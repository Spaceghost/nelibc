## pragmas.nogc = true
## pragmas.noentrypoint = true

local function nelibc_malloc(size: csize): pointer <cimport> end

local function malloc(size: csize): pointer <cexport, codename 'malloc'>
  return nelibc_malloc(size)
end

local function nelibc_hybrid_malloc_usable_size(ptr: pointer): csize <cimport> end

local function malloc_usable_size(ptr: pointer): csize
    <cexport, codename 'malloc_usable_size'>
  return nelibc_hybrid_malloc_usable_size(ptr)
end
