## pragmas.nogc = true
## pragmas.noentrypoint = true

-- The standalone locale backend currently supports the C locale and a small
-- explicit locale set. Keep wide case conversion consistent with its C
-- locale until Unicode locale tables are available.
local function towlower(value: cwchar_t): cwchar_t <cexport, codename 'towlower'>
  if value >= 65 and value <= 90 then return value + 32 end
  return value
end

local function nelibc_multibyte_mode(): cint <cimport> end

local function wcwidth(value: cwchar_t): cint <cexport, codename 'wcwidth'>
  if value == 0 then return 0 end
  if value < 0 or value > 1114111 or (value >= 55296 and value <= 57343) then return -1 end
  if value < 32 or (value >= 127 and value <= 159) then return -1 end
  if nelibc_multibyte_mode() == 0 then
    if value < 127 then return 1 end
    return -1
  end

  -- Common Unicode combining ranges used by C.UTF-8. The complete UCD width
  -- table is still needed for all scripts and marks (tracked in the roadmap).
  if (value >= 768 and value <= 879) or
      (value >= 6832 and value <= 6911) or
      (value >= 7616 and value <= 7679) or
      (value >= 8400 and value <= 8447) or
      (value >= 65024 and value <= 65039) or
      (value >= 65056 and value <= 65071) or
      (value >= 917760 and value <= 917999) then return 0 end

  if (value >= 4352 and value <= 4607) or
      value == 9001 or value == 9002 or
      (value >= 11904 and value <= 42191 and value ~= 12351) or
      (value >= 44032 and value <= 55203) or
      (value >= 63744 and value <= 64255) or
      (value >= 65040 and value <= 65049) or
      (value >= 65072 and value <= 65135) or
      (value >= 65281 and value <= 65376) or
      (value >= 65504 and value <= 65510) or
      (value >= 127744 and value <= 129791) or
      (value >= 131072 and value <= 262141) then return 2 end
  return 1
end

local function nelibc_standalone_setlocale(category: cint,
    name: *[0]cchar <const>): *[0]cchar <cimport> end

local function setlocale(category: cint, name: *[0]cchar <const>): *[0]cchar
    <cexport, codename 'setlocale'>
  return nelibc_standalone_setlocale(category, name)
end

local LocaleConv: type = @record{
  decimal_point: *[0]cchar,
  thousands_sep: *[0]cchar,
  grouping: *[0]cchar,
  int_curr_symbol: *[0]cchar,
  currency_symbol: *[0]cchar,
  mon_decimal_point: *[0]cchar,
  mon_thousands_sep: *[0]cchar,
  mon_grouping: *[0]cchar,
  positive_sign: *[0]cchar,
  negative_sign: *[0]cchar,
  int_frac_digits: cchar,
  frac_digits: cchar,
  p_cs_precedes: cchar,
  p_sep_by_space: cchar,
  n_cs_precedes: cchar,
  n_sep_by_space: cchar,
  p_sign_posn: cchar,
  n_sign_posn: cchar,
  int_p_cs_precedes: cchar,
  int_p_sep_by_space: cchar,
  int_n_cs_precedes: cchar,
  int_n_sep_by_space: cchar,
  int_p_sign_posn: cchar,
  int_n_sign_posn: cchar
}

local function nelibc_standalone_numeric_is_de(): cint <cimport> end
local function nelibc_standalone_monetary_is_de(): cint <cimport> end

local decimal_dot: [2]cchar = {46_cchar, 0_cchar}
local decimal_comma: [2]cchar = {44_cchar, 0_cchar}
local thousands_dot: [2]cchar = {46_cchar, 0_cchar}
local empty_text: [1]cchar = {0_cchar}
local grouping_three: [2]cchar = {3_cchar, 0_cchar}
local euro_code: [5]cchar = {69_cchar, 85_cchar, 82_cchar, 32_cchar, 0_cchar}
local euro_symbol: [4]cchar = {-30_cchar, -126_cchar, -84_cchar, 0_cchar}
local minus_sign: [2]cchar = {45_cchar, 0_cchar}

local locale_data: LocaleConv = {}

local function localeconv(): *LocaleConv <cexport, codename 'localeconv'>
  local numeric_de = nelibc_standalone_numeric_is_de() ~= 0
  local monetary_de = nelibc_standalone_monetary_is_de() ~= 0
  if numeric_de then
    locale_data.decimal_point = (@*[0]cchar)(&decimal_comma[0])
    locale_data.thousands_sep = (@*[0]cchar)(&thousands_dot[0])
    locale_data.grouping = (@*[0]cchar)(&grouping_three[0])
  else
    locale_data.decimal_point = (@*[0]cchar)(&decimal_dot[0])
    locale_data.thousands_sep = (@*[0]cchar)(&empty_text[0])
    locale_data.grouping = (@*[0]cchar)(&empty_text[0])
  end
  if monetary_de then
    locale_data.int_curr_symbol = (@*[0]cchar)(&euro_code[0])
    locale_data.currency_symbol = (@*[0]cchar)(&euro_symbol[0])
    locale_data.mon_decimal_point = (@*[0]cchar)(&decimal_comma[0])
    locale_data.mon_thousands_sep = (@*[0]cchar)(&thousands_dot[0])
    locale_data.mon_grouping = (@*[0]cchar)(&grouping_three[0])
    locale_data.positive_sign = (@*[0]cchar)(&empty_text[0])
    locale_data.negative_sign = (@*[0]cchar)(&minus_sign[0])
    locale_data.int_frac_digits = 2_cchar
    locale_data.frac_digits = 2_cchar
    locale_data.p_cs_precedes = 0_cchar
    locale_data.p_sep_by_space = 1_cchar
    locale_data.n_cs_precedes = 0_cchar
    locale_data.n_sep_by_space = 1_cchar
    locale_data.p_sign_posn = 1_cchar
    locale_data.n_sign_posn = 1_cchar
    locale_data.int_p_cs_precedes = 0_cchar
    locale_data.int_p_sep_by_space = 1_cchar
    locale_data.int_n_cs_precedes = 0_cchar
    locale_data.int_n_sep_by_space = 1_cchar
    locale_data.int_p_sign_posn = 1_cchar
    locale_data.int_n_sign_posn = 1_cchar
  else
    locale_data.int_curr_symbol = (@*[0]cchar)(&empty_text[0])
    locale_data.currency_symbol = (@*[0]cchar)(&empty_text[0])
    locale_data.mon_decimal_point = (@*[0]cchar)(&empty_text[0])
    locale_data.mon_thousands_sep = (@*[0]cchar)(&empty_text[0])
    locale_data.mon_grouping = (@*[0]cchar)(&empty_text[0])
    locale_data.positive_sign = (@*[0]cchar)(&empty_text[0])
    locale_data.negative_sign = (@*[0]cchar)(&empty_text[0])
    locale_data.int_frac_digits = 127_cchar
    locale_data.frac_digits = 127_cchar
    locale_data.p_cs_precedes = 127_cchar
    locale_data.p_sep_by_space = 127_cchar
    locale_data.n_cs_precedes = 127_cchar
    locale_data.n_sep_by_space = 127_cchar
    locale_data.p_sign_posn = 127_cchar
    locale_data.n_sign_posn = 127_cchar
    locale_data.int_p_cs_precedes = 127_cchar
    locale_data.int_p_sep_by_space = 127_cchar
    locale_data.int_n_cs_precedes = 127_cchar
    locale_data.int_n_sep_by_space = 127_cchar
    locale_data.int_p_sign_posn = 127_cchar
    locale_data.int_n_sign_posn = 127_cchar
  end
  return &locale_data
end

local function nelibc_strerror_r(errnum: cint, buffer: *[0]cchar,
    buffer_size: csize): cint <cimport> end

local function standalone_strerror_r(errnum: cint, buffer: *[0]cchar,
    buffer_size: csize): cint <cexport, codename 'strerror_r'>
  return nelibc_strerror_r(errnum, buffer, buffer_size)
end
