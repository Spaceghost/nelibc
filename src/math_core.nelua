local log_ln2hi: cdouble = 0x1.62E42FEFA3800P-1_cdouble
local log_ln2lo: cdouble = 0x1.EF35793C76730P-45_cdouble
local log_poly1: [11]cdouble = {
  -0x1P-1_cdouble, 0x1.5555555555577P-2_cdouble, -0x1.FFFFFFFFFFDCBP-3_cdouble,
  0x1.999999995DD0CP-3_cdouble, -0x1.55555556745A7P-3_cdouble, 0x1.24924A344DE3P-3_cdouble,
  -0x1.FFFFFA4423D65P-4_cdouble, 0x1.C7184282AD6CAP-4_cdouble, -0x1.999EB43B068FFP-4_cdouble,
  0x1.78182F7AFD085P-4_cdouble, -0x1.5521375D145CDP-4_cdouble
}
local log_poly: [5]cdouble = {
  -0x1.0000000000001P-1_cdouble, 0x1.555555551305BP-2_cdouble, -0x1.FFFFFFFEB459P-3_cdouble,
  0x1.999B324F10111P-3_cdouble, -0x1.55575E506C89FP-3_cdouble
}

local function log(x: cdouble): cdouble <cexport, codename 'log'>
  if is_nan64(x) then return x + x end
  local ix = bits_of_double(x)
  local top = (@cuint)(ix >> 48)
  -- [1 - 0x1p-4, 1 + 0x1.09p-4): handle inputs close to 1 separately.
  if ix >= 0x3FEE000000000000_culonglong and ix < 0x3FF1090000000000_culonglong then
    if ix == 0x3FF0000000000000_culonglong then return 0_cdouble end
    local r = x - 1_cdouble
    local r2 = r * r
    local r3 = r * r2
    local y = r3 * (log_poly1[1] + r * log_poly1[2] + r2 * log_poly1[3] +
      r3 * (log_poly1[4] + r * log_poly1[5] + r2 * log_poly1[6] +
      r3 * (log_poly1[7] + r * log_poly1[8] + r2 * log_poly1[9] + r3 * log_poly1[10])))
    local w = r * 0x1P27_cdouble
    local rhi = r + w - w
    local rlo = r - rhi
    w = rhi * rhi * log_poly1[0]
    local hi = r + w
    local lo = r - hi + w
    lo = lo + log_poly1[0] * rlo * (rhi + r)
    y = y + lo
    y = y + hi
    return y
  end
  if top < 0x0010_cuint or top >= 0x7FF0_cuint then
    -- x < 0x1p-1022, infinity or negative.
    if (ix << 1) == 0_culonglong then return math_divzero(true) end
    if ix == 0x7FF0000000000000_culonglong then return x end
    if (top & 0x8000_cuint) ~= 0_cuint then return math_invalid(x) end
    ix = bits_of_double(x * 0x1P52_cdouble)
    ix = ix - (52_culonglong << 52)
  end
  -- x = 2^k z with z in [OFF, 2*OFF); the ith of 128 subintervals holds z.
  local tmp = ix - 0x3FE6000000000000_culonglong
  local i = (@cint)((tmp >> 45) & 127_culonglong)
  local k = (@cint)(tmp >> 52)
  if k >= 2048_cint then k = k - 4096_cint end
  local iz = ix - (tmp & (0xFFF_culonglong << 52))
  local invc = log_tab_invc[i]
  local logc = log_tab_logc[i]
  local z = double_from_bits(iz)
  local r = (z - log_tab2_chi[i] - log_tab2_clo[i]) * invc
  local kd = (@cdouble)(k)
  local w = kd * log_ln2hi + logc
  local hi = w + r
  local lo = w - hi + r + kd * log_ln2lo
  local r2 = r * r
  local y = lo + r2 * log_poly[0] +
    r * r2 * (log_poly[1] + r * log_poly[2] + r2 * (log_poly[3] + r * log_poly[4])) + hi
  return y
end

local function logf(value: cfloat): cfloat <cexport, codename 'logf'>
  return (@cfloat)(log((@cdouble)(value)))
end

local log2_invln2hi: cdouble = 0x1.7154765200000P+0_cdouble
local log2_invln2lo: cdouble = 0x1.705FC2EEFA200P-33_cdouble
local log2_poly1: [10]cdouble = {
  -0x1.71547652B82FEP-1_cdouble, 0x1.EC709DC3A03F7P-2_cdouble, -0x1.71547652B7C3FP-2_cdouble,
  0x1.2776C50F05BE4P-2_cdouble, -0x1.EC709DD768FE5P-3_cdouble, 0x1.A61761EC4E736P-3_cdouble,
  -0x1.7153FBC64A79BP-3_cdouble, 0x1.484D154F01B4AP-3_cdouble, -0x1.289E4A72C383CP-3_cdouble,
  0x1.0B32F285AEE66P-3_cdouble
}
local log2_poly: [6]cdouble = {
  -0x1.71547652B8339P-1_cdouble, 0x1.EC709DC3A04BEP-2_cdouble, -0x1.7154764702FFBP-2_cdouble,
  0x1.2776C50034C48P-2_cdouble, -0x1.EC7B328EA92BCP-3_cdouble, 0x1.A6225E117F92EP-3_cdouble
}

local function log2(x: cdouble): cdouble <cexport, codename 'log2'>
  if is_nan64(x) then return x + x end
  local ix = bits_of_double(x)
  local top = (@cuint)(ix >> 48)
  -- [1 - 0x1.5b51p-5, 1 + 0x1.6ab2p-5): inputs close to 1.
  if ix >= 0x3FEEA4AF00000000_culonglong and ix < 0x3FF0B55900000000_culonglong then
    if ix == 0x3FF0000000000000_culonglong then return 0_cdouble end
    local r = x - 1_cdouble
    local rhi = double_from_bits(bits_of_double(r) & 0xFFFFFFFF00000000_culonglong)
    local rlo = r - rhi
    local hi = rhi * log2_invln2hi
    local lo = rlo * log2_invln2hi + r * log2_invln2lo
    local r2 = r * r
    local r4 = r2 * r2
    local p = r2 * (log2_poly1[0] + r * log2_poly1[1])
    local y = hi + p
    lo = lo + (hi - y + p)
    lo = lo + r4 * (log2_poly1[2] + r * log2_poly1[3] + r2 * (log2_poly1[4] + r * log2_poly1[5]) +
      r4 * (log2_poly1[6] + r * log2_poly1[7] + r2 * (log2_poly1[8] + r * log2_poly1[9])))
    y = y + lo
    return y
  end
  if top < 0x0010_cuint or top >= 0x7FF0_cuint then
    if (ix << 1) == 0_culonglong then return math_divzero(true) end
    if ix == 0x7FF0000000000000_culonglong then return x end
    if (top & 0x8000_cuint) ~= 0_cuint then return math_invalid(x) end
    ix = bits_of_double(x * 0x1P52_cdouble)
    ix = ix - (52_culonglong << 52)
  end
  local tmp = ix - 0x3FE6000000000000_culonglong
  local i = (@cint)((tmp >> 46) & 63_culonglong)
  local k = (@cint)(tmp >> 52)
  if k >= 2048_cint then k = k - 4096_cint end
  local iz = ix - (tmp & (0xFFF_culonglong << 52))
  local invc = log2_tab_invc[i]
  local logc = log2_tab_logc[i]
  local z = double_from_bits(iz)
  local kd = (@cdouble)(k)
  local r = (z - log2_tab2_chi[i] - log2_tab2_clo[i]) * invc
  local rhi = double_from_bits(bits_of_double(r) & 0xFFFFFFFF00000000_culonglong)
  local rlo = r - rhi
  local t1 = rhi * log2_invln2hi
  local t2 = rlo * log2_invln2hi + r * log2_invln2lo
  local t3 = kd + logc
  local hi = t3 + t1
  local lo = t3 - hi + t1 + t2
  local r2 = r * r
  local r4 = r2 * r2
  local p = log2_poly[0] + r * log2_poly[1] + r2 * (log2_poly[2] + r * log2_poly[3]) +
    r4 * (log2_poly[4] + r * log2_poly[5])
  local y = lo + r2 * p + hi
  return y
end

local function log2f(value: cfloat): cfloat <cexport, codename 'log2f'>
  return (@cfloat)(log2((@cdouble)(value)))
end

-- Shared fdlibm log(1+f) polynomial (musl log10.c / log1p.c).
local log_lg1: cdouble = 0x1.5555555555593P-1_cdouble
local log_lg2: cdouble = 0x1.999999997FA04P-2_cdouble
local log_lg3: cdouble = 0x1.2492494229359P-2_cdouble
local log_lg4: cdouble = 0x1.C71C51D8E78AFP-3_cdouble
local log_lg5: cdouble = 0x1.7466496CB03DEP-3_cdouble
local log_lg6: cdouble = 0x1.39A09D078C69FP-3_cdouble
local log_lg7: cdouble = 0x1.2F112DF3E5244P-3_cdouble
local log10_ivln10hi: cdouble = 0x1.BCB7B15200000P-2_cdouble
local log10_ivln10lo: cdouble = 0x1.B9438CA9AADD5P-36_cdouble
local log10_2hi: cdouble = 0x1.34413509F6000P-2_cdouble
local log10_2lo: cdouble = 0x1.9FEF311F12B36P-42_cdouble

local function log10(x: cdouble): cdouble <cexport, codename 'log10'>
  if is_nan64(x) then return x + x end
  local bits = bits_of_double(x)
  local hx = (@cuint)(bits >> 32)
  local k: cint = 0_cint
  if hx < 0x00100000_cuint or (hx >> 31) ~= 0_cuint then
    if (bits << 1) == 0_culonglong then return math_divzero(true) end
    if (hx >> 31) ~= 0_cuint then return math_invalid(x) end
    -- subnormal: scale up
    k = k - 54_cint
    x = x * 0x1P54_cdouble
    bits = bits_of_double(x)
    hx = (@cuint)(bits >> 32)
  elseif hx >= 0x7FF00000_cuint then
    return x
  elseif hx == 0x3FF00000_cuint and (bits << 32) == 0_culonglong then
    return 0_cdouble
  end
  -- reduce x into [sqrt(2)/2, sqrt(2)]
  hx = hx + (0x3FF00000_cuint - 0x3FE6A09E_cuint)
  k = k + (@cint)(hx >> 20) - 0x3FF_cint
  hx = (hx & 0x000FFFFF_cuint) + 0x3FE6A09E_cuint
  bits = ((@culonglong)(hx) << 32) | (bits & 0xFFFFFFFF_culonglong)
  x = double_from_bits(bits)
  local f = x - 1_cdouble
  local hfsq = 0.5_cdouble * f * f
  local s = f / (2_cdouble + f)
  local z = s * s
  local w = z * z
  local t1 = w * (log_lg2 + w * (log_lg4 + w * log_lg6))
  local t2 = z * (log_lg1 + w * (log_lg3 + w * (log_lg5 + w * log_lg7)))
  local r = t2 + t1
  -- hi + lo = f - hfsq + s*(hfsq+R) ~ log(1+f)
  local hi = f - hfsq
  hi = double_from_bits(bits_of_double(hi) & 0xFFFFFFFF00000000_culonglong)
  local lo = f - hi - hfsq + s * (hfsq + r)
  local val_hi = hi * log10_ivln10hi
  local dk = (@cdouble)(k)
  local y = dk * log10_2hi
  local val_lo = dk * log10_2lo + (lo + hi) * log10_ivln10lo + lo * log10_ivln10hi
  w = y + val_hi
  val_lo = val_lo + (y - w) + val_hi
  val_hi = w
  return val_lo + val_hi
end

local function log10f(value: cfloat): cfloat <cexport, codename 'log10f'>
  return (@cfloat)(log10((@cdouble)(value)))
end

local function cbrt(value: cdouble): cdouble <cexport, codename 'cbrt'>
  if value ~= value then return value + value end
  if is_infinite64(value) or value == 0_cdouble then return value end

  local exponent: cint = 0_cint
  local mantissa = frexp(fabs(value), &exponent)
  -- Write exponent = 3*q + r with r in [0, 2], keeping the reduced input
  -- inside [0.5, 4). This makes the Newton iteration safe for all exponents.
  local quotient: cint = exponent // 3_cint
  local residual: cint = exponent - quotient * 3_cint
  local reduced = ldexp(mantissa, residual)
  local root = exp_core(log(reduced) / 3_cdouble)
  local iteration: cint = 0_cint
  while iteration < 3_cint do
    root = (2_cdouble * root + reduced / (root * root)) / 3_cdouble
    iteration = iteration + 1_cint
  end
  root = ldexp(root, quotient)
  if value < 0_cdouble then return -root end
  return root
end

local function cbrtf(value: cfloat): cfloat <cexport, codename 'cbrtf'>
  return (@cfloat)(cbrt((@cdouble)(value)))
end

local function cbrtl(value: clongdouble): clongdouble <cexport, codename 'cbrtl'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) or value == 0_clongdouble then return value end

  local magnitude = value
  if magnitude < 0_clongdouble then magnitude = -magnitude end
  local exponent: cint = 0_cint
  local mantissa = frexpl(magnitude, &exponent)
  -- Keep the reduced input in [0.5, 4) so Newton iteration remains well scaled.
  local quotient: cint = exponent // 3_cint
  local residual: cint = exponent - quotient * 3_cint
  local reduced = ldexpl(mantissa, residual)
  local root = expl(logl(reduced) / 3_clongdouble)
  local iteration: cint = 0_cint
  while iteration < 3_cint do
    root = (2_clongdouble * root + reduced / (root * root)) / 3_clongdouble
    iteration = iteration + 1_cint
  end
  root = ldexpl(root, quotient)
  if value < 0_clongdouble then return -root end
  return root
end

local log1p_ln2_hi: cdouble = 0x1.62E42FEE00000P-1_cdouble
local log1p_ln2_lo: cdouble = 0x1.A39EF35793C76P-33_cdouble

local function log1p(x: cdouble): cdouble <cexport, codename 'log1p'>
  if is_nan64(x) then return x + x end
  local bits = bits_of_double(x)
  local hx = (@cuint)(bits >> 32)
  local k: cint = 1_cint
  local c: cdouble = 0_cdouble
  local f: cdouble = 0_cdouble
  if hx < 0x3FDA827A_cuint or (hx >> 31) ~= 0_cuint then -- 1+x < sqrt(2)+
    if hx >= 0xBFF00000_cuint then -- x <= -1.0
      if x == -1_cdouble then return math_divzero(true) end
      return math_invalid(x)
    end
    if (hx << 1) < (0x3CA00000_cuint << 1) then -- |x| < 2**-53
      if (hx & 0x7FF00000_cuint) == 0_cuint then force_evalf((@cfloat)(x)) end
      return x
    end
    if hx <= 0xBFD2BEC4_cuint then -- sqrt(2)/2- <= 1+x < sqrt(2)+
      k = 0_cint
      c = 0_cdouble
      f = x
    end
  elseif hx >= 0x7FF00000_cuint then
    return x
  end
  if k ~= 0_cint then
    local u = 1_cdouble + x
    local ubits = bits_of_double(u)
    local hu = (@cuint)(ubits >> 32)
    hu = hu + (0x3FF00000_cuint - 0x3FE6A09E_cuint)
    k = (@cint)(hu >> 20) - 0x3FF_cint
    -- correction term ~ log(1+x)-log(u), avoid underflow in c/u
    if k < 54_cint then
      if k >= 2_cint then
        c = 1_cdouble - (u - x)
      else
        c = x - (u - 1_cdouble)
      end
      c = c / u
    else
      c = 0_cdouble
    end
    -- reduce u into [sqrt(2)/2, sqrt(2)]
    hu = (hu & 0x000FFFFF_cuint) + 0x3FE6A09E_cuint
    ubits = ((@culonglong)(hu) << 32) | (ubits & 0xFFFFFFFF_culonglong)
    f = double_from_bits(ubits) - 1_cdouble
  end
  local hfsq = 0.5_cdouble * f * f
  local s = f / (2_cdouble + f)
  local z = s * s
  local w = z * z
  local t1 = w * (log_lg2 + w * (log_lg4 + w * log_lg6))
  local t2 = z * (log_lg1 + w * (log_lg3 + w * (log_lg5 + w * log_lg7)))
  local r = t2 + t1
  local dk = (@cdouble)(k)
  return s * (hfsq + r) + (dk * log1p_ln2_lo + c) - hfsq + f + dk * log1p_ln2_hi
end

local function log1pf(value: cfloat): cfloat <cexport, codename 'log1pf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  return (@cfloat)(log1p((@cdouble)(value)))
end


local function expm1f(value: cfloat): cfloat <cexport, codename 'expm1f'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  return (@cfloat)(expm1((@cdouble)(value)))
end

-- asinh, acosh and atanh follow musl 1.2.5 src/math/asinh.c, acosh.c,
-- atanh.c.
local function asinh(value: cdouble): cdouble <cexport, codename 'asinh'>
  local bits = bits_of_double(value)
  local e = (@cuint)((bits >> 52) & 0x7FF_culonglong)
  local negative = (bits >> 63) ~= 0_culonglong
  local x = double_from_bits(bits & 0x7FFFFFFFFFFFFFFF_culonglong)
  if e >= 0x3FF_cuint + 26_cuint then -- |x| >= 0x1p26, infinity or NaN
    x = log(x) + 0.693147180559945309417232121458176568_cdouble
  elseif e >= 0x3FF_cuint + 1_cuint then -- |x| >= 2
    x = log(2_cdouble * x + 1_cdouble / (sqrt(x * x + 1_cdouble) + x))
  elseif e >= 0x3FF_cuint - 26_cuint then -- |x| >= 0x1p-26
    x = log1p(x + x * x / (sqrt(x * x + 1_cdouble) + 1_cdouble))
  else -- |x| < 0x1p-26: raise inexact if x != 0
    force_eval(x + 0x1p120_cdouble)
  end
  if negative then return -x end
  return x
end


local function acosh(value: cdouble): cdouble <cexport, codename 'acosh'>
  if is_nan64(value) then return value + value end
  if value < 1_cdouble then return math_invalid(value) end
  local e = (@cuint)((bits_of_double(value) >> 52) & 0x7FF_culonglong)
  if e < 0x3FF_cuint + 1_cuint then -- 1 <= x < 2
    local t = value - 1_cdouble
    return log1p(t + sqrt(t * t + 2_cdouble * t))
  end
  if e < 0x3FF_cuint + 26_cuint then -- x < 0x1p26
    return log(2_cdouble * value - 1_cdouble / (value + sqrt(value * value - 1_cdouble)))
  end
  -- x >= 0x1p26 or infinity
  return log(value) + 0.693147180559945309417232121458176568_cdouble
end

local function atanh(value: cdouble): cdouble <cexport, codename 'atanh'>
  local bits = bits_of_double(value)
  local e = (@cuint)((bits >> 52) & 0x7FF_culonglong)
  local negative = (bits >> 63) ~= 0_culonglong
  local y = double_from_bits(bits & 0x7FFFFFFFFFFFFFFF_culonglong)
  if e < 0x3FF_cuint - 1_cuint then -- |x| < 0.5
    if e < 0x3FF_cuint - 32_cuint then
      -- |x| < 2^-32: atanh(x) rounds to x; raise underflow for subnormals.
      if e == 0_cuint then force_evalf((@cfloat)(y)) end
    else
      y = 0.5_cdouble * log1p(2_cdouble * y + 2_cdouble * y * y / (1_cdouble - y))
    end
  else
    if not is_nan64(y) then
      if y > 1_cdouble then
        math_domain_error()
      elseif y == 1_cdouble then
        math_range_error()
      end
    end
    -- y/(1-y) is negative past 1 (INVALID in log1p) and infinite at 1
    -- (DIVBYZERO here).
    y = 0.5_cdouble * log1p(2_cdouble * (y / (1_cdouble - y)))
  end
  if negative then return -y end
  return y
end

local function asinhf(value: cfloat): cfloat <cexport, codename 'asinhf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  return (@cfloat)(asinh((@cdouble)(value)))
end

local function acoshf(value: cfloat): cfloat <cexport, codename 'acoshf'>
  return (@cfloat)(acosh((@cdouble)(value)))
end

local function atanhf(value: cfloat): cfloat <cexport, codename 'atanhf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  return (@cfloat)(atanh((@cdouble)(value)))
end


-- Keep the log/exponent product in x86 extended precision. Doing the whole
-- composition in binary64 magnifies log's last-bit error for large exponents.
-- pow follows musl 1.2.5 src/math/pow.c (Copyright (c) 2018, Arm Limited,
-- MIT): log(x) to about 68 bits as a double-double from a 128-entry table
-- plus a degree-8 polynomial, then exp_inline on the double-double product.
-- pow_log_* are musl's __pow_log_data.tab columns verbatim. Worst-case
-- error documented by musl: 0.54 ulp.
local pow_ln2hi: cdouble = 0x1.62E42FEFA3800P-1_cdouble
local pow_ln2lo: cdouble = 0x1.EF35793C76730P-45_cdouble
-- musl's poly[] with the evaluation scaling (*-2, *4, *-8) folded in.
local pow_a0: cdouble = -0x1P-1_cdouble
local pow_a1: cdouble = -0x1.555555555556P-1_cdouble
local pow_a2: cdouble = 0x1.0000000000006P-1_cdouble
local pow_a3: cdouble = 0x1.999999959554EP-1_cdouble
local pow_a4: cdouble = -0x1.555555529A47AP-1_cdouble
local pow_a5: cdouble = -0x1.2495B9B4845E9P+0_cdouble
local pow_a6: cdouble = 0x1.0002B8B263FC3P+0_cdouble

local PowLog: type = @record{hi: cdouble, lo: cdouble}

-- hi + lo = log(x) with about 15 extra bits in lo. ix is the bit pattern of
-- x, normalized in the subnormal range using the sign bit for the exponent.
local function pow_log_inline(ix: culonglong): PowLog
  -- x = 2^k z with z in [OFF, 2*OFF) exact; the ith of 128 subintervals
  -- holds z and c is near its center.
  local tmp = ix - 0x3FE6955500000000_culonglong
  local i = (@cint)((tmp >> 45) % 128_culonglong)
  local k = (@cint)(tmp >> 52) -- arithmetic shift of the signed exponent
  if k >= 2048_cint then k = k - 4096_cint end
  local iz = ix - (tmp & (0xFFF_culonglong << 52))
  local z = double_from_bits(iz)
  local kd = (@cdouble)(k)
  -- log(x) = k*Ln2 + log(c) + log1p(z/c-1)
  local invc = pow_log_invc[i]
  local logc = pow_log_logc[i]
  local logctail = pow_log_logctail[i]
  -- Split z so that rhi, rlo and rhi*rhi are exact and |rlo| <= |r|.
  local zhi = double_from_bits((iz + (1_culonglong << 31)) & 0xFFFFFFFF00000000_culonglong)
  local zlo = z - zhi
  local rhi = zhi * invc - 1_cdouble
  local rlo = zlo * invc
  local r = rhi + rlo
  -- k*Ln2 + log(c) + r
  local t1 = kd * pow_ln2hi + logc
  local t2 = t1 + r
  local lo1 = kd * pow_ln2lo + logctail
  local lo2 = t1 - t2 + r
  local ar = pow_a0 * r
  local ar2 = r * ar
  local ar3 = r * ar2
  -- k*Ln2 + log(c) + r + A[0]*r*r
  local arhi = pow_a0 * rhi
  local arhi2 = rhi * arhi
  local hi = t2 + arhi2
  local lo3 = rlo * (ar + arhi)
  local lo4 = t2 - hi + arhi2
  -- p = log1p(r) - r - A[0]*r*r
  local p = ar3 * (pow_a1 + r * pow_a2 + ar2 * (pow_a3 + r * pow_a4 +
    ar2 * (pow_a5 + r * pow_a6)))
  local lo = lo1 + lo2 + lo3 + lo4 + p
  local y = hi + lo
  local result: PowLog = {hi = y, lo = hi - y + lo}
  return result
end

-- 0 if y is not an integer, 1 if odd, 2 if even; iy is a non-zero finite
-- bit pattern.
local function pow_checkint(iy: culonglong): cint
  local e = (@cint)((iy >> 52) & 0x7FF_culonglong)
  if e < 0x3FF_cint then return 0_cint end
  if e > 0x3FF_cint + 52_cint then return 2_cint end
  local shift = 0x3FF_cint + 52_cint - e
  if (iy & ((1_culonglong << shift) - 1_culonglong)) ~= 0_culonglong then return 0_cint end
  if (iy & (1_culonglong << shift)) ~= 0_culonglong then return 1_cint end
  return 2_cint
end

local function pow_zero_inf_nan(i: culonglong): boolean <inline>
  local magnitude = i & 0x7FFFFFFFFFFFFFFF_culonglong
  return magnitude == 0_culonglong or magnitude >= 0x7FF0000000000000_culonglong
end

local function pow(x: cdouble, y: cdouble): cdouble
    <cexport, codename 'pow'>
  local negative_result = false
  local ix = bits_of_double(x)
  local iy = bits_of_double(y)
  local topx = top12(x)
  local topy = top12(y)
  local atopy = topy & 0x7FF_cuint
  if iy == 0x3FF0000000000000_culonglong and not is_nan64(x) then return x end -- x^1 = x, exactly
  if topx == 0_cuint or topx >= 0x7FF_cuint or atopy < 0x3BE_cuint or atopy >= 0x43E_cuint then
    -- x < 0x1p-1022, negative, infinite or NaN; or |y| < 2^-65, |y| >= 2^63
    -- or NaN. Beyond |y| ~ 0x1.749p62, pow is inf or 0; below 0x1.e7b6p-65
    -- it is +-1.
    if pow_zero_inf_nan(iy) then
      if (iy & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then
        if is_signaling_nan(x) then return x + y end
        return 1_cdouble
      end
      if ix == 0x3FF0000000000000_culonglong then
        if is_signaling_nan(y) then return x + y end
        return 1_cdouble
      end
      if (ix & 0x7FFFFFFFFFFFFFFF_culonglong) > 0x7FF0000000000000_culonglong or
          (iy & 0x7FFFFFFFFFFFFFFF_culonglong) > 0x7FF0000000000000_culonglong then
        return x + y
      end
      if (ix & 0x7FFFFFFFFFFFFFFF_culonglong) == 0x3FF0000000000000_culonglong then return 1_cdouble end
      if ((ix & 0x7FFFFFFFFFFFFFFF_culonglong) < 0x3FF0000000000000_culonglong) ==
          ((iy >> 63) == 0_culonglong) then
        return 0_cdouble -- |x| < 1 and y == inf, or |x| > 1 and y == -inf
      end
      return y * y
    end
    if pow_zero_inf_nan(ix) then
      local x2 = x * x
      if (ix >> 63) ~= 0_culonglong and pow_checkint(iy) == 1_cint then x2 = -x2 end
      if (iy >> 63) ~= 0_culonglong then
        -- pow(+-0, negative) is a pole: DIVBYZERO from the division.
        if (ix & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then math_range_error() end
        return nelibc_fp_barrier_hw(1_cdouble / x2)
      end
      return x2
    end
    -- x and y are non-zero and finite.
    if (ix >> 63) ~= 0_culonglong then
      -- Finite x < 0.
      local yint = pow_checkint(iy)
      if yint == 0_cint then return math_invalid(x) end
      if yint == 1_cint then negative_result = true end
      ix = ix & 0x7FFFFFFFFFFFFFFF_culonglong
      topx = topx & 0x7FF_cuint
    end
    if atopy < 0x3BE_cuint or atopy >= 0x43E_cuint then
      -- y is not odd here, so the result is positive.
      if ix == 0x3FF0000000000000_culonglong then return 1_cdouble end
      if atopy < 0x3BE_cuint then
        -- |y| < 2^-65: x^y ~= 1 + y*log(x)
        if ix > 0x3FF0000000000000_culonglong then return 1_cdouble + y end
        return 1_cdouble - y
      end
      if (ix > 0x3FF0000000000000_culonglong) == (topy < 0x800_cuint) then
        return math_oflow(false)
      end
      return math_uflow(false)
    end
    if topx == 0_cuint then
      -- Normalize subnormal x so its exponent becomes negative.
      ix = bits_of_double(x * 0x1p52_cdouble) & 0x7FFFFFFFFFFFFFFF_culonglong
      ix = ix - (52_culonglong << 52)
    end
  end

  local lg = pow_log_inline(ix)
  -- y*log(x) as a double-double without fma.
  local yhi = double_from_bits(iy & 0xFFFFFFFFF8000000_culonglong)
  local ylo = y - yhi
  local lhi = double_from_bits(bits_of_double(lg.hi) & 0xFFFFFFFFF8000000_culonglong)
  local llo = lg.hi - lhi + lg.lo
  local ehi = yhi * lhi
  local elo = ylo * lhi + y * llo -- |elo| < |ehi| * 2^-25
  return exp_inline(ehi, elo, negative_result)
end

local function powf(value: cfloat, exponent: cfloat): cfloat
    <cexport, codename 'powf'>
  local result = (@cfloat)(pow((@cdouble)(value), (@cdouble)(exponent)))
  if is_infinite32(result) and not is_infinite32(value) and not is_infinite32(exponent) then
    math_range_error()
  elseif result == 0_cfloat and value ~= 0_cfloat then
    math_range_error()
  end
  return result
end

-- Scale by the larger operand before squaring. Exponent-gap shortcuts avoid
-- raising underflow for a contribution too small to affect the rounded result.
-- hypot and hypotf follow musl 1.2.5 src/math/hypot.c and hypotf.c.
local function hypot_sq(x: cdouble): (cdouble, cdouble)
  local xc = x * 134217729_cdouble -- SPLIT = 0x1p27 + 1
  local xh = x - xc + xc
  local xl = x - xh
  local hi = x * x
  local lo = xh * xh - hi + 2_cdouble * xh * xl + xl * xl
  return hi, lo
end

local function hypot(x: cdouble, y: cdouble): cdouble <cexport, codename 'hypot'>
  local ux = bits_of_double(x) & 0x7FFFFFFFFFFFFFFF_culonglong
  local uy = bits_of_double(y) & 0x7FFFFFFFFFFFFFFF_culonglong
  if ux < uy then
    local swap = ux
    ux = uy
    uy = swap
  end
  local ex = (@cint)(ux >> 52)
  local ey = (@cint)(uy >> 52)
  x = double_from_bits(ux)
  y = double_from_bits(uy)
  -- hypot(inf, nan) == inf
  if ey == 0x7FF_cint then return y end
  if ex == 0x7FF_cint or uy == 0_culonglong then return x end
  -- hypot(x, y) ~= x + y*y/x/2 with inexact for small y/x
  if ex - ey > 64_cint then return x + y end
  -- precise sqrt argument in nearest rounding mode without overflow
  local z: cdouble = 1_cdouble
  if ex > 0x3FF_cint + 510_cint then
    z = 0x1P700_cdouble
    x = x * 0x1P-700_cdouble
    y = y * 0x1P-700_cdouble
  elseif ey < 0x3FF_cint - 450_cint then
    z = 0x1P-700_cdouble
    x = x * 0x1P700_cdouble
    y = y * 0x1P700_cdouble
  end
  local hx, lx = hypot_sq(x)
  local hy, ly = hypot_sq(y)
  local result = z * sqrt(ly + lx + hy + hx)
  if is_infinite64(result) then math_range_error() end
  return result
end

local function hypotf(x: cfloat, y: cfloat): cfloat <cexport, codename 'hypotf'>
  local ux = bits_of_float(x) & 0x7FFFFFFF_cuint
  local uy = bits_of_float(y) & 0x7FFFFFFF_cuint
  if ux < uy then
    local swap = ux
    ux = uy
    uy = swap
  end
  x = float_from_bits(ux)
  y = float_from_bits(uy)
  if uy == 0x7F800000_cuint then return y end
  if ux >= 0x7F800000_cuint or uy == 0_cuint or ux - uy >= (25_cuint << 23) then
    return x + y
  end
  local z: cfloat = 1_cfloat
  if ux >= ((0x7F_cuint + 60_cuint) << 23) then
    z = 0x1P90_cfloat
    x = x * 0x1P-90_cfloat
    y = y * 0x1P-90_cfloat
  elseif uy < ((0x7F_cuint - 60_cuint) << 23) then
    z = 0x1P-90_cfloat
    x = x * 0x1P90_cfloat
    y = y * 0x1P90_cfloat
  end
  local result = z * sqrtf((@cfloat)((@cdouble)(x) * x + (@cdouble)(y) * y))
  if is_infinite32(result) then math_range_error() end
  return result
end

-- The 80-bit format has 64 significand bits. An exponent gap of 33 makes
-- the smaller operand's squared contribution less than half an ulp of ax.
local function hypotl(x: clongdouble, y: clongdouble): clongdouble
    <cexport, codename 'hypotl'>
  if is_infinite80(x) or is_infinite80(y) then
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    return infinity.value
  end
  if is_nan80(x) or is_nan80(y) then return x + y end
  local ax = fabsl(x)
  local ay = fabsl(y)
  if ax < ay then
    local temporary = ax
    ax = ay
    ay = temporary
  end
  if ax == 0_clongdouble then return 0_clongdouble end
  if ay == 0_clongdouble then return ax end
  if ilogbl(ax) - ilogbl(ay) >= 33_cint then return ax end
  local ratio = ay / ax
  local result = ax * sqrtl(1_clongdouble + ratio * ratio)
  if is_infinite80(result) then math_range_error() end
  return result
end

-- C complex values have compiler-specific argument and return conventions.
-- Keep the arithmetic in Nelua and expose scalar helpers for the ABI adapters.
local function nelibc_cabs_parts(x: cdouble, y: cdouble): cdouble
    <cexport, codename 'nelibc_cabs_parts'>
  return hypot(x, y)
end

local function nelibc_cabsf_parts(x: cfloat, y: cfloat): cfloat
    <cexport, codename 'nelibc_cabsf_parts'>
  return hypotf(x, y)
end

local function nelibc_cabsl_parts(x: clongdouble, y: clongdouble): clongdouble
    <cexport, codename 'nelibc_cabsl_parts'>
  return hypotl(x, y)
end

local function nelibc_conjf_imaginary(value: cfloat): cfloat
    <cexport, codename 'nelibc_conjf_imaginary'>
  return -value
end

local function nelibc_conj_imaginary(value: cdouble): cdouble
    <cexport, codename 'nelibc_conj_imaginary'>
  return -value
end

local function nelibc_conjl_imaginary(value: clongdouble): clongdouble
    <cexport, codename 'nelibc_conjl_imaginary'>
  return -value
end

local function nelibc_cprojf_real(real: cfloat, imaginary: cfloat): cfloat
    <cexport, codename 'nelibc_cprojf_real'>
  if is_infinite32(real) or is_infinite32(imaginary) then
    return float_from_bits(0x7F800000_cuint)
  end
  return real
end

local function nelibc_cproj_real(real: cdouble, imaginary: cdouble): cdouble
    <cexport, codename 'nelibc_cproj_real'>
  if is_infinite64(real) or is_infinite64(imaginary) then
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  return real
end

local function nelibc_cprojl_real(real: clongdouble, imaginary: clongdouble): clongdouble
    <cexport, codename 'nelibc_cprojl_real'>
  if is_infinite80(real) or is_infinite80(imaginary) then
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    return infinity.value
  end
  return real
end

local function nelibc_cprojf_imaginary(real: cfloat, imaginary: cfloat): cfloat
    <cexport, codename 'nelibc_cprojf_imaginary'>
  if is_infinite32(real) or is_infinite32(imaginary) then
    return copysignf(0_cfloat, imaginary)
  end
  return imaginary
end

local function nelibc_cproj_imaginary(real: cdouble, imaginary: cdouble): cdouble
    <cexport, codename 'nelibc_cproj_imaginary'>
  if is_infinite64(real) or is_infinite64(imaginary) then
    return copysign(0_cdouble, imaginary)
  end
  return imaginary
end

local function nelibc_cprojl_imaginary(real: clongdouble, imaginary: clongdouble): clongdouble
    <cexport, codename 'nelibc_cprojl_imaginary'>
  if is_infinite80(real) or is_infinite80(imaginary) then
    return copysignl(0_clongdouble, imaginary)
  end
  return imaginary
end

local function nelibc_cargf(real: cfloat, imaginary: cfloat): cfloat
    <cexport, codename 'nelibc_cargf'>
  return atan2f(imaginary, real)
end

local function nelibc_carg(real: cdouble, imaginary: cdouble): cdouble
    <cexport, codename 'nelibc_carg'>
  return atan2(imaginary, real)
end

local function nelibc_cargl(real: clongdouble, imaginary: clongdouble): clongdouble
    <cexport, codename 'nelibc_cargl'>
  return atan2l(imaginary, real)
end

-- Scaled principal square root: intermediate ratios stay in [0, 1], so inputs
-- near the largest finite value do not overflow while forming x*x or x+y.
local function nelibc_csqrtf_parts(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_csqrtf_parts'>
  if is_infinite32(y) then
    real_out[0] = float_from_bits(0x7F800000_cuint)
    imaginary_out[0] = copysignf(float_from_bits(0x7F800000_cuint), y)
    return
  end
  if is_infinite32(x) then
    if x > 0_cfloat then
      real_out[0] = x
      if is_nan32(y) then
        imaginary_out[0] = x + y
      else
        imaginary_out[0] = copysignf(0_cfloat, y)
      end
    else
      if is_nan32(y) then
        real_out[0] = x + y
      else
        real_out[0] = 0_cfloat
      end
      imaginary_out[0] = copysignf(float_from_bits(0x7F800000_cuint), y)
    end
    return
  end
  if is_nan32(x) or is_nan32(y) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  if x == 0_cfloat and y == 0_cfloat then
    real_out[0] = 0_cfloat
    imaginary_out[0] = y
    return
  end
  local ax = fabsf(x)
  local ay = fabsf(y)
  local magnitude: cfloat
  if ax >= ay then
    local ratio = ay / ax
    magnitude = sqrtf(ax) * sqrtf((1_cfloat + sqrtf(1_cfloat + ratio * ratio)) * 0.5_cfloat)
  else
    local ratio = ax / ay
    magnitude = sqrtf(ay) * sqrtf((ratio + sqrtf(1_cfloat + ratio * ratio)) * 0.5_cfloat)
  end
  if x >= 0_cfloat then
    real_out[0] = magnitude
    imaginary_out[0] = y / (2_cfloat * magnitude)
  else
    real_out[0] = ay / (2_cfloat * magnitude)
    imaginary_out[0] = copysignf(magnitude, y)
  end
end

local function nelibc_csqrt_parts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_csqrt_parts'>
  if is_infinite64(y) then
    real_out[0] = double_from_bits(0x7ff0000000000000_culonglong)
    imaginary_out[0] = copysign(double_from_bits(0x7ff0000000000000_culonglong), y)
    return
  end
  if is_infinite64(x) then
    if x > 0_cdouble then
      real_out[0] = x
      if is_nan64(y) then
        imaginary_out[0] = x + y
      else
        imaginary_out[0] = copysign(0_cdouble, y)
      end
    else
      if is_nan64(y) then
        real_out[0] = x + y
      else
        real_out[0] = 0_cdouble
      end
      imaginary_out[0] = copysign(double_from_bits(0x7ff0000000000000_culonglong), y)
    end
    return
  end
  if is_nan64(x) or is_nan64(y) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  if x == 0_cdouble and y == 0_cdouble then
    real_out[0] = 0_cdouble
    imaginary_out[0] = y
    return
  end
  local ax = fabs(x)
  local ay = fabs(y)
  local magnitude: cdouble
  if ax >= ay then
    local ratio = ay / ax
    magnitude = sqrt(ax) * sqrt((1_cdouble + sqrt(1_cdouble + ratio * ratio)) * 0.5_cdouble)
  else
    local ratio = ax / ay
    magnitude = sqrt(ay) * sqrt((ratio + sqrt(1_cdouble + ratio * ratio)) * 0.5_cdouble)
  end
  if x >= 0_cdouble then
    real_out[0] = magnitude
    imaginary_out[0] = y / (2_cdouble * magnitude)
  else
    real_out[0] = ay / (2_cdouble * magnitude)
    imaginary_out[0] = copysign(magnitude, y)
  end
end

local function nelibc_csqrtl_parts(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_csqrtl_parts'>
  if is_infinite80(y) then
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    real_out[0] = infinity.value
    imaginary_out[0] = copysignl(infinity.value, y)
    return
  end
  if is_infinite80(x) then
    if x > 0_clongdouble then
      real_out[0] = x
      if is_nan80(y) then
        imaginary_out[0] = x + y
      else
        imaginary_out[0] = copysignl(0_clongdouble, y)
      end
    else
      local infinity: LongDoubleBits = {
        parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
      }
      if is_nan80(y) then
        real_out[0] = x + y
      else
        real_out[0] = 0_clongdouble
      end
      imaginary_out[0] = copysignl(infinity.value, y)
    end
    return
  end
  if is_nan80(x) or is_nan80(y) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  if x == 0_clongdouble and y == 0_clongdouble then
    real_out[0] = 0_clongdouble
    imaginary_out[0] = y
    return
  end
  local ax = fabsl(x)
  local ay = fabsl(y)
  local magnitude: clongdouble
  if ax >= ay then
    local ratio = ay / ax
    magnitude = sqrtl(ax) * sqrtl((1_clongdouble + sqrtl(1_clongdouble + ratio * ratio)) * 0.5_clongdouble)
  else
    local ratio = ax / ay
    magnitude = sqrtl(ay) * sqrtl((ratio + sqrtl(1_clongdouble + ratio * ratio)) * 0.5_clongdouble)
  end
  if x >= 0_clongdouble then
    real_out[0] = magnitude
    imaginary_out[0] = y / (2_clongdouble * magnitude)
  else
    real_out[0] = ay / (2_clongdouble * magnitude)
    imaginary_out[0] = copysignl(magnitude, y)
  end
end

-- Advance one encoding in the 80-bit extended-precision value ordering.
local function nextafterl(x: clongdouble, y: clongdouble): clongdouble
    <cexport, codename 'nextafterl'>
  if is_signaling_nan80(x) then return x + x end
  if is_signaling_nan80(y) then return y + y end
  if is_nan80(x) or is_nan80(y) then return x + y end
  if x == y then return y end

  local current: LongDoubleBits = {value = x}
  local target: LongDoubleBits = {value = y}
  local sign = current.parts.sign_exponent & 0x8000_cushort
  local exponent = current.parts.sign_exponent & 0x7fff_cushort
  local magnitude_increases = (sign == 0_cushort and x < y) or
      (sign ~= 0_cushort and x > y)

  if x == 0_clongdouble then
    current.parts.significand = 1_culonglong
    current.parts.sign_exponent = target.parts.sign_exponent & 0x8000_cushort
  elseif magnitude_increases then
    if exponent == 0_cushort and current.parts.significand == 0x7fffffffffffffff_culonglong then
      exponent = 1_cushort
      current.parts.significand = 0x8000000000000000_culonglong
    elseif exponent ~= 0_cushort and current.parts.significand == 0xffffffffffffffff_culonglong then
      exponent = exponent + 1_cushort
      current.parts.significand = 0x8000000000000000_culonglong
    else
      current.parts.significand = current.parts.significand + 1_culonglong
    end
    current.parts.sign_exponent = sign | exponent
  else
    if exponent == 0x7fff_cushort then
      exponent = 0x7ffe_cushort
      current.parts.significand = 0xffffffffffffffff_culonglong
    elseif exponent == 1_cushort and current.parts.significand == 0x8000000000000000_culonglong then
      exponent = 0_cushort
      current.parts.significand = 0x7fffffffffffffff_culonglong
    elseif exponent > 1_cushort and current.parts.significand == 0x8000000000000000_culonglong then
      exponent = exponent - 1_cushort
      current.parts.significand = 0xffffffffffffffff_culonglong
    else
      current.parts.significand = current.parts.significand - 1_culonglong
    end
    current.parts.sign_exponent = sign | exponent
  end

  local result = current.value
  local result_exponent = current.parts.sign_exponent & 0x7fff_cushort
  if is_infinite80(result) then
    math_range_error()
    nelibc_math_raise_except(0x28_cint) -- FE_OVERFLOW | FE_INEXACT
  elseif result_exponent == 0_cushort then
    -- Both glibc and musl leave errno unchanged for zero -> minimum subnormal.
    if x ~= 0_clongdouble then math_range_error() end
    nelibc_math_raise_except(0x30_cint) -- FE_UNDERFLOW | FE_INEXACT
  end
  return result
end

local function nexttowardl(x: clongdouble, y: clongdouble): clongdouble
    <cexport, codename 'nexttowardl'>
  return nextafterl(x, y)
end

local function pio2_product_bit(product: *[0]cuint, bit_index: cint): cint <inline>
  if bit_index < 0 or bit_index >= 1272_cint then return 0_cint end
  local limb: cint = bit_index / 24_cint
  local offset: cint = bit_index % 24_cint
  return (@cint)((product[limb] >> offset) & 1_cuint)
end

local function pio2_product_bit_long(product: *[0]cuint, bit_index: cint): cint <inline>
  if bit_index < 0 or bit_index >= 16872_cint then return 0_cint end
  local limb: cint = bit_index / 24_cint
  local offset: cint = bit_index % 24_cint
  return (@cint)((product[limb] >> offset) & 1_cuint)
end

-- Payne-Hanek reduction: multiply the 53-bit significand by 1200 fixed bits
-- of 2/pi, then extract the nearest integer and two pieces of its fraction.
-- The table leaves over 170 guard bits at the largest binary64 exponent.
local function reduce_pio2(value: cdouble, quadrant: *[0]cint,
    head: *[0]cdouble, tail: *[0]cdouble): void
  local absolute = fabs(value)
  local exponent: cint = 0_cint
  local mantissa: cdouble = frexp(absolute, &exponent)
  local significand: culonglong = (@culonglong)(mantissa * 0x1p53_cdouble)
  local m: [3]cuint = {
    (@cuint)(significand & 0xFFFFFF_culonglong),
    (@cuint)((significand >> 24) & 0xFFFFFF_culonglong),
    (@cuint)(significand >> 48),
  }
  local product: [53]cuint = {}
  for i = 0, 2 do
    local carry: culonglong = 0_culonglong
    for j = 0, 49 do
      local destination = i + j
      local table_value = two_over_pi[49 - j]
      local accum = (@culonglong)(product[destination]) +
        (@culonglong)(m[i]) * (@culonglong)(table_value) + carry
      product[destination] = (@cuint)(accum & 0xFFFFFF_culonglong)
      carry = accum >> 24
    end
    product[i + 50] = (@cuint)(carry)
  end

  local shift: cint = 1253_cint - exponent
  local q = pio2_product_bit(&product[0], shift) +
    2_cint * pio2_product_bit(&product[0], shift + 1_cint)
  local fractional_head: culonglong = 0_culonglong
  local fractional_tail: culonglong = 0_culonglong
  for i = 0, 52 do
    fractional_head = (fractional_head << 1) |
      (@culonglong)(pio2_product_bit(&product[0], shift - 1_cint - i))
    fractional_tail = (fractional_tail << 1) |
      (@culonglong)(pio2_product_bit(&product[0], shift - 54_cint - i))
  end
  local fraction_hi = (@cdouble)(fractional_head) * 0x1p-53_cdouble
  local fraction_lo = (@cdouble)(fractional_tail) * 0x1p-106_cdouble
  if pio2_product_bit(&product[0], shift - 1_cint) ~= 0_cint then
    q = (q + 1_cint) & 3_cint
    fraction_hi = fraction_hi - 1_cdouble
  end
  if value < 0_cdouble then
    q = (4_cint - q) & 3_cint
    fraction_hi = -fraction_hi
    fraction_lo = -fraction_lo
  end
  quadrant[0] = q

  -- TwoProduct recovers the rounding error of fraction*pio2_hi; the low part
  -- then carries both that error and the omitted bits of the fraction.
  local pio2_hi: cdouble = 0x1.921fb54442D18p+0_cdouble
  local pio2_lo: cdouble = 6.12323399573676603587e-17_cdouble
  local product_hi = fraction_hi * pio2_hi
  local split = 0x1.0000002p+27_cdouble
  local ca = split * fraction_hi
  local a_hi = ca - (ca - fraction_hi)
  local a_lo = fraction_hi - a_hi
  local cb = split * pio2_hi
  local b_hi = cb - (cb - pio2_hi)
  local b_lo = pio2_hi - b_hi
  local product_error = ((a_hi * b_hi - product_hi) + a_hi * b_lo + a_lo * b_hi) + a_lo * b_lo
  head[0] = product_hi
  tail[0] = product_error + fraction_hi * pio2_lo + fraction_lo * pio2_hi +
    fraction_lo * pio2_lo
end

-- Binary80 Payne-Hanek reduction. The 700 limbs provide 16,800 bits of 2/pi,
-- leaving more than 350 guard bits at the maximum binary80 exponent.
local function reduce_pio2l(value: clongdouble, quadrant: *[0]cint,
    head: *[0]clongdouble, tail: *[0]clongdouble): void
  local absolute = fabsl(value)
  local exponent: cint = 0_cint
  local mantissa: clongdouble = frexpl(absolute, &exponent)
  local significand: culonglong = (@culonglong)(ldexpl(mantissa, 64_cint))
  local m: [3]cuint = {
    (@cuint)(significand & 0xFFFFFF_culonglong),
    (@cuint)((significand >> 24) & 0xFFFFFF_culonglong),
    (@cuint)(significand >> 48),
  }
  local product: [703]cuint = {}
  for i = 0, 2 do
    local carry: culonglong = 0_culonglong
    for j = 0, 699 do
      local destination = i + j
      local table_value = two_over_pi[699 - j]
      local accum = (@culonglong)(product[destination]) +
        (@culonglong)(m[i]) * (@culonglong)(table_value) + carry
      product[destination] = (@cuint)(accum & 0xFFFFFF_culonglong)
      carry = accum >> 24
    end
    product[i + 700] = (@cuint)(carry)
  end

  local shift: cint = 16864_cint - exponent
  local q = pio2_product_bit_long(&product[0], shift) +
    2_cint * pio2_product_bit_long(&product[0], shift + 1_cint)
  local fractional_head: culonglong = 0_culonglong
  local fractional_tail: culonglong = 0_culonglong
  for i = 0, 63 do
    fractional_head = (fractional_head << 1) |
      (@culonglong)(pio2_product_bit_long(&product[0], shift - 1_cint - i))
    fractional_tail = (fractional_tail << 1) |
      (@culonglong)(pio2_product_bit_long(&product[0], shift - 65_cint - i))
  end
  local fraction_hi =
    ldexpl((@clongdouble)(fractional_head >> 32), -32_cint) +
    ldexpl((@clongdouble)(fractional_head & 0xffffffff_culonglong), -64_cint)
  local fraction_lo =
    ldexpl((@clongdouble)(fractional_tail >> 32), -96_cint) +
    ldexpl((@clongdouble)(fractional_tail & 0xffffffff_culonglong), -128_cint)
  if pio2_product_bit_long(&product[0], shift - 1_cint) ~= 0_cint then
    q = (q + 1_cint) & 3_cint
    fraction_hi = fraction_hi - 1_clongdouble
  end
  if value < 0_clongdouble then
    q = (4_cint - q) & 3_cint
    fraction_hi = -fraction_hi
    fraction_lo = -fraction_lo
  end
  quadrant[0] = q

  local pio2_hi = nelibc_pio2l_hi_hw()
  local pio2_lo = nelibc_pio2l_lo_hw()
  local product_hi = fraction_hi * pio2_hi
  local split: clongdouble = 0x1.00000001p+32_clongdouble
  local ca = split * fraction_hi
  local a_hi = ca - (ca - fraction_hi)
  local a_lo = fraction_hi - a_hi
  local cb = split * pio2_hi
  local b_hi = cb - (cb - pio2_hi)
  local b_lo = pio2_hi - b_hi
  local product_error = ((a_hi * b_hi - product_hi) + a_hi * b_lo + a_lo * b_hi) + a_lo * b_lo
  head[0] = product_hi
  tail[0] = product_error + fraction_hi * pio2_lo + fraction_lo * pio2_hi +
    fraction_lo * pio2_lo
end

local function sin_kernel(x: cdouble, y: cdouble): cdouble
  local z = x * x
  local w = z * z
  local r = 8.33333333332248946124e-3_cdouble + z *
    (-1.98412698298579493134e-4_cdouble + z * 2.75573137070700676789e-6_cdouble) +
    z * w * (-2.50507602534068634195e-8_cdouble + z * 1.58969099521155010221e-10_cdouble)
  local v = z * x
  if y == 0_cdouble then
    return x + v * (-1.66666666666666324348e-1_cdouble + z * r)
  end
  return x - ((z * (0.5_cdouble * y - v * r) - y) - v * -1.66666666666666324348e-1_cdouble)
end

local function cos_kernel(x: cdouble, y: cdouble): cdouble
  local z = x * x
  local w = z * z
  local r = z * (4.16666666666666019037e-2_cdouble + z *
    (-1.38888888888741095749e-3_cdouble + z * 2.48015872894767294178e-5_cdouble)) +
    w * w * (-2.75573143513906633035e-7_cdouble + z *
      (2.08757232129817482790e-9_cdouble - z * 1.13596475577881948265e-11_cdouble))
  local half_square = 0.5_cdouble * z
  local rounded_base = 1_cdouble - half_square
  return rounded_base + (((1_cdouble - rounded_base) - half_square) + (z * r - x * y))
end

local function sin(value: cdouble): cdouble <cexport, codename 'sin'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    math_domain_error()
    return value - value
  end
  local ix = (@cuint)(bits_of_double(value) >> 32) & 0x7FFFFFFF_cuint
  if ix < 0x3E500000_cuint then -- |x| < 2^-26
    -- sin(x) rounds to x: raise inexact if x != 0 and underflow if subnormal.
    if ix < 0x00100000_cuint then
      force_eval(value / 0x1p120_cdouble)
    else
      force_eval(value + 0x1p120_cdouble)
    end
    return value
  end
  local quadrant: cint = 0_cint
  local x: cdouble = value
  local y: cdouble = 0_cdouble
  if fabs(value) > 0x1.921FB54442D18P-1_cdouble then
    reduce_pio2(value, &quadrant, &x, &y)
  end
  local sine = sin_kernel(x, y)
  local cosine = cos_kernel(x, y)
  if quadrant == 0_cint then return sine end
  if quadrant == 1_cint then return cosine end
  if quadrant == 2_cint then return -sine end
  return -cosine
end

local function cos(value: cdouble): cdouble <cexport, codename 'cos'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    math_domain_error()
    return value - value
  end
  if fabs(value) < 0x1p-27_cdouble then return 1_cdouble end
  local quadrant: cint = 0_cint
  local x: cdouble = value
  local y: cdouble = 0_cdouble
  if fabs(value) > 0x1.921FB54442D18P-1_cdouble then
    reduce_pio2(value, &quadrant, &x, &y)
  end
  local sine = sin_kernel(x, y)
  local cosine = cos_kernel(x, y)
  if quadrant == 0_cint then return cosine end
  if quadrant == 1_cint then return -sine end
  if quadrant == 2_cint then return -cosine end
  return sine
end

local function sincos(value: cdouble, sine_out: *[0]cdouble, cosine_out: *[0]cdouble)
    <cexport, codename 'sincos'>
  if value ~= value then
    local nan_value = value + value
    sine_out[0] = nan_value
    cosine_out[0] = nan_value
    return
  end
  if is_infinite64(value) then
    math_domain_error()
    local nan_value = value - value
    sine_out[0] = nan_value
    cosine_out[0] = nan_value
    return
  end
  if fabs(value) < 0x1p-27_cdouble then
    sine_out[0] = value
    cosine_out[0] = 1_cdouble
    return
  end
  local quadrant: cint = 0_cint
  local x: cdouble = value
  local y: cdouble = 0_cdouble
  if fabs(value) > 0x1.921FB54442D18P-1_cdouble then
    reduce_pio2(value, &quadrant, &x, &y)
  end
  local sine = sin_kernel(x, y)
  local cosine = cos_kernel(x, y)
  if quadrant == 0_cint then
    sine_out[0], cosine_out[0] = sine, cosine
  elseif quadrant == 1_cint then
    sine_out[0], cosine_out[0] = cosine, -sine
  elseif quadrant == 2_cint then
    sine_out[0], cosine_out[0] = -sine, -cosine
  else
    sine_out[0], cosine_out[0] = -cosine, sine
  end
end

local function sincosf(value: cfloat, sine_out: *[0]cfloat, cosine_out: *[0]cfloat)
    <cexport, codename 'sincosf'>
  local sine_value: cdouble
  local cosine_value: cdouble
  sincos((@cdouble)(value), &sine_value, &cosine_value)
  sine_out[0] = (@cfloat)(sine_value)
  cosine_out[0] = (@cfloat)(cosine_value)
end

local function sincosl(value: clongdouble, sine_out: *[0]clongdouble,
    cosine_out: *[0]clongdouble): void <cexport, codename 'sincosl'>
  if is_nan80(value) then
    local nan_value = value + value
    sine_out[0], cosine_out[0] = nan_value, nan_value
    return
  end
  if is_infinite80(value) then
    math_domain_error()
    local nan_value = value - value
    sine_out[0], cosine_out[0] = nan_value, nan_value
    return
  end
  if value == 0_clongdouble then
    sine_out[0], cosine_out[0] = value, 1_clongdouble
    return
  end

  local quadrant: cint = 0_cint
  local x: clongdouble = value
  local y: clongdouble = 0_clongdouble
  if fabsl(value) > 0.7853981633974483096282022398515465511082_clongdouble then
    reduce_pio2l(value, &quadrant, &x, &y)
  end
  local cosine: clongdouble = 0_clongdouble
  local sine = nelibc_sincosl_hw(x + y, &cosine)
  if quadrant == 0_cint then
    sine_out[0], cosine_out[0] = sine, cosine
  elseif quadrant == 1_cint then
    sine_out[0], cosine_out[0] = cosine, -sine
  elseif quadrant == 2_cint then
    sine_out[0], cosine_out[0] = -sine, -cosine
  else
    sine_out[0], cosine_out[0] = -cosine, sine
  end
end

local function sinl(value: clongdouble): clongdouble <cexport, codename 'sinl'>
  local sine: clongdouble
  local cosine: clongdouble
  sincosl(value, &sine, &cosine)
  return sine
end

local function cosl(value: clongdouble): clongdouble <cexport, codename 'cosl'>
  local sine: clongdouble
  local cosine: clongdouble
  sincosl(value, &sine, &cosine)
  return cosine
end

local function tanl(value: clongdouble): clongdouble <cexport, codename 'tanl'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    math_domain_error()
    return value - value
  end
  if value == 0_clongdouble then return value end
  local quadrant: cint = 0_cint
  local x: clongdouble = value
  local y: clongdouble = 0_clongdouble
  if fabsl(value) > 0.7853981633974483096282022398515465511082_clongdouble then
    reduce_pio2l(value, &quadrant, &x, &y)
  end
  local reduced_tangent = nelibc_tanl_hw(x + y)
  -- An odd multiple of pi/2 leaves -cot(remainder); an even one leaves tan.
  if (quadrant & 1_cint) ~= 0_cint then
    return -1_clongdouble / reduced_tangent
  end
  return reduced_tangent
end

local function sinf(value: cfloat): cfloat <cexport, codename 'sinf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  return (@cfloat)(sin((@cdouble)(value)))
end

-- lgamma_r follows musl 1.2.5 src/math/lgamma_r.c (fdlibm e_lgamma_r.c):
-- rational approximations on [0,2), a polynomial correction on [2,8), and
-- Stirling's series above, with the reflection formula for negative x.
local lgamma_pi: cdouble = 3.14159265358979311600e+00_cdouble
local lgamma_a: [12]cdouble = {
  7.72156649015328655494e-02_cdouble, 3.22467033424113591611e-01_cdouble,
  6.73523010531292681824e-02_cdouble, 2.05808084325167332806e-02_cdouble,
  7.38555086081402883957e-03_cdouble, 2.89051383673415629091e-03_cdouble,
  1.19270763183362067845e-03_cdouble, 5.10069792153511336608e-04_cdouble,
  2.20862790713908385557e-04_cdouble, 1.08011567247583939954e-04_cdouble,
  2.52144565451257326939e-05_cdouble, 4.48640949618915160150e-05_cdouble,
}
local lgamma_tc: cdouble = 1.46163214496836224576e+00_cdouble
local lgamma_tf: cdouble = -1.21486290535849611461e-01_cdouble
local lgamma_tt: cdouble = -3.63867699703950536541e-18_cdouble
local lgamma_t: [15]cdouble = {
  4.83836122723810047042e-01_cdouble, -1.47587722994593911752e-01_cdouble,
  6.46249402391333854778e-02_cdouble, -3.27885410759859649565e-02_cdouble,
  1.79706750811820387126e-02_cdouble, -1.03142241298341437450e-02_cdouble,
  6.10053870246291332635e-03_cdouble, -3.68452016781138256760e-03_cdouble,
  2.25964780900612472250e-03_cdouble, -1.40346469989232843813e-03_cdouble,
  8.81081882437654011382e-04_cdouble, -5.38595305356740546715e-04_cdouble,
  3.15632070903625950361e-04_cdouble, -3.12754168375120860518e-04_cdouble,
  3.35529192635519073543e-04_cdouble,
}
local lgamma_u: [6]cdouble = {
  -7.72156649015328655494e-02_cdouble, 6.32827064025093366517e-01_cdouble,
  1.45492250137234768737e+00_cdouble, 9.77717527963372745603e-01_cdouble,
  2.28963728064692451092e-01_cdouble, 1.33810918536787660377e-02_cdouble,
}
local lgamma_v: [6]cdouble = {
  0_cdouble, 2.45597793713041134822e+00_cdouble, 2.12848976379893395361e+00_cdouble,
  7.69285150456672783825e-01_cdouble, 1.04222645593369134254e-01_cdouble,
  3.21709242282423911810e-03_cdouble,
}
local lgamma_s: [7]cdouble = {
  -7.72156649015328655494e-02_cdouble, 2.14982415960608852501e-01_cdouble,
  3.25778796408930981787e-01_cdouble, 1.46350472652464452805e-01_cdouble,
  2.66422703033638609560e-02_cdouble, 1.84028451407337715652e-03_cdouble,
  3.19475326584100867617e-05_cdouble,
}
local lgamma_rc: [7]cdouble = {
  0_cdouble, 1.39200533467621045958e+00_cdouble, 7.21935547567138069525e-01_cdouble,
  1.71933865632803078993e-01_cdouble, 1.86459191715652901344e-02_cdouble,
  7.77942496381893596434e-04_cdouble, 7.32668430744625636189e-06_cdouble,
}
local lgamma_w: [7]cdouble = {
  4.18938533204672725052e-01_cdouble, 8.33333333333329678849e-02_cdouble,
  -2.77777777728775536470e-03_cdouble, 7.93650558643019558500e-04_cdouble,
  -5.95187557450339963135e-04_cdouble, 8.36339918996282139126e-04_cdouble,
  -1.63092934096575273989e-03_cdouble,
}

-- sin(pi*x) for the reflection formulas; x is reduced modulo 2 first.
local function gamma_sin_pi(value: cdouble): cdouble
  local x = 2_cdouble * (value * 0.5_cdouble - round_binary64(value * 0.5_cdouble, 1_cint))
  local n = (@cint)(x * 4_cdouble)
  n = (n + 1_cint) // 2_cint
  x = x - (@cdouble)(n) * 0.5_cdouble
  x = x * lgamma_pi
  if n == 1_cint then return cos_kernel(x, 0_cdouble) end
  if n == 2_cint then return sin_kernel(-x, 0_cdouble) end
  if n == 3_cint then return -cos_kernel(x, 0_cdouble) end
  return sin_kernel(x, 0_cdouble)
end

local function lgamma_r(value: cdouble, sign_result: *[0]cint): cdouble
    <cexport, codename 'lgamma_r'>
  sign_result[0] = 1
  local bits = bits_of_double(value)
  local negative = (bits >> 63) ~= 0_culonglong
  local ix = (@cuint)(bits >> 32) & 0x7FFFFFFF_cuint
  local x = value
  if ix >= 0x7FF00000_cuint then return x * x end -- +-inf, NaN
  if ix < ((0x3FF_cuint - 70_cuint) << 20) then -- |x| < 2^-70: -log(|x|)
    if negative then
      x = -x
      sign_result[0] = -1
    end
    return -log(x)
  end
  local nadj: cdouble = 0_cdouble
  if negative then
    x = -x
    local t = gamma_sin_pi(x)
    if t == 0_cdouble then -- negative integer: pole
      math_range_error()
      return 1_cdouble / (x - x)
    end
    if t > 0_cdouble then
      sign_result[0] = -1
    else
      t = -t
    end
    nadj = log(lgamma_pi / (t * x))
  end
  local r: cdouble
  if (ix == 0x3FF00000_cuint or ix == 0x40000000_cuint) and (@cuint)(bits & 0xFFFFFFFF_culonglong) == 0_cuint then
    r = 0_cdouble -- lgamma(1) = lgamma(2) = 0
  elseif ix < 0x40000000_cuint then -- x < 2
    local y: cdouble
    local i: cint
    if ix <= 0x3FECCCCC_cuint then -- lgamma(x) = lgamma(x+1) - log(x)
      r = -log(x)
      if ix >= 0x3FE76944_cuint then
        y = 1_cdouble - x
        i = 0_cint
      elseif ix >= 0x3FCDA661_cuint then
        y = x - (lgamma_tc - 1_cdouble)
        i = 1_cint
      else
        y = x
        i = 2_cint
      end
    else
      r = 0_cdouble
      if ix >= 0x3FFBB4C3_cuint then -- [1.7316, 2]
        y = 2_cdouble - x
        i = 0_cint
      elseif ix >= 0x3FF3B4C4_cuint then -- [1.23, 1.73]
        y = x - lgamma_tc
        i = 1_cint
      else
        y = x - 1_cdouble
        i = 2_cint
      end
    end
    if i == 0_cint then
      local z = y * y
      local p1 = lgamma_a[0] + z * (lgamma_a[2] + z * (lgamma_a[4] + z * (lgamma_a[6] +
        z * (lgamma_a[8] + z * lgamma_a[10]))))
      local p2 = z * (lgamma_a[1] + z * (lgamma_a[3] + z * (lgamma_a[5] + z * (lgamma_a[7] +
        z * (lgamma_a[9] + z * lgamma_a[11])))))
      local p = y * p1 + p2
      r = r + (p - 0.5_cdouble * y)
    elseif i == 1_cint then
      local z = y * y
      local w = z * y
      local p1 = lgamma_t[0] + w * (lgamma_t[3] + w * (lgamma_t[6] + w * (lgamma_t[9] + w * lgamma_t[12])))
      local p2 = lgamma_t[1] + w * (lgamma_t[4] + w * (lgamma_t[7] + w * (lgamma_t[10] + w * lgamma_t[13])))
      local p3 = lgamma_t[2] + w * (lgamma_t[5] + w * (lgamma_t[8] + w * (lgamma_t[11] + w * lgamma_t[14])))
      local p = z * p1 - (lgamma_tt - w * (p2 + y * p3))
      r = r + lgamma_tf + p
    else
      local p1 = y * (lgamma_u[0] + y * (lgamma_u[1] + y * (lgamma_u[2] + y * (lgamma_u[3] +
        y * (lgamma_u[4] + y * lgamma_u[5])))))
      local p2 = 1_cdouble + y * (lgamma_v[1] + y * (lgamma_v[2] + y * (lgamma_v[3] +
        y * (lgamma_v[4] + y * lgamma_v[5]))))
      r = r + (-0.5_cdouble * y + p1 / p2)
    end
  elseif ix < 0x40200000_cuint then -- x < 8
    local i = (@cint)(x)
    local y = x - (@cdouble)(i)
    local p = y * (lgamma_s[0] + y * (lgamma_s[1] + y * (lgamma_s[2] + y * (lgamma_s[3] +
      y * (lgamma_s[4] + y * (lgamma_s[5] + y * lgamma_s[6]))))))
    local q = 1_cdouble + y * (lgamma_rc[1] + y * (lgamma_rc[2] + y * (lgamma_rc[3] +
      y * (lgamma_rc[4] + y * (lgamma_rc[5] + y * lgamma_rc[6])))))
    r = 0.5_cdouble * y + p / q
    local z = 1_cdouble -- lgamma(1+s) = log(s) + lgamma(s)
    if i >= 7_cint then z = z * (y + 6_cdouble) end
    if i >= 6_cint then z = z * (y + 5_cdouble) end
    if i >= 5_cint then z = z * (y + 4_cdouble) end
    if i >= 4_cint then z = z * (y + 3_cdouble) end
    if i >= 3_cint then
      z = z * (y + 2_cdouble)
      r = r + log(z)
    end
  elseif ix < 0x43900000_cuint then -- 8 <= x < 2^58
    local t = log(x)
    local z = 1_cdouble / x
    local y = z * z
    local w = lgamma_w[0] + z * (lgamma_w[1] + y * (lgamma_w[2] + y * (lgamma_w[3] +
      y * (lgamma_w[4] + y * (lgamma_w[5] + y * lgamma_w[6])))))
    r = (x - 0.5_cdouble) * (t - 1_cdouble) + w
  else -- 2^58 <= x <= inf
    r = x * (log(x) - 1_cdouble)
  end
  if negative then r = nadj - r end
  return r
end

local function lgamma(value: cdouble): cdouble <cexport, codename 'lgamma'>
  local sign: cint = 1
  local result = lgamma_r(value, &sign)
  signgam = sign
  return result
end

local function lgammaf(value: cfloat): cfloat <cexport, codename 'lgammaf'>
  local sign: cint = 1
  local result = (@cfloat)(lgamma_r((@cdouble)(value), &sign))
  signgam = sign
  return result
end

local function lgammaf_r(value: cfloat, sign_result: *[0]cint): cfloat
    <cexport, codename 'lgammaf_r'>
  local sign: cint = 1
  local result = lgamma_r((@cdouble)(value), &sign)
  sign_result[0] = sign
  return (@cfloat)(result)
end

-- tgamma follows musl 1.2.5 src/math/tgamma.c (Szabolcs Nagy, MIT): a
-- Lanczos sum with g = 6.0247 and the reflection formula for negative x.
local tgamma_gmhalf: cdouble = 5.524680040776729583740234375_cdouble
local tgamma_fact: [23]cdouble = {
  1_cdouble, 1_cdouble, 2_cdouble, 6_cdouble, 24_cdouble, 120_cdouble, 720_cdouble,
  5040_cdouble, 40320_cdouble, 362880_cdouble, 3628800_cdouble, 39916800_cdouble,
  479001600_cdouble, 6227020800_cdouble, 87178291200_cdouble, 1307674368000_cdouble,
  20922789888000_cdouble, 355687428096000_cdouble, 6402373705728000_cdouble,
  121645100408832000_cdouble, 2432902008176640000_cdouble,
  51090942171709440000_cdouble, 1124000727777607680000_cdouble,
}

local function tgamma_s(x: cdouble): cdouble
  local num: cdouble = 0_cdouble
  local den: cdouble = 0_cdouble
  -- Large x is evaluated in 1/x to avoid overflow.
  if x < 8_cdouble then
    for i = 12, 0, -1 do
      num = num * x + gamma_snum[i]
      den = den * x + gamma_sden[i]
    end
  else
    for i = 0, 12 do
      num = num / x + gamma_snum[i]
      den = den / x + gamma_sden[i]
    end
  end
  return num / den
end

local function tgamma(value: cdouble): cdouble <cexport, codename 'tgamma'>
  local bits = bits_of_double(value)
  local ix = (@cuint)(bits >> 32) & 0x7FFFFFFF_cuint
  local negative = (bits >> 63) ~= 0_culonglong
  local x = value
  if ix >= 0x7FF00000_cuint then
    -- tgamma(nan) = nan, tgamma(inf) = inf, tgamma(-inf) = nan with INVALID
    if negative and not is_nan64(x) then math_domain_error() end
    return x + double_from_bits(0x7FF0000000000000_culonglong)
  end
  if ix < ((0x3FF_cuint - 54_cuint) << 20) then
    -- |x| < 2^-54: tgamma(x) ~ 1/x; +-0 raises DIVBYZERO
    if x == 0_cdouble then math_range_error() end
    return 1_cdouble / x
  end
  -- Integer arguments; a non-integer raises inexact here.
  if x == round_binary64(x, 1_cint) then
    if negative then return math_invalid(x) end
    if x <= 23_cdouble then return tgamma_fact[(@cint)(x) - 1_cint] end
  end
  if ix >= 0x40670000_cuint then -- |x| >= 184
    math_range_error()
    if negative then
      -- tgamma(x <= -184) = +-0 with underflow
      force_evalf((@cfloat)(0x1p-126_cdouble / x))
      if round_binary64(x, 1_cint) * 0.5_cdouble == round_binary64(x * 0.5_cdouble, 1_cint) then
        return 0_cdouble
      end
      return double_from_bits(0x8000000000000000_culonglong)
    end
    return x * 0x1p1023_cdouble -- tgamma(x >= 172) = inf with overflow
  end
  local absx = x
  if negative then absx = -x end
  -- Track the rounding error of absx + g - 0.5.
  local y = absx + tgamma_gmhalf
  local dy: cdouble
  if absx > tgamma_gmhalf then
    dy = y - absx
    dy = dy - tgamma_gmhalf
  else
    dy = y - tgamma_gmhalf
    dy = dy - absx
  end
  local z = absx - 0.5_cdouble
  local r = tgamma_s(absx) * exp(-y)
  if negative then
    -- Reflection formula; sinpi(absx) is not 0, integers are handled above.
    r = -lgamma_pi / (gamma_sin_pi(absx) * absx * r)
    dy = -dy
    z = -z
  end
  r = r + dy * (tgamma_gmhalf + 0.5_cdouble) * r / y
  z = pow(y, 0.5_cdouble * z)
  local result = r * z * z
  if is_infinite64(result) or result == 0_cdouble then math_range_error() end
  return result
end

local function tgammaf(value: cfloat): cfloat <cexport, codename 'tgammaf'>
  local result = (@cfloat)(tgamma((@cdouble)(value)))
  if is_infinite32(result) or (result == 0_cfloat and value ~= 0_cfloat) then math_range_error() end
  return result
end

local function gamma_lanczos_long_positive(value: clongdouble): clongdouble
  -- Stirling's expansion after shifting the argument to 16. Coefficients are
  -- kept as exact integer ratios so Nelua's decimal-literal conversion does
  -- not silently limit binary80 constants to binary64 precision.
  local numerators: [12]clonglong = {
    1_clonglong, -1_clonglong, 1_clonglong, -1_clonglong,
    1_clonglong, -691_clonglong, 1_clonglong, -3617_clonglong,
    43867_clonglong, -174611_clonglong, 77683_clonglong, -236364091_clonglong
  }
  local denominators: [12]clonglong = {
    12_clonglong, 360_clonglong, 1260_clonglong, 1680_clonglong,
    1188_clonglong, 360360_clonglong, 156_clonglong, 122400_clonglong,
    244188_clonglong, 125400_clonglong, 5796_clonglong, 1506960_clonglong
  }
  local shifted = value
  local recurrence: clongdouble = 0_clongdouble
  while shifted < 16_clongdouble do
    recurrence = recurrence - logl(shifted)
    shifted = shifted + 1_clongdouble
  end
  local inverse = 1_clongdouble / shifted
  local inverse_power = inverse
  local inverse_square = inverse * inverse
  local correction: clongdouble = 0_clongdouble
  for i = 0, 11 do
    local coefficient = (@clongdouble)(numerators[i]) / (@clongdouble)(denominators[i])
    correction = correction + coefficient * inverse_power
    inverse_power = inverse_power * inverse_square
  end
  local pi = nelibc_x87_pi()
  local half_log_two_pi = 0.5_clongdouble * logl(2_clongdouble * pi)
  local z = shifted - 0.5_clongdouble
  local result = recurrence + z * logl(shifted) - shifted + half_log_two_pi + correction
  if is_infinite80(result) then math_range_error() end
  return result
end

local function gamma_sin_pi_long(value: clongdouble): clongdouble
  if value >= 0x1p64_clongdouble then return 0_clongdouble end
  local reduced = value - 2_clongdouble * (@clongdouble)((@culonglong)(value * 0.5_clongdouble))
  return sinl(nelibc_x87_pi() * reduced)
end

local function lgammal_r(value: clongdouble, sign_result: *[0]cint): clongdouble
    <cexport, codename 'lgammal_r'>
  sign_result[0] = 1
  if is_nan80(value) or is_infinite80(value) then return value * value end
  local magnitude = fabsl(value)
  if magnitude == 0_clongdouble then
    math_range_error()
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    return infinity.value
  end
  if value == 1_clongdouble or value == 2_clongdouble then return 0_clongdouble end
  if value > 0_clongdouble then return gamma_lanczos_long_positive(value) end
  if magnitude < 0x1p-64_clongdouble then
    sign_result[0] = -1
    return -logl(magnitude)
  end
  if magnitude == truncl(magnitude) then
    math_range_error()
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    return infinity.value
  end
  local sine = gamma_sin_pi_long(magnitude)
  if sine == 0_clongdouble then
    math_range_error()
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    return infinity.value
  end
  if sine > 0_clongdouble then sign_result[0] = -1 end
  return logl(nelibc_x87_pi()) - logl(magnitude) - logl(fabsl(sine)) -
    gamma_lanczos_long_positive(magnitude)
end

local function lgammal(value: clongdouble): clongdouble <cexport, codename 'lgammal'>
  local sign: cint = 1
  local result = lgammal_r(value, &sign)
  signgam = sign
  return result
end

local function tgammal(value: clongdouble): clongdouble <cexport, codename 'tgammal'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    if value > 0_clongdouble then return value end
    math_domain_error()
    return sqrtl(-1_clongdouble)
  end
  if value == 0_clongdouble then
    math_range_error()
    local sign_exponent: cushort = 0x7fff_cushort
    if is_negative_zero80(value) then sign_exponent = 0xffff_cushort end
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = sign_exponent}
    }
    return infinity.value
  end
  local sign: cint = 1
  local logarithm = lgammal_r(value, &sign)
  if is_infinite80(logarithm) then
    if value < 0_clongdouble and fabsl(value) == truncl(fabsl(value)) then
      math_domain_error()
      return sqrtl(-1_clongdouble)
    end
    if value > 0_clongdouble then return expl(logarithm) end
    math_range_error()
    if sign < 0_cint then
      local negative_zero: LongDoubleBits = {parts = {significand = 0_culonglong, sign_exponent = 0x8000_cushort}}
      return negative_zero.value
    end
    return 0_clongdouble
  end
  local result = expl(logarithm)
  if sign < 0_cint then result = -result end
  if is_infinite80(result) or result == 0_clongdouble then math_range_error() end
  return result
end



local function cosf(value: cfloat): cfloat <cexport, codename 'cosf'>
  return (@cfloat)(cos((@cdouble)(value)))
end

-- tan follows musl 1.2.5 src/math/tan.c and __tan.c (fdlibm k_tan.c).
local tan_t: [13]cdouble = {
  3.33333333333334091986e-01_cdouble, 1.33333333333201242699e-01_cdouble,
  5.39682539762260521377e-02_cdouble, 2.18694882948595424599e-02_cdouble,
  8.86323982359930005737e-03_cdouble, 3.59207910759131235356e-03_cdouble,
  1.45620945432529025516e-03_cdouble, 5.88041240820264096874e-04_cdouble,
  2.46463134818469906812e-04_cdouble, 7.81794442939557092300e-05_cdouble,
  7.14072491382608190305e-05_cdouble, -1.85586374855275456654e-05_cdouble,
  2.59073051863633712884e-05_cdouble,
}

-- tan(x+y) for |x| <= pi/4 with y the reduction tail; odd selects -1/tan.
local function tan_kernel(x: cdouble, y: cdouble, odd: cint): cdouble
  local hx = (@cuint)(bits_of_double(x) >> 32)
  local big = (hx & 0x7FFFFFFF_cuint) >= 0x3FE59428_cuint -- |x| >= 0.6744
  local negative = false
  if big then
    negative = (hx >> 31) ~= 0_cuint
    if negative then
      x = -x
      y = -y
    end
    x = (0x1.921FB54442D18P-1_cdouble - x) + (0x1.1A62633145C07P-55_cdouble - y)
    y = 0_cdouble
  end
  local z = x * x
  local w = z * z
  -- x^5*(T[1]+x^2*T[2]+...) split into even and odd parts
  local r = tan_t[1] + w * (tan_t[3] + w * (tan_t[5] + w * (tan_t[7] + w *
    (tan_t[9] + w * tan_t[11]))))
  local v = z * (tan_t[2] + w * (tan_t[4] + w * (tan_t[6] + w * (tan_t[8] + w *
    (tan_t[10] + w * tan_t[12])))))
  local s = z * x
  r = y + z * (s * (r + v) + y) + s * tan_t[0]
  w = x + r
  if big then
    s = (@cdouble)(1_cint - 2_cint * odd)
    v = s - 2_cdouble * (x + (r - w * w / (w + s)))
    if negative then return -v end
    return v
  end
  if odd == 0_cint then return w end
  -- -1.0/(x+r) has up to 2 ulp of error, so compute it accurately.
  local w0 = double_from_bits(bits_of_double(w) & 0xFFFFFFFF00000000_culonglong)
  v = r - (w0 - x) -- w0 + v = r + x
  local a = -1_cdouble / w
  local a0 = double_from_bits(bits_of_double(a) & 0xFFFFFFFF00000000_culonglong)
  return a0 + a * (1_cdouble + a0 * w0 + a0 * v)
end

local function tan(value: cdouble): cdouble <cexport, codename 'tan'>
  local ix = (@cuint)(bits_of_double(value) >> 32) & 0x7FFFFFFF_cuint
  if ix <= 0x3FE921FB_cuint then -- |x| ~<= pi/4
    if ix < 0x3E400000_cuint then -- |x| < 2^-27
      if ix < 0x00100000_cuint then
        force_eval(value / 0x1p120_cdouble)
      else
        force_eval(value + 0x1p120_cdouble)
      end
      return value
    end
    return tan_kernel(value, 0_cdouble, 0_cint)
  end
  if ix >= 0x7FF00000_cuint then -- infinity or NaN
    if is_infinite64(value) then math_domain_error() end
    return value - value
  end
  local quadrant: cint = 0_cint
  local x: cdouble = 0_cdouble
  local y: cdouble = 0_cdouble
  reduce_pio2(value, &quadrant, &x, &y)
  return tan_kernel(x, y, quadrant & 1_cint)
end

local function tanf(value: cfloat): cfloat <cexport, codename 'tanf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  local result = (@cfloat)(tan((@cdouble)(value)))
  if is_infinite32(result) and value == value and not is_infinite32(value) then
    math_range_error()
  end
  return result
end

local function modf(value: cdouble, integral: *[0]cdouble): cdouble
    <cexport, codename 'modf'>
  if value ~= value then
    integral[0] = value
    return value
  end
  local representation: DoubleBits = {value = value}
  if (representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then
    integral[0] = value
    return value
  end
  if (representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0x7FF0000000000000_culonglong then
    integral[0] = value
    return double_from_bits(representation.bits & 0x8000000000000000_culonglong)
  end
  integral[0] = round_binary64(value, 0_cint)
  if value == integral[0] then
    return double_from_bits(representation.bits & 0x8000000000000000_culonglong)
  end
  return value - integral[0]
end

local function modff(value: cfloat, integral: *[0]cfloat): cfloat
    <cexport, codename 'modff'>
  if value ~= value then
    integral[0] = value
    return value
  end
  local representation: FloatBits = {value = value}
  if (representation.bits & 0x7FFFFFFF_cuint) == 0_cuint then
    integral[0] = value
    return value
  end
  if (representation.bits & 0x7FFFFFFF_cuint) == 0x7F800000_cuint then
    integral[0] = value
    return float_from_bits(representation.bits & 0x80000000_cuint)
  end
  integral[0] = round_binary32(value, 0_cint)
  if value == integral[0] then
    return float_from_bits(representation.bits & 0x80000000_cuint)
  end
  return value - integral[0]
end

local function modfl(value: clongdouble, integral: *[0]clongdouble): clongdouble
    <cexport, codename 'modfl'>
  return nelibc_modfl_hw(value, integral)
end

local function trunc(value: cdouble): cdouble <cexport, codename 'trunc'>
  return round_binary64(value, 0_cint)
end
local function floor(value: cdouble): cdouble <cexport, codename 'floor'>
  return round_binary64(value, 1_cint)
end
local function ceil(value: cdouble): cdouble <cexport, codename 'ceil'>
  return round_binary64(value, 2_cint)
end
local function round(value: cdouble): cdouble <cexport, codename 'round'>
  return round_binary64(value, 3_cint)
end

local function truncf(value: cfloat): cfloat <cexport, codename 'truncf'>
  return round_binary32(value, 0_cint)
end
local function floorf(value: cfloat): cfloat <cexport, codename 'floorf'>
  return round_binary32(value, 1_cint)
end
local function ceilf(value: cfloat): cfloat <cexport, codename 'ceilf'>
  return round_binary32(value, 2_cint)
end
local function roundf(value: cfloat): cfloat <cexport, codename 'roundf'>
  return round_binary32(value, 3_cint)
end

local function lrint(value: cdouble): clong <cexport, codename 'lrint'>
  return (@clong)(nelibc_lrint_hw(value))
end
local function lrintf(value: cfloat): clong <cexport, codename 'lrintf'>
  return (@clong)(nelibc_lrintf_hw(value))
end
local function llrint(value: cdouble): clonglong <cexport, codename 'llrint'>
  return nelibc_lrint_hw(value)
end
local function llrintf(value: cfloat): clonglong <cexport, codename 'llrintf'>
  return nelibc_lrintf_hw(value)
end
local function lround(value: cdouble): clong <cexport, codename 'lround'>
  return (@clong)(nelibc_lround_hw(round(value)))
end
local function lroundf(value: cfloat): clong <cexport, codename 'lroundf'>
  return (@clong)(nelibc_lroundf_hw(roundf(value)))
end
local function llround(value: cdouble): clonglong <cexport, codename 'llround'>
  return nelibc_lround_hw(round(value))
end
local function llroundf(value: cfloat): clonglong <cexport, codename 'llroundf'>
  return nelibc_lroundf_hw(roundf(value))
end

-- j0, y0, j1, y1, jn, yn follow musl 1.2.5 src/math/j0.c, j1.c and jn.c
-- (fdlibm e_j0.c, e_j1.c, e_jn.c): rational approximations below 2 and the
-- asymptotic forms sqrt(2/(pi x)) (P cos(x-phi) - Q sin(x-phi)) above, with
-- P and Q as rational functions of 1/x^2 on four subranges.
local bessel_invsqrtpi: cdouble = 5.64189583547756279280e-01_cdouble
local bessel_tpi: cdouble = 6.36619772367581382433e-01_cdouble

local j0_pr8: [6]cdouble = {
  0_cdouble, -7.03124999999900357484e-02_cdouble, -8.08167041275349795626e+00_cdouble,
  -2.57063105679704847262e+02_cdouble, -2.48521641009428822144e+03_cdouble,
  -5.25304380490729545272e+03_cdouble,
