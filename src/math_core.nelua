  local log_real: clongdouble
  local log_imaginary: clongdouble
  nelibc_clogl_parts(x, y, &log_real, &log_imaginary)
  local exp_real = exponent_real * log_real - exponent_imaginary * log_imaginary
  local exp_imaginary = exponent_imaginary * log_real + exponent_real * log_imaginary
  nelibc_cexpl_parts(exp_real, exp_imaginary, real_out, imaginary_out)
end
