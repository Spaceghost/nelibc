  0xC0DB62_cuint, 0x95993C_cuint, 0x439041_cuint, 0xFE5163_cuint, 0xABDEBB_cuint,
  0xC561B7_cuint, 0x246E3A_cuint, 0x424DD2_cuint, 0xE00649_cuint, 0x2EEA09_cuint,
  0xD1921C_cuint, 0xFE1DEB_cuint, 0x1CB129_cuint, 0xA73EE8_cuint, 0x8235F5_cuint,
  0x2EBB44_cuint, 0x84E99C_cuint, 0x7026B4_cuint, 0x5F7E41_cuint, 0x3991D6_cuint,
  0x398353_cuint, 0x39F49C_cuint, 0x845F8B_cuint, 0xBDF928_cuint, 0x3B1FF8_cuint,
  0x97FFDE_cuint, 0x05980F_cuint, 0xEF2F11_cuint, 0x8B5A0A_cuint, 0x6D1F6D_cuint,
  0x367ECF_cuint, 0x27CB09_cuint, 0xB74F46_cuint, 0x3F669E_cuint, 0x5FEA2D_cuint,
  0x7527BA_cuint, 0xC7EBE5_cuint, 0xF17B3D_cuint, 0x0739F7_cuint, 0x8A5292_cuint,
  0xEA6BFB_cuint, 0x5FB11F_cuint, 0x8D5D08_cuint, 0x560330_cuint, 0x46FC7B_cuint,
}

