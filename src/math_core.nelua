  -0x1.980267C7E09E4P-45_cdouble, -0x1.88D5493FAA639P-45_cdouble,
  -0x1.F1E7CF6D3A69CP-50_cdouble, -0x1.F1E7CF6D3A69CP-50_cdouble,
  -0x1.9E23F0DDA40E4P-46_cdouble, -0x1.9E23F0DDA40E4P-46_cdouble,
  0x0.0000000000000P+0_cdouble, 0x0.0000000000000P+0_cdouble,
  -0x1.0C76B999D2BE8P-46_cdouble, -0x1.3DC5B06E2F7D2P-45_cdouble,
  -0x1.AA0BA325A0C34P-45_cdouble, 0x1.111C05CF1D753P-47_cdouble,
  -0x1.C167375BDFD28P-45_cdouble, -0x1.97995D05A267DP-46_cdouble,
  -0x1.A68F247D82807P-46_cdouble, -0x1.E113E4FC93B7BP-47_cdouble,
  -0x1.5325D560D9E9BP-45_cdouble, 0x1.CC85EA5DB4ED7P-45_cdouble,
  -0x1.C69063C5D1D1EP-45_cdouble, 0x1.C1E8DA99DED32P-49_cdouble,
  0x1.3115C3ABD47DAP-45_cdouble, -0x1.390802BF768E5P-46_cdouble,
  0x1.646D1C65AACD3P-45_cdouble, -0x1.DC068AFE645E0P-45_cdouble,
  -0x1.534D64FA10AFDP-45_cdouble, 0x1.1EF78CE2D07F2P-45_cdouble,
  0x1.CA78E44389934P-45_cdouble, 0x1.39D6CCB81B4A1P-47_cdouble,
  0x1.62FA8234B7289P-51_cdouble, 0x1.5837954FDB678P-45_cdouble,
  0x1.633E8E5697DC7P-45_cdouble, 0x1.9CF8B2C3C2E78P-46_cdouble,
  -0x1.5118DE59C21E1P-45_cdouble, -0x1.C661070914305P-46_cdouble,
  -0x1.73D54AAE92CD1P-47_cdouble, 0x1.7F22858A0FF6FP-47_cdouble,
  -0x1.8724350562169P-45_cdouble, -0x1.C358D4EACE1AAP-47_cdouble,
  -0x1.D4BC4595412B6P-45_cdouble, -0x1.1EC72C5962BD2P-48_cdouble,
  -0x1.AFF2AF715B035P-45_cdouble, 0x1.212276041F430P-51_cdouble,
  -0x1.A211565BB8E11P-51_cdouble, 0x1.BCBECCA0CDF30P-46_cdouble,
  0x1.89CDB16ED4E91P-48_cdouble, 0x1.7188B163CEAE9P-45_cdouble,
  -0x1.C210E63A5F01CP-45_cdouble, 0x1.B9ACDF7A51681P-45_cdouble,
  0x1.CA6ED5147BDB7P-45_cdouble, 0x1.A87DEBA46BAEAP-47_cdouble,
  0x1.A9CFA4A5004F4P-45_cdouble, -0x1.8E27AD3213CB8P-45_cdouble,
  0x1.16ECDB0F177C8P-46_cdouble, 0x1.83B54B606BD5CP-46_cdouble,
  0x1.8E436EC90E09DP-47_cdouble, -0x1.F27CE0967D675P-45_cdouble,
  -0x1.E20891B0AD8A4P-45_cdouble, 0x1.EBE708164C759P-45_cdouble,
  0x1.FADEDEE5D40EFP-46_cdouble, -0x1.A0B2A08A465DCP-47_cdouble,
}

local function nelibc_fp_barrier_hw(value: cdouble): cdouble <cimport> end
local function nelibc_fp_barrierl_hw(value: clongdouble): clongdouble <cimport> end
local function nelibc_fp_barrierf_hw(value: cfloat): cfloat <cimport> end

local function bits_of_double(value: cdouble): culonglong <inline>
  local representation: DoubleBits = {value = value}
  return representation.bits
end

local function bits_of_float(value: cfloat): cuint <inline>
  local representation: FloatBits = {value = value}
  return representation.bits
end

-- Sign and exponent bits of a double (musl's top12).
local function top12(value: cdouble): cuint <inline>
  return (@cuint)(bits_of_double(value) >> 52)
end

-- musl's FORCE_EVAL and fp_barrier: an opaque call keeps the compiler from
-- dropping an operation performed only for the floating-point flags it
-- raises, or from folding a constant expression that must raise them.
local function force_evall(value: clongdouble): void <inline>
  nelibc_fp_barrierl_hw(value)
end
local function force_eval(value: cdouble): void <inline>
  nelibc_fp_barrier_hw(value)
end

local function force_evalf(value: cfloat): void <inline>
  nelibc_fp_barrierf_hw(value)
end

-- musl's __math_invalid/__math_divzero/__math_oflow/__math_uflow, plus the
-- errno that glibc's MATH_ERRNO contract expects.
local function math_invalid(x: cdouble): cdouble <inline>
  math_domain_error()
  return (x - x) / (x - x)
end

local function math_divzero(negative: boolean): cdouble <inline>
  math_range_error()
  local one: cdouble = 1_cdouble
  if negative then one = -1_cdouble end
  return nelibc_fp_barrier_hw(one) / 0_cdouble
end

local function math_xflow(negative: boolean, y: cdouble): cdouble <inline>
  math_range_error()
  local scaled = y
  if negative then scaled = -y end
  return nelibc_fp_barrier_hw(scaled) * y
end

local function math_oflow(negative: boolean): cdouble <inline>
  return math_xflow(negative, 0x1p769_cdouble)
end

local function math_uflow(negative: boolean): cdouble <inline>
  return math_xflow(negative, 0x1p-767_cdouble)
end

local function raise_invalid(): void <inline>
  force_eval(nelibc_fp_barrier_hw(0_cdouble) / 0_cdouble)
end

-- A float wrapper around a double kernel returns a subnormal argument
-- unchanged for the odd functions that behave like x near zero; the result
-- is still inexact and must raise underflow, which the exact conversion
-- back to float would not.
local function is_subnormal32(value: cfloat): boolean <inline>
  return (bits_of_float(value) & 0x7F800000_cuint) == 0_cuint and value ~= 0_cfloat
end

local function float_subnormal_result(value: cfloat): cfloat <inline>
  force_evalf(value * value)
  return value
end

local function sqrt(value: cdouble): cdouble <cexport, codename 'sqrt'>
  -- Test the sign through the bits: an ordered comparison with a quiet NaN
  -- would raise INVALID, which sqrt(NaN) must not do.
  if (bits_of_double(value) >> 63) ~= 0_culonglong and value ~= 0_cdouble and
      not is_nan64(value) then
    math_domain_error()
  end
  return nelibc_sqrt_hw(value)
end

local function sqrtf(value: cfloat): cfloat <cexport, codename 'sqrtf'>
  return nelibc_sqrtf_hw(value)
end

local function sqrtl(value: clongdouble): clongdouble <cexport, codename 'sqrtl'>
  if not is_nan80(value) and value < 0_clongdouble then math_domain_error() end
  return nelibc_sqrtl_hw(value)
end

local function rint(value: cdouble): cdouble <cexport, codename 'rint'>
  return nelibc_rint_hw(value)
end

local function rintf(value: cfloat): cfloat <cexport, codename 'rintf'>
  return nelibc_rintf_hw(value)
end

local function nearbyint(value: cdouble): cdouble
    <cexport, codename 'nearbyint'>
  return nelibc_nearbyint_hw(value)
end

local function nearbyintf(value: cfloat): cfloat
    <cexport, codename 'nearbyintf'>
  return nelibc_nearbyintf_hw(value)
end

local function ilogb(value: cdouble): cint <cexport, codename 'ilogb'>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong
  local field = (@cint)((bits >> 52) & 0x7FF_culonglong)
  if field == 0x7FF_cint then
    raise_invalid()
    if (bits & 0x000FFFFFFFFFFFFF_culonglong) ~= 0_culonglong then return (-2147483647_cint - 1_cint) end
    return 2147483647_cint
  end
  if bits == 0_culonglong then
    raise_invalid()
    return (-2147483647_cint - 1_cint)
  end
  if field ~= 0_cint then return field - 1023_cint end
  local fraction = bits & 0x000FFFFFFFFFFFFF_culonglong
  local shifts: cint = 0_cint
  while (fraction & 0x0010000000000000_culonglong) == 0_culonglong do
    fraction = fraction << 1
    shifts = shifts + 1_cint
  end
  return -1022_cint - shifts
end

local function ilogbf(value: cfloat): cint <cexport, codename 'ilogbf'>
  local representation: FloatBits = {value = value}
  local bits = representation.bits & 0x7FFFFFFF_cuint
  local field = (@cint)((bits >> 23) & 0xFF_cuint)
  if field == 0xFF_cint then
    raise_invalid()
    if (bits & 0x007FFFFF_cuint) ~= 0_cuint then return (-2147483647_cint - 1_cint) end
    return 2147483647_cint
  end
  if bits == 0_cuint then
    raise_invalid()
    return (-2147483647_cint - 1_cint)
  end
  if field ~= 0_cint then return field - 127_cint end
  local fraction = bits & 0x007FFFFF_cuint
  local shifts: cint = 0_cint
  while (fraction & 0x00800000_cuint) == 0_cuint do
    fraction = fraction << 1
    shifts = shifts + 1_cint
  end
  return -126_cint - shifts
end

local function ilogbl(value: clongdouble): cint <cexport, codename 'ilogbl'>
  if value == 0_clongdouble or not is_finite80(value) then raise_invalid() end
  return nelibc_ilogbl_hw(value)
end

local function logb(value: cdouble): cdouble <cexport, codename 'logb'>
  if not is_finite64(value) then return value * value end
  if value == 0_cdouble then
    math_range_error()
    return -1_cdouble / (value * value)
  end
  return (@cdouble)(ilogb(value))
end

local function logbf(value: cfloat): cfloat <cexport, codename 'logbf'>
  if not is_finite32(value) then return value * value end
  if value == 0_cfloat then
    math_range_error()
    return -1_cfloat / (value * value)
  end
  return (@cfloat)(ilogbf(value))
end

local function logbl(value: clongdouble): clongdouble <cexport, codename 'logbl'>
  if value == 0_clongdouble then
    math_range_error()
    return -1_clongdouble / (value * value)
  end
  return nelibc_logbl_hw(value)
end

local function ldexpl(value: clongdouble, exponent: cint): clongdouble <cexport, codename 'ldexpl'>
  local range_error: cint = 0_cint
  local result = nelibc_ldexpl_hw(value, exponent, &range_error)
  if range_error ~= 0_cint then math_range_error() end
  return result
end

local function scalbnl(value: clongdouble, exponent: cint): clongdouble <cexport, codename 'scalbnl'>
  return ldexpl(value, exponent)
end

local function scalblnl(value: clongdouble, exponent: clong): clongdouble <cexport, codename 'scalblnl'>
  local range_error: cint = 0_cint
  local result = nelibc_scalblnl_hw(value, exponent, &range_error)
  if range_error ~= 0_cint then math_range_error() end
  return result
end

local function truncl(value: clongdouble): clongdouble <cexport, codename 'truncl'>
  return nelibc_roundl_hw(value, 0_cint)
end

local function floorl(value: clongdouble): clongdouble <cexport, codename 'floorl'>
  return nelibc_roundl_hw(value, 1_cint)
end

local function ceill(value: clongdouble): clongdouble <cexport, codename 'ceill'>
  return nelibc_roundl_hw(value, 2_cint)
end

local function rintl(value: clongdouble): clongdouble <cexport, codename 'rintl'>
  return nelibc_roundl_hw(value, 3_cint)
end

local function nearbyintl(value: clongdouble): clongdouble <cexport, codename 'nearbyintl'>
  return nelibc_roundl_hw(value, 4_cint)
end

-- roundl follows musl 1.2.5 src/math/roundl.c: the 0x1p63 trick rounds
-- without raising a spurious INEXACT on values that are already integral.
local function roundl(value: clongdouble): clongdouble <cexport, codename 'roundl'>
  local bits: LongDoubleBits = {value = value}
  local biased = (@cint)(bits.parts.sign_exponent & 0x7fff_cushort)
  local negative = (bits.parts.sign_exponent & 0x8000_cushort) ~= 0_cushort
  if biased >= 0x3fff_cint + 63_cint then return value end
  local x = value
  if negative then x = -x end
  if biased < 0x3fff_cint - 1_cint then
    force_evall(x + 0x1P63_clongdouble)
    return 0_clongdouble * value
  end
  local y = x + 0x1P63_clongdouble - 0x1P63_clongdouble - x
  if y > 0.5_clongdouble then
    y = y + x - 1_clongdouble
  elseif y <= -0.5_clongdouble then
    y = y + x + 1_clongdouble
  else
    y = y + x
  end
  if negative then y = -y end
  return y
end

local function lrintl(value: clongdouble): clong <cexport, codename 'lrintl'>
  return (@clong)(nelibc_lrintl_hw(value))
end

local function llrintl(value: clongdouble): clonglong <cexport, codename 'llrintl'>
  return nelibc_lrintl_hw(value)
end

local function lroundl(value: clongdouble): clong <cexport, codename 'lroundl'>
  return (@clong)(nelibc_lroundl_hw(value))
end

local function llroundl(value: clongdouble): clonglong <cexport, codename 'llroundl'>
  return nelibc_lroundl_hw(value)
end

local function atanl(value: clongdouble): clongdouble <cexport, codename 'atanl'>
  return nelibc_atan2l_hw(value, 1_clongdouble)
end

local function atan2l(y: clongdouble, x: clongdouble): clongdouble
    <cexport, codename 'atan2l'>
  return nelibc_atan2l_hw(y, x)
end

local function asinl(value: clongdouble): clongdouble <cexport, codename 'asinl'>
  if is_nan80(value) then return value + value end
  if value < -1_clongdouble or value > 1_clongdouble then
    return sqrtl(-1_clongdouble)
  end
  local complement = sqrtl((1_clongdouble - value) * (1_clongdouble + value))
  return atan2l(value, complement)
end

local function acosl(value: clongdouble): clongdouble <cexport, codename 'acosl'>
  if is_nan80(value) then return value + value end
  if value < -1_clongdouble or value > 1_clongdouble then
    return sqrtl(-1_clongdouble)
  end
  local complement = sqrtl((1_clongdouble - value) * (1_clongdouble + value))
  return atan2l(complement, value)
end

local function logl(value: clongdouble): clongdouble <cexport, codename 'logl'>
  if is_nan80(value) then return value + value end
  if value == 0_clongdouble then
    math_range_error()
  elseif value < 0_clongdouble then
    math_domain_error()
  end
  return nelibc_logl_hw(value)
end

local function log2l(value: clongdouble): clongdouble <cexport, codename 'log2l'>
  if is_nan80(value) then return value + value end
  if value == 0_clongdouble then
    math_range_error()
  elseif value < 0_clongdouble then
    math_domain_error()
  end
  return nelibc_log2l_hw(value)
end

local function log10l(value: clongdouble): clongdouble <cexport, codename 'log10l'>
  if is_nan80(value) then return value + value end
  if value == 0_clongdouble then
    math_range_error()
  elseif value < 0_clongdouble then
    math_domain_error()
  end
  return nelibc_log10l_hw(value)
end

local function log1pl(value: clongdouble): clongdouble <cexport, codename 'log1pl'>
  if is_nan80(value) then return value + value end
  if value > -0.5_clongdouble and value < 0.5_clongdouble then
    return nelibc_log1pl_small_hw(value)
  end
  return logl(1_clongdouble + value)
end

local function long_double_pow2(exponent: cint): clongdouble <inline>
  local bits: LongDoubleBits = {
    parts = {significand = 0x8000000000000000_culonglong,
             sign_exponent = (@cushort)(exponent + 0x3fff_cint)}
  }
  return bits.value
end

-- ERANGE plus a real OVERFLOW / UNDERFLOW flag, computed at run time so the
-- compiler cannot fold the product away.
local function long_double_overflow(): clongdouble
  math_range_error()
  return nelibc_fp_barrierl_hw(long_double_pow2(16383_cint)) * long_double_pow2(16383_cint)
end

local function long_double_underflow(): clongdouble
  math_range_error()
  return nelibc_fp_barrierl_hw(long_double_pow2(-16382_cint)) * long_double_pow2(-16382_cint)
end

-- glibc raises UNDERFLOW for every subnormal exp result, even an exact one.
local function long_double_subnormal_result(result: clongdouble): clongdouble
  local bits: LongDoubleBits = {value = result}
  if (bits.parts.sign_exponent & 0x7fff_cushort) == 0_cushort and
      bits.parts.significand ~= 0_culonglong then
    math_range_error()
    force_evall(nelibc_fp_barrierl_hw(long_double_pow2(-16382_cint)) * long_double_pow2(-16382_cint))
  end
  return result
end
local function expl(value: clongdouble): clongdouble <cexport, codename 'expl'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    if value < 0_clongdouble then return 0_clongdouble end
    return value
  end
  -- ln(LDBL_MAX) = 11356.52..., ln(LDBL_TRUE_MIN) = -11399.49...; beyond
  -- them the x87 fist step would raise INVALID, so answer directly.
  if value > 11357_clongdouble then return long_double_overflow() end
  if value < -11400_clongdouble then return long_double_underflow() end
  local result = nelibc_expl_hw(value)
  if is_infinite80(result) or (result == 0_clongdouble and value ~= 0_clongdouble) then
    math_range_error()
    return result
  end
  return long_double_subnormal_result(result)
end

local function exp2l(value: clongdouble): clongdouble <cexport, codename 'exp2l'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    if value < 0_clongdouble then return 0_clongdouble end
    return value
  end
  if value > -0x1P-65_clongdouble and value < 0x1P-65_clongdouble then
    return 1_clongdouble + value
  end
  if value >= 16384_clongdouble then return long_double_overflow() end
  if value < -16446_clongdouble then return long_double_underflow() end
  local result = nelibc_exp2l_hw(value)
  if is_infinite80(result) or (result == 0_clongdouble and value ~= 0_clongdouble) then
    math_range_error()
    return result
  end
  return long_double_subnormal_result(result)
end

local function expm1l(value: clongdouble): clongdouble <cexport, codename 'expm1l'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    if value < 0_clongdouble then return -1_clongdouble end
    return value
  end
  if value < -48_clongdouble then
    if nelibc_x87_rounding_mode() == 0x0800_cint then
      return nelibc_neg_one_up_hw()
    end
    return -1_clongdouble
  end
  if value > -0.69_clongdouble and value < 0.69_clongdouble then
    return nelibc_expm1l_small_hw(value)
  end
  return expl(value) - 1_clongdouble
end

local function erf_abs_l(value: clongdouble): clongdouble <inline>
  if value < 0_clongdouble then return -value end
  return value
end

local function erf_series_l(value: clongdouble): clongdouble
  local square = value * value
  local term = value
  local sum = value
  local index: cint = 1_cint
  while index < 256_cint do
    term = -term * square / (@clongdouble)(index)
    local addition = term / (@clongdouble)(2_cint * index + 1_cint)
    sum = sum + addition
    if erf_abs_l(addition) <= erf_abs_l(sum) * 0x1p-66_clongdouble then break end
    index = index + 1_cint
  end
  return (2_clongdouble / sqrtl(nelibc_x87_pi())) * sum
end

local function erfc_positive_l(value: clongdouble): clongdouble
  if value == 0_clongdouble then return 1_clongdouble end
  if value >= 2000_clongdouble then
    math_range_error()
    return 0_clongdouble
  end
  local square = value * value
  if value < 1.5_clongdouble then return 1_clongdouble - erf_series_l(value) end

  -- Continued fraction for Q(1/2, x^2), which is exactly erfc(x). It avoids
  -- subtracting erf(x) from one in the tail and keeps binary80 precision.
  local a = 0.5_clongdouble
  local b = square + 0.5_clongdouble
  local c = 0x1p10000_clongdouble
  local d = 1_clongdouble / b
  local h = d
  local tiny = 0x1p-10000_clongdouble
  local index: cint = 1_cint
  while index < 512_cint do
    local iteration = (@clongdouble)(index)
    local coefficient = -iteration * (iteration - a)
    b = b + 2_clongdouble
    d = coefficient * d + b
    if erf_abs_l(d) < tiny then
      if d < 0_clongdouble then d = -tiny else d = tiny end
    end
    c = b + coefficient / c
    if erf_abs_l(c) < tiny then
      if c < 0_clongdouble then c = -tiny else c = tiny end
    end
    d = 1_clongdouble / d
    local delta = d * c
    h = h * delta
    if erf_abs_l(delta - 1_clongdouble) <= 0x1p-63_clongdouble then break end
    index = index + 1_cint
  end
  return expl(-square) * sqrtl(square / nelibc_x87_pi()) * h
end

local function erfl(value: clongdouble): clongdouble <cexport, codename 'erfl'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    if value < 0_clongdouble then return -1_clongdouble end
    return 1_clongdouble
  end
  if value == 0_clongdouble then return value end
  local magnitude = erf_abs_l(value)
  if magnitude >= 8_clongdouble then
    if value < 0_clongdouble then return -1_clongdouble end
    return 1_clongdouble
  end
  if magnitude < 1.5_clongdouble then return erf_series_l(value) end
  local result = 1_clongdouble - erfc_positive_l(magnitude)
  if value < 0_clongdouble then return -result end
  return result
end

local function erfcl(value: clongdouble): clongdouble <cexport, codename 'erfcl'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    if value < 0_clongdouble then return 2_clongdouble end
    return 0_clongdouble
  end
  if value <= -8_clongdouble then return 2_clongdouble end
  if value >= 0_clongdouble then return erfc_positive_l(value) end
  return 2_clongdouble - erfc_positive_l(-value)
end

local function sinhl(value: clongdouble): clongdouble <cexport, codename 'sinhl'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then return value end
  if value == 0_clongdouble then return value end
  local magnitude = value
  if magnitude < 0_clongdouble then magnitude = -magnitude end
  local result: clongdouble
  if magnitude < 1_clongdouble then
    result = 0.5_clongdouble * (expm1l(magnitude) - expm1l(-magnitude))
  elseif magnitude <= 40_clongdouble then
    local exponential = expl(magnitude)
    result = 0.5_clongdouble * (exponential - 1_clongdouble / exponential)
  elseif magnitude <= 12000_clongdouble then
    result = nelibc_expl_half_hw(magnitude)
    if is_infinite80(result) then math_range_error() end
  else
    nelibc_expl_half_hw(12000_clongdouble)
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    math_range_error()
    result = infinity.value
  end
  if value < 0_clongdouble then return -result end
  return result
end

local function coshl(value: clongdouble): clongdouble <cexport, codename 'coshl'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    return infinity.value
  end
  local magnitude = value
  if magnitude < 0_clongdouble then magnitude = -magnitude end
  if magnitude < 1_clongdouble then
    local half_sine = sinhl(0.5_clongdouble * magnitude)
    return 1_clongdouble + 2_clongdouble * half_sine * half_sine
  end
  if magnitude <= 40_clongdouble then
    local exponential = expl(magnitude)
    return 0.5_clongdouble * (exponential + 1_clongdouble / exponential)
  end
  if magnitude <= 12000_clongdouble then
    local result = nelibc_expl_half_hw(magnitude)
    if is_infinite80(result) then math_range_error() end
    return result
  end
  local infinity: LongDoubleBits = {
    parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
  }
  nelibc_expl_half_hw(12000_clongdouble)
  math_range_error()
  return infinity.value
end

local function asinhl(value: clongdouble): clongdouble <cexport, codename 'asinhl'>
  if is_nan80(value) or is_infinite80(value) or value == 0_clongdouble then return value end
  local magnitude = value
  if magnitude < 0_clongdouble then magnitude = -magnitude end
  local result: clongdouble
  if magnitude >= 0x1p512_clongdouble then
    result = logl(magnitude) + 0.6931471805599453094286904741849753008863_clongdouble
  else
    local square = magnitude * magnitude
    result = log1pl(magnitude + square / (1_clongdouble + sqrtl(square + 1_clongdouble)))
  end
  if value < 0_clongdouble then return -result end
  return result
end

local function acoshl(value: clongdouble): clongdouble <cexport, codename 'acoshl'>
  if is_nan80(value) then return value + value end
  if value < 1_clongdouble then
    math_domain_error()
    return sqrtl(-1_clongdouble)
  end
  if value == 1_clongdouble then return 0_clongdouble end
  if is_infinite80(value) then return value end
  if value >= 0x1p512_clongdouble then
    return logl(value) + 0.6931471805599453094286904741849753008863_clongdouble
  end
  if value < 2_clongdouble then
    local delta = value - 1_clongdouble
    return log1pl(delta + sqrtl(delta * (delta + 2_clongdouble)))
  end
  return 2_clongdouble * asinhl(sqrtl((value - 1_clongdouble) * 0.5_clongdouble))
end

local function atanhl(value: clongdouble): clongdouble <cexport, codename 'atanhl'>
  if is_nan80(value) then return value + value end
  if value == 0_clongdouble then return value end
  local magnitude = value
  if magnitude < 0_clongdouble then magnitude = -magnitude end
  if magnitude == 1_clongdouble then
    math_range_error()
    return value / (magnitude - 1_clongdouble) -- +-inf with DIVBYZERO
  end
  if magnitude > 1_clongdouble then
    math_domain_error()
    return sqrtl(-1_clongdouble)
  end
  local result = 0.5_clongdouble * log1pl((2_clongdouble * magnitude) / (1_clongdouble - magnitude))
  if value < 0_clongdouble then return -result end
  return result
end

-- Whether exponent * multiplier is an exact integer for a binary80 exponent.
local function ldexp(value: cdouble, exponent: cint): cdouble <cexport, codename 'ldexp'>
  local result = nelibc_ldexp_hw(value, exponent)
  local input_bits: DoubleBits = {value = value}
  local result_bits: DoubleBits = {value = result}
  local input_field = input_bits.bits & 0x7FF0000000000000_culonglong
  local result_field = result_bits.bits & 0x7FF0000000000000_culonglong
  if input_field ~= 0x7FF0000000000000_culonglong and
      (result_field == 0x7FF0000000000000_culonglong or
       ((result_bits.bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong and
        value ~= 0_cdouble)) then
    math_range_error()
  end
  return result
end

local function ldexpf(value: cfloat, exponent: cint): cfloat <cexport, codename 'ldexpf'>
  local result = nelibc_ldexpf_hw(value, exponent)
  local input_bits: FloatBits = {value = value}
  local result_bits: FloatBits = {value = result}
  local input_field = input_bits.bits & 0x7F800000_cuint
  local result_field = result_bits.bits & 0x7F800000_cuint
  if input_field ~= 0x7F800000_cuint and
      (result_field == 0x7F800000_cuint or
       ((result_bits.bits & 0x7FFFFFFF_cuint) == 0_cuint and
        value ~= 0_cfloat)) then
    math_range_error()
  end
  return result
end

local function scalbn(value: cdouble, exponent: cint): cdouble <cexport, codename 'scalbn'>
  return ldexp(value, exponent)
end

local function scalbnf(value: cfloat, exponent: cint): cfloat <cexport, codename 'scalbnf'>
  return ldexpf(value, exponent)
end

local function scalbln(value: cdouble, exponent: clong): cdouble <cexport, codename 'scalbln'>
  local bounded: cint
  if exponent > 2147483647_clong then
    bounded = 2147483647_cint
  elseif exponent < (-2147483647_clong - 1_clong) then
    bounded = (-2147483647_cint - 1_cint)
  else
    bounded = (@cint)(exponent)
  end
  return ldexp(value, bounded)
end

local function scalblnf(value: cfloat, exponent: clong): cfloat <cexport, codename 'scalblnf'>
  local bounded: cint
  if exponent > 2147483647_clong then
    bounded = 2147483647_cint
  elseif exponent < (-2147483647_clong - 1_clong) then
    bounded = (-2147483647_cint - 1_cint)
  else
    bounded = (@cint)(exponent)
  end
  return ldexpf(value, bounded)
end

local function scalb(value: cdouble, exponent: cdouble): cdouble <cexport, codename 'scalb'>
  if is_nan64(value) or is_nan64(exponent) then return value * exponent end
  if is_infinite64(exponent) then
    if (value == 0_cdouble and exponent > 0_cdouble) or
        (is_infinite64(value) and exponent < 0_cdouble) then
      return math_invalid(value)
    end
    if exponent > 0_cdouble then return value * exponent end
    return value / (-exponent)
  end
  -- rint raises INEXACT for a fractional exponent before the INVALID below.
  if rint(exponent) ~= exponent then return math_invalid(exponent) end
  if exponent > 65000_cdouble then return scalbn(value, 65000_cint) end
  if exponent < -65000_cdouble then return scalbn(value, -65000_cint) end
  return scalbn(value, (@cint)(exponent))
end

local function scalbf(value: cfloat, exponent: cfloat): cfloat <cexport, codename 'scalbf'>
  if is_nan32(value) or is_nan32(exponent) then return value * exponent end
  if is_infinite32(exponent) then
    if (value == 0_cfloat and exponent > 0_cfloat) or
        (is_infinite32(value) and exponent < 0_cfloat) then
      math_domain_error()
      return (value - value) / (value - value)
    end
    if exponent > 0_cfloat then return value * exponent end
    return value / (-exponent)
  end
  if rintf(exponent) ~= exponent then
    math_domain_error()
    return (exponent - exponent) / (exponent - exponent)
  end
  if exponent > 65000_cfloat then return scalbnf(value, 65000_cint) end
  if exponent < -65000_cfloat then return scalbnf(value, -65000_cint) end
  return scalbnf(value, (@cint)(exponent))
end

local function significand(value: cdouble): cdouble <cexport, codename 'significand'>
  if is_nan64(value) then return value + value end
  if is_infinite64(value) or value == 0_cdouble then return value end
  return scalbn(value, -ilogb(value))
end

local function significandf(value: cfloat): cfloat <cexport, codename 'significandf'>
  if is_nan32(value) then return value + value end
  if is_infinite32(value) or value == 0_cfloat then return value end
  return scalbnf(value, -ilogbf(value))
end

local function fma_normalize(value: cdouble): FmaNumber <inline>
  local representation: DoubleBits = {value = value}
  local exponent = (@cint)(representation.bits >> 52)
  local sign = exponent & 0x800_cint
  exponent = exponent & 0x7FF_cint
  if exponent == 0_cint then
    local scaled_representation: DoubleBits = {value = value * 0x1p63_cdouble}
    representation.bits = scaled_representation.bits
    exponent = (@cint)((representation.bits >> 52) & 0x7FF_culonglong)
    if exponent ~= 0_cint then
      exponent = exponent - 63_cint
    else
      exponent = 0x800_cint
    end
  end
  local mantissa = (representation.bits & 0x000FFFFFFFFFFFFF_culonglong) |
    0x0010000000000000_culonglong
  return {mantissa = mantissa << 1,
          exponent = exponent - 0x3FF_cint - 52_cint - 1_cint,
          sign = sign}
end

local function fma_multiply(x: culonglong, y: culonglong): FmaProduct <inline>
  local x_low = x & 0xFFFFFFFF_culonglong
  local x_high = x >> 32
  local y_low = y & 0xFFFFFFFF_culonglong
  local y_high = y >> 32
  local term1 = x_low * y_low
  local term2_low = x_low * y_high
  local term2_high = x_high * y_low
  local term3 = x_high * y_high
  local middle = (term1 >> 32) + (term2_low & 0xFFFFFFFF_culonglong) +
      (term2_high & 0xFFFFFFFF_culonglong)
  local low = (middle << 32) | (term1 & 0xFFFFFFFF_culonglong)
  local high = term3 + (term2_low >> 32) + (term2_high >> 32) + (middle >> 32)
  return {high = high, low = low}
end

local function fmal_normalize(value: clongdouble): FmaNumber <inline>
  local representation: LongDoubleBits = {value = value}
  local exponent = representation.parts.sign_exponent & 0x7fff_cushort
  local sign: cint = 0_cint
  if (representation.parts.sign_exponent & 0x8000_cushort) ~= 0_cushort then
    sign = 0x8000_cint
  end
  if exponent == 0x7fff_cushort then
    return {mantissa = representation.parts.significand, exponent = 16321_cint, sign = sign}
  end
  if exponent == 0_cushort then
    return {mantissa = representation.parts.significand, exponent = -16445_cint, sign = sign}
  end
  return {mantissa = representation.parts.significand,
          exponent = (@cint)(exponent) - 16446_cint, sign = sign}
end

local function fmal_store_product(limbs: *[0]culonglong, product: FmaProduct,
    offset: cint): void <inline>
  local index = offset >> 6
  local bit = offset & 63_cint
  limbs[index] = product.low << bit
  if bit == 0_cint then
    limbs[index + 1] = product.high
  else
    limbs[index + 1] = (product.low >> (64_cint - bit)) | (product.high << bit)
    limbs[index + 2] = product.high >> (64_cint - bit)
  end
end

local function fmal_add_shifted(limbs: *[0]culonglong, mantissa: culonglong,
    offset: cint): void <inline>
  local index = offset >> 6
  local bit = offset & 63_cint
  local low = mantissa << bit
  local high: culonglong = 0_culonglong
  if bit ~= 0_cint then high = mantissa >> (64_cint - bit) end
  local old = limbs[index]
  limbs[index] = old + low
  local carry = limbs[index] < old
  old = limbs[index + 1]
  local sum = old + high
  local carry_high = sum < old
  local carry_value: culonglong = 0_culonglong
  if carry then carry_value = 1_culonglong end
  local sum_with_carry = sum + carry_value
  carry_high = carry_high or sum_with_carry < sum
  limbs[index + 1] = sum_with_carry
  index = index + 2_cint
  while carry_high and index < 1026_cint do
    old = limbs[index]
    limbs[index] = old + 1_culonglong
    carry_high = limbs[index] == 0_culonglong
    index = index + 1_cint
  end
end

local function fmal_subtract_shifted(limbs: *[0]culonglong, mantissa: culonglong,
    offset: cint): boolean <inline>
  local index = offset >> 6
  local bit = offset & 63_cint
  local low = mantissa << bit
  local high: culonglong = 0_culonglong
  if bit ~= 0_cint then high = mantissa >> (64_cint - bit) end
  local old = limbs[index]
  limbs[index] = old - low
  local borrow = old < low
  old = limbs[index + 1]
  local difference = old - high
  local borrow_high = old < high
  local borrow_value: culonglong = 0_culonglong
  if borrow then borrow_value = 1_culonglong end
  local difference_with_borrow = difference - borrow_value
  borrow_high = borrow_high or difference < borrow_value
  limbs[index + 1] = difference_with_borrow
  index = index + 2_cint
  while borrow_high and index < 1026_cint do
    old = limbs[index]
    limbs[index] = old - 1_culonglong
    borrow_high = old == 0_culonglong
    index = index + 1_cint
  end
  return borrow_high
end

local function fmal_negate(limbs: *[0]culonglong): void <inline>
  local carry = true
  local index: cint = 0_cint
  while index < 1026_cint do
    limbs[index] = ~limbs[index]
    if carry then
      limbs[index] = limbs[index] + 1_culonglong
      carry = limbs[index] == 0_culonglong
    end
    index = index + 1_cint
  end
end

local function fma_clz64(value: culonglong): cint <inline>
  local count: cint = 0_cint
  local bit = 0x8000000000000000_culonglong
  while (value & bit) == 0_culonglong and count < 64_cint do
    count = count + 1_cint
    bit = bit >> 1
  end
  return count
end

local function fma_boolean_bit(value: boolean): culonglong <inline>
  if value then return 1_culonglong end
  return 0_culonglong
end

local function fma(x: cdouble, y: cdouble, z: cdouble): cdouble
    <cexport, codename 'fma'>
  local nx = fma_normalize(x)
  local ny = fma_normalize(y)
  local nz = fma_normalize(z)
  local zero_inf_nan_exponent = 0x7FF_cint - 0x3FF_cint - 52_cint - 1_cint
  if nx.exponent >= zero_inf_nan_exponent or ny.exponent >= zero_inf_nan_exponent then
    return x * y + z
  end
  if nz.exponent >= zero_inf_nan_exponent then
    if nz.exponent > zero_inf_nan_exponent then return x * y + z end
    return z
  end

  local product = fma_multiply(nx.mantissa, ny.mantissa)
  local exponent = nx.exponent + ny.exponent
  local distance = nz.exponent - exponent
  local z_high: culonglong
  local z_low: culonglong
  if distance > 0_cint then
    if distance < 64_cint then
      z_low = nz.mantissa << distance
      z_high = nz.mantissa >> (64_cint - distance)
    else
      z_low = 0_culonglong
      z_high = nz.mantissa
      exponent = nz.exponent - 64_cint
      distance = distance - 64_cint
      if distance > 0_cint then
        if distance < 64_cint then
          product.low = (product.high << (64_cint - distance)) |
            (product.low >> distance) |
            fma_boolean_bit((product.low << (64_cint - distance)) ~= 0_culonglong)
          product.high = product.high >> distance
        else
          product.low = 1_culonglong
          product.high = 0_culonglong
        end
      end
    end
  else
    z_high = 0_culonglong
    distance = -distance
    if distance == 0_cint then
      z_low = nz.mantissa
    elseif distance < 64_cint then
      z_low = (nz.mantissa >> distance) |
        fma_boolean_bit((nz.mantissa << (64_cint - distance)) ~= 0_culonglong)
    else
      z_low = 1_culonglong
    end
  end

  local sign = nx.sign ~ ny.sign
  local same_sign = (sign ~ nz.sign) == 0_cint
  local nonzero = true
  if same_sign then
    local previous_low = product.low
    product.low = product.low + z_low
    product.high = product.high + z_high + fma_boolean_bit(product.low < previous_low)
  else
    local previous_low = product.low
    product.low = product.low - z_low
    product.high = product.high - z_high - fma_boolean_bit(previous_low < z_low)
    if (product.high >> 63) ~= 0_culonglong then
      product.low = 0_culonglong - product.low
      product.high = 0_culonglong - product.high - fma_boolean_bit(product.low ~= 0_culonglong)
      sign = sign ~ 0x800_cint
    end
    nonzero = product.high ~= 0_culonglong
  end

  local result_high: culonglong
  local shift: cint
  if nonzero then
    exponent = exponent + 64_cint
    shift = fma_clz64(product.high) - 1_cint
    result_high = (product.high << shift) | (product.low >> (64_cint - shift)) |
      fma_boolean_bit((product.low << shift) ~= 0_culonglong)
  elseif product.low ~= 0_culonglong then
    shift = fma_clz64(product.low) - 1_cint
    if shift < 0_cint then
      result_high = (product.low >> 1) | (product.low & 1_culonglong)
    else
      result_high = product.low << shift
    end
  else
    return x * y + z
  end
  exponent = exponent - shift

  local signed_integer = (@clonglong)(result_high)
  if sign ~= 0_cint then signed_integer = -signed_integer end
  local result = (@cdouble)(signed_integer)
  if exponent < -1022_cint - 62_cint then
    if exponent == -1022_cint - 63_cint then
      local cutoff = 0x1p63_cdouble
      if sign ~= 0_cint then cutoff = -cutoff end
      if result == cutoff then
        local float_min = 0x0.ffffff8p-63_cdouble * 0x1p-126_cdouble * result
        return 0x1p-896_cdouble * float_min
      end
      if (result_high << 53) ~= 0_culonglong then
        signed_integer = (@clonglong)((result_high >> 1) |
          (result_high & 1_culonglong) | 0x4000000000000000_culonglong)
        if sign ~= 0_cint then signed_integer = -signed_integer end
        result = (@cdouble)(signed_integer)
        result = 2_cdouble * result - cutoff
        local tiny = 0x1p-896_cdouble * result
        result = result + (tiny * tiny) * (result - result)
      end
    else
      shift = 10_cint
      signed_integer = (@clonglong)((result_high >> shift) |
        fma_boolean_bit((result_high << (64_cint - shift)) ~= 0_culonglong)) << shift
      if sign ~= 0_cint then signed_integer = -signed_integer end
      result = (@cdouble)(signed_integer)
    end
  end
  return scalbn(result, exponent)
end

local function nelibc_fmal(x: clongdouble, y: clongdouble, z: clongdouble): clongdouble
    <cexport, codename 'nelibc_fmal'>
  local nx = fmal_normalize(x)
  local ny = fmal_normalize(y)
  local nz = fmal_normalize(z)
  if nx.exponent == 16321_cint or ny.exponent == 16321_cint then
    return x * y + z
  end
  if nz.exponent == 16321_cint then
    if is_nan80(z) then
      if is_signaling_nan80(z) then return z + z end
      return z
    end
    return z
  end
  if nx.mantissa == 0_culonglong or ny.mantissa == 0_culonglong then
    return x * y + z
  end

  -- The product and addend span at most 65,658 binary positions for binary80.
  -- Keeping the exact integer sum avoids both product rounding and cancellation
  -- loss when the operands' exponents are far apart.
  local limbs: [1026]culonglong = {}
  local product = fma_multiply(nx.mantissa, ny.mantissa)
  local product_sign = nx.sign ~ ny.sign
  local product_offset = nx.exponent + ny.exponent + 32890_cint
  fmal_store_product(&limbs[0], product, product_offset)
  local addend_offset = nz.exponent + 32890_cint
  local sign = product_sign
  local same_sign = product_sign == nz.sign
  if same_sign then
    fmal_add_shifted(&limbs[0], nz.mantissa, addend_offset)
  else
    if fmal_subtract_shifted(&limbs[0], nz.mantissa, addend_offset) then
      fmal_negate(&limbs[0])
      sign = nz.sign
    end
  end

  local top: cint = -1_cint
  local index: cint = 1025_cint
  while index >= 0_cint do
    if limbs[index] ~= 0_culonglong then
      top = index * 64_cint + 63_cint - fma_clz64(limbs[index])
      break
    end
    index = index - 1_cint
  end
  if top < 0_cint then
    local zero_sign: cushort = 0_cushort
    if nelibc_x87_rounding_mode() == 0x0400_cint then zero_sign = 0x8000_cushort end
    local zero: LongDoubleBits = {
      parts = {significand = 0_culonglong, sign_exponent = zero_sign}
    }
    return zero.value
  end

  local shift = top - 63_cint
  if shift < 16445_cint then shift = 16445_cint end
  local word = shift >> 6
  local bit = shift & 63_cint
  local significand = limbs[word] >> bit
  if bit ~= 0_cint then
    significand = significand | (limbs[word + 1] << (64_cint - bit))
  end
  local guard_index = shift - 1_cint
  local guard_word = guard_index >> 6
  local guard_bit = guard_index & 63_cint
  local guard = ((limbs[guard_word] >> guard_bit) & 1_culonglong) ~= 0_culonglong
  local sticky = false
  index = 0_cint
  while index < guard_word do
    if limbs[index] ~= 0_culonglong then
      sticky = true
      break
    end
    index = index + 1_cint
  end
  if guard_bit > 0_cint and
     (limbs[guard_word] & ((1_culonglong << guard_bit) - 1_culonglong)) ~= 0_culonglong then
    sticky = true
  end
  local discarded = guard or sticky
  local rounding_mode = nelibc_x87_rounding_mode()
  local increment = false
  if rounding_mode == 0_cint then
    increment = guard and (sticky or (significand & 1_culonglong) ~= 0_culonglong)
  elseif rounding_mode == 0x0400_cint then
    increment = sign ~= 0_cint and discarded
  elseif rounding_mode == 0x0800_cint then
    increment = sign == 0_cint and discarded
  end
  local significand_overflow = false
  if increment then
    significand = significand + 1_culonglong
    significand_overflow = significand == 0_culonglong
  end

  local exponent_field: cint = 0_cint
  if significand_overflow then
    significand = 0x8000000000000000_culonglong
    if shift == 16445_cint then
      exponent_field = 1_cint
    else
      exponent_field = shift - 16443_cint
    end
  elseif (significand & 0x8000000000000000_culonglong) ~= 0_culonglong then
    exponent_field = shift - 16444_cint
  end

  local overflow = shift > 49210_cint or exponent_field >= 0x7fff_cint or
      (shift == 49210_cint and significand == 0xffffffffffffffff_culonglong and discarded)
  local exception_flags: cint = 0_cint
  if overflow then
    local to_infinity = rounding_mode == 0_cint or
        (rounding_mode == 0x0800_cint and sign == 0_cint) or
        (rounding_mode == 0x0400_cint and sign ~= 0_cint)
    if to_infinity then
      significand = 0x8000000000000000_culonglong
      exponent_field = 0x7fff_cint
    else
      significand = 0xffffffffffffffff_culonglong
      exponent_field = 0x7ffe_cint
    end
    exception_flags = 0x28_cint -- FE_OVERFLOW | FE_INEXACT
    math_range_error()
  else
    if discarded then exception_flags = 0x20_cint end -- FE_INEXACT
    if discarded and top < 16508_cint then
      exception_flags = exception_flags | 0x10_cint -- FE_UNDERFLOW
      math_range_error()
    end
  end
  if exception_flags ~= 0_cint then nelibc_math_raise_except(exception_flags) end
  local result: LongDoubleBits = {
    parts = {significand = significand,
             sign_exponent = ((@cushort)(exponent_field)) | ((@cushort)(sign))}
  }
  return result.value
end

local function fmal(x: clongdouble, y: clongdouble, z: clongdouble): clongdouble
    <cexport, codename 'fmal'>
  return nelibc_fmal(x, y, z)
end

local PowlDD: type = @record{hi: clongdouble, lo: clongdouble}

local function powl_dd_normalize(hi: clongdouble, lo: clongdouble): PowlDD
  local sum = hi + lo
  return {hi = sum, lo = lo - (sum - hi)}
end

local function powl_dd_add(a: PowlDD, b: PowlDD): PowlDD
  local sum = a.hi + b.hi
  local split = sum - a.hi
  local error = (a.hi - (sum - split)) + (b.hi - split) + a.lo + b.lo
  return powl_dd_normalize(sum, error)
end

local function powl_dd_mul(a: PowlDD, b: PowlDD): PowlDD
  local product = a.hi * b.hi
  local error = nelibc_fmal(a.hi, b.hi, -product) + a.hi * b.lo + a.lo * b.hi
  return powl_dd_normalize(product, error)
end

local function powl_dd_div(a: PowlDD, b: PowlDD): PowlDD
  local quotient = a.hi / b.hi
  local product = powl_dd_mul({hi = quotient, lo = 0_clongdouble}, b)
  local remainder = powl_dd_add(a, {hi = -product.hi, lo = -product.lo})
  local correction = (remainder.hi + remainder.lo) / b.hi
  return powl_dd_normalize(quotient, correction)
end

-- Double-double log2(1+x), using the rapidly convergent atanh series.
local function powl_log2p1_dd(value: clongdouble): PowlDD
  local numerator: PowlDD = {hi = value, lo = 0_clongdouble}
  local denominator = powl_dd_add(
    {hi = 2_clongdouble, lo = 0_clongdouble}, numerator
  )
  local z = powl_dd_div(numerator, denominator)
  local z_squared = powl_dd_mul(z, z)
  local term = z
  local sum = z
  for index = 1, 47 do
    term = powl_dd_mul(term, z_squared)
    local odd = (@clongdouble)(2 * index + 1)
    local contribution = powl_dd_div(term, {hi = odd, lo = 0_clongdouble})
    sum = powl_dd_add(sum, contribution)
  end
  return powl_dd_normalize(2_clongdouble * sum.hi, 2_clongdouble * sum.lo)
end

local function powl_mantissa_log2_dd(mantissa: clongdouble): PowlDD
  local input: clongdouble
  local integer_part = 0_clongdouble
  if mantissa <= sqrtl(2_clongdouble) then
    input = mantissa - 1_clongdouble
  else
    input = 0.5_clongdouble * mantissa - 1_clongdouble
    integer_part = 1_clongdouble
  end
  local logarithm = powl_log2p1_dd(input)
  local log_two = powl_log2p1_dd(1_clongdouble)
  local result = powl_dd_div(logarithm, log_two)
  return powl_dd_add(result, {hi = integer_part, lo = 0_clongdouble})
end

local function powl_scaled_exponent_is_integer(exponent: clongdouble, multiplier: cint): boolean <inline>
  if multiplier == 0_cint then return true end
  local bits: LongDoubleBits = {value = exponent}
  local exponent_field = bits.parts.sign_exponent & 0x7fff_cushort
  local binary_shift: cint
  if exponent_field == 0_cushort then
    binary_shift = -16445_cint
  else
    binary_shift = (@cint)(exponent_field) - 16446_cint
  end
  if binary_shift >= 0_cint then return true end

  local trailing_zeroes: cint = 0_cint
  local significand = bits.parts.significand
  while (significand & 1_culonglong) == 0_culonglong and trailing_zeroes < 64_cint do
    significand = significand >> 1
    trailing_zeroes = trailing_zeroes + 1_cint
  end
  local multiplier_magnitude = multiplier
  if multiplier_magnitude < 0_cint then multiplier_magnitude = -multiplier_magnitude end
  local multiplier_bits = (@cuint)(multiplier_magnitude)
  while (multiplier_bits & 1_cuint) == 0_cuint do
    multiplier_bits = multiplier_bits >> 1
    trailing_zeroes = trailing_zeroes + 1_cint
  end
  return trailing_zeroes >= -binary_shift
end

local function powl(value: clongdouble, exponent: clongdouble): clongdouble
    <cexport, codename 'powl'>
  if exponent == 0_clongdouble or value == 1_clongdouble then return 1_clongdouble end
  if is_nan80(value) or is_nan80(exponent) then return value + exponent end
  if exponent == 1_clongdouble then return value end
  local absolute = value
  if absolute < 0_clongdouble then absolute = -absolute end
  local odd = is_odd_integer80(exponent)
  if is_infinite80(exponent) then
    if absolute == 1_clongdouble then return 1_clongdouble end
    if (absolute > 1_clongdouble) == (exponent > 0_clongdouble) then
      local infinity: LongDoubleBits = {
        parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
      }
      return infinity.value
    end
    return 0_clongdouble
  end
  if is_infinite80(value) then
    if exponent > 0_clongdouble then
      local sign_exponent: cushort = 0x7fff_cushort
      if value < 0_clongdouble and odd then sign_exponent = 0xffff_cushort end
      local infinity: LongDoubleBits = {
        parts = {significand = 0x8000000000000000_culonglong, sign_exponent = sign_exponent}
      }
      return infinity.value
    end
    if value < 0_clongdouble and odd then
      local negative_zero: LongDoubleBits = {
        parts = {significand = 0_culonglong, sign_exponent = 0x8000_cushort}
      }
      return negative_zero.value
    end
    return 0_clongdouble
  end
  if value == 0_clongdouble then
    if exponent > 0_clongdouble then
      if is_negative_zero80(value) and odd then return value end
      return 0_clongdouble
    end
    math_range_error()
    local numerator: clongdouble = 1_clongdouble
    if is_negative_zero80(value) and odd then numerator = -1_clongdouble end
    return numerator / (value - value) -- +-inf with DIVBYZERO
  end
  if value < 0_clongdouble and not is_integer80(exponent) then
    math_domain_error()
    return sqrtl(-1_clongdouble)
  end

  local saved_errno = nelibc_errno_location()[0]
  local result: clongdouble
  local exponent_magnitude = exponent
  if exponent_magnitude < 0_clongdouble then exponent_magnitude = -exponent_magnitude end
  local fractional_exponent_limit = 560861783937657_clongdouble
  -- Preserve exact powers of two, including fractional exponents whose product
  -- with the base's binary exponent is integral.
  if exponent_magnitude <= 32768_clongdouble then
    local base_exponent = nelibc_ilogbl_hw(absolute)
    local ignored_range_error: cint = 0_cint
    local power_of_two = nelibc_ldexpl_hw(1_clongdouble, base_exponent, &ignored_range_error)
    if power_of_two == absolute then
      local scaled_exponent = exponent * (@clongdouble)(base_exponent)
      if powl_scaled_exponent_is_integer(exponent, base_exponent) then
        local result_exponent = (@clonglong)(scaled_exponent)
        if result_exponent >= -16445_clonglong and result_exponent <= 16383_clonglong then
          result = nelibc_ldexpl_hw(1_clongdouble, (@cint)(result_exponent), &ignored_range_error)
          if value < 0_clongdouble and odd then result = -result end
          return result
        end
      end
      result = nelibc_exp2l_hw(scaled_exponent)
      if value < 0_clongdouble and odd then result = -result end
      local result_bits: LongDoubleBits = {value = result}
      if is_infinite80(result) or scaled_exponent >= 16384_clongdouble then
        math_range_error()
        nelibc_math_raise_except(0x28_cint) -- FE_OVERFLOW | FE_INEXACT
      elseif result == 0_clongdouble then
        math_range_error()
        nelibc_math_raise_except(0x30_cint) -- FE_UNDERFLOW | FE_INEXACT
      elseif (result_bits.parts.sign_exponent & 0x7fff_cushort) == 0_cushort then
        nelibc_math_raise_except(0x30_cint) -- FE_UNDERFLOW | FE_INEXACT
      end
      return result
    end
  end
  if exponent_magnitude == 0.5_clongdouble then
    result = sqrtl(absolute)
    if exponent < 0_clongdouble then result = 1_clongdouble / result end
  elseif exponent_magnitude == 1.5_clongdouble then
    local root = sqrtl(absolute)
    if exponent < 0_clongdouble then
      result = (1_clongdouble / root) / absolute
    else
      result = absolute * root
    end
  elseif exponent_magnitude <= fractional_exponent_limit and not is_integer80(exponent) then
    -- Split the base into a binary exponent and a [1, 2) mantissa. Keeping
    -- the mantissa logarithm small avoids magnifying logl's absolute error
    -- when the original base is near the ends of the binary80 range.
    local base_exponent: cint = 0_cint
    local mantissa = nelibc_frexpl_hw(absolute, &base_exponent) * 2_clongdouble
    base_exponent = base_exponent - 1_cint
    local scaled_exponent = exponent * (@clongdouble)(base_exponent)
    -- Keep the scale product below LONG_MAX even for binary80 subnormals.
    if scaled_exponent >= -9223372036854770000_clongdouble and
        scaled_exponent <= 9223372036854770000_clongdouble then
      local caller_rounding_mode = nelibc_x87_rounding_mode()
      if caller_rounding_mode ~= 0_cint then
        -- The error-free transforms below require round-to-nearest. Restore
        -- the caller's mode before evaluating the final result.
        nelibc_x87_set_rounding_mode(0_cint)
      end
      local scaled_error = nelibc_fmal(exponent, (@clongdouble)(base_exponent), -scaled_exponent)
      local integral_exponent = truncl(scaled_exponent)
      local fractional_exponent = scaled_exponent - integral_exponent + scaled_error
      local mantissa_log2: PowlDD
      if exponent_magnitude <= 576_clongdouble and
          (nelibc_x87_rounding_mode() == 0_cint or exponent_magnitude <= 256_clongdouble) then
        local logarithm: clongdouble
        if mantissa <= sqrtl(2_clongdouble) then
          logarithm = nelibc_log2p1l_small_hw(mantissa - 1_clongdouble)
        else
          logarithm = 1_clongdouble +
              nelibc_log2p1l_small_hw(0.5_clongdouble * mantissa - 1_clongdouble)
        end
        mantissa_log2 = {hi = logarithm, lo = 0_clongdouble}
      else
        mantissa_log2 = powl_mantissa_log2_dd(mantissa)
      end
      local mantissa_scaled_exponent = powl_dd_mul(
        mantissa_log2, {hi = exponent, lo = 0_clongdouble}
      )
      local mantissa_integral_exponent = truncl(mantissa_scaled_exponent.hi)
      local mantissa_fraction = powl_dd_add(
        {
          hi = mantissa_scaled_exponent.hi - mantissa_integral_exponent,
          lo = mantissa_scaled_exponent.lo
        },
        {hi = fractional_exponent, lo = 0_clongdouble}
      )
      local final_fractional_exponent = mantissa_fraction.hi + mantissa_fraction.lo
      local final_integral_exponent = integral_exponent + mantissa_integral_exponent
      if caller_rounding_mode ~= 0_cint then
        nelibc_x87_set_rounding_mode(caller_rounding_mode)
      end
      -- Keep the original nearest path when its intermediate remains normal;
      -- otherwise combine the integer scale first to avoid premature range loss.
      if caller_rounding_mode == 0_cint and
          mantissa_scaled_exponent.hi <= 16383_clongdouble and
          mantissa_scaled_exponent.hi >= -16382_clongdouble then
        local mantissa_power = exp2l(mantissa_scaled_exponent.hi) *
            exp2l(mantissa_scaled_exponent.lo)
        result = scalblnl(mantissa_power * exp2l(fractional_exponent),
                          (@clong)(integral_exponent))
      else
        result = scalblnl(exp2l(final_fractional_exponent),
                          (@clong)(final_integral_exponent))
      end
      if value < 0_clongdouble and odd then result = -result end
    else
      local logarithm = logl(absolute)
      result = expl(exponent * logarithm)
      if value < 0_clongdouble and odd then result = -result end
    end
  elseif is_integer80(exponent) and exponent_magnitude <= 128_clongdouble then
    local power: cuint = (@cuint)(exponent_magnitude)
    local base = absolute
    if exponent < 0_clongdouble then base = 1_clongdouble / base end
    result = 1_clongdouble
    while power ~= 0_cuint do
      if (power & 1_cuint) ~= 0_cuint then result = result * base end
      power = power >> 1
      if power ~= 0_cuint then base = base * base end
    end
    if value < 0_clongdouble and odd then result = -result end
  else
    local logarithm = logl(absolute)
    local scaled_exponent = exponent * logarithm
    if is_infinite80(scaled_exponent) and
        not is_infinite80(exponent) and not is_infinite80(logarithm) then
      math_range_error()
    end
    result = expl(scaled_exponent)
    if value < 0_clongdouble and odd then result = -result end
  end

  local result_bits: LongDoubleBits = {value = result}
  if is_infinite80(result) and not is_infinite80(value) then
    math_range_error()
  elseif result == 0_clongdouble and value ~= 0_clongdouble then
    math_range_error()
  elseif (result_bits.parts.sign_exponent & 0x7fff_cushort) == 0_cushort and
      result_bits.parts.significand ~= 0_culonglong then
    -- Underflow to a nonzero subnormal does not set errno in glibc or musl.
    nelibc_errno_location()[0] = saved_errno
  end
  return result
end

local function exp10l(value: clongdouble): clongdouble <cexport, codename 'exp10l'>
  -- Near the binary80 underflow boundary, powl's log/exp path loses too much
  -- accuracy in the exponent. Use a split log2(10) and exp2l's exact binary
  -- scaling so representable subnormal results survive the final rounding.
  if value < -4000_clongdouble and value > -5000_clongdouble then
    local log2_10_high_bits: LongDoubleBits = {
      parts = {significand = 0xd49a784bcd1b8afe_culonglong,
               sign_exponent = 0x4000_cushort}
    }
    local log2_10_low_bits: LongDoubleBits = {
      parts = {significand = 0x9257edfe9b5fb69a_culonglong,
               sign_exponent = 0x3fbf_cushort}
    }
    local log2_10_high = log2_10_high_bits.value
    local log2_10_low = log2_10_low_bits.value
    local product_high = value * log2_10_high
    local product_error = nelibc_fmal(value, log2_10_high, -product_high)
    local low_correction = nelibc_fmal(value, log2_10_low, product_error)
    local scale = truncl(product_high)
    local fraction = (product_high - scale) + low_correction
    return ldexpl(exp2l(fraction), (@cint)(scale))
  end
  return powl(10_clongdouble, value)
end

local function pow10l(value: clongdouble): clongdouble <cexport, codename 'pow10l'>
  return exp10l(value)
end

local function fmaf(x: cfloat, y: cfloat, z: cfloat): cfloat
    <cexport, codename 'fmaf'>
  local product = (@cdouble)(x) * (@cdouble)(y)
  local result = product + (@cdouble)(z)
  local representation: DoubleBits = {value = result}
  local exponent = (@cint)((representation.bits >> 52) & 0x7FF_culonglong)
  if (representation.bits & 0x1FFFFFFF_culonglong) ~= 0x10000000_culonglong or
      exponent == 0x7FF_cint or (result - product == (@cdouble)(z) and
      result - (@cdouble)(z) == product) then
    return (@cfloat)(result)
  end
  local negative = (representation.bits >> 63) ~= 0_culonglong
  local error: cdouble
  if negative == ((@cdouble)(z) > product) then
    error = product - result + (@cdouble)(z)
  else
    error = (@cdouble)(z) - result + product
  end
  if negative == (error < 0_cdouble) then
    representation.bits = representation.bits + 1_culonglong
  else
    representation.bits = representation.bits - 1_culonglong
  end
  return (@cfloat)(representation.value)
end

local function nextafter(x: cdouble, y: cdouble): cdouble <cexport, codename 'nextafter'>
  if is_signaling_nan(x) then return x + x end
  if is_signaling_nan(y) then return y + y end
  if is_nan64(x) then return x + y end
  if is_nan64(y) then return x + y end
  if x == y then return y end
  local xbits: DoubleBits = {value = x}
  local ybits: DoubleBits = {value = y}
  if (xbits.bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then
    xbits.bits = (ybits.bits & 0x8000000000000000_culonglong) | 1_culonglong
  elseif (x < y) == (x > 0_cdouble) then
    xbits.bits = xbits.bits + 1_culonglong
  else
    xbits.bits = xbits.bits - 1_culonglong
  end
  local result_field = xbits.bits & 0x7FF0000000000000_culonglong
  if result_field == 0x7FF0000000000000_culonglong and not is_infinite64(x) then
    math_range_error()
    nelibc_math_raise_except(0x28_cint) -- FE_OVERFLOW | FE_INEXACT
  elseif result_field == 0_culonglong then
    -- nextafter raises underflow for every subnormal result, including zero to
    -- the least subnormal. Preserve the host errno convention for zero input.
    if x ~= 0_cdouble then math_range_error() end
    nelibc_math_raise_except(0x30_cint) -- FE_UNDERFLOW | FE_INEXACT
  end
  return xbits.value
end

local function nextafterf(x: cfloat, y: cfloat): cfloat <cexport, codename 'nextafterf'>
  if is_signaling_nanf(x) then return x + x end
  if is_signaling_nanf(y) then return y + y end
  if is_nan32(x) then return x + y end
  if is_nan32(y) then return x + y end
  if x == y then return y end
  local xbits: FloatBits = {value = x}
  local ybits: FloatBits = {value = y}
  if (xbits.bits & 0x7FFFFFFF_cuint) == 0_cuint then
    xbits.bits = (ybits.bits & 0x80000000_cuint) | 1_cuint
  elseif (x < y) == (x > 0_cfloat) then
    xbits.bits = xbits.bits + 1_cuint
  else
    xbits.bits = xbits.bits - 1_cuint
  end
  local result_field = xbits.bits & 0x7F800000_cuint
  if result_field == 0x7F800000_cuint and not is_infinite32(x) then
    math_range_error()
    nelibc_math_raise_except(0x28_cint) -- FE_OVERFLOW | FE_INEXACT
  elseif result_field == 0_cuint then
    if x ~= 0_cfloat then math_range_error() end
    nelibc_math_raise_except(0x30_cint) -- FE_UNDERFLOW | FE_INEXACT
  end
  return xbits.value
end

local function nexttoward(x: cdouble, y: clongdouble): cdouble <cexport, codename 'nexttoward'>
  -- Compare in the direction type before narrowing: y may lie between x and
  -- its adjacent double, where converting y to double would lose direction.
  if x ~= x or y ~= y then return nextafter(x, (@cdouble)(y)) end
  if (@clongdouble)(x) == y then return (@cdouble)(y) end
  if (@clongdouble)(x) < y then
    return nextafter(x, double_from_bits(0x7FF0000000000000_culonglong))
  end
  return nextafter(x, double_from_bits(0xFFF0000000000000_culonglong))
end

local function nexttowardf(x: cfloat, y: clongdouble): cfloat <cexport, codename 'nexttowardf'>
  if x ~= x or y ~= y then return nextafterf(x, (@cfloat)(y)) end
  if (@clongdouble)(x) == y then return (@cfloat)(y) end
  if (@clongdouble)(x) < y then
    return nextafterf(x, float_from_bits(0x7F800000_cuint))
  end
  return nextafterf(x, float_from_bits(0xFF800000_cuint))
end

local function fmod(x: cdouble, y: cdouble): cdouble <cexport, codename 'fmod'>
  check_remainder_domain(x, y)
  return nelibc_fmod_hw(x, y)
end

local function fmodf(x: cfloat, y: cfloat): cfloat <cexport, codename 'fmodf'>
  check_remainder_domain((@cdouble)(x), (@cdouble)(y))
  return (@cfloat)(nelibc_fmod_hw((@cdouble)(x), (@cdouble)(y)))
end

local function remainder(x: cdouble, y: cdouble): cdouble
    <cexport, codename 'remainder'>
  check_remainder_domain(x, y)
  return nelibc_remainder_hw(x, y)
end

local function remainderf(x: cfloat, y: cfloat): cfloat
    <cexport, codename 'remainderf'>
  check_remainder_domain((@cdouble)(x), (@cdouble)(y))
  return (@cfloat)(nelibc_remainder_hw((@cdouble)(x), (@cdouble)(y)))
end

local function fmodl(x: clongdouble, y: clongdouble): clongdouble <cexport, codename 'fmodl'>
  check_remainder_domain80(x, y)
  return nelibc_fmodl_hw(x, y)
end

local function remainderl(x: clongdouble, y: clongdouble): clongdouble
    <cexport, codename 'remainderl'>
  check_remainder_domain80(x, y)
  return nelibc_remainderl_hw(x, y)
end

local function drem(x: cdouble, y: cdouble): cdouble <cexport, codename 'drem'>
  return remainder(x, y)
end
local function dremf(x: cfloat, y: cfloat): cfloat <cexport, codename 'dremf'>
  return remainderf(x, y)
end

local function remquo(x: cdouble, y: cdouble, quotient: *[0]cint): cdouble
    <cexport, codename 'remquo'>
  check_remainder_domain(x, y)
  if is_nan64(x) or is_nan64(y) or is_infinite64(x) or y == 0_cdouble then
    quotient[0] = 0_cint
    return nelibc_remainder_hw(x, y)
  end
  return nelibc_remquo_hw(x, y, quotient)
end

local function remquof(x: cfloat, y: cfloat, quotient: *[0]cint): cfloat
    <cexport, codename 'remquof'>
  local result: cint
  local value = remquo((@cdouble)(x), (@cdouble)(y), &result)
  quotient[0] = result
  return (@cfloat)(value)
end

local function remquol(x: clongdouble, y: clongdouble, quotient: *[0]cint): clongdouble
    <cexport, codename 'remquol'>
  check_remainder_domain80(x, y)
  if is_nan80(x) or is_nan80(y) or is_infinite80(x) or y == 0_clongdouble then
    quotient[0] = 0_cint
    return nelibc_remainderl_hw(x, y)
  end
  return nelibc_remquol_hw(x, y, quotient)
end

local function fmin(x: cdouble, y: cdouble): cdouble <cexport, codename 'fmin'>
  if is_signaling_nan(x) then return x + x end
  if is_signaling_nan(y) then return y + y end
  if x ~= x then return y end
  if y ~= y then return x end
  if x < y then return x end
  if y < x then return y end
  if x == 0_cdouble then
    if is_negative_zero64(x) or is_negative_zero64(y) then
      return double_from_bits(0x8000000000000000_culonglong)
    end
    return 0_cdouble
  end
  return y -- Either operand has the same value here.
end

local function fmax(x: cdouble, y: cdouble): cdouble <cexport, codename 'fmax'>
  if is_signaling_nan(x) then return x + x end
  if is_signaling_nan(y) then return y + y end
  if x ~= x then return y end
  if y ~= y then return x end
  if x < y then return y end
  if y < x then return x end
  if x == 0_cdouble then
    if not is_negative_zero64(x) or not is_negative_zero64(y) then return 0_cdouble end
    return double_from_bits(0x8000000000000000_culonglong)
  end
  return y
end

local function fminf(x: cfloat, y: cfloat): cfloat <cexport, codename 'fminf'>
  if is_signaling_nanf(x) then return x + x end
  if is_signaling_nanf(y) then return y + y end
  if x ~= x then return y end
  if y ~= y then return x end
  if x < y then return x end
  if y < x then return y end
  if x == 0_cfloat then
    if is_negative_zerof(x) or is_negative_zerof(y) then
      return float_from_bits(0x80000000_cuint)
    end
    return 0_cfloat
  end
  return y
end

local function fmaxf(x: cfloat, y: cfloat): cfloat <cexport, codename 'fmaxf'>
  if is_signaling_nanf(x) then return x + x end
  if is_signaling_nanf(y) then return y + y end
  if x ~= x then return y end
  if y ~= y then return x end
  if x < y then return y end
  if y < x then return x end
  if x == 0_cfloat then
    if not is_negative_zerof(x) or not is_negative_zerof(y) then return 0_cfloat end
    return float_from_bits(0x80000000_cuint)
  end
  return y
end

local function fdim(x: cdouble, y: cdouble): cdouble <cexport, codename 'fdim'>
  if x ~= x or y ~= y then return x + y end
  if x <= y then return 0_cdouble end
  local result = x - y
  if is_infinite64(result) and not is_infinite64(x) and not is_infinite64(y) then
    math_range_error()
  end
  return result
end

local function fdimf(x: cfloat, y: cfloat): cfloat <cexport, codename 'fdimf'>
  if x ~= x or y ~= y then return x + y end
  if x <= y then return 0_cfloat end
  local result = x - y
  if is_infinite32(result) and not is_infinite32(x) and not is_infinite32(y) then
    math_range_error()
  end
  return result
end

local function fminl(x: clongdouble, y: clongdouble): clongdouble
    <cexport, codename 'fminl'>
  if is_signaling_nan80(x) then return x + x end
  if is_signaling_nan80(y) then return y + y end
  if is_nan80(x) then return y end
  if is_nan80(y) then return x end
  if x < y then return x end
  if y < x then return y end
  if x == 0_clongdouble then
    if is_negative_zero80(x) or is_negative_zero80(y) then
      local negative_zero: LongDoubleBits = {
        parts = {significand = 0_culonglong, sign_exponent = 0x8000_cushort}
      }
      return negative_zero.value
    end
    return 0_clongdouble
  end
  return y
end

local function fmaxl(x: clongdouble, y: clongdouble): clongdouble
    <cexport, codename 'fmaxl'>
  if is_signaling_nan80(x) then return x + x end
  if is_signaling_nan80(y) then return y + y end
  if is_nan80(x) then return y end
  if is_nan80(y) then return x end
  if x < y then return y end
  if y < x then return x end
  if x == 0_clongdouble then
    if not is_negative_zero80(x) or not is_negative_zero80(y) then
      return 0_clongdouble
    end
    local negative_zero: LongDoubleBits = {
      parts = {significand = 0_culonglong, sign_exponent = 0x8000_cushort}
    }
    return negative_zero.value
  end
  return y
end

local function fdiml(x: clongdouble, y: clongdouble): clongdouble
    <cexport, codename 'fdiml'>
  if is_nan80(x) or is_nan80(y) then return x + y end
  if x <= y then return 0_clongdouble end
  local result = x - y
  if is_infinite80(result) and not is_infinite80(x) and not is_infinite80(y) then
    math_range_error()
  end
  return result
end

local function frexp(value: cdouble, exponent: *[0]cint): cdouble
    <cexport, codename 'frexp'>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits
  local field = (@cint)((bits >> 52) & 0x7FF_culonglong)
  local fraction = bits & 0x000FFFFFFFFFFFFF_culonglong
  if field == 0x7FF_cint or (field == 0_cint and fraction == 0_culonglong) then
    exponent[0] = 0_cint
    return value
  end
  if field == 0_cint then
    local shifts: cint = 0_cint
    while (fraction & 0x0010000000000000_culonglong) == 0_culonglong do
      fraction = fraction << 1
      shifts = shifts + 1_cint
    end
    exponent[0] = -1021_cint - shifts
    representation.bits = (bits & 0x8000000000000000_culonglong) |
      0x3FE0000000000000_culonglong |
      (fraction & 0x000FFFFFFFFFFFFF_culonglong)
    return representation.value
  end
  exponent[0] = field - 1022_cint
  representation.bits = (bits & 0x800FFFFFFFFFFFFF_culonglong) |
    0x3FE0000000000000_culonglong
  return representation.value
end

local function frexpf(value: cfloat, exponent: *[0]cint): cfloat
    <cexport, codename 'frexpf'>
  local representation: FloatBits = {value = value}
  local bits = representation.bits
  local field = (@cint)((bits >> 23) & 0xFF_cuint)
  local fraction = bits & 0x007FFFFF_cuint
  if field == 0xFF_cint or (field == 0_cint and fraction == 0_cuint) then
    exponent[0] = 0_cint
    return value
  end
  if field == 0_cint then
    local shifts: cint = 0_cint
    while (fraction & 0x00800000_cuint) == 0_cuint do
      fraction = fraction << 1
      shifts = shifts + 1_cint
    end
    exponent[0] = -125_cint - shifts
    representation.bits = (bits & 0x80000000_cuint) |
      0x3F000000_cuint | (fraction & 0x007FFFFF_cuint)
    return representation.value
  end
  exponent[0] = field - 126_cint
  representation.bits = (bits & 0x807FFFFF_cuint) | 0x3F000000_cuint
  return representation.value
end

local function frexpl(value: clongdouble, exponent: *[0]cint): clongdouble
    <cexport, codename 'frexpl'>
  return nelibc_frexpl_hw(value, exponent)
end

local function fabsf(value: cfloat): cfloat <cexport, codename 'fabsf'>
  local representation: FloatBits = {value = value}
  representation.bits = representation.bits & 0x7FFFFFFF_cuint
  return representation.value
end

local function fabs(value: cdouble): cdouble <cexport, codename 'fabs'>
  local representation: DoubleBits = {value = value}
  representation.bits = representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong
  return representation.value
end

local function fabsl(value: clongdouble): clongdouble <cexport, codename 'fabsl'>
  return nelibc_fabsl_hw(value)
end

local function copysignf(magnitude: cfloat, sign: cfloat): cfloat
    <cexport, codename 'copysignf'>
  local magnitude_bits: FloatBits = {value = magnitude}
  local sign_bits: FloatBits = {value = sign}
  magnitude_bits.bits = (magnitude_bits.bits & 0x7FFFFFFF_cuint) |
    (sign_bits.bits & 0x80000000_cuint)
  return magnitude_bits.value
end

local function copysign(magnitude: cdouble, sign: cdouble): cdouble
    <cexport, codename 'copysign'>
  local magnitude_bits: DoubleBits = {value = magnitude}
  local sign_bits: DoubleBits = {value = sign}
  magnitude_bits.bits = (magnitude_bits.bits & 0x7FFFFFFFFFFFFFFF_culonglong) |
    (sign_bits.bits & 0x8000000000000000_culonglong)
  return magnitude_bits.value
end

local function copysignl(magnitude: clongdouble, sign: clongdouble): clongdouble
    <cexport, codename 'copysignl'>
  return nelibc_copysignl_hw(magnitude, sign)
end

local function round_binary64(value: cdouble, mode: cint): cdouble <inline>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits
  local sign = bits & 0x8000000000000000_culonglong
  local exponent = (@cint)((bits >> 52) & 0x7FF_culonglong)
  if exponent == 0x7FF_cint then return value end -- NaN or infinity
  if (bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0 then return value end

  local unbiased = exponent - 1023_cint
  if unbiased < 0_cint then
    if mode == 0_cint then return double_from_bits(sign) end -- trunc
    if mode == 1_cint then -- floor
      if sign ~= 0_culonglong then return -1_cdouble end
      return double_from_bits(0_culonglong)
    end
    if mode == 2_cint then -- ceil
      if sign == 0_culonglong then return 1_cdouble end
      return double_from_bits(sign)
    end
    if unbiased == -1_cint and
        (bits & 0x7FFFFFFFFFFFFFFF_culonglong) >= 0x3FE0000000000000_culonglong then
      if sign ~= 0_culonglong then return -1_cdouble end
      return 1_cdouble
    end
    return double_from_bits(sign)
  end
  if unbiased >= 52_cint then return value end

  local fractional_bits: cint = 52_cint - unbiased
  local mask: culonglong = (1_culonglong << fractional_bits) - 1_culonglong
  local fraction = bits & mask
  if fraction == 0_culonglong then return value end
  local truncated = double_from_bits(bits & (~mask))
  if mode == 1_cint then
    if sign ~= 0_culonglong then return truncated - 1_cdouble end
    return truncated
  end
  if mode == 2_cint then
    if sign == 0_culonglong then return truncated + 1_cdouble end
    return truncated
  end
  if mode == 3_cint then
    local half: culonglong = 1_culonglong << (fractional_bits - 1_cint)
    if fraction >= half then
      if sign ~= 0_culonglong then return truncated - 1_cdouble end
      return truncated + 1_cdouble
    end
    return truncated
  end
  return truncated
end

local function round_binary32(value: cfloat, mode: cint): cfloat <inline>
  local representation: FloatBits = {value = value}
  local bits = representation.bits
  local sign = bits & 0x80000000_cuint
  local exponent = (@cint)((bits >> 23) & 0xFF_cuint)
  if exponent == 0xFF_cint then return value end
  if (bits & 0x7FFFFFFF_cuint) == 0 then return value end

  local unbiased = exponent - 127_cint
  if unbiased < 0_cint then
    if mode == 0_cint then return float_from_bits(sign) end
    if mode == 1_cint then
      if sign ~= 0_cuint then return -1_cfloat end
      return float_from_bits(0_cuint)
    end
    if mode == 2_cint then
      if sign == 0_cuint then return 1_cfloat end
      return float_from_bits(sign)
    end
    if unbiased == -1_cint and
        (bits & 0x7FFFFFFF_cuint) >= 0x3F000000_cuint then
      if sign ~= 0_cuint then return -1_cfloat end
      return 1_cfloat
    end
    return float_from_bits(sign)
  end
  if unbiased >= 23_cint then return value end

  local fractional_bits: cint = 23_cint - unbiased
  local mask: cuint = (1_cuint << fractional_bits) - 1_cuint
  local fraction = bits & mask
  if fraction == 0_cuint then return value end
  local truncated = float_from_bits(bits & (~mask))
  if mode == 1_cint then
    if sign ~= 0_cuint then return truncated - 1_cfloat end
    return truncated
  end
  if mode == 2_cint then
    if sign == 0_cuint then return truncated + 1_cfloat end
    return truncated
  end
  if mode == 3_cint then
    local half: cuint = 1_cuint << (fractional_bits - 1_cint)
    if fraction >= half then
      if sign ~= 0_cuint then return truncated - 1_cfloat end
      return truncated + 1_cfloat
    end
    return truncated
  end
  return truncated
end

-- Range-reduced Taylor kernel. The residual is close to [-ln(2)/2, ln(2)/2];
-- the split ln(2) constants keep the reduction accurate for the full binary64
-- exponent range. Scaling uses the same x86-64 primitive as ldexp.
-- exp, exp2 and the exp step of pow follow musl 1.2.5 src/math/exp.c,
-- exp2.c and pow.c (Copyright (c) 2018, Arm Limited, MIT): 2^(k/128) from a
-- 128-entry table of (tail, scale) pairs times a degree-5 polynomial in the
-- reduced argument. exp_data_tab is musl's __exp_data.tab verbatim.
local exp_invln2n: cdouble = 0x1.71547652B82FEP+7_cdouble -- 128/ln2
local exp_negln2hin: cdouble = -0x1.62E42FEFA0000P-8_cdouble
local exp_negln2lon: cdouble = -0x1.CF79ABC9E3B3AP-47_cdouble
local exp_shift: cdouble = 0x1.8P+52_cdouble
local exp_poly_c2: cdouble = 0x1.FFFFFFFFFFDBDP-2_cdouble
local exp_poly_c3: cdouble = 0x1.555555555543CP-3_cdouble
local exp_poly_c4: cdouble = 0x1.55555CF172B91P-5_cdouble
local exp_poly_c5: cdouble = 0x1.1111167A4D017P-7_cdouble
local exp2_shift: cdouble = 0x1.8P+45_cdouble -- 0x1.8p52 / 128
local exp2_poly_c1: cdouble = 0x1.62E42FEFA39EFP-1_cdouble
local exp2_poly_c2: cdouble = 0x1.EBFBDFF82C424P-3_cdouble
local exp2_poly_c3: cdouble = 0x1.C6B08D70CF4B5P-5_cdouble
local exp2_poly_c4: cdouble = 0x1.3B2ABD24650CCP-7_cdouble
local exp2_poly_c5: cdouble = 0x1.5D7E09B4E3A84P-10_cdouble

-- Results near overflow or underflow: scale*(1+tmp) without an intermediate
-- rounding. The exponent of scale may have run into the sign bit, so sbits
-- is adjusted before use. ki with bit 31 clear means k > 0 (overflow side).
local function exp_specialcase(tmp: cdouble, sbits: culonglong, ki: culonglong,
    base_two: boolean): cdouble
  if (ki & 0x80000000_culonglong) == 0_culonglong then
    local y: cdouble
    if base_two then
      -- exp2: the exponent of scale might have overflowed by 1.
      local scale = double_from_bits(sbits - (1_culonglong << 52))
      y = 2_cdouble * (scale + scale * tmp)
    else
      -- exp: the exponent of scale might have overflowed by up to 460.
      local scale = double_from_bits(sbits - (1009_culonglong << 52))
      y = 0x1p1009_cdouble * (scale + scale * tmp)
    end
    if is_infinite64(y) then math_range_error() end
    return y
  end
  -- k < 0: the result may be subnormal. After the adjustment the sign bit of
  -- sbits is only pow's sign bias.
  sbits = sbits + (1022_culonglong << 52)
  local scale = double_from_bits(sbits)
  local y = scale + scale * tmp
  if fabs(y) < 1_cdouble then
    -- Round y to the final precision before scaling into the subnormal range
    -- so the double rounding cannot add 0.5 ulp of error.
    local one: cdouble = 1_cdouble
    if y < 0_cdouble then one = -1_cdouble end
    local lo = scale - y + scale * tmp
    local hi = one + y
    lo = one - hi + y + lo
    y = (hi + lo) - one
    -- Fix the sign of zero.
    if y == 0_cdouble then y = double_from_bits(sbits & 0x8000000000000000_culonglong) end
    -- The underflow exception needs to be signaled explicitly.
    force_eval(nelibc_fp_barrier_hw(0x1p-1022_cdouble) * 0x1p-1022_cdouble)
  end
  local result = 0x1p-1022_cdouble * y
  if result == 0_cdouble then math_range_error() end
  return result
end

-- sign*exp(x+xtail) with |xtail| < 2^-15 and |xtail| <= |x| (musl exp_inline).
local function exp_inline(x: cdouble, xtail: cdouble, negative: boolean): cdouble
  local abstop = top12(x) & 0x7FF_cuint
  local special = false
  if abstop < 0x3C9_cuint then
    -- |x| < 2^-54: 1+x rounds correctly without a spurious underflow.
    local one = 1_cdouble + x
    if negative then return -one end
    return one
  end
  if abstop >= 0x408_cuint then
    if abstop >= 0x409_cuint then
      -- |x| >= 1024, infinity or NaN.
      local bits = bits_of_double(x)
      if bits == 0xFFF0000000000000_culonglong then return 0_cdouble end
      if abstop >= 0x7FF_cuint then return 1_cdouble + x end
      if (bits >> 63) ~= 0_culonglong then return math_uflow(negative) end
      return math_oflow(negative)
    end
    -- 512 <= |x| < 1024 may overflow or underflow the scale.
    special = true
  end
  -- exp(x) = 2^(k/128) * exp(r) with r in [-ln2/256, ln2/256].
  local z = exp_invln2n * x
  local kd = z + exp_shift
  local ki = bits_of_double(kd)
  kd = kd - exp_shift
  local r = x + kd * exp_negln2hin + kd * exp_negln2lon
  r = r + xtail
  local idx = 2_culonglong * (ki % 128_culonglong)
  local bias: culonglong = 0_culonglong
  if negative then bias = 0x800_culonglong << 7 end
  local top = (ki + bias) << 45
  local tail = double_from_bits(exp_data_tab[idx])
  local sbits = exp_data_tab[idx + 1] + top
  local r2 = r * r
  local tmp = tail + r + r2 * (exp_poly_c2 + r * exp_poly_c3) +
    r2 * r2 * (exp_poly_c4 + r * exp_poly_c5)
  if special then return exp_specialcase(tmp, sbits, ki, false) end
  local scale = double_from_bits(sbits)
  return scale + scale * tmp
end

local function exp_core(value: cdouble): cdouble <inline>
  return exp_inline(value, 0_cdouble, false)
end

local function exp(value: cdouble): cdouble <cexport, codename 'exp'>
  return exp_inline(value, 0_cdouble, false)
end

local function expf(value: cfloat): cfloat <cexport, codename 'expf'>
  local result = (@cfloat)(exp_core((@cdouble)(value)))
  local result_bits: FloatBits = {value = result}
  local result_field = result_bits.bits & 0x7F800000_cuint
  if result_field == 0x7F800000_cuint or result_field == 0_cuint then
    if value == value and not is_infinite32(value) then math_range_error() end
  end
  return result
end

local function erf_erfc_middle(x: cdouble): cdouble <inline>
  local offset = x - 1_cdouble
  local p = erf_pa[0] + offset * (erf_pa[1] + offset * (erf_pa[2] + offset *
    (erf_pa[3] + offset * (erf_pa[4] + offset * (erf_pa[5] + offset * erf_pa[6])))))
  local q = 1_cdouble + offset * (erf_qa[0] + offset * (erf_qa[1] + offset *
    (erf_qa[2] + offset * (erf_qa[3] + offset * (erf_qa[4] + offset * erf_qa[5])))))
  return 1_cdouble - 0.845062911510467529297_cdouble - p / q
end

local function erfc_positive(x: cdouble): cdouble
  if x < 0.84375_cdouble then
    if x < 0x1p-56_cdouble then return 1_cdouble - x end
    local z = x * x
    local p = erf_pp[0] + z * (erf_pp[1] + z * (erf_pp[2] + z * (erf_pp[3] + z * erf_pp[4])))
    local q = 1_cdouble + z * (erf_qq[0] + z * (erf_qq[1] + z * (erf_qq[2] + z * (erf_qq[3] + z * erf_qq[4]))))
    local xy = x * (p / q)
    if x < 0.25_cdouble then return 1_cdouble - (x + xy) end
    return 0.5_cdouble - (x - 0.5_cdouble + xy)
  end
  if x < 1.25_cdouble then return erf_erfc_middle(x) end
  local inverse_square = 1_cdouble / (x * x)
  local r: cdouble
  local denominator: cdouble
  if x < 2.857142857142857_cdouble then
    r = erf_ra[0] + inverse_square * (erf_ra[1] + inverse_square * (erf_ra[2] + inverse_square * (erf_ra[3] + inverse_square * (erf_ra[4] + inverse_square * (erf_ra[5] + inverse_square * (erf_ra[6] + inverse_square * erf_ra[7]))))))
    denominator = 1_cdouble + inverse_square * (erf_sa[0] + inverse_square * (erf_sa[1] + inverse_square * (erf_sa[2] + inverse_square * (erf_sa[3] + inverse_square * (erf_sa[4] + inverse_square * (erf_sa[5] + inverse_square * (erf_sa[6] + inverse_square * erf_sa[7])))))))
  else
    r = erf_rb[0] + inverse_square * (erf_rb[1] + inverse_square * (erf_rb[2] + inverse_square * (erf_rb[3] + inverse_square * (erf_rb[4] + inverse_square * (erf_rb[5] + inverse_square * erf_rb[6])))))
    denominator = 1_cdouble + inverse_square * (erf_sb[0] + inverse_square * (erf_sb[1] + inverse_square * (erf_sb[2] + inverse_square * (erf_sb[3] + inverse_square * (erf_sb[4] + inverse_square * (erf_sb[5] + inverse_square * erf_sb[6]))))))
  end
  local high_bits: DoubleBits = {value = x}
  high_bits.bits = high_bits.bits & 0xFFFFFFFF00000000_culonglong
  local high = high_bits.value
  return exp(-high * high - 0.5625_cdouble) * exp((high - x) * (high + x) + r / denominator) / x
end

local function erf(value: cdouble): cdouble <cexport, codename 'erf'>
  if is_nan64(value) then return value + value end
  if is_infinite64(value) then return copysign(1_cdouble, value) end
  local magnitude = fabs(value)
  local result: cdouble
  if magnitude < 0.84375_cdouble then
    if magnitude < 0x1p-28_cdouble then return value * 1.12837916709551257390_cdouble end
    local z = value * value
    local p = erf_pp[0] + z * (erf_pp[1] + z * (erf_pp[2] + z * (erf_pp[3] + z * erf_pp[4])))
    local q = 1_cdouble + z * (erf_qq[0] + z * (erf_qq[1] + z * (erf_qq[2] + z * (erf_qq[3] + z * erf_qq[4]))))
    return value + value * (p / q)
  end
  if magnitude >= 6_cdouble then result = 1_cdouble - 0x1p-1022_cdouble
  else result = 1_cdouble - erfc_positive(magnitude) end
  return copysign(result, value)
end

local function erfc(value: cdouble): cdouble <cexport, codename 'erfc'>
  if is_nan64(value) then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return 2_cdouble end
    return 0_cdouble
  end
  local magnitude = fabs(value)
  if magnitude >= 28_cdouble then
    if value < 0_cdouble then return 2_cdouble - 0x1p-1022_cdouble end
    return 0x1p-1022_cdouble * 0x1p-1022_cdouble
  end
  local tail = erfc_positive(magnitude)
  if value < 0_cdouble then return 2_cdouble - tail end
  return tail
end

local function erff(value: cfloat): cfloat <cexport, codename 'erff'>
  return (@cfloat)(erf((@cdouble)(value)))
end

local function erfcf(value: cfloat): cfloat <cexport, codename 'erfcf'>
  return (@cfloat)(erfc((@cdouble)(value)))
end

-- Evaluate 2^x by separating its integral binary scale from a small
-- fractional remainder. This avoids multiplying the full input by ln(2),
-- which loses many bits for ordinary fractions.

local function exp2(value: cdouble): cdouble <cexport, codename 'exp2'>
  local abstop = top12(value) & 0x7FF_cuint
  local special = false
  if abstop < 0x3C9_cuint then return 1_cdouble + value end
  if abstop >= 0x408_cuint then
    local bits = bits_of_double(value)
    if abstop >= 0x409_cuint then
      if bits == 0xFFF0000000000000_culonglong then return 0_cdouble end
      if abstop >= 0x7FF_cuint then return 1_cdouble + value end
      if (bits >> 63) == 0_culonglong then return math_oflow(false) end
      -- x <= -1075 underflows to zero; closer to -1024 is still subnormal.
      if bits >= 0xC090CC0000000000_culonglong then return math_uflow(false) end
    end
    if (bits & 0x7FFFFFFFFFFFFFFF_culonglong) > 0x408D000000000000_culonglong then special = true end -- |x| > 928
  end
  -- exp2(x) = 2^(k/128) * 2^r with r in [-1/256, 1/256].
  local kd = value + exp2_shift
  local ki = bits_of_double(kd)
  kd = kd - exp2_shift
  local r = value - kd
  local idx = 2_culonglong * (ki % 128_culonglong)
  local top = ki << 45
  local tail = double_from_bits(exp_data_tab[idx])
  local sbits = exp_data_tab[idx + 1] + top
  local r2 = r * r
  local tmp = tail + r * exp2_poly_c1 + r2 * (exp2_poly_c2 + r * exp2_poly_c3) +
    r2 * r2 * (exp2_poly_c4 + r * exp2_poly_c5)
  if special then return exp_specialcase(tmp, sbits, ki, true) end
  local scale = double_from_bits(sbits)
  return scale + scale * tmp
end

local function exp2f(value: cfloat): cfloat <cexport, codename 'exp2f'>
  local result = (@cfloat)(exp2((@cdouble)(value)))
  local result_bits: FloatBits = {value = result}
  local result_field = result_bits.bits & 0x7F800000_cuint
  if result_field == 0x7F800000_cuint or result_field == 0_cuint then
    if value == value and not is_infinite32(value) then math_range_error() end
  end
  return result
end

local function integer_power_of_ten(exponent: cint): cdouble
  local remaining = exponent
  local positive_powers: [9]cdouble = {
    1e1_cdouble, 1e2_cdouble, 1e4_cdouble, 1e8_cdouble, 1e16_cdouble,
    1e32_cdouble, 1e64_cdouble, 1e128_cdouble, 1e256_cdouble,
  }
  local negative_powers: [9]cdouble = {
    1e-1_cdouble, 1e-2_cdouble, 1e-4_cdouble, 1e-8_cdouble, 1e-16_cdouble,
    1e-32_cdouble, 1e-64_cdouble, 1e-128_cdouble, 1e-256_cdouble,
  }
  local powers = &positive_powers
  if remaining < 0_cint then
    remaining = -remaining
    powers = &negative_powers
  end
  local result = 1_cdouble
  local index: cint = 0_cint
  while remaining > 0_cint and index < 9_cint do
    if (remaining & 1_cint) ~= 0_cint then result = result * powers[index] end
    remaining = remaining >> 1
    index = index + 1_cint
  end
  return result
end

local function exp10(value: cdouble): cdouble <cexport, codename 'exp10'>
  if is_nan64(value) then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return 0_cdouble end
    return value
  end
  if value > 310_cdouble then
    math_range_error()
    return nelibc_exp_overflow_hw()
  end
  if value < -324_cdouble then
    math_range_error()
    return nelibc_exp_underflow_hw()
  end
  local scale: cint = (@cint)(round_binary64(value, 3_cint))
  local fraction = value - (@cdouble)(scale)
  local residual = fraction * 0x1.26BB1C0000000P+1_cdouble +
    fraction * -0x1.12AABA8000000P-25_cdouble
  local result = integer_power_of_ten(scale) * exp_core(residual)
  if is_infinite64(result) or result == 0_cdouble then math_range_error() end
  return result
end

local function exp10f(value: cfloat): cfloat <cexport, codename 'exp10f'>
  local result = (@cfloat)(exp10((@cdouble)(value)))
  local result_bits: FloatBits = {value = result}
  local result_field = result_bits.bits & 0x7F800000_cuint
  if result_field == 0x7F800000_cuint or result_field == 0_cuint then
    if value == value and not is_infinite32(value) then math_range_error() end
  end
  return result
end

local function pow10(value: cdouble): cdouble <cexport, codename 'pow10'>
  return exp10(value)
end
local function pow10f(value: cfloat): cfloat <cexport, codename 'pow10f'>
  return exp10f(value)
end

local function __fpclassify(value: cdouble): cint <cexport, codename '__fpclassify'>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits
  local exponent = bits & 0x7ff0000000000000_culonglong
  local fraction = bits & 0x000fffffffffffff_culonglong
  if exponent == 0x7ff0000000000000_culonglong then
    if fraction == 0_culonglong then return 1_cint end -- FP_INFINITE
    return 0_cint -- FP_NAN
  end
  if (bits & 0x7fffffffffffffff_culonglong) == 0_culonglong then return 2_cint end -- FP_ZERO
  if exponent == 0_culonglong then return 3_cint end -- FP_SUBNORMAL
  return 4_cint -- FP_NORMAL
end

local function __fpclassifyf(value: cfloat): cint <cexport, codename '__fpclassifyf'>
  local representation: FloatBits = {value = value}
  local bits = representation.bits
  local exponent = bits & 0x7f800000_cuint
  local fraction = bits & 0x007fffff_cuint
  if exponent == 0x7f800000_cuint then
    if fraction == 0_cuint then return 1_cint end
    return 0_cint
  end
  if (bits & 0x7fffffff_cuint) == 0_cuint then return 2_cint end
  if exponent == 0_cuint then return 3_cint end
  return 4_cint
end

local function __fpclassifyl(value: clongdouble): cint <cexport, codename '__fpclassifyl'>
  local representation: LongDoubleBits = {value = value}
  local parts = representation.parts
  local exponent = parts.sign_exponent & 0x7fff_cushort
  local integer_bit = parts.significand & 0x8000000000000000_culonglong
  if exponent == 0x7fff_cushort then
    if parts.significand == 0x8000000000000000_culonglong then return 1_cint end
    return 0_cint
  end
  if exponent == 0_cushort then
    if parts.significand == 0_culonglong then return 2_cint end
    if integer_bit == 0_culonglong then return 3_cint end
    return 4_cint -- x87 pseudo-denormal encodings denote normal values.
  end
  if integer_bit == 0_culonglong then return 0_cint end -- unsupported x87 encoding
  return 4_cint
end

local function __signbit(value: cdouble): cint <cexport, codename '__signbit'>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits
  return (@cint)(bits >> 63)
end

local function __signbitf(value: cfloat): cint <cexport, codename '__signbitf'>
  local representation: FloatBits = {value = value}
  local bits = representation.bits
  return (@cint)(bits >> 31)
end

local function __signbitl(value: clongdouble): cint <cexport, codename '__signbitl'>
  local representation: LongDoubleBits = {value = value}
  local parts = representation.parts
  return (@cint)(parts.sign_exponent >> 15)
end

local function finite(value: cdouble): cint <cexport, codename 'finite'>
  if is_finite64(value) then return 1_cint end
  return 0_cint
end
local function finitef(value: cfloat): cint <cexport, codename 'finitef'>
  if is_finite32(value) then return 1_cint end
  return 0_cint
end

local function nan(tag: *const cchar): cdouble <cexport, codename 'nan'>
  return double_from_bits(0x7FF8000000000000_culonglong)
end
local function nanf(tag: *const cchar): cfloat <cexport, codename 'nanf'>
  return float_from_bits(0x7FC00000_cuint)
end
local function nanl(tag: *const cchar): clongdouble <cexport, codename 'nanl'>
  local quiet_nan: LongDoubleBits = {
    parts = {significand = 0xC000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
  }
  return quiet_nan.value
end

-- Compute exp(value - ln(2)) without losing the low subtraction bits near the
-- binary64 overflow boundary, where exp(value) itself no longer fits.
-- expm1 follows musl 1.2.5 src/math/expm1.c (fdlibm s_expm1.c, Sun
-- Microsystems; see the notice above).
local expm1_ln2_hi: cdouble = 6.93147180369123816490e-01_cdouble
local expm1_ln2_lo: cdouble = 1.90821492927058770002e-10_cdouble
local expm1_invln2: cdouble = 1.44269504088896338700e+00_cdouble
local expm1_q1: cdouble = -3.33333333333331316428e-02_cdouble
local expm1_q2: cdouble = 1.58730158725481460165e-03_cdouble
local expm1_q3: cdouble = -7.93650757867487942473e-05_cdouble
local expm1_q4: cdouble = 4.00821782732936239552e-06_cdouble
local expm1_q5: cdouble = -2.01099218183624371326e-07_cdouble

local function expm1(value: cdouble): cdouble <cexport, codename 'expm1'>
  local bits = bits_of_double(value)
  local hx = (@cuint)(bits >> 32) & 0x7FFFFFFF_cuint
  local negative = (bits >> 63) ~= 0_culonglong
  local x = value
  if hx >= 0x4043687A_cuint then -- |x| >= 56 ln2
    if is_nan64(x) then return x end
    if negative then return -1_cdouble end
    if x > 7.09782712893383973096e+02_cdouble then
      math_range_error()
      return x * 0x1p1023_cdouble
    end
  end
  local k: cint = 0_cint
  local c: cdouble = 0_cdouble
  if hx > 0x3FD62E42_cuint then -- |x| > 0.5 ln2
    local hi: cdouble
    local lo: cdouble
    if hx < 0x3FF0A2B2_cuint then -- |x| < 1.5 ln2
      if not negative then
        hi = x - expm1_ln2_hi
        lo = expm1_ln2_lo
        k = 1_cint
      else
        hi = x + expm1_ln2_hi
        lo = -expm1_ln2_lo
        k = -1_cint
      end
    else
      local half: cdouble = 0.5_cdouble
      if negative then half = -0.5_cdouble end
      k = (@cint)(expm1_invln2 * x + half)
      local t = (@cdouble)(k)
      hi = x - t * expm1_ln2_hi -- t*ln2_hi is exact here
      lo = t * expm1_ln2_lo
    end
    x = hi - lo
    c = (hi - x) - lo
  elseif hx < 0x3C900000_cuint then -- |x| < 2^-54
    if hx < 0x00100000_cuint then force_evalf((@cfloat)(x)) end
    return x
  end
  local hfx = 0.5_cdouble * x
  local hxs = x * hfx
  local r1 = 1_cdouble + hxs * (expm1_q1 + hxs * (expm1_q2 + hxs *
    (expm1_q3 + hxs * (expm1_q4 + hxs * expm1_q5))))
  local t = 3_cdouble - r1 * hfx
  local e = hxs * ((r1 - t) / (6_cdouble - x * t))
  if k == 0_cint then return x - (x * e - hxs) end
  e = x * (e - c) - c
  e = e - hxs
  if k == -1_cint then return 0.5_cdouble * (x - e) - 0.5_cdouble end
  if k == 1_cint then
    if x < -0.25_cdouble then return -2_cdouble * (e - (x + 0.5_cdouble)) end
    return 1_cdouble + 2_cdouble * (x - e)
  end
  local twopk = double_from_bits((@culonglong)(0x3FF_cint + k) << 52)
  if k < 0_cint or k > 56_cint then
    local y = x - e + 1_cdouble
    if k == 1024_cint then
      y = y * 2_cdouble * 0x1p1023_cdouble
    else
      y = y * twopk
    end
    return y - 1_cdouble
  end
  local two_minus_k = double_from_bits((@culonglong)(0x3FF_cint - k) << 52)
  if k < 20_cint then return (x - e + (1_cdouble - two_minus_k)) * twopk end
  return (x - (e + two_minus_k) + 1_cdouble) * twopk
end

-- musl __expo2: exp(x - k ln2) * 2^(k-1) for |x| beyond log(DBL_MAX), with k
-- odd so that the final scaling overflows with the right sign in every
-- rounding mode.
local function expo2(x: cdouble, sign: cdouble): cdouble
  local scale = double_from_bits((@culonglong)(0x3FF_cint + 1021_cint) << 52)
  return exp(x - 0x1.62066151ADD8BP+10_cdouble) * (sign * scale) * scale
end

-- sinh, cosh and tanh follow musl 1.2.5 src/math/sinh.c, cosh.c, tanh.c.
local function sinh(value: cdouble): cdouble <cexport, codename 'sinh'>
  local bits = bits_of_double(value)
  local h: cdouble = 0.5_cdouble
  if (bits >> 63) ~= 0_culonglong then h = -h end
  bits = bits & 0x7FFFFFFFFFFFFFFF_culonglong
  local absx = double_from_bits(bits)
  local w = (@cuint)(bits >> 32)
  if w < 0x40862E42_cuint then -- |x| < log(DBL_MAX)
    local t = expm1(absx)
    if w < 0x3FF00000_cuint then
      -- |x| < 2^-26: expm1 raised inexact and underflow; avoid a second one.
      if w < 0x3FF00000_cuint - (26_cuint << 20) then return value end
      return h * (2_cdouble * t - t * t / (t + 1_cdouble))
    end
    return h * (t + t / (t + 1_cdouble))
  end
  local result = expo2(absx, 2_cdouble * h)
  if is_infinite64(result) and not is_infinite64(value) then math_range_error() end
  return result
end

local function cosh(value: cdouble): cdouble <cexport, codename 'cosh'>
  local bits = bits_of_double(value) & 0x7FFFFFFFFFFFFFFF_culonglong
  local x = double_from_bits(bits)
  local w = (@cuint)(bits >> 32)
  if w < 0x3FE62E42_cuint then -- |x| < log(2)
    if w < 0x3FF00000_cuint - (26_cuint << 20) then
      force_eval(x + 0x1p120_cdouble) -- raise inexact if x != 0
      return 1_cdouble
    end
    local t = expm1(x)
    return 1_cdouble + t * t / (2_cdouble * (1_cdouble + t))
  end
  if w < 0x40862E42_cuint then -- |x| < log(DBL_MAX)
    local t = exp(x)
    return 0.5_cdouble * (t + 1_cdouble / t)
  end
  local result = expo2(x, 1_cdouble)
  if is_infinite64(result) and not is_infinite64(value) then math_range_error() end
  return result
end

local function tanh(value: cdouble): cdouble <cexport, codename 'tanh'>
  local bits = bits_of_double(value)
  local negative = (bits >> 63) ~= 0_culonglong
  bits = bits & 0x7FFFFFFFFFFFFFFF_culonglong
  local x = double_from_bits(bits)
  local w = (@cuint)(bits >> 32)
  local t: cdouble
  if w > 0x3FE193EA_cuint then -- |x| > log(3)/2 ~= 0.5493 or NaN
    if w > 0x40340000_cuint then -- |x| > 20 or NaN: avoid raising overflow
      t = 1_cdouble - 0_cdouble / x
    else
      t = expm1(2_cdouble * x)
      t = 1_cdouble - 2_cdouble / (t + 2_cdouble)
    end
  elseif w > 0x3FD058AE_cuint then -- |x| > log(5/3)/2 ~= 0.2554
    t = expm1(2_cdouble * x)
    t = t / (t + 2_cdouble)
  elseif w >= 0x00100000_cuint then -- |x| >= 0x1p-1022
    t = expm1(-2_cdouble * x)
    t = -t / (t + 2_cdouble)
  else -- subnormal: raise inexact and underflow
    force_evalf((@cfloat)(x))
    t = x
  end
  if negative then return -t end
  return t
end

local function sinhf(value: cfloat): cfloat <cexport, codename 'sinhf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  local result = (@cfloat)(sinh((@cdouble)(value)))
  if is_infinite32(result) and not is_infinite32(value) then math_range_error() end
  return result
end

local function coshf(value: cfloat): cfloat <cexport, codename 'coshf'>
  local result = (@cfloat)(cosh((@cdouble)(value)))
  if is_infinite32(result) and not is_infinite32(value) then math_range_error() end
  return result
end

local function tanhf(value: cfloat): cfloat <cexport, codename 'tanhf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  return (@cfloat)(tanh((@cdouble)(value)))
end

local function tanhl(value: clongdouble): clongdouble <cexport, codename 'tanhl'>
  if is_nan80(value) then return value + value end
  if is_infinite80(value) then
    if value < 0_clongdouble then return -1_clongdouble end
    return 1_clongdouble
  end
  if value == 0_clongdouble then return value end
  local magnitude = fabsl(value)
  -- Beyond this point tanh rounds to one in binary80. Avoid overflowing the
  -- doubled argument and preserve the sign of the saturated result.
  if magnitude > 24_clongdouble then
    if value < 0_clongdouble then return -1_clongdouble end
    return 1_clongdouble
  end
  local exponential_minus_one = expm1l(-2_clongdouble * magnitude)
  local result = -exponential_minus_one / (2_clongdouble + exponential_minus_one)
  if value < 0_clongdouble then return -result end
  return result
end

local function atan(value: cdouble): cdouble <cexport, codename 'atan'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return -atan_high[3] end
    return atan_high[3]
  end
  if value == 0_cdouble then return value end
  local negative = value < 0_cdouble
  local x = fabs(value)
  if x >= 0x1p66_cdouble then
    if negative then return -atan_high[3] end
    return atan_high[3]
  end
  if x < 0x1p-27_cdouble then
    -- atan(x) rounds to x; raise underflow only for a subnormal argument.
    if x < 0x1p-1022_cdouble then force_evalf((@cfloat)(value)) end
    return value
  end

  local id: cint = -1_cint
  local z = x
  if x < 0.4375_cdouble then
    id = -1_cint
  elseif x < 1.1875_cdouble then
    id = 0_cint
    z = (2_cdouble * x - 1_cdouble) / (2_cdouble + x)
  elseif x < 2.4375_cdouble then
    id = 1_cint
    z = (x - 1_cdouble) / (x + 1_cdouble)
  elseif x < 3_cdouble then
    id = 2_cint
    z = (x - 1.5_cdouble) / (1_cdouble + 1.5_cdouble * x)
  else
    id = 3_cint
    z = -1_cdouble / x
  end

  local square = z * z
  local fourth = square * square
  local s1 = square * (atan_coefficients[0] + fourth *
    (atan_coefficients[2] + fourth * (atan_coefficients[4] +
    fourth * (atan_coefficients[6] + fourth *
    (atan_coefficients[8] + fourth * atan_coefficients[10])))))
  local s2 = fourth * (atan_coefficients[1] + fourth *
    (atan_coefficients[3] + fourth * (atan_coefficients[5] +
    fourth * (atan_coefficients[7] + fourth * atan_coefficients[9]))))
  local result: cdouble
  if id < 0_cint then
    result = z - z * (s1 + s2)
  else
    result = atan_high[id] - ((z * (s1 + s2) - atan_low[id]) - z)
  end
  if negative then return -result end
  return result
end

-- atan2 follows musl 1.2.5 src/math/atan2.c (fdlibm e_atan2.c).
local function atan2(y: cdouble, x: cdouble): cdouble
    <cexport, codename 'atan2'>
  if is_nan64(x) or is_nan64(y) then return x + y end
  local pi = 0x1.921FB54442D18P+1_cdouble
  local pi_lo = 0x1.1A62633145C07P-53_cdouble
  local xbits = bits_of_double(x)
  local ybits = bits_of_double(y)
  if xbits == 0x3FF0000000000000_culonglong then return atan(y) end
  -- m = 2*sign(x) + sign(y)
  local m = (@cuint)(((ybits >> 63) & 1_culonglong) | ((xbits >> 62) & 2_culonglong))
  local ix = xbits & 0x7FFFFFFFFFFFFFFF_culonglong
  local iy = ybits & 0x7FFFFFFFFFFFFFFF_culonglong
  if iy == 0_culonglong then
    if m == 0_cuint or m == 1_cuint then return y end -- atan(+-0, +anything) = +-0
    if m == 2_cuint then return pi end -- atan(+0, -anything) = pi
    return -pi -- atan(-0, -anything) = -pi
  end
  if ix == 0_culonglong then
    if (m & 1_cuint) ~= 0_cuint then return -pi / 2_cdouble end
    return pi / 2_cdouble
  end
  if ix == 0x7FF0000000000000_culonglong then
    if iy == 0x7FF0000000000000_culonglong then
      if m == 0_cuint then return pi / 4_cdouble end
      if m == 1_cuint then return -pi / 4_cdouble end
      if m == 2_cuint then return 3_cdouble * pi / 4_cdouble end
      return -3_cdouble * pi / 4_cdouble
    end
    if m == 0_cuint then return 0_cdouble end
    if m == 1_cuint then return double_from_bits(0x8000000000000000_culonglong) end
    if m == 2_cuint then return pi end
    return -pi
  end
  local ixh = (@cuint)(ix >> 32)
  local iyh = (@cuint)(iy >> 32)
  -- |y/x| > 2^64
  if ixh + (64_cuint << 20) < iyh or iy == 0x7FF0000000000000_culonglong then
    if (m & 1_cuint) ~= 0_cuint then return -pi / 2_cdouble end
    return pi / 2_cdouble
  end
  -- z = atan(|y/x|) without spurious underflow
  local z: cdouble
  if (m & 2_cuint) ~= 0_cuint and iyh + (64_cuint << 20) < ixh then -- |y/x| < 2^-64, x < 0
    z = 0_cdouble
  else
    z = atan(fabs(y / x))
  end
  if m == 0_cuint then return z end -- atan(+,+)
  if m == 1_cuint then return -z end -- atan(-,+)
  if m == 2_cuint then return pi - (z - pi_lo) end -- atan(+,-)
  return (z - pi_lo) - pi -- atan(-,-)
end

local function atanf(value: cfloat): cfloat <cexport, codename 'atanf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  return (@cfloat)(atan((@cdouble)(value)))
end

local function atan2f(y: cfloat, x: cfloat): cfloat
    <cexport, codename 'atan2f'>
  local result = (@cfloat)(atan2((@cdouble)(y), (@cdouble)(x)))
  if is_subnormal32(result) then return float_subnormal_result(result) end
  return result
end

-- asin and acos follow musl 1.2.5 src/math/asin.c and acos.c (fdlibm
-- e_asin.c, e_acos.c).
local asin_pio2_hi: cdouble = 1.57079632679489655800e+00_cdouble
local asin_pio2_lo: cdouble = 6.12323399573676603587e-17_cdouble

local function asin_acos_r(z: cdouble): cdouble <inline>
  local p = z * (1.66666666666666657415e-01_cdouble + z * (-3.25565818622400915405e-01_cdouble +
    z * (2.01212532134862925881e-01_cdouble + z * (-4.00555345006794114027e-02_cdouble +
    z * (7.91534994289814532176e-04_cdouble + z * 3.47933107596021167570e-05_cdouble)))))
  local q = 1_cdouble + z * (-2.40339491173441421878e+00_cdouble + z *
    (2.02094576023350569471e+00_cdouble + z * (-6.88283971605453293030e-01_cdouble +
    z * 7.70381505559019352791e-02_cdouble)))
  return p / q
end

local function asin(value: cdouble): cdouble <cexport, codename 'asin'>
  local bits = bits_of_double(value)
  local hx = (@cuint)(bits >> 32)
  local ix = hx & 0x7FFFFFFF_cuint
  local x = value
  if ix >= 0x3FF00000_cuint then -- |x| >= 1 or NaN
    if is_nan64(x) then return x + x end
    local lx = (@cuint)(bits & 0xFFFFFFFF_culonglong)
    if ((ix - 0x3FF00000_cuint) | lx) == 0_cuint then
      return x * asin_pio2_hi + 0x1p-120_cdouble -- asin(+-1) = +-pi/2 with inexact
    end
    return math_invalid(x)
  end
  if ix < 0x3FE00000_cuint then -- |x| < 0.5
    -- 0x1p-1022 <= |x| < 0x1p-26: avoid raising underflow
    if ix < 0x3E500000_cuint and ix >= 0x00100000_cuint then return x end
    return x + x * asin_acos_r(x * x)
  end
  -- 1 > |x| >= 0.5
  local z = (1_cdouble - fabs(x)) * 0.5_cdouble
  local s = sqrt(z)
  local r = asin_acos_r(z)
  if ix >= 0x3FEF3333_cuint then -- |x| > 0.975
    x = asin_pio2_hi - (2_cdouble * (s + s * r) - asin_pio2_lo)
  else
    local f = double_from_bits(bits_of_double(s) & 0xFFFFFFFF00000000_culonglong)
    local c = (z - f * f) / (s + f) -- f + c = sqrt(z)
    x = 0.5_cdouble * asin_pio2_hi - (2_cdouble * s * r - (asin_pio2_lo - 2_cdouble * c) -
      (0.5_cdouble * asin_pio2_hi - 2_cdouble * f))
  end
  if (hx >> 31) ~= 0_cuint then return -x end
  return x
end

local function acos(value: cdouble): cdouble <cexport, codename 'acos'>
  local bits = bits_of_double(value)
  local hx = (@cuint)(bits >> 32)
  local ix = hx & 0x7FFFFFFF_cuint
  local x = value
  if ix >= 0x3FF00000_cuint then -- |x| >= 1 or NaN
    if is_nan64(x) then return x + x end
    local lx = (@cuint)(bits & 0xFFFFFFFF_culonglong)
    if ((ix - 0x3FF00000_cuint) | lx) == 0_cuint then
      if (hx >> 31) ~= 0_cuint then return 2_cdouble * asin_pio2_hi + 0x1p-120_cdouble end
      return 0_cdouble
    end
    return math_invalid(x)
  end
  if ix < 0x3FE00000_cuint then -- |x| < 0.5
    if ix <= 0x3C600000_cuint then return asin_pio2_hi + 0x1p-120_cdouble end -- |x| < 2^-57
    return asin_pio2_hi - (x - (asin_pio2_lo - x * asin_acos_r(x * x)))
  end
  if (hx >> 31) ~= 0_cuint then -- x < -0.5
    local z = (1_cdouble + x) * 0.5_cdouble
    local s = sqrt(z)
    local w = asin_acos_r(z) * s - asin_pio2_lo
    return 2_cdouble * (asin_pio2_hi - (s + w))
  end
  -- x > 0.5
  local z = (1_cdouble - x) * 0.5_cdouble
  local s = sqrt(z)
  local df = double_from_bits(bits_of_double(s) & 0xFFFFFFFF00000000_culonglong)
  local c = (z - df * df) / (s + df)
  local w = asin_acos_r(z) * s + c
  return 2_cdouble * (df + w)
end

local function asinf(value: cfloat): cfloat <cexport, codename 'asinf'>
  if is_subnormal32(value) then return float_subnormal_result(value) end
  return (@cfloat)(asin((@cdouble)(value)))
end

local function acosf(value: cfloat): cfloat <cexport, codename 'acosf'>
  return (@cfloat)(acos((@cdouble)(value)))
end

