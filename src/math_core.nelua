  -2.54704601771951915620e-09_cdouble, -7.03119616381481654654e-02_cdouble,
  -2.40903221549529611423e+00_cdouble, -2.19659774734883086467e+01_cdouble,
  -5.80791704701737572236e+01_cdouble, -3.14479470594888503854e+01_cdouble,
}
local j0_ps3: [5]cdouble = {
  3.58560338055209726349e+01_cdouble, 3.61513983050303863820e+02_cdouble,
  1.19360783792111533330e+03_cdouble, 1.12799679856907414432e+03_cdouble,
  1.73580930813335754692e+02_cdouble,
