local function nelibc_casinparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_casinparts_f'>
  if is_infinite32(y) then
    local infinity = float_from_bits(0x7F800000_cuint)
    if is_infinite32(x) then
      real_out[0] = copysignf(0.25_cfloat * acosf(-1_cfloat), x)
    elseif is_nan32(x) then
      real_out[0] = x + y
    else
      real_out[0] = copysignf(0_cfloat, x)
    end
    imaginary_out[0] = copysignf(infinity, y)
    return
  end
  if is_infinite32(x) then
    if is_nan32(y) then
      local nan_value = x + y
      real_out[0], imaginary_out[0] = nan_value, nan_value
      return
    end
    real_out[0] = copysignf(0.5_cfloat * acosf(-1_cfloat), x)
    imaginary_out[0] = copysignf(float_from_bits(0x7F800000_cuint), y)
    return
  end
  if is_nan32(x) or is_nan32(y) then
    local nan_value = x + y
    real_out[0], imaginary_out[0] = nan_value, nan_value
    return
  end
  local scale = 1_cfloat
  if fabsf(x) > scale then scale = fabsf(x) end
  if fabsf(y) > scale then scale = fabsf(y) end
  local reciprocal = 1_cfloat / scale
  local sx = x / scale
  local sy = y / scale
  local plus_distance = sqrtf((sx + reciprocal) * (sx + reciprocal) + sy * sy)
  local minus_distance = sqrtf((sx - reciprocal) * (sx - reciprocal) + sy * sy)
  local alpha_scaled = 0.5_cfloat * (plus_distance + minus_distance)
  local beta = sx / alpha_scaled
  if beta > 1_cfloat then beta = 1_cfloat elseif beta < -1_cfloat then beta = -1_cfloat end
  real_out[0] = asinf(beta)
  local imaginary_magnitude: cfloat
  local absolute_x = fabsf(x)
  local absolute_y = fabsf(y)
  if absolute_x < 1_cfloat then
    local cosine_real = sqrtf((1_cfloat - absolute_x) * (1_cfloat + absolute_x))
    if absolute_y < 0x1p-12_cfloat * cosine_real then
      imaginary_magnitude = asinhf(absolute_y / cosine_real)
    elseif scale > 0x1p16_cfloat then
      imaginary_magnitude = logf(scale) + logf(alpha_scaled) + 0.6931471805599453_cfloat
    else
      local alpha = scale * alpha_scaled
      if alpha < 1_cfloat then alpha = 1_cfloat end
      imaginary_magnitude = acoshf(alpha)
    end
  elseif absolute_x == 1_cfloat and absolute_y < 1_cfloat then
    local delta = 0.5_cfloat * absolute_y + absolute_y * absolute_y /
      (2_cfloat * (sqrtf(4_cfloat + absolute_y * absolute_y) + 2_cfloat))
    imaginary_magnitude = 2_cfloat * asinhf(sqrtf(0.5_cfloat * delta))
  elseif scale > 0x1p16_cfloat then
    imaginary_magnitude = logf(scale) + logf(alpha_scaled) + 0.6931471805599453_cfloat
  else
    local alpha = scale * alpha_scaled
    if alpha < 1_cfloat then alpha = 1_cfloat end
    imaginary_magnitude = acoshf(alpha)
  end
  imaginary_out[0] = copysignf(imaginary_magnitude, y)
end

local function nelibc_casinparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_casinparts'>
  if is_infinite64(y) then
    local infinity = double_from_bits(0x7ff0000000000000_culonglong)
    if is_infinite64(x) then
      real_out[0] = copysign(0.25_cdouble * acos(-1_cdouble), x)
    elseif is_nan64(x) then
      real_out[0] = x + y
    else
      real_out[0] = copysign(0_cdouble, x)
    end
    imaginary_out[0] = copysign(infinity, y)
    return
  end
  if is_infinite64(x) then
    if is_nan64(y) then
      local nan_value = x + y
      real_out[0], imaginary_out[0] = nan_value, nan_value
      return
    end
    real_out[0] = copysign(0.5_cdouble * acos(-1_cdouble), x)
    imaginary_out[0] = copysign(double_from_bits(0x7ff0000000000000_culonglong), y)
    return
  end
  if is_nan64(x) or is_nan64(y) then
    local nan_value = x + y
    real_out[0], imaginary_out[0] = nan_value, nan_value
    return
  end
  local scale = 1_cdouble
  if fabs(x) > scale then scale = fabs(x) end
  if fabs(y) > scale then scale = fabs(y) end
  local reciprocal = 1_cdouble / scale
  local sx = x / scale
  local sy = y / scale
  local plus_distance = sqrt((sx + reciprocal) * (sx + reciprocal) + sy * sy)
  local minus_distance = sqrt((sx - reciprocal) * (sx - reciprocal) + sy * sy)
  local alpha_scaled = 0.5_cdouble * (plus_distance + minus_distance)
  local beta = sx / alpha_scaled
  if beta > 1_cdouble then beta = 1_cdouble elseif beta < -1_cdouble then beta = -1_cdouble end
  real_out[0] = asin(beta)
  local imaginary_magnitude: cdouble
  local absolute_x = fabs(x)
  local absolute_y = fabs(y)
  if absolute_x < 1_cdouble then
    local cosine_real = sqrt((1_cdouble - absolute_x) * (1_cdouble + absolute_x))
    if absolute_y < 0x1p-26_cdouble * cosine_real then
      imaginary_magnitude = asinh(absolute_y / cosine_real)
    elseif scale > 0x1p32_cdouble then
      imaginary_magnitude = log(scale) + log(alpha_scaled) + 0.693147180559945309417232121458176568_cdouble
    else
      local alpha = scale * alpha_scaled
      if alpha < 1_cdouble then alpha = 1_cdouble end
      imaginary_magnitude = acosh(alpha)
    end
  elseif absolute_x == 1_cdouble and absolute_y < 1_cdouble then
    local delta = 0.5_cdouble * absolute_y + absolute_y * absolute_y /
      (2_cdouble * (sqrt(4_cdouble + absolute_y * absolute_y) + 2_cdouble))
    imaginary_magnitude = 2_cdouble * asinh(sqrt(0.5_cdouble * delta))
  elseif scale > 0x1p32_cdouble then
    imaginary_magnitude = log(scale) + log(alpha_scaled) + 0.693147180559945309417232121458176568_cdouble
  else
    local alpha = scale * alpha_scaled
    if alpha < 1_cdouble then alpha = 1_cdouble end
    imaginary_magnitude = acosh(alpha)
  end
  imaginary_out[0] = copysign(imaginary_magnitude, y)
end

local function nelibc_casinparts_l(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_casinparts_l'>
  if is_infinite80(y) then
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
