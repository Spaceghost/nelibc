local function nelibc_cpowparts_f(x: cfloat, y: cfloat, exponent_real: cfloat,
    exponent_imaginary: cfloat, real_out: *[0]cfloat,
    imaginary_out: *[0]cfloat): void <cexport, codename 'nelibc_cpowparts_f'>
  if exponent_real == 0_cfloat and exponent_imaginary == 0_cfloat then
    real_out[0], imaginary_out[0] = 1_cfloat, 0_cfloat
    return
  end
  if x == 1_cfloat and y == 0_cfloat and is_finite32(exponent_real) and is_finite32(exponent_imaginary) then
    real_out[0], imaginary_out[0] = 1_cfloat, 0_cfloat
    return
  end
  if x == 0_cfloat and y == 0_cfloat then
    if exponent_real > 0_cfloat then
      real_out[0], imaginary_out[0] = 0_cfloat, -0_cfloat
    elseif exponent_real < 0_cfloat then
      local infinity = float_from_bits(0x7F800000_cuint)
      real_out[0], imaginary_out[0] = infinity, infinity - infinity
    else
      local infinity = float_from_bits(0x7F800000_cuint)
      local nan_value = infinity - infinity
      real_out[0], imaginary_out[0] = nan_value, nan_value
    end
    return
  end
  local log_real: cfloat
  local log_imaginary: cfloat
  nelibc_clogf_parts(x, y, &log_real, &log_imaginary)
  local exp_real = exponent_real * log_real - exponent_imaginary * log_imaginary
  local exp_imaginary = exponent_imaginary * log_real + exponent_real * log_imaginary
  nelibc_cexpf_parts(exp_real, exp_imaginary, real_out, imaginary_out)
end

