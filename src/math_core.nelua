local function nelibc_errno_location(): *[0]cint <cimport> end

local function float_from_bits(bits: cuint): cfloat <inline>
  local representation: FloatBits = {bits = bits}
  return representation.value
end

local function double_from_bits(bits: culonglong): cdouble <inline>
  local representation: DoubleBits = {bits = bits}
  return representation.value
end

local function is_signaling_nan(value: cdouble): boolean <inline>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits
  return (bits & 0x7FF0000000000000_culonglong) == 0x7FF0000000000000_culonglong and
    (bits & 0x000FFFFFFFFFFFFF_culonglong) ~= 0_culonglong and
    (bits & 0x0008000000000000_culonglong) == 0_culonglong
end

local function is_signaling_nanf(value: cfloat): boolean <inline>
  local representation: FloatBits = {value = value}
  local bits = representation.bits
  return (bits & 0x7F800000_cuint) == 0x7F800000_cuint and
    (bits & 0x007FFFFF_cuint) ~= 0_cuint and
    (bits & 0x00400000_cuint) == 0_cuint
end

local function is_nan64(value: cdouble): boolean <inline>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits
  return (bits & 0x7FF0000000000000_culonglong) == 0x7FF0000000000000_culonglong and
    (bits & 0x000FFFFFFFFFFFFF_culonglong) ~= 0_culonglong
end

local function is_infinite64(value: cdouble): boolean <inline>
  local representation: DoubleBits = {value = value}
  return (representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong) ==
    0x7FF0000000000000_culonglong
end

local function is_nan32(value: cfloat): boolean <inline>
  local representation: FloatBits = {value = value}
  return (representation.bits & 0x7F800000_cuint) == 0x7F800000_cuint and
    (representation.bits & 0x007FFFFF_cuint) ~= 0_cuint
end

local function is_infinite32(value: cfloat): boolean <inline>
  local representation: FloatBits = {value = value}
  return (representation.bits & 0x7FFFFFFF_cuint) == 0x7F800000_cuint
end

local function is_negative_zero64(value: cdouble): boolean <inline>
  local representation: DoubleBits = {value = value}
  return representation.bits == 0x8000000000000000_culonglong
end

local function is_negative_zerof(value: cfloat): boolean <inline>
  local representation: FloatBits = {value = value}
  return representation.bits == 0x80000000_cuint
end

local function is_integer64(value: cdouble): boolean <inline>
  if is_nan64(value) or is_infinite64(value) then return false end
  if value == 0_cdouble then return true end
  local representation: DoubleBits = {value = value}
  local bits = representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong
  local field = (@cint)((bits >> 52) & 0x7FF_culonglong)
  local exponent = field - 1023_cint
  if exponent < 0_cint then return false end
  if exponent >= 52_cint then return true end
  local fractional_bits = 52_cint - exponent
  local mask = (1_culonglong << fractional_bits) - 1_culonglong
  return (bits & mask) == 0_culonglong
end

local function is_odd_integer64(value: cdouble): boolean <inline>
  if not is_integer64(value) or value <= -0x1p53_cdouble or value >= 0x1p53_cdouble then return false end
  local magnitude: cdouble
  if value < 0_cdouble then magnitude = -value else magnitude = value end
  local integral = (@culonglong)(magnitude)
  return (integral & 1_culonglong) ~= 0_culonglong
end

local function math_domain_error(): void <inline>
  nelibc_errno_location()[0] = 33 -- EDOM on the supported Linux target.
end

local function math_range_error(): void <inline>
  nelibc_errno_location()[0] = 34 -- ERANGE on the supported Linux target.
end

local function check_remainder_domain(x: cdouble, y: cdouble): void <inline>
  if not is_nan64(x) and not is_nan64(y) and (is_infinite64(x) or y == 0_cdouble) then
    math_domain_error()
  end
end

local function nelibc_sqrt_hw(value: cdouble): cdouble <cimport> end
local function nelibc_sqrtf_hw(value: cfloat): cfloat <cimport> end
local function nelibc_rint_hw(value: cdouble): cdouble <cimport> end
local function nelibc_rintf_hw(value: cfloat): cfloat <cimport> end
local function nelibc_lrint_hw(value: cdouble): clonglong <cimport> end
local function nelibc_lrintf_hw(value: cfloat): clonglong <cimport> end
local function nelibc_lround_hw(value: cdouble): clonglong <cimport> end
local function nelibc_lroundf_hw(value: cfloat): clonglong <cimport> end
local function nelibc_nearbyint_hw(value: cdouble): cdouble <cimport> end
local function nelibc_nearbyintf_hw(value: cfloat): cfloat <cimport> end
local function nelibc_exp_overflow_hw(): cdouble <cimport> end
local function nelibc_exp_underflow_hw(): cdouble <cimport> end
local function nelibc_log_domain_error_hw(): cdouble <cimport> end
local function nelibc_log_pole_hw(): cdouble <cimport> end
local function nelibc_ldexp_hw(value: cdouble, exponent: cint): cdouble <cimport> end
local function nelibc_ldexpf_hw(value: cfloat, exponent: cint): cfloat <cimport> end
local function nelibc_fmod_hw(x: cdouble, y: cdouble): cdouble <cimport> end
local function nelibc_remainder_hw(x: cdouble, y: cdouble): cdouble <cimport> end

local function sqrt(value: cdouble): cdouble <cexport, codename 'sqrt'>
  if value < 0_cdouble then math_domain_error() end
  return nelibc_sqrt_hw(value)
end

local function sqrtf(value: cfloat): cfloat <cexport, codename 'sqrtf'>
  return nelibc_sqrtf_hw(value)
end

local function rint(value: cdouble): cdouble <cexport, codename 'rint'>
  return nelibc_rint_hw(value)
end

local function rintf(value: cfloat): cfloat <cexport, codename 'rintf'>
  return nelibc_rintf_hw(value)
end

local function nearbyint(value: cdouble): cdouble
    <cexport, codename 'nearbyint'>
  return nelibc_nearbyint_hw(value)
end

local function nearbyintf(value: cfloat): cfloat
    <cexport, codename 'nearbyintf'>
  return nelibc_nearbyintf_hw(value)
end

local function ilogb(value: cdouble): cint <cexport, codename 'ilogb'>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong
  local field = (@cint)((bits >> 52) & 0x7FF_culonglong)
  if field == 0x7FF_cint then
    if (bits & 0x000FFFFFFFFFFFFF_culonglong) ~= 0_culonglong then return (-2147483647_cint - 1_cint) end
    return 2147483647_cint
  end
  if bits == 0_culonglong then return (-2147483647_cint - 1_cint) end
  if field ~= 0_cint then return field - 1023_cint end
  local fraction = bits & 0x000FFFFFFFFFFFFF_culonglong
  local shifts: cint = 0_cint
  while (fraction & 0x0010000000000000_culonglong) == 0_culonglong do
    fraction = fraction << 1
    shifts = shifts + 1_cint
  end
  return -1022_cint - shifts
end

local function ilogbf(value: cfloat): cint <cexport, codename 'ilogbf'>
  local representation: FloatBits = {value = value}
  local bits = representation.bits & 0x7FFFFFFF_cuint
  local field = (@cint)((bits >> 23) & 0xFF_cuint)
  if field == 0xFF_cint then
    if (bits & 0x007FFFFF_cuint) ~= 0_cuint then return (-2147483647_cint - 1_cint) end
    return 2147483647_cint
  end
  if bits == 0_cuint then return (-2147483647_cint - 1_cint) end
  if field ~= 0_cint then return field - 127_cint end
  local fraction = bits & 0x007FFFFF_cuint
  local shifts: cint = 0_cint
  while (fraction & 0x00800000_cuint) == 0_cuint do
    fraction = fraction << 1
    shifts = shifts + 1_cint
  end
  return -126_cint - shifts
end

local function logb(value: cdouble): cdouble <cexport, codename 'logb'>
  if value ~= value then return value + value end
  if is_infinite64(value) then return double_from_bits(0x7FF0000000000000_culonglong) end
  if value == 0_cdouble then return double_from_bits(0xFFF0000000000000_culonglong) end
  return (@cdouble)(ilogb(value))
end

local function logbf(value: cfloat): cfloat <cexport, codename 'logbf'>
  if is_nan32(value) then return value + value end
  if is_infinite32(value) then return float_from_bits(0x7F800000_cuint) end
  if value == 0_cfloat then return float_from_bits(0xFF800000_cuint) end
  return (@cfloat)(ilogbf(value))
end

local function ldexp(value: cdouble, exponent: cint): cdouble <cexport, codename 'ldexp'>
  local result = nelibc_ldexp_hw(value, exponent)
  local input_bits: DoubleBits = {value = value}
  local result_bits: DoubleBits = {value = result}
  local input_field = input_bits.bits & 0x7FF0000000000000_culonglong
  local result_field = result_bits.bits & 0x7FF0000000000000_culonglong
  if input_field ~= 0x7FF0000000000000_culonglong and
      (result_field == 0x7FF0000000000000_culonglong or
       ((result_bits.bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong and
        value ~= 0_cdouble)) then
    math_range_error()
  end
  return result
end

local function ldexpf(value: cfloat, exponent: cint): cfloat <cexport, codename 'ldexpf'>
  local result = nelibc_ldexpf_hw(value, exponent)
  local input_bits: FloatBits = {value = value}
  local result_bits: FloatBits = {value = result}
  local input_field = input_bits.bits & 0x7F800000_cuint
  local result_field = result_bits.bits & 0x7F800000_cuint
  if input_field ~= 0x7F800000_cuint and
      (result_field == 0x7F800000_cuint or
       ((result_bits.bits & 0x7FFFFFFF_cuint) == 0_cuint and
        value ~= 0_cfloat)) then
    math_range_error()
  end
  return result
end

local function scalbn(value: cdouble, exponent: cint): cdouble <cexport, codename 'scalbn'>
  return ldexp(value, exponent)
end

local function scalbnf(value: cfloat, exponent: cint): cfloat <cexport, codename 'scalbnf'>
  return ldexpf(value, exponent)
end

local function scalbln(value: cdouble, exponent: clong): cdouble <cexport, codename 'scalbln'>
  local bounded: cint
  if exponent > 2147483647_clong then
    bounded = 2147483647_cint
  elseif exponent < (-2147483647_clong - 1_clong) then
    bounded = (-2147483647_cint - 1_cint)
  else
    bounded = (@cint)(exponent)
  end
  return ldexp(value, bounded)
end

local function scalblnf(value: cfloat, exponent: clong): cfloat <cexport, codename 'scalblnf'>
  local bounded: cint
  if exponent > 2147483647_clong then
    bounded = 2147483647_cint
  elseif exponent < (-2147483647_clong - 1_clong) then
    bounded = (-2147483647_cint - 1_cint)
  else
    bounded = (@cint)(exponent)
  end
  return ldexpf(value, bounded)
end

local function fma_normalize(value: cdouble): FmaNumber <inline>
  local representation: DoubleBits = {value = value}
  local exponent = (@cint)(representation.bits >> 52)
  local sign = exponent & 0x800_cint
  exponent = exponent & 0x7FF_cint
  if exponent == 0_cint then
    local scaled_representation: DoubleBits = {value = value * 0x1p63_cdouble}
    representation.bits = scaled_representation.bits
    exponent = (@cint)((representation.bits >> 52) & 0x7FF_culonglong)
    if exponent ~= 0_cint then
      exponent = exponent - 63_cint
    else
      exponent = 0x800_cint
    end
  end
  local mantissa = (representation.bits & 0x000FFFFFFFFFFFFF_culonglong) |
    0x0010000000000000_culonglong
  return {mantissa = mantissa << 1,
          exponent = exponent - 0x3FF_cint - 52_cint - 1_cint,
          sign = sign}
end

local function fma_multiply(x: culonglong, y: culonglong): FmaProduct <inline>
  local x_low = x & 0xFFFFFFFF_culonglong
  local x_high = x >> 32
  local y_low = y & 0xFFFFFFFF_culonglong
  local y_high = y >> 32
  local term1 = x_low * y_low
  local term2 = x_low * y_high + x_high * y_low
  local term3 = x_high * y_high
  local low = term1 + (term2 << 32)
  local high = term3 + (term2 >> 32)
  if low < term1 then high = high + 1_culonglong end
  return {high = high, low = low}
end

local function fma_clz64(value: culonglong): cint <inline>
  local count: cint = 0_cint
  local bit = 0x8000000000000000_culonglong
  while (value & bit) == 0_culonglong and count < 64_cint do
    count = count + 1_cint
    bit = bit >> 1
  end
  return count
end

local function fma_boolean_bit(value: boolean): culonglong <inline>
  if value then return 1_culonglong end
  return 0_culonglong
end

local function fma(x: cdouble, y: cdouble, z: cdouble): cdouble
    <cexport, codename 'fma'>
  local nx = fma_normalize(x)
  local ny = fma_normalize(y)
  local nz = fma_normalize(z)
  local zero_inf_nan_exponent = 0x7FF_cint - 0x3FF_cint - 52_cint - 1_cint
  if nx.exponent >= zero_inf_nan_exponent or ny.exponent >= zero_inf_nan_exponent then
    return x * y + z
  end
  if nz.exponent >= zero_inf_nan_exponent then
    if nz.exponent > zero_inf_nan_exponent then return x * y + z end
    return z
  end

  local product = fma_multiply(nx.mantissa, ny.mantissa)
  local exponent = nx.exponent + ny.exponent
  local distance = nz.exponent - exponent
  local z_high: culonglong
  local z_low: culonglong
  if distance > 0_cint then
    if distance < 64_cint then
      z_low = nz.mantissa << distance
      z_high = nz.mantissa >> (64_cint - distance)
    else
      z_low = 0_culonglong
      z_high = nz.mantissa
      exponent = nz.exponent - 64_cint
      distance = distance - 64_cint
      if distance > 0_cint then
        if distance < 64_cint then
          product.low = (product.high << (64_cint - distance)) |
            (product.low >> distance) |
            fma_boolean_bit((product.low << (64_cint - distance)) ~= 0_culonglong)
          product.high = product.high >> distance
        else
          product.low = 1_culonglong
          product.high = 0_culonglong
        end
      end
    end
  else
    z_high = 0_culonglong
    distance = -distance
    if distance == 0_cint then
      z_low = nz.mantissa
    elseif distance < 64_cint then
      z_low = (nz.mantissa >> distance) |
        fma_boolean_bit((nz.mantissa << (64_cint - distance)) ~= 0_culonglong)
    else
      z_low = 1_culonglong
    end
  end

  local sign = nx.sign ~ ny.sign
  local same_sign = (sign ~ nz.sign) == 0_cint
  local nonzero = true
  if same_sign then
    local previous_low = product.low
    product.low = product.low + z_low
    product.high = product.high + z_high + fma_boolean_bit(product.low < previous_low)
  else
    local previous_low = product.low
    product.low = product.low - z_low
    product.high = product.high - z_high - fma_boolean_bit(previous_low < z_low)
    if (product.high >> 63) ~= 0_culonglong then
      product.low = 0_culonglong - product.low
      product.high = 0_culonglong - product.high - fma_boolean_bit(product.low ~= 0_culonglong)
      sign = sign ~ 0x800_cint
    end
    nonzero = product.high ~= 0_culonglong
  end

  local result_high: culonglong
  local shift: cint
  if nonzero then
    exponent = exponent + 64_cint
    shift = fma_clz64(product.high) - 1_cint
    result_high = (product.high << shift) | (product.low >> (64_cint - shift)) |
      fma_boolean_bit((product.low << shift) ~= 0_culonglong)
  elseif product.low ~= 0_culonglong then
    shift = fma_clz64(product.low) - 1_cint
    if shift < 0_cint then
      result_high = (product.low >> 1) | (product.low & 1_culonglong)
    else
      result_high = product.low << shift
    end
  else
    return x * y + z
  end
  exponent = exponent - shift

  local signed_integer = (@clonglong)(result_high)
  if sign ~= 0_cint then signed_integer = -signed_integer end
  local result = (@cdouble)(signed_integer)
  if exponent < -1022_cint - 62_cint then
    if exponent == -1022_cint - 63_cint then
      local cutoff = 0x1p63_cdouble
      if sign ~= 0_cint then cutoff = -cutoff end
      if result == cutoff then
        local float_min = 0x0.ffffff8p-63_cdouble * 0x1p-126_cdouble * result
        return 0x1p-896_cdouble * float_min
      end
      if (result_high << 53) ~= 0_culonglong then
        signed_integer = (@clonglong)((result_high >> 1) |
          (result_high & 1_culonglong) | 0x4000000000000000_culonglong)
        if sign ~= 0_cint then signed_integer = -signed_integer end
        result = (@cdouble)(signed_integer)
        result = 2_cdouble * result - cutoff
        local tiny = 0x1p-896_cdouble * result
        result = result + (tiny * tiny) * (result - result)
      end
    else
      shift = 10_cint
      signed_integer = (@clonglong)((result_high >> shift) |
        fma_boolean_bit((result_high << (64_cint - shift)) ~= 0_culonglong)) << shift
      if sign ~= 0_cint then signed_integer = -signed_integer end
      result = (@cdouble)(signed_integer)
    end
  end
  return scalbn(result, exponent)
end

local function fmaf(x: cfloat, y: cfloat, z: cfloat): cfloat
    <cexport, codename 'fmaf'>
  local product = (@cdouble)(x) * (@cdouble)(y)
  local result = product + (@cdouble)(z)
  local representation: DoubleBits = {value = result}
  local exponent = (@cint)((representation.bits >> 52) & 0x7FF_culonglong)
  if (representation.bits & 0x1FFFFFFF_culonglong) ~= 0x10000000_culonglong or
      exponent == 0x7FF_cint or (result - product == (@cdouble)(z) and
      result - (@cdouble)(z) == product) then
    return (@cfloat)(result)
  end
  local negative = (representation.bits >> 63) ~= 0_culonglong
  local error: cdouble
  if negative == ((@cdouble)(z) > product) then
    error = product - result + (@cdouble)(z)
  else
    error = (@cdouble)(z) - result + product
  end
  if negative == (error < 0_cdouble) then
    representation.bits = representation.bits + 1_culonglong
  else
    representation.bits = representation.bits - 1_culonglong
  end
  return (@cfloat)(representation.value)
end

local function nextafter(x: cdouble, y: cdouble): cdouble <cexport, codename 'nextafter'>
  if is_nan64(x) then return x + y end
  if is_nan64(y) then return x + y end
  if x == y then return y end
  local xbits: DoubleBits = {value = x}
  local ybits: DoubleBits = {value = y}
  if (xbits.bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then
    xbits.bits = (ybits.bits & 0x8000000000000000_culonglong) | 1_culonglong
  elseif (x < y) == (x > 0_cdouble) then
    xbits.bits = xbits.bits + 1_culonglong
  else
    xbits.bits = xbits.bits - 1_culonglong
  end
  local result_field = xbits.bits & 0x7FF0000000000000_culonglong
  if result_field == 0x7FF0000000000000_culonglong and not is_infinite64(x) then
    math_range_error()
  elseif result_field == 0_culonglong and x ~= 0_cdouble then
    math_range_error()
  end
  return xbits.value
end

local function nextafterf(x: cfloat, y: cfloat): cfloat <cexport, codename 'nextafterf'>
  if is_nan32(x) then return x + y end
  if is_nan32(y) then return x + y end
  if x == y then return y end
  local xbits: FloatBits = {value = x}
  local ybits: FloatBits = {value = y}
  if (xbits.bits & 0x7FFFFFFF_cuint) == 0_cuint then
    xbits.bits = (ybits.bits & 0x80000000_cuint) | 1_cuint
  elseif (x < y) == (x > 0_cfloat) then
    xbits.bits = xbits.bits + 1_cuint
  else
    xbits.bits = xbits.bits - 1_cuint
  end
  local result_field = xbits.bits & 0x7F800000_cuint
  if result_field == 0x7F800000_cuint and not is_infinite32(x) then
    math_range_error()
  elseif result_field == 0_cuint and x ~= 0_cfloat then
    math_range_error()
  end
  return xbits.value
end

local function nexttoward(x: cdouble, y: clongdouble): cdouble <cexport, codename 'nexttoward'>
  -- Compare in the direction type before narrowing: y may lie between x and
  -- its adjacent double, where converting y to double would lose direction.
  if x ~= x or y ~= y then return nextafter(x, (@cdouble)(y)) end
  if (@clongdouble)(x) == y then return (@cdouble)(y) end
  if (@clongdouble)(x) < y then
    return nextafter(x, double_from_bits(0x7FF0000000000000_culonglong))
  end
  return nextafter(x, double_from_bits(0xFFF0000000000000_culonglong))
end

local function nexttowardf(x: cfloat, y: clongdouble): cfloat <cexport, codename 'nexttowardf'>
  if x ~= x or y ~= y then return nextafterf(x, (@cfloat)(y)) end
  if (@clongdouble)(x) == y then return (@cfloat)(y) end
  if (@clongdouble)(x) < y then
    return nextafterf(x, float_from_bits(0x7F800000_cuint))
  end
  return nextafterf(x, float_from_bits(0xFF800000_cuint))
end

local function fmod(x: cdouble, y: cdouble): cdouble <cexport, codename 'fmod'>
  check_remainder_domain(x, y)
  return nelibc_fmod_hw(x, y)
end

local function fmodf(x: cfloat, y: cfloat): cfloat <cexport, codename 'fmodf'>
  check_remainder_domain((@cdouble)(x), (@cdouble)(y))
  return (@cfloat)(nelibc_fmod_hw((@cdouble)(x), (@cdouble)(y)))
end

local function remainder(x: cdouble, y: cdouble): cdouble
    <cexport, codename 'remainder'>
  check_remainder_domain(x, y)
  return nelibc_remainder_hw(x, y)
end

local function remainderf(x: cfloat, y: cfloat): cfloat
    <cexport, codename 'remainderf'>
  check_remainder_domain((@cdouble)(x), (@cdouble)(y))
  return (@cfloat)(nelibc_remainder_hw((@cdouble)(x), (@cdouble)(y)))
end

local function fmin(x: cdouble, y: cdouble): cdouble <cexport, codename 'fmin'>
  if is_signaling_nan(x) then return x + x end
  if is_signaling_nan(y) then return y + y end
  if x ~= x then return y end
  if y ~= y then return x end
  if x < y then return x end
  if y < x then return y end
  if x == 0_cdouble then
    if is_negative_zero64(x) or is_negative_zero64(y) then
      return double_from_bits(0x8000000000000000_culonglong)
    end
    return 0_cdouble
  end
  return y -- Either operand has the same value here.
end

local function fmax(x: cdouble, y: cdouble): cdouble <cexport, codename 'fmax'>
  if is_signaling_nan(x) then return x + x end
  if is_signaling_nan(y) then return y + y end
  if x ~= x then return y end
  if y ~= y then return x end
  if x < y then return y end
  if y < x then return x end
  if x == 0_cdouble then
    if not is_negative_zero64(x) or not is_negative_zero64(y) then return 0_cdouble end
    return double_from_bits(0x8000000000000000_culonglong)
  end
  return y
end

local function fminf(x: cfloat, y: cfloat): cfloat <cexport, codename 'fminf'>
  if is_signaling_nanf(x) then return x + x end
  if is_signaling_nanf(y) then return y + y end
  if x ~= x then return y end
  if y ~= y then return x end
  if x < y then return x end
  if y < x then return y end
  if x == 0_cfloat then
    if is_negative_zerof(x) or is_negative_zerof(y) then
      return float_from_bits(0x80000000_cuint)
    end
    return 0_cfloat
  end
  return y
end

local function fmaxf(x: cfloat, y: cfloat): cfloat <cexport, codename 'fmaxf'>
  if is_signaling_nanf(x) then return x + x end
  if is_signaling_nanf(y) then return y + y end
  if x ~= x then return y end
  if y ~= y then return x end
  if x < y then return y end
  if y < x then return x end
  if x == 0_cfloat then
    if not is_negative_zerof(x) or not is_negative_zerof(y) then return 0_cfloat end
    return float_from_bits(0x80000000_cuint)
  end
  return y
end

local function fdim(x: cdouble, y: cdouble): cdouble <cexport, codename 'fdim'>
  if x ~= x or y ~= y then return x + y end
  if x <= y then return 0_cdouble end
  local result = x - y
  if is_infinite64(result) and not is_infinite64(x) and not is_infinite64(y) then
    math_range_error()
  end
  return result
end

local function fdimf(x: cfloat, y: cfloat): cfloat <cexport, codename 'fdimf'>
  if x ~= x or y ~= y then return x + y end
  if x <= y then return 0_cfloat end
  local result = x - y
  if is_infinite32(result) and not is_infinite32(x) and not is_infinite32(y) then
    math_range_error()
  end
  return result
end

local function frexp(value: cdouble, exponent: *[0]cint): cdouble
    <cexport, codename 'frexp'>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits
  local field = (@cint)((bits >> 52) & 0x7FF_culonglong)
  local fraction = bits & 0x000FFFFFFFFFFFFF_culonglong
  if field == 0x7FF_cint or (field == 0_cint and fraction == 0_culonglong) then
    exponent[0] = 0_cint
    return value
  end
  if field == 0_cint then
    local shifts: cint = 0_cint
    while (fraction & 0x0010000000000000_culonglong) == 0_culonglong do
      fraction = fraction << 1
      shifts = shifts + 1_cint
    end
    exponent[0] = -1021_cint - shifts
    representation.bits = (bits & 0x8000000000000000_culonglong) |
      0x3FE0000000000000_culonglong |
      (fraction & 0x000FFFFFFFFFFFFF_culonglong)
    return representation.value
  end
  exponent[0] = field - 1022_cint
  representation.bits = (bits & 0x800FFFFFFFFFFFFF_culonglong) |
    0x3FE0000000000000_culonglong
  return representation.value
end

local function frexpf(value: cfloat, exponent: *[0]cint): cfloat
    <cexport, codename 'frexpf'>
  local representation: FloatBits = {value = value}
  local bits = representation.bits
  local field = (@cint)((bits >> 23) & 0xFF_cuint)
  local fraction = bits & 0x007FFFFF_cuint
  if field == 0xFF_cint or (field == 0_cint and fraction == 0_cuint) then
    exponent[0] = 0_cint
    return value
  end
  if field == 0_cint then
    local shifts: cint = 0_cint
    while (fraction & 0x00800000_cuint) == 0_cuint do
      fraction = fraction << 1
      shifts = shifts + 1_cint
    end
    exponent[0] = -125_cint - shifts
    representation.bits = (bits & 0x80000000_cuint) |
      0x3F000000_cuint | (fraction & 0x007FFFFF_cuint)
    return representation.value
  end
  exponent[0] = field - 126_cint
  representation.bits = (bits & 0x807FFFFF_cuint) | 0x3F000000_cuint
  return representation.value
end

local function fabsf(value: cfloat): cfloat <cexport, codename 'fabsf'>
  local representation: FloatBits = {value = value}
  representation.bits = representation.bits & 0x7FFFFFFF_cuint
  return representation.value
end

local function fabs(value: cdouble): cdouble <cexport, codename 'fabs'>
  local representation: DoubleBits = {value = value}
  representation.bits = representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong
  return representation.value
end

local function copysignf(magnitude: cfloat, sign: cfloat): cfloat
    <cexport, codename 'copysignf'>
  local magnitude_bits: FloatBits = {value = magnitude}
  local sign_bits: FloatBits = {value = sign}
  magnitude_bits.bits = (magnitude_bits.bits & 0x7FFFFFFF_cuint) |
    (sign_bits.bits & 0x80000000_cuint)
  return magnitude_bits.value
end

local function copysign(magnitude: cdouble, sign: cdouble): cdouble
    <cexport, codename 'copysign'>
  local magnitude_bits: DoubleBits = {value = magnitude}
  local sign_bits: DoubleBits = {value = sign}
  magnitude_bits.bits = (magnitude_bits.bits & 0x7FFFFFFFFFFFFFFF_culonglong) |
    (sign_bits.bits & 0x8000000000000000_culonglong)
  return magnitude_bits.value
end

local function round_binary64(value: cdouble, mode: cint): cdouble <inline>
  local representation: DoubleBits = {value = value}
  local bits = representation.bits
  local sign = bits & 0x8000000000000000_culonglong
  local exponent = (@cint)((bits >> 52) & 0x7FF_culonglong)
  if exponent == 0x7FF_cint then return value end -- NaN or infinity
  if (bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0 then return value end

  local unbiased = exponent - 1023_cint
  if unbiased < 0_cint then
    if mode == 0_cint then return double_from_bits(sign) end -- trunc
    if mode == 1_cint then -- floor
      if sign ~= 0_culonglong then return -1_cdouble end
      return double_from_bits(0_culonglong)
    end
    if mode == 2_cint then -- ceil
      if sign == 0_culonglong then return 1_cdouble end
      return double_from_bits(sign)
    end
    if unbiased == -1_cint and
        (bits & 0x7FFFFFFFFFFFFFFF_culonglong) >= 0x3FE0000000000000_culonglong then
      if sign ~= 0_culonglong then return -1_cdouble end
      return 1_cdouble
    end
    return double_from_bits(sign)
  end
  if unbiased >= 52_cint then return value end

  local fractional_bits: cint = 52_cint - unbiased
  local mask: culonglong = (1_culonglong << fractional_bits) - 1_culonglong
  local fraction = bits & mask
  if fraction == 0_culonglong then return value end
  local truncated = double_from_bits(bits & (~mask))
  if mode == 1_cint then
    if sign ~= 0_culonglong then return truncated - 1_cdouble end
    return truncated
  end
  if mode == 2_cint then
    if sign == 0_culonglong then return truncated + 1_cdouble end
    return truncated
  end
  if mode == 3_cint then
    local half: culonglong = 1_culonglong << (fractional_bits - 1_cint)
    if fraction >= half then
      if sign ~= 0_culonglong then return truncated - 1_cdouble end
      return truncated + 1_cdouble
    end
    return truncated
  end
  return truncated
end

local function round_binary32(value: cfloat, mode: cint): cfloat <inline>
  local representation: FloatBits = {value = value}
  local bits = representation.bits
  local sign = bits & 0x80000000_cuint
  local exponent = (@cint)((bits >> 23) & 0xFF_cuint)
  if exponent == 0xFF_cint then return value end
  if (bits & 0x7FFFFFFF_cuint) == 0 then return value end

  local unbiased = exponent - 127_cint
  if unbiased < 0_cint then
    if mode == 0_cint then return float_from_bits(sign) end
    if mode == 1_cint then
      if sign ~= 0_cuint then return -1_cfloat end
      return float_from_bits(0_cuint)
    end
    if mode == 2_cint then
      if sign == 0_cuint then return 1_cfloat end
      return float_from_bits(sign)
    end
    if unbiased == -1_cint and
        (bits & 0x7FFFFFFF_cuint) >= 0x3F000000_cuint then
      if sign ~= 0_cuint then return -1_cfloat end
      return 1_cfloat
    end
    return float_from_bits(sign)
  end
  if unbiased >= 23_cint then return value end

  local fractional_bits: cint = 23_cint - unbiased
  local mask: cuint = (1_cuint << fractional_bits) - 1_cuint
  local fraction = bits & mask
  if fraction == 0_cuint then return value end
  local truncated = float_from_bits(bits & (~mask))
  if mode == 1_cint then
    if sign ~= 0_cuint then return truncated - 1_cfloat end
    return truncated
  end
  if mode == 2_cint then
    if sign == 0_cuint then return truncated + 1_cfloat end
    return truncated
  end
  if mode == 3_cint then
    local half: cuint = 1_cuint << (fractional_bits - 1_cint)
    if fraction >= half then
      if sign ~= 0_cuint then return truncated - 1_cfloat end
      return truncated + 1_cfloat
    end
    return truncated
  end
  return truncated
end

-- Range-reduced Taylor kernel. The residual is close to [-ln(2)/2, ln(2)/2];
-- the split ln(2) constants keep the reduction accurate for the full binary64
-- exponent range. Scaling uses the same x86-64 primitive as ldexp.
local function exp_core(value: cdouble): cdouble
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return 0_cdouble end
    return value
  end
  if value > 710_cdouble then
    math_range_error()
    return nelibc_exp_overflow_hw()
  end
  if value < -746_cdouble then
    math_range_error()
    return nelibc_exp_underflow_hw()
  end

  local scale_value = value * 0x1.71547652B82FEP+0_cdouble
  local scale: cint = (@cint)(round_binary64(scale_value, 3_cint))
  local residual = (value - (@cdouble)(scale) * 0x1.62E42FEE00000P-1_cdouble) -
    (@cdouble)(scale) * 0x1.A39EF35793C76P-33_cdouble
  local polynomial: cdouble = 4.110317623312165E-19_cdouble -- 1/20!
  polynomial = 8.22063524662433E-18_cdouble + residual * polynomial -- 1/19!
  polynomial = 1.5619206968586225E-16_cdouble + residual * polynomial -- 1/18!
  polynomial = 2.8114572543455206E-15_cdouble + residual * polynomial -- 1/17!
  polynomial = 4.7794773323873853E-14_cdouble + residual * polynomial -- 1/16!
  polynomial = 7.6471637318198164E-13_cdouble + residual * polynomial -- 1/15!
  polynomial = 1.1470745597729725E-11_cdouble + residual * polynomial -- 1/14!
  polynomial = 1.6059043836821613E-10_cdouble + residual * polynomial -- 1/13!
  polynomial = 2.08767569878681E-9_cdouble + residual * polynomial -- 1/12!
  polynomial = 2.505210838544172E-8_cdouble + residual * polynomial -- 1/11!
  polynomial = 2.7557319223985893E-7_cdouble + residual * polynomial -- 1/10!
  polynomial = 2.755731922398589E-6_cdouble + residual * polynomial -- 1/9!
  polynomial = 2.48015873015873E-5_cdouble + residual * polynomial -- 1/8!
  polynomial = 1.984126984126984E-4_cdouble + residual * polynomial -- 1/7!
  polynomial = 1.388888888888889E-3_cdouble + residual * polynomial -- 1/6!
  polynomial = 8.333333333333333E-3_cdouble + residual * polynomial -- 1/5!
  polynomial = 4.166666666666667E-2_cdouble + residual * polynomial -- 1/4!
  polynomial = 1.6666666666666667E-1_cdouble + residual * polynomial -- 1/3!
  polynomial = 0.5_cdouble + residual * polynomial -- 1/2!
  local result = ldexp(1_cdouble + residual + residual * residual * polynomial, scale)
  local result_bits: DoubleBits = {value = result}
  local result_field = result_bits.bits & 0x7FF0000000000000_culonglong
  if result_field == 0x7FF0000000000000_culonglong or result_field == 0_culonglong then
    math_range_error()
  end
  return result
end

local function exp(value: cdouble): cdouble <cexport, codename 'exp'>
  return exp_core(value)
end

local function expf(value: cfloat): cfloat <cexport, codename 'expf'>
  local result = (@cfloat)(exp_core((@cdouble)(value)))
  local result_bits: FloatBits = {value = result}
  local result_field = result_bits.bits & 0x7F800000_cuint
  if result_field == 0x7F800000_cuint or result_field == 0_cuint then
    if value == value and not is_infinite32(value) then math_range_error() end
  end
  return result
end

local function erf_erfc_middle(x: cdouble): cdouble <inline>
  local offset = x - 1_cdouble
  local p = erf_pa[0] + offset * (erf_pa[1] + offset * (erf_pa[2] + offset *
    (erf_pa[3] + offset * (erf_pa[4] + offset * (erf_pa[5] + offset * erf_pa[6])))))
  local q = 1_cdouble + offset * (erf_qa[0] + offset * (erf_qa[1] + offset *
    (erf_qa[2] + offset * (erf_qa[3] + offset * (erf_qa[4] + offset * erf_qa[5])))))
  return 1_cdouble - 0.845062911510467529297_cdouble - p / q
end

local function erfc_positive(x: cdouble): cdouble
  if x < 0.84375_cdouble then
    if x < 0x1p-56_cdouble then return 1_cdouble - x end
    local z = x * x
    local p = erf_pp[0] + z * (erf_pp[1] + z * (erf_pp[2] + z * (erf_pp[3] + z * erf_pp[4])))
    local q = 1_cdouble + z * (erf_qq[0] + z * (erf_qq[1] + z * (erf_qq[2] + z * (erf_qq[3] + z * erf_qq[4]))))
    local xy = x * (p / q)
    if x < 0.25_cdouble then return 1_cdouble - (x + xy) end
    return 0.5_cdouble - (x - 0.5_cdouble + xy)
  end
  if x < 1.25_cdouble then return erf_erfc_middle(x) end
  local inverse_square = 1_cdouble / (x * x)
  local r: cdouble
  local denominator: cdouble
  if x < 2.857142857142857_cdouble then
    r = erf_ra[0] + inverse_square * (erf_ra[1] + inverse_square * (erf_ra[2] + inverse_square * (erf_ra[3] + inverse_square * (erf_ra[4] + inverse_square * (erf_ra[5] + inverse_square * (erf_ra[6] + inverse_square * erf_ra[7]))))))
    denominator = 1_cdouble + inverse_square * (erf_sa[0] + inverse_square * (erf_sa[1] + inverse_square * (erf_sa[2] + inverse_square * (erf_sa[3] + inverse_square * (erf_sa[4] + inverse_square * (erf_sa[5] + inverse_square * (erf_sa[6] + inverse_square * erf_sa[7])))))))
  else
    r = erf_rb[0] + inverse_square * (erf_rb[1] + inverse_square * (erf_rb[2] + inverse_square * (erf_rb[3] + inverse_square * (erf_rb[4] + inverse_square * (erf_rb[5] + inverse_square * erf_rb[6])))))
    denominator = 1_cdouble + inverse_square * (erf_sb[0] + inverse_square * (erf_sb[1] + inverse_square * (erf_sb[2] + inverse_square * (erf_sb[3] + inverse_square * (erf_sb[4] + inverse_square * (erf_sb[5] + inverse_square * erf_sb[6]))))))
  end
  local high_bits: DoubleBits = {value = x}
  high_bits.bits = high_bits.bits & 0xFFFFFFFF00000000_culonglong
  local high = high_bits.value
  return exp(-high * high - 0.5625_cdouble) * exp((high - x) * (high + x) + r / denominator) / x
end

local function erf(value: cdouble): cdouble <cexport, codename 'erf'>
  if is_nan64(value) then return value + value end
  if is_infinite64(value) then return copysign(1_cdouble, value) end
  local magnitude = fabs(value)
  local result: cdouble
  if magnitude < 0.84375_cdouble then
    if magnitude < 0x1p-28_cdouble then return value * 1.12837916709551257390_cdouble end
    local z = value * value
    local p = erf_pp[0] + z * (erf_pp[1] + z * (erf_pp[2] + z * (erf_pp[3] + z * erf_pp[4])))
    local q = 1_cdouble + z * (erf_qq[0] + z * (erf_qq[1] + z * (erf_qq[2] + z * (erf_qq[3] + z * erf_qq[4]))))
    return value + value * (p / q)
  end
  if magnitude >= 6_cdouble then result = 1_cdouble - 0x1p-1022_cdouble
  else result = 1_cdouble - erfc_positive(magnitude) end
  return copysign(result, value)
end

local function erfc(value: cdouble): cdouble <cexport, codename 'erfc'>
  if is_nan64(value) then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return 2_cdouble end
    return 0_cdouble
  end
  local magnitude = fabs(value)
  if magnitude >= 28_cdouble then
    if value < 0_cdouble then return 2_cdouble - 0x1p-1022_cdouble end
    return 0x1p-1022_cdouble * 0x1p-1022_cdouble
  end
  local tail = erfc_positive(magnitude)
  if value < 0_cdouble then return 2_cdouble - tail end
  return tail
end

local function erff(value: cfloat): cfloat <cexport, codename 'erff'>
  return (@cfloat)(erf((@cdouble)(value)))
end

local function erfcf(value: cfloat): cfloat <cexport, codename 'erfcf'>
  return (@cfloat)(erfc((@cdouble)(value)))
end

-- Evaluate 2^x by separating its integral binary scale from a small
-- fractional remainder. This avoids multiplying the full input by ln(2),
-- which loses many bits for ordinary fractions.

local function exp2(value: cdouble): cdouble <cexport, codename 'exp2'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return 0_cdouble end
    return value
  end
  if value > 1024_cdouble then
    math_range_error()
    return nelibc_exp_overflow_hw()
  end
  if value < -1075_cdouble then
    math_range_error()
    return nelibc_exp_underflow_hw()
  end
  local scale: cint = (@cint)(round_binary64(value, 3_cint))
  local residual = value - (@cdouble)(scale)
  local z = residual * 0x1.62E42FEE00000P-1_cdouble +
    residual * 0x1.A39EF35793C76P-33_cdouble
  local term: cdouble = 1_cdouble
  local sum: cdouble = 1_cdouble
  local n: cint = 1_cint
  while n <= 20_cint do
    term = term * z / (@cdouble)(n)
    sum = sum + term
    n = n + 1_cint
  end
  return ldexp(sum, scale)
end

local function exp2f(value: cfloat): cfloat <cexport, codename 'exp2f'>
  local result = (@cfloat)(exp2((@cdouble)(value)))
  local result_bits: FloatBits = {value = result}
  local result_field = result_bits.bits & 0x7F800000_cuint
  if result_field == 0x7F800000_cuint or result_field == 0_cuint then
    if value == value and not is_infinite32(value) then math_range_error() end
  end
  return result
end

local function integer_power_of_ten(exponent: cint): cdouble
  local remaining = exponent
  local positive_powers: [9]cdouble = {
    1e1_cdouble, 1e2_cdouble, 1e4_cdouble, 1e8_cdouble, 1e16_cdouble,
    1e32_cdouble, 1e64_cdouble, 1e128_cdouble, 1e256_cdouble,
  }
  local negative_powers: [9]cdouble = {
    1e-1_cdouble, 1e-2_cdouble, 1e-4_cdouble, 1e-8_cdouble, 1e-16_cdouble,
    1e-32_cdouble, 1e-64_cdouble, 1e-128_cdouble, 1e-256_cdouble,
  }
  local powers = &positive_powers
  if remaining < 0_cint then
    remaining = -remaining
    powers = &negative_powers
  end
  local result = 1_cdouble
  local index: cint = 0_cint
  while remaining > 0_cint and index < 9_cint do
    if (remaining & 1_cint) ~= 0_cint then result = result * powers[index] end
    remaining = remaining >> 1
    index = index + 1_cint
  end
  return result
end

local function exp10(value: cdouble): cdouble <cexport, codename 'exp10'>
  if value ~= value or is_infinite64(value) then
    if value < 0_cdouble then return 0_cdouble end
    return value
  end
  if value > 310_cdouble then
    math_range_error()
    return nelibc_exp_overflow_hw()
  end
  if value < -324_cdouble then
    math_range_error()
    return nelibc_exp_underflow_hw()
  end
  local scale: cint = (@cint)(round_binary64(value, 3_cint))
  local fraction = value - (@cdouble)(scale)
  local residual = fraction * 0x1.26BB1C0000000P+1_cdouble +
    fraction * -0x1.12AABA8000000P-25_cdouble
  local result = integer_power_of_ten(scale) * exp_core(residual)
  if is_infinite64(result) or result == 0_cdouble then math_range_error() end
  return result
end

local function exp10f(value: cfloat): cfloat <cexport, codename 'exp10f'>
  local result = (@cfloat)(exp10((@cdouble)(value)))
  local result_bits: FloatBits = {value = result}
  local result_field = result_bits.bits & 0x7F800000_cuint
  if result_field == 0x7F800000_cuint or result_field == 0_cuint then
    if value == value and not is_infinite32(value) then math_range_error() end
  end
  return result
end

-- Compute exp(value - ln(2)) without losing the low subtraction bits near the
-- binary64 overflow boundary, where exp(value) itself no longer fits.
local function exp_minus_ln2(value: cdouble): cdouble
  local negative_ln2_hi = -0x1.62E42FEE00000P-1_cdouble
  local high = value + negative_ln2_hi
  local b_virtual = high - value
  local a_virtual = high - b_virtual
  local b_roundoff = negative_ln2_hi - b_virtual
  local a_roundoff = value - a_virtual
  local correction = (a_roundoff + b_roundoff) - 0x1.A39EF35793C76P-33_cdouble
  return exp_core(high) * (1_cdouble + correction)
end

local function sinh(value: cdouble): cdouble <cexport, codename 'sinh'>
  if value ~= value or is_infinite64(value) then return value + value end
  if fabs(value) < 0x1p-27_cdouble then return value end
  if fabs(value) < 0.5_cdouble then
    local square = value * value
    return value + value * square * (1_cdouble / 6_cdouble + square *
      (1_cdouble / 120_cdouble + square * (1_cdouble / 5040_cdouble +
      square * (1_cdouble / 362880_cdouble + square *
      (1_cdouble / 39916800_cdouble + square / 6227020800_cdouble)))))
  end
  local magnitude = fabs(value)
  if magnitude > 20_cdouble then
    local result: cdouble
    if magnitude <= 709_cdouble then
      result = 0.5_cdouble * exp_core(magnitude)
    else
      result = exp_minus_ln2(magnitude)
    end
    if value < 0_cdouble then return -result end
    return result
  end
  local exponential = exp_core(magnitude)
  local result = 0.5_cdouble * (exponential - 1_cdouble / exponential)
  if value < 0_cdouble then return -result end
  return result
end

local function cosh(value: cdouble): cdouble <cexport, codename 'cosh'>
  if value ~= value then return value + value end
  if is_infinite64(value) then return double_from_bits(0x7FF0000000000000_culonglong) end
  local magnitude = fabs(value)
  if magnitude < 0x1p-27_cdouble then return 1_cdouble end
  if magnitude > 20_cdouble then
    if magnitude <= 709_cdouble then return 0.5_cdouble * exp_core(magnitude) end
    return exp_minus_ln2(magnitude)
  end
  local exponential = exp_core(magnitude)
  return 0.5_cdouble * (exponential + 1_cdouble / exponential)
end

local function tanh(value: cdouble): cdouble <cexport, codename 'tanh'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return -1_cdouble end
    return 1_cdouble
  end
  local magnitude = fabs(value)
  if magnitude < 0x1p-27_cdouble then return value end
  if magnitude < 0.125_cdouble then
    local square = value * value
    return value + value * square * (-1_cdouble / 3_cdouble + square *
      (2_cdouble / 15_cdouble + square * (-17_cdouble / 315_cdouble +
      square * (62_cdouble / 2835_cdouble + square *
      (-1382_cdouble / 155925_cdouble + square *
      (21844_cdouble / 6081075_cdouble + square *
      (-929569_cdouble / 638512875_cdouble + square *
      (6404582_cdouble / 10854718875_cdouble))))))))
  end
  if magnitude > 20_cdouble then
    if value < 0_cdouble then return -1_cdouble end
    return 1_cdouble
  end
  local exponential = exp_core(2_cdouble * magnitude)
  local result = (exponential - 1_cdouble) / (exponential + 1_cdouble)
  if value < 0_cdouble then return -result end
  return result
end

local function sinhf(value: cfloat): cfloat <cexport, codename 'sinhf'>
  local result = (@cfloat)(sinh((@cdouble)(value)))
  if is_infinite32(result) and not is_infinite32(value) then math_range_error() end
  return result
end

local function coshf(value: cfloat): cfloat <cexport, codename 'coshf'>
  local result = (@cfloat)(cosh((@cdouble)(value)))
  if is_infinite32(result) and not is_infinite32(value) then math_range_error() end
  return result
end

local function tanhf(value: cfloat): cfloat <cexport, codename 'tanhf'>
  return (@cfloat)(tanh((@cdouble)(value)))
end

local function atan(value: cdouble): cdouble <cexport, codename 'atan'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return -atan_high[3] end
    return atan_high[3]
  end
  if value == 0_cdouble then return value end
  local negative = value < 0_cdouble
  local x = fabs(value)
  if x >= 0x1p66_cdouble then
    if negative then return -atan_high[3] end
    return atan_high[3]
  end

  local id: cint = -1_cint
  local z = x
  if x < 0.4375_cdouble then
    id = -1_cint
  elseif x < 1.1875_cdouble then
    id = 0_cint
    z = (2_cdouble * x - 1_cdouble) / (2_cdouble + x)
  elseif x < 2.4375_cdouble then
    id = 1_cint
    z = (x - 1_cdouble) / (x + 1_cdouble)
  elseif x < 3_cdouble then
    id = 2_cint
    z = (x - 1.5_cdouble) / (1_cdouble + 1.5_cdouble * x)
  else
    id = 3_cint
    z = -1_cdouble / x
  end

  local square = z * z
  local fourth = square * square
  local s1 = square * (atan_coefficients[0] + fourth *
    (atan_coefficients[2] + fourth * (atan_coefficients[4] +
    fourth * (atan_coefficients[6] + fourth *
    (atan_coefficients[8] + fourth * atan_coefficients[10])))))
  local s2 = fourth * (atan_coefficients[1] + fourth *
    (atan_coefficients[3] + fourth * (atan_coefficients[5] +
    fourth * (atan_coefficients[7] + fourth * atan_coefficients[9]))))
  local result: cdouble
  if id < 0_cint then
    result = z - z * (s1 + s2)
  else
    result = atan_high[id] - ((z * (s1 + s2) - atan_low[id]) - z)
  end
  if negative then return -result end
  return result
end

local function atan2(y: cdouble, x: cdouble): cdouble
    <cexport, codename 'atan2'>
  if is_nan64(x) or is_nan64(y) then return x + y end
  local pi = 0x1.921FB54442D18P+1_cdouble
  local half_pi = 0x1.921FB54442D18P+0_cdouble
  local quarter_pi = 0x1.921FB54442D18P-1_cdouble
  local ay = fabs(y)
  local ax = fabs(x)
  local y_negative = y < 0_cdouble or is_negative_zero64(y)
  local x_negative = x < 0_cdouble or is_negative_zero64(x)

  if ay == 0_cdouble then
    if x_negative then
      if y_negative then return -pi end
      return pi
    end
    return y
  end
  if ax == 0_cdouble then
    if y_negative then return -half_pi end
    return half_pi
  end
  if is_infinite64(ay) then
    if is_infinite64(ax) then
      if x_negative then
        if y_negative then return -3_cdouble * quarter_pi end
        return 3_cdouble * quarter_pi
      end
      if y_negative then return -quarter_pi end
      return quarter_pi
    end
    if y_negative then return -half_pi end
    return half_pi
  end
  if is_infinite64(ax) then
    if x_negative then
      if y_negative then return -pi end
      return pi
    end
    if y_negative then return -0_cdouble end
    return 0_cdouble
  end

  local angle: cdouble
  if ax > ay then
    angle = atan(ay / ax)
    if x_negative then
      if y_negative then return angle - pi end
      return pi - angle
    end
  else
    angle = half_pi - atan(ax / ay)
    if x_negative then
      if y_negative then return angle - pi end
      return pi - angle
    end
  end
  if y_negative then return -angle end
  return angle
end

local function atanf(value: cfloat): cfloat <cexport, codename 'atanf'>
  return (@cfloat)(atan((@cdouble)(value)))
end

local function atan2f(y: cfloat, x: cfloat): cfloat
    <cexport, codename 'atan2f'>
  return (@cfloat)(atan2((@cdouble)(y), (@cdouble)(x)))
end

local function asin(value: cdouble): cdouble <cexport, codename 'asin'>
  if is_nan64(value) then return value + value end
  if value < -1_cdouble or value > 1_cdouble then
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end
  -- This product keeps useful relative precision near both endpoints.
  local complement = sqrt((1_cdouble - value) * (1_cdouble + value))
  return atan2(value, complement)
end

local function acos(value: cdouble): cdouble <cexport, codename 'acos'>
  if is_nan64(value) then return value + value end
  if value < -1_cdouble or value > 1_cdouble then
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end
  local complement = sqrt((1_cdouble - value) * (1_cdouble + value))
  return atan2(complement, value)
end

local function asinf(value: cfloat): cfloat <cexport, codename 'asinf'>
  return (@cfloat)(asin((@cdouble)(value)))
end

local function acosf(value: cfloat): cfloat <cexport, codename 'acosf'>
  return (@cfloat)(acos((@cdouble)(value)))
end

local function log(value: cdouble): cdouble <cexport, codename 'log'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then
      math_domain_error()
      return nelibc_log_domain_error_hw()
    end
    return value
  end
  if value == 0_cdouble then
    math_range_error()
    return nelibc_log_pole_hw()
  end
  if value < 0_cdouble then
    math_domain_error()
    return nelibc_log_domain_error_hw()
  end
  local exponent: cint = 0_cint
  local mantissa: cdouble
  if value >= 0.5_cdouble and value <= 1.5_cdouble then
    -- Avoid subtracting two rounded ln(2) values around one. Sterbenz's
    -- lemma makes value-1 exact in this interval.
    mantissa = value
  else
    mantissa = frexp(value, &exponent) * 2_cdouble
    exponent = exponent - 1_cint
  end
  local z = (mantissa - 1_cdouble) / (mantissa + 1_cdouble)
  local z_squared = z * z
  local polynomial: cdouble = 1_cdouble / 41_cdouble
  local denominator: cint = 39_cint
  while denominator >= 3_cint do
    polynomial = 1_cdouble / (@cdouble)(denominator) + z_squared * polynomial
    denominator = denominator - 2_cint
  end
  local log_mantissa = 2_cdouble * z * (1_cdouble + z_squared * polynomial)
  local exponent_double = (@cdouble)(exponent)
  return (log_mantissa + exponent_double * 0x1.62E42FEE00000P-1_cdouble) +
    exponent_double * 0x1.A39EF35793C76P-33_cdouble
end

local function logf(value: cfloat): cfloat <cexport, codename 'logf'>
  return (@cfloat)(log((@cdouble)(value)))
end

local function log2(value: cdouble): cdouble <cexport, codename 'log2'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then
      math_domain_error()
      return nelibc_log_domain_error_hw()
    end
    return value
  end
  if value == 0_cdouble then
    math_range_error()
    return nelibc_log_pole_hw()
  end
  if value < 0_cdouble then
    math_domain_error()
    return nelibc_log_domain_error_hw()
  end
  local exponent: cint = 0_cint
  local normalized_mantissa = frexp(value, &exponent) * 2_cdouble
  exponent = exponent - 1_cint
  if normalized_mantissa == 1_cdouble then return (@cdouble)(exponent) end
  if value < 0.5_cdouble or value > 1.5_cdouble then
    return log(value) * 0x1.71547652B82FEP+0_cdouble
  end

  local mantissa: cdouble
  if value >= 0.5_cdouble and value <= 1.5_cdouble then
    mantissa = value
    exponent = 0_cint
  else
    mantissa = normalized_mantissa
  end
  if mantissa == 1_cdouble then return (@cdouble)(exponent) end

  local z = (mantissa - 1_cdouble) / (mantissa + 1_cdouble)
  local z_squared = z * z
  local polynomial: cdouble = 1_cdouble / 41_cdouble
  local denominator: cint = 39_cint
  while denominator >= 3_cint do
    polynomial = 1_cdouble / (@cdouble)(denominator) + z_squared * polynomial
    denominator = denominator - 2_cint
  end
  local log_mantissa = 2_cdouble * z * (1_cdouble + z_squared * polynomial)
  return (@cdouble)(exponent) + log_mantissa * 0x1.71547652B82FEP+0_cdouble
end

local function log2f(value: cfloat): cfloat <cexport, codename 'log2f'>
  return (@cfloat)(log2((@cdouble)(value)))
end

local function log10(value: cdouble): cdouble <cexport, codename 'log10'>
  return log(value) * 0x1.BCB7B1526E50EP-2_cdouble
end

local function log10f(value: cfloat): cfloat <cexport, codename 'log10f'>
  return (@cfloat)(log10((@cdouble)(value)))
end

local function cbrt(value: cdouble): cdouble <cexport, codename 'cbrt'>
  if value ~= value then return value + value end
  if is_infinite64(value) or value == 0_cdouble then return value end

  local exponent: cint = 0_cint
  local mantissa = frexp(fabs(value), &exponent)
  -- Write exponent = 3*q + r with r in [0, 2], keeping the reduced input
  -- inside [0.5, 4). This makes the Newton iteration safe for all exponents.
  local quotient: cint = exponent // 3_cint
  local residual: cint = exponent - quotient * 3_cint
  local reduced = ldexp(mantissa, residual)
  local root = exp_core(log(reduced) / 3_cdouble)
  local iteration: cint = 0_cint
  while iteration < 3_cint do
    root = (2_cdouble * root + reduced / (root * root)) / 3_cdouble
    iteration = iteration + 1_cint
  end
  root = ldexp(root, quotient)
  if value < 0_cdouble then return -root end
  return root
end

local function cbrtf(value: cfloat): cfloat <cexport, codename 'cbrtf'>
  return (@cfloat)(cbrt((@cdouble)(value)))
end

local function log1p_core(value: cdouble): cdouble
  if fabs(value) >= 0.125_cdouble then
    local adjusted = 1_cdouble + value
    local correction = (value - (adjusted - 1_cdouble)) / adjusted
    return log(adjusted) + correction
  end
  local transformed = value / (2_cdouble + value)
  local square = transformed * transformed
  local polynomial: cdouble = 1_cdouble / 41_cdouble
  local denominator: cint = 39_cint
  while denominator >= 3_cint do
    polynomial = 1_cdouble / (@cdouble)(denominator) + square * polynomial
    denominator = denominator - 2_cint
  end
  return 2_cdouble * transformed * (1_cdouble + square * polynomial)
end

local function log1p(value: cdouble): cdouble <cexport, codename 'log1p'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then
      math_domain_error()
      return nelibc_log_domain_error_hw()
    end
    return value
  end
  if value == -1_cdouble then
    math_range_error()
    return nelibc_log_pole_hw()
  end
  if value < -1_cdouble then
    math_domain_error()
    return nelibc_log_domain_error_hw()
  end
  return log1p_core(value)
end

local function log1pf(value: cfloat): cfloat <cexport, codename 'log1pf'>
  return (@cfloat)(log1p((@cdouble)(value)))
end

local function expm1(value: cdouble): cdouble <cexport, codename 'expm1'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    if value < 0_cdouble then return -1_cdouble end
    return value
  end
  if fabs(value) >= 1_cdouble then return exp_core(value) - 1_cdouble end

  local term = value
  local sum = value
  local n: cint = 2_cint
  while n <= 22_cint do
    term = term * value / (@cdouble)(n)
    sum = sum + term
    n = n + 1_cint
  end
  return sum
end

local function expm1f(value: cfloat): cfloat <cexport, codename 'expm1f'>
  return (@cfloat)(expm1((@cdouble)(value)))
end


local function asinh(value: cdouble): cdouble <cexport, codename 'asinh'>
  if value ~= value or is_infinite64(value) or value == 0_cdouble then return value end
  local magnitude = fabs(value)
  if magnitude < 0x1p-27_cdouble then return value end
  local result: cdouble
  if magnitude >= 0x1p512_cdouble then
    result = log(magnitude) + 0.693147180559945309417232121458176568_cdouble
    if value < 0_cdouble then result = -result end
  else
    local square = magnitude * magnitude
    result = log1p_core(magnitude + square / (1_cdouble + sqrt(square + 1_cdouble)))
    if value < 0_cdouble then result = -result end
  end
  return result
end


local function acosh(value: cdouble): cdouble <cexport, codename 'acosh'>
  if value ~= value then return value + value end
  if value < 1_cdouble then
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end
  if value == 1_cdouble then return 0_cdouble end
  if is_infinite64(value) then return value end
  if value >= 0x1p512_cdouble then
    return log(value) + 0.693147180559945309417232121458176568_cdouble
  end
  if value < 2_cdouble then
    local delta = value - 1_cdouble
    return log1p_core(delta + sqrt(delta * (delta + 2_cdouble)))
  end
  -- acosh(1+2t²) = 2 asinh(t) avoids overflowing intermediate squares.
  return 2_cdouble * asinh(sqrt((value - 1_cdouble) * 0.5_cdouble))
end

local function atanh(value: cdouble): cdouble <cexport, codename 'atanh'>
  if value ~= value then return value + value end
  if value == 0_cdouble then return value end
  local magnitude = fabs(value)
  if magnitude == 1_cdouble then
    math_range_error()
    if value < 0_cdouble then return double_from_bits(0xFFF0000000000000_culonglong) end
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  if magnitude > 1_cdouble then
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end
  if magnitude < 0.125_cdouble then
    local square = value * value
    return value + value * square * (1_cdouble / 3_cdouble + square *
      (1_cdouble / 5_cdouble + square * (1_cdouble / 7_cdouble + square *
      (1_cdouble / 9_cdouble + square * (1_cdouble / 11_cdouble + square *
      (1_cdouble / 13_cdouble + square * (1_cdouble / 15_cdouble + square *
      (1_cdouble / 17_cdouble + square / 19_cdouble))))))))
  end
  return 0.5_cdouble * log((1_cdouble + value) / (1_cdouble - value))
end

local function asinhf(value: cfloat): cfloat <cexport, codename 'asinhf'>
  return (@cfloat)(asinh((@cdouble)(value)))
end

local function acoshf(value: cfloat): cfloat <cexport, codename 'acoshf'>
  return (@cfloat)(acosh((@cdouble)(value)))
end

local function atanhf(value: cfloat): cfloat <cexport, codename 'atanhf'>
  return (@cfloat)(atanh((@cdouble)(value)))
end


-- Keep the log/exponent product in x86 extended precision. Doing the whole
-- composition in binary64 magnifies log's last-bit error for large exponents.
local function pow_wide(base: cdouble, exponent: cdouble): cdouble
  local fraction_exponent: cint = 0_cint
  local fraction = frexp(base, &fraction_exponent)
  local mantissa = (@clongdouble)(fraction) * 2.0_clongdouble
  fraction_exponent = fraction_exponent - 1_cint
  if mantissa > 1.414213562373095048801688724209698079_clongdouble then
    mantissa = mantissa * 0.5_clongdouble
    fraction_exponent = fraction_exponent + 1_cint
  end
  local z = (mantissa - 1.0_clongdouble) / (mantissa + 1.0_clongdouble)
  local z_squared = z * z
  local polynomial = 1.0_clongdouble / 81.0_clongdouble
  local denominator: cint = 79_cint
  while denominator >= 3_cint do
    polynomial = 1.0_clongdouble / (@clongdouble)(denominator) + z_squared * polynomial
    denominator = denominator - 2_cint
  end
  local log_mantissa = 2.0_clongdouble * z * (1.0_clongdouble + z_squared * polynomial)
  local log_base = log_mantissa + (@clongdouble)(fraction_exponent) *
    0.693147180559945309417232121458176568_clongdouble
  local wide_argument = (@clongdouble)(exponent) * log_base
  if wide_argument > 710.0_clongdouble then
    math_range_error()
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  if wide_argument < -750.0_clongdouble then
    math_range_error()
    return 0_cdouble
  end
  local scaled_argument = wide_argument * 1.442695040888963407359924681001892137_clongdouble
  local scale: cint
  if scaled_argument >= 0.0_clongdouble then
    scale = (@cint)(scaled_argument + 0.5_clongdouble)
  else
    scale = (@cint)(scaled_argument - 0.5_clongdouble)
  end
  local residual = wide_argument - (@clongdouble)(scale) *
    0.693147180559945309417232121458176568_clongdouble
  local sum = 1.0_clongdouble
  local term = 1.0_clongdouble
  for i = 1, 32 do
    term = term * residual / (@clongdouble)(i)
    sum = sum + term
  end
  if scale > 0_cint then
    for i = 1, scale do sum = sum * 2.0_clongdouble end
  elseif scale < 0_cint then
    for i = scale, -1_cint do sum = sum * 0.5_clongdouble end
  end
  local result = (@cdouble)(sum)
  if is_infinite64(result) or result == 0_cdouble then math_range_error() end
  return result
end

local function pow(value: cdouble, exponent: cdouble): cdouble
    <cexport, codename 'pow'>
  if exponent == 0_cdouble or value == 1_cdouble then return 1_cdouble end
  if is_nan64(value) or is_nan64(exponent) then return value + exponent end
  local absolute = fabs(value)
  local odd = is_odd_integer64(exponent)
  if is_infinite64(exponent) then
    if absolute == 1_cdouble then return 1_cdouble end
    if (absolute > 1_cdouble) == (exponent > 0_cdouble) then
      return double_from_bits(0x7FF0000000000000_culonglong)
    end
    return 0_cdouble
  end
  if is_infinite64(value) then
    if value < 0_cdouble and not is_integer64(exponent) then
      math_domain_error()
      return double_from_bits(0x7FF8000000000000_culonglong)
    end
    if exponent > 0_cdouble then
      if value < 0_cdouble and odd then
        return double_from_bits(0xFFF0000000000000_culonglong)
      end
      return double_from_bits(0x7FF0000000000000_culonglong)
    end
    if value < 0_cdouble and odd then
      return double_from_bits(0x8000000000000000_culonglong)
    end
    return 0_cdouble
  end
  if value == 0_cdouble then
    if exponent > 0_cdouble then
      if is_negative_zero64(value) and odd then
        return double_from_bits(0x8000000000000000_culonglong)
      end
      return 0_cdouble
    end
    math_range_error()
    if is_negative_zero64(value) and odd then
      return double_from_bits(0xFFF0000000000000_culonglong)
    end
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  if value < 0_cdouble and not is_integer64(exponent) then
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end

  local result: cdouble
  if is_integer64(exponent) and fabs(exponent) <= 64_cdouble then
    local integer_exponent = (@cint)(fabs(exponent))
    local power: cuint = (@cuint)(integer_exponent)
    local base = absolute
    result = 1_cdouble
    while power ~= 0_cuint do
      if (power & 1_cuint) ~= 0_cuint then result = result * base end
      power = power >> 1
      if power ~= 0_cuint then base = base * base end
    end
    if exponent < 0_cdouble then result = 1_cdouble / result end
    if value < 0_cdouble and odd then result = -result end
  else
    result = pow_wide(absolute, exponent)
    if value < 0_cdouble and odd then result = -result end
  end
  if is_infinite64(result) and not is_infinite64(value) and not is_infinite64(exponent) then
    math_range_error()
  elseif result == 0_cdouble and value ~= 0_cdouble then
    math_range_error()
  end
  return result
end

local function powf(value: cfloat, exponent: cfloat): cfloat
    <cexport, codename 'powf'>
  local result = (@cfloat)(pow((@cdouble)(value), (@cdouble)(exponent)))
  if is_infinite32(result) and not is_infinite32(value) and not is_infinite32(exponent) then
    math_range_error()
  elseif result == 0_cfloat and value ~= 0_cfloat then
    math_range_error()
  end
  return result
end

-- Scale by the larger operand before squaring. Exponent-gap shortcuts avoid
-- raising underflow for a contribution too small to affect the rounded result.
local function hypot(x: cdouble, y: cdouble): cdouble <cexport, codename 'hypot'>
  local ax = fabs(x)
  local ay = fabs(y)
  if is_infinite64(ax) or is_infinite64(ay) then
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  if is_nan64(ax) or is_nan64(ay) then return ax + ay end
  if ax < ay then
    local temporary = ax
    ax = ay
    ay = temporary
  end
  if ax == 0_cdouble then return 0_cdouble end
  if ay == 0_cdouble then return ax end
  if ilogb(ax) - ilogb(ay) >= 27_cint then return ax end
  local ratio = ay / ax
  local result = ax * sqrt(1_cdouble + ratio * ratio)
  if is_infinite64(result) then math_range_error() end
  return result
end

local function hypotf(x: cfloat, y: cfloat): cfloat <cexport, codename 'hypotf'>
  local ax = fabsf(x)
  local ay = fabsf(y)
  if is_infinite32(ax) or is_infinite32(ay) then
    return float_from_bits(0x7F800000_cuint)
  end
  if is_nan32(ax) or is_nan32(ay) then return ax + ay end
  if ax < ay then
    local temporary = ax
    ax = ay
    ay = temporary
  end
  if ax == 0_cfloat then return 0_cfloat end
  if ay == 0_cfloat then return ax end
  if ilogbf(ax) - ilogbf(ay) >= 13_cint then return ax end
  local ratio = ay / ax
  local result = ax * sqrtf(1_cfloat + ratio * ratio)
  if is_infinite32(result) then math_range_error() end
  return result
end

local function pio2_product_bit(product: *[0]cuint, bit_index: cint): cint <inline>
  if bit_index < 0 or bit_index >= 1272_cint then return 0_cint end
  local limb: cint = bit_index / 24_cint
  local offset: cint = bit_index % 24_cint
  return (@cint)((product[limb] >> offset) & 1_cuint)
end

-- Payne-Hanek reduction: multiply the 53-bit significand by 1200 fixed bits
-- of 2/pi, then extract the nearest integer and two pieces of its fraction.
-- The table leaves over 170 guard bits at the largest binary64 exponent.
local function reduce_pio2(value: cdouble, quadrant: *[0]cint,
    head: *[0]cdouble, tail: *[0]cdouble): void
  local absolute = fabs(value)
  local exponent: cint = 0_cint
  local mantissa: cdouble = frexp(absolute, &exponent)
  local significand: culonglong = (@culonglong)(mantissa * 0x1p53_cdouble)
  local m: [3]cuint = {
    (@cuint)(significand & 0xFFFFFF_culonglong),
    (@cuint)((significand >> 24) & 0xFFFFFF_culonglong),
    (@cuint)(significand >> 48),
  }
  local product: [53]cuint = {}
  for i = 0, 2 do
    local carry: culonglong = 0_culonglong
    for j = 0, 49 do
      local destination = i + j
      local table_value = two_over_pi[49 - j]
      local accum = (@culonglong)(product[destination]) +
        (@culonglong)(m[i]) * (@culonglong)(table_value) + carry
      product[destination] = (@cuint)(accum & 0xFFFFFF_culonglong)
      carry = accum >> 24
    end
    product[i + 50] = (@cuint)(carry)
  end

  local shift: cint = 1253_cint - exponent
  local q = pio2_product_bit(&product[0], shift) +
    2_cint * pio2_product_bit(&product[0], shift + 1_cint)
  local fractional_head: culonglong = 0_culonglong
  local fractional_tail: culonglong = 0_culonglong
  for i = 0, 52 do
    fractional_head = (fractional_head << 1) |
      (@culonglong)(pio2_product_bit(&product[0], shift - 1_cint - i))
    fractional_tail = (fractional_tail << 1) |
      (@culonglong)(pio2_product_bit(&product[0], shift - 54_cint - i))
  end
  local fraction_hi = (@cdouble)(fractional_head) * 0x1p-53_cdouble
  local fraction_lo = (@cdouble)(fractional_tail) * 0x1p-106_cdouble
  if pio2_product_bit(&product[0], shift - 1_cint) ~= 0_cint then
    q = (q + 1_cint) & 3_cint
    fraction_hi = fraction_hi - 1_cdouble
  end
  if value < 0_cdouble then
    q = (4_cint - q) & 3_cint
    fraction_hi = -fraction_hi
    fraction_lo = -fraction_lo
  end
  quadrant[0] = q

  -- TwoProduct recovers the rounding error of fraction*pio2_hi; the low part
  -- then carries both that error and the omitted bits of the fraction.
  local pio2_hi: cdouble = 0x1.921fb54442D18p+0_cdouble
  local pio2_lo: cdouble = 6.12323399573676603587e-17_cdouble
  local product_hi = fraction_hi * pio2_hi
  local split = 0x1.0000002p+27_cdouble
  local ca = split * fraction_hi
  local a_hi = ca - (ca - fraction_hi)
  local a_lo = fraction_hi - a_hi
  local cb = split * pio2_hi
  local b_hi = cb - (cb - pio2_hi)
  local b_lo = pio2_hi - b_hi
  local product_error = ((a_hi * b_hi - product_hi) + a_hi * b_lo + a_lo * b_hi) + a_lo * b_lo
  head[0] = product_hi
  tail[0] = product_error + fraction_hi * pio2_lo + fraction_lo * pio2_hi +
    fraction_lo * pio2_lo
end

local function sin_kernel(x: cdouble, y: cdouble): cdouble
  local z = x * x
  local w = z * z
  local r = 8.33333333332248946124e-3_cdouble + z *
    (-1.98412698298579493134e-4_cdouble + z * 2.75573137070700676789e-6_cdouble) +
    z * w * (-2.50507602534068634195e-8_cdouble + z * 1.58969099521155010221e-10_cdouble)
  local v = z * x
  if y == 0_cdouble then
    return x + v * (-1.66666666666666324348e-1_cdouble + z * r)
  end
  return x - ((z * (0.5_cdouble * y - v * r) - y) - v * -1.66666666666666324348e-1_cdouble)
end

local function cos_kernel(x: cdouble, y: cdouble): cdouble
  local z = x * x
  local w = z * z
  local r = z * (4.16666666666666019037e-2_cdouble + z *
    (-1.38888888888741095749e-3_cdouble + z * 2.48015872894767294178e-5_cdouble)) +
    w * w * (-2.75573143513906633035e-7_cdouble + z *
      (2.08757232129817482790e-9_cdouble - z * 1.13596475577881948265e-11_cdouble))
  local half_square = 0.5_cdouble * z
  local rounded_base = 1_cdouble - half_square
  return rounded_base + (((1_cdouble - rounded_base) - half_square) + (z * r - x * y))
end

local function sin(value: cdouble): cdouble <cexport, codename 'sin'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    math_domain_error()
    return value - value
  end
  if fabs(value) < 0x1p-27_cdouble then return value end
  local quadrant: cint = 0_cint
  local x: cdouble = value
  local y: cdouble = 0_cdouble
  if fabs(value) > 0x1.921FB54442D18P-1_cdouble then
    reduce_pio2(value, &quadrant, &x, &y)
  end
  local sine = sin_kernel(x, y)
  local cosine = cos_kernel(x, y)
  if quadrant == 0_cint then return sine end
  if quadrant == 1_cint then return cosine end
  if quadrant == 2_cint then return -sine end
  return -cosine
end

local function cos(value: cdouble): cdouble <cexport, codename 'cos'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    math_domain_error()
    return value - value
  end
  if fabs(value) < 0x1p-27_cdouble then return 1_cdouble end
  local quadrant: cint = 0_cint
  local x: cdouble = value
  local y: cdouble = 0_cdouble
  if fabs(value) > 0x1.921FB54442D18P-1_cdouble then
    reduce_pio2(value, &quadrant, &x, &y)
  end
  local sine = sin_kernel(x, y)
  local cosine = cos_kernel(x, y)
  if quadrant == 0_cint then return cosine end
  if quadrant == 1_cint then return -sine end
  if quadrant == 2_cint then return -cosine end
  return sine
end

local function sincos(value: cdouble, sine_out: *[0]cdouble, cosine_out: *[0]cdouble)
    <cexport, codename 'sincos'>
  if value ~= value then
    local nan_value = value + value
    sine_out[0] = nan_value
    cosine_out[0] = nan_value
    return
  end
  if is_infinite64(value) then
    math_domain_error()
    local nan_value = value - value
    sine_out[0] = nan_value
    cosine_out[0] = nan_value
    return
  end
  if fabs(value) < 0x1p-27_cdouble then
    sine_out[0] = value
    cosine_out[0] = 1_cdouble
    return
  end
  local quadrant: cint = 0_cint
  local x: cdouble = value
  local y: cdouble = 0_cdouble
  if fabs(value) > 0x1.921FB54442D18P-1_cdouble then
    reduce_pio2(value, &quadrant, &x, &y)
  end
  local sine = sin_kernel(x, y)
  local cosine = cos_kernel(x, y)
  if quadrant == 0_cint then
    sine_out[0], cosine_out[0] = sine, cosine
  elseif quadrant == 1_cint then
    sine_out[0], cosine_out[0] = cosine, -sine
  elseif quadrant == 2_cint then
    sine_out[0], cosine_out[0] = -sine, -cosine
  else
    sine_out[0], cosine_out[0] = -cosine, sine
  end
end

local function sincosf(value: cfloat, sine_out: *[0]cfloat, cosine_out: *[0]cfloat)
    <cexport, codename 'sincosf'>
  local sine_value: cdouble
  local cosine_value: cdouble
  sincos((@cdouble)(value), &sine_value, &cosine_value)
  sine_out[0] = (@cfloat)(sine_value)
  cosine_out[0] = (@cfloat)(cosine_value)
end

local function sinf(value: cfloat): cfloat <cexport, codename 'sinf'>
  return (@cfloat)(sin((@cdouble)(value)))
end

local function gamma_lanczos_positive(value: cdouble): cdouble
  local numerator: cdouble = 0_cdouble
  local denominator: cdouble = 0_cdouble
  if value < 8_cdouble then
    for i = 12, 0, -1 do
      numerator = numerator * value + gamma_snum[i]
      denominator = denominator * value + gamma_sden[i]
    end
  else
    for i = 0, 12 do
      numerator = numerator / value + gamma_snum[i]
      denominator = denominator / value + gamma_sden[i]
    end
  end
  local series = numerator / denominator
  local g_minus_half = 5.524680040776729583740234375_cdouble
  local y = value + g_minus_half
  local delta = (y - value) - g_minus_half
  local z = value - 0.5_cdouble
  return log(series) - y + z * log(y) + delta * (g_minus_half + 0.5_cdouble) / y
end

local function gamma_is_integer(value: cdouble): boolean <inline>
  if value >= 0x1p52_cdouble then return true end
  return value == (@cdouble)((@culonglong)(value))
end

local function gamma_sin_pi_positive(value: cdouble): cdouble
  if value >= 0x1p52_cdouble then return 0_cdouble end
  local reduced = value - 2_cdouble * (@cdouble)((@culonglong)(value * 0.5_cdouble))
  return sin(3.141592653589793238462643383279502884_cdouble * reduced)
end

local function lgamma_r(value: cdouble, sign_result: *[0]cint): cdouble
    <cexport, codename 'lgamma_r'>
  sign_result[0] = 1
  if is_nan64(value) then return value * value end
  if is_infinite64(value) then return value * value end
  local magnitude = fabs(value)
  if magnitude == 0_cdouble then
    math_range_error()
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  if magnitude < 0x1p-54_cdouble then
    if value < 0_cdouble then sign_result[0] = -1 end
    return -log(magnitude)
  end
  local positive = gamma_lanczos_positive(magnitude)
  if value > 0_cdouble then return positive end
  if gamma_is_integer(magnitude) then
    math_range_error()
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  local sine = gamma_sin_pi_positive(magnitude)
  if sine == 0_cdouble then
    math_range_error()
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  if sine > 0_cdouble then sign_result[0] = -1 end
  return log(3.141592653589793238462643383279502884_cdouble / (magnitude * fabs(sine))) - positive
end

local function lgamma(value: cdouble): cdouble <cexport, codename 'lgamma'>
  local sign: cint = 1
  local result = lgamma_r(value, &sign)
  signgam = sign
  return result
end

local function lgammaf(value: cfloat): cfloat <cexport, codename 'lgammaf'>
  local sign: cint = 1
  local result = (@cfloat)(lgamma_r((@cdouble)(value), &sign))
  signgam = sign
  return result
end

local function lgammaf_r(value: cfloat, sign_result: *[0]cint): cfloat
    <cexport, codename 'lgammaf_r'>
  local sign: cint = 1
  local result = lgamma_r((@cdouble)(value), &sign)
  sign_result[0] = sign
  return (@cfloat)(result)
end

local function tgamma(value: cdouble): cdouble <cexport, codename 'tgamma'>
  if is_nan64(value) then return value + value end
  if is_infinite64(value) then
    if value > 0_cdouble then return value end
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end
  if value == 0_cdouble then
    math_range_error()
    if is_negative_zero64(value) then return double_from_bits(0xFFF0000000000000_culonglong) end
    return double_from_bits(0x7FF0000000000000_culonglong)
  end
  local sign: cint = 1
  local logarithm = lgamma_r(value, &sign)
  if is_infinite64(logarithm) then
    if value < 0_cdouble and gamma_is_integer(fabs(value)) then
      math_domain_error()
      return double_from_bits(0x7FF8000000000000_culonglong)
    end
    if value > 0_cdouble then return exp(logarithm) end
    math_range_error()
    if sign < 0_cint then return double_from_bits(0x8000000000000000_culonglong) end
    return 0_cdouble
  end
  local result = exp(logarithm)
  if sign < 0_cint then result = -result end
  if is_infinite64(result) or result == 0_cdouble then math_range_error() end
  return result
end

local function tgammaf(value: cfloat): cfloat <cexport, codename 'tgammaf'>
  local result = (@cfloat)(tgamma((@cdouble)(value)))
  if is_infinite32(result) or (result == 0_cfloat and value ~= 0_cfloat) then math_range_error() end
  return result
end



local function cosf(value: cfloat): cfloat <cexport, codename 'cosf'>
  return (@cfloat)(cos((@cdouble)(value)))
end

local function tan(value: cdouble): cdouble <cexport, codename 'tan'>
  if value ~= value then return value + value end
  if is_infinite64(value) then
    math_domain_error()
    return value - value
  end
  if fabs(value) < 0x1p-27_cdouble then return value end
  local result = sin(value) / cos(value)
  if is_infinite64(result) then math_range_error() end
  return result
end

local function tanf(value: cfloat): cfloat <cexport, codename 'tanf'>
  local result = (@cfloat)(tan((@cdouble)(value)))
  if is_infinite32(result) and value == value and not is_infinite32(value) then
    math_range_error()
  end
  return result
end

local function modf(value: cdouble, integral: *[0]cdouble): cdouble
    <cexport, codename 'modf'>
  if value ~= value then
    integral[0] = value
    return value
  end
  local representation: DoubleBits = {value = value}
  if (representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then
    integral[0] = value
    return value
  end
  if (representation.bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0x7FF0000000000000_culonglong then
    integral[0] = value
    return double_from_bits(representation.bits & 0x8000000000000000_culonglong)
  end
  integral[0] = round_binary64(value, 0_cint)
  if value == integral[0] then
    return double_from_bits(representation.bits & 0x8000000000000000_culonglong)
  end
  return value - integral[0]
end

local function modff(value: cfloat, integral: *[0]cfloat): cfloat
    <cexport, codename 'modff'>
  if value ~= value then
    integral[0] = value
    return value
  end
  local representation: FloatBits = {value = value}
  if (representation.bits & 0x7FFFFFFF_cuint) == 0_cuint then
    integral[0] = value
    return value
  end
  if (representation.bits & 0x7FFFFFFF_cuint) == 0x7F800000_cuint then
    integral[0] = value
    return float_from_bits(representation.bits & 0x80000000_cuint)
  end
  integral[0] = round_binary32(value, 0_cint)
  if value == integral[0] then
    return float_from_bits(representation.bits & 0x80000000_cuint)
  end
  return value - integral[0]
end

local function trunc(value: cdouble): cdouble <cexport, codename 'trunc'>
  return round_binary64(value, 0_cint)
end
local function floor(value: cdouble): cdouble <cexport, codename 'floor'>
  return round_binary64(value, 1_cint)
end
local function ceil(value: cdouble): cdouble <cexport, codename 'ceil'>
  return round_binary64(value, 2_cint)
end
local function round(value: cdouble): cdouble <cexport, codename 'round'>
  return round_binary64(value, 3_cint)
end

local function truncf(value: cfloat): cfloat <cexport, codename 'truncf'>
  return round_binary32(value, 0_cint)
end
local function floorf(value: cfloat): cfloat <cexport, codename 'floorf'>
  return round_binary32(value, 1_cint)
end
local function ceilf(value: cfloat): cfloat <cexport, codename 'ceilf'>
  return round_binary32(value, 2_cint)
end
local function roundf(value: cfloat): cfloat <cexport, codename 'roundf'>
  return round_binary32(value, 3_cint)
end

local function lrint(value: cdouble): clong <cexport, codename 'lrint'>
  return (@clong)(nelibc_lrint_hw(value))
end
local function lrintf(value: cfloat): clong <cexport, codename 'lrintf'>
  return (@clong)(nelibc_lrintf_hw(value))
end
local function llrint(value: cdouble): clonglong <cexport, codename 'llrint'>
  return nelibc_lrint_hw(value)
end
local function llrintf(value: cfloat): clonglong <cexport, codename 'llrintf'>
  return nelibc_lrintf_hw(value)
end
local function lround(value: cdouble): clong <cexport, codename 'lround'>
  return (@clong)(nelibc_lround_hw(round(value)))
end
local function lroundf(value: cfloat): clong <cexport, codename 'lroundf'>
  return (@clong)(nelibc_lroundf_hw(roundf(value)))
end
local function llround(value: cdouble): clonglong <cexport, codename 'llround'>
  return nelibc_lround_hw(round(value))
end
local function llroundf(value: cfloat): clonglong <cexport, codename 'llroundf'>
  return nelibc_lroundf_hw(roundf(value))
end

local BesselPair: type = @record{j: cdouble, y: cdouble}
local bessel_pi: cdouble = 3.141592653589793238462643383279502884_cdouble
local bessel_euler: cdouble = 0.577215664901532860606512090082402431_cdouble
local bessel_sqrt_two_over_pi: cdouble = 0.797884560802865355879892119868763737_cdouble

-- Power series for the first 12 units; the order-zero and order-one Y series
-- share their J series and harmonic-number terms.
local function bessel_series(x: cdouble, order: cint): BesselPair
  local q = x * x * 0.25_cdouble
  local term0: cdouble = 1_cdouble
  local j0sum: cdouble = 1_cdouble
  local y0sum: cdouble = 0_cdouble
  local harmonic: cdouble = 0_cdouble
  for k = 1, 80 do
    local kd: cdouble = (@cdouble)(k)
    term0 = -term0 * q / (kd * kd)
    j0sum = j0sum + term0
    harmonic = harmonic + 1_cdouble / kd
    y0sum = y0sum - harmonic * term0
  end
  local term1: cdouble = x * 0.5_cdouble
  local j1sum = term1
  local y1sum = term1 -- H_0 + H_1 = 1
  local harmonic1: cdouble = 0_cdouble
  for k = 1, 80 do
    local kd: cdouble = (@cdouble)(k)
    term1 = -term1 * q / (kd * (kd + 1_cdouble))
    j1sum = j1sum + term1
    harmonic1 = harmonic1 + 1_cdouble / kd
    y1sum = y1sum + (harmonic1 + harmonic1 + 1_cdouble / (kd + 1_cdouble)) * term1
  end
  local logarithm = log(x) - 0.693147180559945309417232121458176568_cdouble + bessel_euler
  local result: BesselPair
  if order == 0_cint then
    result.j = j0sum
    result.y = (2_cdouble / bessel_pi) * (logarithm * j0sum + y0sum)
  else
    result.j = j1sum
    result.y = -2_cdouble / (bessel_pi * x) + (2_cdouble / bessel_pi) * logarithm * j1sum - y1sum / bessel_pi
  end
  return result
end

-- Optimally truncated Hankel expansions for large arguments. The sine and
-- cosine phase shifts are formed from sin(x), cos(x), preserving reduction at
-- large magnitudes where subtracting pi/4 or 3pi/4 would lose phase bits.
local function bessel_asymptotic(x: cdouble, order: cint): BesselPair
  local p: cdouble = 1_cdouble
  local q: cdouble = 0_cdouble
  local term: cdouble = 1_cdouble
  local previous: cdouble = 1_cdouble
  local phase: cdouble = 1_cdouble
  local nu: cdouble = (@cdouble)(order)
  for k = 1, 80 do
    local kd: cdouble = (@cdouble)(k)
    local odd: cdouble = 2_cdouble * kd - 1_cdouble
    term = term * (4_cdouble * nu * nu - odd * odd) / (8_cdouble * kd * x)
    local magnitude = fabs(term)
    if magnitude > previous then break end
    if k % 2 == 0 then phase = -phase end
    if k % 2 == 0 then p = p + phase * term else q = q + phase * term end
    previous = magnitude
  end
  local sx = sin(x)
  local cx = cos(x)
  local cosine_phase: cdouble
  local sine_phase: cdouble
  if order == 0_cint then
    cosine_phase = (sx + cx) * 0.707106781186547524400844362104849039_cdouble
    sine_phase = (sx - cx) * 0.707106781186547524400844362104849039_cdouble
  else
    cosine_phase = (sx - cx) * 0.707106781186547524400844362104849039_cdouble
    sine_phase = -(sx + cx) * 0.707106781186547524400844362104849039_cdouble
  end
  local j = cosine_phase * p - sine_phase * q
  local y = sine_phase * p + cosine_phase * q
  local scale = bessel_sqrt_two_over_pi / sqrt(x)
  local result: BesselPair
  result.j = scale * j
  result.y = scale * y
  return result
end

local function bessel_pair(x: cdouble, order: cint): BesselPair
  if x < 12_cdouble then return bessel_series(x, order) end
  return bessel_asymptotic(x, order)
end

local function j0(value: cdouble): cdouble <cexport, codename 'j0'>
  if is_nan64(value) then return value + value end
  if value == 0_cdouble then return 1_cdouble end
  if is_infinite64(value) then return 0_cdouble end
  return bessel_pair(fabs(value), 0_cint).j
end

local function j1(value: cdouble): cdouble <cexport, codename 'j1'>
  if is_nan64(value) then return value + value end
  if value == 0_cdouble then return value end
  if is_infinite64(value) then return 0_cdouble end
  local result = bessel_pair(fabs(value), 1_cint).j
  if value < 0_cdouble or is_negative_zero64(value) then return -result end
  return result
end

local function y0(value: cdouble): cdouble <cexport, codename 'y0'>
  if is_nan64(value) then return value + value end
  if value == 0_cdouble then
    math_range_error()
    return double_from_bits(0xFFF0000000000000_culonglong)
  end
  if value < 0_cdouble then
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end
  if is_infinite64(value) then return 0_cdouble end
  return bessel_pair(value, 0_cint).y
end

local function y1(value: cdouble): cdouble <cexport, codename 'y1'>
  if is_nan64(value) then return value + value end
  if value == 0_cdouble then
    math_range_error()
    return double_from_bits(0xFFF0000000000000_culonglong)
  end
  if value < 0_cdouble then
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end
  if is_infinite64(value) then return 0_cdouble end
  local result = bessel_pair(value, 1_cint).y
  if is_infinite64(result) then math_range_error() end
  return result
end

local function j0f(value: cfloat): cfloat <cexport, codename 'j0f'>
  return (@cfloat)(j0((@cdouble)(value)))
end
local function j1f(value: cfloat): cfloat <cexport, codename 'j1f'>
  return (@cfloat)(j1((@cdouble)(value)))
end
local function y0f(value: cfloat): cfloat <cexport, codename 'y0f'>
  return (@cfloat)(y0((@cdouble)(value)))
end
local function y1f(value: cfloat): cfloat <cexport, codename 'y1f'>
  return (@cfloat)(y1((@cdouble)(value)))
end

local bessel_invsqrtpi: cdouble = 0.564189583547756279280349644977834_cdouble

local function jn(n: cint, value: cdouble): cdouble <cexport, codename 'jn'>
  if is_nan64(value) then return value end
  if n == 0_cint then return j0(value) end
  local negative_x = value < 0_cdouble or is_negative_zero64(value)
  local nm1: cint
  if n < 0_cint then nm1 = -(n + 1_cint) else nm1 = n - 1_cint end
  local odd_order = (n & 1_cint) ~= 0_cint
  local negative_result = odd_order and (negative_x ~= (n < 0_cint))
  if nm1 == 0_cint then
    local result = j1(fabs(value))
    if negative_result then return -result end
    return result
  end
  local x = fabs(value)
  local result: cdouble = 0_cdouble
  if x == 0_cdouble or is_infinite64(x) then
    result = 0_cdouble
  elseif (@cdouble)(nm1) < x then
    if x >= 0x1p302_cdouble then
      local phase: cdouble
      local sx, cx = sin(x), cos(x)
      if (nm1 & 3_cint) == 0_cint then phase = -cx + sx
      elseif (nm1 & 3_cint) == 1_cint then phase = -cx - sx
      elseif (nm1 & 3_cint) == 2_cint then phase = cx - sx
      else phase = cx + sx end
      result = bessel_invsqrtpi * phase / sqrt(x)
    else
      local a, b = j0(x), j1(x)
      for i = 1_cint, nm1 do
        local temporary = b
        b = b * (2_cdouble * (@cdouble)(i) / x) - a
        a = temporary
      end
      result = b
    end
  elseif x < 0x1p-29_cdouble then
    if nm1 > 32_cint then result = 0_cdouble
    else
      local half_x = x * 0.5_cdouble
      local power = half_x
      local factorial: cdouble = 1_cdouble
      for i = 2_cint, nm1 + 1_cint do
        factorial = factorial * (@cdouble)(i)
        power = power * half_x
      end
      result = power / factorial
    end
  else
    local nf = (@cdouble)(nm1 + 1_cint)
    local w = 2_cdouble * nf / x
    local h = 2_cdouble / x
    local z = w + h
    local q0 = w
    local q1 = w * z - 1_cdouble
    local k: cint = 1_cint
    while q1 < 1e9_cdouble do
      k = k + 1_cint
      z = z + h
      local temporary = z * q1 - q0
      q0 = q1
      q1 = temporary
    end
    local continued_fraction: cdouble = 0_cdouble
    for i = k, 0_cint, -1_cint do
      continued_fraction = 1_cdouble / (2_cdouble * ((@cdouble)(i) + nf) / x - continued_fraction)
    end
    local a = continued_fraction
    local b: cdouble = 1_cdouble
    local estimate = nf * log(fabs(w))
    if estimate < 709.782712893383973096_cdouble then
      for i = nm1, 1_cint, -1_cint do
        local temporary = b
        b = b * (2_cdouble * (@cdouble)(i)) / x - a
        a = temporary
      end
    else
      for i = nm1, 1_cint, -1_cint do
        local temporary = b
        b = b * (2_cdouble * (@cdouble)(i)) / x - a
        a = temporary
        if b > 0x1p500_cdouble then
          a = a / b
          continued_fraction = continued_fraction / b
          b = 1_cdouble
        end
      end
    end
    local j_zero, j_one = j0(x), j1(x)
    if fabs(j_zero) >= fabs(j_one) then result = continued_fraction * j_zero / b
    else result = continued_fraction * j_one / a end
  end
  if negative_result then return -result end
  return result
end

local function yn(n: cint, value: cdouble): cdouble <cexport, codename 'yn'>
  if is_nan64(value) then return value end
  if value < 0_cdouble then
    math_domain_error()
    return double_from_bits(0x7FF8000000000000_culonglong)
  end
  if is_infinite64(value) then return 0_cdouble end
  if n == 0_cint then return y0(value) end
  local negative_result = n < 0_cint and (n & 1_cint) ~= 0_cint
  local nm1: cint
  if n < 0_cint then nm1 = -(n + 1_cint) else nm1 = n - 1_cint end
  if nm1 == 0_cint then
    local result = y1(value)
    if negative_result then return -result end
    return result
  end
  if value == 0_cdouble then
    math_range_error()
    if negative_result then return double_from_bits(0x7FF0000000000000_culonglong) end
    return double_from_bits(0xFFF0000000000000_culonglong)
  end
  local result: cdouble
  if value >= 0x1p302_cdouble then
    local phase: cdouble
    local sx, cx = sin(value), cos(value)
    if (nm1 & 3_cint) == 0_cint then phase = -sx - cx
    elseif (nm1 & 3_cint) == 1_cint then phase = -sx + cx
    elseif (nm1 & 3_cint) == 2_cint then phase = sx + cx
    else phase = sx - cx end
    result = bessel_invsqrtpi * phase / sqrt(value)
  else
    local a, b = y0(value), y1(value)
    local b_bits: DoubleBits = {value = b}
    for i = 1_cint, nm1 do
      if b_bits.bits == 0xFFF0000000000000_culonglong then break end
      local temporary = b
      b = (2_cdouble * (@cdouble)(i) / value) * b - a
      a = temporary
      b_bits.value = b
    end
    result = b
  end
  if negative_result then return -result end
  return result
end

local function jnf(n: cint, value: cfloat): cfloat <cexport, codename 'jnf'>
  return (@cfloat)(jn(n, (@cdouble)(value)))
end
local function ynf(n: cint, value: cfloat): cfloat <cexport, codename 'ynf'>
  return (@cfloat)(yn(n, (@cdouble)(value)))
end
