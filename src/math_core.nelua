  2.70470278658083486789e+02_cdouble, 1.53875394208320329881e+02_cdouble,
  1.46576176948256193810e+01_cdouble,
}
local j0_qr8: [6]cdouble = {
  0_cdouble, 7.32421874999935051953e-02_cdouble, 1.17682064682252693899e+01_cdouble,
  5.57673380256401856059e+02_cdouble, 8.85919720756468632317e+03_cdouble,
  3.70146267776887834771e+04_cdouble,
