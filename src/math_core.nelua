      imaginary_magnitude = acoshl(alpha)
    end
  elseif absolute_x == 1_clongdouble and absolute_y < 1_clongdouble then
    local delta = 0.5_clongdouble * absolute_y + absolute_y * absolute_y /
      (2_clongdouble * (sqrtl(4_clongdouble + absolute_y * absolute_y) + 2_clongdouble))
    imaginary_magnitude = 2_clongdouble * asinhl(sqrtl(0.5_clongdouble * delta))
  elseif scale > 0x1p64_clongdouble then
    imaginary_magnitude = logl(scale) + logl(alpha_scaled) + 0.693147180559945309417232121458176568_clongdouble
  else
    local alpha = scale * alpha_scaled
    if alpha < 1_clongdouble then alpha = 1_clongdouble end
    imaginary_magnitude = acoshl(alpha)
  end
  imaginary_out[0] = copysignl(imaginary_magnitude, y)
end

local function nelibc_cacosparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_cacosparts_f'>
  local asin_real: cfloat
  local asin_imaginary: cfloat
