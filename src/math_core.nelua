  local reciprocal = 1_clongdouble / scale
  local sx = x / scale
  local sy = y / scale
  local plus_distance = sqrtl((sx + reciprocal) * (sx + reciprocal) + sy * sy)
  local minus_distance = sqrtl((sx - reciprocal) * (sx - reciprocal) + sy * sy)
  local alpha_scaled = 0.5_clongdouble * (plus_distance + minus_distance)
  local beta = sx / alpha_scaled
  if beta > 1_clongdouble then beta = 1_clongdouble elseif beta < -1_clongdouble then beta = -1_clongdouble end
  real_out[0] = asinl(beta)
  local imaginary_magnitude: clongdouble
  local absolute_x = fabsl(x)
  local absolute_y = fabsl(y)
  if absolute_x < 1_clongdouble then
    local cosine_real = sqrtl((1_clongdouble - absolute_x) * (1_clongdouble + absolute_x))
    if absolute_y < 0x1p-32_clongdouble * cosine_real then
      imaginary_magnitude = asinhl(absolute_y / cosine_real)
    elseif scale > 0x1p64_clongdouble then
      imaginary_magnitude = logl(scale) + logl(alpha_scaled) + 0.693147180559945309417232121458176568_clongdouble
    else
