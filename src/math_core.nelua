    <cexport, codename 'nelibc_cacoshparts_f'>
  if is_infinite32(x) and is_nan32(y) then
    real_out[0] = float_from_bits(0x7F800000_cuint)
    imaginary_out[0] = x + y
    return
  end
  local acos_real: cfloat
  local acos_imaginary: cfloat
  nelibc_cacosparts_f(x, y, &acos_real, &acos_imaginary)
  real_out[0] = -acos_imaginary
  imaginary_out[0] = acos_real
end

local function nelibc_cacoshparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_cacoshparts'>
  if is_infinite64(x) and is_nan64(y) then
    real_out[0] = double_from_bits(0x7ff0000000000000_culonglong)
    imaginary_out[0] = x + y
    return
  end
  local acos_real: cdouble
  local acos_imaginary: cdouble
  nelibc_cacosparts(x, y, &acos_real, &acos_imaginary)
