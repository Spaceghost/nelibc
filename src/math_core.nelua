-- The P and Q rational functions in z = 1/x^2; Q's denominator has one more
-- coefficient than P's.
local function bessel_rational(x: cdouble, p: *[0]cdouble, q: *[0]cdouble,
    q_terms: cint): cdouble <inline>
  local z = 1_cdouble / (x * x)
  local r = p[0] + z * (p[1] + z * (p[2] + z * (p[3] + z * (p[4] + z * p[5]))))
  local s: cdouble
  if q_terms == 6_cint then
    s = 1_cdouble + z * (q[0] + z * (q[1] + z * (q[2] + z * (q[3] + z * (q[4] + z * q[5])))))
  else
    s = 1_cdouble + z * (q[0] + z * (q[1] + z * (q[2] + z * (q[3] + z * q[4]))))
  end
  return r / s
end

local function bessel_pzero(x: cdouble): cdouble
  local ix = (@cuint)(bits_of_double(x) >> 32) & 0x7FFFFFFF_cuint
  local ratio: cdouble
  if ix >= 0x40200000_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j0_pr8[0]), (@*[0]cdouble)(&j0_ps8[0]), 5_cint)
  elseif ix >= 0x40122E8B_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j0_pr5[0]), (@*[0]cdouble)(&j0_ps5[0]), 5_cint)
  elseif ix >= 0x4006DB6D_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j0_pr3[0]), (@*[0]cdouble)(&j0_ps3[0]), 5_cint)
  else
    ratio = bessel_rational(x, (@*[0]cdouble)(&j0_pr2[0]), (@*[0]cdouble)(&j0_ps2[0]), 5_cint)
  end
  return 1_cdouble + ratio
end

local function bessel_qzero(x: cdouble): cdouble
  local ix = (@cuint)(bits_of_double(x) >> 32) & 0x7FFFFFFF_cuint
  local ratio: cdouble
  if ix >= 0x40200000_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j0_qr8[0]), (@*[0]cdouble)(&j0_qs8[0]), 6_cint)
  elseif ix >= 0x40122E8B_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j0_qr5[0]), (@*[0]cdouble)(&j0_qs5[0]), 6_cint)
  elseif ix >= 0x4006DB6D_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j0_qr3[0]), (@*[0]cdouble)(&j0_qs3[0]), 6_cint)
  else
    ratio = bessel_rational(x, (@*[0]cdouble)(&j0_qr2[0]), (@*[0]cdouble)(&j0_qs2[0]), 6_cint)
  end
  return (-0.125_cdouble + ratio) / x
end

local function bessel_pone(x: cdouble): cdouble
  local ix = (@cuint)(bits_of_double(x) >> 32) & 0x7FFFFFFF_cuint
  local ratio: cdouble
  if ix >= 0x40200000_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j1_pr8[0]), (@*[0]cdouble)(&j1_ps8[0]), 5_cint)
  elseif ix >= 0x40122E8B_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j1_pr5[0]), (@*[0]cdouble)(&j1_ps5[0]), 5_cint)
  elseif ix >= 0x4006DB6D_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j1_pr3[0]), (@*[0]cdouble)(&j1_ps3[0]), 5_cint)
  else
    ratio = bessel_rational(x, (@*[0]cdouble)(&j1_pr2[0]), (@*[0]cdouble)(&j1_ps2[0]), 5_cint)
  end
  return 1_cdouble + ratio
end

local function bessel_qone(x: cdouble): cdouble
  local ix = (@cuint)(bits_of_double(x) >> 32) & 0x7FFFFFFF_cuint
  local ratio: cdouble
  if ix >= 0x40200000_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j1_qr8[0]), (@*[0]cdouble)(&j1_qs8[0]), 6_cint)
  elseif ix >= 0x40122E8B_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j1_qr5[0]), (@*[0]cdouble)(&j1_qs5[0]), 6_cint)
  elseif ix >= 0x4006DB6D_cuint then
    ratio = bessel_rational(x, (@*[0]cdouble)(&j1_qr3[0]), (@*[0]cdouble)(&j1_qs3[0]), 6_cint)
  else
    ratio = bessel_rational(x, (@*[0]cdouble)(&j1_qr2[0]), (@*[0]cdouble)(&j1_qs2[0]), 6_cint)
  end
  return (0.375_cdouble + ratio) / x
end

-- j0/y0 for |x| >= 2: sqrt(2/(pi x)) (p0 cos(x-pi/4) -+ q0 sin(x-pi/4)),
-- with sin(x) +- cos(x) = -cos(2x)/(sin(x) -+ cos(x)) to keep the phase
-- accurate where the direct sum cancels.
local function bessel_common0(ix: cuint, x: cdouble, want_y: boolean): cdouble
  local s = sin(x)
  local c = cos(x)
  if want_y then c = -c end
  local cc = s + c
  if ix < 0x7FE00000_cuint then -- avoid overflow in 2x
    local ss = s - c
    local z = -cos(2_cdouble * x)
    if s * c < 0_cdouble then
      cc = z / ss
    else
      ss = z / cc
    end
    if ix < 0x48000000_cuint then
      if want_y then ss = -ss end
      cc = bessel_pzero(x) * cc - bessel_qzero(x) * ss
    end
  end
  return bessel_invsqrtpi * cc / sqrt(x)
end

-- j1/y1 for |x| >= 2: sqrt(2/(pi x)) (p1 cos(x-3pi/4) -+ q1 sin(x-3pi/4)).
local function bessel_common1(ix: cuint, x: cdouble, want_y: boolean, negative: boolean): cdouble
  local s = sin(x)
  if want_y then s = -s end
  local c = cos(x)
  local cc = s - c
  if ix < 0x7FE00000_cuint then
    local ss = -s - c
    local z = cos(2_cdouble * x)
    if s * c > 0_cdouble then
      cc = z / ss
    else
      ss = z / cc
    end
    if ix < 0x48000000_cuint then
      if want_y then ss = -ss end
      cc = bessel_pone(x) * cc - bessel_qone(x) * ss
    end
  end
  if negative then cc = -cc end
  return bessel_invsqrtpi * cc / sqrt(x)
end

-- Optimally truncated Hankel expansions for large arguments. The sine and
-- cosine phase shifts are formed from sin(x), cos(x), preserving reduction at
-- large magnitudes where subtracting pi/4 or 3pi/4 would lose phase bits.
local function j0(value: cdouble): cdouble <cexport, codename 'j0'>
  local ix = (@cuint)(bits_of_double(value) >> 32) & 0x7FFFFFFF_cuint
  if ix >= 0x7FF00000_cuint then return 1_cdouble / (value * value) end -- j0(+-inf) = 0, j0(nan) = nan
  local x = fabs(value)
  if ix >= 0x40000000_cuint then return bessel_common0(ix, x, false) end -- |x| >= 2
  if ix >= 0x3F200000_cuint then -- |x| >= 2^-13: 1 - x*x/4 + x*x*R(x^2)/S(x^2)
    local z = x * x
    local r = z * (1.56249999999999947958e-02_cdouble + z * (-1.89979294238854721751e-04_cdouble +
      z * (1.82954049532700665670e-06_cdouble + z * -4.61832688532103189199e-09_cdouble)))
    local s = 1_cdouble + z * (1.56191029464890010492e-02_cdouble + z * (1.16926784663337450260e-04_cdouble +
      z * (5.13546550207318111446e-07_cdouble + z * 1.16614003333790000205e-09_cdouble)))
    return (1_cdouble + x / 2_cdouble) * (1_cdouble - x / 2_cdouble) + z * (r / s)
  end
  -- 1 - x*x/4 without underflow
  if ix >= 0x38000000_cuint then x = 0.25_cdouble * x * x end -- |x| >= 2^-127
  return 1_cdouble - x
end

local function j1(value: cdouble): cdouble <cexport, codename 'j1'>
  local bits = bits_of_double(value)
  local negative = (bits >> 63) ~= 0_culonglong
  local ix = (@cuint)(bits >> 32) & 0x7FFFFFFF_cuint
  if ix >= 0x7FF00000_cuint then return 1_cdouble / (value * value) end
  if ix >= 0x40000000_cuint then return bessel_common1(ix, fabs(value), false, negative) end -- |x| >= 2
  local z: cdouble
  if ix >= 0x38000000_cuint then -- |x| >= 2^-127
    z = value * value
    local r = z * (-6.25000000000000000000e-02_cdouble + z * (1.40705666955189706048e-03_cdouble +
      z * (-1.59955631084035597520e-05_cdouble + z * 4.96727999609584448412e-08_cdouble)))
    local s = 1_cdouble + z * (1.91537599538363460805e-02_cdouble + z * (1.85946785588630915560e-04_cdouble +
      z * (1.17718464042623683263e-06_cdouble + z * (5.04636257076217042715e-09_cdouble +
      z * 1.23542274426137913908e-11_cdouble))))
    z = r / s
  else
    z = value -- avoid underflow; raise inexact if x != 0
  end
  return (0.5_cdouble + z) * value
end

local function y0(value: cdouble): cdouble <cexport, codename 'y0'>
  local bits = bits_of_double(value)
  local ix = (@cuint)(bits >> 32)
  -- y0(nan) = nan, y0(<0) = nan, y0(0) = -inf, y0(inf) = 0
  if (bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then
    math_range_error()
    return math_divzero(true)
  end
  if (ix >> 31) ~= 0_cuint then
    if is_nan64(value) then return value + value end
    return math_invalid(value)
  end
  if ix >= 0x7FF00000_cuint then return 1_cdouble / value end
  if ix >= 0x40000000_cuint then return bessel_common0(ix, value, true) end -- x >= 2
  -- U(x^2)/V(x^2) + (2/pi)*j0(x)*log(x)
  if ix >= 0x3E400000_cuint then -- x >= 2^-27
    local z = value * value
    local u = -7.38042951086872317523e-02_cdouble + z * (1.76666452509181115538e-01_cdouble +
      z * (-1.38185671945596898896e-02_cdouble + z * (3.47453432093683650238e-04_cdouble +
      z * (-3.81407053724364161125e-06_cdouble + z * (1.95590137035022920206e-08_cdouble +
      z * -3.98205194132103398453e-11_cdouble)))))
    local v = 1_cdouble + z * (1.27304834834123699328e-02_cdouble + z * (7.60068627350353253702e-05_cdouble +
      z * (2.59150851840457805467e-07_cdouble + z * 4.41110311332675467403e-10_cdouble)))
    return u / v + bessel_tpi * (j0(value) * log(value))
  end
  return -7.38042951086872317523e-02_cdouble + bessel_tpi * log(value)
end

local function y1(value: cdouble): cdouble <cexport, codename 'y1'>
  local bits = bits_of_double(value)
  local ix = (@cuint)(bits >> 32)
  if (bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then
    math_range_error()
    return math_divzero(true)
  end
  if (ix >> 31) ~= 0_cuint then
    if is_nan64(value) then return value + value end
    return math_invalid(value)
  end
  if ix >= 0x7FF00000_cuint then return 1_cdouble / value end
  if ix >= 0x40000000_cuint then return bessel_common1(ix, value, true, false) end -- x >= 2
  if ix < 0x3C900000_cuint then -- x < 2^-54
    local result = -bessel_tpi / value
    if is_infinite64(result) then math_range_error() end
    return result
  end
  local z = value * value
  local u = -1.96057090646238940668e-01_cdouble + z * (5.04438716639811282616e-02_cdouble +
    z * (-1.91256895875763547298e-03_cdouble + z * (2.35252600561610495928e-05_cdouble +
    z * -9.19099158039878874504e-08_cdouble)))
  local v = 1_cdouble + z * (1.99167318236649903973e-02_cdouble + z * (2.02552581025135171496e-04_cdouble +
    z * (1.35608801097516229404e-06_cdouble + z * (6.22741452364621501295e-09_cdouble +
    z * 1.66559246207992079114e-11_cdouble))))
  return value * (u / v) + bessel_tpi * (j1(value) * log(value) - 1_cdouble / value)
end

local function j0f(value: cfloat): cfloat <cexport, codename 'j0f'>
  return (@cfloat)(j0((@cdouble)(value)))
end
local function j1f(value: cfloat): cfloat <cexport, codename 'j1f'>
  return (@cfloat)(j1((@cdouble)(value)))
end
local function y0f(value: cfloat): cfloat <cexport, codename 'y0f'>
  return (@cfloat)(y0((@cdouble)(value)))
end
local function y1f(value: cfloat): cfloat <cexport, codename 'y1f'>
  return (@cfloat)(y1((@cdouble)(value)))
end

local function jn(n: cint, value: cdouble): cdouble <cexport, codename 'jn'>
  if is_nan64(value) then return value end
  -- J(-n,x) = (-1)^n J(n,x) and J(n,-x) = (-1)^n J(n,x), so J(-n,x) = J(n,-x).
  if n == 0_cint then return j0(value) end
  local x = value
  local bits = bits_of_double(x)
  local negative = (bits >> 63) ~= 0_culonglong
  local nm1: cint -- |n|-1 handles n == INT_MIN
  if n < 0_cint then
    nm1 = -(n + 1_cint)
    x = -x
    negative = not negative
  else
    nm1 = n - 1_cint
  end
  if nm1 == 0_cint then return j1(x) end
  negative = negative and (n & 1_cint) ~= 0_cint -- even n: positive; odd n: sign of x
  x = fabs(x)
  local ix = (@cuint)(bits >> 32) & 0x7FFFFFFF_cuint
  local b: cdouble = 0_cdouble
  if x == 0_cdouble or ix == 0x7FF00000_cuint then
    b = 0_cdouble
  elseif (@cdouble)(nm1) < x then
    -- Forward recurrence J(n+1,x) = 2n/x J(n,x) - J(n-1,x) is safe.
    if ix >= 0x52D00000_cuint then -- x > 2^302: Jn(x) = cos(x-(2n+1)pi/4) sqrt(2/(pi x))
      local temp: cdouble
      local phase = nm1 & 3_cint
      if phase == 0_cint then temp = -cos(x) + sin(x)
      elseif phase == 1_cint then temp = -cos(x) - sin(x)
      elseif phase == 2_cint then temp = cos(x) - sin(x)
      else temp = cos(x) + sin(x) end
      b = bessel_invsqrtpi * temp / sqrt(x)
    else
      local a = j0(x)
      b = j1(x)
      for i = 1_cint, nm1 do
        local temp = b
        b = b * (2_cdouble * (@cdouble)(i) / x) - a -- avoid underflow
        a = temp
      end
    end
  elseif ix < 0x3E100000_cuint then -- x < 2^-29: first Taylor term 1/n! (x/2)^n
    if nm1 > 32_cint then
      b = 0_cdouble -- underflow
    else
      local temp = x * 0.5_cdouble
      b = temp
      local a: cdouble = 1_cdouble
      for i = 2_cint, nm1 + 1_cint do
        a = a * (@cdouble)(i) -- n!
        b = b * temp -- (x/2)^n
      end
      b = b / a
    end
  else
    -- Backward recurrence from the continued fraction for J(n,x)/J(n-1,x);
    -- Q(k) > 1e9 terms are enough for double.
    local nf = (@cdouble)(nm1) + 1_cdouble
    local w = 2_cdouble * nf / x
    local h = 2_cdouble / x
    local z = w + h
    local q0 = w
    local q1 = w * z - 1_cdouble
    local k: cint = 1_cint
    while q1 < 1.0e9_cdouble do
      k = k + 1_cint
      z = z + h
      local tmp = z * q1 - q0
      q0 = q1
      q1 = tmp
    end
    local t: cdouble = 0_cdouble
    for i = k, 0_cint, -1_cint do
      t = 1_cdouble / (2_cdouble * ((@cdouble)(i) + nf) / x - t)
    end
    local a = t
    b = 1_cdouble
    -- If n*log(2n/x) exceeds log(DBL_MAX) the recurrence may overflow and the
    -- result is likely to underflow; rescale along the way.
    local estimate = nf * log(fabs(w))
    if estimate < 7.09782712893383973096e+02_cdouble then
      for i = nm1, 1_cint, -1_cint do
        local temp = b
        b = b * (2_cdouble * (@cdouble)(i)) / x - a
        a = temp
      end
    else
      for i = nm1, 1_cint, -1_cint do
        local temp = b
        b = b * (2_cdouble * (@cdouble)(i)) / x - a
        a = temp
        if b > 0x1p500_cdouble then
          a = a / b
          t = t / b
          b = 1_cdouble
        end
      end
    end
    local z0 = j0(x)
    local w1 = j1(x)
    if fabs(z0) >= fabs(w1) then
      b = t * z0 / b
    else
      b = t * w1 / a
    end
  end
  if negative then return -b end
  return b
end

local function yn(n: cint, value: cdouble): cdouble <cexport, codename 'yn'>
  if is_nan64(value) then return value end
  local bits = bits_of_double(value)
  local ix = (@cuint)(bits >> 32) & 0x7FFFFFFF_cuint
  if (bits >> 63) ~= 0_culonglong and (bits & 0x7FFFFFFFFFFFFFFF_culonglong) ~= 0_culonglong then
    return math_invalid(value) -- x < 0
  end
  if ix == 0x7FF00000_cuint then return 0_cdouble end
  if n == 0_cint then return y0(value) end
  local nm1: cint
  local negative = false
  if n < 0_cint then
    nm1 = -(n + 1_cint)
    negative = (n & 1_cint) ~= 0_cint
  else
    nm1 = n - 1_cint
  end
  if nm1 == 0_cint then
    if negative then return -y1(value) end
    return y1(value)
  end
  if (bits & 0x7FFFFFFFFFFFFFFF_culonglong) == 0_culonglong then
    -- yn(n, 0) = -inf for n > 0 and the sign of (-1)^n for n < 0
    math_range_error()
    return math_divzero(not negative)
  end
  local b: cdouble
  if ix >= 0x52D00000_cuint then -- x > 2^302: Yn(x) = sin(x-(2n+1)pi/4) sqrt(2/(pi x))
    local temp: cdouble
    local phase = nm1 & 3_cint
    if phase == 0_cint then temp = -sin(value) - cos(value)
    elseif phase == 1_cint then temp = -sin(value) + cos(value)
    elseif phase == 2_cint then temp = sin(value) + cos(value)
    else temp = sin(value) - cos(value) end
    b = bessel_invsqrtpi * temp / sqrt(value)
  else
    local a = y0(value)
    b = y1(value)
    -- Stop once b reaches -inf.
    local i: cint = 0_cint
    while i < nm1 and bits_of_double(b) ~= 0xFFF0000000000000_culonglong do
      i = i + 1_cint
      local temp = b
      b = (2_cdouble * (@cdouble)(i) / value) * b - a
      a = temp
    end
  end
  if negative then return -b end
  return b
end

local function jnf(n: cint, value: cfloat): cfloat <cexport, codename 'jnf'>
  return (@cfloat)(jn(n, (@cdouble)(value)))
end
local function ynf(n: cint, value: cfloat): cfloat <cexport, codename 'ynf'>
  return (@cfloat)(yn(n, (@cdouble)(value)))
end

-- C complex ABI adaptation is in complex_abi.c; keep the scalar calculation
-- here so cexp composes only Nelibc's real exp and trigonometric functions.
local function nelibc_cexpf_parts(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_cexpf_parts'>
  if y == 0_cfloat then
    real_out[0] = expf(x)
    imaginary_out[0] = y
    return
  end
  if is_infinite32(y) then
    local nan_value = y - y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  if is_nan32(y) or is_nan32(x) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  local scale = expf(x)
  real_out[0] = scale * cosf(y)
  imaginary_out[0] = scale * sinf(y)
end

local function nelibc_cexp_parts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_cexp_parts'>
  if y == 0_cdouble then
    real_out[0] = exp(x)
    imaginary_out[0] = y
    return
  end
  if is_infinite64(y) then
    local nan_value = y - y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  if is_nan64(y) or is_nan64(x) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  local scale = exp(x)
  real_out[0] = scale * cos(y)
  imaginary_out[0] = scale * sin(y)
end

local function nelibc_cexpl_parts(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_cexpl_parts'>
  if y == 0_clongdouble then
    real_out[0] = expl(x)
    imaginary_out[0] = y
    return
  end
  if is_infinite80(y) then
    local nan_value = y - y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  if is_nan80(y) or is_nan80(x) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  local scale = expl(x)
  real_out[0] = scale * cosl(y)
  imaginary_out[0] = scale * sinl(y)
end

-- Compute log(|x+iy|) without forming hypot(x,y): hypot can overflow when
-- both components are near the format maximum even though the logarithm fits.
local function nelibc_clogf_parts(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_clogf_parts'>
  if is_infinite32(x) or is_infinite32(y) then
    real_out[0] = float_from_bits(0x7F800000_cuint)
    imaginary_out[0] = atan2f(y, x)
    return
  end
  if is_nan32(x) or is_nan32(y) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  local ax = fabsf(x)
  local ay = fabsf(y)
  local maximum = ax
  local minimum = ay
  if maximum < minimum then
    maximum = ay
    minimum = ax
  end
  if maximum == 0_cfloat then
    real_out[0] = logf(maximum)
  else
    local ratio = minimum / maximum
    real_out[0] = logf(maximum) + 0.5_cfloat * log1pf(ratio * ratio)
  end
  imaginary_out[0] = atan2f(y, x)
end

local function nelibc_clog_parts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_clog_parts'>
  if is_infinite64(x) or is_infinite64(y) then
    real_out[0] = double_from_bits(0x7ff0000000000000_culonglong)
    imaginary_out[0] = atan2(y, x)
    return
  end
  if is_nan64(x) or is_nan64(y) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  local ax = fabs(x)
  local ay = fabs(y)
  local maximum = ax
  local minimum = ay
  if maximum < minimum then
    maximum = ay
    minimum = ax
  end
  if maximum == 0_cdouble then
    real_out[0] = log(maximum)
  else
    local ratio = minimum / maximum
    real_out[0] = log(maximum) + 0.5_cdouble * log1p(ratio * ratio)
  end
  imaginary_out[0] = atan2(y, x)
end

local function nelibc_clogl_parts(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_clogl_parts'>
  if is_infinite80(x) or is_infinite80(y) then
    local infinity: LongDoubleBits = {
      parts = {significand = 0x8000000000000000_culonglong, sign_exponent = 0x7fff_cushort}
    }
    real_out[0] = infinity.value
    imaginary_out[0] = atan2l(y, x)
    return
  end
  if is_nan80(x) or is_nan80(y) then
    local nan_value = x + y
    real_out[0] = nan_value
    imaginary_out[0] = nan_value
    return
  end
  local ax = fabsl(x)
  local ay = fabsl(y)
  local maximum = ax
  local minimum = ay
  if maximum < minimum then
    maximum = ay
    minimum = ax
  end
  if maximum == 0_clongdouble then
    real_out[0] = logl(maximum)
  else
    local ratio = minimum / maximum
    real_out[0] = logl(maximum) + 0.5_clongdouble * log1pl(ratio * ratio)
  end
  imaginary_out[0] = atan2l(y, x)
end

local function nelibc_csinparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_csinparts_f'>
  local sine_x = sinf(x)
  local cosine_x = cosf(x)
  local sinh_y = sinhf(y)
  local cosh_y = coshf(y)
  real_out[0] = sine_x * cosh_y
  imaginary_out[0] = cosine_x * sinh_y
end

local function nelibc_csinparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_csinparts'>
  local sine_x = sin(x)
  local cosine_x = cos(x)
  local sinh_y = sinh(y)
  local cosh_y = cosh(y)
  real_out[0] = sine_x * cosh_y
  imaginary_out[0] = cosine_x * sinh_y
end

local function nelibc_csinparts_l(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_csinparts_l'>
  local sine_x = sinl(x)
  local cosine_x = cosl(x)
  local sinh_y = sinhl(y)
  local cosh_y = coshl(y)
  real_out[0] = sine_x * cosh_y
  imaginary_out[0] = cosine_x * sinh_y
end

local function nelibc_ccosparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_ccosparts_f'>
  local sine_x = sinf(x)
  local cosine_x = cosf(x)
  local sinh_y = sinhf(y)
  local cosh_y = coshf(y)
  real_out[0] = cosine_x * cosh_y
  imaginary_out[0] = -(sine_x * sinh_y)
end

local function nelibc_ccosparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_ccosparts'>
  local sine_x = sin(x)
  local cosine_x = cos(x)
  local sinh_y = sinh(y)
  local cosh_y = cosh(y)
  real_out[0] = cosine_x * cosh_y
  imaginary_out[0] = -(sine_x * sinh_y)
end

local function nelibc_ccosparts_l(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_ccosparts_l'>
  local sine_x = sinl(x)
  local cosine_x = cosl(x)
  local sinh_y = sinhl(y)
  local cosh_y = coshl(y)
  real_out[0] = cosine_x * cosh_y
  imaginary_out[0] = -(sine_x * sinh_y)
end

local function nelibc_csinhparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_csinhparts_f'>
  real_out[0] = sinhf(x) * cosf(y)
  imaginary_out[0] = coshf(x) * sinf(y)
end

local function nelibc_csinhparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_csinhparts'>
  real_out[0] = sinh(x) * cos(y)
  imaginary_out[0] = cosh(x) * sin(y)
end

local function nelibc_csinhparts_l(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_csinhparts_l'>
  real_out[0] = sinhl(x) * cosl(y)
  imaginary_out[0] = coshl(x) * sinl(y)
end

local function nelibc_ccoshparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_ccoshparts_f'>
  real_out[0] = coshf(x) * cosf(y)
  imaginary_out[0] = sinhf(x) * sinf(y)
end

local function nelibc_ccoshparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_ccoshparts'>
  real_out[0] = cosh(x) * cos(y)
  imaginary_out[0] = sinh(x) * sin(y)
end

local function nelibc_ccoshparts_l(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_ccoshparts_l'>
  real_out[0] = coshl(x) * cosl(y)
  imaginary_out[0] = sinhl(x) * sinl(y)
end

local function nelibc_ctanparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_ctanparts_f'>
  local sine_x = sinf(x)
  local cosine_x = cosf(x)
  local sine_2x = 2_cfloat * sine_x * cosine_x
  local cosine_2x = cosine_x * cosine_x - sine_x * sine_x
  local absolute_y = fabsf(y)
  if absolute_y > 10_cfloat then
    local exponential = expf(-2_cfloat * absolute_y)
    local exponential_squared = exponential * exponential
    local denominator = 1_cfloat + 2_cfloat * cosine_2x * exponential + exponential_squared
    real_out[0] = 2_cfloat * sine_2x * exponential / denominator
    imaginary_out[0] = copysignf((1_cfloat - exponential_squared) / denominator, y)
  else
    local denominator = cosine_2x + coshf(2_cfloat * y)
    real_out[0] = sine_2x / denominator
    imaginary_out[0] = sinhf(2_cfloat * y) / denominator
  end
end

local function nelibc_ctanparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_ctanparts'>
  local sine_x = sin(x)
  local cosine_x = cos(x)
  local sine_2x = 2_cdouble * sine_x * cosine_x
  local cosine_2x = cosine_x * cosine_x - sine_x * sine_x
  local absolute_y = fabs(y)
  if absolute_y > 10_cdouble then
    local exponential = exp(-2_cdouble * absolute_y)
    local exponential_squared = exponential * exponential
    local denominator = 1_cdouble + 2_cdouble * cosine_2x * exponential + exponential_squared
    real_out[0] = 2_cdouble * sine_2x * exponential / denominator
    imaginary_out[0] = copysign((1_cdouble - exponential_squared) / denominator, y)
  else
    local denominator = cosine_2x + cosh(2_cdouble * y)
    real_out[0] = sine_2x / denominator
    imaginary_out[0] = sinh(2_cdouble * y) / denominator
  end
end

local function nelibc_ctanparts_l(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_ctanparts_l'>
  local sine_x = sinl(x)
  local cosine_x = cosl(x)
  local sine_2x = 2_clongdouble * sine_x * cosine_x
  local cosine_2x = cosine_x * cosine_x - sine_x * sine_x
  local absolute_y = fabsl(y)
  if absolute_y > 10_clongdouble then
    local exponential = expl(-2_clongdouble * absolute_y)
    local exponential_squared = exponential * exponential
    local denominator = 1_clongdouble + 2_clongdouble * cosine_2x * exponential + exponential_squared
    real_out[0] = 2_clongdouble * sine_2x * exponential / denominator
    imaginary_out[0] = copysignl((1_clongdouble - exponential_squared) / denominator, y)
  else
    local denominator = cosine_2x + coshl(2_clongdouble * y)
    real_out[0] = sine_2x / denominator
    imaginary_out[0] = sinhl(2_clongdouble * y) / denominator
  end
end

local function nelibc_ctanhparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_ctanhparts_f'>
  local sine_y = sinf(y)
  local cosine_y = cosf(y)
  local sine_2y = 2_cfloat * sine_y * cosine_y
  local cosine_2y = cosine_y * cosine_y - sine_y * sine_y
  local absolute_x = fabsf(x)
  if absolute_x > 10_cfloat then
    local exponential = expf(-2_cfloat * absolute_x)
    local exponential_squared = exponential * exponential
    local denominator = 1_cfloat + 2_cfloat * cosine_2y * exponential + exponential_squared
    real_out[0] = copysignf((1_cfloat - exponential_squared) / denominator, x)
    imaginary_out[0] = 2_cfloat * sine_2y * exponential / denominator
  else
    local denominator = coshf(2_cfloat * x) + cosine_2y
    real_out[0] = sinhf(2_cfloat * x) / denominator
    imaginary_out[0] = sine_2y / denominator
  end
end

local function nelibc_ctanhparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_ctanhparts'>
  local sine_y = sin(y)
  local cosine_y = cos(y)
  local sine_2y = 2_cdouble * sine_y * cosine_y
  local cosine_2y = cosine_y * cosine_y - sine_y * sine_y
  local absolute_x = fabs(x)
  if absolute_x > 10_cdouble then
    local exponential = exp(-2_cdouble * absolute_x)
    local exponential_squared = exponential * exponential
    local denominator = 1_cdouble + 2_cdouble * cosine_2y * exponential + exponential_squared
    real_out[0] = copysign((1_cdouble - exponential_squared) / denominator, x)
    imaginary_out[0] = 2_cdouble * sine_2y * exponential / denominator
  else
    local denominator = cosh(2_cdouble * x) + cosine_2y
    real_out[0] = sinh(2_cdouble * x) / denominator
    imaginary_out[0] = sine_2y / denominator
  end
end

local function nelibc_ctanhparts_l(x: clongdouble, y: clongdouble,
    real_out: *[0]clongdouble, imaginary_out: *[0]clongdouble): void
    <cexport, codename 'nelibc_ctanhparts_l'>
  local sine_y = sinl(y)
  local cosine_y = cosl(y)
  local sine_2y = 2_clongdouble * sine_y * cosine_y
  local cosine_2y = cosine_y * cosine_y - sine_y * sine_y
  local absolute_x = fabsl(x)
  if absolute_x > 10_clongdouble then
    local exponential = expl(-2_clongdouble * absolute_x)
    local exponential_squared = exponential * exponential
    local denominator = 1_clongdouble + 2_clongdouble * cosine_2y * exponential + exponential_squared
    real_out[0] = copysignl((1_clongdouble - exponential_squared) / denominator, x)
    imaginary_out[0] = 2_clongdouble * sine_2y * exponential / denominator
  else
    local denominator = coshl(2_clongdouble * x) + cosine_2y
    real_out[0] = sinhl(2_clongdouble * x) / denominator
    imaginary_out[0] = sine_2y / denominator
  end
end

local function nelibc_catanparts_f(x: cfloat, y: cfloat,
    real_out: *[0]cfloat, imaginary_out: *[0]cfloat): void
    <cexport, codename 'nelibc_catanparts_f'>
  if is_infinite32(x) or is_infinite32(y) then
    real_out[0] = copysignf(0.5_cfloat * acosf(-1_cfloat), x)
    imaginary_out[0] = copysignf(0_cfloat, y)
    return
  end
  if is_nan32(x) or is_nan32(y) then
    local nan_value = x + y
    real_out[0], imaginary_out[0] = nan_value, nan_value
    return
  end
  local scale = 1_cfloat
  if fabsf(x) > scale then scale = fabsf(x) end
  if fabsf(y) > scale then scale = fabsf(y) end
  local sx = x / scale
  local sy = y / scale
  local reciprocal = 1_cfloat / scale
  local denominator = sx * sx + sy * sy + reciprocal * reciprocal
  real_out[0] = 0.5_cfloat * atan2f(2_cfloat * sx * reciprocal,
    reciprocal * reciprocal - sx * sx - sy * sy)
  imaginary_out[0] = 0.5_cfloat * atanhf(2_cfloat * sy * reciprocal / denominator)
end

local function nelibc_catanparts(x: cdouble, y: cdouble,
    real_out: *[0]cdouble, imaginary_out: *[0]cdouble): void
    <cexport, codename 'nelibc_catanparts'>
  if is_infinite64(x) or is_infinite64(y) then
    real_out[0] = copysign(0.5_cdouble * acos(-1_cdouble), x)
    imaginary_out[0] = copysign(0_cdouble, y)
    return
  end
  if is_nan64(x) or is_nan64(y) then
    local nan_value = x + y
    real_out[0], imaginary_out[0] = nan_value, nan_value
    return
  end
  local scale = 1_cdouble
  if fabs(x) > scale then scale = fabs(x) end
  if fabs(y) > scale then scale = fabs(y) end
  local sx = x / scale
  local sy = y / scale
  local reciprocal = 1_cdouble / scale
  local denominator = sx * sx + sy * sy + reciprocal * reciprocal
  real_out[0] = 0.5_cdouble * atan2(2_cdouble * sx * reciprocal,
    reciprocal * reciprocal - sx * sx - sy * sy)
  imaginary_out[0] = 0.5_cdouble * atanh(2_cdouble * sy * reciprocal / denominator)
end

local function nelibc_catanparts_l(x: clongdouble, y: clongdouble,
