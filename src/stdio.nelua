        if sign ~= 0 then core_length = core_length + 1 end
        local spaces: csize = 0
        if width > 0 and (@csize)(width) > core_length then
          spaces = (@csize)(width) - core_length
        end
        if not left_align and not zero_pad then written = written + emit_padding(stream, 32, spaces) end
        if sign ~= 0 then written = written + emit_padding(stream, sign, 1) end
        if not left_align and zero_pad then written = written + emit_padding(stream, 48, spaces) end
        written = written + emit_bytes(stream, (@pointer)(&float_buffer), float_length)
        if left_align then written = written + emit_padding(stream, 32, spaces) end
      end
    elseif conversion == 112 or conversion == 100 or conversion == 105 or
        conversion == 117 or conversion == 111 or conversion == 120 or conversion == 88 then
      local is_signed: boolean = conversion == 100 or conversion == 105
      local is_pointer: boolean = conversion == 112
      local base: culonglong = 10
      if conversion == 111 then base = 8 end
      if conversion == 120 or conversion == 88 or is_pointer then base = 16 end
      local negative: boolean = false
      local numeric_value: culonglong = 0
      if is_pointer then
        numeric_value = (@culonglong)((@usize)(nelibc_va_arg_pointer(arguments)))
      elseif is_signed then
        local signed_value: clonglong = 0
        if length_mod == 1 then signed_value = (@clonglong)(nelibc_va_arg_long(arguments))
        elseif length_mod == 2 or length_mod == 3 then signed_value = nelibc_va_arg_long_long(arguments)
        else signed_value = (@clonglong)(nelibc_va_arg_int(arguments)) end
        if signed_value < 0 then
          negative = true
          numeric_value = 0_culonglong - (@culonglong)(signed_value)
        else
          numeric_value = (@culonglong)(signed_value)
        end
      else
        if length_mod == 1 then numeric_value = (@culonglong)(nelibc_va_arg_unsigned_long(arguments))
        elseif length_mod == 2 then numeric_value = nelibc_va_arg_unsigned_long_long(arguments)
        elseif length_mod == 3 then numeric_value = (@culonglong)(nelibc_va_arg_size(arguments))
        else numeric_value = (@culonglong)(nelibc_va_arg_unsigned_int(arguments)) end
      end
      local digits: [64]byte
      local digit_count: csize = 0
      local alphabet: *[0]byte = (@*[0]byte)('0123456789abcdef'_cstring)
      if conversion == 88 then alphabet = (@*[0]byte)('0123456789ABCDEF'_cstring) end
      if numeric_value == 0 then
        if not precision_set or precision ~= 0 then digits[0] = 48; digit_count = 1 end
      else
        while numeric_value ~= 0 do
          digits[digit_count] = alphabet[(@csize)(numeric_value % base)]
          digit_count = digit_count + 1
          numeric_value = numeric_value // base
        end
      end
      if alternate and base == 8 and
          (digit_count == 0 or digits[digit_count - 1] ~= 48) then
        digits[digit_count] = 48
        digit_count = digit_count + 1
      end
      local sign: byte = 0
      if negative then sign = 45
      elseif is_signed and plus_sign then sign = 43
      elseif is_signed and space_sign then sign = 32 end
      local prefix: boolean = is_pointer or (alternate and base == 16 and digit_count ~= 0 and
          not (digit_count == 1 and digits[0] == 48))
      local zeroes: csize = 0
      if precision_set and precision > (@cint)(digit_count) then
        zeroes = (@csize)(precision - (@cint)(digit_count))
      end
      local prefix_length: csize = 0
      if prefix then prefix_length = 2 end
      local sign_length: csize = 0
      if sign ~= 0 then sign_length = 1 end
      local width_value: csize = 0
      if width > 0 then width_value = (@csize)(width) end
      local grouping_active: boolean = grouping_flag and base == 10 and not is_pointer and
          nelibc_grouping_separator_length() > 0 and nelibc_grouping_size(0) > 0
      local separator_length: csize = 0
      local total_digits: csize = zeroes + digit_count
      local grouped_digits: csize = digit_count
      local separators: csize = 0
      if grouping_active then
        separator_length = (@csize)(nelibc_grouping_separator_length())
        separators = grouping_separator_count(grouped_digits)
      end
      local width_zeroes: csize = 0
      if zero_pad and not left_align and not precision_set then
        local raw_length: csize = sign_length + prefix_length + total_digits +
            separators * separator_length
        if width_value > raw_length then width_zeroes = width_value - raw_length end
      end
      local core_length: csize = sign_length + prefix_length + zeroes + width_zeroes +
          digit_count + separators * separator_length
      local spaces: csize = 0
      if width_value > core_length then spaces = width_value - core_length end
      if not left_align then written = written + emit_padding(stream, 32, spaces) end
      if sign ~= 0 then written = written + emit_padding(stream, sign, 1) end
      if prefix then
        written = written + emit_padding(stream, 48, 1)
        written = written + emit_padding(stream, 120, 1)
      end
      written = written + emit_padding(stream, 48, width_zeroes + zeroes)
      local emitted_digits: csize = 0
      local next_separator: csize = grouped_digits
      local next_group_size_index: cint = 0
      if grouping_active then
        local right_boundary: csize = 0
        while (@csize)(next_group_size_index) < separators do
          local group_size: cint = nelibc_grouping_size(next_group_size_index)
          if group_size <= 0 or right_boundary + (@csize)(group_size) >= grouped_digits then break end
          right_boundary = right_boundary + (@csize)(group_size)
          next_group_size_index = next_group_size_index + 1
        end
        next_separator = grouped_digits - right_boundary
        next_group_size_index = next_group_size_index - 1
      end
      while emitted_digits < grouped_digits do
        local digit: byte = digits[digit_count - emitted_digits - 1]
        written = written + emit_padding(stream, digit, 1)
        emitted_digits = emitted_digits + 1
        if grouping_active and emitted_digits == next_separator and emitted_digits < grouped_digits then
          local separator_index: cint = 0
          while separator_index < (@cint)(separator_length) do
            written = written + emit_padding(stream,
                (@byte)(nelibc_grouping_separator_byte(separator_index)), 1)
            separator_index = separator_index + 1
          end
          local group_size: cint = nelibc_grouping_size(next_group_size_index)
          if group_size > 0 then
            next_separator = next_separator + (@csize)(group_size)
            next_group_size_index = next_group_size_index - 1
          else
            next_separator = grouped_digits
          end
        end
      end
      if left_align then written = written + emit_padding(stream, 32, spaces) end
    elseif conversion == 37 then -- %
      local pad: csize = 0
      if width > 1 then pad = (@csize)(width - 1) end
      if not left_align then written = written + emit_padding(stream, 32, pad) end
      written = written + emit_padding(stream, 37, 1)
      if left_align then written = written + emit_padding(stream, 32, pad) end
    else
      nelibc_errno_location()[0] = 22 -- EINVAL
      stream_unlock(stream)
      return -1
    end
    if written < field_start then
      stream_unlock(stream)
      return -1
    end
    if (stream.flags & STREAM_ERROR) ~= 0 then
      stream_unlock(stream)
      return -1
    end
    if written > 2147483647_csize then
      nelibc_errno_location()[0] = 75 -- EOVERFLOW
      stream_unlock(stream)
      return -1
    end
  end
  stream_unlock(stream)
  return (@cint)(written)
end

local function nelibc_vfprintf_host(host_stream: pointer,
    format: *[0]cchar <const>, arguments: cvalist): cint
    <cexport, codename 'nelibc_vfprintf_host'>
  if host_stream == nilptr or format == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local stream: FILE = {
    fd = -6, flags = WRITABLE, user_buffer = (@*byte)(host_stream)
  }
  return vfprintf(&stream, format, arguments)
end

local function fprintf(stream: *FILE, format: *[0]cchar <const>, ...: cvarargs): cint <cexport, codename 'fprintf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vfprintf(stream, format, arguments)
  C.va_end(arguments)
  return result
end

local function printf(format: *[0]cchar <const>, ...: cvarargs): cint <cexport, codename 'printf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vfprintf(&stdout_FILE, format, arguments)
  C.va_end(arguments)
  return result
end

local function vprintf(format: *[0]cchar <const>, arguments: cvalist): cint <cexport, codename 'vprintf'>
  return vfprintf(&stdout_FILE, format, arguments)
end

local function vdprintf(fd: cint, format: *[0]cchar <const>, arguments: cvalist): cint <cexport, codename 'vdprintf'>
  local stream: FILE = {fd = -3, flags = WRITABLE, read_position = (@csize)(fd)}
  return vfprintf(&stream, format, arguments)
end

local function dprintf(fd: cint, format: *[0]cchar <const>, ...: cvarargs): cint <cexport, codename 'dprintf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vdprintf(fd, format, arguments)
  C.va_end(arguments)
  return result
end

local function vsnprintf(buffer: *[0]cchar, size: csize, format: *[0]cchar <const>, arguments: cvalist): cint <cexport, codename 'vsnprintf'>
  if size ~= 0 and buffer == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local stream: FILE = {fd = -2, flags = WRITABLE, buffer_size = size, user_buffer = (@*byte)(buffer)}
  local result: cint = vfprintf(&stream, format, arguments)
  if size ~= 0 then
    local terminator: csize = stream.write_length
    if terminator >= size then terminator = size - 1 end
    buffer[terminator] = 0
  end
  return result
end

local function snprintf(buffer: *[0]cchar, size: csize, format: *[0]cchar <const>, ...: cvarargs): cint <cexport, codename 'snprintf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vsnprintf(buffer, size, format, arguments)
  C.va_end(arguments)
  return result
end

local function vasprintf(output: *[0]*[0]cchar, format: *[0]cchar <const>, arguments: cvalist): cint <cexport, codename 'vasprintf'>
  if output == nilptr or format == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  output[0] = nilptr
  local count_arguments: cvalist
  nelibc_va_copy(count_arguments, arguments)
  local count: cint = vsnprintf(nilptr, 0, format, count_arguments)
  C.va_end(count_arguments)
  if count < 0 then return -1 end
  local size: csize = (@csize)(count) + 1
  local output_buffer: pointer = nelibc_malloc(size)
  if output_buffer == nilptr then return -1 end
  local write_arguments: cvalist
  nelibc_va_copy(write_arguments, arguments)
  local result: cint = vsnprintf((@*[0]cchar)(output_buffer), size, format, write_arguments)
  C.va_end(write_arguments)
  if result < 0 then
    nelibc_free(output_buffer)
    return -1
  end
  output[0] = (@*[0]cchar)(output_buffer)
  return result
end

local function asprintf(output: *[0]*[0]cchar, format: *[0]cchar <const>, ...: cvarargs): cint <cexport, codename 'asprintf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vasprintf(output, format, arguments)
  C.va_end(arguments)
  return result
end

local function vsprintf(buffer: *[0]cchar, format: *[0]cchar <const>, arguments: cvalist): cint <cexport, codename 'vsprintf'>
  return vsnprintf(buffer, MAX_CSIZE, format, arguments)
end

local function sprintf(buffer: *[0]cchar, format: *[0]cchar <const>, ...: cvarargs): cint <cexport, codename 'sprintf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vsprintf(buffer, format, arguments)
  C.va_end(arguments)
  return result
end

local function fflush(stream: *FILE): cint <cexport, codename 'fflush'>
  if stream == nilptr then
    stream_list_lock()
    local cursor: *FILE = all_streams
    local status: cint = 0
    while cursor ~= nilptr do
      stream_lock(cursor)
      if cursor.fd == -5 or (cursor.flags & LAST_WRITE) ~= 0 then
        if flush_write_buffer(cursor) < 0 then status = -1 end
      elseif (cursor.flags & LAST_READ) ~= 0 or cursor.has_pushback ~= 0 then
        if discard_read_buffer(cursor) < 0 then status = -1 end
      end
      stream_unlock(cursor)
      cursor = cursor.next
    end
    stream_list_unlock()
    return status
  end
  stream_lock(stream)
  if stream.fd < 0 and stream.fd ~= -4 and stream.fd ~= -5 then
    nelibc_errno_location()[0] = 9 -- EBADF
    stream_unlock(stream)
    return -1
  end
  local result: cint = 0
  if stream.fd == -5 or (stream.flags & LAST_WRITE) ~= 0 then
    result = flush_write_buffer(stream)
  elseif (stream.flags & LAST_READ) ~= 0 or stream.has_pushback ~= 0 then
    result = discard_read_buffer(stream)
  end
  stream_unlock(stream)
  return result
end

local function fseek(stream: *FILE, offset: clong, whence: cint): cint <cexport, codename 'fseek'>
  if stream == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  stream_lock(stream)
  if stream.fd < 0 and stream.fd ~= -4 and stream.fd ~= -5 then
    nelibc_errno_location()[0] = 9 -- EBADF
    stream_unlock(stream)
    return -1
  end
  if flush_write_buffer(stream) < 0 then
    stream_unlock(stream)
    return -1
  end
  if stream.fd == -4 then
    local base: clong = 0
    if whence == 1 then base = (@clong)(stream.read_position)
    elseif whence == 2 then base = (@clong)(stream.read_length)
    elseif whence ~= 0 then nelibc_errno_location()[0] = 22; stream_unlock(stream); return -1 end
    if (offset > 0 and base > 0x7FFFFFFFFFFFFFFF_clong - offset) or
        (offset < 0 and base < (-0x7FFFFFFFFFFFFFFF_clong - 1) - offset) then
      nelibc_errno_location()[0] = 22
      stream_unlock(stream)
      return -1
    end
    local target: clong = base + offset
    if target < 0 or (@culonglong)(target) > (@culonglong)(stream.buffer_size) then
      nelibc_errno_location()[0] = 22
      stream_unlock(stream)
      return -1
    end
    stream.read_position = (@csize)(target)
    stream.has_pushback = 0
    stream.flags = stream.flags & 0xFFFFFFFE_cuint
    stream_unlock(stream)
    return 0
  end
  if stream.fd == -5 then
    local base: clong = 0
    if whence == 1 then base = (@clong)(stream.read_position)
    elseif whence == 2 then base = (@clong)(stream.read_length)
    elseif whence ~= 0 then nelibc_errno_location()[0] = 22; stream_unlock(stream); return -1 end
    if (offset > 0 and base > 0x7FFFFFFFFFFFFFFF_clong - offset) or
        (offset < 0 and base < (-0x7FFFFFFFFFFFFFFF_clong - 1) - offset) then
      nelibc_errno_location()[0] = 22
      stream_unlock(stream)
      return -1
    end
    local target: clong = base + offset
    if target < 0 then nelibc_errno_location()[0] = 22; stream_unlock(stream); return -1 end
    stream.read_position = (@csize)(target)
    stream.has_pushback = 0
    stream.flags = stream.flags & 0xFFFFFFFE_cuint
    stream_unlock(stream)
    return 0
  end
  local unread: csize = stream.read_length - stream.read_position
  if stream.has_pushback ~= 0 then unread = unread + 1 end
  local result: clong
  if whence == 1 and unread ~= 0 then
    if lseek(stream.fd, -(@clong)(unread), 1) < 0 then
      stream_unlock(stream)
      return -1
    end
    result = lseek(stream.fd, offset, 1)
  else
    result = lseek(stream.fd, offset, whence)
  end
  if result < 0 then
    stream.flags = stream.flags | STREAM_ERROR
    stream_unlock(stream)
    return -1
  end
  stream.read_position = 0
  stream.read_length = 0
  stream.has_pushback = 0
  stream.flags = stream.flags & 0xFFFFFFFE_cuint
  stream_unlock(stream)
  return 0
end

local function fseeko(stream: *FILE, offset: clong, whence: cint): cint <cexport, codename 'fseeko'>
  return fseek(stream, offset, whence)
end

local function ftell(stream: *FILE): clong <cexport, codename 'ftell'>
  if stream == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  stream_lock(stream)
  if stream.fd < 0 and stream.fd ~= -4 and stream.fd ~= -5 then
    nelibc_errno_location()[0] = 9 -- EBADF
    stream_unlock(stream)
    return -1
  end
  if stream.fd == -4 then
    local position: clong = (@clong)(stream.read_position)
    stream_unlock(stream)
    return position
  end
  if stream.fd == -5 then
    local position: clong = (@clong)(stream.read_position)
    stream_unlock(stream)
    return position
  end
  local position: clong = lseek(stream.fd, 0, 1)
  if position < 0 then
    stream_unlock(stream)
    return -1
  end
  local unread: csize = stream.read_length - stream.read_position
  if stream.has_pushback ~= 0 then unread = unread + 1 end
  position = position - (@clong)(unread) + (@clong)(stream.write_length)
  stream_unlock(stream)
  return position
end

local function ftello(stream: *FILE): clong <cexport, codename 'ftello'>
  return ftell(stream)
end

local function fgetpos(stream: *FILE, position: *[0]clong): cint <cexport, codename 'fgetpos'>
  if stream == nilptr or position == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local current: clong = ftell(stream)
  if current < 0 then return -1 end
  position[0] = current
  return 0
end

local function fsetpos(stream: *FILE, position: *[0]clong <const>): cint <cexport, codename 'fsetpos'>
  if stream == nilptr or position == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  return fseek(stream, position[0], 0)
end

local function rewind(stream: *FILE): void <cexport, codename 'rewind'>
  fseek(stream, 0, 0)
  clearerr(stream)
end

local function nelibc_strerror(errnum: cint): *[0]cchar <cimport> end

local function perror(prefix: *[0]cchar <const>): void <cexport, codename 'perror'>
  local errno_slot: *[0]cint = nelibc_errno_location()
  local saved_errno: cint = errno_slot[0]
  if prefix ~= nilptr and prefix[0] ~= 0 then
    if fputs(prefix, &stderr_FILE) == -1 or fputs(': ', &stderr_FILE) == -1 then
      errno_slot[0] = saved_errno
      return
    end
  end
  if fputs(nelibc_strerror(saved_errno), &stderr_FILE) == -1 then
    errno_slot[0] = saved_errno
    return
  end
  fputc(10, &stderr_FILE)
  errno_slot[0] = saved_errno
end
