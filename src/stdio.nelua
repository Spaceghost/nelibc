  local converted: csize = wcrtomb(&output[0], (@cint)(wide),
      (@pointer)(&stream.wide_write_state[0]))
  if converted == ~0_csize or write_bytes(stream, (@pointer)(&output[0]), converted) ~= converted then
    return ~0_cuint
  end
  return wide
end

