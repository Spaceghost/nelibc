    if position > MAX_CSIZE - 2 then
      nelibc_errno_location()[0] = 75 -- EOVERFLOW
      stream.flags = stream.flags | STREAM_ERROR
      return ~0_cuint
    end
    local needed: csize = position + 2
    if needed > MAX_CSIZE // (@csize)(#cint) then
      nelibc_errno_location()[0] = 75 -- EOVERFLOW
      stream.flags = stream.flags | STREAM_ERROR
      return ~0_cuint
    end
    if needed > stream.buffer_size then
      local capacity: csize = stream.buffer_size
      while capacity < needed and capacity <= MAX_CSIZE // 2 do
        capacity = capacity * 2
      end
      if capacity < needed then capacity = needed end
      if capacity > MAX_CSIZE // (@csize)(#cint) then
        nelibc_errno_location()[0] = 75 -- EOVERFLOW
        stream.flags = stream.flags | STREAM_ERROR
        return ~0_cuint
      end
      local grown: pointer = nelibc_realloc((@pointer)(stream.user_buffer),
          capacity * (@csize)(#cint))
      if grown == nilptr then
        stream.flags = stream.flags | STREAM_ERROR
        return ~0_cuint
      end
      stream.user_buffer = (@*byte)(grown)
      stream.buffer_size = capacity
    end
    local memory: *[0]cint = (@*[0]cint)(stream.user_buffer)
    local gap: csize = stream.read_length
    while gap < position do
      memory[gap] = 0
      gap = gap + 1
    end
    memory[position] = (@cint)(wide)
    if position >= stream.read_length then stream.read_length = position + 1 end
    memory[stream.read_length] = 0
    stream.read_position = position + 1
    stream.flags = (stream.flags & ~LAST_READ) | LAST_WRITE
    return wide
  end
