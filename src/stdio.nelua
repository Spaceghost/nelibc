## pragmas.nogc = true
## pragmas.noentrypoint = true

require 'C.stdarg'

local function nelibc_va_arg_int(arguments: cvalist): cint <cimport> end
local function nelibc_va_arg_pointer(arguments: cvalist): pointer <cimport> end
local function nelibc_va_arg_long(arguments: cvalist): clong <cimport> end
local function nelibc_va_arg_long_long(arguments: cvalist): clonglong <cimport> end
local function nelibc_va_arg_unsigned_long(arguments: cvalist): culong <cimport> end
local function nelibc_va_arg_unsigned_long_long(arguments: cvalist): culonglong <cimport> end
local function nelibc_va_arg_size(arguments: cvalist): csize <cimport> end
local function nelibc_va_arg_unsigned_int(arguments: cvalist): cuint <cimport> end
local function nelibc_va_arg_double(arguments: cvalist): cdouble <cimport> end
local function nelibc_va_copy(destination: cvalist, source: cvalist): void <cimport> end
local function nelibc_store_format_count(pointer: pointer, length: cint, count: csize): void <cimport> end

local DoubleBits: type = @union{bits: culonglong, value: cdouble}
local function nelibc_double_bits(value: cdouble): culonglong <inline>
  local representation: DoubleBits = {value = value}
  return representation.bits
end

local function write(fd: cint, buffer: pointer <const>, count: csize): clong <cimport> end
local function read(fd: cint, buffer: pointer, count: csize): clong <cimport> end
local function nelibc_errno_location(): *[0]cint <cimport> end
local function nelibc_radix_character(): cint <cimport> end
local function nelibc_format_fixed_double(value: cdouble, precision: cint,
    radix: cint, output: *[0]byte, capacity: csize): csize <cimport> end
local function nelibc_round_significant_double(value: cdouble, decimal_scale: cint,
    result: *[0]culonglong): cint <cimport> end
local function nelibc_format_general_double(value: cdouble, precision: cint,
    exponent: cint, alternate: cint, uppercase: cint, radix: cint,
    output: *[0]byte, capacity: csize): csize <cimport> end
local function nelibc_grouping_size(position: cint): cint <cimport> end
local function nelibc_grouping_separator_length(): cint <cimport> end
local function nelibc_grouping_separator_byte(index: cint): cint <cimport> end
local function openat(dirfd: cint, pathname: pointer <const>, flags: cint, mode: cuint): cint <cimport> end
local function unlinkat(dirfd: cint, pathname: pointer <const>, flags: cint): cint <cimport> end
local function getpid(): cint <cimport> end
local function nelibc_raw_fcntl(fd: cint, command: cint, argument: culong): cint <cimport> end
local function close(fd: cint): cint <cimport> end
local function nelibc_malloc(size: csize): pointer <cimport> end
local function nelibc_realloc(ptr: pointer, size: csize): pointer <cimport> end
local function nelibc_free(ptr: pointer): void <cimport> end
local function nelibc_stdio_lock(word: *cint, owner: *cint, depth: *cint): void <cimport> end
local function nelibc_stdio_trylock(word: *cint, owner: *cint, depth: *cint): cint <cimport> end
local function nelibc_stdio_unlock(word: *cint, owner: *cint, depth: *cint): void <cimport> end
local function nelibc_host_format_write(stream: pointer, buffer: pointer <const>, count: csize): csize <cimport> end
local function memcpy(dest: pointer, src: pointer <const>, n: csize): pointer <cimport> end
local function memmove(dest: pointer, src: pointer <const>, n: csize): pointer <cimport> end
local function memset(dest: pointer, value: cint, n: csize): pointer <cimport> end

-- Standalone FILE ABI. Keep this record in sync with
-- include/nelibc_stdio_standalone.h.
local FILE: type = @record{
  fd: cint,
  flags: cuint,
  pushback_value: cint,
  has_pushback: cint,
  read_position: csize,
  read_length: csize,
  write_length: csize,
  lock_word: cint,
  lock_owner: cint,
  lock_depth: cint,
  buffer_size: csize,
  user_buffer: *byte,
  next: *FILE,
  buffer: [4096]byte,
  memstream_buffer: **byte,
  memstream_size: *csize
}

local stderr_FILE: FILE <cexport, codename 'nelibc_stderr_FILE'> = {
  fd = 0, flags = 0, pushback_value = 0, has_pushback = 0, next = nilptr
}
local stdout_FILE: FILE <cexport, codename 'nelibc_stdout_FILE'> = {
  fd = 0, flags = 0, pushback_value = 0, has_pushback = 0, next = nilptr
}
local stdin_FILE: FILE <cexport, codename 'nelibc_stdin_FILE'> = {
  fd = 0, flags = 0, pushback_value = 0, has_pushback = 0, next = nilptr
}
local all_streams: *FILE = &stdin_FILE
local stream_list_lock_word: cint = 0
local stream_list_lock_owner: cint = 0
local stream_list_lock_depth: cint = 0
local tmpfile_sequence: culonglong = 0

local STREAM_EOF: cuint <comptime> = 1
local STREAM_ERROR: cuint <comptime> = 2
local MAX_CSIZE: csize <comptime> = ~0_csize
local READABLE: cuint <comptime> = 4
local WRITABLE: cuint <comptime> = 8
local LINE_BUFFERED: cuint <comptime> = 16
local UNBUFFERED: cuint <comptime> = 32
local LAST_WRITE: cuint <comptime> = 64
local LAST_READ: cuint <comptime> = 128
local MEMORY_OWNED: cuint <comptime> = 256
local MEMORY_APPEND: cuint <comptime> = 512
local function lseek(fd: cint, offset: clong, whence: cint): clong <cimport> end
local function stream_lock(stream: *FILE): void <inline>
  if stream.fd == -2 or stream.fd == -3 or stream.fd == -6 then return end
  nelibc_stdio_lock(&stream.lock_word, &stream.lock_owner, &stream.lock_depth)
end
local function stream_unlock(stream: *FILE): void <inline>
  if stream.fd == -2 or stream.fd == -3 or stream.fd == -6 then return end
  nelibc_stdio_unlock(&stream.lock_word, &stream.lock_owner, &stream.lock_depth)
end
local function stream_list_lock(): void <inline>
  nelibc_stdio_lock(&stream_list_lock_word, &stream_list_lock_owner, &stream_list_lock_depth)
end
local function stream_list_unlock(): void <inline>
  nelibc_stdio_unlock(&stream_list_lock_word, &stream_list_lock_owner, &stream_list_lock_depth)
end
local function nelibc_stdio_fork_prepare(): void <cexport, codename 'nelibc_stdio_fork_prepare'>
  stream_list_lock()
  local stream = all_streams
  while stream ~= nilptr do
    stream_lock(stream)
    stream = stream.next
  end
end
local function nelibc_stdio_fork_parent(): void <cexport, codename 'nelibc_stdio_fork_parent'>
  local stream = all_streams
  while stream ~= nilptr do
    stream_unlock(stream)
    stream = stream.next
  end
  stream_list_unlock()
end
local function nelibc_stdio_fork_child(): void <cexport, codename 'nelibc_stdio_fork_child'>
  local stream = all_streams
  while stream ~= nilptr do
    stream.lock_word = 0
    stream.lock_owner = 0
    stream.lock_depth = 0
    stream = stream.next
  end
  stream_list_lock_word = 0
  stream_list_lock_owner = 0
  stream_list_lock_depth = 0
end
local function stream_buffer(stream: *FILE): pointer <inline>
  if stream.user_buffer == nilptr then return (@pointer)(&stream.buffer[0]) end
  return (@pointer)(stream.user_buffer)
end

local function nelibc_stdio_init(): void <cexport, codename 'nelibc_stdio_init'>
  stderr_FILE.fd = 2
  stderr_FILE.flags = WRITABLE | UNBUFFERED
  stderr_FILE.buffer_size = 1
  stderr_FILE.user_buffer = nilptr
  stderr_FILE.next = nilptr
  stdout_FILE.fd = 1
  stdout_FILE.flags = WRITABLE | LINE_BUFFERED
  stdout_FILE.buffer_size = 4096
  stdout_FILE.user_buffer = nilptr
  stdout_FILE.next = &stderr_FILE
  stdin_FILE.fd = 0
  stdin_FILE.flags = READABLE
  stdin_FILE.buffer_size = 4096
  stdin_FILE.user_buffer = nilptr
  stdin_FILE.next = &stdout_FILE
  all_streams = &stdin_FILE
end

local function flush_write_buffer(stream: *FILE): cint <inline>
  if stream.fd == -5 then
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    local published_buffer: *[0]*byte = (@*[0]*byte)(stream.memstream_buffer)
    local published_size: *[0]csize = (@*[0]csize)(stream.memstream_size)
    memory[stream.read_length] = 0
    published_buffer[0] = stream.user_buffer
    published_size[0] = stream.read_length
    stream.write_length = 0
    return 0
  end
  if stream.fd == -4 then
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    if stream.read_position < stream.buffer_size then
      memory[stream.read_position] = 0
    end
    stream.write_length = 0
    return 0
  end
  local offset: csize = 0
  while offset < stream.write_length do
    local chunk: pointer = (@pointer)((@usize)(stream_buffer(stream)) + offset)
    local result: clong = write(stream.fd, chunk, stream.write_length - offset)
    if result <= 0 then
      stream.flags = stream.flags | STREAM_ERROR
      if offset ~= 0 then
        memmove(stream_buffer(stream), chunk, stream.write_length - offset)
        stream.write_length = stream.write_length - offset
      end
      return -1
    end
    offset = offset + (@csize)(result)
  end
  stream.write_length = 0
  return 0
end

local function read_bytes(stream: *FILE, buffer: pointer, count: csize): csize <inline>
  if (stream.flags & READABLE) == 0 then
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  if (stream.flags & LAST_WRITE) ~= 0 and flush_write_buffer(stream) < 0 then return 0 end
  stream.flags = (stream.flags & ~LAST_WRITE) | LAST_READ
  local destination: *[0]byte = (@*[0]byte)(buffer)
  local offset: csize = 0
  if count ~= 0 and stream.has_pushback ~= 0 then
    destination[0] = (@byte)(stream.pushback_value)
    stream.has_pushback = 0
    offset = 1
  end
  if stream.fd == -4 or stream.fd == -5 then
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    while offset < count do
      if stream.read_position >= stream.read_length then
        stream.flags = stream.flags | STREAM_EOF
        break
      end
      local available: csize = stream.read_length - stream.read_position
      local wanted: csize = count - offset
      local amount: csize = available
      if amount > wanted then amount = wanted end
      local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
      local source: pointer <const> = (@pointer)((@usize)(stream.user_buffer) + stream.read_position)
      memcpy(cursor, source, amount)
      stream.read_position = stream.read_position + amount
      offset = offset + amount
    end
    return offset
  end
  while offset < count do
    if stream.read_position == stream.read_length then
      local result: clong = read(stream.fd, stream_buffer(stream), stream.buffer_size)
      if result < 0 then
        stream.flags = stream.flags | STREAM_ERROR
        break
      elseif result == 0 then
        stream.flags = stream.flags | STREAM_EOF
        break
      end
      stream.read_position = 0
      stream.read_length = (@csize)(result)
    end
    local available: csize = stream.read_length - stream.read_position
    local wanted: csize = count - offset
    local amount: csize = available
    if amount > wanted then amount = wanted end
    local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
    local source: pointer <const> = (@pointer)((@usize)(stream_buffer(stream)) + stream.read_position)
    memcpy(cursor, source, amount)
    stream.read_position = stream.read_position + amount
    offset = offset + amount
  end
  return offset
end

local function write_bytes(stream: *FILE, buffer: pointer <const>, count: csize): csize <inline>
  if (stream.flags & WRITABLE) == 0 then
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  if stream.fd == -6 then
    local written: csize = nelibc_host_format_write((@pointer)(stream.user_buffer), buffer, count)
    if written ~= count then stream.flags = stream.flags | STREAM_ERROR end
    return written
  end
  if stream.fd == -2 then
    local copied: csize = 0
    if stream.buffer_size > 0 and stream.write_length < stream.buffer_size - 1 then
      copied = stream.buffer_size - 1 - stream.write_length
      if copied > count then copied = count end
      local destination: pointer = (@pointer)((@usize)(stream.user_buffer) + stream.write_length)
      memcpy(destination, buffer, copied)
    end
    stream.write_length = stream.write_length + count
    return count
  end
  if stream.fd == -3 then
    local offset: csize = 0
    local output_fd: cint = (@cint)(stream.read_position)
    while offset < count do
      local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
      local result: clong = write(output_fd, cursor, count - offset)
      if result <= 0 then
        stream.flags = stream.flags | STREAM_ERROR
        break
      end
      offset = offset + (@csize)(result)
    end
    return offset
  end
  if stream.fd == -5 then
    local needed: csize = stream.read_position + count
    if needed < stream.read_position or needed == MAX_CSIZE then
      stream.flags = stream.flags | STREAM_ERROR
      nelibc_errno_location()[0] = 75 -- EOVERFLOW
      return 0
    end
    needed = needed + 1
    if needed > stream.buffer_size then
      local capacity: csize = stream.buffer_size
      while capacity < needed and capacity <= MAX_CSIZE // 2 do capacity = capacity * 2 end
      if capacity < needed then capacity = needed end
      local grown: pointer = nelibc_realloc((@pointer)(stream.user_buffer), capacity)
      if grown == nilptr then stream.flags = stream.flags | STREAM_ERROR; return 0 end
      stream.user_buffer = (@*byte)(grown)
      stream.buffer_size = capacity
    end
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    stream.flags = (stream.flags & ~LAST_READ) | LAST_WRITE
    local gap: csize = stream.read_length
    while gap < stream.read_position do
      memory[gap] = 0
      gap = gap + 1
    end
    memcpy((@pointer)((@usize)(stream.user_buffer) + stream.read_position), buffer, count)
    stream.read_position = stream.read_position + count
    if stream.read_position > stream.read_length then stream.read_length = stream.read_position end
    memory[stream.read_length] = 0
    return count
  end
  if stream.fd == -4 then
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    if (stream.flags & MEMORY_APPEND) ~= 0 then stream.read_position = stream.read_length end
    stream.flags = (stream.flags & ~LAST_READ) | LAST_WRITE
    local amount: csize = count
    if stream.read_position >= stream.buffer_size then
      amount = 0
    elseif amount > stream.buffer_size - stream.read_position then
      amount = stream.buffer_size - stream.read_position
    end
    if amount ~= 0 then
      local destination: pointer = (@pointer)((@usize)(stream.user_buffer) + stream.read_position)
      memcpy(destination, buffer, amount)
      stream.read_position = stream.read_position + amount
      if stream.read_position > stream.read_length then stream.read_length = stream.read_position end
      if stream.read_position < stream.buffer_size then memory[stream.read_position] = 0 end
    end
    if amount ~= count then stream.flags = stream.flags | STREAM_ERROR end
    return amount
  end
  local unread: csize = 0
  if (stream.flags & LAST_READ) ~= 0 then
    unread = stream.read_length - stream.read_position
    if stream.has_pushback ~= 0 then unread = unread + 1 end
  end
  if unread ~= 0 then
    if lseek(stream.fd, -(@clong)(unread), 1) < 0 then
      stream.flags = stream.flags | STREAM_ERROR
      return 0
    end
    stream.read_position = 0
    stream.read_length = 0
    stream.has_pushback = 0
  end
  stream.flags = (stream.flags & ~LAST_READ) | LAST_WRITE
  local offset: csize = 0
  while offset < count do
    if (stream.flags & UNBUFFERED) ~= 0 then
      local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
      local result: clong = write(stream.fd, cursor, count - offset)
      if result <= 0 then stream.flags = stream.flags | STREAM_ERROR; break end
      offset = offset + (@csize)(result)
    else
      local space: csize = stream.buffer_size - stream.write_length
      local amount: csize = count - offset
      if amount > space then amount = space end
      local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
      local destination: pointer = (@pointer)((@usize)(stream_buffer(stream)) + stream.write_length)
      memcpy(destination, cursor, amount)
      stream.write_length = stream.write_length + amount
      offset = offset + amount
      local flush_now: boolean = stream.write_length == stream.buffer_size
      if (stream.flags & LINE_BUFFERED) ~= 0 then
        local input: *[0]byte = (@*[0]byte)(buffer)
        local j: csize = offset - amount
        while j < offset do
          if input[j] == 10 then flush_now = true end
          j = j + 1
        end
      end
      if flush_now and flush_write_buffer(stream) < 0 then break end
    end
  end
  return offset
end

local function fgetc(stream: *FILE): cint <cexport, codename 'fgetc'>
  stream_lock(stream)
  local value: byte = 0
  if read_bytes(stream, (@pointer)(&value), 1) ~= 1 then stream_unlock(stream); return -1 end
  stream_unlock(stream)
  return (@cint)(value)
end

local function fgetc_unlocked(stream: *FILE): cint <inline>
  local value: byte = 0
  if read_bytes(stream, (@pointer)(&value), 1) ~= 1 then return -1 end
  return (@cint)(value)
end

local function getc(stream: *FILE): cint <cexport, codename 'getc'>
  return fgetc(stream)
end

local function getdelim(line_pointer: *[0]*[0]cchar, capacity_pointer: *[0]csize, delimiter: cint, stream: *FILE): clong <cexport, codename 'getdelim'>
  if line_pointer == nilptr or capacity_pointer == nilptr or stream == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local capacity: csize = capacity_pointer[0]
  local line: *[0]cchar = line_pointer[0]
  if line == nilptr or capacity == 0 then
    capacity = 128
    local replacement: pointer = nelibc_realloc((@pointer)(line), capacity)
    if replacement == nilptr then return -1 end
    line = (@*[0]cchar)(replacement)
    line_pointer[0] = line
    capacity_pointer[0] = capacity
  end
  local length: csize = 0
  local delimiter_byte: byte = (@byte)(delimiter)
  while true do
    if length >= capacity - 1 then
      if capacity > MAX_CSIZE // 2 then
        nelibc_errno_location()[0] = 75 -- EOVERFLOW
        return -1
      end
      local new_capacity: csize = capacity * 2
      local replacement: pointer = nelibc_realloc((@pointer)(line), new_capacity)
      if replacement == nilptr then
        if length == 0 then return -1 end
        break
      end
      line = (@*[0]cchar)(replacement)
      line_pointer[0] = line
      capacity = new_capacity
      capacity_pointer[0] = capacity
    end
    local character: cint = fgetc(stream)
    if character == -1 then break end
    line[length] = (@cchar)(character)
    length = length + 1
    if (@byte)(character) == delimiter_byte then break end
  end
  if length == 0 then return -1 end
  line[length] = 0
  if length > 9223372036854775807_csize then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    return -1
  end
  return (@clong)(length)
end

local function getline(line_pointer: *[0]*[0]cchar, capacity_pointer: *[0]csize, stream: *FILE): clong <cexport, codename 'getline'>
  return getdelim(line_pointer, capacity_pointer, 10, stream)
end

local function getchar(): cint <cexport, codename 'getchar'>
  return fgetc(&stdin_FILE)
end

local function getchar_unlocked(): cint <cexport, codename 'getchar_unlocked'>
  return fgetc_unlocked(&stdin_FILE)
end

local function fgets(buffer: *[0]cchar, count: cint, stream: *FILE): *[0]cchar <cexport, codename 'fgets'>
  if count <= 0 then return nilptr end
  local destination: *[0]byte = (@*[0]byte)(buffer)
  if count == 1 then
    destination[0] = 0
    return buffer
  end
  stream_lock(stream)
  local length: csize = 0
  local limit: csize = (@csize)(count - 1)
  while length < limit do
    local value: byte = 0
    if read_bytes(stream, (@pointer)(&value), 1) ~= 1 then break end
    destination[length] = value
    length = length + 1
    if value == 10 then break end
  end
  if length == 0 then
    stream_unlock(stream)
    return nilptr
  end
  destination[length] = 0
  stream_unlock(stream)
  return buffer
end

local function fgets_unlocked(buffer: *[0]cchar, count: cint, stream: *FILE): *[0]cchar
    <cexport, codename 'fgets_unlocked'>
  if count <= 0 then return nilptr end
  local destination: *[0]byte = (@*[0]byte)(buffer)
  if count == 1 then
    destination[0] = 0
    return buffer
  end
  local length: csize = 0
  local limit: csize = (@csize)(count - 1)
  while length < limit do
    local value: byte = 0
    if read_bytes(stream, (@pointer)(&value), 1) ~= 1 then break end
    destination[length] = value
    length = length + 1
    if value == 10 then break end
  end
  if length == 0 then return nilptr end
  destination[length] = 0
  return buffer
end

local function ungetc(character: cint, stream: *FILE): cint <cexport, codename 'ungetc'>
  stream_lock(stream)
  if character == -1 or stream.has_pushback ~= 0 or (stream.flags & READABLE) == 0 then stream_unlock(stream); return -1 end
  stream.pushback_value = character & 255
  stream.has_pushback = 1
  stream.flags = stream.flags | LAST_READ
  stream.flags = stream.flags & 0xFFFFFFFE_cuint
  stream_unlock(stream)
  return character & 255
end

local function fread(buffer: pointer, size: csize, count: csize, stream: *FILE): csize <cexport, codename 'fread'>
  if size == 0 or count == 0 then return 0 end
  if count > MAX_CSIZE // size then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  stream_lock(stream)
  local bytes_read = read_bytes(stream, buffer, size * count)
  stream_unlock(stream)
  return bytes_read // size
end

local function fwrite(buffer: pointer <const>, size: csize, count: csize, stream: *FILE): csize <cexport, codename 'fwrite'>
  if size == 0 or count == 0 then return 0 end
  if count > MAX_CSIZE // size then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  stream_lock(stream)
  local bytes_written = write_bytes(stream, buffer, size * count)
  stream_unlock(stream)
  return bytes_written // size
end

local function fputc(character: cint, stream: *FILE): cint <cexport, codename 'fputc'>
  stream_lock(stream)
  local value: byte = (@byte)(character)
  if write_bytes(stream, (@pointer)(&value), 1) ~= 1 then stream_unlock(stream); return -1 end
  stream_unlock(stream)
  return (@cint)(value)
end

local function fputc_unlocked(character: cint, stream: *FILE): cint <inline>
  local value: byte = (@byte)(character)
  if write_bytes(stream, (@pointer)(&value), 1) ~= 1 then return -1 end
  return (@cint)(value)
end

local function fputs(string: *[0]cchar <const>, stream: *FILE): cint <cexport, codename 'fputs'>
  local bytes: *[0]byte = (@*[0]byte)(string)
  local length: csize = 0
  while bytes[length] ~= 0 do length = length + 1 end
  stream_lock(stream)
  if write_bytes(stream, (@pointer)(string), length) ~= length then stream_unlock(stream); return -1 end
  stream_unlock(stream)
  return 0
end

local function fputs_unlocked(string: *[0]cchar <const>, stream: *FILE): cint
    <cexport, codename 'fputs_unlocked'>
  local bytes: *[0]byte = (@*[0]byte)(string)
  local length: csize = 0
  while bytes[length] ~= 0 do length = length + 1 end
  if write_bytes(stream, (@pointer)(string), length) ~= length then return -1 end
  return 0
end

local function putchar(character: cint): cint <cexport, codename 'putchar'>
  return fputc(character, &stdout_FILE)
end

local function putchar_unlocked(character: cint): cint <cexport, codename 'putchar_unlocked'>
  return fputc_unlocked(character, &stdout_FILE)
end

local function puts(string: *[0]cchar <const>): cint <cexport, codename 'puts'>
  stream_lock(&stdout_FILE)
  if fputs(string, &stdout_FILE) == -1 or fputc(10, &stdout_FILE) == -1 then stream_unlock(&stdout_FILE); return -1 end
  stream_unlock(&stdout_FILE)
  return 0
end

local function feof(stream: *FILE): cint <cexport, codename 'feof'>
  stream_lock(stream)
  local result: cint = 0
  if (stream.flags & STREAM_EOF) ~= 0 then result = 1 end
  stream_unlock(stream)
  return result
end

local function ferror(stream: *FILE): cint <cexport, codename 'ferror'>
  stream_lock(stream)
  local result: cint = 0
  if (stream.flags & STREAM_ERROR) ~= 0 then result = 1 end
  stream_unlock(stream)
  return result
end

local function clearerr(stream: *FILE): void <cexport, codename 'clearerr'>
  stream_lock(stream)
  stream.flags = stream.flags & 0xFFFFFFFC_cuint
  stream_unlock(stream)
end

local function flockfile(stream: *FILE): void <cexport, codename 'flockfile'>
  stream_lock(stream)
end
local function ftrylockfile(stream: *FILE): cint <cexport, codename 'ftrylockfile'>
  return nelibc_stdio_trylock(&stream.lock_word, &stream.lock_owner, &stream.lock_depth)
end
local function funlockfile(stream: *FILE): void <cexport, codename 'funlockfile'>
  stream_unlock(stream)
end

local function remove(pathname: *[0]cchar <const>): cint <cexport, codename 'remove'>
  if pathname == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  if unlinkat(-100, pathname, 0) == 0 then return 0 end -- AT_FDCWD
  if nelibc_errno_location()[0] == 21 then -- EISDIR
    return unlinkat(-100, pathname, 512) -- AT_REMOVEDIR
  end
  return -1
end

local function fopen(pathname: *[0]cchar <const>, mode: *[0]cchar <const>): *FILE <cexport, codename 'fopen'>
  if pathname == nilptr or mode == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end

  local flags: cint = 0
  if mode[0] == 114 then -- 'r'
    flags = 0 -- O_RDONLY
  elseif mode[0] == 119 then -- 'w'
    flags = 1 | 64 | 512 -- O_WRONLY | O_CREAT | O_TRUNC
  elseif mode[0] == 97 then -- 'a'
    flags = 1 | 64 | 1024 -- O_WRONLY | O_CREAT | O_APPEND
  else
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end

  local plus_seen: boolean = false
  local exclusive_seen: boolean = false
  local close_on_exec_seen: boolean = false
  local index: csize = 1
  while mode[index] ~= 0 do
    if mode[index] == 98 then -- 'b'
      -- Binary mode is equivalent to text mode on Linux.
    elseif mode[index] == 43 then -- '+'
      if plus_seen then
        nelibc_errno_location()[0] = 22 -- EINVAL
        return nilptr
      end
      plus_seen = true
    elseif mode[index] == 120 then -- 'x'
      if exclusive_seen or mode[0] ~= 119 then -- 'w'
        nelibc_errno_location()[0] = 22 -- EINVAL
        return nilptr
      end
      exclusive_seen = true
      flags = flags | 128 -- O_EXCL
    elseif mode[index] == 101 then -- 'e'
      if close_on_exec_seen then
        nelibc_errno_location()[0] = 22 -- EINVAL
        return nilptr
      end
      close_on_exec_seen = true
      flags = flags | 524288 -- O_CLOEXEC
    else
      nelibc_errno_location()[0] = 22 -- EINVAL
      return nilptr
    end
    index = index + 1
  end
  if plus_seen then flags = (flags & ~3) | 2 end -- O_RDWR

  local fd: cint = openat(-100, (@pointer)(pathname), flags, 438_cuint)
  if fd < 0 then return nilptr end
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then
    local saved_errno: cint = nelibc_errno_location()[0]
    close(fd)
    nelibc_errno_location()[0] = saved_errno
    return nilptr
  end
  stream.fd = fd
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = fd
  stream.flags = WRITABLE
  if mode[0] == 114 then stream.flags = READABLE end
  if plus_seen then stream.flags = READABLE | WRITABLE end
  stream.buffer_size = 4096
  stream.user_buffer = nilptr
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end

local function fmemopen(buffer: pointer, size: csize, mode: *[0]cchar <const>): *FILE <cexport, codename 'fmemopen'>
  if size == 0 or mode == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local initial_mode: byte = (@byte)(mode[0])
  if initial_mode ~= 114 and initial_mode ~= 119 and initial_mode ~= 97 then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local plus_seen: boolean = false
  local binary_seen: boolean = false
  local index: csize = 1
  while mode[index] ~= 0 do
    if mode[index] == 43 then
      if plus_seen then nelibc_errno_location()[0] = 22; return nilptr end
      plus_seen = true
    elseif mode[index] == 98 then
      if binary_seen then nelibc_errno_location()[0] = 22; return nilptr end
      binary_seen = true
      -- Binary mode is equivalent to text mode on Linux.
    else
      nelibc_errno_location()[0] = 22 -- EINVAL
      return nilptr
    end
    index = index + 1
  end
  local owned: boolean = buffer == nilptr
  if owned then
    buffer = nelibc_malloc(size)
    if buffer == nilptr then return nilptr end
    memset(buffer, 0, size)
  end
  local bytes: *[0]byte = (@*[0]byte)(buffer)
  local length: csize = 0
  if initial_mode == 119 then
    bytes[0] = 0
  else
    while length < size and bytes[length] ~= 0 do length = length + 1 end
  end
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then
    if owned then nelibc_free(buffer) end
    return nilptr
  end
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = -4
  stream.flags = 0
  if initial_mode == 114 or plus_seen then stream.flags = stream.flags | READABLE end
  if initial_mode ~= 114 or plus_seen then stream.flags = stream.flags | WRITABLE end
  if owned then stream.flags = stream.flags | MEMORY_OWNED end
  if initial_mode == 97 then stream.flags = stream.flags | MEMORY_APPEND end
  stream.buffer_size = size
  stream.user_buffer = (@*byte)(buffer)
  stream.read_length = length
  if initial_mode == 97 then stream.read_position = length end
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end

local function open_memstream(buffer: **byte, size: *csize): *FILE <cexport, codename 'open_memstream'>
  if buffer == nilptr or size == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local output_buffer: *[0]*byte = (@*[0]*byte)(buffer)
  local output_size: *[0]csize = (@*[0]csize)(size)
  output_buffer[0] = nilptr
  output_size[0] = 0
  local memory: pointer = nelibc_malloc(1)
  if memory == nilptr then return nilptr end
  ((@*[0]byte)(memory))[0] = 0
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then
    nelibc_free(memory)
    return nilptr
  end
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = -5
  stream.flags = READABLE | WRITABLE
  stream.buffer_size = 1
  stream.user_buffer = (@*byte)(memory)
  stream.memstream_buffer = buffer
  stream.memstream_size = size
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end

local function fdopen(fd: cint, mode: *[0]cchar <const>): *FILE <cexport, codename 'fdopen'>
  if mode == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  if fd < 0 then
    nelibc_errno_location()[0] = 9 -- EBADF
    return nilptr
  end
  local initial_mode: byte = (@byte)(mode[0])
  if initial_mode ~= 114 and initial_mode ~= 119 and initial_mode ~= 97 then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local plus_seen: boolean = false
  local close_on_exec_seen: boolean = false
  local index: csize = 1
  while mode[index] ~= 0 do
    if mode[index] == 43 then
      if plus_seen then nelibc_errno_location()[0] = 22; return nilptr end
      plus_seen = true
    elseif mode[index] == 98 then
      -- Binary mode is equivalent to text mode on Linux.
    elseif mode[index] == 101 then
      if close_on_exec_seen then nelibc_errno_location()[0] = 22; return nilptr end
      close_on_exec_seen = true
    else
      nelibc_errno_location()[0] = 22 -- EINVAL
      return nilptr
    end
    index = index + 1
  end
  local descriptor_flags: cint = nelibc_raw_fcntl(fd, 3, 0) -- F_GETFL
  if descriptor_flags < 0 then return nilptr end
  local access_mode: cint = descriptor_flags & 3 -- O_ACCMODE
  local wants_read: boolean = initial_mode == 114 or plus_seen
  local wants_write: boolean = initial_mode ~= 114 or plus_seen
  if (wants_read and access_mode == 1) or (wants_write and access_mode == 0) then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then return nilptr end
  local fd_flags: cint = 0
  if close_on_exec_seen then
    fd_flags = nelibc_raw_fcntl(fd, 1, 0) -- F_GETFD
    if fd_flags < 0 then
      nelibc_free((@pointer)(stream))
      return nilptr
    end
  end
  local append_changed: boolean = false
  if initial_mode == 97 and (descriptor_flags & 1024) == 0 then
    if nelibc_raw_fcntl(fd, 4, (@culong)(descriptor_flags | 1024)) < 0 then
      nelibc_free((@pointer)(stream))
      return nilptr
    end -- F_SETFL, O_APPEND
    append_changed = true
  end
  if close_on_exec_seen then
    if nelibc_raw_fcntl(fd, 2, (@culong)(fd_flags | 1)) < 0 then
      if append_changed then nelibc_raw_fcntl(fd, 4, (@culong)(descriptor_flags)) end
      nelibc_free((@pointer)(stream))
      return nilptr
    end -- F_SETFD, FD_CLOEXEC
  end
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = fd
  stream.flags = 0
  if wants_read then stream.flags = stream.flags | READABLE end
  if wants_write then stream.flags = stream.flags | WRITABLE end
  stream.buffer_size = 4096
  stream.user_buffer = nilptr
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end

local function fileno(stream: *FILE): cint <cexport, codename 'fileno'>
  if stream == nilptr then
    nelibc_errno_location()[0] = 9 -- EBADF
    return -1
  end
  stream_lock(stream)
  local fd: cint = stream.fd
  stream_unlock(stream)
  if fd < 0 then nelibc_errno_location()[0] = 9; return -1 end
  return fd
end

local function tmpfile(): *FILE <cexport, codename 'tmpfile'>
  local prefix: *[0]byte = (@*[0]byte)('/tmp/nelibc-tmp-'_cstring)
  local prefix_length: csize = 0
  while prefix[prefix_length] ~= 0 do prefix_length = prefix_length + 1 end
  local attempt: cint = 0
  while attempt < 128 do
    stream_list_lock()
    tmpfile_sequence = tmpfile_sequence + 1
    if tmpfile_sequence == 0 then tmpfile_sequence = 1 end
    local sequence: culonglong = tmpfile_sequence
    stream_list_unlock()

    local pathname: [64]byte
    local path_length: csize = 0
    memcpy((@pointer)(&pathname[0]), (@pointer)(prefix), prefix_length)
    path_length = prefix_length
    local pid_digits: [16]byte
    local pid_count: csize = 0
    local pid_value: cuint = (@cuint)(getpid())
    repeat
      pid_digits[pid_count] = (@byte)(48 + pid_value % 10)
      pid_count = pid_count + 1
      pid_value = pid_value // 10
    until pid_value == 0
    while pid_count > 0 do
      pid_count = pid_count - 1
      pathname[path_length] = pid_digits[pid_count]
      path_length = path_length + 1
    end
    pathname[path_length] = 45
    path_length = path_length + 1
    local sequence_digits: [24]byte
    local sequence_count: csize = 0
    repeat
      sequence_digits[sequence_count] = (@byte)(48 + sequence % 10)
      sequence_count = sequence_count + 1
      sequence = sequence // 10
    until sequence == 0
    while sequence_count > 0 do
      sequence_count = sequence_count - 1
      pathname[path_length] = sequence_digits[sequence_count]
      path_length = path_length + 1
    end
    pathname[path_length] = 0

    local stream: *FILE = fopen((@*[0]cchar)(&pathname[0]), 'w+xe'_cstring)
    if stream ~= nilptr then
      if unlinkat(-100, (@pointer)(&pathname[0]), 0) == 0 then return stream end
      local saved_errno: cint = nelibc_errno_location()[0]
      close(stream.fd)
      stream_list_lock()
      if all_streams == stream then
        all_streams = stream.next
      else
        local previous: *FILE = all_streams
        while previous ~= nilptr and previous.next ~= stream do previous = previous.next end
        if previous ~= nilptr then previous.next = stream.next end
      end
      stream_list_unlock()
      nelibc_free((@pointer)(stream))
      nelibc_errno_location()[0] = saved_errno
      return nilptr
    end
    if nelibc_errno_location()[0] ~= 17 then
      unlinkat(-100, (@pointer)(&pathname[0]), 0)
      return nilptr
    end -- EEXIST
    attempt = attempt + 1
  end
  nelibc_errno_location()[0] = 17 -- EEXIST
  return nilptr
end

local function close_stream(stream: *FILE, release_stream: boolean): cint
  if stream == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  stream_list_lock()
  stream_lock(stream)
  local result: cint = flush_write_buffer(stream)
  if stream.fd ~= -4 and stream.fd ~= -5 and close(stream.fd) < 0 then result = -1 end
  local owned_buffer: pointer = nilptr
  if stream.fd == -5 then
    if flush_write_buffer(stream) < 0 then result = -1 end
  elseif (stream.flags & MEMORY_OWNED) ~= 0 then
    owned_buffer = (@pointer)(stream.user_buffer)
  end
  stream_unlock(stream)
  stream.fd = -1
  stream.flags = 0
  stream.pushback_value = 0
  stream.has_pushback = 0
  stream.read_position = 0
  stream.read_length = 0
  stream.write_length = 0
  stream.buffer_size = 0
  stream.user_buffer = nilptr
  stream.memstream_buffer = nilptr
  stream.memstream_size = nilptr
  if release_stream and stream ~= &stdin_FILE and stream ~= &stdout_FILE and stream ~= &stderr_FILE then
    local previous: *FILE = nilptr
    local cursor: *FILE = all_streams
    while cursor ~= nilptr do
      if cursor == stream then
        if previous == nilptr then all_streams = cursor.next else previous.next = cursor.next end
        break
      end
      previous = cursor
      cursor = cursor.next
    end
  end
  stream_list_unlock()
  if owned_buffer ~= nilptr then nelibc_free(owned_buffer) end
  if release_stream and stream ~= &stdin_FILE and stream ~= &stdout_FILE and stream ~= &stderr_FILE then
    nelibc_free((@pointer)(stream))
  end
  return result
end

local function fclose(stream: *FILE): cint <cexport, codename 'fclose'>
  return close_stream(stream, true)
end

local function freopen(pathname: *[0]cchar <const>, mode: *[0]cchar <const>, stream: *FILE): *FILE <cexport, codename 'freopen'>
  if stream == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  if pathname == nilptr or mode == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    local saved_errno: cint = nelibc_errno_location()[0]
    close_stream(stream, true)
    nelibc_errno_location()[0] = saved_errno
    return nilptr
  end

  -- freopen closes the old association even if opening the replacement fails.
  close_stream(stream, false)
  local replacement: *FILE = fopen(pathname, mode)
  if replacement == nilptr then
    local saved_errno: cint = nelibc_errno_location()[0]
    close_stream(stream, true)
    nelibc_errno_location()[0] = saved_errno
    return nilptr
  end

  stream_list_lock()
  stream_lock(stream)
  stream_lock(replacement)
  local previous: *FILE = nilptr
  local cursor: *FILE = all_streams
  while cursor ~= nilptr and cursor ~= replacement do
    previous = cursor
    cursor = cursor.next
  end
  if cursor == replacement then
    if previous == nilptr then all_streams = replacement.next
    else previous.next = replacement.next end
  end
  local old_next: *FILE = stream.next
  local old_lock_word: cint = stream.lock_word
  local old_lock_owner: cint = stream.lock_owner
  local old_lock_depth: cint = stream.lock_depth
  memcpy((@pointer)(stream), (@pointer)(replacement), (@csize)(#FILE))
  stream.next = old_next
  stream.lock_word = old_lock_word
  stream.lock_owner = old_lock_owner
  stream.lock_depth = old_lock_depth
  stream_unlock(replacement)
  nelibc_stdio_unlock(&stream.lock_word, &stream.lock_owner, &stream.lock_depth)
  nelibc_free((@pointer)(replacement))
  stream_list_unlock()
  return stream
end

local function discard_read_buffer(stream: *FILE): cint <inline>
  if stream.fd == -4 or stream.fd == -5 then
    stream.has_pushback = 0
    stream.flags = stream.flags & ~LAST_READ
    return 0
  end
  local unread: csize = stream.read_length - stream.read_position
  if stream.has_pushback ~= 0 then unread = unread + 1 end
  if unread ~= 0 and lseek(stream.fd, -(@clong)(unread), 1) < 0 then
    stream.flags = stream.flags | STREAM_ERROR
    return -1
  end
  stream.read_position = 0
  stream.read_length = 0
  stream.has_pushback = 0
  stream.flags = stream.flags & ~LAST_READ
  return 0
end

local function setvbuf(stream: *FILE, buffer: pointer, mode: cint, size: csize): cint <cexport, codename 'setvbuf'>
  if stream == nilptr or (mode ~= 0 and mode ~= 1 and mode ~= 2) then return 1 end
  if mode ~= 2 and buffer ~= nilptr and size == 0 then return 1 end
  stream_lock(stream)
  if stream.fd < 0 then
    nelibc_errno_location()[0] = 9 -- EBADF
    stream_unlock(stream)
    return 1
  end
  if (stream.flags & LAST_WRITE) ~= 0 then
    if flush_write_buffer(stream) < 0 then stream_unlock(stream); return 1 end
  elseif (stream.flags & LAST_READ) ~= 0 or stream.has_pushback ~= 0 then
    if discard_read_buffer(stream) < 0 then stream_unlock(stream); return 1 end
  end
  stream.flags = stream.flags & ~(LINE_BUFFERED | UNBUFFERED)
  if mode == 2 then
    stream.user_buffer = nilptr
    stream.buffer_size = 1
    stream.flags = stream.flags | UNBUFFERED
  elseif buffer ~= nilptr then
    stream.user_buffer = (@*byte)(buffer)
    stream.buffer_size = size
    if mode == 1 then stream.flags = stream.flags | LINE_BUFFERED end
  else
    stream.user_buffer = nilptr
    stream.buffer_size = 4096
    if size ~= 0 and size < 4096 then stream.buffer_size = size end
    if mode == 1 then stream.flags = stream.flags | LINE_BUFFERED end
  end
  stream_unlock(stream)
  return 0
end

local function setbuf(stream: *FILE, buffer: *cchar): void <cexport, codename 'setbuf'>
  if buffer == nilptr then
    setvbuf(stream, nilptr, 2, 4096)
  else
    setvbuf(stream, (@pointer)(buffer), 0, 4096)
  end
end

local function setbuffer(stream: *FILE, buffer: *cchar, size: csize): void
    <cexport, codename 'setbuffer'>
  if buffer == nilptr then setvbuf(stream, nilptr, 2, 4096)
  else setvbuf(stream, (@pointer)(buffer), 0, size) end
end

local function setlinebuf(stream: *FILE): void <cexport, codename 'setlinebuf'>
  setvbuf(stream, nilptr, 1, 0)
end

local function emit_bytes(stream: *FILE, bytes: pointer <const>, count: csize): csize <inline>
  return write_bytes(stream, bytes, count)
end

local function emit_padding(stream: *FILE, value: byte, count: csize): csize <inline>
  local total: csize = 0
  while total < count do
    local byte_value: byte = value
    if write_bytes(stream, (@pointer)(&byte_value), 1) ~= 1 then return total end
    total = total + 1
  end
  return total
end

local function grouping_separator_count(digit_count: csize): csize <inline>
  local remaining: csize = digit_count
  local groups: cint = 0
  local separators: csize = 0
  while (@csize)(groups) < digit_count do
    local group_size: cint = nelibc_grouping_size(groups)
    if group_size <= 0 or remaining <= (@csize)(group_size) then break end
    remaining = remaining - (@csize)(group_size)
    separators = separators + 1
    groups = groups + 1
  end
  return separators
end

local function vfprintf(stream: *FILE, format: *[0]cchar <const>, arguments: cvalist): cint <cexport, codename 'vfprintf'>
  if stream == nilptr or format == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  stream_lock(stream)
  local written: csize = 0
  local index: csize = 0
  while format[index] ~= 0 do
    if format[index] ~= 37 then
      local start: csize = index
      while format[index] ~= 0 and format[index] ~= 37 do index = index + 1 end
      local length: csize = index - start
      local data: pointer <const> = (@pointer)((@usize)(format) + start)
      local result: csize = emit_bytes(stream, data, length)
      written = written + result
      if result ~= length then stream_unlock(stream); return -1 end
      continue
    end
    index = index + 1
    local left_align: boolean = false
    local plus_sign: boolean = false
    local space_sign: boolean = false
    local alternate: boolean = false
    local zero_pad: boolean = false
    local grouping_flag: boolean = false
    local flags_done: boolean = false
    while not flags_done do
      if format[index] == 45 then left_align = true
      elseif format[index] == 43 then plus_sign = true
      elseif format[index] == 32 then space_sign = true
      elseif format[index] == 35 then alternate = true
      elseif format[index] == 48 then zero_pad = true
      elseif format[index] == 39 then grouping_flag = true
      else flags_done = true end
      if not flags_done then index = index + 1 end
    end
    local width: cint = 0
    if format[index] == 42 then
      width = nelibc_va_arg_int(arguments)
      index = index + 1
      if width < 0 then left_align = true; width = -width end
    else
      while format[index] >= 48 and format[index] <= 57 do
        if width > 100000 then
          nelibc_errno_location()[0] = 75 -- EOVERFLOW
          stream_unlock(stream)
          return -1
        end
        width = width * 10 + (@cint)(format[index] - 48)
        index = index + 1
      end
    end
    local precision: cint = 0
    local precision_set: boolean = false
    if format[index] == 46 then
      precision_set = true
      index = index + 1
      if format[index] == 42 then
        precision = nelibc_va_arg_int(arguments)
        if precision < 0 then precision_set = false; precision = 0 end
        index = index + 1
      else
        while format[index] >= 48 and format[index] <= 57 do
          if precision > 100000 then
            nelibc_errno_location()[0] = 75 -- EOVERFLOW
            stream_unlock(stream)
            return -1
          end
          precision = precision * 10 + (@cint)(format[index] - 48)
          index = index + 1
        end
      end
    end
    local length_mod: cint = 0
    if format[index] == 108 then
      length_mod = 1
      index = index + 1
      if format[index] == 108 then length_mod = 2; index = index + 1 end
    elseif format[index] == 122 or format[index] == 106 or format[index] == 116 then
      length_mod = 3
      index = index + 1
    elseif format[index] == 104 then
      index = index + 1
      if format[index] == 104 then length_mod = 4; index = index + 1
