      break
    end
    output[index] = (@cint)(wide)
    index = index + 1
    if wide == 10 then break end
  end
  output[index] = 0
  return output
end

local function fgetws(output: *[0]cint, count: cint, stream: *FILE): *[0]cint
    <cexport, codename 'fgetws'>
  stream_lock(stream)
  local result = fgetws_unlocked(output, count, stream)
  stream_unlock(stream)
  return result
end

local function fputws_unlocked(input: *[0]cint <const>, stream: *FILE): cint
    <cexport, codename 'fputws_unlocked'>
