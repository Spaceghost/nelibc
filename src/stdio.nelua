## pragmas.nogc = true
## pragmas.noentrypoint = true
-- Standalone stdio uses Nelibc's FILE type; its replacements intentionally
-- do not include the host's stdio declarations.
## cinclude [[#if defined(__clang__)]]
## cinclude [[#pragma clang diagnostic ignored "-Wbuiltin-requires-header"]]
## cinclude [[#endif]]

require 'C.stdarg'


local function nelibc_va_arg_int(arguments: cvalist): cint <cimport> end
local function nelibc_va_arg_pointer(arguments: cvalist): pointer <cimport> end
local function nelibc_va_arg_long(arguments: cvalist): clong <cimport> end
local function nelibc_va_arg_long_long(arguments: cvalist): clonglong <cimport> end
local function nelibc_va_arg_unsigned_long(arguments: cvalist): culong <cimport> end
local function nelibc_va_arg_unsigned_long_long(arguments: cvalist): culonglong <cimport> end
local function nelibc_va_arg_size(arguments: cvalist): csize <cimport> end
local function nelibc_va_arg_unsigned_int(arguments: cvalist): cuint <cimport> end
local function nelibc_va_arg_double(arguments: cvalist): cdouble <cimport> end
local function isspace(character: cint): cint <cimport> end
local function nelibc_scan_strtoll(text: *[0]cchar <const>, end_text: **cchar,
    base: cint): clonglong <cimport> end
local function nelibc_scan_strtoull(text: *[0]cchar <const>, end_text: **cchar,
    base: cint): culonglong <cimport> end
local function nelibc_scan_strtof(text: *[0]cchar <const>, end_text: **cchar): cfloat <cimport> end
local function nelibc_scan_strtod(text: *[0]cchar <const>, end_text: **cchar): cdouble <cimport> end
local function nelibc_scan_strtold(text: *[0]cchar <const>, end_text: **cchar): clongdouble <cimport> end
local function nelibc_va_copy(destination: cvalist, source: cvalist): void <cimport> end
local function nelibc_store_format_count(pointer: pointer, length: cint, count: csize): void <cimport> end

local DoubleBits: type = @union{bits: culonglong, value: cdouble}
local function nelibc_double_bits(value: cdouble): culonglong <inline>
  local representation: DoubleBits = {value = value}
  return representation.bits
end

local function write(fd: cint, buffer: pointer <const>, count: csize): clong <cimport> end
local function read(fd: cint, buffer: pointer, count: csize): clong <cimport> end
local function nelibc_errno_location(): *[0]cint <cimport> end
local function nelibc_radix_character(): cint <cimport> end
local function nelibc_format_fixed_double(value: cdouble, precision: cint,
    radix: cint, output: *[0]byte, capacity: csize): csize <cimport> end
local function nelibc_round_significant_double(value: cdouble, decimal_scale: cint,
    result: *[0]culonglong): cint <cimport> end
local function nelibc_format_general_double(value: cdouble, precision: cint,
    exponent: cint, alternate: cint, uppercase: cint, radix: cint,
    output: *[0]byte, capacity: csize): csize <cimport> end
local function nelibc_grouping_size(position: cint): cint <cimport> end
local function nelibc_grouping_separator_length(): cint <cimport> end
local function nelibc_grouping_separator_byte(index: cint): cint <cimport> end
local function openat(dirfd: cint, pathname: pointer <const>, flags: cint, mode: cuint): cint <cimport> end
local function unlinkat(dirfd: cint, pathname: pointer <const>, flags: cint): cint <cimport> end
local function getpid(): cint <cimport> end
local function nelibc_raw_fcntl(fd: cint, command: cint, argument: culong): cint <cimport> end
local function close(fd: cint): cint <cimport> end
local function nelibc_malloc(size: csize): pointer <cimport> end
local function nelibc_realloc(ptr: pointer, size: csize): pointer <cimport> end
local function nelibc_free(ptr: pointer): void <cimport> end
local function nelibc_stdio_lock(word: *cint, owner: *cint, depth: *cint): void <cimport> end
local function nelibc_stdio_trylock(word: *cint, owner: *cint, depth: *cint): cint <cimport> end
local function nelibc_stdio_unlock(word: *cint, owner: *cint, depth: *cint): void <cimport> end
local function nelibc_host_format_write(stream: pointer, buffer: pointer <const>, count: csize): csize <cimport> end
local function memcpy(dest: pointer, src: pointer <const>, n: csize): pointer <cimport> end
local function memmove(dest: pointer, src: pointer <const>, n: csize): pointer <cimport> end
local function memset(dest: pointer, value: cint, n: csize): pointer <cimport> end
local function mbrtowc(wide: *cint, input: *[0]cchar <const>, count: csize,
    state: pointer): csize <cimport> end
local function wcrtomb(output: *[0]cchar, wide: cint, state: pointer): csize <cimport> end
local function wcsrtombs(output: *[0]cchar, input: *[0]*[0]cint,
    count: csize, state: pointer): csize <cimport> end
local function wcsnrtombs(output: *[0]cchar, input: *[0]*[0]cint,
    input_count: csize, output_count: csize, state: pointer): csize <cimport> end
local function mbsrtowcs(output: *[0]cint, input: *[0]*[0]cchar,
    count: csize, state: pointer): csize <cimport> end
local function iswspace(wide: cint): cint <cimport> end
local function wcstoll(text: *[0]cint <const>, end_text: **cint, base: cint): clonglong <cimport> end
local function wcstoull(text: *[0]cint <const>, end_text: **cint, base: cint): culonglong <cimport> end
local function wcstof(text: *[0]cint <const>, end_text: **cint): cfloat <cimport> end
local function wcstod(text: *[0]cint <const>, end_text: **cint): cdouble <cimport> end
local function wcstold(text: *[0]cint <const>, end_text: **cint): clongdouble <cimport> end

-- Standalone FILE ABI. Keep this record in sync with
-- include/nelibc_stdio_standalone.h.
local FILE: type = @record{
  fd: cint,
  flags: cuint,
  pushback_value: cint,
  has_pushback: cint,
  read_position: csize,
  read_length: csize,
  write_length: csize,
  lock_word: cint,
  lock_owner: cint,
  lock_depth: cint,
  buffer_size: csize,
  user_buffer: *byte,
  next: *FILE,
  buffer: [4096]byte,
  memstream_buffer: **byte,
  memstream_size: *csize,
  orientation: cint,
  wide_read_state: [16]culong,
  wide_write_state: [16]culong,
  has_wide_pushback: cint,
  wide_pushback_value: cint
}

local stderr_FILE: FILE <cexport, codename 'nelibc_stderr_FILE'> = {
  fd = 0, flags = 0, pushback_value = 0, has_pushback = 0, next = nilptr
}
local stdout_FILE: FILE <cexport, codename 'nelibc_stdout_FILE'> = {
  fd = 0, flags = 0, pushback_value = 0, has_pushback = 0, next = nilptr
}
local stdin_FILE: FILE <cexport, codename 'nelibc_stdin_FILE'> = {
  fd = 0, flags = 0, pushback_value = 0, has_pushback = 0, next = nilptr
}
local all_streams: *FILE = &stdin_FILE
local stream_list_lock_word: cint = 0
local stream_list_lock_owner: cint = 0
local stream_list_lock_depth: cint = 0
local tmpfile_sequence: culonglong = 0

local STREAM_EOF: cuint <comptime> = 1
local STREAM_ERROR: cuint <comptime> = 2
local MAX_CSIZE: csize <comptime> = ~0_csize
local READABLE: cuint <comptime> = 4
local WRITABLE: cuint <comptime> = 8
local LINE_BUFFERED: cuint <comptime> = 16
local UNBUFFERED: cuint <comptime> = 32
local LAST_WRITE: cuint <comptime> = 64
local LAST_READ: cuint <comptime> = 128
local MEMORY_OWNED: cuint <comptime> = 256
local MEMORY_APPEND: cuint <comptime> = 512
local WIDE_FORMAT: cuint <comptime> = 1024
local FORMAT_COUNT_ONLY: cuint <comptime> = 2048
local function lseek(fd: cint, offset: clong, whence: cint): clong <cimport> end
local function stream_lock(stream: *FILE): void <inline>
  if stream.fd == -2 or stream.fd == -3 or stream.fd == -6 then return end
  nelibc_stdio_lock(&stream.lock_word, &stream.lock_owner, &stream.lock_depth)
end
local function stream_unlock(stream: *FILE): void <inline>
  if stream.fd == -2 or stream.fd == -3 or stream.fd == -6 then return end
  nelibc_stdio_unlock(&stream.lock_word, &stream.lock_owner, &stream.lock_depth)
end
local function stream_list_lock(): void <inline>
  nelibc_stdio_lock(&stream_list_lock_word, &stream_list_lock_owner, &stream_list_lock_depth)
end
local function stream_list_unlock(): void <inline>
  nelibc_stdio_unlock(&stream_list_lock_word, &stream_list_lock_owner, &stream_list_lock_depth)
end
local function nelibc_stdio_fork_prepare(): void <cexport, codename 'nelibc_stdio_fork_prepare'>
  stream_list_lock()
  local stream = all_streams
  while stream ~= nilptr do
    stream_lock(stream)
    stream = stream.next
  end
end
local function nelibc_stdio_fork_parent(): void <cexport, codename 'nelibc_stdio_fork_parent'>
  local stream = all_streams
  while stream ~= nilptr do
    stream_unlock(stream)
    stream = stream.next
  end
  stream_list_unlock()
end
local function nelibc_stdio_fork_child(): void <cexport, codename 'nelibc_stdio_fork_child'>
  local stream = all_streams
  while stream ~= nilptr do
    stream.lock_word = 0
    stream.lock_owner = 0
    stream.lock_depth = 0
    stream = stream.next
  end
  stream_list_lock_word = 0
  stream_list_lock_owner = 0
  stream_list_lock_depth = 0
end
local function stream_buffer(stream: *FILE): pointer <inline>
  if stream.user_buffer == nilptr then return (@pointer)(&stream.buffer[0]) end
  return (@pointer)(stream.user_buffer)
end

local function nelibc_stdio_init(): void <cexport, codename 'nelibc_stdio_init'>
  stderr_FILE.fd = 2
  stderr_FILE.flags = WRITABLE | UNBUFFERED
  stderr_FILE.buffer_size = 1
  stderr_FILE.user_buffer = nilptr
  stderr_FILE.next = nilptr
  stdout_FILE.fd = 1
  stdout_FILE.flags = WRITABLE | LINE_BUFFERED
  stdout_FILE.buffer_size = 4096
  stdout_FILE.user_buffer = nilptr
  stdout_FILE.next = &stderr_FILE
  stdin_FILE.fd = 0
  stdin_FILE.flags = READABLE
  stdin_FILE.buffer_size = 4096
  stdin_FILE.user_buffer = nilptr
  stdin_FILE.next = &stdout_FILE
  all_streams = &stdin_FILE
end

local function flush_write_buffer(stream: *FILE): cint <inline>
  if stream.fd == -7 then
    local memory: *[0]cint = (@*[0]cint)(stream.user_buffer)
    local published_buffer: *[0]*[0]cint = (@*[0]*[0]cint)(stream.memstream_buffer)
    local published_size: *[0]csize = (@*[0]csize)(stream.memstream_size)
    memory[stream.read_length] = 0
    published_buffer[0] = (@*[0]cint)(stream.user_buffer)
    published_size[0] = stream.read_length
    stream.write_length = 0
    return 0
  end
  if stream.fd == -5 then
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    local published_buffer: *[0]*byte = (@*[0]*byte)(stream.memstream_buffer)
    local published_size: *[0]csize = (@*[0]csize)(stream.memstream_size)
    memory[stream.read_length] = 0
    published_buffer[0] = stream.user_buffer
    published_size[0] = stream.read_length
    stream.write_length = 0
    return 0
  end
  if stream.fd == -4 then
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    if stream.read_position < stream.buffer_size then
      memory[stream.read_position] = 0
    end
    stream.write_length = 0
    return 0
  end
  local offset: csize = 0
  while offset < stream.write_length do
    local chunk: pointer = (@pointer)((@usize)(stream_buffer(stream)) + offset)
    local result: clong = write(stream.fd, chunk, stream.write_length - offset)
    if result <= 0 then
      stream.flags = stream.flags | STREAM_ERROR
      if offset ~= 0 then
        memmove(stream_buffer(stream), chunk, stream.write_length - offset)
        stream.write_length = stream.write_length - offset
      end
      return -1
    end
    offset = offset + (@csize)(result)
  end
  stream.write_length = 0
  return 0
end

local function read_bytes(stream: *FILE, buffer: pointer, count: csize): csize <inline>
  if (stream.flags & READABLE) == 0 then
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  if (stream.flags & LAST_WRITE) ~= 0 and flush_write_buffer(stream) < 0 then return 0 end
  stream.flags = (stream.flags & ~LAST_WRITE) | LAST_READ
  local destination: *[0]byte = (@*[0]byte)(buffer)
  local offset: csize = 0
  if count ~= 0 and stream.has_pushback ~= 0 then
    destination[0] = (@byte)(stream.pushback_value)
    stream.has_pushback = 0
    offset = 1
  end
  if stream.fd == -4 or stream.fd == -5 then
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    while offset < count do
      if stream.read_position >= stream.read_length then
        stream.flags = stream.flags | STREAM_EOF
        break
      end
      local available: csize = stream.read_length - stream.read_position
      local wanted: csize = count - offset
      local amount: csize = available
      if amount > wanted then amount = wanted end
      local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
      local source: pointer <const> = (@pointer)((@usize)(stream.user_buffer) + stream.read_position)
      memcpy(cursor, source, amount)
      stream.read_position = stream.read_position + amount
      offset = offset + amount
    end
    return offset
  end
  while offset < count do
    if stream.read_position == stream.read_length then
      local result: clong = read(stream.fd, stream_buffer(stream), stream.buffer_size)
      if result < 0 then
        stream.flags = stream.flags | STREAM_ERROR
        break
      elseif result == 0 then
        stream.flags = stream.flags | STREAM_EOF
        break
      end
      stream.read_position = 0
      stream.read_length = (@csize)(result)
    end
    local available: csize = stream.read_length - stream.read_position
    local wanted: csize = count - offset
    local amount: csize = available
    if amount > wanted then amount = wanted end
    local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
    local source: pointer <const> = (@pointer)((@usize)(stream_buffer(stream)) + stream.read_position)
    memcpy(cursor, source, amount)
    stream.read_position = stream.read_position + amount
    offset = offset + amount
  end
  return offset
end

local function write_bytes(stream: *FILE, buffer: pointer <const>, count: csize): csize <inline>
  if (stream.flags & WRITABLE) == 0 then
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  if stream.fd == -7 then
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  if stream.fd == -6 then
    local written: csize = nelibc_host_format_write((@pointer)(stream.user_buffer), buffer, count)
    if written ~= count then stream.flags = stream.flags | STREAM_ERROR end
    return written
  end
  if stream.fd == -2 then
    local copied: csize = 0
    if stream.buffer_size > 0 and stream.write_length < stream.buffer_size - 1 then
      copied = stream.buffer_size - 1 - stream.write_length
      if copied > count then copied = count end
      local destination: pointer = (@pointer)((@usize)(stream.user_buffer) + stream.write_length)
      memcpy(destination, buffer, copied)
    end
    stream.write_length = stream.write_length + count
    return count
  end
  if stream.fd == -3 then
    local offset: csize = 0
    local output_fd: cint = (@cint)(stream.read_position)
    while offset < count do
      local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
      local result: clong = write(output_fd, cursor, count - offset)
      if result <= 0 then
        stream.flags = stream.flags | STREAM_ERROR
        break
      end
      offset = offset + (@csize)(result)
    end
    return offset
  end
  if stream.fd == -5 then
    local needed: csize = stream.read_position + count
    if needed < stream.read_position or needed == MAX_CSIZE then
      stream.flags = stream.flags | STREAM_ERROR
      nelibc_errno_location()[0] = 75 -- EOVERFLOW
      return 0
    end
    needed = needed + 1
    if needed > stream.buffer_size then
      local capacity: csize = stream.buffer_size
      while capacity < needed and capacity <= MAX_CSIZE // 2 do capacity = capacity * 2 end
      if capacity < needed then capacity = needed end
      local grown: pointer = nelibc_realloc((@pointer)(stream.user_buffer), capacity)
      if grown == nilptr then stream.flags = stream.flags | STREAM_ERROR; return 0 end
      stream.user_buffer = (@*byte)(grown)
      stream.buffer_size = capacity
    end
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    stream.flags = (stream.flags & ~LAST_READ) | LAST_WRITE
    local gap: csize = stream.read_length
    while gap < stream.read_position do
      memory[gap] = 0
      gap = gap + 1
    end
    memcpy((@pointer)((@usize)(stream.user_buffer) + stream.read_position), buffer, count)
    stream.read_position = stream.read_position + count
    if stream.read_position > stream.read_length then stream.read_length = stream.read_position end
    memory[stream.read_length] = 0
    return count
  end
  if stream.fd == -4 then
    local memory: *[0]byte = (@*[0]byte)(stream.user_buffer)
    if (stream.flags & MEMORY_APPEND) ~= 0 then stream.read_position = stream.read_length end
    stream.flags = (stream.flags & ~LAST_READ) | LAST_WRITE
    local amount: csize = count
    if stream.read_position >= stream.buffer_size then
      amount = 0
    elseif amount > stream.buffer_size - stream.read_position then
      amount = stream.buffer_size - stream.read_position
    end
    if amount ~= 0 then
      local destination: pointer = (@pointer)((@usize)(stream.user_buffer) + stream.read_position)
      memcpy(destination, buffer, amount)
      stream.read_position = stream.read_position + amount
      if stream.read_position > stream.read_length then stream.read_length = stream.read_position end
      if stream.read_position < stream.buffer_size then memory[stream.read_position] = 0 end
    end
    if amount ~= count then stream.flags = stream.flags | STREAM_ERROR end
    return amount
  end
  local unread: csize = 0
  if (stream.flags & LAST_READ) ~= 0 then
    unread = stream.read_length - stream.read_position
    if stream.has_pushback ~= 0 then unread = unread + 1 end
  end
  if unread ~= 0 then
    if lseek(stream.fd, -(@clong)(unread), 1) < 0 then
      stream.flags = stream.flags | STREAM_ERROR
      return 0
    end
    stream.read_position = 0
    stream.read_length = 0
    stream.has_pushback = 0
  end
  stream.flags = (stream.flags & ~LAST_READ) | LAST_WRITE
  local offset: csize = 0
  while offset < count do
    if (stream.flags & UNBUFFERED) ~= 0 then
      local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
      local result: clong = write(stream.fd, cursor, count - offset)
      if result <= 0 then stream.flags = stream.flags | STREAM_ERROR; break end
      offset = offset + (@csize)(result)
    else
      local space: csize = stream.buffer_size - stream.write_length
      local amount: csize = count - offset
      if amount > space then amount = space end
      local cursor: pointer = (@pointer)((@usize)(buffer) + offset)
      local destination: pointer = (@pointer)((@usize)(stream_buffer(stream)) + stream.write_length)
      memcpy(destination, cursor, amount)
      stream.write_length = stream.write_length + amount
      offset = offset + amount
      local flush_now: boolean = stream.write_length == stream.buffer_size
      if (stream.flags & LINE_BUFFERED) ~= 0 then
        local input: *[0]byte = (@*[0]byte)(buffer)
        local j: csize = offset - amount
        while j < offset do
          if input[j] == 10 then flush_now = true end
          j = j + 1
        end
      end
      if flush_now and flush_write_buffer(stream) < 0 then break end
    end
  end
  return offset
end

local function stream_orient(stream: *FILE, orientation: cint): cint <inline>
  if stream.orientation == 0 and orientation ~= 0 then stream.orientation = orientation end
  return stream.orientation
end

local function reset_wide_stream_state(stream: *FILE): void <inline>
  local state_size: csize = 16_csize * (@csize)(#culong)
  memset((@pointer)(&stream.wide_read_state[0]), 0, state_size)
  memset((@pointer)(&stream.wide_write_state[0]), 0, state_size)
  stream.has_wide_pushback = 0
end

local function read_char_unoriented(stream: *FILE): cint <inline>
  local value: byte = 0
  if read_bytes(stream, (@pointer)(&value), 1) ~= 1 then return -1 end
  return (@cint)(value)
end

local function fgetc(stream: *FILE): cint <cexport, codename 'fgetc'>
  stream_lock(stream)
  stream_orient(stream, -1)
  local result: cint = read_char_unoriented(stream)
  stream_unlock(stream)
  return result
end

local function fgetc_unlocked(stream: *FILE): cint <inline>
  stream_orient(stream, -1)
  return read_char_unoriented(stream)
end

local function scan_read_wide_unlocked(stream: *FILE, state: pointer,
    wide: *[0]cint, byte_count: *[0]csize): cint <inline>
  while true do
    local character: cint = fgetc_unlocked(stream)
    if character == -1 then return 0 end
    byte_count[0] = byte_count[0] + 1
    local byte: cchar = (@cchar)(character)
    local converted: csize = mbrtowc(wide, &byte, 1, state)
    if converted == ~0_csize then
      nelibc_errno_location()[0] = 84 -- EILSEQ
      return -1
    end
    if converted == ~1_csize then continue end
    return 1
  end
end

local function ungetc_unlocked(character: cint, stream: *FILE): cint <inline>
  stream_orient(stream, -1)
  if character == -1 or stream.has_pushback ~= 0 or (stream.flags & READABLE) == 0 then return -1 end
  stream.pushback_value = character & 255
  stream.has_pushback = 1
  stream.flags = stream.flags | LAST_READ
  stream.flags = stream.flags & ~STREAM_EOF
  return character & 255
end

local function fwide(stream: *FILE, mode: cint): cint <cexport, codename 'fwide'>
  if stream == nilptr then return 0 end
  stream_lock(stream)
  local result: cint = stream.orientation
  if mode > 0 then result = stream_orient(stream, 1)
  elseif mode < 0 then result = stream_orient(stream, -1) end
  stream_unlock(stream)
  return result
end

local function fgetwc_unlocked(stream: *FILE): cuint <cexport, codename 'fgetwc_unlocked'>
  if stream_orient(stream, 1) < 0 then return ~0_cuint end
  if stream.has_wide_pushback ~= 0 then
    stream.has_wide_pushback = 0
    return (@cuint)(stream.wide_pushback_value)
  end
  local state: pointer = (@pointer)(&stream.wide_read_state[0])
  local input: [1]cchar = {}
  local wide: cint = 0
  while true do
    local value: cint = read_char_unoriented(stream)
    if value < 0 then return ~0_cuint end
    input[0] = (@cchar)(value)
    local converted: csize = mbrtowc(&wide, &input[0], 1, state)
    if converted == ~0_csize then return ~0_cuint end
    if converted ~= ~1_csize then return (@cuint)(wide) end
  end
end

local function fgetwc(stream: *FILE): cuint <cexport, codename 'fgetwc'>
  stream_lock(stream)
  local result: cuint = fgetwc_unlocked(stream)
  stream_unlock(stream)
  return result
end

local function ungetwc(wide: cuint, stream: *FILE): cuint <cexport, codename 'ungetwc'>
  stream_lock(stream)
  if wide == ~0_cuint or (stream.flags & READABLE) == 0 or
      stream_orient(stream, 1) < 0 or stream.has_wide_pushback ~= 0 then
    stream_unlock(stream)
    return ~0_cuint
  end
  stream.wide_pushback_value = (@cint)(wide)
  stream.has_wide_pushback = 1
  stream.flags = stream.flags & 0xFFFFFFFE_cuint
  stream_unlock(stream)
  return wide
end

local function getwc(stream: *FILE): cuint <cexport, codename 'getwc'>
  return fgetwc(stream)
end

local function getwc_unlocked(stream: *FILE): cuint <cexport, codename 'getwc_unlocked'>
  return fgetwc_unlocked(stream)
end

local function getwchar(): cuint <cexport, codename 'getwchar'>
