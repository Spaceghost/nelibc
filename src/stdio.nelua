local function fscanf(stream: *FILE, format: *[0]cchar <const>, ...: cvarargs): cint
    <cexport, codename 'fscanf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vfscanf(stream, format, arguments)
  C.va_end(arguments)
  return result
end

local function vscanf(format: *[0]cchar <const>, arguments: cvalist): cint
    <cexport, codename 'vscanf'>
  return vfscanf(&stdin_FILE, format, arguments)
end

local function scanf(format: *[0]cchar <const>, ...: cvarargs): cint
    <cexport, codename 'scanf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vscanf(format, arguments)
  C.va_end(arguments)
  return result
end

local function fwscanf(stream: *FILE, format: *[0]cint <const>, ...: cvarargs): cint
    <cexport, codename 'fwscanf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vfwscanf(stream, format, arguments)
  C.va_end(arguments)
  return result
end

local function vwscanf(format: *[0]cint <const>, arguments: cvalist): cint
    <cexport, codename 'vwscanf'>
  return vfwscanf(&stdin_FILE, format, arguments)
end

local function wscanf(format: *[0]cint <const>, ...: cvarargs): cint
    <cexport, codename 'wscanf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vwscanf(format, arguments)
  C.va_end(arguments)
  return result
end


local function getc(stream: *FILE): cint <cexport, codename 'getc'>
  return fgetc(stream)
end

local function getdelim(line_pointer: *[0]*[0]cchar, capacity_pointer: *[0]csize, delimiter: cint, stream: *FILE): clong <cexport, codename 'getdelim'>
  if line_pointer == nilptr or capacity_pointer == nilptr or stream == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local capacity: csize = capacity_pointer[0]
  local line: *[0]cchar = line_pointer[0]
  if line == nilptr or capacity == 0 then
    capacity = 128
    local replacement: pointer = nelibc_realloc((@pointer)(line), capacity)
    if replacement == nilptr then return -1 end
    line = (@*[0]cchar)(replacement)
    line_pointer[0] = line
    capacity_pointer[0] = capacity
  end
  local length: csize = 0
  local delimiter_byte: byte = (@byte)(delimiter)
  while true do
    if length >= capacity - 1 then
      if capacity > MAX_CSIZE // 2 then
        nelibc_errno_location()[0] = 75 -- EOVERFLOW
        return -1
      end
      local new_capacity: csize = capacity * 2
      local replacement: pointer = nelibc_realloc((@pointer)(line), new_capacity)
      if replacement == nilptr then
        if length == 0 then return -1 end
        break
      end
      line = (@*[0]cchar)(replacement)
      line_pointer[0] = line
      capacity = new_capacity
      capacity_pointer[0] = capacity
    end
    local character: cint = fgetc(stream)
    if character == -1 then break end
    line[length] = (@cchar)(character)
    length = length + 1
    if (@byte)(character) == delimiter_byte then break end
  end
  if length == 0 then return -1 end
  line[length] = 0
  if length > 9223372036854775807_csize then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    return -1
  end
  return (@clong)(length)
end

local function getline(line_pointer: *[0]*[0]cchar, capacity_pointer: *[0]csize, stream: *FILE): clong <cexport, codename 'getline'>
  return getdelim(line_pointer, capacity_pointer, 10, stream)
end

local function getchar(): cint <cexport, codename 'getchar'>
  return fgetc(&stdin_FILE)
end

local function getchar_unlocked(): cint <cexport, codename 'getchar_unlocked'>
  return fgetc_unlocked(&stdin_FILE)
end

local function fgets(buffer: *[0]cchar, count: cint, stream: *FILE): *[0]cchar <cexport, codename 'fgets'>
  if count <= 0 then return nilptr end
  local destination: *[0]byte = (@*[0]byte)(buffer)
  if count == 1 then
    destination[0] = 0
    return buffer
  end
  stream_lock(stream)
  local length: csize = 0
  local limit: csize = (@csize)(count - 1)
  while length < limit do
    local value: byte = 0
    if read_bytes(stream, (@pointer)(&value), 1) ~= 1 then break end
    destination[length] = value
    length = length + 1
    if value == 10 then break end
  end
  if length == 0 then
    stream_unlock(stream)
    return nilptr
  end
  destination[length] = 0
  stream_unlock(stream)
  return buffer
end

local function fgets_unlocked(buffer: *[0]cchar, count: cint, stream: *FILE): *[0]cchar
    <cexport, codename 'fgets_unlocked'>
  if count <= 0 then return nilptr end
  local destination: *[0]byte = (@*[0]byte)(buffer)
  if count == 1 then
    destination[0] = 0
    return buffer
  end
  local length: csize = 0
  local limit: csize = (@csize)(count - 1)
  while length < limit do
    local value: byte = 0
    if read_bytes(stream, (@pointer)(&value), 1) ~= 1 then break end
    destination[length] = value
    length = length + 1
    if value == 10 then break end
  end
  if length == 0 then return nilptr end
  destination[length] = 0
  return buffer
end

local function ungetc(character: cint, stream: *FILE): cint <cexport, codename 'ungetc'>
  stream_lock(stream)
  stream_orient(stream, -1)
  if character == -1 or stream.has_pushback ~= 0 or (stream.flags & READABLE) == 0 then stream_unlock(stream); return -1 end
  stream.pushback_value = character & 255
  stream.has_pushback = 1
  stream.flags = stream.flags | LAST_READ
  stream.flags = stream.flags & 0xFFFFFFFE_cuint
  stream_unlock(stream)
  return character & 255
end

local function fread(buffer: pointer, size: csize, count: csize, stream: *FILE): csize <cexport, codename 'fread'>
  if size == 0 or count == 0 then return 0 end
  if count > MAX_CSIZE // size then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  stream_lock(stream)
  stream_orient(stream, -1)
  local bytes_read = read_bytes(stream, buffer, size * count)
  stream_unlock(stream)
  return bytes_read // size
end

local function fwrite(buffer: pointer <const>, size: csize, count: csize, stream: *FILE): csize <cexport, codename 'fwrite'>
  if size == 0 or count == 0 then return 0 end
  if count > MAX_CSIZE // size then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    stream.flags = stream.flags | STREAM_ERROR
    return 0
  end
  stream_lock(stream)
  stream_orient(stream, -1)
  local bytes_written = write_bytes(stream, buffer, size * count)
  stream_unlock(stream)
  return bytes_written // size
end

local function fputc(character: cint, stream: *FILE): cint <cexport, codename 'fputc'>
  stream_lock(stream)
  stream_orient(stream, -1)
  local value: byte = (@byte)(character)
  if write_bytes(stream, (@pointer)(&value), 1) ~= 1 then stream_unlock(stream); return -1 end
  stream_unlock(stream)
  return (@cint)(value)
end

local function fputc_unlocked(character: cint, stream: *FILE): cint <inline>
  stream_orient(stream, -1)
  local value: byte = (@byte)(character)
  if write_bytes(stream, (@pointer)(&value), 1) ~= 1 then return -1 end
  return (@cint)(value)
end

local function fputs(string: cstring <const>, stream: *FILE): cint <cexport, codename 'fputs'>
  local string: *[0]cchar = (@*[0]cchar)(string)
  local bytes: *[0]byte = (@*[0]byte)(string)
  local length: csize = 0
  while bytes[length] ~= 0 do length = length + 1 end
  stream_lock(stream)
  stream_orient(stream, -1)
  if write_bytes(stream, (@pointer)(string), length) ~= length then stream_unlock(stream); return -1 end
  stream_unlock(stream)
  return 0
end

local function fputs_unlocked(string: *[0]cchar <const>, stream: *FILE): cint
    <cexport, codename 'fputs_unlocked'>
  local bytes: *[0]byte = (@*[0]byte)(string)
  local length: csize = 0
  while bytes[length] ~= 0 do length = length + 1 end
  stream_orient(stream, -1)
  if write_bytes(stream, (@pointer)(string), length) ~= length then return -1 end
  return 0
end

local function putchar(character: cint): cint <cexport, codename 'putchar'>
  return fputc(character, &stdout_FILE)
end

local function putchar_unlocked(character: cint): cint <cexport, codename 'putchar_unlocked'>
  return fputc_unlocked(character, &stdout_FILE)
end

local function puts(string: cstring <const>): cint <cexport, codename 'puts'>
  local string: *[0]cchar = (@*[0]cchar)(string)
  stream_lock(&stdout_FILE)
  if fputs(string, &stdout_FILE) == -1 or fputc(10, &stdout_FILE) == -1 then stream_unlock(&stdout_FILE); return -1 end
  stream_unlock(&stdout_FILE)
  return 0
end

local function feof(stream: *FILE): cint <cexport, codename 'feof'>
  stream_lock(stream)
  local result: cint = 0
  if (stream.flags & STREAM_EOF) ~= 0 then result = 1 end
  stream_unlock(stream)
  return result
end

local function ferror(stream: *FILE): cint <cexport, codename 'ferror'>
  stream_lock(stream)
  local result: cint = 0
  if (stream.flags & STREAM_ERROR) ~= 0 then result = 1 end
  stream_unlock(stream)
  return result
end

local function clearerr(stream: *FILE): void <cexport, codename 'clearerr'>
  stream_lock(stream)
  stream.flags = stream.flags & 0xFFFFFFFC_cuint
  stream_unlock(stream)
end

local function flockfile(stream: *FILE): void <cexport, codename 'flockfile'>
  stream_lock(stream)
end
local function ftrylockfile(stream: *FILE): cint <cexport, codename 'ftrylockfile'>
  return nelibc_stdio_trylock(&stream.lock_word, &stream.lock_owner, &stream.lock_depth)
end
local function funlockfile(stream: *FILE): void <cexport, codename 'funlockfile'>
  stream_unlock(stream)
end

local function remove(pathname: cstring <const>): cint <cexport, codename 'remove'>
  local pathname: *[0]cchar = (@*[0]cchar)(pathname)
  if pathname == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  if unlinkat(-100, pathname, 0) == 0 then return 0 end -- AT_FDCWD
  if nelibc_errno_location()[0] == 21 then -- EISDIR
    return unlinkat(-100, pathname, 512) -- AT_REMOVEDIR
  end
  return -1
end

local function fopen(pathname: cstring <const>, mode: cstring <const>): *FILE <cexport, codename 'fopen'>
  local pathname: *[0]cchar = (@*[0]cchar)(pathname)
  local mode: *[0]cchar = (@*[0]cchar)(mode)
  if pathname == nilptr or mode == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end

  local flags: cint = 0
  if mode[0] == 114 then -- 'r'
    flags = 0 -- O_RDONLY
  elseif mode[0] == 119 then -- 'w'
    flags = 1 | 64 | 512 -- O_WRONLY | O_CREAT | O_TRUNC
  elseif mode[0] == 97 then -- 'a'
    flags = 1 | 64 | 1024 -- O_WRONLY | O_CREAT | O_APPEND
  else
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end

  local plus_seen: boolean = false
  local exclusive_seen: boolean = false
  local close_on_exec_seen: boolean = false
  local index: csize = 1
  while mode[index] ~= 0 do
    if mode[index] == 98 then -- 'b'
      -- Binary mode is equivalent to text mode on Linux.
    elseif mode[index] == 43 then -- '+'
      if plus_seen then
        nelibc_errno_location()[0] = 22 -- EINVAL
        return nilptr
      end
      plus_seen = true
    elseif mode[index] == 120 then -- 'x'
      if exclusive_seen or mode[0] ~= 119 then -- 'w'
        nelibc_errno_location()[0] = 22 -- EINVAL
        return nilptr
      end
      exclusive_seen = true
      flags = flags | 128 -- O_EXCL
    elseif mode[index] == 101 then -- 'e'
      if close_on_exec_seen then
        nelibc_errno_location()[0] = 22 -- EINVAL
        return nilptr
      end
      close_on_exec_seen = true
      flags = flags | 524288 -- O_CLOEXEC
    else
      nelibc_errno_location()[0] = 22 -- EINVAL
      return nilptr
    end
    index = index + 1
  end
  if plus_seen then flags = (flags & ~3) | 2 end -- O_RDWR

  local fd: cint = openat(-100, (@pointer)(pathname), flags, 438_cuint)
  if fd < 0 then return nilptr end
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then
    local saved_errno: cint = nelibc_errno_location()[0]
    close(fd)
    nelibc_errno_location()[0] = saved_errno
    return nilptr
  end
  stream.fd = fd
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = fd
  stream.flags = WRITABLE
  if mode[0] == 114 then stream.flags = READABLE end
  if plus_seen then stream.flags = READABLE | WRITABLE end
  stream.buffer_size = 4096
  stream.user_buffer = nilptr
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end

local function fmemopen(buffer: pointer, size: csize, mode: cstring <const>): *FILE <cexport, codename 'fmemopen'>
  local mode: *[0]cchar = (@*[0]cchar)(mode)
  if size == 0 or mode == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local initial_mode: byte = (@byte)(mode[0])
  if initial_mode ~= 114 and initial_mode ~= 119 and initial_mode ~= 97 then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local plus_seen: boolean = false
  local binary_seen: boolean = false
  local index: csize = 1
  while mode[index] ~= 0 do
    if mode[index] == 43 then
      if plus_seen then nelibc_errno_location()[0] = 22; return nilptr end
      plus_seen = true
    elseif mode[index] == 98 then
      if binary_seen then nelibc_errno_location()[0] = 22; return nilptr end
      binary_seen = true
      -- Binary mode is equivalent to text mode on Linux.
    else
      nelibc_errno_location()[0] = 22 -- EINVAL
      return nilptr
    end
    index = index + 1
  end
  local owned: boolean = buffer == nilptr
  if owned then
    buffer = nelibc_malloc(size)
    if buffer == nilptr then return nilptr end
    memset(buffer, 0, size)
  end
  local bytes: *[0]byte = (@*[0]byte)(buffer)
  local length: csize = 0
  if initial_mode == 119 then
    bytes[0] = 0
  else
    while length < size and bytes[length] ~= 0 do length = length + 1 end
  end
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then
    if owned then nelibc_free(buffer) end
    return nilptr
  end
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = -4
  stream.flags = 0
  if initial_mode == 114 or plus_seen then stream.flags = stream.flags | READABLE end
  if initial_mode ~= 114 or plus_seen then stream.flags = stream.flags | WRITABLE end
  if owned then stream.flags = stream.flags | MEMORY_OWNED end
  if initial_mode == 97 then stream.flags = stream.flags | MEMORY_APPEND end
  stream.buffer_size = size
  stream.user_buffer = (@*byte)(buffer)
  stream.read_length = length
  if initial_mode == 97 then stream.read_position = length end
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end


local function open_memstream(buffer: **byte, size: *csize): *FILE <cexport, codename 'open_memstream'>
  if buffer == nilptr or size == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local output_buffer: *[0]*byte = (@*[0]*byte)(buffer)
  local output_size: *[0]csize = (@*[0]csize)(size)
  output_buffer[0] = nilptr
  output_size[0] = 0
  local memory: pointer = nelibc_malloc(1)
  if memory == nilptr then return nilptr end
  ((@*[0]byte)(memory))[0] = 0
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then
    nelibc_free(memory)
    return nilptr
  end
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = -5
  stream.flags = READABLE | WRITABLE
  stream.buffer_size = 1
  stream.user_buffer = (@*byte)(memory)
  stream.memstream_buffer = buffer
  stream.memstream_size = size
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end

local function open_wmemstream(buffer: **cint, size: *csize): *FILE
    <cexport, codename 'open_wmemstream'>
  if buffer == nilptr or size == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local output_buffer: *[0]*[0]cint = (@*[0]*[0]cint)(buffer)
  local output_size: *[0]csize = (@*[0]csize)(size)
  output_buffer[0] = nilptr
  output_size[0] = 0

  local capacity: csize = 8
  local memory: pointer = nelibc_malloc(capacity * (@csize)(#cint))
  if memory == nilptr then return nilptr end
  ((@*[0]cint)(memory))[0] = 0
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then
    nelibc_free(memory)
    return nilptr
  end
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = -7
  stream.flags = WRITABLE
  stream.buffer_size = capacity
  stream.user_buffer = (@*byte)(memory)
  stream.memstream_buffer = (@**byte)(buffer)
  stream.memstream_size = size
  stream.orientation = 1
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end

local function fdopen(fd: cint, mode: cstring <const>): *FILE <cexport, codename 'fdopen'>
  local mode: *[0]cchar = (@*[0]cchar)(mode)
  if mode == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  if fd < 0 then
    nelibc_errno_location()[0] = 9 -- EBADF
    return nilptr
  end
  local initial_mode: byte = (@byte)(mode[0])
  if initial_mode ~= 114 and initial_mode ~= 119 and initial_mode ~= 97 then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local plus_seen: boolean = false
  local close_on_exec_seen: boolean = false
  local index: csize = 1
  while mode[index] ~= 0 do
    if mode[index] == 43 then
      if plus_seen then nelibc_errno_location()[0] = 22; return nilptr end
      plus_seen = true
    elseif mode[index] == 98 then
      -- Binary mode is equivalent to text mode on Linux.
    elseif mode[index] == 101 then
      if close_on_exec_seen then nelibc_errno_location()[0] = 22; return nilptr end
      close_on_exec_seen = true
    else
      nelibc_errno_location()[0] = 22 -- EINVAL
      return nilptr
    end
    index = index + 1
  end
  local descriptor_flags: cint = nelibc_raw_fcntl(fd, 3, 0) -- F_GETFL
  if descriptor_flags < 0 then return nilptr end
  local access_mode: cint = descriptor_flags & 3 -- O_ACCMODE
  local wants_read: boolean = initial_mode == 114 or plus_seen
  local wants_write: boolean = initial_mode ~= 114 or plus_seen
  if (wants_read and access_mode == 1) or (wants_write and access_mode == 0) then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local stream: *FILE = (@*FILE)(nelibc_malloc((@csize)(#FILE)))
  if stream == nilptr then return nilptr end
  local fd_flags: cint = 0
  if close_on_exec_seen then
    fd_flags = nelibc_raw_fcntl(fd, 1, 0) -- F_GETFD
    if fd_flags < 0 then
      nelibc_free((@pointer)(stream))
      return nilptr
    end
  end
  local append_changed: boolean = false
  if initial_mode == 97 and (descriptor_flags & 1024) == 0 then
    if nelibc_raw_fcntl(fd, 4, (@culong)(descriptor_flags | 1024)) < 0 then
      nelibc_free((@pointer)(stream))
      return nilptr
    end -- F_SETFL, O_APPEND
    append_changed = true
  end
  if close_on_exec_seen then
    if nelibc_raw_fcntl(fd, 2, (@culong)(fd_flags | 1)) < 0 then
      if append_changed then nelibc_raw_fcntl(fd, 4, (@culong)(descriptor_flags)) end
      nelibc_free((@pointer)(stream))
      return nilptr
    end -- F_SETFD, FD_CLOEXEC
  end
  memset((@pointer)(stream), 0, (@csize)(#FILE))
  stream.fd = fd
  stream.flags = 0
  if wants_read then stream.flags = stream.flags | READABLE end
  if wants_write then stream.flags = stream.flags | WRITABLE end
  stream.buffer_size = 4096
  stream.user_buffer = nilptr
  stream_list_lock()
  stream.next = all_streams
  all_streams = stream
  stream_list_unlock()
  return stream
end

local function fileno(stream: *FILE): cint <cexport, codename 'fileno'>
  if stream == nilptr then
    nelibc_errno_location()[0] = 9 -- EBADF
    return -1
  end
  stream_lock(stream)
  local fd: cint = stream.fd
  stream_unlock(stream)
  if fd < 0 then nelibc_errno_location()[0] = 9; return -1 end
  return fd
end

local function tmpfile(): *FILE <cexport, codename 'tmpfile'>
  local prefix: *[0]byte = (@*[0]byte)('/tmp/nelibc-tmp-'_cstring)
  local prefix_length: csize = 0
  while prefix[prefix_length] ~= 0 do prefix_length = prefix_length + 1 end
  local attempt: cint = 0
  while attempt < 128 do
    stream_list_lock()
    tmpfile_sequence = tmpfile_sequence + 1
    if tmpfile_sequence == 0 then tmpfile_sequence = 1 end
    local sequence: culonglong = tmpfile_sequence
    stream_list_unlock()

    local pathname: [64]byte
    local path_length: csize = 0
    memcpy((@pointer)(&pathname[0]), (@pointer)(prefix), prefix_length)
    path_length = prefix_length
    local pid_digits: [16]byte
    local pid_count: csize = 0
    local pid_value: cuint = (@cuint)(getpid())
    repeat
      pid_digits[pid_count] = (@byte)(48 + pid_value % 10)
      pid_count = pid_count + 1
      pid_value = pid_value // 10
    until pid_value == 0
    while pid_count > 0 do
      pid_count = pid_count - 1
      pathname[path_length] = pid_digits[pid_count]
      path_length = path_length + 1
    end
    pathname[path_length] = 45
    path_length = path_length + 1
    local sequence_digits: [24]byte
    local sequence_count: csize = 0
    repeat
      sequence_digits[sequence_count] = (@byte)(48 + sequence % 10)
      sequence_count = sequence_count + 1
      sequence = sequence // 10
    until sequence == 0
    while sequence_count > 0 do
      sequence_count = sequence_count - 1
      pathname[path_length] = sequence_digits[sequence_count]
      path_length = path_length + 1
    end
    pathname[path_length] = 0

    local stream: *FILE = fopen((@*[0]cchar)(&pathname[0]), 'w+xe'_cstring)
    if stream ~= nilptr then
      if unlinkat(-100, (@pointer)(&pathname[0]), 0) == 0 then return stream end
      local saved_errno: cint = nelibc_errno_location()[0]
      close(stream.fd)
      stream_list_lock()
      if all_streams == stream then
        all_streams = stream.next
      else
        local previous: *FILE = all_streams
        while previous ~= nilptr and previous.next ~= stream do previous = previous.next end
        if previous ~= nilptr then previous.next = stream.next end
      end
      stream_list_unlock()
      nelibc_free((@pointer)(stream))
      nelibc_errno_location()[0] = saved_errno
      return nilptr
    end
    if nelibc_errno_location()[0] ~= 17 then
      unlinkat(-100, (@pointer)(&pathname[0]), 0)
      return nilptr
    end -- EEXIST
    attempt = attempt + 1
  end
  nelibc_errno_location()[0] = 17 -- EEXIST
  return nilptr
end

local function close_stream(stream: *FILE, release_stream: boolean): cint
  if stream == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  stream_list_lock()
  stream_lock(stream)
  local result: cint = flush_write_buffer(stream)
  if stream.fd ~= -4 and stream.fd ~= -5 and stream.fd ~= -7 and close(stream.fd) < 0 then result = -1 end
  local owned_buffer: pointer = nilptr
  if stream.fd == -5 or stream.fd == -7 then
    if flush_write_buffer(stream) < 0 then result = -1 end
  elseif (stream.flags & MEMORY_OWNED) ~= 0 then
    owned_buffer = (@pointer)(stream.user_buffer)
  end
  stream_unlock(stream)
  stream.fd = -1
  stream.flags = 0
  stream.pushback_value = 0
  stream.has_pushback = 0
  stream.read_position = 0
  stream.read_length = 0
  stream.write_length = 0
  stream.buffer_size = 0
  stream.user_buffer = nilptr
  stream.memstream_buffer = nilptr
  stream.memstream_size = nilptr
  if release_stream and stream ~= &stdin_FILE and stream ~= &stdout_FILE and stream ~= &stderr_FILE then
    local previous: *FILE = nilptr
    local cursor: *FILE = all_streams
    while cursor ~= nilptr do
      if cursor == stream then
        if previous == nilptr then all_streams = cursor.next else previous.next = cursor.next end
        break
      end
      previous = cursor
      cursor = cursor.next
    end
  end
  stream_list_unlock()
  if owned_buffer ~= nilptr then nelibc_free(owned_buffer) end
  if release_stream and stream ~= &stdin_FILE and stream ~= &stdout_FILE and stream ~= &stderr_FILE then
    nelibc_free((@pointer)(stream))
  end
  return result
end

local function vswscanf(input: *[0]cint <const>, format: *[0]cint <const>,
    arguments: cvalist): cint <cexport, codename 'vswscanf'>
  if input == nilptr or format == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local source: *[0]cint = (@*[0]cint)(input)
  local byte_length: csize = wcsrtombs(nilptr, &source, 0, nilptr)
  if byte_length == ~0_csize then
    nelibc_errno_location()[0] = 84 -- EILSEQ
    return -1
  end
  if byte_length == MAX_CSIZE then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    return -1
  end
  local bytes: *[0]cchar = (@*[0]cchar)(nelibc_malloc(byte_length + 1))
  if bytes == nilptr then
    nelibc_errno_location()[0] = 12 -- ENOMEM
    return -1
  end
  source = (@*[0]cint)(input)
  if wcsrtombs(bytes, &source, byte_length + 1, nilptr) == ~0_csize then
    nelibc_free((@pointer)(bytes))
    nelibc_errno_location()[0] = 84 -- EILSEQ
    return -1
  end
  -- fmemopen rejects a zero size. Its memory length scan still sees an empty
  -- string in a one-byte buffer containing the terminator.
  local stream_size: csize = byte_length
  if stream_size == 0 then stream_size = 1 end
  local stream: *FILE = fmemopen((@pointer)(bytes), stream_size, 'r'_cstring)
  if stream == nilptr then
    nelibc_free((@pointer)(bytes))
    return -1
  end
  stream_orient(stream, 1)
  local result: cint = vfwscanf(stream, format, arguments)
  close_stream(stream, true)
  nelibc_free((@pointer)(bytes))
  return result
end

local function vsscanf(input: *[0]cchar <const>, format: *[0]cchar <const>,
    arguments: cvalist): cint <cexport, codename 'vsscanf'>
  if input == nilptr or format == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local input_length: csize = 0
  while input[input_length] ~= 0 do input_length = input_length + 1 end
  if input_length == MAX_CSIZE then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    return -1
  end
  local bytes: *[0]cchar = (@*[0]cchar)(nelibc_malloc(input_length + 1))
  if bytes == nilptr then return -1 end
  memcpy((@pointer)(bytes), (@pointer)(input), input_length + 1)
  local stream_size: csize = input_length
  if stream_size == 0 then stream_size = 1 end
  local stream: *FILE = fmemopen((@pointer)(bytes), stream_size, 'r'_cstring)
  if stream == nilptr then
    nelibc_free((@pointer)(bytes))
    return -1
  end
  local result: cint = vfscanf(stream, format, arguments)
  close_stream(stream, true)
  nelibc_free((@pointer)(bytes))
  return result
end

local function sscanf(input: *[0]cchar <const>, format: *[0]cchar <const>,
    ...: cvarargs): cint <cexport, codename 'sscanf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vsscanf(input, format, arguments)
  C.va_end(arguments)
  return result
end

local function swscanf(input: *[0]cint <const>, format: *[0]cint <const>,
    ...: cvarargs): cint <cexport, codename 'swscanf'>
  local arguments: cvalist
  C.va_start(arguments, format)
  local result: cint = vswscanf(input, format, arguments)
  C.va_end(arguments)
  return result
end



local function fclose(stream: *FILE): cint <cexport, codename 'fclose'>
  return close_stream(stream, true)
end

local function freopen(pathname: cstring <const>, mode: cstring <const>, stream: *FILE): *FILE <cexport, codename 'freopen'>
  local pathname: *[0]cchar = (@*[0]cchar)(pathname)
  local mode: *[0]cchar = (@*[0]cchar)(mode)
  if stream == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  if pathname == nilptr or mode == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    local saved_errno: cint = nelibc_errno_location()[0]
    close_stream(stream, true)
    nelibc_errno_location()[0] = saved_errno
    return nilptr
  end

  -- freopen closes the old association even if opening the replacement fails.
  close_stream(stream, false)
  local replacement: *FILE = fopen(pathname, mode)
  if replacement == nilptr then
    local saved_errno: cint = nelibc_errno_location()[0]
    close_stream(stream, true)
    nelibc_errno_location()[0] = saved_errno
    return nilptr
  end

  stream_list_lock()
  stream_lock(stream)
  stream_lock(replacement)
  local previous: *FILE = nilptr
  local cursor: *FILE = all_streams
  while cursor ~= nilptr and cursor ~= replacement do
    previous = cursor
    cursor = cursor.next
  end
  if cursor == replacement then
    if previous == nilptr then all_streams = replacement.next
    else previous.next = replacement.next end
  end
  local old_next: *FILE = stream.next
  local old_lock_word: cint = stream.lock_word
  local old_lock_owner: cint = stream.lock_owner
  local old_lock_depth: cint = stream.lock_depth
  memcpy((@pointer)(stream), (@pointer)(replacement), (@csize)(#FILE))
  stream.next = old_next
  stream.lock_word = old_lock_word
  stream.lock_owner = old_lock_owner
  stream.lock_depth = old_lock_depth
  stream_unlock(replacement)
  nelibc_stdio_unlock(&stream.lock_word, &stream.lock_owner, &stream.lock_depth)
  nelibc_free((@pointer)(replacement))
  stream_list_unlock()
  return stream
end

local function discard_read_buffer(stream: *FILE): cint <inline>
  if stream.fd == -4 or stream.fd == -5 or stream.fd == -7 then
    stream.has_pushback = 0
    reset_wide_stream_state(stream)
    stream.flags = stream.flags & ~LAST_READ
    return 0
  end
  local unread: csize = stream.read_length - stream.read_position
  if stream.has_pushback ~= 0 then unread = unread + 1 end
  if unread ~= 0 and lseek(stream.fd, -(@clong)(unread), 1) < 0 then
    stream.flags = stream.flags | STREAM_ERROR
    return -1
  end
  stream.read_position = 0
  stream.read_length = 0
  stream.has_pushback = 0
  reset_wide_stream_state(stream)
  stream.flags = stream.flags & ~LAST_READ
  return 0
end

local function setvbuf(stream: *FILE, buffer: pointer, mode: cint, size: csize): cint <cexport, codename 'setvbuf'>
  if stream == nilptr or (mode ~= 0 and mode ~= 1 and mode ~= 2) then return 1 end
  if mode ~= 2 and buffer ~= nilptr and size == 0 then return 1 end
  stream_lock(stream)
  if stream.fd < 0 then
    nelibc_errno_location()[0] = 9 -- EBADF
    stream_unlock(stream)
    return 1
  end
  if (stream.flags & LAST_WRITE) ~= 0 then
    if flush_write_buffer(stream) < 0 then stream_unlock(stream); return 1 end
  elseif (stream.flags & LAST_READ) ~= 0 or stream.has_pushback ~= 0 or
      stream.has_wide_pushback ~= 0 then
    if discard_read_buffer(stream) < 0 then stream_unlock(stream); return 1 end
  end
  stream.flags = stream.flags & ~(LINE_BUFFERED | UNBUFFERED)
  if mode == 2 then
    stream.user_buffer = nilptr
    stream.buffer_size = 1
    stream.flags = stream.flags | UNBUFFERED
  elseif buffer ~= nilptr then
    stream.user_buffer = (@*byte)(buffer)
    stream.buffer_size = size
    if mode == 1 then stream.flags = stream.flags | LINE_BUFFERED end
  else
    stream.user_buffer = nilptr
    stream.buffer_size = 4096
    if size ~= 0 and size < 4096 then stream.buffer_size = size end
    if mode == 1 then stream.flags = stream.flags | LINE_BUFFERED end
  end
  stream_unlock(stream)
  return 0
end

local function setbuf(stream: *FILE, buffer: *cchar): void <cexport, codename 'setbuf'>
  if buffer == nilptr then
    setvbuf(stream, nilptr, 2, 4096)
  else
    setvbuf(stream, (@pointer)(buffer), 0, 4096)
  end
end

local function setbuffer(stream: *FILE, buffer: *cchar, size: csize): void
    <cexport, codename 'setbuffer'>
  if buffer == nilptr then setvbuf(stream, nilptr, 2, 4096)
  else setvbuf(stream, (@pointer)(buffer), 0, size) end
end

local function setlinebuf(stream: *FILE): void <cexport, codename 'setlinebuf'>
  setvbuf(stream, nilptr, 1, 0)
end

local function emit_bytes(stream: *FILE, bytes: pointer <const>, count: csize): csize <inline>
  return write_bytes(stream, bytes, count)
end

local function emit_padding(stream: *FILE, value: byte, count: csize): csize <inline>
  local total: csize = 0
  while total < count do
    local byte_value: byte = value
    if write_bytes(stream, (@pointer)(&byte_value), 1) ~= 1 then return total end
    total = total + 1
  end
  return total
end

local function grouping_separator_count(digit_count: csize): csize <inline>
  local remaining: csize = digit_count
  local groups: cint = 0
  local separators: csize = 0
  while (@csize)(groups) < digit_count do
    local group_size: cint = nelibc_grouping_size(groups)
    if group_size <= 0 or remaining <= (@csize)(group_size) then break end
    remaining = remaining - (@csize)(group_size)
    separators = separators + 1
    groups = groups + 1
  end
  return separators
end

local function format_wide_string(input: *[0]cint <const>, precision_set: boolean,
    precision: cint, bytes_out: **cchar, byte_length_out: *csize,
    wide_length_out: *csize): boolean <inline>
  local bytes_pointer: *[0]*cchar = (@*[0]*cchar)(bytes_out)
  local byte_length_pointer: *[0]csize = (@*[0]csize)(byte_length_out)
  local wide_length_pointer: *[0]csize = (@*[0]csize)(wide_length_out)
  local wide_length: csize = 0
  while input[wide_length] ~= 0 and
      (not precision_set or wide_length < (@csize)(precision)) do
    wide_length = wide_length + 1
  end
  local state: [16]culong = {}
  local source: *[0]cint = (@*[0]cint)(input)
  local byte_length: csize = wcsnrtombs(nilptr, &source, wide_length, 0, (@pointer)(&state[0]))
  if byte_length == ~0_csize then
    nelibc_errno_location()[0] = 84 -- EILSEQ
    return false
  end
  if byte_length == MAX_CSIZE then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    return false
  end
  local bytes: *[0]cchar = (@*[0]cchar)(nelibc_malloc(byte_length + 1))
  if bytes == nilptr then
    nelibc_errno_location()[0] = 12 -- ENOMEM
    return false
  end
  source = (@*[0]cint)(input)
  state[0] = 0
  local converted: csize = wcsnrtombs(bytes, &source, wide_length,
      byte_length + 1, (@pointer)(&state[0]))
  if converted == ~0_csize then
    nelibc_free((@pointer)(bytes))
    nelibc_errno_location()[0] = 84 -- EILSEQ
    return false
  end
  bytes[converted] = 0
  bytes_pointer[0] = bytes
  byte_length_pointer[0] = converted
  wide_length_pointer[0] = wide_length
  return true
end

local function format_wide_format(format: *[0]cint <const>,
    format_bytes_out: **cchar): boolean <inline>
  local format_bytes_pointer: *[0]*cchar = (@*[0]*cchar)(format_bytes_out)
  local source: *[0]cint = (@*[0]cint)(format)
  local byte_length: csize = wcsrtombs(nilptr, &source, 0, nilptr)
  if byte_length == ~0_csize then
    nelibc_errno_location()[0] = 84 -- EILSEQ
    return false
  end
  if byte_length > (MAX_CSIZE - 1) // 2 then
    nelibc_errno_location()[0] = 75 -- EOVERFLOW
    return false
  end
  local raw_format: *[0]cchar = (@*[0]cchar)(nelibc_malloc(byte_length + 1))
  if raw_format == nilptr then
    nelibc_errno_location()[0] = 12 -- ENOMEM
    return false
  end
  source = (@*[0]cint)(format)
  if wcsrtombs(raw_format, &source, byte_length + 1, nilptr) == ~0_csize then
    nelibc_free((@pointer)(raw_format))
    nelibc_errno_location()[0] = 84 -- EILSEQ
    return false
  end
  local converted_format: *[0]cchar = (@*[0]cchar)(
      nelibc_malloc(byte_length * 2 + 1))
  if converted_format == nilptr then
    nelibc_free((@pointer)(raw_format))
    nelibc_errno_location()[0] = 12 -- ENOMEM
    return false
  end
  local input_index: csize = 0
  local output_index: csize = 0
  while input_index < byte_length do
    if raw_format[input_index] ~= 37 then
      converted_format[output_index] = raw_format[input_index]
      input_index = input_index + 1
      output_index = output_index + 1
      continue
    end
    local spec_start: csize = input_index
    input_index = input_index + 1
    if input_index < byte_length and raw_format[input_index] == 37 then
      converted_format[output_index] = 37
      converted_format[output_index + 1] = 37
      input_index = input_index + 1
      output_index = output_index + 2
      continue
    end
    local cursor: csize = input_index
    local narrow_modifier: boolean = false
    local long_modifier: boolean = false
    local long_double_modifier: boolean = false
    while cursor < byte_length do
      local character: byte = (@byte)(raw_format[cursor])
      if character == 104 then narrow_modifier = true end
      if character == 108 then long_modifier = true end
      if character == 76 then long_double_modifier = true end
      if character == 100 or character == 105 or character == 111 or
          character == 117 or character == 120 or character == 88 or
          character == 102 or character == 70 or character == 101 or
          character == 69 or character == 103 or character == 71 or
          character == 97 or character == 65 or character == 99 or
          character == 115 or character == 112 or character == 110 then break end
      cursor = cursor + 1
    end
    if cursor >= byte_length then
      while spec_start < byte_length do
        converted_format[output_index] = raw_format[spec_start]
        output_index = output_index + 1
        spec_start = spec_start + 1
      end
      input_index = byte_length
      break
    end
    if long_double_modifier then
      nelibc_free((@pointer)(converted_format))
      nelibc_free((@pointer)(raw_format))
      nelibc_errno_location()[0] = 22 -- EINVAL: long-double formatting is not implemented yet
      return false
    end
    while spec_start < cursor do
      converted_format[output_index] = raw_format[spec_start]
      output_index = output_index + 1
      spec_start = spec_start + 1
    end
    local conversion: byte = (@byte)(raw_format[cursor])
    if long_modifier and conversion == 115 then conversion = 83 end
    if not narrow_modifier and conversion == 99 then conversion = 67 end
    converted_format[output_index] = (@cchar)(conversion)
    output_index = output_index + 1
    input_index = cursor + 1
  end
  converted_format[output_index] = 0
  nelibc_free((@pointer)(raw_format))
  format_bytes_pointer[0] = converted_format
  return true
end

local function vfprintf(stream: *FILE, format: cstring <const>, arguments: cvalist): cint <cexport, codename 'vfprintf'>
  local format: *[0]cchar = (@*[0]cchar)(format)
  if stream == nilptr or format == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  stream_lock(stream)
  stream_orient(stream, -1)
  local written: csize = 0
  local index: csize = 0
  while format[index] ~= 0 do
    if format[index] ~= 37 then
      local start: csize = index
      while format[index] ~= 0 and format[index] ~= 37 do index = index + 1 end
      local length: csize = index - start
      local data: pointer <const> = (@pointer)((@usize)(format) + start)
      local result: csize = emit_bytes(stream, data, length)
      written = written + result
      if result ~= length then stream_unlock(stream); return -1 end
      continue
    end
    index = index + 1
    local left_align: boolean = false
    local plus_sign: boolean = false
    local space_sign: boolean = false
    local alternate: boolean = false
    local zero_pad: boolean = false
    local grouping_flag: boolean = false
    local flags_done: boolean = false
    while not flags_done do
      if format[index] == 45 then left_align = true
      elseif format[index] == 43 then plus_sign = true
      elseif format[index] == 32 then space_sign = true
      elseif format[index] == 35 then alternate = true
      elseif format[index] == 48 then zero_pad = true
      elseif format[index] == 39 then grouping_flag = true
      else flags_done = true end
      if not flags_done then index = index + 1 end
    end
    local width: cint = 0
    if format[index] == 42 then
      width = nelibc_va_arg_int(arguments)
      index = index + 1
      if width < 0 then left_align = true; width = -width end
    else
      while format[index] >= 48 and format[index] <= 57 do
        if width > 100000 then
          nelibc_errno_location()[0] = 75 -- EOVERFLOW
          stream_unlock(stream)
          return -1
        end
        width = width * 10 + (@cint)(format[index] - 48)
        index = index + 1
      end
    end
    local precision: cint = 0
    local precision_set: boolean = false
    if format[index] == 46 then
      precision_set = true
      index = index + 1
      if format[index] == 42 then
        precision = nelibc_va_arg_int(arguments)
        if precision < 0 then precision_set = false; precision = 0 end
        index = index + 1
      else
        while format[index] >= 48 and format[index] <= 57 do
          if precision > 100000 then
            nelibc_errno_location()[0] = 75 -- EOVERFLOW
            stream_unlock(stream)
            return -1
          end
          precision = precision * 10 + (@cint)(format[index] - 48)
          index = index + 1
        end
      end
    end
    local length_mod: cint = 0
    if format[index] == 108 then
      length_mod = 1
      index = index + 1
      if format[index] == 108 then length_mod = 2; index = index + 1 end
    elseif format[index] == 122 or format[index] == 106 or format[index] == 116 then
      length_mod = 3
      index = index + 1
    elseif format[index] == 104 then
      index = index + 1
      if format[index] == 104 then length_mod = 4; index = index + 1
      else length_mod = 5 end
    end
    local conversion: byte = (@byte)(format[index])
    if conversion == 0 then
      nelibc_errno_location()[0] = 22 -- EINVAL
      stream_unlock(stream)
      return -1
    end
    index = index + 1
    local field_start: csize = written
    if conversion == 110 then -- n
      local count_pointer: pointer = nelibc_va_arg_pointer(arguments)
      if (stream.flags & FORMAT_COUNT_ONLY) == 0 then
        local count: csize = written
        if (stream.flags & WIDE_FORMAT) ~= 0 then
          local bytes: *[0]cchar = (@*[0]cchar)(stream.user_buffer)
          if stream.write_length < stream.buffer_size then bytes[stream.write_length] = 0 end
          local prefix: *[0]cchar = bytes
          local state: [16]culong = {}
          count = mbsrtowcs(nilptr, &prefix, 0, (@pointer)(&state[0]))
          if count == ~0_csize then
            stream_unlock(stream)
            return -1
          end
        end
        nelibc_store_format_count(count_pointer, length_mod, count)
      end
    elseif conversion == 115 then -- s
      local string_pointer: pointer = nelibc_va_arg_pointer(arguments)
      if string_pointer == nilptr then string_pointer = (@pointer)('(null)'_cstring) end
      local string_bytes: *[0]byte = (@*[0]byte)(string_pointer)
      local string_length: csize = 0
      while string_bytes[string_length] ~= 0 and
          (not precision_set or string_length < (@csize)(precision)) do
        string_length = string_length + 1
      end
      local pad: csize = 0
      if width > (@cint)(string_length) then pad = (@csize)(width - (@cint)(string_length)) end
      if not left_align then written = written + emit_padding(stream, 32, pad) end
      written = written + emit_bytes(stream, string_pointer, string_length)
      if left_align then written = written + emit_padding(stream, 32, pad) end
    elseif conversion == 83 then -- internal wide-string conversion for vswprintf
      local wide_pointer: *[0]cint = (@*[0]cint)(nelibc_va_arg_pointer(arguments))
      local converted_bytes: *[0]cchar = nilptr
      local byte_length: csize = 0
      local wide_length: csize = 0
      local owned_bytes: boolean = wide_pointer ~= nilptr
      if wide_pointer == nilptr then
        converted_bytes = (@*[0]cchar)('(null)'_cstring)
        byte_length = 6
        wide_length = 6
      elseif not format_wide_string(wide_pointer, precision_set, precision,
          &converted_bytes, &byte_length, &wide_length) then
        stream.flags = stream.flags | STREAM_ERROR
        stream_unlock(stream)
        return -1
      end
      local pad: csize = 0
      if width > (@cint)(wide_length) then pad = (@csize)(width - (@cint)(wide_length)) end
      if not left_align then written = written + emit_padding(stream, 32, pad) end
      if emit_bytes(stream, (@pointer)(converted_bytes), byte_length) ~= byte_length then
        if owned_bytes then nelibc_free((@pointer)(converted_bytes)) end
        stream_unlock(stream)
        return -1
      end
      written = written + byte_length
      if left_align then written = written + emit_padding(stream, 32, pad) end
      if owned_bytes then nelibc_free((@pointer)(converted_bytes)) end
    elseif conversion == 99 then -- c
      local character: byte = (@byte)(nelibc_va_arg_int(arguments))
      local pad: csize = 0
      if width > 1 then pad = (@csize)(width - 1) end
      if not left_align then written = written + emit_padding(stream, 32, pad) end
      written = written + emit_padding(stream, character, 1)
      if left_align then written = written + emit_padding(stream, 32, pad) end
    elseif conversion == 67 then -- internal wide-character conversion for vswprintf
      local wide: cint = nelibc_va_arg_int(arguments)
      local encoded: [64]cchar = {}
      local state: [16]culong = {}
      local encoded_length: csize = wcrtomb((@*[0]cchar)(&encoded[0]), wide,
          (@pointer)(&state[0]))
      if encoded_length == ~0_csize then
        stream.flags = stream.flags | STREAM_ERROR
        stream_unlock(stream)
        return -1
      end
      local pad: csize = 0
      if width > 1 then pad = (@csize)(width - 1) end
      if not left_align then written = written + emit_padding(stream, 32, pad) end
      if emit_bytes(stream, (@pointer)(&encoded[0]), encoded_length) ~= encoded_length then
        stream_unlock(stream)
        return -1
      end
      written = written + encoded_length
