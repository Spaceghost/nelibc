  &T_CP1257, &T_CP1258, &T_KOI8_R, &T_KOI8_U, &T_CP437, &T_CP850,
}

local Name = @record{ name: cstring, id: integer }

-- Names in their compared form: lower-case letters and digits only.
local NAMES: []Name = {
  {'utf8', C_UTF8}, {'', C_UTF8},
  {'ascii', C_ASCII}, {'usascii', C_ASCII}, {'ansix341968', C_ASCII}, {'iso646us', C_ASCII}, {'us', C_ASCII},
  {'utf16', C_UTF16}, {'utf16be', C_UTF16BE}, {'utf16le', C_UTF16LE},
  {'ucs2', C_UCS2BE}, {'ucs2be', C_UCS2BE}, {'ucs2le', C_UCS2LE},
