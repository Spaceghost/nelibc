-- <iconv.h> for the standalone profile, after musl 1.2.5 src/locale/iconv.c:
-- UTF-8; US-ASCII; UTF-16, UTF-16BE/LE, UCS-2, UCS-2BE/LE; UTF-32 (UCS-4),
-- UTF-32BE/LE, WCHAR_T; ISO-8859-1 to -16; Windows-1250 to -1258; KOI8-R,
-- KOI8-U; CP437, CP850. Names match as musl matches them: case is ignored and
-- characters other than letters and digits in the requested name are
-- skipped ("iso_8859-1", "ISO8859-1", "latin1"); a "//TRANSLIT" or "//IGNORE"
-- suffix is accepted and ignored; "" is UTF-8. As in musl, a character the
-- target cannot represent becomes '*' and is counted in iconv's result;
-- invalid input is EILSEQ, input that stops in the middle of a character is
-- EINVAL, a full output buffer is E2BIG. UTF-16 and UTF-32 input honour a
-- byte order mark (big-endian without one); their output is big-endian
-- without a mark, as musl writes it. The single-byte tables come from the
-- Unicode mapping tables.
## pragmas.nogc = true
## pragmas.noentrypoint = true

local function malloc(size: csize): pointer <cimport> end
local function free(p: pointer): void <cimport> end
local function nelibc_errno_location(): *[0]cint <cimport> end

local EILSEQ: cint <comptime> = 84
local EINVAL: cint <comptime> = 22
local E2BIG: cint <comptime> = 7
local EBADF: cint <comptime> = 9

-- Generated from the Unicode mapping tables (Python 3 codecs): high halves
-- (bytes 0x80-0xFF) of the single-byte charsets; 0xFFFF marks an undefined byte.
