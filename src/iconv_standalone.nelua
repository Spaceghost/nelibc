local C_UTF8: integer <comptime> = 1
local C_ASCII: integer <comptime> = 2
local C_UTF16: integer <comptime> = 3
local C_UTF16BE: integer <comptime> = 4
local C_UTF16LE: integer <comptime> = 5
local C_UTF32: integer <comptime> = 6
local C_UTF32BE: integer <comptime> = 7
local C_UTF32LE: integer <comptime> = 8
local C_UCS2BE: integer <comptime> = 9
local C_UCS2LE: integer <comptime> = 10
local C_WCHAR: integer <comptime> = 11
local C_TABLE: integer <comptime> = 100   -- + index into TABLES

local TABLES: [28]*[128]uint16 = {
  &T_ISO_8859_1, &T_ISO_8859_2, &T_ISO_8859_3, &T_ISO_8859_4, &T_ISO_8859_5,
