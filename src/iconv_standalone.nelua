  {'koi8r', C_TABLE + 24}, {'koi8u', C_TABLE + 25},
  {'cp437', C_TABLE + 26}, {'ibm437', C_TABLE + 26},
  {'cp850', C_TABLE + 27}, {'ibm850', C_TABLE + 27},
}

-- musl's fuzzycmp: skip anything but letters and digits in `a`; case-blind.
local function name_matches(a: *const [0]cchar, b: cstring): boolean
  local bb = (@*const [0]cchar)(b)
  local i, j = 0, 0
  while true do
    local c = (@byte)(a[i])
    -- stop at the end or at a "//" suffix
    if c == 0 or (c == 47 and (@byte)(a[i + 1]) == 47) then break end
    local lower = c | 32
    if (lower >= 97 and lower <= 122) or (c >= 48 and c <= 57) then
      if (@byte)(bb[j]) ~= ((c >= 48 and c <= 57) and c or lower) then return false end
      j = j + 1
    end
    i = i + 1
  end
  return bb[j] == 0
end

local function charset_id(name: *const [0]cchar): integer
  if name == nilptr then return 0 end
  for k = 0, < #NAMES do
    if name_matches(name, NAMES[k].name) then return NAMES[k].id end
  end
  return 0
end

local Conv = @record{ from: integer, to: integer, order: integer }  -- order: 0 unset, 1 BE, 2 LE

local function iconv_open(tocode: *const [0]cchar, fromcode: *const [0]cchar): pointer <cexport, codename 'iconv_open'>
  local t, f = charset_id(tocode), charset_id(fromcode)
  if t == 0 or f == 0 then
    nelibc_errno_location()[0] = EINVAL
    return (@pointer)((@usize)(-1))
  end
  local cd = (@*Conv)(malloc(#Conv))
  if cd == nilptr then return (@pointer)((@usize)(-1)) end
  cd.from = f; cd.to = t; cd.order = 0
  return cd
end

local function iconv_close(cd: pointer): cint <cexport, codename 'iconv_close'>
  if cd == nilptr or (@usize)(cd) == (@usize)(-1) then
    nelibc_errno_location()[0] = EBADF
    return -1
  end
  free(cd)
  return 0
end

-- Decode one character at in[0..avail). Returns (code point, length);
-- length 0 means incomplete (EINVAL), -1 invalid (EILSEQ).
local function decode(cd: *Conv, s: *[0]byte, avail: csize): (uint32, integer)
  local f = cd.from
  local c0: uint32 = s[0]
  if f == C_UTF8 then
    if c0 < 0x80 then return c0, 1 end
    local n: integer
    local c: uint32
    local min: uint32
    if c0 >= 0xC2 and c0 <= 0xDF then n = 2; c = c0 & 0x1F; min = 0x80
    elseif c0 >= 0xE0 and c0 <= 0xEF then n = 3; c = c0 & 0x0F; min = 0x800
    elseif c0 >= 0xF0 and c0 <= 0xF4 then n = 4; c = c0 & 0x07; min = 0x10000
    else return 0, -1 end
    for k = 1, n - 1 do
      if (@csize)(k) >= avail then
        -- a truncated sequence is EINVAL only if what is there could continue
        return 0, 0
      end
      local b: uint32 = s[k]
      if b & 0xC0 ~= 0x80 then return 0, -1 end
      c = (c << 6) | (b & 0x3F)
    end
    if c < min or c > 0x10FFFF or (c >= 0xD800 and c <= 0xDFFF) then return 0, -1 end
    return c, n
  elseif f == C_ASCII then
    if c0 >= 0x80 then return 0, -1 end
    return c0, 1
  elseif f >= C_TABLE then
    if c0 < 0x80 then return c0, 1 end
    local v = TABLES[f - C_TABLE][c0 - 0x80]
    if v == 0xFFFF then return 0, -1 end
    return v, 1
  elseif f == C_UTF16 or f == C_UTF16BE or f == C_UTF16LE or f == C_UCS2BE or f == C_UCS2LE then
    if avail < 2 then return 0, 0 end
    local le = f == C_UTF16LE or f == C_UCS2LE
    if f == C_UTF16 then
      if cd.order == 0 then
        -- a byte order mark sets the order and is consumed
        if s[0] == 0xFE and s[1] == 0xFF then cd.order = 1; return 0xFEFF0000, 2 end
        if s[0] == 0xFF and s[1] == 0xFE then cd.order = 2; return 0xFEFF0000, 2 end
        cd.order = 1
      end
      le = cd.order == 2
    end
    local u: uint32 = le and ((@uint32)(s[1]) << 8 | s[0]) or ((@uint32)(s[0]) << 8 | s[1])
    if f == C_UCS2BE or f == C_UCS2LE then
      if u >= 0xD800 and u <= 0xDFFF then return 0, -1 end
      return u, 2
    end
    if u >= 0xDC00 and u <= 0xDFFF then return 0, -1 end
    if u >= 0xD800 and u <= 0xDBFF then
      if avail < 4 then return 0, 0 end
      local u2: uint32 = le and ((@uint32)(s[3]) << 8 | s[2]) or ((@uint32)(s[2]) << 8 | s[3])
      if u2 < 0xDC00 or u2 > 0xDFFF then return 0, -1 end
      return 0x10000 + ((u - 0xD800) << 10) + (u2 - 0xDC00), 4
    end
    return u, 2
  else
    -- UTF-32 family and WCHAR_T (native little-endian)
    if avail < 4 then return 0, 0 end
    local le = f == C_UTF32LE or f == C_WCHAR
    if f == C_UTF32 then
      if cd.order == 0 then
        if s[0] == 0 and s[1] == 0 and s[2] == 0xFE and s[3] == 0xFF then cd.order = 1; return 0xFEFF0000, 4 end
        if s[0] == 0xFF and s[1] == 0xFE and s[2] == 0 and s[3] == 0 then cd.order = 2; return 0xFEFF0000, 4 end
        cd.order = 1
      end
      le = cd.order == 2
    end
    local u: uint32
    if le then u = (@uint32)(s[0]) | ((@uint32)(s[1]) << 8) | ((@uint32)(s[2]) << 16) | ((@uint32)(s[3]) << 24)
    else u = (@uint32)(s[3]) | ((@uint32)(s[2]) << 8) | ((@uint32)(s[1]) << 16) | ((@uint32)(s[0]) << 24) end
    if u > 0x10FFFF or (u >= 0xD800 and u <= 0xDFFF) then return 0, -1 end
    return u, 4
  end
end

-- Encode `c` into out[0..room). Returns the length written, 0 when there is
-- no room (E2BIG); `lossy` reports a character replaced by '*'.
local function encode(cd: *Conv, c: uint32, o: *[0]byte, room: csize): (integer, boolean)
  local t = cd.to
  local lossy = false
  if t == C_UTF8 then
    local n: integer = c < 0x80 and 1 or (c < 0x800 and 2 or (c < 0x10000 and 3 or 4))
    if room < (@csize)(n) then return 0, false end
    if n == 1 then o[0] = (@byte)(c)
    elseif n == 2 then o[0] = (@byte)(0xC0 | (c >> 6)); o[1] = (@byte)(0x80 | (c & 0x3F))
    elseif n == 3 then o[0] = (@byte)(0xE0 | (c >> 12)); o[1] = (@byte)(0x80 | ((c >> 6) & 0x3F)); o[2] = (@byte)(0x80 | (c & 0x3F))
    else o[0] = (@byte)(0xF0 | (c >> 18)); o[1] = (@byte)(0x80 | ((c >> 12) & 0x3F)); o[2] = (@byte)(0x80 | ((c >> 6) & 0x3F)); o[3] = (@byte)(0x80 | (c & 0x3F)) end
    return n, false
  elseif t == C_ASCII or t >= C_TABLE then
    if room < 1 then return 0, false end
    if c < 0x80 then o[0] = (@byte)(c); return 1, false end
    if t >= C_TABLE then
      local tab = TABLES[t - C_TABLE]
      for k = 0, < 128 do
        if (@uint32)(tab[k]) == c then o[0] = (@byte)(0x80 + k); return 1, false end
      end
    end
    o[0] = 42
    return 1, true
  elseif t == C_UTF16 or t == C_UTF16BE or t == C_UTF16LE or t == C_UCS2BE or t == C_UCS2LE then
    local le = t == C_UTF16LE or t == C_UCS2LE
    if c >= 0x10000 and (t == C_UCS2BE or t == C_UCS2LE) then c = 42; lossy = true end
    if c >= 0x10000 then
      if room < 4 then return 0, false end
      local v = c - 0x10000
      local hi: uint32 = 0xD800 | (v >> 10)
      local lo: uint32 = 0xDC00 | (v & 0x3FF)
      if le then o[0] = (@byte)(hi & 0xFF); o[1] = (@byte)(hi >> 8); o[2] = (@byte)(lo & 0xFF); o[3] = (@byte)(lo >> 8)
      else o[0] = (@byte)(hi >> 8); o[1] = (@byte)(hi & 0xFF); o[2] = (@byte)(lo >> 8); o[3] = (@byte)(lo & 0xFF) end
      return 4, lossy
    end
    if room < 2 then return 0, false end
    if le then o[0] = (@byte)(c & 0xFF); o[1] = (@byte)(c >> 8)
    else o[0] = (@byte)(c >> 8); o[1] = (@byte)(c & 0xFF) end
    return 2, lossy
  else
    if room < 4 then return 0, false end
    if t == C_UTF32LE or t == C_WCHAR then
      o[0] = (@byte)(c & 0xFF); o[1] = (@byte)((c >> 8) & 0xFF); o[2] = (@byte)((c >> 16) & 0xFF); o[3] = (@byte)(c >> 24)
    else
      o[0] = (@byte)(c >> 24); o[1] = (@byte)((c >> 16) & 0xFF); o[2] = (@byte)((c >> 8) & 0xFF); o[3] = (@byte)(c & 0xFF)
    end
    return 4, false
  end
end

local function iconv(cd: pointer, inbuf: *[0]*[0]byte, inleft: *csize, outbuf: *[0]*[0]byte, outleft: *csize): csize <cexport, codename 'iconv'>
  if cd == nilptr or (@usize)(cd) == (@usize)(-1) then
    nelibc_errno_location()[0] = EBADF
    return (@csize)(-1)
  end
  local conv = (@*Conv)(cd)
  -- no input: back to the initial state (no shift sequences to write)
  if inbuf == nilptr or inbuf[0] == nilptr or inleft == nilptr or $inleft == 0 then
    if inbuf == nilptr or inbuf[0] == nilptr then conv.order = 0 end
    return 0
  end
  local x: csize = 0
  while $inleft > 0 do
    local saved_order = conv.order
    local c, l = decode(conv, inbuf[0], $inleft)
    if l == 0 then nelibc_errno_location()[0] = EINVAL; return (@csize)(-1) end
    if l < 0 then nelibc_errno_location()[0] = EILSEQ; return (@csize)(-1) end
    if c ~= 0xFEFF0000 then   -- a consumed byte order mark writes nothing
      if outbuf == nilptr or outbuf[0] == nilptr or outleft == nilptr then
        nelibc_errno_location()[0] = E2BIG; return (@csize)(-1)
      end
      local n, lossy = encode(conv, c, outbuf[0], $outleft)
      if n == 0 then
        conv.order = saved_order
        nelibc_errno_location()[0] = E2BIG
        return (@csize)(-1)
      end
      if lossy then x = x + 1 end
      outbuf[0] = (@*[0]byte)(&outbuf[0][n])
      $outleft = $outleft - (@csize)(n)
    end
    inbuf[0] = (@*[0]byte)(&inbuf[0][l])
    $inleft = $inleft - (@csize)(l)
  end
  return x
end
