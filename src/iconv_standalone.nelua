  {'iso885911', C_TABLE + 10}, {'tis620', C_TABLE + 10},
  {'iso885913', C_TABLE + 11}, {'latin7', C_TABLE + 11},
  {'iso885914', C_TABLE + 12}, {'latin8', C_TABLE + 12},
  {'iso885915', C_TABLE + 13}, {'latin9', C_TABLE + 13},
  {'iso885916', C_TABLE + 14}, {'latin10', C_TABLE + 14},
  {'cp1250', C_TABLE + 15}, {'windows1250', C_TABLE + 15},
  {'cp1251', C_TABLE + 16}, {'windows1251', C_TABLE + 16},
  {'cp1252', C_TABLE + 17}, {'windows1252', C_TABLE + 17},
  {'cp1253', C_TABLE + 18}, {'windows1253', C_TABLE + 18},
  {'cp1254', C_TABLE + 19}, {'windows1254', C_TABLE + 19},
