  {'utf32le', C_UTF32LE}, {'ucs4le', C_UTF32LE}, {'wchart', C_WCHAR},
  {'iso88591', C_TABLE + 0}, {'latin1', C_TABLE + 0}, {'l1', C_TABLE + 0},
  {'iso88592', C_TABLE + 1}, {'latin2', C_TABLE + 1},
