            elseif ch >= 65_cuint and ch <= 70_cuint then digit = ch - 55_cuint
            else break end
            first = first * 16_usize + (@usize)(digit)
            have_first_digit = true
            j = j + 1_csize
          end
          if have_first_digit and j < line_length and line[j] == 45_cchar then
            j = j + 1_csize
            local have_last_digit = false
            while j < line_length and line[j] ~= 32_cchar do -- space
              local ch = (@cuint)(line[j])
              local digit: cuint
              if ch >= 48_cuint and ch <= 57_cuint then digit = ch - 48_cuint
              elseif ch >= 97_cuint and ch <= 102_cuint then digit = ch - 87_cuint
              elseif ch >= 65_cuint and ch <= 70_cuint then digit = ch - 55_cuint
              else break end
              last = last * 16_usize + (@usize)(digit)
              have_last_digit = true
              j = j + 1_csize
            end
            if have_last_digit and probe >= first and probe < last then
              stack_start[0] = first
              stack_end[0] = last
              close(fd)
              return 0
            end
          end
        end
        line_length = 0_csize
        dropping_line = false
      elseif not dropping_line then
        if line_length < 511_csize then
          line[line_length] = input[i]
          line_length = line_length + 1_csize
        else
          line_length = 0_csize
          dropping_line = true
        end
      end
      i = i + 1_csize
    end
  end
  close(fd)
  return 5 -- EIO: current stack mapping was not found
end

local function pthread_getattr_np(thread: pointer, attr: *PthreadAttr): cint
    <cexport, codename 'pthread_getattr_np'>
  if attr == nilptr then return 22 end -- EINVAL
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  local stack_addr: pointer
  local stack_size: csize
  local guard_size: csize
  local detachstate: cint = 0
  local schedpolicy: cint = SCHED_OTHER
  local schedpriority: cint = 0
  local inheritsched: cint = PTHREAD_INHERIT_SCHED
  if initial_thread_identity ~= nilptr and thread == initial_thread_identity then
    local probe: cint = 0
    local stack_start: usize
    local stack_end: usize
    local stack_error = pthread_find_current_stack((@usize)(&probe),
        &stack_start, &stack_end)
    if stack_error ~= 0 then return stack_error end
    stack_addr = (@pointer)(stack_start)
    stack_size = (@csize)(stack_end - stack_start)
    guard_size = 0_csize
    local context = pthread_current_context()
    schedpolicy = context.sched_policy
    schedpriority = context.sched_priority
    inheritsched = context.sched_inherit
  else
    local state = (@*PthreadObject)(thread)
    if state.magic ~= PTHREAD_OBJECT_MAGIC then return 3 end -- ESRCH
    stack_addr = state.stack_addr
    stack_size = state.stack_size
    guard_size = state.guard_size
    local lifecycle = nelibc_atomic_load_int(&state.context.lifecycle)
    if lifecycle == 1 or lifecycle == 3 or lifecycle == 5 or lifecycle == 6 then
      detachstate = 1
    end
    schedpolicy = state.context.sched_policy
    schedpriority = state.context.sched_priority
    inheritsched = state.context.sched_inherit
  end
  local init_error = pthread_attr_init(attr)
  if init_error ~= 0 then return init_error end
  attr.stackaddr = stack_addr
  attr.stacksize = stack_size
  attr.guardsize = guard_size
  attr.detachstate = detachstate
  attr.schedpolicy = schedpolicy
  attr.schedparam.sched_priority = schedpriority
  attr.inheritsched = inheritsched
  return 0
end

local function pthread_getaffinity_np(thread: pointer, cpusetsize: csize,
    cpuset: pointer): cint <cexport, codename 'pthread_getaffinity_np'>
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  local result = nelibc_raw_syscall3(204_culong, (@culong)(tid),
      (@culong)(cpusetsize), (@culong)((@usize)(cpuset))) -- sched_getaffinity
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  return 0
end

local function pthread_setaffinity_np(thread: pointer, cpusetsize: csize,
    cpuset: pointer <const>): cint <cexport, codename 'pthread_setaffinity_np'>
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  local result = nelibc_raw_syscall3(203_culong, (@culong)(tid),
      (@culong)(cpusetsize), (@culong)((@usize)(cpuset))) -- sched_setaffinity
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  return 0
end

local function pthread_comm_path(tid: cint, path: *[0]cchar): void
  local prefix: [16]cchar = {
    47_cchar, 112_cchar, 114_cchar, 111_cchar, 99_cchar, 47_cchar,
    115_cchar, 101_cchar, 108_cchar, 102_cchar, 47_cchar,
    116_cchar, 97_cchar, 115_cchar, 107_cchar, 47_cchar
  }
  for i: csize = 0, 15 do path[i] = prefix[i] end
  local digits: [10]cchar = {}
  local digit_count: csize = 0
  local value: cuint = (@cuint)(tid)
  while value > 0_cuint do
    digits[digit_count] = (@cchar)(48_cuint + value % 10_cuint)
    digit_count = digit_count + 1_csize
    value = value / 10_cuint
  end
  local index: csize = 16_csize
  while digit_count > 0_csize do
    digit_count = digit_count - 1_csize
    path[index] = digits[digit_count]
    index = index + 1_csize
  end
  path[index] = 47_cchar
  index = index + 1_csize
  path[index] = 99_cchar
  path[index + 1_csize] = 111_cchar
  path[index + 2_csize] = 109_cchar
  path[index + 3_csize] = 109_cchar
  path[index + 4_csize] = 0_cchar
end

local function pthread_getname_np(thread: pointer, name: *[0]cchar,
    length: csize): cint <cexport, codename 'pthread_getname_np'>
  if length < 16_csize then return 34 end -- ERANGE: Linux TASK_COMM_LEN
  if name == nilptr then return 22 end -- EINVAL
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  if thread == pthread_self() then
    local result = nelibc_raw_syscall6(157_culong, 16_culong,
        (@culong)((@usize)(name)), 0_culong, 0_culong, 0_culong, 0_culong)
    if result < 0 and result >= -4095 then return (@cint)(-result) end
    return 0
  end
  local path: [32]cchar = {}
  pthread_comm_path(tid, &path[0])
  local fd = openat(-100_cint, &path[0], 0_cint, 0_cuint)
  if fd < 0 then
    local error_code = nelibc_errno_location()[0]
    if error_code == 2 then return 3 end -- ESRCH: target exited
    return error_code
  end
  local result = nelibc_raw_syscall3(0_culong, (@culong)(fd),
      (@culong)((@usize)(name)), (@culong)(length)) -- read
  close(fd)
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  if result <= 0 then return 3 end -- ESRCH
  name[(@csize)(result - 1_clong)] = 0_cchar -- strip procfs newline
  return 0
end

local function pthread_setname_np(thread: pointer,
    name: *[0]cchar <const>): cint <cexport, codename 'pthread_setname_np'>
  if name == nilptr then return 22 end -- EINVAL
  local name_length: csize = 0
  while name_length < 16_csize and name[name_length] ~= 0_cchar do
    name_length = name_length + 1_csize
  end
  if name_length > 15_csize then return 34 end -- ERANGE
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  if thread == pthread_self() then
    local result = nelibc_raw_syscall6(157_culong, 15_culong,
        (@culong)((@usize)(name)), 0_culong, 0_culong, 0_culong, 0_culong)
    if result < 0 and result >= -4095 then return (@cint)(-result) end
    return 0
  end
  local path: [32]cchar = {}
  pthread_comm_path(tid, &path[0])
  local fd = openat(-100_cint, &path[0], 1_cint | 524288_cint, 0_cuint)
  if fd < 0 then
    local error_code = nelibc_errno_location()[0]
    if error_code == 2 then return 3 end -- ESRCH: target exited
    return error_code
  end
  local result = nelibc_raw_syscall3(1_culong, (@culong)(fd),
      (@culong)((@usize)(name)), (@culong)(name_length)) -- write
  close(fd)
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  if result ~= (@clong)(name_length) then return 5 end -- EIO
  return 0
end

local function pthread_kill(thread: pointer, signal: cint): cint <cexport, codename 'pthread_kill'>
  if signal < 0 or signal > 64 or signal == 32 then return 22 end -- EINVAL
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  local pid = nelibc_raw_syscall3(39_culong, 0_culong, 0_culong, 0_culong)
  if pid < 0 then return 3 end -- ESRCH
  local result = nelibc_raw_syscall3(234_culong, (@culong)(pid),
      (@culong)(tid), (@culong)(signal))
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  return 0
end

local function pthread_getcpuclockid(thread: pointer, clock_id: *[0]cint): cint <cexport, codename 'pthread_getcpuclockid'>
  if clock_id == nilptr then return 22 end -- EINVAL
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  -- Linux make_thread_cpuclock(tid, CPUCLOCK_SCHED) encodes (~tid << 3) | 6.
  clock_id[0] = (@cint)(((~(@cuint)(tid)) << 3) | 6_cuint)
  return 0
end

local function pthread_target_context(thread: pointer): *PthreadContext <inline>
  if initial_thread_identity ~= nilptr and thread == initial_thread_identity then
    return &initial_thread_context
  end
  if thread == nilptr then return nilptr end
  local state = (@*PthreadObject)(thread)
  if state.magic ~= PTHREAD_OBJECT_MAGIC then return nilptr end
  return &state.context
end

local function pthread_getschedparam(thread: pointer, policy: *[0]cint,
    param: *SchedParam): cint <cexport, codename 'pthread_getschedparam'>
  if policy == nilptr or param == nilptr then return 22 end -- EINVAL
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  local context = pthread_target_context(thread)
  if context ~= nilptr then pthread_priority_context_lock(context) end
  if context ~= nilptr and context.protect_mutexes ~= nilptr then
    policy[0] = context.protect_base_policy
    param.sched_priority = context.protect_base_priority
    pthread_priority_context_unlock(context)
    return 0
  end
  if context ~= nilptr then pthread_priority_context_unlock(context) end
  local sched_policy = nelibc_raw_syscall3(145_culong, (@culong)(tid),
                                           0_culong, 0_culong)
  if sched_policy < 0 and sched_policy >= -4095 then return (@cint)(-sched_policy) end
  local sched_param: SchedParam
  local result = nelibc_raw_syscall3(143_culong, (@culong)(tid),
      (@culong)((@usize)(&sched_param)), 0_culong)
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  policy[0] = (@cint)(sched_policy)
  param.sched_priority = sched_param.sched_priority
  return 0
end

local function pthread_setschedparam(thread: pointer, policy: cint,
    param: *SchedParam): cint <cexport, codename 'pthread_setschedparam'>
  if param == nilptr or not pthread_sched_priority_valid(policy, param.sched_priority) then
    return 22 -- EINVAL
  end
  local tid: cint
  local thread_error = pthread_target_tid(thread, &tid)
  if thread_error ~= 0 then return thread_error end
  local context = pthread_target_context(thread)
  if context ~= nilptr then pthread_priority_context_lock(context) end
  if context ~= nilptr and context.protect_mutexes ~= nilptr then
    if not pthread_priority_protect_can_set(context, policy,
                                             param.sched_priority) then
      pthread_priority_context_unlock(context)
      return 22 -- EINVAL: base priority exceeds an owned ceiling
    end
    local old_policy = context.protect_base_policy
    local old_priority = context.protect_base_priority
    context.protect_base_policy = policy
    context.protect_base_priority = param.sched_priority
    local protect_result = pthread_priority_protect_refresh(context, tid)
    if protect_result ~= 0 then
      context.protect_base_policy = old_policy
      context.protect_base_priority = old_priority
      pthread_priority_protect_refresh(context, tid)
      pthread_priority_context_unlock(context)
      return protect_result
    end
    context.sched_policy = policy
    context.sched_priority = param.sched_priority
    pthread_priority_context_unlock(context)
    return 0
  end
  local result = nelibc_raw_syscall3(144_culong, (@culong)(tid),
      (@culong)(policy), (@culong)((@usize)(param)))
  if result < 0 and result >= -4095 then
    if context ~= nilptr then pthread_priority_context_unlock(context) end
    return (@cint)(-result)
  end
  if context ~= nilptr then
    context.sched_policy = policy
    context.sched_priority = param.sched_priority
    pthread_priority_context_unlock(context)
  end
  return 0
end

local function pthread_setschedprio(thread: pointer, priority: cint): cint <cexport, codename 'pthread_setschedprio'>
  local policy: cint
  local param: SchedParam
  local result = pthread_getschedparam(thread, &policy, &param)
  if result ~= 0 then return result end
  param.sched_priority = priority
  return pthread_setschedparam(thread, policy, &param)
end

local function pthread_exit(result: pointer): void <cexport, codename 'pthread_exit'>
  local context = pthread_current_context()
  pthread_context_exit(context, result)
end

local function pthread_cleanup_push(routine: function(pointer): void, arg: pointer): void <cexport, codename '__nelibc_pthread_cleanup_push'>
  local context = pthread_current_context()
  if context == nilptr or routine == nilptr or context.cleanup_count >= 32 then return end
  context.cleanup_entries[context.cleanup_count].routine = routine
  context.cleanup_entries[context.cleanup_count].arg = arg
  context.cleanup_count = context.cleanup_count + 1
end

local function pthread_cleanup_pop(execute: cint): void <cexport, codename '__nelibc_pthread_cleanup_pop'>
  local context = pthread_current_context()
  if context == nilptr or context.cleanup_count <= 0 then return end
  context.cleanup_count = context.cleanup_count - 1
  local entry = context.cleanup_entries[context.cleanup_count]
  if execute ~= 0 and entry.routine ~= nilptr then entry.routine(entry.arg) end
end
