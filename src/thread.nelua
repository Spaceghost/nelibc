  attr.magic = 0
  return 0
end

local function pthread_condattr_setpshared(attr: *PthreadCondAttr, pshared: cint): cint <cexport, codename 'pthread_condattr_setpshared'>
  if not pthread_condattr_valid(attr) or (pshared ~= 0 and pshared ~= 1) then return 22 end -- EINVAL
  attr.pshared = pshared
  return 0
