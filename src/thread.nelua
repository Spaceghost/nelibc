local function pthread_condattr_getpshared(attr: *PthreadCondAttr, pshared: *[0]cint): cint <cexport, codename 'pthread_condattr_getpshared'>
  if not pthread_condattr_valid(attr) or pshared == nilptr then return 22 end -- EINVAL
  pshared[0] = attr.pshared
  return 0
