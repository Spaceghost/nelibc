local function pthread_cond_init(cond: *PthreadCond, attr: *PthreadCondAttr): cint <cexport, codename 'pthread_cond_init'>
  if cond == nilptr then return 22 end -- EINVAL
  local pshared: cint = 0
  if attr ~= nilptr then
    if not pthread_condattr_valid(attr) then return 22 end -- EINVAL
    pshared = attr.pshared
  end
  cond.sequence = 0
  cond.waiters = 0
  cond.pshared = pshared
  cond.magic = PTHREAD_COND_MAGIC
  return 0
end

local function pthread_cond_destroy(cond: *PthreadCond): cint <cexport, codename 'pthread_cond_destroy'>
  if not pthread_cond_valid(cond) then return 22 end -- EINVAL
  if nelibc_atomic_load_int(&cond.waiters) ~= 0 then return 16 end -- EBUSY
  cond.magic = 0
  return 0
end

local function pthread_cond_wait_internal(cond: *PthreadCond, mutex: *PthreadMutex, abstime: *Timespec): cint
  if not pthread_cond_valid(cond) or not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  pthread_testcancel()
  if cond.pshared ~= mutex.pshared then return 22 end -- EINVAL
  if abstime ~= nilptr and (abstime.tv_nsec < 0 or abstime.tv_nsec >= 1000000000) then
    return 22 -- EINVAL
  end
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if nelibc_atomic_load_int(&mutex.owner) ~= tid then return 1 end -- EPERM
  if mutex.kind == 1 and mutex.count ~= 1 then return 22 end -- EINVAL
  local sequence = nelibc_atomic_load_int(&cond.sequence)
  local context = nelibc_thread_current_pthread_context()
  nelibc_atomic_fetch_add_int(&cond.waiters, 1)
  local unlock_result = pthread_mutex_unlock(mutex)
  if unlock_result ~= 0 then
    nelibc_atomic_fetch_add_int(&cond.waiters, -1)
    return unlock_result
  end
  local wait_operation: culong = 0_culong
  local timeout_pointer: culong = 0_culong
  local futex_mask: culong = 0_culong
  if abstime ~= nilptr then
    wait_operation = 265_culong -- FUTEX_WAIT_BITSET | FUTEX_CLOCK_REALTIME
    timeout_pointer = (@culong)((@usize)(abstime))
    futex_mask = 0xFFFFFFFF_culong -- FUTEX_BITSET_MATCH_ANY
  end
  if cond.pshared == 0 then
    if abstime ~= nilptr then wait_operation = wait_operation | 128_culong
    else wait_operation = 128_culong end -- FUTEX_PRIVATE_FLAG
  end
  if context ~= nilptr then
    if cond.pshared == 0 then context.cancel_wait_wake_operation = 129
    else context.cancel_wait_wake_operation = 1 end
    nelibc_atomic_store_pointer(&context.cancel_wait_address, (@pointer)(&cond.sequence))
    if context.cancel_state == PTHREAD_CANCEL_ENABLE and
       nelibc_atomic_load_int(&context.cancel_pending) ~= 0 then
      pthread_cancel_wake(context)
    end
  end
  local wait_result = nelibc_raw_syscall6(
    202_culong, (@culong)((@usize)(&cond.sequence)), wait_operation,
    (@culong)(sequence), timeout_pointer, 0_culong, futex_mask
  )
  local wait_error: cint = 0
  if wait_result < 0 and wait_result >= -4095 then
    wait_error = (@cint)(-wait_result)
    if wait_error == 4 or wait_error == 11 then wait_error = 0 end -- EINTR/EAGAIN are spurious returns
  end
  if context ~= nilptr then nelibc_atomic_store_pointer(&context.cancel_wait_address, nilptr) end
  nelibc_atomic_fetch_add_int(&cond.waiters, -1)
  local lock_result = pthread_mutex_lock(mutex)
  if lock_result ~= 0 then return lock_result end
  pthread_testcancel()
  return wait_error
end

local function pthread_cond_wait(cond: *PthreadCond, mutex: *PthreadMutex): cint <cexport, codename 'pthread_cond_wait'>
  return pthread_cond_wait_internal(cond, mutex, nilptr)
end

local function pthread_cond_timedwait(cond: *PthreadCond, mutex: *PthreadMutex, abstime: *Timespec): cint <cexport, codename 'pthread_cond_timedwait'>
  if abstime == nilptr then return 22 end -- EINVAL
  return pthread_cond_wait_internal(cond, mutex, abstime)
end

local function pthread_cond_signal(cond: *PthreadCond): cint <cexport, codename 'pthread_cond_signal'>
  if not pthread_cond_valid(cond) then return 22 end -- EINVAL
  nelibc_atomic_fetch_add_int(&cond.sequence, 1)
  if nelibc_atomic_load_int(&cond.waiters) ~= 0 then
    local operation: culong = 129_culong
    if cond.pshared ~= 0 then operation = 1_culong end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&cond.sequence)),
                        operation, 1_culong, 0_culong, 0_culong, 0_culong)
  end
  return 0
end

local function pthread_cond_broadcast(cond: *PthreadCond): cint <cexport, codename 'pthread_cond_broadcast'>
  if not pthread_cond_valid(cond) then return 22 end -- EINVAL
  nelibc_atomic_fetch_add_int(&cond.sequence, 1)
  if nelibc_atomic_load_int(&cond.waiters) ~= 0 then
    local operation: culong = 129_culong
    if cond.pshared ~= 0 then operation = 1_culong end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&cond.sequence)),
                        operation, 2147483647_culong, 0_culong, 0_culong, 0_culong)
  end
  return 0
end

local function semaphore_valid(sem: *Semaphore): boolean <inline>
  return sem ~= nilptr and (sem.magic == SEMAPHORE_MAGIC or
    sem.magic == (SEMAPHORE_MAGIC | 0x8000000000000000_culong))
end

local function semaphore_shared(sem: *Semaphore): boolean <inline>
  return (sem.magic & 0x8000000000000000_culong) ~= 0_culong
end

local function sem_init(sem: *Semaphore, pshared: cint, value: cuint): cint <cexport, codename 'sem_init'>
  if sem == nilptr or value > 2147483647_cuint then
    nelibc_errno_location()[0] = 22; return -1
  end
  sem.magic = SEMAPHORE_MAGIC
  if pshared ~= 0 then sem.magic = SEMAPHORE_MAGIC | 0x8000000000000000_culong end
  sem.value = (@cint)(value)
  sem.sequence = 0
  sem.waiters = 0
  return 0
end

local function sem_destroy(sem: *Semaphore): cint <cexport, codename 'sem_destroy'>
  if not semaphore_valid(sem) then nelibc_errno_location()[0] = 22; return -1 end
  if nelibc_atomic_load_int(&sem.waiters) ~= 0 then nelibc_errno_location()[0] = 16; return -1 end
  sem.magic = 0
  return 0
end

local function sem_trywait(sem: *Semaphore): cint <cexport, codename 'sem_trywait'>
  if not semaphore_valid(sem) then nelibc_errno_location()[0] = 22; return -1 end
  while true do
    local value = nelibc_atomic_load_int(&sem.value)
    if value == 0 then nelibc_errno_location()[0] = 11; return -1 end
    if nelibc_atomic_cas_int(&sem.value, value, value - 1) == 0 then return 0 end
  end
end

local function sem_post(sem: *Semaphore): cint <cexport, codename 'sem_post'>
  if not semaphore_valid(sem) then nelibc_errno_location()[0] = 22; return -1 end
  while true do
    local value = nelibc_atomic_load_int(&sem.value)
    if value == 2147483647 then nelibc_errno_location()[0] = 75; return -1 end
    if nelibc_atomic_cas_int(&sem.value, value, value + 1) == 0 then break end
  end
  if nelibc_atomic_load_int(&sem.waiters) ~= 0 then
    nelibc_atomic_fetch_add_int(&sem.sequence, 1)
    local operation: culong = 129_culong
    if semaphore_shared(sem) then operation = 1_culong end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&sem.sequence)),
                        operation, 1_culong, 0_culong, 0_culong, 0_culong)
  end
  return 0
end

local function semaphore_wait(sem: *Semaphore, abstime: *Timespec, timed: boolean,
                              clock_id: cint): cint
  if not semaphore_valid(sem) then
    nelibc_errno_location()[0] = 22; return -1
  end
  pthread_testcancel()
  while true do
    local value = nelibc_atomic_load_int(&sem.value)
    if value > 0 and nelibc_atomic_cas_int(&sem.value, value, value - 1) == 0 then return 0 end
    if timed then
      if abstime == nilptr then
        nelibc_errno_location()[0] = 22 -- EINVAL
        return -1
      end
      if abstime.tv_nsec < 0 or abstime.tv_nsec >= 1000000000 then
        nelibc_errno_location()[0] = 22 -- EINVAL
        return -1
      end
    end
    local sequence = nelibc_atomic_load_int(&sem.sequence)
    local context = nelibc_thread_current_pthread_context()
    nelibc_atomic_fetch_add_int(&sem.waiters, 1)
    if context ~= nilptr then
      if semaphore_shared(sem) then context.cancel_wait_wake_operation = 1
      else context.cancel_wait_wake_operation = 129 end
      nelibc_atomic_store_pointer(&context.cancel_wait_address, (@pointer)(&sem.sequence))
      if context.cancel_state == PTHREAD_CANCEL_ENABLE and
         nelibc_atomic_load_int(&context.cancel_pending) ~= 0 then pthread_cancel_wake(context) end
    end
    -- A post may have observed no waiters just before we registered. Recheck
    -- both the token count and sequence before entering the kernel.
    if nelibc_atomic_load_int(&sem.value) > 0 or
       nelibc_atomic_load_int(&sem.sequence) ~= sequence then
      if context ~= nilptr then nelibc_atomic_store_pointer(&context.cancel_wait_address, nilptr) end
      nelibc_atomic_fetch_add_int(&sem.waiters, -1)
      continue
    end
    local operation: culong = 0_culong
    local timeout_pointer: culong = 0_culong
    local mask: culong = 0_culong
    if abstime ~= nilptr then
      operation = 9_culong -- FUTEX_WAIT_BITSET (CLOCK_MONOTONIC)
      if clock_id == 0_cint then operation = 265_culong end -- FUTEX_CLOCK_REALTIME
      timeout_pointer = (@culong)((@usize)(abstime))
      mask = 0xFFFFFFFF_culong
    end
    if not semaphore_shared(sem) then operation = operation | 128_culong end
    local result = nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&sem.sequence)),
      operation, (@culong)(sequence), timeout_pointer, 0_culong, mask)
    if context ~= nilptr then nelibc_atomic_store_pointer(&context.cancel_wait_address, nilptr) end
    nelibc_atomic_fetch_add_int(&sem.waiters, -1)
    pthread_testcancel()
    if result == -110 then nelibc_errno_location()[0] = 110; return -1 end
    if result == -4 then
      local cancel_context = nelibc_thread_current_pthread_context()
      if cancel_context ~= nilptr and cancel_context.cancel_state == PTHREAD_CANCEL_DISABLE and
         nelibc_atomic_load_int(&cancel_context.cancel_pending) ~= 0 then
        continue -- Hide the internal cancellation signal while cancellation is disabled.
      end
      nelibc_errno_location()[0] = 4
      return -1
    end
    if result < 0 and result ~= -11 then
      nelibc_errno_location()[0] = (@cint)(-result); return -1
    end
  end
end

local function sem_wait(sem: *Semaphore): cint <cexport, codename 'sem_wait'>
  return semaphore_wait(sem, nilptr, false, 0_cint)
end

local function sem_timedwait(sem: *Semaphore, abstime: *Timespec): cint <cexport, codename 'sem_timedwait'>
  return semaphore_wait(sem, abstime, true, 0_cint)
end

local function sem_clockwait(sem: *Semaphore, clock_id: cint,
                             abstime: *Timespec): cint <cexport, codename 'sem_clockwait'>
  if clock_id ~= 0_cint and clock_id ~= 1_cint then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  return semaphore_wait(sem, abstime, true, clock_id)
end

local function sem_getvalue(sem: *Semaphore, value: *[0]cint): cint <cexport, codename 'sem_getvalue'>
  if not semaphore_valid(sem) or value == nilptr then nelibc_errno_location()[0] = 22; return -1 end
  value[0] = nelibc_atomic_load_int(&sem.value)
  return 0
end

local function named_sem_registry_lock(): void
  while nelibc_atomic_cas_int(&named_semaphore_handles_lock, 0, 1) ~= 0 do
    nelibc_raw_syscall3(24_culong, 0_culong, 0_culong, 0_culong)
  end
end

local function named_sem_registry_unlock(): void
  nelibc_atomic_store_int(&named_semaphore_handles_lock, 0)
end

local function named_sem_build_path(name: *[0]cchar <const>, path: *[0]cchar): cint
  if name == nilptr or name[0] ~= 47_cchar then return -1 end
  local name_length = strlen(name)
  if name_length < 2_csize or name_length > 252_csize then return -1 end
  for i: csize = 1, name_length - 1_csize do
    if name[i] == 47_cchar then return -1 end
  end
  -- Linux reserves a four-byte "sem." prefix inside /dev/shm's NAME_MAX.
  if name_length - 1_csize > 251_csize then return -1 end
  local prefix: [13]cchar = {
    47_cchar, 100_cchar, 101_cchar, 118_cchar, 47_cchar,
    115_cchar, 104_cchar, 109_cchar, 47_cchar,
    115_cchar, 101_cchar, 109_cchar, 46_cchar
  }
  for i: csize = 0, 12 do path[i] = prefix[i] end
  for i: csize = 1, name_length - 1_csize do path[12_csize + i] = name[i] end
  path[12_csize + name_length] = 0_cchar
  return (@cint)(name_length + 12_csize)
end

local function nelibc_sem_open_impl(name: *[0]cchar <const>, oflag: cint,
                                    mode: cuint, value: cuint): *Semaphore <cexport, codename 'nelibc_sem_open_impl'>
  local path: [265]cchar = {}
  local path_length = named_sem_build_path(name, &path[0])
  if path_length < 0 or (oflag & ~(64_cint | 128_cint)) ~= 0_cint or
     ((oflag & 128_cint) ~= 0_cint and (oflag & 64_cint) == 0_cint) then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local open_flags: cint = 2_cint | 524288_cint | 131072_cint
  local created = false
  local fd: cint = -1
  if (oflag & 64_cint) ~= 0_cint and value > 2147483647_cuint then
    -- mode and value are ignored when opening an existing semaphore.
    fd = openat(-100_cint, &path[0], open_flags, 0_cuint)
    if fd < 0 then
      if nelibc_errno_location()[0] == 2 then nelibc_errno_location()[0] = 22 end
      return nilptr
    end
    if (oflag & 128_cint) ~= 0_cint then
      close(fd)
      nelibc_errno_location()[0] = 17 -- EEXIST takes precedence for O_EXCL.
      return nilptr
    end
  else
    if (oflag & 64_cint) ~= 0_cint then open_flags = open_flags | 64_cint | 128_cint end
    fd = openat(-100_cint, &path[0], open_flags, mode)
    if fd < 0 then
      local open_error = nelibc_errno_location()[0]
      if (oflag & 64_cint) == 0_cint or open_error ~= 17 or (oflag & 128_cint) ~= 0_cint then
        return nilptr
      end
      fd = openat(-100_cint, &path[0], 2_cint | 524288_cint | 131072_cint, 0_cuint)
      if fd < 0 then return nilptr end
    else
      created = true
    end
  end
  -- flock serializes the first initializer against concurrent sem_open calls.
  local lock_result = nelibc_raw_syscall6(73_culong, (@culong)(fd), 2_culong,
                                           0_culong, 0_culong, 0_culong, 0_culong)
  if lock_result < 0 then
    nelibc_errno_location()[0] = (@cint)(-lock_result)
    close(fd)
    if created then unlink(&path[0]) end
    return nilptr
  end
  if created then
    if ftruncate(fd, 16_clong) ~= 0 then
      local error_code = nelibc_errno_location()[0]
      nelibc_raw_syscall6(73_culong, (@culong)(fd), 8_culong, 0_culong, 0_culong, 0_culong, 0_culong)
      close(fd); unlink(&path[0]); nelibc_errno_location()[0] = error_code
      return nilptr
    end
  else
    local size: clong = -1_clong
    for attempt: cint = 0, 9999 do
      size = lseek(fd, 0_clong, 2_cint)
      if size < 0_clong then
        local error_code = nelibc_errno_location()[0]
        nelibc_raw_syscall6(73_culong, (@culong)(fd), 8_culong, 0_culong, 0_culong, 0_culong, 0_culong)
        close(fd); nelibc_errno_location()[0] = error_code
        return nilptr
      end
      if size ~= 0_clong then break end
      nelibc_raw_syscall6(73_culong, (@culong)(fd), 8_culong, 0_culong, 0_culong, 0_culong, 0_culong)
      nelibc_raw_syscall3(24_culong, 0_culong, 0_culong, 0_culong)
      lock_result = nelibc_raw_syscall6(73_culong, (@culong)(fd), 2_culong,
                                         0_culong, 0_culong, 0_culong, 0_culong)
      if lock_result < 0 then
        nelibc_errno_location()[0] = (@cint)(-lock_result); close(fd); return nilptr
      end
    end
    if size ~= 16_clong then
      nelibc_raw_syscall6(73_culong, (@culong)(fd), 8_culong, 0_culong, 0_culong, 0_culong, 0_culong)
      close(fd); nelibc_errno_location()[0] = 22; return nilptr
    end
  end
  local mapped = mmap(nilptr, 16_csize, 3_cint, 1_cint, fd, 0_clong)
  if mapped == (@pointer)(~0_csize) then
    local error_code = nelibc_errno_location()[0]
    nelibc_raw_syscall6(73_culong, (@culong)(fd), 8_culong, 0_culong, 0_culong, 0_culong, 0_culong)
    close(fd)
    if created then unlink(&path[0]) end
    nelibc_errno_location()[0] = error_code
    return nilptr
  end
  local semaphore = (@*Semaphore)(mapped)
  if created then
    semaphore.magic = SEMAPHORE_MAGIC | 0x8000000000000000_culong
    semaphore.value = (@cint)(value)
    semaphore.sequence = 0
    semaphore.waiters = 0
  elseif not semaphore_valid(semaphore) or not semaphore_shared(semaphore) then
    munmap(mapped, 16_csize)
    nelibc_raw_syscall6(73_culong, (@culong)(fd), 8_culong, 0_culong, 0_culong, 0_culong, 0_culong)
    close(fd); nelibc_errno_location()[0] = 22; return nilptr
  end
  local handle = (@*NamedSemaphoreHandle)(nelibc_malloc(24_csize))
  if handle == nilptr then
    munmap(mapped, 16_csize)
    nelibc_raw_syscall6(73_culong, (@culong)(fd), 8_culong, 0_culong, 0_culong, 0_culong, 0_culong)
    close(fd)
    if created then unlink(&path[0]) end
    nelibc_errno_location()[0] = 12 -- ENOMEM
    return nilptr
  end
  handle.semaphore = mapped
  handle.fd = fd
  named_sem_registry_lock()
  handle.next = named_semaphore_handles
  named_semaphore_handles = handle
  named_sem_registry_unlock()
  nelibc_raw_syscall6(73_culong, (@culong)(fd), 8_culong, 0_culong, 0_culong, 0_culong, 0_culong)
  return semaphore
end

local function sem_close(sem: *Semaphore): cint <cexport, codename 'sem_close'>
  if sem == nilptr then nelibc_errno_location()[0] = 22; return -1 end
  named_sem_registry_lock()
  local previous: *NamedSemaphoreHandle = nilptr
  local handle = named_semaphore_handles
  while handle ~= nilptr and handle.semaphore ~= (@pointer)(sem) do
    previous = handle
    handle = handle.next
  end
  if handle == nilptr then
    named_sem_registry_unlock()
    nelibc_errno_location()[0] = 22
    return -1
  end
  if previous == nilptr then named_semaphore_handles = handle.next
  else previous.next = handle.next end
  named_sem_registry_unlock()
  local unmap_result = munmap(handle.semaphore, 16_csize)
  local close_result = close(handle.fd)
  nelibc_free((@pointer)(handle))
  if unmap_result ~= 0 or close_result ~= 0 then return -1 end
  return 0
end

local function sem_unlink(name: *[0]cchar <const>): cint <cexport, codename 'sem_unlink'>
  local path: [265]cchar = {}
  if named_sem_build_path(name, &path[0]) < 0 then nelibc_errno_location()[0] = 22; return -1 end
  return unlink(&path[0])
end

local function pthread_once(control: *[0]cint, init_routine: function(): void): cint <cexport, codename 'pthread_once'>
  if control == nilptr or init_routine == nilptr then return 22 end -- EINVAL
  while true do
    local state = nelibc_atomic_load_int(control)
    if state == 2 then return 0 end
    if state == 0 then
      if nelibc_atomic_cas_int(control, 0, 1) == 0 then
        init_routine()
        nelibc_atomic_store_int(control, 2)
        nelibc_raw_syscall6(202_culong, (@culong)((@usize)(control)),
                            129_culong, 2147483647_culong,
                            0_culong, 0_culong, 0_culong)
        return 0
      end
    elseif state == 1 then
      nelibc_raw_syscall6(202_culong, (@culong)((@usize)(control)),
                          128_culong, 1_culong, 0_culong, 0_culong, 0_culong)
    else
      return 22 -- EINVAL
    end
  end
end

local function pthread_create(thread: *[0]pointer, attr: *PthreadAttr, start: function(pointer): pointer, arg: pointer): cint <cexport, codename 'pthread_create'>
  if thread == nilptr or start == nilptr then return 22 end -- EINVAL
  local stacksize: csize = STACK_SIZE
  if attr ~= nilptr then
    if not pthread_attr_valid(attr) then return 22 end -- EINVAL
    if attr.detachstate ~= 0 and attr.detachstate ~= 1 then return 22 end -- EINVAL
    stacksize = attr.stacksize
  end
  local signal_error = nelibc_thread_cancel_signal_install()
  if signal_error ~= 0 then return signal_error end
  local object = nelibc_malloc(1024_csize)
  if object == nilptr then return 12 end -- ENOMEM
  local tid_word = nelibc_thread_tid_slot_alloc()
  if tid_word == nilptr then
    nelibc_free(object)
    return 11 -- EAGAIN
  end
  local state = (@*PthreadObject)(object)
  state.magic = PTHREAD_OBJECT_MAGIC
  state.context.start = start
  state.context.arg = arg
  state.context.result = nilptr
  state.context.handle = &state.handle
  state.context.object = object
  state.context.cancel_pending = 0
  state.context.cancel_state = PTHREAD_CANCEL_ENABLE
  state.context.cancel_wait_address = nilptr
  state.context.cancel_wait_wake_operation = 0
  state.context.cleanup_count = 0
  if attr ~= nilptr and attr.detachstate == 1 then state.context.lifecycle = 3
  else state.context.lifecycle = 0 end
  state.handle.state = 0
  state.handle.tid_word = tid_word
  if thread_spawn(&state.handle, (@pointer)(pthread_trampoline), &state.context,
                  stacksize, object, &state.context, attr ~= nilptr and attr.detachstate == 1) ~= 0 then
    local error_code = nelibc_errno_location()[0]
    nelibc_thread_tid_slot_release(tid_word)
    nelibc_free(object)
    if error_code == 0 then return 11 end -- EAGAIN
    return error_code
  end
  thread[0] = object
  return 0
end

local function pthread_join(thread: pointer, result: *[0]pointer): cint <cexport, codename 'pthread_join'>
  if thread == nilptr then return 3 end -- ESRCH
  if thread == nelibc_thread_current_identity() then return 35 end -- EDEADLK
  local state = (@*PthreadObject)(thread)
  if state.magic ~= PTHREAD_OBJECT_MAGIC then return 3 end -- ESRCH
  local lifecycle = nelibc_atomic_load_int(&state.context.lifecycle)
  while true do
    if lifecycle ~= 0 and lifecycle ~= 2 then return 22 end -- EINVAL
    if nelibc_atomic_cas_int(&state.context.lifecycle, lifecycle, 4) == 0 then break end
    lifecycle = nelibc_atomic_load_int(&state.context.lifecycle)
  end
  local tid_word: *[0]cint = state.handle.tid_word
  if thread_wait(&state.handle) ~= 0 then return nelibc_errno_location()[0] end
  if result ~= nilptr then result[0] = state.context.result end
  nelibc_thread_tid_slot_release(tid_word)
  state.magic = 0
  nelibc_free(thread)
  return 0
end

local function pthread_detach(thread: pointer): cint <cexport, codename 'pthread_detach'>
  if thread == nilptr then return 3 end -- ESRCH
  local state = (@*PthreadObject)(thread)
  if state.magic ~= PTHREAD_OBJECT_MAGIC then return 3 end -- ESRCH
  local lifecycle = nelibc_atomic_load_int(&state.context.lifecycle)
  while true do
    if lifecycle == 0 then
      if nelibc_atomic_cas_int(&state.context.lifecycle, 0, 1) == 0 then return 0 end
    elseif lifecycle == 2 then
      if nelibc_atomic_cas_int(&state.context.lifecycle, 2, 6) == 0 then
        local tid_word: *[0]cint = state.handle.tid_word
        if thread_wait(&state.handle) ~= 0 then return nelibc_errno_location()[0] end
        nelibc_thread_tid_slot_release(tid_word)
        state.magic = 0
        nelibc_free(thread)
        return 0
      end
    else
      return 22 -- EINVAL: detached or already joined/detached
    end
    lifecycle = nelibc_atomic_load_int(&state.context.lifecycle)
  end
end

local function pthread_equal(first: pointer, second: pointer): cint <cexport, codename 'pthread_equal'>
  if first == second then return 1 end
  return 0
end

local function pthread_self(): pointer <cexport, codename 'pthread_self'>
  return nelibc_thread_current_identity()
end

local function pthread_exit(result: pointer): void <cexport, codename 'pthread_exit'>
  local context = nelibc_thread_current_pthread_context()
  pthread_context_exit(context, result)
end

local function pthread_cleanup_push(routine: function(pointer): void, arg: pointer): void <cexport, codename '__nelibc_pthread_cleanup_push'>
  local context = nelibc_thread_current_pthread_context()
  if context == nilptr or routine == nilptr or context.cleanup_count >= 32 then return end
  context.cleanup_entries[context.cleanup_count].routine = routine
  context.cleanup_entries[context.cleanup_count].arg = arg
  context.cleanup_count = context.cleanup_count + 1
end

local function pthread_cleanup_pop(execute: cint): void <cexport, codename '__nelibc_pthread_cleanup_pop'>
  local context = nelibc_thread_current_pthread_context()
  if context == nilptr or context.cleanup_count <= 0 then return end
  context.cleanup_count = context.cleanup_count - 1
  local entry = context.cleanup_entries[context.cleanup_count]
  if execute ~= 0 and entry.routine ~= nilptr then entry.routine(entry.arg) end
end
