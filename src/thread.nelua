local function pthread_mutex_valid(mutex: *PthreadMutex): boolean <inline>
  return mutex ~= nilptr and mutex.magic == PTHREAD_MUTEX_MAGIC and
         pthread_mutex_type_valid(mutex.kind) and
         (mutex.pshared == 0 or mutex.pshared == 1)
end

local function pthread_mutex_init(mutex: *PthreadMutex, attr: *PthreadMutexAttr): cint <cexport, codename 'pthread_mutex_init'>
  if mutex == nilptr then return 22 end -- EINVAL
  local kind: cint = 0
  if attr ~= nilptr then
    if not pthread_mutexattr_valid(attr) then return 22 end -- EINVAL
    kind = attr.kind
  end
  if not pthread_mutex_type_valid(kind) then return 22 end -- EINVAL
  if attr ~= nilptr and attr.pshared ~= 0 and attr.pshared ~= 1 then return 22 end -- EINVAL
  mutex.state = 0
  mutex.kind = kind
  mutex.owner = 0
  mutex.count = 0
  mutex.pshared = 0
  if attr ~= nilptr then mutex.pshared = attr.pshared end
  mutex.magic = PTHREAD_MUTEX_MAGIC
  return 0
end

local function pthread_mutex_destroy(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_destroy'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  if nelibc_atomic_load_int(&mutex.state) ~= 0 then return 16 end -- EBUSY
  mutex.magic = 0
  mutex.owner = 0
  mutex.count = 0
  return 0
end

local function pthread_mutex_owner_check(mutex: *PthreadMutex, tid: cint): cint <inline>
  if nelibc_atomic_load_int(&mutex.owner) ~= tid then return 0 end
  if mutex.kind == 1 then
    if mutex.count == 2147483647 then return 11 end -- EAGAIN
    mutex.count = mutex.count + 1
    return 1
  end
  if mutex.kind == 2 then return 35 end -- EDEADLK
  return -1 -- A normal mutex self-lock blocks.
end

local function pthread_mutex_acquire(mutex: *PthreadMutex): void
  if nelibc_atomic_cas_int(&mutex.state, 0, 1) == 0 then return end
  local operation: culong = 0_culong
  if mutex.pshared == 0 then operation = 128_culong end -- FUTEX_WAIT_PRIVATE
  while true do
    local previous = nelibc_atomic_exchange_int(&mutex.state, 2)
    if previous == 0 then return end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&mutex.state)),
                        operation, 2_culong, 0_culong, 0_culong, 0_culong)
  end
end

local function pthread_mutex_lock(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_lock'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  local owner_result = pthread_mutex_owner_check(mutex, tid)
  if owner_result == 1 then return 0 end
  if owner_result > 1 then return owner_result end
  pthread_mutex_acquire(mutex)
  mutex.count = 1
  nelibc_atomic_store_int(&mutex.owner, tid)
  return 0
end

local function pthread_mutex_trylock(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_trylock'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if nelibc_atomic_load_int(&mutex.owner) == tid then
    if mutex.kind == 1 then
      if mutex.count == 2147483647 then return 11 end -- EAGAIN
      mutex.count = mutex.count + 1
      return 0
    end
    return 16 -- EBUSY
  end
  if nelibc_atomic_cas_int(&mutex.state, 0, 1) ~= 0 then return 16 end -- EBUSY
  mutex.count = 1
  nelibc_atomic_store_int(&mutex.owner, tid)
  return 0
end

local function pthread_mutex_unlock(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_unlock'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if nelibc_atomic_load_int(&mutex.owner) ~= tid then return 1 end -- EPERM
  if mutex.kind == 1 and mutex.count > 1 then
    mutex.count = mutex.count - 1
    return 0
  end
  mutex.count = 0
  nelibc_atomic_store_int(&mutex.owner, 0)
  local previous = nelibc_atomic_exchange_int(&mutex.state, 0)
  if previous == 2 then
    local operation: culong = 1_culong
    if mutex.pshared == 0 then operation = 129_culong end -- FUTEX_WAKE_PRIVATE
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&mutex.state)),
                        operation, 1_culong, 0_culong, 0_culong, 0_culong)
  end
  return 0
end

local function pthread_condattr_valid(attr: *PthreadCondAttr): boolean <inline>
  return attr ~= nilptr and attr.magic == PTHREAD_COND_ATTR_MAGIC
