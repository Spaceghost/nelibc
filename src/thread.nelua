## pragmas.nogc = true
## pragmas.noentrypoint = true

-- Experimental Linux x86_64 thread runtime for the standalone profile.
local TLSLayout: type = @record{
  image_start: pointer,
  image_filesz: csize,
  image_memsz: csize,
  image_align: csize
}
local ThreadContext: type = @record{
  start: function(pointer): cint,
  arg: pointer,
  result: cint
}
local ThreadHandle: type = @record{
  context: ThreadContext,
  stack: pointer,
  tls: pointer,
  tls_size: csize,
  tid: cint,
  state: cint,
  stack_size: csize,
  cleanup_stack: pointer,
  cleanup_stack_size: csize,
  tid_word: *[0]cint
}
local PthreadRobustHead: type = @record{
  list_next: pointer,
  futex_offset: clong,
  list_op_pending: pointer
}
local PthreadRobustSlot: type = @record{
  head: PthreadRobustHead,
  tid: cint,
  state: cint
}
local PthreadCleanupEntry: type = @record{
  routine: function(pointer): void,
  arg: pointer
}
local PthreadContext: type = @record{
  start: function(pointer): pointer,
  arg: pointer,
  result: pointer,
  handle: *ThreadHandle,
  object: pointer,
  lifecycle: cint,
  cancel_pending: cint,
  cancel_defer_depth: cint,
  cancel_state: cint,
  cancel_type: cint,
  sched_policy: cint,
  sched_priority: cint,
  sched_inherit: cint,
  startup_gate: cint,
  cancel_wait_address: pointer,
  cancel_wait_wake_operation: cint,
  cleanup_count: cint,
  cleanup_entries: [32]PthreadCleanupEntry,
  robust_slot: *PthreadRobustSlot,
  robust_registered: cint,
  robust_pid: cint,
  protect_mutexes: pointer,
  protect_base_policy: cint,
  protect_base_priority: cint,
  protect_lock: cint
}
local SchedParam: type = @record{
  sched_priority: cint
}
local PthreadAttr: type = @record{
  magic: culong,
  detachstate: cint,
  scope: cint,
  stacksize: csize,
  guardsize: csize,
  inheritsched: cint,
  schedpolicy: cint,
  schedparam: SchedParam,
  stackaddr: pointer
}
local PthreadMutexAttr: type = @record{
  magic: culong,
  kind: cint,
  pshared: cint,
  robust: cint,
  protocol: cint,
  prioceiling: cint
}
local PthreadCondAttr: type = @record{
  magic: culong,
  pshared: cint,
  clockid: cint
}
local PthreadMutex: type = @record{
  magic: culong,
  state: cint,
  kind: cint,
  owner: cint,
  count: cint,
  pshared: cint,
  robust: cint,
  robust_state: cint,
  protocol: cint,
  robust_next: pointer,
  prioceiling: cint,
  protect_next: pointer
}
local PthreadCond: type = @record{
  magic: culong,
  sequence: cint,
  waiters: cint,
  pshared: cint,
  clockid: cint
}
local PthreadBarrierAttr: type = @record{
  magic: culong,
  pshared: cint
}
local PthreadBarrier: type = @record{
  magic: culong,
  count: cint,
  arrived: cint,
  generation: cint,
  pshared: cint
}
local PthreadRwlockAttr: type = @record{
  magic: culong,
  pshared: cint
}
local PthreadRwlock: type = @record{
  magic: culong,
  state: cint,
  writer: cint,
  waiting_writers: cint,
  sequence: cint,
  pshared: cint
}
local Semaphore: type = @record{
  magic: culong,
  value: cint,
  sequence: cint,
  waiters: cint
}
local NamedSemaphoreHandle: type = @record{
  semaphore: pointer,
  fd: cint,
  next: *NamedSemaphoreHandle
}
local PthreadKeyValue: type = @record{
  key: cuint,
  value: pointer
}
local PthreadObject: type = @record{
  magic: culong,
  handle: ThreadHandle,
  stack_addr: pointer,
  stack_size: csize,
  guard_size: csize,
  context: PthreadContext
}
local Timespec: type = @record{
  tv_sec: clong,
  tv_nsec: clong
}
local STACK_SIZE: csize <comptime> = 1048576
local PAGE_SIZE: csize <comptime> = 4096
local PTHREAD_STACK_MINIMUM: csize <comptime> = 16384
local CLEANUP_STACK_SIZE: csize <comptime> = 16384
local PTHREAD_ATTR_MAGIC: culong <comptime> = 0x4E454C4154545231
local PTHREAD_OBJECT_MAGIC: culong <comptime> = 0x4E454C4950544831
local PTHREAD_MUTEX_ATTR_MAGIC: culong <comptime> = 0x4E4D4154545231
local PTHREAD_MUTEX_MAGIC: culong <comptime> = 0x4E4D5458
local PTHREAD_MUTEX_STALLED: cint <comptime> = 0
local PTHREAD_MUTEX_ROBUST: cint <comptime> = 1
local PTHREAD_PRIO_NONE: cint <comptime> = 0
local PTHREAD_PRIO_INHERIT: cint <comptime> = 1
local PTHREAD_PRIO_PROTECT: cint <comptime> = 2
local FUTEX_LOCK_PI: culong <comptime> = 6
local FUTEX_UNLOCK_PI: culong <comptime> = 7
local FUTEX_TRYLOCK_PI: culong <comptime> = 8
local FUTEX_WAITERS: cint <comptime> = -2147483648
local FUTEX_OWNER_DIED: cint <comptime> = 1073741824
local FUTEX_TID_MASK: cint <comptime> = 1073741823
local ROBUST_LIST_FUTEX_OFFSET: clong <comptime> = -32
local ROBUST_SLOT_COUNT: csize <comptime> = 1024
local PTHREAD_COND_ATTR_MAGIC: culong <comptime> = 0x4E434154545231
local PTHREAD_COND_MAGIC: culong <comptime> = 0x4E434F4E44
local CLOCK_REALTIME: cint <comptime> = 0
local CLOCK_MONOTONIC: cint <comptime> = 1
local PTHREAD_BARRIER_ATTR_MAGIC: culong <comptime> = 0x4E424154545231
local PTHREAD_BARRIER_MAGIC: culong <comptime> = 0x4E42415252
local PTHREAD_RWLOCK_ATTR_MAGIC: culong <comptime> = 0x4E525741545452
local PTHREAD_RWLOCK_MAGIC: culong <comptime> = 0x4E52574C4F434B
local SEMAPHORE_MAGIC: culong <comptime> = 0x4E454C53454D31
local PTHREAD_CANCELED: pointer <comptime> = (@pointer)(~0_csize)
local PTHREAD_CANCEL_ENABLE: cint <comptime> = 0
local PTHREAD_CANCEL_DISABLE: cint <comptime> = 1
local PTHREAD_CANCEL_DEFERRED: cint <comptime> = 0
local PTHREAD_CANCEL_ASYNCHRONOUS: cint <comptime> = 1
local PTHREAD_INHERIT_SCHED: cint <comptime> = 0
local PTHREAD_EXPLICIT_SCHED: cint <comptime> = 1
local PTHREAD_SCOPE_SYSTEM: cint <comptime> = 0
local PTHREAD_SCOPE_PROCESS: cint <comptime> = 1
local SCHED_OTHER: cint <comptime> = 0
local SCHED_FIFO: cint <comptime> = 1
local SCHED_RR: cint <comptime> = 2
local default_thread_attr_lock: cint
local default_thread_attr_initialized: cint
local default_thread_attr: PthreadAttr
local pthread_concurrency_level: cint
local PTHREAD_KEY_COUNT: csize <comptime> = 128
local PTHREAD_KEY_INDEX_MASK: cuint <comptime> = 255
local pthread_key_lock: cint = 0
local pthread_robust_slot_lock: cint = 0
local pthread_robust_slots: [1024]PthreadRobustSlot = {}
local pthread_key_allocated: [128]cint = {}
local pthread_key_generations: [128]cuint = {}
local pthread_key_destructors: [128]pointer = {}
local initial_thread_context: PthreadContext = {}
local initial_thread_identity: pointer = nilptr
local initial_thread_tid: cint = 0
local named_semaphore_handles: *NamedSemaphoreHandle = nilptr
local named_semaphore_handles_lock: cint = 0
local MAX_CSIZE: csize <comptime> = ~0_csize

local function nelibc_raw_syscall3(number: culong, arg1: culong, arg2: culong, arg3: culong): clong <cimport> end
local function nelibc_raw_syscall6(number: culong, arg1: culong, arg2: culong, arg3: culong, arg4: culong, arg5: culong, arg6: culong): clong <cimport> end
local function nelibc_errno_location(): *[0]cint <cimport> end
local function nelibc_tls_layout(layout: *TLSLayout): void <cimport> end
local function nelibc_clone_thread(start: pointer, arg: pointer, stack_top: pointer, tls_tp: pointer, tid: *[0]cint): clong <cimport> end
local function nelibc_credential_sync_begin(): cint <cimport> end
local function nelibc_credential_sync_serve(): void <cimport> end
local function nelibc_credential_sync_end(): void <cimport> end
local function nelibc_thread_tid_load(tid: pointer): cint <cimport> end
local function nelibc_thread_current_identity(): pointer <cimport> end
local function nelibc_thread_current_pthread_context(): *PthreadContext <cimport> end
local function nelibc_thread_set_pthread_context(context: pointer): void <cimport> end
local function nelibc_thread_cancel_signal_install(): cint <cimport> end
local function nelibc_thread_cancel_signal_unblock(): cint <cimport> end
local function nelibc_thread_current_key_values(): pointer <cimport> end
local function nelibc_thread_set_key_values(values: pointer): void <cimport> end
local function nelibc_thread_detached_exit(stack: pointer, stack_size: csize, tls: pointer, tls_size: csize, cleanup_stack: pointer, cleanup_stack_size: csize): void <cimport> end
local function nelibc_thread_tid_slot_alloc(): *[0]cint <cimport> end
local function nelibc_thread_tid_slot_release(tid: *[0]cint): void <cimport> end
local function nelibc_atomic_load_int(value: *[0]cint): cint <cimport> end
local function nelibc_atomic_store_int(value: *[0]cint, next: cint): void <cimport> end
local function nelibc_atomic_cas_int(value: *[0]cint, expected: cint, next: cint): cint <cimport> end
local function nelibc_atomic_exchange_int(value: *[0]cint, next: cint): cint <cimport> end
local function nelibc_atomic_fetch_add_int(value: *[0]cint, delta: cint): cint <cimport> end
local function nelibc_atomic_load_pointer(value: *[0]pointer): pointer <cimport> end
local function nelibc_atomic_store_pointer(value: *[0]pointer, next: pointer): void <cimport> end
local function nelibc_malloc(size: csize): pointer <cimport> end
local function nelibc_free(ptr: pointer): void <cimport> end
local function openat(dirfd: cint, pathname: pointer <const>, flags: cint, mode: cuint): cint <cimport> end
local function close(fd: cint): cint <cimport> end
local function ftruncate(fd: cint, length: clong): cint <cimport> end
local function lseek(fd: cint, offset: clong, whence: cint): clong <cimport> end
local function mmap(address: pointer, length: csize, protection: cint, flags: cint, fd: cint, offset: clong): pointer <cimport> end
local function munmap(address: pointer, length: csize): cint <cimport> end
local function unlink(pathname: pointer <const>): cint <cimport> end
local function strlen(string: *[0]cchar <const>): csize <cimport> end

-- Async cancellation must not run cleanup handlers while this thread owns a
-- libc lock that those handlers or TLS destructors may need. If the reserved
-- signal arrives in the protected region, keep it pending and retrigger it
-- only after the lock has been released.
local function pthread_cancel_defer_begin(): void <inline>
  local context = nelibc_thread_current_pthread_context()
  if context ~= nilptr then context.cancel_defer_depth = context.cancel_defer_depth + 1 end
end

local function pthread_cancel_defer_end(): void <inline>
  local context = nelibc_thread_current_pthread_context()
  if context == nilptr or context.cancel_defer_depth <= 0 then return end
  context.cancel_defer_depth = context.cancel_defer_depth - 1
  if context.cancel_defer_depth == 0 and
     context.cancel_state == PTHREAD_CANCEL_ENABLE and
     context.cancel_type == PTHREAD_CANCEL_ASYNCHRONOUS and
     nelibc_atomic_load_int(&context.cancel_pending) ~= 0 then
    local pid = nelibc_raw_syscall3(39_culong, 0_culong, 0_culong, 0_culong)
    local tid = nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong)
    nelibc_raw_syscall3(234_culong, (@culong)(pid), (@culong)(tid), 32_culong)
  end
end

local function nelibc_pthread_cancel_defer_begin(): void <cexport, codename 'nelibc_pthread_cancel_defer_begin'>
  pthread_cancel_defer_begin()
end

local function nelibc_pthread_cancel_defer_end(): void <cexport, codename 'nelibc_pthread_cancel_defer_end'>
  pthread_cancel_defer_end()
end

local function pthread_robust_slot_lock_acquire(): void <inline>
  pthread_cancel_defer_begin()
  while nelibc_atomic_cas_int(&pthread_robust_slot_lock, 0, 1) ~= 0 do end
end

local function pthread_robust_slot_lock_release(): void <inline>
  nelibc_atomic_store_int(&pthread_robust_slot_lock, 0)
  pthread_cancel_defer_end()
end

local function pthread_robust_slot_alloc(): *PthreadRobustSlot
  pthread_robust_slot_lock_acquire()
  local pid = nelibc_raw_syscall3(39_culong, 0_culong, 0_culong, 0_culong)
  local index: csize = 0
  while index < ROBUST_SLOT_COUNT do
    local slot = &pthread_robust_slots[index]
    if slot.state == 2 and slot.tid > 0 then
      local alive = nelibc_raw_syscall3(234_culong, (@culong)(pid),
                                        (@culong)(slot.tid), 0_culong)
      if alive == -3 then slot.state = 0 end -- ESRCH: kernel completed robust-list exit
    end
    if slot.state == 0 then
      slot.state = 1
      slot.tid = 0
      slot.head.list_next = (@pointer)(&slot.head.list_next)
      slot.head.futex_offset = ROBUST_LIST_FUTEX_OFFSET
      slot.head.list_op_pending = nilptr
      pthread_robust_slot_lock_release()
      return slot
    end
    index = index + 1
  end
  pthread_robust_slot_lock_release()
  return nilptr
end

local function pthread_robust_slot_release(slot: *PthreadRobustSlot): void
  if slot == nilptr then return end
  pthread_robust_slot_lock_acquire()
  slot.tid = 0
  slot.state = 0
  slot.head.list_next = (@pointer)(&slot.head.list_next)
  slot.head.list_op_pending = nilptr
  pthread_robust_slot_lock_release()
end

local function pthread_robust_register(context: *PthreadContext): boolean
  if context == nilptr or context.robust_slot == nilptr then return false end
  if context.robust_registered ~= 0 then return true end
  local slot = context.robust_slot
  local tid = nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong)
  local result = nelibc_raw_syscall3(273_culong,
      (@culong)((@usize)(&slot.head)), 24_culong, 0_culong)
  slot.tid = (@cint)(tid)
  slot.state = 2
  if result < 0 and result >= -4095 then return false end
  context.robust_registered = 1
  context.robust_pid = (@cint)(nelibc_raw_syscall3(39_culong, 0_culong, 0_culong, 0_culong))
  return true
end

local function pthread_current_context(): *PthreadContext <inline>
  local context = nelibc_thread_current_pthread_context()
  if context == nilptr then
    context = &initial_thread_context
    initial_thread_context.cancel_state = PTHREAD_CANCEL_ENABLE
    initial_thread_context.cancel_type = PTHREAD_CANCEL_DEFERRED
    initial_thread_context.cancel_defer_depth = 0
    nelibc_thread_set_pthread_context((@pointer)(context))
    initial_thread_identity = nelibc_thread_current_identity()
    nelibc_thread_cancel_signal_install()
    nelibc_thread_cancel_signal_unblock()
  end
  local pid = (@cint)(nelibc_raw_syscall3(39_culong, 0_culong, 0_culong, 0_culong))
  if context.robust_pid ~= pid then
    context.robust_registered = 0
    context.robust_slot = nilptr
  end
  if context.robust_slot == nilptr then
    context.robust_slot = pthread_robust_slot_alloc()
    context.robust_pid = pid
  end
  pthread_robust_register(context)
  if context == &initial_thread_context then
    initial_thread_tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  end
  return context
end

local function pthread_key_lock_acquire(): void <inline>
  pthread_cancel_defer_begin()
  while true do
    if nelibc_atomic_cas_int(&pthread_key_lock, 0, 1) == 0 then return end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&pthread_key_lock)),
                        128_culong, 1_culong, 0_culong, 0_culong, 0_culong)
  end
end

local function pthread_key_lock_release(): void <inline>
  nelibc_atomic_store_int(&pthread_key_lock, 0)
  nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&pthread_key_lock)),
                      129_culong, 1_culong, 0_culong, 0_culong, 0_culong)
  pthread_cancel_defer_end()
end

local function pthread_key_parts(key: cuint, index: *[0]csize): boolean <inline>
  local encoded_index: cuint = key & PTHREAD_KEY_INDEX_MASK
  if encoded_index == 0 or encoded_index > 128 then return false end
  index[0] = (@csize)(encoded_index - 1)
  return true
end

local function pthread_key_valid_locked(key: cuint, index: csize): boolean <inline>
  return pthread_key_allocated[index] ~= 0 and
         pthread_key_generations[index] == (key >> 8)
end

local function pthread_key_reset_values(): void <inline>
  nelibc_thread_set_key_values(nilptr)
end

local function pthread_key_run_destructors(): void
  local values: *[0]PthreadKeyValue = (@*[0]PthreadKeyValue)(nelibc_thread_current_key_values())
  if values == nilptr then return end
  local iteration: cint = 0
  while iteration < 4 do
    local called: boolean = false
    local index: csize = 0
    while index < PTHREAD_KEY_COUNT do
      local value = values[index].value
      if value ~= nilptr then
        local key = values[index].key
        values[index].value = nilptr
        local destructor: pointer = nilptr
        local key_index: csize
        if pthread_key_parts(key, &key_index) then
          pthread_key_lock_acquire()
          if pthread_key_valid_locked(key, key_index) then
            destructor = pthread_key_destructors[key_index]
          end
          pthread_key_lock_release()
        end
        if destructor ~= nilptr then
          called = true
          ((@function(pointer): void)(destructor))(value)
        end
      end
      index = index + 1
    end
    if not called then break end
    iteration = iteration + 1
  end
  local index: csize = 0
  while index < PTHREAD_KEY_COUNT do
    values[index].value = nilptr
    index = index + 1
  end
  nelibc_free((@pointer)(values))
  nelibc_thread_set_key_values(nilptr)
end

local function pthread_key_create(key: *[0]cuint, destructor: pointer): cint <cexport, codename 'pthread_key_create'>
  if key == nilptr then return 22 end -- EINVAL
  pthread_key_lock_acquire()
  local index: csize = 0
  while index < PTHREAD_KEY_COUNT and pthread_key_allocated[index] ~= 0 do
    index = index + 1
  end
  if index == PTHREAD_KEY_COUNT then
    pthread_key_lock_release()
    return 11 -- EAGAIN
  end
  local generation = pthread_key_generations[index] + 1
  if generation == 0 or generation > 0xFFFFFF then generation = 1 end
  pthread_key_generations[index] = generation
  pthread_key_destructors[index] = destructor
  pthread_key_allocated[index] = 1
  key[0] = (generation << 8) | (@cuint)(index + 1)
  pthread_key_lock_release()
  return 0
end

local function pthread_key_delete(key: cuint): cint <cexport, codename 'pthread_key_delete'>
  local index: csize
  if not pthread_key_parts(key, &index) then return 22 end -- EINVAL
  pthread_key_lock_acquire()
  if not pthread_key_valid_locked(key, index) then
    pthread_key_lock_release()
    return 22 -- EINVAL
  end
  pthread_key_allocated[index] = 0
  pthread_key_destructors[index] = nilptr
  pthread_key_lock_release()
  return 0
end

local function pthread_getspecific(key: cuint): pointer <cexport, codename 'pthread_getspecific'>
  local index: csize
  if not pthread_key_parts(key, &index) then return nilptr end
  pthread_key_lock_acquire()
  local valid = pthread_key_valid_locked(key, index)
  pthread_key_lock_release()
  if not valid then return nilptr end
  local values: *[0]PthreadKeyValue = (@*[0]PthreadKeyValue)(nelibc_thread_current_key_values())
  if values == nilptr or values[index].key ~= key then return nilptr end
  return values[index].value
end

local function pthread_setspecific(key: cuint, value: pointer): cint <cexport, codename 'pthread_setspecific'>
  local index: csize
  if not pthread_key_parts(key, &index) then return 22 end -- EINVAL
  pthread_key_lock_acquire()
  local valid = pthread_key_valid_locked(key, index)
  pthread_key_lock_release()
  if not valid then return 22 end -- EINVAL
  local values: *[0]PthreadKeyValue = (@*[0]PthreadKeyValue)(nelibc_thread_current_key_values())
  if values == nilptr and value == nilptr then return 0 end
  if values == nilptr then
    local allocated = nelibc_malloc(PTHREAD_KEY_COUNT * 16_csize)
    if allocated == nilptr then return 12 end -- ENOMEM
    local slots = (@*[0]PthreadKeyValue)(allocated)
    local slot: csize = 0
    while slot < PTHREAD_KEY_COUNT do
      slots[slot].key = 0
      slots[slot].value = nilptr
      slot = slot + 1
    end
    nelibc_thread_set_key_values(allocated)
    values = slots
  end
  values[index].key = key
  values[index].value = value
  return 0
end

local function thread_trampoline(argument: pointer): cint <cexport, codename 'nelibc_thread_trampoline'>
  local context = (@*ThreadContext)(argument)
  context.result = context.start(context.arg)
  return 0
end

local function map_rw(size: csize): pointer <inline>
  local result = nelibc_raw_syscall6(
    9_culong, 0_culong, (@culong)(size), 3_culong, 34_culong,
    (@culong)(-1_cint), 0_culong
  )
  if result < 0 and result >= -4095 then
    nelibc_errno_location()[0] = (@cint)(-result)
    return nilptr
  end
  return (@pointer)((@usize)(result))
end

local function unmap(addr: pointer, size: csize): void <inline>
  nelibc_raw_syscall3(11_culong, (@culong)((@usize)(addr)), (@culong)(size), 0_culong)
end

local function pthread_detached_cleanup(context: *PthreadContext): void
  local handle = context.handle
  local stack = handle.stack
  local stack_size = handle.stack_size
  local tls = handle.tls
  local tls_size = handle.tls_size
  local cleanup_stack = handle.cleanup_stack
  local cleanup_stack_size = handle.cleanup_stack_size
  local object = context.object
  local tid_word: *[0]cint = handle.tid_word
  nelibc_credential_sync_end()
  nelibc_thread_tid_slot_release(tid_word)
  nelibc_free(object)
  nelibc_thread_detached_exit(stack, stack_size, tls, tls_size,
                              cleanup_stack, cleanup_stack_size)
end

-- Start a callback on a Linux thread with a private stack and static TLS copy.
local function thread_spawn(handle: *ThreadHandle, start: pointer, arg: pointer, requested_stack_size: csize, provided_stack: pointer, requested_guard_size: csize, identity: pointer, pthread_context: *PthreadContext, detached: boolean): cint
  if handle == nilptr or start == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  if handle.state == 1 then
    nelibc_errno_location()[0] = 16 -- EBUSY
    return -1
  end
  handle.state = 0
  if requested_stack_size < PTHREAD_STACK_MINIMUM or requested_stack_size > MAX_CSIZE - (PAGE_SIZE - 1) then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local stack_size: csize = (requested_stack_size + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1)
  if requested_guard_size > MAX_CSIZE - (PAGE_SIZE - 1) then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local guard_size: csize = (requested_guard_size + PAGE_SIZE - 1) & ~(PAGE_SIZE - 1)
  if guard_size > MAX_CSIZE - stack_size then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  local mapping_size = stack_size + guard_size
  local stack: pointer
  if provided_stack ~= nilptr then
    stack = provided_stack
    stack_size = 0
    guard_size = 0
    mapping_size = 0
  else
    stack = map_rw(mapping_size)
    if stack == nilptr then return -1 end
  end
  if guard_size > 0 then
    local protect_result = nelibc_raw_syscall3(
      10_culong, (@culong)((@usize)(stack)), (@culong)(guard_size), 0_culong
    )
    if protect_result < 0 and protect_result >= -4095 then
      nelibc_errno_location()[0] = (@cint)(-protect_result)
      if mapping_size > 0 then unmap(stack, mapping_size) end
      return -1
    end
  end

  local cleanup_stack: pointer = nilptr
  if detached or pthread_context ~= nilptr then
    cleanup_stack = map_rw(CLEANUP_STACK_SIZE)
    if cleanup_stack == nilptr then
      if mapping_size > 0 then unmap(stack, mapping_size) end
      return -1
    end
  end

  local layout: TLSLayout
  nelibc_tls_layout(&layout)
  local align: csize = layout.image_align
  if align < 16 then align = 16 end
  if (align & (align - 1)) ~= 0 then
    if cleanup_stack ~= nilptr then unmap(cleanup_stack, CLEANUP_STACK_SIZE) end
    if mapping_size > 0 then unmap(stack, mapping_size) end
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end

  local rounded_size: csize = layout.image_memsz
  if rounded_size > MAX_CSIZE - (align - 1) then
    if cleanup_stack ~= nilptr then unmap(cleanup_stack, CLEANUP_STACK_SIZE) end
    if mapping_size > 0 then unmap(stack, mapping_size) end
    nelibc_errno_location()[0] = 12 -- ENOMEM
    return -1
  end
  rounded_size = (rounded_size + align - 1) & ~(align - 1)
  if align > MAX_CSIZE - 16 then
    if cleanup_stack ~= nilptr then unmap(cleanup_stack, CLEANUP_STACK_SIZE) end
    if mapping_size > 0 then unmap(stack, mapping_size) end
    nelibc_errno_location()[0] = 12 -- ENOMEM
    return -1
  end
  if rounded_size > MAX_CSIZE - align - 64 then
    if cleanup_stack ~= nilptr then unmap(cleanup_stack, CLEANUP_STACK_SIZE) end
    if mapping_size > 0 then unmap(stack, mapping_size) end
    nelibc_errno_location()[0] = 12 -- ENOMEM
    return -1
  end
  local tls_map_size: csize = rounded_size + align + 64
  local tls_map = map_rw(tls_map_size)
  if tls_map == nilptr then
    if cleanup_stack ~= nilptr then unmap(cleanup_stack, CLEANUP_STACK_SIZE) end
    if mapping_size > 0 then unmap(stack, mapping_size) end
    return -1
  end

  local base: usize = (@usize)(tls_map)
  local tp_address: usize = (base + (@usize)(rounded_size) + (@usize)(align - 1)) & ~(@usize)(align - 1)
  local tls_address: usize = tp_address - (@usize)(rounded_size)
  local source: *[0]byte = (@*[0]byte)(layout.image_start)
  local destination: *[0]byte = (@*[0]byte)(tls_address)
  local i: csize = 0
  while i < layout.image_filesz do
    destination[i] = source[i]
    i = i + 1
  end
  while i < rounded_size do
    destination[i] = 0
    i = i + 1
  end
  local tcb: *[0]pointer = (@*[0]pointer)(tp_address)
  tcb[0] = (@pointer)(tp_address)
  tcb[1] = identity
  tcb[2] = (@pointer)(pthread_context)
  if detached then tcb[3] = identity else tcb[3] = nilptr end
  tcb[4] = nilptr
  if mapping_size > 0 then handle.stack = stack else handle.stack = nilptr end
  handle.tls = tls_map
  handle.tls_size = tls_map_size
  handle.stack_size = mapping_size
  handle.cleanup_stack = cleanup_stack
  if cleanup_stack ~= nilptr then handle.cleanup_stack_size = CLEANUP_STACK_SIZE else handle.cleanup_stack_size = 0 end
  handle.tid = 0
  if handle.tid_word == nilptr then handle.tid_word = &handle.tid end
  if detached then handle.state = 3 end
  local stack_top: pointer
  if provided_stack ~= nilptr then
    stack_top = (@pointer)(((@usize)(provided_stack) + (@usize)(requested_stack_size)) & ~15_usize)
  else
    stack_top = (@pointer)((@usize)(stack) + (@usize)(mapping_size))
  end
  if nelibc_credential_sync_begin() ~= 0 then
    unmap(tls_map, tls_map_size)
    if cleanup_stack ~= nilptr then unmap(cleanup_stack, CLEANUP_STACK_SIZE) end
    if mapping_size > 0 then unmap(stack, mapping_size) end
    return -1
  end
  local tid_pointer: *[0]cint = handle.tid_word
  local child = nelibc_clone_thread(start, arg, stack_top, (@pointer)(tp_address), tid_pointer)
  if child < 0 then
    nelibc_credential_sync_end()
    nelibc_errno_location()[0] = (@cint)(-child)
    unmap(tls_map, tls_map_size)
    if cleanup_stack ~= nilptr then unmap(cleanup_stack, CLEANUP_STACK_SIZE) end
    if mapping_size > 0 then unmap(stack, mapping_size) end
    return -1
  end
  if not detached then handle.state = 1 end
  return 0
end

local function nelibc_thread_create(handle: *ThreadHandle, start: function(pointer): cint, arg: pointer): cint <cexport, codename 'nelibc_thread_create'>
  if handle == nilptr or start == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  handle.context.start = start
  handle.context.arg = arg
  handle.context.result = 0
  return thread_spawn(handle, (@pointer)(thread_trampoline), &handle.context,
                      STACK_SIZE, nilptr, 0_csize, (@pointer)(handle), nilptr, false)
end

-- Wait for a child, service process-wide credential rendezvous, and release maps.
-- A non-null deadline is an absolute CLOCK_REALTIME deadline. Keep futex sleeps
-- short so this waiter continues to service process-wide credential work.
local function thread_wait_until(handle: *ThreadHandle,
    deadline: *Timespec): cint
  if handle == nilptr or handle.state ~= 1 then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  -- FUTEX_WAIT is compare-and-block: a concurrent child clear either wakes
  -- this wait or makes it return -EAGAIN. Credential requests also update
  -- their shared request state; timed waits let this join service requests
  -- made by any active child, not only the child being joined.
  local timeout: Timespec
  local tid_word: *[0]cint = handle.tid_word
  if tid_word == nilptr then tid_word = &handle.tid end
  while nelibc_thread_tid_load((@pointer)(tid_word)) ~= 0 do
    local expected_tid: cint = nelibc_thread_tid_load((@pointer)(tid_word))
    nelibc_credential_sync_serve()
    if nelibc_thread_tid_load((@pointer)(tid_word)) ~= 0 then
      timeout.tv_sec = 0
      timeout.tv_nsec = 10000000
      if deadline ~= nilptr then
        local now: Timespec
        local clock_result = nelibc_raw_syscall3(228_culong, 0_culong,
            (@culong)((@usize)(&now)), 0_culong) -- clock_gettime(CLOCK_REALTIME)
        if clock_result < 0 and clock_result >= -4095 then
          nelibc_errno_location()[0] = (@cint)(-clock_result)
          return -1
        end
        if deadline.tv_sec < now.tv_sec or
           (deadline.tv_sec == now.tv_sec and deadline.tv_nsec <= now.tv_nsec) then
          if nelibc_thread_tid_load((@pointer)(tid_word)) ~= 0 then
            nelibc_errno_location()[0] = 110 -- ETIMEDOUT
            return -1
          end
          continue
        end
        local remaining_sec = deadline.tv_sec - now.tv_sec
        local remaining_nsec = deadline.tv_nsec - now.tv_nsec
        if remaining_nsec < 0 then
          remaining_sec = remaining_sec - 1
          remaining_nsec = remaining_nsec + 1000000000
        end
        if remaining_sec == 0 and remaining_nsec < timeout.tv_nsec then
          timeout.tv_nsec = remaining_nsec
        end
      end
      nelibc_raw_syscall6(
        202_culong, (@culong)((@usize)(tid_word)), 0_culong,
        (@culong)(expected_tid), (@culong)((@usize)(&timeout)), 0_culong, 0_culong
      )
    end
  end
  nelibc_credential_sync_end()
  unmap(handle.tls, handle.tls_size)
  if handle.stack ~= nilptr then unmap(handle.stack, handle.stack_size) end
  if handle.cleanup_stack ~= nilptr then unmap(handle.cleanup_stack, handle.cleanup_stack_size) end
  handle.stack = nilptr
  handle.tls = nilptr
  handle.tls_size = 0
  handle.stack_size = 0
  handle.cleanup_stack = nilptr
  handle.cleanup_stack_size = 0
  handle.tid_word = nilptr
  handle.state = 2
  return 0
end

local function thread_wait(handle: *ThreadHandle): cint
  return thread_wait_until(handle, nilptr)
end

local function nelibc_thread_join(handle: *ThreadHandle, result: *[0]cint): cint <cexport, codename 'nelibc_thread_join'>
  if result == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return -1
  end
  if thread_wait(handle) ~= 0 then return -1 end
  result[0] = handle.context.result
  return 0
end

-- Synchronous compatibility wrapper around create and join.
local function nelibc_thread_run_once(start: function(pointer): cint, arg: pointer): cint <cexport, codename 'nelibc_thread_run_once'>
  local handle: ThreadHandle
  local result: cint
  handle.state = 0
  handle.tid_word = nilptr
  if nelibc_thread_create(&handle, start, arg) ~= 0 then return -1 end
  if nelibc_thread_join(&handle, &result) ~= 0 then return -1 end
  return result
end

local function pthread_join_release_claim(context: *PthreadContext,
    lifecycle: cint): void
  if nelibc_atomic_cas_int(&context.lifecycle, 4, lifecycle) == 0 then return end
  -- The target exited while the nonblocking/timed join held lifecycle 4.
  -- pthread_finish changes 4 to 7 in that case; retain a joinable-completed
  -- state after releasing the claim so detach and a later join can clean up.
  if nelibc_atomic_load_int(&context.lifecycle) == 7 then
    nelibc_atomic_store_int(&context.lifecycle, 2)
  end
end

local function pthread_finish(context: *PthreadContext): void
  while true do
    local lifecycle = nelibc_atomic_load_int(&context.lifecycle)
    if lifecycle == 0 then
      if nelibc_atomic_cas_int(&context.lifecycle, 0, 2) ~= 0 then continue end
      return
    elseif lifecycle == 4 then
      if nelibc_atomic_cas_int(&context.lifecycle, 4, 7) ~= 0 then continue end
      return
    elseif lifecycle == 1 or lifecycle == 3 then
      if nelibc_atomic_cas_int(&context.lifecycle, lifecycle, 5) ~= 0 then continue end
      pthread_detached_cleanup(context)
    else
      return
    end
  end
end

local function pthread_cleanup_run(context: *PthreadContext): void
  if context == nilptr then return end
  while context.cleanup_count > 0 do
    context.cleanup_count = context.cleanup_count - 1
    local entry = context.cleanup_entries[context.cleanup_count]
    if entry.routine ~= nilptr then entry.routine(entry.arg) end
  end
end

local function pthread_context_exit(context: *PthreadContext, result: pointer): void
  pthread_cleanup_run(context)
  if context ~= nilptr then
    context.result = result
    pthread_key_run_destructors()
    pthread_finish(context)
  else
    pthread_key_run_destructors()
  end
  nelibc_raw_syscall3(60_culong, 0_culong, 0_culong, 0_culong)
  while true do end
end

local function pthread_cancel_wake(context: *PthreadContext): void
  local address = nelibc_atomic_load_pointer(&context.cancel_wait_address)
  if address == nilptr then return end
  nelibc_atomic_fetch_add_int((@*[0]cint)(address), 1)
  nelibc_raw_syscall6(202_culong, (@culong)((@usize)(address)),
                      (@culong)(context.cancel_wait_wake_operation),
                      2147483647_culong, 0_culong, 0_culong, 0_culong)
end

local function pthread_testcancel(): void <cexport, codename 'pthread_testcancel'>
  local context = pthread_current_context()
  if context == nilptr or context.cancel_state == PTHREAD_CANCEL_DISABLE or
     nelibc_atomic_load_int(&context.cancel_pending) == 0 then return end
  nelibc_atomic_store_int(&context.cancel_pending, 0)
  pthread_context_exit(context, PTHREAD_CANCELED)
end

local function nelibc_pthread_cancel_signal(): void <cexport, codename 'nelibc_pthread_cancel_signal'>
  local context = pthread_current_context()
  if context == nilptr or context.cancel_state == PTHREAD_CANCEL_DISABLE or
     context.cancel_type ~= PTHREAD_CANCEL_ASYNCHRONOUS or
     context.cancel_defer_depth ~= 0 or
     nelibc_atomic_load_int(&context.cancel_pending) == 0 then return end
  nelibc_atomic_store_int(&context.cancel_pending, 0)
  pthread_context_exit(context, PTHREAD_CANCELED)
end

local function pthread_sigmask(how: cint, set: pointer <const>, oldset: pointer): cint <cexport, codename 'pthread_sigmask'>
  local kernel_set: culong = 0_culong
  local set_pointer: pointer = nilptr
  if set ~= nilptr then
    local set_words: *[0]culong = (@*[0]culong)(set)
    kernel_set = set_words[0] & ~(1_culong << 31)
    set_pointer = (@pointer)(&kernel_set)
  end
  local result = nelibc_raw_syscall6(14_culong, (@culong)(how),
      (@culong)((@usize)(set_pointer)), (@culong)((@usize)(oldset)),
      8_culong, 0_culong, 0_culong)
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  if oldset ~= nilptr then
    local old_words: *[0]culong = (@*[0]culong)(oldset)
    old_words[0] = old_words[0] & ~(1_culong << 31)
  end
  return 0
end

local function pthread_cancel(thread: pointer): cint <cexport, codename 'pthread_cancel'>
  if thread == nilptr then return 3 end -- ESRCH
  local context: *PthreadContext
  local tid: cint = 0
  if initial_thread_identity ~= nilptr and thread == initial_thread_identity then
    context = &initial_thread_context
    tid = initial_thread_tid
  else
    local state = (@*PthreadObject)(thread)
    if state.magic ~= PTHREAD_OBJECT_MAGIC then return 3 end -- ESRCH
    context = &state.context
    local tid_word = state.handle.tid_word
    if tid_word ~= nilptr then tid = nelibc_thread_tid_load((@pointer)(tid_word)) end
  end
  nelibc_atomic_store_int(&context.cancel_pending, 1)
  if nelibc_atomic_load_int(&context.cancel_state) == PTHREAD_CANCEL_ENABLE then
    pthread_cancel_wake(context)
    if tid > 0 then
      local pid = nelibc_raw_syscall3(39_culong, 0_culong, 0_culong, 0_culong)
      nelibc_raw_syscall3(234_culong, (@culong)(pid), (@culong)(tid), 32_culong)
    end
  end
  return 0
end

local function pthread_setcancelstate(cancel_state: cint, old_state: *[0]cint): cint <cexport, codename 'pthread_setcancelstate'>
  if cancel_state ~= PTHREAD_CANCEL_ENABLE and cancel_state ~= PTHREAD_CANCEL_DISABLE then return 22 end -- EINVAL
  local context = pthread_current_context()
  if context == nilptr then return 0 end
  local previous = nelibc_atomic_exchange_int(&context.cancel_state, cancel_state)
  if old_state ~= nilptr then old_state[0] = previous end
  if cancel_state == PTHREAD_CANCEL_ENABLE then
    pthread_cancel_wake(context)
    pthread_testcancel()
  end
  return 0
end

local function pthread_setcanceltype(cancel_type: cint, old_type: *[0]cint): cint <cexport, codename 'pthread_setcanceltype'>
  if cancel_type ~= PTHREAD_CANCEL_DEFERRED and cancel_type ~= PTHREAD_CANCEL_ASYNCHRONOUS then return 22 end -- EINVAL
  local context = pthread_current_context()
  local previous = nelibc_atomic_exchange_int(&context.cancel_type, cancel_type)
  if old_type ~= nilptr then old_type[0] = previous end
  if cancel_type == PTHREAD_CANCEL_ASYNCHRONOUS and
     context.cancel_state == PTHREAD_CANCEL_ENABLE and
     nelibc_atomic_load_int(&context.cancel_pending) ~= 0 then
    nelibc_pthread_cancel_signal()
  end
  return 0
end

local function pthread_trampoline(argument: pointer): cint <cexport, codename 'nelibc_pthread_trampoline'>
  local context = (@*PthreadContext)(argument)
  while nelibc_atomic_load_int(&context.startup_gate) == 0 do
    nelibc_raw_syscall6(202_culong,
      (@culong)((@usize)(&context.startup_gate)), 128_culong,
      0_culong, 0_culong, 0_culong, 0_culong)
  end
  if nelibc_atomic_load_int(&context.startup_gate) < 0 then return 0 end
  nelibc_thread_cancel_signal_unblock()
  pthread_robust_register(context)
  pthread_key_reset_values()
  pthread_testcancel()
  context.result = context.start(context.arg)
  pthread_cleanup_run(context)
  pthread_key_run_destructors()
  pthread_finish(context)
  return 0
end

local function pthread_attr_valid(attr: *PthreadAttr): boolean <inline>
  return attr ~= nilptr and attr.magic == PTHREAD_ATTR_MAGIC
end

local function pthread_default_attr_lock_acquire(): void <inline>
  pthread_cancel_defer_begin()
  while true do
    if nelibc_atomic_cas_int(&default_thread_attr_lock, 0, 1) == 0 then return end
    nelibc_raw_syscall6(202_culong,
        (@culong)((@usize)(&default_thread_attr_lock)), 128_culong, 1_culong,
        0_culong, 0_culong, 0_culong)
  end
end

local function pthread_default_attr_lock_release(): void <inline>
  nelibc_atomic_store_int(&default_thread_attr_lock, 0)
  nelibc_raw_syscall6(202_culong,
      (@culong)((@usize)(&default_thread_attr_lock)), 129_culong, 1_culong,
      0_culong, 0_culong, 0_culong)
  pthread_cancel_defer_end()
end

local function pthread_default_attr_ensure_initialized(): void <inline>
  if default_thread_attr_initialized ~= 0 then return end
  default_thread_attr.magic = PTHREAD_ATTR_MAGIC
  default_thread_attr.detachstate = 0
  default_thread_attr.scope = PTHREAD_SCOPE_SYSTEM
  default_thread_attr.stacksize = STACK_SIZE
  default_thread_attr.guardsize = PAGE_SIZE
  default_thread_attr.inheritsched = PTHREAD_INHERIT_SCHED
  default_thread_attr.schedpolicy = SCHED_OTHER
  default_thread_attr.schedparam.sched_priority = 0
  default_thread_attr.stackaddr = nilptr
  default_thread_attr_initialized = 1
end

local function pthread_attr_copy(destination: *PthreadAttr,
    source: *PthreadAttr): void <inline>
  destination.magic = source.magic
  destination.detachstate = source.detachstate
  destination.scope = source.scope
  destination.stacksize = source.stacksize
  destination.guardsize = source.guardsize
  destination.inheritsched = source.inheritsched
  destination.schedpolicy = source.schedpolicy
  destination.schedparam.sched_priority = source.schedparam.sched_priority
  destination.stackaddr = source.stackaddr
end

local function pthread_attr_init(attr: *PthreadAttr): cint <cexport, codename 'pthread_attr_init'>
  if attr == nilptr then return 22 end -- EINVAL
  pthread_default_attr_lock_acquire()
  pthread_default_attr_ensure_initialized()
  pthread_attr_copy(attr, &default_thread_attr)
  pthread_default_attr_lock_release()
  return 0
end

local function pthread_getattr_default_np(attr: *PthreadAttr): cint
    <cexport, codename 'pthread_getattr_default_np'>
  if attr == nilptr then return 22 end -- EINVAL
  pthread_default_attr_lock_acquire()
  pthread_default_attr_ensure_initialized()
  pthread_attr_copy(attr, &default_thread_attr)
  pthread_default_attr_lock_release()
  return 0
end

local function pthread_setattr_default_np(attr: *PthreadAttr <const>): cint
    <cexport, codename 'pthread_setattr_default_np'>
  if not pthread_attr_valid(attr) or attr.stackaddr ~= nilptr then return 22 end -- EINVAL
  if attr.detachstate ~= 0 and attr.detachstate ~= 1 then return 22 end -- EINVAL
  if attr.scope ~= PTHREAD_SCOPE_SYSTEM then return 22 end -- EINVAL
  if attr.stacksize ~= 0_csize and
      (attr.stacksize < PTHREAD_STACK_MINIMUM or
       attr.stacksize > MAX_CSIZE - (PAGE_SIZE - 1_csize)) then return 22 end -- EINVAL
  if attr.guardsize > MAX_CSIZE - (PAGE_SIZE - 1_csize) then return 22 end -- EINVAL
  if attr.inheritsched ~= PTHREAD_INHERIT_SCHED and
      attr.inheritsched ~= PTHREAD_EXPLICIT_SCHED then return 22 end -- EINVAL
  if attr.schedpolicy ~= SCHED_OTHER and attr.schedpolicy ~= SCHED_FIFO and
      attr.schedpolicy ~= SCHED_RR then return 22 end -- EINVAL
  if (attr.schedpolicy == SCHED_OTHER and attr.schedparam.sched_priority ~= 0) or
      (attr.schedpolicy ~= SCHED_OTHER and
       (attr.schedparam.sched_priority < 1 or attr.schedparam.sched_priority > 99)) then
    return 22 -- EINVAL
  end
  pthread_default_attr_lock_acquire()
  pthread_default_attr_ensure_initialized()
  local next_attr: PthreadAttr
  pthread_attr_copy(&next_attr, attr)
  if next_attr.stacksize == 0_csize then next_attr.stacksize = default_thread_attr.stacksize end
  pthread_attr_copy(&default_thread_attr, &next_attr)
  pthread_default_attr_lock_release()
  return 0
end

local function pthread_getconcurrency(): cint
    <cexport, codename 'pthread_getconcurrency'>
  return nelibc_atomic_load_int(&pthread_concurrency_level)
end

local function pthread_setconcurrency(level: cint): cint
    <cexport, codename 'pthread_setconcurrency'>
  if level < 0 then return 22 end -- EINVAL
  nelibc_atomic_store_int(&pthread_concurrency_level, level)
  return 0
end

local function pthread_attr_destroy(attr: *PthreadAttr): cint <cexport, codename 'pthread_attr_destroy'>
  if not pthread_attr_valid(attr) then return 22 end -- EINVAL
  attr.magic = 0
  return 0
end

local function pthread_attr_setdetachstate(attr: *PthreadAttr, state: cint): cint <cexport, codename 'pthread_attr_setdetachstate'>
  if not pthread_attr_valid(attr) then return 22 end -- EINVAL
  if state ~= 0 and state ~= 1 then return 22 end -- EINVAL
  attr.detachstate = state
  return 0
end

local function pthread_attr_getdetachstate(attr: *PthreadAttr, state: *[0]cint): cint <cexport, codename 'pthread_attr_getdetachstate'>
  if not pthread_attr_valid(attr) or state == nilptr then return 22 end -- EINVAL
  state[0] = attr.detachstate
  return 0
end

local function pthread_attr_setstacksize(attr: *PthreadAttr, stacksize: csize): cint <cexport, codename 'pthread_attr_setstacksize'>
  if not pthread_attr_valid(attr) then return 22 end -- EINVAL
  if stacksize < PTHREAD_STACK_MINIMUM or stacksize > MAX_CSIZE - (PAGE_SIZE - 1) or
     (attr.stackaddr ~= nilptr and
      stacksize > MAX_CSIZE - (@csize)((@usize)(attr.stackaddr))) then
    return 22 -- EINVAL
  end
  attr.stacksize = stacksize
  return 0
end

local function pthread_attr_getstacksize(attr: *PthreadAttr, stacksize: *[0]csize): cint <cexport, codename 'pthread_attr_getstacksize'>
  if not pthread_attr_valid(attr) or stacksize == nilptr then return 22 end -- EINVAL
  stacksize[0] = attr.stacksize
  return 0
end

local function pthread_attr_setstack(attr: *PthreadAttr, stackaddr: pointer, stacksize: csize): cint <cexport, codename 'pthread_attr_setstack'>
  if not pthread_attr_valid(attr) or stackaddr == nilptr or
     stacksize < PTHREAD_STACK_MINIMUM or
     stacksize > MAX_CSIZE - (@csize)((@usize)(stackaddr)) then
    return 22 -- EINVAL
  end
  attr.stackaddr = stackaddr
  attr.stacksize = stacksize
  return 0
end

local function pthread_attr_getstack(attr: *PthreadAttr, stackaddr: *[0]pointer,
    stacksize: *[0]csize): cint <cexport, codename 'pthread_attr_getstack'>
  if not pthread_attr_valid(attr) or stackaddr == nilptr or stacksize == nilptr then
    return 22 -- EINVAL
  end
  stackaddr[0] = attr.stackaddr
  stacksize[0] = attr.stacksize
  return 0
end

local function pthread_attr_setscope(attr: *PthreadAttr, scope: cint): cint <cexport, codename 'pthread_attr_setscope'>
  if not pthread_attr_valid(attr) then return 22 end -- EINVAL
  if scope == PTHREAD_SCOPE_PROCESS then return 95 end -- ENOTSUP on Linux
  if scope ~= PTHREAD_SCOPE_SYSTEM then return 22 end -- EINVAL
  attr.scope = scope
  return 0
end

local function pthread_attr_getscope(attr: *PthreadAttr, scope: *[0]cint): cint <cexport, codename 'pthread_attr_getscope'>
  if not pthread_attr_valid(attr) or scope == nilptr then return 22 end -- EINVAL
  scope[0] = attr.scope
  return 0
end

local function pthread_attr_setguardsize(attr: *PthreadAttr, guardsize: csize): cint
    <cexport, codename 'pthread_attr_setguardsize'>
  if not pthread_attr_valid(attr) or guardsize > MAX_CSIZE - (PAGE_SIZE - 1) then
    return 22 -- EINVAL
  end
  attr.guardsize = guardsize
  return 0
end

local function pthread_attr_getguardsize(attr: *PthreadAttr, guardsize: *[0]csize): cint
    <cexport, codename 'pthread_attr_getguardsize'>
  if not pthread_attr_valid(attr) or guardsize == nilptr then return 22 end -- EINVAL
  guardsize[0] = attr.guardsize
  return 0
end

local function pthread_sched_policy_valid(policy: cint): boolean <inline>
  return policy == SCHED_OTHER or policy == SCHED_FIFO or policy == SCHED_RR
end

local function pthread_sched_priority_valid(policy: cint, priority: cint): boolean <inline>
  if policy == SCHED_OTHER then return priority == 0 end
  return pthread_sched_policy_valid(policy) and priority >= 1 and priority <= 99
end

local function pthread_attr_setinheritsched(attr: *PthreadAttr,
    inheritsched: cint): cint <cexport, codename 'pthread_attr_setinheritsched'>
  if not pthread_attr_valid(attr) or
     (inheritsched ~= PTHREAD_INHERIT_SCHED and
      inheritsched ~= PTHREAD_EXPLICIT_SCHED) then
    return 22 -- EINVAL
  end
  attr.inheritsched = inheritsched
  return 0
end

local function pthread_attr_getinheritsched(attr: *PthreadAttr,
    inheritsched: *[0]cint): cint <cexport, codename 'pthread_attr_getinheritsched'>
  if not pthread_attr_valid(attr) or inheritsched == nilptr then return 22 end -- EINVAL
  inheritsched[0] = attr.inheritsched
  return 0
end

local function pthread_attr_setschedpolicy(attr: *PthreadAttr,
    policy: cint): cint <cexport, codename 'pthread_attr_setschedpolicy'>
  if not pthread_attr_valid(attr) or not pthread_sched_policy_valid(policy) then
    return 22 -- EINVAL
  end
  attr.schedpolicy = policy
  return 0
end

local function pthread_attr_getschedpolicy(attr: *PthreadAttr,
    policy: *[0]cint): cint <cexport, codename 'pthread_attr_getschedpolicy'>
  if not pthread_attr_valid(attr) or policy == nilptr then return 22 end -- EINVAL
  policy[0] = attr.schedpolicy
  return 0
end

local function pthread_attr_setschedparam(attr: *PthreadAttr,
    param: *SchedParam): cint <cexport, codename 'pthread_attr_setschedparam'>
  if not pthread_attr_valid(attr) or param == nilptr or
     not pthread_sched_priority_valid(attr.schedpolicy, param.sched_priority) then
    return 22 -- EINVAL
  end
  attr.schedparam.sched_priority = param.sched_priority
  return 0
end

local function pthread_attr_getschedparam(attr: *PthreadAttr,
    param: *SchedParam): cint <cexport, codename 'pthread_attr_getschedparam'>
  if not pthread_attr_valid(attr) or param == nilptr then return 22 end -- EINVAL
  param.sched_priority = attr.schedparam.sched_priority
  return 0
end

local function pthread_mutex_type_valid(kind: cint): boolean <inline>
  return kind == 0 or kind == 1 or kind == 2
end

local function pthread_mutexattr_valid(attr: *PthreadMutexAttr): boolean <inline>
  return attr ~= nilptr and attr.magic == PTHREAD_MUTEX_ATTR_MAGIC
end

local function pthread_mutexattr_init(attr: *PthreadMutexAttr): cint <cexport, codename 'pthread_mutexattr_init'>
  if attr == nilptr then return 22 end -- EINVAL
  attr.magic = PTHREAD_MUTEX_ATTR_MAGIC
  attr.kind = 0
  attr.pshared = 0
  attr.robust = PTHREAD_MUTEX_STALLED
  attr.protocol = PTHREAD_PRIO_NONE
  attr.prioceiling = 1
  return 0
end

local function pthread_mutexattr_destroy(attr: *PthreadMutexAttr): cint <cexport, codename 'pthread_mutexattr_destroy'>
  if not pthread_mutexattr_valid(attr) then return 22 end -- EINVAL
  attr.magic = 0
  return 0
end

local function pthread_mutexattr_settype(attr: *PthreadMutexAttr, kind: cint): cint <cexport, codename 'pthread_mutexattr_settype'>
  if not pthread_mutexattr_valid(attr) or not pthread_mutex_type_valid(kind) then return 22 end -- EINVAL
  attr.kind = kind
  return 0
end

local function pthread_mutexattr_gettype(attr: *PthreadMutexAttr, kind: *[0]cint): cint <cexport, codename 'pthread_mutexattr_gettype'>
  if not pthread_mutexattr_valid(attr) or kind == nilptr then return 22 end -- EINVAL
  kind[0] = attr.kind
  return 0
end

local function pthread_mutexattr_setpshared(attr: *PthreadMutexAttr, pshared: cint): cint <cexport, codename 'pthread_mutexattr_setpshared'>
  if not pthread_mutexattr_valid(attr) or (pshared ~= 0 and pshared ~= 1) then return 22 end -- EINVAL
  attr.pshared = pshared
  return 0
end

local function pthread_mutexattr_getpshared(attr: *PthreadMutexAttr, pshared: *[0]cint): cint <cexport, codename 'pthread_mutexattr_getpshared'>
  if not pthread_mutexattr_valid(attr) or pshared == nilptr then return 22 end -- EINVAL
  pshared[0] = attr.pshared
  return 0
end

local function pthread_mutexattr_setrobust(attr: *PthreadMutexAttr,
    robustness: cint): cint <cexport, codename 'pthread_mutexattr_setrobust'>
  if not pthread_mutexattr_valid(attr) or
     (robustness ~= PTHREAD_MUTEX_STALLED and robustness ~= PTHREAD_MUTEX_ROBUST) then
    return 22 -- EINVAL
  end
  attr.robust = robustness
  return 0
end

local function pthread_mutexattr_getrobust(attr: *PthreadMutexAttr,
    robustness: *[0]cint): cint <cexport, codename 'pthread_mutexattr_getrobust'>
  if not pthread_mutexattr_valid(attr) or robustness == nilptr then return 22 end -- EINVAL
  robustness[0] = attr.robust
  return 0
end

local function pthread_mutexattr_setprotocol(attr: *PthreadMutexAttr,
    protocol: cint): cint <cexport, codename 'pthread_mutexattr_setprotocol'>
  if not pthread_mutexattr_valid(attr) then return 22 end -- EINVAL
  if protocol ~= PTHREAD_PRIO_NONE and protocol ~= PTHREAD_PRIO_INHERIT and
     protocol ~= PTHREAD_PRIO_PROTECT then
    return 22 -- EINVAL
  end
  attr.protocol = protocol
  return 0
end

local function pthread_mutexattr_getprotocol(attr: *PthreadMutexAttr,
    protocol: *[0]cint): cint <cexport, codename 'pthread_mutexattr_getprotocol'>
  if not pthread_mutexattr_valid(attr) or protocol == nilptr then return 22 end -- EINVAL
  protocol[0] = attr.protocol
  return 0
end

local function pthread_mutexattr_getprioceiling(attr: *PthreadMutexAttr,
    prioceiling: *[0]cint): cint <cexport, codename 'pthread_mutexattr_getprioceiling'>
  if not pthread_mutexattr_valid(attr) or prioceiling == nilptr then return 22 end -- EINVAL
  prioceiling[0] = attr.prioceiling
  return 0
end

local function pthread_mutexattr_setprioceiling(attr: *PthreadMutexAttr,
    prioceiling: cint): cint <cexport, codename 'pthread_mutexattr_setprioceiling'>
  if not pthread_mutexattr_valid(attr) or prioceiling < 1 or prioceiling > 99 then
    return 22 -- EINVAL
  end
  attr.prioceiling = prioceiling
  return 0
end

local function pthread_mutex_valid(mutex: *PthreadMutex): boolean <inline>
  return mutex ~= nilptr and mutex.magic == PTHREAD_MUTEX_MAGIC and
         pthread_mutex_type_valid(mutex.kind) and
         (mutex.pshared == 0 or mutex.pshared == 1) and
         (mutex.robust == PTHREAD_MUTEX_STALLED or mutex.robust == PTHREAD_MUTEX_ROBUST) and
         (mutex.protocol == PTHREAD_PRIO_NONE or mutex.protocol == PTHREAD_PRIO_INHERIT or
          mutex.protocol == PTHREAD_PRIO_PROTECT) and
         (mutex.protocol ~= PTHREAD_PRIO_PROTECT or
          (mutex.prioceiling >= 1 and mutex.prioceiling <= 99))
end

local function pthread_mutex_init(mutex: *PthreadMutex, attr: *PthreadMutexAttr): cint <cexport, codename 'pthread_mutex_init'>
  if mutex == nilptr then return 22 end -- EINVAL
  local kind: cint = 0
  local robust: cint = PTHREAD_MUTEX_STALLED
  local protocol: cint = PTHREAD_PRIO_NONE
  local prioceiling: cint = 1
  if attr ~= nilptr then
    if not pthread_mutexattr_valid(attr) then return 22 end -- EINVAL
    if attr.prioceiling < 1 or attr.prioceiling > 99 then return 22 end -- EINVAL
    kind = attr.kind
    robust = attr.robust
    protocol = attr.protocol
    prioceiling = attr.prioceiling
  end
  if not pthread_mutex_type_valid(kind) or
     (robust ~= PTHREAD_MUTEX_STALLED and robust ~= PTHREAD_MUTEX_ROBUST) or
     (protocol ~= PTHREAD_PRIO_NONE and protocol ~= PTHREAD_PRIO_INHERIT and
      protocol ~= PTHREAD_PRIO_PROTECT) then
    return 22 -- EINVAL
  end
  if attr ~= nilptr and attr.pshared ~= 0 and attr.pshared ~= 1 then return 22 end -- EINVAL
  mutex.state = 0
  mutex.kind = kind
  mutex.owner = 0
  mutex.count = 0
  mutex.pshared = 0
  if attr ~= nilptr then mutex.pshared = attr.pshared end
  mutex.robust = robust
  mutex.robust_state = 0
  mutex.protocol = protocol
  mutex.robust_next = nilptr
  mutex.prioceiling = prioceiling
  mutex.protect_next = nilptr
  mutex.magic = PTHREAD_MUTEX_MAGIC
  return 0
end

local function pthread_mutex_destroy(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_destroy'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  if nelibc_atomic_load_int(&mutex.state) ~= 0 then return 16 end -- EBUSY
  mutex.magic = 0
  mutex.owner = 0
  mutex.count = 0
  mutex.robust_state = 0
  mutex.robust_next = nilptr
  mutex.protect_next = nilptr
  return 0
end

local function pthread_mutex_owner_check(mutex: *PthreadMutex, tid: cint): cint <inline>
  if nelibc_atomic_load_int(&mutex.owner) ~= tid then return 0 end
  if mutex.kind == 1 then
    if mutex.count == 2147483647 then return 11 end -- EAGAIN
    mutex.count = mutex.count + 1
    return 1
  end
  if mutex.kind == 2 then return 35 end -- EDEADLK
  return -1 -- A normal mutex self-lock blocks.
end

local function pthread_mutex_acquire(mutex: *PthreadMutex): void
  if nelibc_atomic_cas_int(&mutex.state, 0, 1) == 0 then return end
  local operation: culong = 0_culong
  if mutex.pshared == 0 then operation = 128_culong end -- FUTEX_WAIT_PRIVATE
  while true do
    local previous = nelibc_atomic_exchange_int(&mutex.state, 2)
    if previous == 0 then return end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&mutex.state)),
                        operation, 2_culong, 0_culong, 0_culong, 0_culong)
  end
end

local function pthread_robust_mutex_add(context: *PthreadContext,
    mutex: *PthreadMutex): void
  local slot = context.robust_slot
  local node: pointer = (@pointer)(&mutex.robust_next)
  slot.head.list_op_pending = node
  mutex.robust_next = slot.head.list_next
  slot.head.list_next = node
  slot.head.list_op_pending = nilptr
end

local function pthread_robust_mutex_remove(context: *PthreadContext,
    mutex: *PthreadMutex): void
  local slot = context.robust_slot
  local node: pointer = (@pointer)(&mutex.robust_next)
  slot.head.list_op_pending = node
  local cursor: *[0]pointer = &slot.head.list_next
  while cursor[0] ~= (@pointer)(&slot.head.list_next) and cursor[0] ~= node do
    cursor = (@*[0]pointer)(cursor[0])
  end
  if cursor[0] == node then cursor[0] = mutex.robust_next end
  mutex.robust_next = nilptr
end

local function pthread_priority_set(tid: cint, policy: cint, priority: cint): cint
  local param: SchedParam
  param.sched_priority = priority
  local result = nelibc_raw_syscall3(144_culong, (@culong)(tid),
      (@culong)(policy), (@culong)((@usize)(&param)))
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  return 0
end

local function pthread_priority_protect_refresh(context: *PthreadContext,
    tid: cint): cint
  if context == nilptr then return 0 end
  local effective = context.protect_base_priority
  local cursor: *[0]pointer = &context.protect_mutexes
  while cursor[0] ~= nilptr do
    local held = (@*PthreadMutex)(cursor[0])
    if held.prioceiling > effective then effective = held.prioceiling end
    cursor = &held.protect_next
  end
  return pthread_priority_set(tid, context.protect_base_policy, effective)
end

local function pthread_priority_context_lock(context: *PthreadContext): void <inline>
  pthread_cancel_defer_begin()
  while nelibc_atomic_cas_int(&context.protect_lock, 0, 1) ~= 0 do end
end

local function pthread_priority_context_unlock(context: *PthreadContext): void <inline>
  nelibc_atomic_store_int(&context.protect_lock, 0)
  pthread_cancel_defer_end()
end

local function pthread_priority_protect_can_set(context: *PthreadContext,
    policy: cint, priority: cint): boolean
  if context == nilptr then return true end
  local cursor: *[0]pointer = &context.protect_mutexes
  while cursor[0] ~= nilptr do
    local held = (@*PthreadMutex)(cursor[0])
    if priority > held.prioceiling or
       (policy == SCHED_OTHER and held.prioceiling > 0) then
      return false
    end
    cursor = &held.protect_next
  end
  return true
end

local function pthread_priority_protect_enter(mutex: *PthreadMutex): cint
  local context = pthread_current_context()
  if context == nilptr then return 12 end -- ENOMEM
  pthread_priority_context_lock(context)
  local cursor: *[0]pointer = &context.protect_mutexes
  while cursor[0] ~= nilptr do
    local held = (@*PthreadMutex)(cursor[0])
    if held == mutex then
      pthread_priority_context_unlock(context)
      return 0
    end
    cursor = &held.protect_next
  end

  local policy: cint
  local priority: cint
  if context.protect_mutexes == nilptr then
    local current_policy = nelibc_raw_syscall3(145_culong, 0_culong, 0_culong, 0_culong)
    if current_policy < 0 and current_policy >= -4095 then
      pthread_priority_context_unlock(context)
      return (@cint)(-current_policy)
    end
    local param: SchedParam
    local result = nelibc_raw_syscall3(143_culong, 0_culong,
        (@culong)((@usize)(&param)), 0_culong)
    if result < 0 and result >= -4095 then
      pthread_priority_context_unlock(context)
      return (@cint)(-result)
    end
    policy = (@cint)(current_policy)
    priority = param.sched_priority
    context.protect_base_policy = policy
    context.protect_base_priority = priority
  else
    policy = context.protect_base_policy
    priority = context.protect_base_priority
    local held_cursor = context.protect_mutexes
    while held_cursor ~= nilptr do
      local held = (@*PthreadMutex)(held_cursor)
      if held.prioceiling > priority then priority = held.prioceiling end
      held_cursor = held.protect_next
    end
  end
  if priority > mutex.prioceiling or
     (policy == SCHED_OTHER and mutex.prioceiling > 0) then
    pthread_priority_context_unlock(context)
    return 22 -- EINVAL
  end
  mutex.protect_next = context.protect_mutexes
  context.protect_mutexes = (@pointer)(mutex)
  local result = pthread_priority_protect_refresh(context, 0)
  if result ~= 0 then
    context.protect_mutexes = mutex.protect_next
    mutex.protect_next = nilptr
    if context.protect_mutexes == nilptr then
      context.protect_base_policy = 0
      context.protect_base_priority = 0
    end
    pthread_priority_context_unlock(context)
    return result
  end
  pthread_priority_context_unlock(context)
  return 0
end

local function pthread_priority_protect_leave(mutex: *PthreadMutex): cint
  local context = pthread_current_context()
  if context == nilptr or context.protect_mutexes == nilptr then return 0 end
  pthread_priority_context_lock(context)
  if context.protect_mutexes == nilptr then
    pthread_priority_context_unlock(context)
    return 0
  end
  local cursor: *[0]pointer = &context.protect_mutexes
  while cursor[0] ~= nilptr and cursor[0] ~= (@pointer)(mutex) do
    local held = (@*PthreadMutex)(cursor[0])
    cursor = &held.protect_next
  end
  if cursor[0] == nilptr then
    pthread_priority_context_unlock(context)
    return 0
  end
  cursor[0] = mutex.protect_next
  mutex.protect_next = nilptr
  local result = pthread_priority_protect_refresh(context, 0)
  if context.protect_mutexes == nilptr then
    context.protect_base_policy = 0
    context.protect_base_priority = 0
  end
  pthread_priority_context_unlock(context)
  return result
end

local function pthread_mutex_protect_finish(mutex: *PthreadMutex,
    result: cint): cint
  if mutex.protocol ~= PTHREAD_PRIO_PROTECT or (result ~= 0 and result ~= 130) then
    return result
  end
  local protect_result = pthread_priority_protect_enter(mutex)
  if protect_result ~= 0 then
    local context = pthread_current_context()
    if mutex.robust == PTHREAD_MUTEX_ROBUST then
      pthread_robust_mutex_remove(context, mutex)
      if nelibc_atomic_load_int(&mutex.robust_state) == 1 then
        nelibc_atomic_store_int(&mutex.robust_state, 2)
      end
    end
    mutex.count = 0
    mutex.owner = 0
    local previous = nelibc_atomic_exchange_int(&mutex.state, 0)
    if mutex.robust == PTHREAD_MUTEX_ROBUST then
      context.robust_slot.head.list_op_pending = nilptr
    end
    if (previous & FUTEX_WAITERS) ~= 0 then
      local operation: culong = 1_culong
      if mutex.robust ~= PTHREAD_MUTEX_ROBUST and mutex.pshared == 0 then
        operation = 129_culong
      end
      nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&mutex.state)),
          operation, 1_culong, 0_culong, 0_culong, 0_culong)
    end
    return protect_result
  end
  return result
end

local function pthread_mutex_lock_robust(mutex: *PthreadMutex, tid: cint,
    abstime: *Timespec): cint
  local context = pthread_current_context()
  if not pthread_robust_register(context) then return 95 end -- ENOTSUP
  if nelibc_atomic_load_int(&mutex.robust_state) == 2 then return 131 end -- ENOTRECOVERABLE
  -- The kernel robust-list exit path wakes shared futex keys, even for a
  -- process-private robust mutex, so robust waiters use the shared futex key.
  local wait_operation: culong = 0_culong -- FUTEX_WAIT
  if abstime ~= nilptr then
    wait_operation = 393_culong -- WAIT_BITSET | CLOCK_REALTIME | MATCH_ANY
  end
  while true do
    local state = nelibc_atomic_load_int(&mutex.state)
    local owner = state & FUTEX_TID_MASK
    if owner == tid then
      if mutex.kind == 1 then
        if mutex.count == 2147483647 then return 11 end -- EAGAIN
        mutex.count = mutex.count + 1
        return 0
      end
      if mutex.kind == 2 then return 35 end -- EDEADLK
    end
    if owner == 0 then
      if nelibc_atomic_load_int(&mutex.robust_state) == 2 then return 131 end -- ENOTRECOVERABLE
      local died: boolean = (state & FUTEX_OWNER_DIED) ~= 0
      local desired = tid | (state & FUTEX_WAITERS) | (state & FUTEX_OWNER_DIED)
      nelibc_atomic_store_pointer(&context.robust_slot.head.list_op_pending,
                                  (@pointer)(&mutex.robust_next))
      if nelibc_atomic_cas_int(&mutex.state, state, desired) == 0 then
        mutex.owner = tid
        mutex.count = 1
        if died then nelibc_atomic_store_int(&mutex.robust_state, 1)
        else nelibc_atomic_store_int(&mutex.robust_state, 0) end
        pthread_robust_mutex_add(context, mutex)
        return died and 130 or 0 -- EOWNERDEAD
      end
      context.robust_slot.head.list_op_pending = nilptr
      continue
    end
    local wait_state = state | FUTEX_WAITERS
    if wait_state ~= state then
      if nelibc_atomic_cas_int(&mutex.state, state, wait_state) ~= 0 then continue end
    end
    local wait_result: clong
    if abstime == nilptr then
      wait_result = nelibc_raw_syscall6(202_culong,
          (@culong)((@usize)(&mutex.state)), wait_operation,
          (@culong)(wait_state), 0_culong, 0_culong, 0_culong)
    else
      wait_result = nelibc_raw_syscall6(202_culong,
          (@culong)((@usize)(&mutex.state)), wait_operation,
          (@culong)(wait_state), (@culong)((@usize)(abstime)),
          0_culong, 0xFFFFFFFF_culong)
    end
    if wait_result < 0 and wait_result >= -4095 then
      local wait_error = (@cint)(-wait_result)
      if wait_error == 4 or wait_error == 11 then continue end -- EINTR/EAGAIN
      if wait_error == 110 then
        if (nelibc_atomic_load_int(&mutex.state) & FUTEX_TID_MASK) == 0 then continue end
        return 110 -- ETIMEDOUT
      end
      return wait_error
    end
  end
end

local function pthread_mutex_lock_pi(mutex: *PthreadMutex, tid: cint,
    abstime: *Timespec): cint
  local context: *PthreadContext = nilptr
  if mutex.robust == PTHREAD_MUTEX_ROBUST then
    context = pthread_current_context()
    if not pthread_robust_register(context) then return 95 end -- ENOTSUP
  end
  if mutex.robust == PTHREAD_MUTEX_ROBUST and
     nelibc_atomic_load_int(&mutex.robust_state) == 2 then
    return 131 -- ENOTRECOVERABLE
  end
  local state = nelibc_atomic_load_int(&mutex.state)
  if (state & FUTEX_TID_MASK) == tid then
    if mutex.kind == 1 then
      if mutex.count == 2147483647 then return 11 end -- EAGAIN
      mutex.count = mutex.count + 1
      return 0
    end
    if mutex.kind == 2 then return 35 end -- EDEADLK
    -- FUTEX_LOCK_PI reports EDEADLK for a normal PI mutex self-lock.
  elseif state == 0 then
    if context ~= nilptr then
      nelibc_atomic_store_pointer(&context.robust_slot.head.list_op_pending,
                                  (@pointer)(&mutex.robust_next))
    end
    if nelibc_atomic_cas_int(&mutex.state, 0, tid) == 0 then
      mutex.owner = tid
      mutex.count = 1
      if context ~= nilptr then
        nelibc_atomic_store_int(&mutex.robust_state, 0)
        pthread_robust_mutex_add(context, mutex)
      end
      return 0
    end
    if context ~= nilptr then context.robust_slot.head.list_op_pending = nilptr end
  end

  if context ~= nilptr then
    nelibc_atomic_store_pointer(&context.robust_slot.head.list_op_pending,
                                (@pointer)(&mutex.robust_next))
  end
  local operation: culong = FUTEX_LOCK_PI
  if mutex.pshared == 0 then operation = operation | 128_culong end
  while true do
    local timeout: culong = 0_culong
    if abstime ~= nilptr then timeout = (@culong)((@usize)(abstime)) end
    local result = nelibc_raw_syscall6(202_culong,
        (@culong)((@usize)(&mutex.state)), operation, 0_culong,
        timeout, 0_culong, 0_culong)
    if result >= 0 then
      local acquired_state = nelibc_atomic_load_int(&mutex.state)
      if mutex.robust == PTHREAD_MUTEX_ROBUST and
         nelibc_atomic_load_int(&mutex.robust_state) == 2 then
        local unlock_operation: culong = FUTEX_UNLOCK_PI
        if mutex.pshared == 0 then unlock_operation = unlock_operation | 128_culong end
        nelibc_raw_syscall6(202_culong,
            (@culong)((@usize)(&mutex.state)), unlock_operation,
            0_culong, 0_culong, 0_culong, 0_culong)
        context.robust_slot.head.list_op_pending = nilptr
        return 131 -- ENOTRECOVERABLE
      end
      local died: boolean = (acquired_state & FUTEX_OWNER_DIED) ~= 0
      mutex.owner = tid
      mutex.count = 1
      if context ~= nilptr then
        if died then nelibc_atomic_store_int(&mutex.robust_state, 1)
        else nelibc_atomic_store_int(&mutex.robust_state, 0) end
        pthread_robust_mutex_add(context, mutex)
      end
      return died and 130 or 0 -- EOWNERDEAD
    end
    if result < 0 and result >= -4095 then
      local error_code = (@cint)(-result)
      if error_code == 4 or error_code == 11 then continue end -- EINTR/EAGAIN
      if context ~= nilptr then context.robust_slot.head.list_op_pending = nilptr end
      return error_code
    end
  end
end

local function pthread_mutex_trylock_pi(mutex: *PthreadMutex, tid: cint): cint
  local context: *PthreadContext = nilptr
  if mutex.robust == PTHREAD_MUTEX_ROBUST then
    context = pthread_current_context()
    if not pthread_robust_register(context) then return 95 end -- ENOTSUP
    if nelibc_atomic_load_int(&mutex.robust_state) == 2 then return 131 end -- ENOTRECOVERABLE
  end
  local state = nelibc_atomic_load_int(&mutex.state)
  if (state & FUTEX_TID_MASK) == tid then
    if mutex.kind == 1 then
      if mutex.count == 2147483647 then return 11 end -- EAGAIN
      mutex.count = mutex.count + 1
      return 0
    end
    return 16 -- EBUSY
  end
  if state == 0 then
    if context ~= nilptr then
      nelibc_atomic_store_pointer(&context.robust_slot.head.list_op_pending,
                                  (@pointer)(&mutex.robust_next))
    end
    if nelibc_atomic_cas_int(&mutex.state, 0, tid) == 0 then
      mutex.owner = tid
      mutex.count = 1
      if context ~= nilptr then
        nelibc_atomic_store_int(&mutex.robust_state, 0)
        pthread_robust_mutex_add(context, mutex)
      end
      return 0
    end
    if context ~= nilptr then context.robust_slot.head.list_op_pending = nilptr end
  end
  if context ~= nilptr then
    nelibc_atomic_store_pointer(&context.robust_slot.head.list_op_pending,
                                (@pointer)(&mutex.robust_next))
  end
  local operation: culong = FUTEX_TRYLOCK_PI
  if mutex.pshared == 0 then operation = operation | 128_culong end
  local result = nelibc_raw_syscall6(202_culong,
      (@culong)((@usize)(&mutex.state)), operation, 0_culong,
      0_culong, 0_culong, 0_culong)
  if result < 0 and result >= -4095 then
    local error_code = (@cint)(-result)
    if context ~= nilptr then context.robust_slot.head.list_op_pending = nilptr end
    if error_code == 11 or error_code == 16 then return 16 end -- EBUSY
    return error_code
  end
  local acquired_state = nelibc_atomic_load_int(&mutex.state)
  if mutex.robust == PTHREAD_MUTEX_ROBUST and
     nelibc_atomic_load_int(&mutex.robust_state) == 2 then
    local unlock_operation: culong = FUTEX_UNLOCK_PI
    if mutex.pshared == 0 then unlock_operation = unlock_operation | 128_culong end
    nelibc_raw_syscall6(202_culong,
        (@culong)((@usize)(&mutex.state)), unlock_operation,
        0_culong, 0_culong, 0_culong, 0_culong)
    context.robust_slot.head.list_op_pending = nilptr
    return 131 -- ENOTRECOVERABLE
  end
  local died: boolean = (acquired_state & FUTEX_OWNER_DIED) ~= 0
  mutex.owner = tid
  mutex.count = 1
  if context ~= nilptr then
    if died then nelibc_atomic_store_int(&mutex.robust_state, 1)
    else nelibc_atomic_store_int(&mutex.robust_state, 0) end
    pthread_robust_mutex_add(context, mutex)
  end
  return died and 130 or 0 -- EOWNERDEAD
end

local function pthread_mutex_unlock_pi(mutex: *PthreadMutex, tid: cint): cint
  local state = nelibc_atomic_load_int(&mutex.state)
  if (state & FUTEX_TID_MASK) ~= tid then return 1 end -- EPERM
  if mutex.kind == 1 and mutex.count > 1 then
    mutex.count = mutex.count - 1
    return 0
  end
  local context: *PthreadContext = nilptr
  if mutex.robust == PTHREAD_MUTEX_ROBUST then
    context = pthread_current_context()
    pthread_robust_mutex_remove(context, mutex)
    if nelibc_atomic_load_int(&mutex.robust_state) == 1 then
      nelibc_atomic_store_int(&mutex.robust_state, 2)
    end
  end
  mutex.owner = 0
  mutex.count = 0
  local operation: culong = FUTEX_UNLOCK_PI
  if mutex.pshared == 0 then operation = operation | 128_culong end
  while true do
    state = nelibc_atomic_load_int(&mutex.state)
    if (state & FUTEX_WAITERS) ~= 0 then
      local result = nelibc_raw_syscall6(202_culong,
          (@culong)((@usize)(&mutex.state)), operation, 0_culong,
          0_culong, 0_culong, 0_culong)
      if result < 0 and result >= -4095 then
        if context ~= nilptr then context.robust_slot.head.list_op_pending = nilptr end
        return (@cint)(-result)
      end
      if context ~= nilptr then context.robust_slot.head.list_op_pending = nilptr end
      return 0
    end
    if nelibc_atomic_cas_int(&mutex.state, state, 0) == 0 then
      if context ~= nilptr then context.robust_slot.head.list_op_pending = nilptr end
      return 0
    end
  end
end

local function pthread_mutex_lock(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_lock'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if mutex.protocol == PTHREAD_PRIO_INHERIT then
    return pthread_mutex_lock_pi(mutex, tid, nilptr)
  end
  if mutex.robust == PTHREAD_MUTEX_ROBUST then
    return pthread_mutex_protect_finish(mutex,
        pthread_mutex_lock_robust(mutex, tid, nilptr))
  end
  local owner_result = pthread_mutex_owner_check(mutex, tid)
  if owner_result == 1 then return 0 end
  if owner_result > 1 then return owner_result end
  pthread_mutex_acquire(mutex)
  mutex.count = 1
  nelibc_atomic_store_int(&mutex.owner, tid)
  return pthread_mutex_protect_finish(mutex, 0)
end

local function pthread_mutex_timedlock(mutex: *PthreadMutex,
    abstime: *Timespec): cint <cexport, codename 'pthread_mutex_timedlock'>
  if not pthread_mutex_valid(mutex) or abstime == nilptr or
     abstime.tv_nsec < 0 or abstime.tv_nsec >= 1000000000 then
    return 22 -- EINVAL
  end
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if mutex.protocol == PTHREAD_PRIO_INHERIT then
    return pthread_mutex_lock_pi(mutex, tid, abstime)
  end
  if mutex.robust == PTHREAD_MUTEX_ROBUST then
    return pthread_mutex_protect_finish(mutex,
        pthread_mutex_lock_robust(mutex, tid, abstime))
  end
  local owner_result = pthread_mutex_owner_check(mutex, tid)
  if owner_result == 1 then return 0 end
  if owner_result > 1 then return owner_result end
  if nelibc_atomic_cas_int(&mutex.state, 0, 1) == 0 then
    mutex.count = 1
    nelibc_atomic_store_int(&mutex.owner, tid)
    return pthread_mutex_protect_finish(mutex, 0)
  end
  local operation: culong = 393_culong -- WAIT_BITSET | CLOCK_REALTIME | MATCH_ANY
  if mutex.pshared == 0 then operation = operation | 128_culong end
  while true do
    local previous = nelibc_atomic_exchange_int(&mutex.state, 2)
    if previous == 0 then
      mutex.count = 1
      nelibc_atomic_store_int(&mutex.owner, tid)
      return pthread_mutex_protect_finish(mutex, 0)
    end
    local wait_result = nelibc_raw_syscall6(
      202_culong, (@culong)((@usize)(&mutex.state)), operation, 2_culong,
      (@culong)((@usize)(abstime)), 0_culong, 0xFFFFFFFF_culong
    )
    if wait_result < 0 and wait_result >= -4095 then
      local wait_error = (@cint)(-wait_result)
      if wait_error == 4 or wait_error == 11 then continue end -- EINTR/EAGAIN
      if wait_error == 110 then
        if nelibc_atomic_cas_int(&mutex.state, 0, 2) == 0 then
          mutex.count = 1
          nelibc_atomic_store_int(&mutex.owner, tid)
          return pthread_mutex_protect_finish(mutex, 0)
        end
      end
      return wait_error
    end
  end
end

local function pthread_mutex_trylock(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_trylock'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if mutex.protocol == PTHREAD_PRIO_INHERIT then
    return pthread_mutex_protect_finish(mutex,
        pthread_mutex_trylock_pi(mutex, tid))
  end
  if mutex.robust == PTHREAD_MUTEX_ROBUST then
    if not pthread_robust_register(pthread_current_context()) then return 95 end -- ENOTSUP
    if nelibc_atomic_load_int(&mutex.robust_state) == 2 then return 131 end -- ENOTRECOVERABLE
    local state = nelibc_atomic_load_int(&mutex.state)
    if (state & FUTEX_TID_MASK) ~= 0 then
      if (state & FUTEX_TID_MASK) == tid then
        if mutex.kind == 1 then
          if mutex.count == 2147483647 then return 11 end -- EAGAIN
          mutex.count = mutex.count + 1
          return 0
        end
      end
      return 16 -- EBUSY
    end
    local died: boolean = (state & FUTEX_OWNER_DIED) ~= 0
    local desired = tid | (state & FUTEX_WAITERS) | (state & FUTEX_OWNER_DIED)
    local context = pthread_current_context()
    nelibc_atomic_store_pointer(&context.robust_slot.head.list_op_pending,
                                (@pointer)(&mutex.robust_next))
    if nelibc_atomic_cas_int(&mutex.state, state, desired) ~= 0 then
      context.robust_slot.head.list_op_pending = nilptr
      return 16 -- EBUSY
    end
    mutex.owner = tid
    mutex.count = 1
    if died then nelibc_atomic_store_int(&mutex.robust_state, 1)
        else nelibc_atomic_store_int(&mutex.robust_state, 0) end
    pthread_robust_mutex_add(context, mutex)
    return pthread_mutex_protect_finish(mutex, died and 130 or 0) -- EOWNERDEAD
  end
  if nelibc_atomic_load_int(&mutex.owner) == tid then
    if mutex.kind == 1 then
      if mutex.count == 2147483647 then return 11 end -- EAGAIN
      mutex.count = mutex.count + 1
      return 0
    end
    return 16 -- EBUSY
  end
  if nelibc_atomic_cas_int(&mutex.state, 0, 1) ~= 0 then return 16 end -- EBUSY
  mutex.count = 1
  nelibc_atomic_store_int(&mutex.owner, tid)
  return pthread_mutex_protect_finish(mutex, 0)
end

local function pthread_mutex_unlock(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_unlock'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if mutex.protocol == PTHREAD_PRIO_INHERIT then
    return pthread_mutex_unlock_pi(mutex, tid)
  end
  if mutex.robust == PTHREAD_MUTEX_ROBUST then
    local state = nelibc_atomic_load_int(&mutex.state)
    if (state & FUTEX_TID_MASK) ~= tid then return 1 end -- EPERM
    if mutex.kind == 1 and mutex.count > 1 then
      mutex.count = mutex.count - 1
      return 0
    end
    local context = pthread_current_context()
    pthread_robust_mutex_remove(context, mutex)
    mutex.count = 0
    mutex.owner = 0
    if nelibc_atomic_load_int(&mutex.robust_state) == 1 then
      nelibc_atomic_store_int(&mutex.robust_state, 2)
    end
    local previous = nelibc_atomic_exchange_int(&mutex.state, 0)
    context.robust_slot.head.list_op_pending = nilptr
    if (previous & FUTEX_WAITERS) ~= 0 then
      -- Match the shared-key wake used by Linux robust-list owner-death exit.
      local operation: culong = 1_culong -- FUTEX_WAKE
      nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&mutex.state)),
                          operation, 1_culong, 0_culong, 0_culong, 0_culong)
    end
    return pthread_priority_protect_leave(mutex)
  end
  if nelibc_atomic_load_int(&mutex.owner) ~= tid then return 1 end -- EPERM
  if mutex.kind == 1 and mutex.count > 1 then
    mutex.count = mutex.count - 1
    return 0
  end
  mutex.count = 0
  nelibc_atomic_store_int(&mutex.owner, 0)
  local previous = nelibc_atomic_exchange_int(&mutex.state, 0)
  if previous == 2 then
    local operation: culong = 1_culong
    if mutex.pshared == 0 then operation = 129_culong end -- FUTEX_WAKE_PRIVATE
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&mutex.state)),
                        operation, 1_culong, 0_culong, 0_culong, 0_culong)
  end
  if mutex.protocol == PTHREAD_PRIO_PROTECT then
    return pthread_priority_protect_leave(mutex)
  end
  return 0
end

local function pthread_mutex_lock_for_ceiling(mutex: *PthreadMutex): cint
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if mutex.robust == PTHREAD_MUTEX_ROBUST then
    return pthread_mutex_lock_robust(mutex, tid, nilptr)
  end
  local owner_result = pthread_mutex_owner_check(mutex, tid)
  if owner_result == 1 then return 0 end
  if owner_result > 1 then return owner_result end
  pthread_mutex_acquire(mutex)
  mutex.count = 1
  nelibc_atomic_store_int(&mutex.owner, tid)
  return 0
end

local function pthread_mutex_getprioceiling(mutex: *PthreadMutex,
    prioceiling: *[0]cint): cint <cexport, codename 'pthread_mutex_getprioceiling'>
  if not pthread_mutex_valid(mutex) or prioceiling == nilptr or
     mutex.protocol ~= PTHREAD_PRIO_PROTECT then
    return 22 -- EINVAL
  end
  prioceiling[0] = nelibc_atomic_load_int(&mutex.prioceiling)
  return 0
end

local function pthread_mutex_setprioceiling(mutex: *PthreadMutex,
    prioceiling: cint, old_ceiling: *[0]cint): cint <cexport, codename 'pthread_mutex_setprioceiling'>
  if not pthread_mutex_valid(mutex) or old_ceiling == nilptr or
     mutex.protocol ~= PTHREAD_PRIO_PROTECT or
     prioceiling < 1 or prioceiling > 99 then
    return 22 -- EINVAL
  end
  local lock_result = pthread_mutex_lock_for_ceiling(mutex)
  if lock_result ~= 0 and lock_result ~= 130 then return lock_result end
  local previous = nelibc_atomic_load_int(&mutex.prioceiling)
  local context = pthread_current_context()
  pthread_priority_context_lock(context)
  nelibc_atomic_store_int(&mutex.prioceiling, prioceiling)
  local refresh_result = pthread_priority_protect_refresh(context, 0)
  if refresh_result ~= 0 then
    nelibc_atomic_store_int(&mutex.prioceiling, previous)
    pthread_priority_protect_refresh(context, 0)
  else
    old_ceiling[0] = previous
  end
  pthread_priority_context_unlock(context)
  local unlock_result = pthread_mutex_unlock(mutex)
  if refresh_result ~= 0 then return refresh_result end
  if unlock_result ~= 0 then return unlock_result end
  return lock_result
end

local function pthread_mutex_consistent(mutex: *PthreadMutex): cint <cexport, codename 'pthread_mutex_consistent'>
  if not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  if mutex.robust ~= PTHREAD_MUTEX_ROBUST then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if nelibc_atomic_load_int(&mutex.robust_state) ~= 1 or
     (nelibc_atomic_load_int(&mutex.state) & FUTEX_TID_MASK) ~= tid then
    return 22 -- EINVAL
  end
  while true do
    local state = nelibc_atomic_load_int(&mutex.state)
    local consistent_state = state & ~FUTEX_OWNER_DIED
    if nelibc_atomic_cas_int(&mutex.state, state, consistent_state) == 0 then break end
  end
  nelibc_atomic_store_int(&mutex.robust_state, 0)
  return 0
end

local function pthread_spin_init(lock: *[0]cint, pshared: cint): cint
    <cexport, codename 'pthread_spin_init'>
  if lock == nilptr or (pshared ~= 0 and pshared ~= 1) then return 22 end -- EINVAL
  nelibc_atomic_store_int(lock, 0)
  return 0
end

local function pthread_spin_destroy(lock: *[0]cint): cint
    <cexport, codename 'pthread_spin_destroy'>
  if lock == nilptr then return 22 end -- EINVAL
  local state = nelibc_atomic_load_int(lock)
  if state == -1 then return 22 end -- EINVAL: already destroyed
  if state ~= 0 then return 16 end -- EBUSY
  if nelibc_atomic_cas_int(lock, 0, -1) ~= 0 then return 16 end
  return 0
end

local function pthread_spin_lock(lock: *[0]cint): cint
    <cexport, codename 'pthread_spin_lock'>
  if lock == nilptr then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  local attempts: cint = 0
  while true do
    local state = nelibc_atomic_load_int(lock)
    if state == -1 then return 22 end -- EINVAL: destroyed
    if state == 0 and nelibc_atomic_cas_int(lock, 0, tid) == 0 then return 0 end
    attempts = attempts + 1
    if attempts >= 128 then
      attempts = 0
      nelibc_raw_syscall3(24_culong, 0_culong, 0_culong, 0_culong) -- sched_yield
    end
  end
end

local function pthread_spin_trylock(lock: *[0]cint): cint
    <cexport, codename 'pthread_spin_trylock'>
  if lock == nilptr then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  local state = nelibc_atomic_load_int(lock)
  if state == -1 then return 22 end -- EINVAL: destroyed
  if state ~= 0 or nelibc_atomic_cas_int(lock, 0, tid) ~= 0 then return 16 end -- EBUSY
  return 0
end

local function pthread_spin_unlock(lock: *[0]cint): cint
    <cexport, codename 'pthread_spin_unlock'>
  if lock == nilptr then return 22 end -- EINVAL
  local state = nelibc_atomic_load_int(lock)
  if state == -1 then return 22 end -- EINVAL: destroyed
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if state ~= tid then return 1 end -- EPERM
  if nelibc_atomic_cas_int(lock, tid, 0) ~= 0 then return 1 end -- EPERM
  return 0
end

local function pthread_condattr_valid(attr: *PthreadCondAttr): boolean <inline>
  return attr ~= nilptr and attr.magic == PTHREAD_COND_ATTR_MAGIC and
         (attr.pshared == 0 or attr.pshared == 1) and
         (attr.clockid == CLOCK_REALTIME or attr.clockid == CLOCK_MONOTONIC)
end

local function pthread_cond_valid(cond: *PthreadCond): boolean <inline>
  return cond ~= nilptr and cond.magic == PTHREAD_COND_MAGIC and
         (cond.pshared == 0 or cond.pshared == 1) and
         (cond.clockid == CLOCK_REALTIME or cond.clockid == CLOCK_MONOTONIC)
end

local function pthread_condattr_init(attr: *PthreadCondAttr): cint <cexport, codename 'pthread_condattr_init'>
  if attr == nilptr then return 22 end -- EINVAL
  attr.magic = PTHREAD_COND_ATTR_MAGIC
  attr.pshared = 0
  attr.clockid = CLOCK_REALTIME
  return 0
end

local function pthread_condattr_destroy(attr: *PthreadCondAttr): cint <cexport, codename 'pthread_condattr_destroy'>
  if not pthread_condattr_valid(attr) then return 22 end -- EINVAL
  attr.magic = 0
  return 0
end

local function pthread_condattr_setpshared(attr: *PthreadCondAttr, pshared: cint): cint <cexport, codename 'pthread_condattr_setpshared'>
  if not pthread_condattr_valid(attr) or (pshared ~= 0 and pshared ~= 1) then return 22 end -- EINVAL
  attr.pshared = pshared
  return 0
end

local function pthread_condattr_getpshared(attr: *PthreadCondAttr, pshared: *[0]cint): cint <cexport, codename 'pthread_condattr_getpshared'>
  if not pthread_condattr_valid(attr) or pshared == nilptr then return 22 end -- EINVAL
  pshared[0] = attr.pshared
  return 0
end

local function pthread_condattr_setclock(attr: *PthreadCondAttr, clockid: cint): cint <cexport, codename 'pthread_condattr_setclock'>
  if not pthread_condattr_valid(attr) or
     (clockid ~= CLOCK_REALTIME and clockid ~= CLOCK_MONOTONIC) then
    return 22 -- EINVAL
  end
  attr.clockid = clockid
  return 0
end

local function pthread_condattr_getclock(attr: *PthreadCondAttr, clockid: *[0]cint): cint <cexport, codename 'pthread_condattr_getclock'>
  if not pthread_condattr_valid(attr) or clockid == nilptr then return 22 end -- EINVAL
  clockid[0] = attr.clockid
  return 0
end

local function pthread_cond_init(cond: *PthreadCond, attr: *PthreadCondAttr): cint <cexport, codename 'pthread_cond_init'>
  if cond == nilptr then return 22 end -- EINVAL
  local pshared: cint = 0
  local clockid: cint = CLOCK_REALTIME
  if attr ~= nilptr then
    if not pthread_condattr_valid(attr) then return 22 end -- EINVAL
    pshared = attr.pshared
    clockid = attr.clockid
  end
  cond.sequence = 0
  cond.waiters = 0
  cond.pshared = pshared
  cond.clockid = clockid
  cond.magic = PTHREAD_COND_MAGIC
  return 0
end

local function pthread_cond_destroy(cond: *PthreadCond): cint <cexport, codename 'pthread_cond_destroy'>
  if not pthread_cond_valid(cond) then return 22 end -- EINVAL
  if nelibc_atomic_load_int(&cond.waiters) ~= 0 then return 16 end -- EBUSY
  cond.magic = 0
  return 0
end

local function pthread_cond_wait_internal(cond: *PthreadCond, mutex: *PthreadMutex,
    abstime: *Timespec, clock_id: cint): cint
  if not pthread_cond_valid(cond) or not pthread_mutex_valid(mutex) then return 22 end -- EINVAL
  pthread_testcancel()
  if cond.pshared ~= mutex.pshared then return 22 end -- EINVAL
  if clock_id ~= CLOCK_REALTIME and clock_id ~= CLOCK_MONOTONIC then return 22 end -- EINVAL
  if abstime ~= nilptr and (abstime.tv_nsec < 0 or abstime.tv_nsec >= 1000000000) then
    return 22 -- EINVAL
  end
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if nelibc_atomic_load_int(&mutex.owner) ~= tid then return 1 end -- EPERM
  if mutex.kind == 1 and mutex.count ~= 1 then return 22 end -- EINVAL
  local sequence = nelibc_atomic_load_int(&cond.sequence)
  local context = pthread_current_context()
  -- Cancellation must not run cleanup handlers until the mutex has been
  -- reacquired, even when the thread uses asynchronous cancellation.
  pthread_cancel_defer_begin()
  nelibc_atomic_fetch_add_int(&cond.waiters, 1)
  local unlock_result = pthread_mutex_unlock(mutex)
  if unlock_result ~= 0 then
    nelibc_atomic_fetch_add_int(&cond.waiters, -1)
    pthread_cancel_defer_end()
    return unlock_result
  end
  local wait_operation: culong = 0_culong
  local timeout_pointer: culong = 0_culong
  local futex_mask: culong = 0_culong
  if abstime ~= nilptr then
    if clock_id == CLOCK_MONOTONIC then
      wait_operation = 9_culong -- FUTEX_WAIT_BITSET uses CLOCK_MONOTONIC
    else
      wait_operation = 265_culong -- FUTEX_WAIT_BITSET | FUTEX_CLOCK_REALTIME
    end
    timeout_pointer = (@culong)((@usize)(abstime))
    futex_mask = 0xFFFFFFFF_culong -- FUTEX_BITSET_MATCH_ANY
  end
  if cond.pshared == 0 then
    if abstime ~= nilptr then wait_operation = wait_operation | 128_culong
    else wait_operation = 128_culong end -- FUTEX_PRIVATE_FLAG
  end
  if context ~= nilptr then
    if cond.pshared == 0 then context.cancel_wait_wake_operation = 129
    else context.cancel_wait_wake_operation = 1 end
    nelibc_atomic_store_pointer(&context.cancel_wait_address, (@pointer)(&cond.sequence))
    if context.cancel_state == PTHREAD_CANCEL_ENABLE and
       nelibc_atomic_load_int(&context.cancel_pending) ~= 0 then
      pthread_cancel_wake(context)
    end
  end
  local wait_result = nelibc_raw_syscall6(
    202_culong, (@culong)((@usize)(&cond.sequence)), wait_operation,
    (@culong)(sequence), timeout_pointer, 0_culong, futex_mask
  )
  local wait_error: cint = 0
  if wait_result < 0 and wait_result >= -4095 then
    wait_error = (@cint)(-wait_result)
    if wait_error == 4 or wait_error == 11 then wait_error = 0 end -- EINTR/EAGAIN are spurious returns
  end
  if context ~= nilptr then nelibc_atomic_store_pointer(&context.cancel_wait_address, nilptr) end
  nelibc_atomic_fetch_add_int(&cond.waiters, -1)
  local lock_result = pthread_mutex_lock(mutex)
  pthread_cancel_defer_end()
  if lock_result ~= 0 then return lock_result end
  pthread_testcancel()
  return wait_error
end

local function pthread_cond_wait(cond: *PthreadCond, mutex: *PthreadMutex): cint <cexport, codename 'pthread_cond_wait'>
  if cond == nilptr then return 22 end -- EINVAL
  return pthread_cond_wait_internal(cond, mutex, nilptr, cond.clockid)
end

local function pthread_cond_timedwait(cond: *PthreadCond, mutex: *PthreadMutex, abstime: *Timespec): cint <cexport, codename 'pthread_cond_timedwait'>
  if abstime == nilptr then return 22 end -- EINVAL
  if cond == nilptr then return 22 end -- EINVAL
  return pthread_cond_wait_internal(cond, mutex, abstime, cond.clockid)
end

local function pthread_cond_clockwait(cond: *PthreadCond, mutex: *PthreadMutex,
    clock_id: cint, abstime: *Timespec): cint <cexport, codename 'pthread_cond_clockwait'>
  if abstime == nilptr then return 22 end -- EINVAL
  return pthread_cond_wait_internal(cond, mutex, abstime, clock_id)
end

local function pthread_cond_signal(cond: *PthreadCond): cint <cexport, codename 'pthread_cond_signal'>
  if not pthread_cond_valid(cond) then return 22 end -- EINVAL
  nelibc_atomic_fetch_add_int(&cond.sequence, 1)
  if nelibc_atomic_load_int(&cond.waiters) ~= 0 then
    local operation: culong = 129_culong
    if cond.pshared ~= 0 then operation = 1_culong end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&cond.sequence)),
                        operation, 1_culong, 0_culong, 0_culong, 0_culong)
  end
  return 0
end

local function pthread_cond_broadcast(cond: *PthreadCond): cint <cexport, codename 'pthread_cond_broadcast'>
  if not pthread_cond_valid(cond) then return 22 end -- EINVAL
  nelibc_atomic_fetch_add_int(&cond.sequence, 1)
  if nelibc_atomic_load_int(&cond.waiters) ~= 0 then
    local operation: culong = 129_culong
    if cond.pshared ~= 0 then operation = 1_culong end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&cond.sequence)),
                        operation, 2147483647_culong, 0_culong, 0_culong, 0_culong)
  end
  return 0
end

local function pthread_barrierattr_valid(attr: *PthreadBarrierAttr): boolean <inline>
  return attr ~= nilptr and attr.magic == PTHREAD_BARRIER_ATTR_MAGIC
end

local function pthread_barrier_valid(barrier: *PthreadBarrier): boolean <inline>
  return barrier ~= nilptr and barrier.magic == PTHREAD_BARRIER_MAGIC and
         barrier.count > 0
end

local function pthread_barrierattr_init(attr: *PthreadBarrierAttr): cint
    <cexport, codename 'pthread_barrierattr_init'>
  if attr == nilptr then return 22 end -- EINVAL
  attr.magic = PTHREAD_BARRIER_ATTR_MAGIC
  attr.pshared = 0
  return 0
end

local function pthread_barrierattr_destroy(attr: *PthreadBarrierAttr): cint
    <cexport, codename 'pthread_barrierattr_destroy'>
  if not pthread_barrierattr_valid(attr) then return 22 end -- EINVAL
  attr.magic = 0
  return 0
end

local function pthread_barrierattr_setpshared(attr: *PthreadBarrierAttr,
    pshared: cint): cint <cexport, codename 'pthread_barrierattr_setpshared'>
  if not pthread_barrierattr_valid(attr) or (pshared ~= 0 and pshared ~= 1) then
    return 22 -- EINVAL
  end
  attr.pshared = pshared
  return 0
end

local function pthread_barrierattr_getpshared(attr: *PthreadBarrierAttr,
    pshared: *[0]cint): cint <cexport, codename 'pthread_barrierattr_getpshared'>
  if not pthread_barrierattr_valid(attr) or pshared == nilptr then return 22 end
  pshared[0] = attr.pshared
  return 0
end

local function pthread_barrier_init(barrier: *PthreadBarrier,
    attr: *PthreadBarrierAttr, count: cuint): cint
    <cexport, codename 'pthread_barrier_init'>
  if barrier == nilptr or count == 0 or count > 2147483647_cuint then
    return 22 -- EINVAL
  end
  local pshared: cint = 0
  if attr ~= nilptr then
    if not pthread_barrierattr_valid(attr) then return 22 end
    pshared = attr.pshared
  end
  barrier.count = (@cint)(count)
  barrier.arrived = 0
  barrier.generation = 0
  barrier.pshared = pshared
  barrier.magic = PTHREAD_BARRIER_MAGIC
  return 0
end

local function pthread_barrier_destroy(barrier: *PthreadBarrier): cint
    <cexport, codename 'pthread_barrier_destroy'>
  if not pthread_barrier_valid(barrier) then return 22 end -- EINVAL
  if nelibc_atomic_load_int(&barrier.arrived) ~= 0 then return 16 end -- EBUSY
  barrier.magic = 0
  return 0
end

local function pthread_barrier_wait(barrier: *PthreadBarrier): cint
    <cexport, codename 'pthread_barrier_wait'>
  if not pthread_barrier_valid(barrier) then return 22 end -- EINVAL
  local generation = nelibc_atomic_load_int(&barrier.generation)
  local position = nelibc_atomic_fetch_add_int(&barrier.arrived, 1)
  if position < 0 or position >= barrier.count then
    nelibc_atomic_fetch_add_int(&barrier.arrived, -1)
    return 22 -- EINVAL: corrupt or concurrently reused barrier state
  end
  if position == barrier.count - 1 then
    nelibc_atomic_store_int(&barrier.arrived, 0)
    nelibc_atomic_fetch_add_int(&barrier.generation, 1)
    local operation: culong = 129_culong -- FUTEX_WAKE | FUTEX_PRIVATE_FLAG
    if barrier.pshared ~= 0 then operation = 1_culong end
    nelibc_raw_syscall6(202_culong,
      (@culong)((@usize)(&barrier.generation)), operation,
      2147483647_culong, 0_culong, 0_culong, 0_culong)
    return -1 -- PTHREAD_BARRIER_SERIAL_THREAD
  end
  local operation: culong = 128_culong -- FUTEX_WAIT | FUTEX_PRIVATE_FLAG
  if barrier.pshared ~= 0 then operation = 0_culong end
  while nelibc_atomic_load_int(&barrier.generation) == generation do
    nelibc_raw_syscall6(202_culong,
      (@culong)((@usize)(&barrier.generation)), operation,
      (@culong)(generation), 0_culong, 0_culong, 0_culong)
  end
  return 0
end

local function pthread_rwlockattr_valid(attr: *PthreadRwlockAttr): boolean <inline>
  return attr ~= nilptr and attr.magic == PTHREAD_RWLOCK_ATTR_MAGIC
end

local function pthread_rwlock_valid(rwlock: *PthreadRwlock): boolean <inline>
  return rwlock ~= nilptr and rwlock.magic == PTHREAD_RWLOCK_MAGIC and
         (rwlock.pshared == 0 or rwlock.pshared == 1)
end

local function pthread_rwlock_wake(rwlock: *PthreadRwlock): void
  nelibc_atomic_fetch_add_int(&rwlock.sequence, 1)
  local operation: culong = 129_culong -- FUTEX_WAKE | FUTEX_PRIVATE_FLAG
  if rwlock.pshared ~= 0 then operation = 1_culong end
  nelibc_raw_syscall6(202_culong,
    (@culong)((@usize)(&rwlock.sequence)), operation,
    2147483647_culong, 0_culong, 0_culong, 0_culong)
end

local function pthread_rwlock_wait(rwlock: *PthreadRwlock, sequence: cint,
    abstime: *Timespec, clock_id: cint): cint
  if abstime ~= nilptr and
      (abstime.tv_nsec < 0 or abstime.tv_nsec >= 1000000000) then
    return 22 -- EINVAL
  end
  local operation: culong = 0_culong
  local timeout_pointer: culong = 0_culong
  local bitset: culong = 0_culong
  if abstime ~= nilptr then
    if clock_id == CLOCK_MONOTONIC then
      operation = 9_culong -- FUTEX_WAIT_BITSET uses CLOCK_MONOTONIC
    else
      operation = 265_culong -- FUTEX_WAIT_BITSET | FUTEX_CLOCK_REALTIME
    end
    timeout_pointer = (@culong)((@usize)(abstime))
    bitset = 0xFFFFFFFF_culong
  end
  if rwlock.pshared == 0 then operation = operation | 128_culong end
  local result = nelibc_raw_syscall6(202_culong,
    (@culong)((@usize)(&rwlock.sequence)), operation,
    (@culong)(sequence), timeout_pointer, 0_culong, bitset)
  if result < 0 and result >= -4095 then
    local error = (@cint)(-result)
    if error == 4 or error == 11 then return 0 end -- EINTR/EAGAIN: retry
    return error
  end
  return 0
end

local function pthread_rwlockattr_init(attr: *PthreadRwlockAttr): cint
    <cexport, codename 'pthread_rwlockattr_init'>
  if attr == nilptr then return 22 end -- EINVAL
  attr.magic = PTHREAD_RWLOCK_ATTR_MAGIC
  attr.pshared = 0
  return 0
end

local function pthread_rwlockattr_destroy(attr: *PthreadRwlockAttr): cint
    <cexport, codename 'pthread_rwlockattr_destroy'>
  if not pthread_rwlockattr_valid(attr) then return 22 end -- EINVAL
  attr.magic = 0
  return 0
end

local function pthread_rwlockattr_setpshared(attr: *PthreadRwlockAttr,
    pshared: cint): cint <cexport, codename 'pthread_rwlockattr_setpshared'>
  if not pthread_rwlockattr_valid(attr) or (pshared ~= 0 and pshared ~= 1) then
    return 22 -- EINVAL
  end
  attr.pshared = pshared
  return 0
end

local function pthread_rwlockattr_getpshared(attr: *PthreadRwlockAttr,
    pshared: *[0]cint): cint <cexport, codename 'pthread_rwlockattr_getpshared'>
  if not pthread_rwlockattr_valid(attr) or pshared == nilptr then return 22 end
  pshared[0] = attr.pshared
  return 0
end

local function pthread_rwlock_init(rwlock: *PthreadRwlock,
    attr: *PthreadRwlockAttr): cint <cexport, codename 'pthread_rwlock_init'>
  if rwlock == nilptr then return 22 end -- EINVAL
  local pshared: cint = 0
  if attr ~= nilptr then
    if not pthread_rwlockattr_valid(attr) then return 22 end
    pshared = attr.pshared
  end
  rwlock.state = 0
  rwlock.writer = 0
  rwlock.waiting_writers = 0
  rwlock.sequence = 0
  rwlock.pshared = pshared
  rwlock.magic = PTHREAD_RWLOCK_MAGIC
  return 0
end

local function pthread_rwlock_destroy(rwlock: *PthreadRwlock): cint
    <cexport, codename 'pthread_rwlock_destroy'>
  if not pthread_rwlock_valid(rwlock) then return 22 end -- EINVAL
  if nelibc_atomic_load_int(&rwlock.state) ~= 0 or
      nelibc_atomic_load_int(&rwlock.waiting_writers) ~= 0 then
    return 16 -- EBUSY
  end
  rwlock.magic = 0
  return 0
end

local function pthread_rwlock_rdlock_internal(rwlock: *PthreadRwlock,
    abstime: *Timespec, clock_id: cint, nonblocking: boolean): cint
  if not pthread_rwlock_valid(rwlock) then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if nelibc_atomic_load_int(&rwlock.state) < 0 and rwlock.writer == tid then
    if nonblocking then return 16 end -- EBUSY
    return 35 -- EDEADLK
  end
  while true do
    local sequence = nelibc_atomic_load_int(&rwlock.sequence)
    local state = nelibc_atomic_load_int(&rwlock.state)
    if state >= 2147483647 then return 11 end -- EAGAIN
    if state >= 0 then
      if nelibc_atomic_cas_int(&rwlock.state, state, state + 1) == 0 then
        return 0
      end
      continue
    end
    if nonblocking then return 16 end -- EBUSY
    local wait_error = pthread_rwlock_wait(rwlock, sequence, abstime, clock_id)
    if wait_error == 110 then -- ETIMEDOUT: take any lock available at the deadline
      state = nelibc_atomic_load_int(&rwlock.state)
      if state >= 0 and state < 2147483647 and
          nelibc_atomic_cas_int(&rwlock.state, state, state + 1) == 0 then
        return 0
      end
      return wait_error
    end
    if wait_error ~= 0 then return wait_error end
  end
end

local function pthread_rwlock_rdlock(rwlock: *PthreadRwlock): cint
    <cexport, codename 'pthread_rwlock_rdlock'>
  return pthread_rwlock_rdlock_internal(rwlock, nilptr, CLOCK_REALTIME, false)
end

local function pthread_rwlock_tryrdlock(rwlock: *PthreadRwlock): cint
    <cexport, codename 'pthread_rwlock_tryrdlock'>
  return pthread_rwlock_rdlock_internal(rwlock, nilptr, CLOCK_REALTIME, true)
end

local function pthread_rwlock_timedrdlock(rwlock: *PthreadRwlock,
    abstime: *Timespec): cint <cexport, codename 'pthread_rwlock_timedrdlock'>
  if abstime == nilptr then return 22 end -- EINVAL
  return pthread_rwlock_rdlock_internal(rwlock, abstime, CLOCK_REALTIME, false)
end

local function pthread_rwlock_clockrdlock(rwlock: *PthreadRwlock,
    clock_id: cint, abstime: *Timespec): cint
    <cexport, codename 'pthread_rwlock_clockrdlock'>
  if abstime == nilptr or
     (clock_id ~= CLOCK_REALTIME and clock_id ~= CLOCK_MONOTONIC) then
    return 22 -- EINVAL
  end
  return pthread_rwlock_rdlock_internal(rwlock, abstime, clock_id, false)
end

local function pthread_rwlock_wrlock_internal(rwlock: *PthreadRwlock,
    abstime: *Timespec, clock_id: cint, nonblocking: boolean): cint
  if not pthread_rwlock_valid(rwlock) then return 22 end -- EINVAL
  local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
  if not nonblocking and nelibc_atomic_load_int(&rwlock.state) < 0 and
      rwlock.writer == tid then
    return 35 -- EDEADLK
  end
  if nonblocking then
    if nelibc_atomic_cas_int(&rwlock.state, 0, -1) ~= 0 then return 16 end
    nelibc_atomic_store_int(&rwlock.writer, tid)
    return 0
  end
  nelibc_atomic_fetch_add_int(&rwlock.waiting_writers, 1)
  while true do
    local sequence = nelibc_atomic_load_int(&rwlock.sequence)
    if nelibc_atomic_cas_int(&rwlock.state, 0, -1) == 0 then
      nelibc_atomic_fetch_add_int(&rwlock.waiting_writers, -1)
      nelibc_atomic_store_int(&rwlock.writer, tid)
      return 0
    end
    local wait_error = pthread_rwlock_wait(rwlock, sequence, abstime, clock_id)
    if wait_error ~= 0 then
      if wait_error == 110 and nelibc_atomic_cas_int(&rwlock.state, 0, -1) == 0 then
        nelibc_atomic_fetch_add_int(&rwlock.waiting_writers, -1)
        nelibc_atomic_store_int(&rwlock.writer, tid)
        return 0
      end
      nelibc_atomic_fetch_add_int(&rwlock.waiting_writers, -1)
      pthread_rwlock_wake(rwlock)
      return wait_error
    end
  end
end

local function pthread_rwlock_wrlock(rwlock: *PthreadRwlock): cint
    <cexport, codename 'pthread_rwlock_wrlock'>
  return pthread_rwlock_wrlock_internal(rwlock, nilptr, CLOCK_REALTIME, false)
end

local function pthread_rwlock_trywrlock(rwlock: *PthreadRwlock): cint
    <cexport, codename 'pthread_rwlock_trywrlock'>
  return pthread_rwlock_wrlock_internal(rwlock, nilptr, CLOCK_REALTIME, true)
end

local function pthread_rwlock_timedwrlock(rwlock: *PthreadRwlock,
    abstime: *Timespec): cint <cexport, codename 'pthread_rwlock_timedwrlock'>
  if abstime == nilptr then return 22 end -- EINVAL
  return pthread_rwlock_wrlock_internal(rwlock, abstime, CLOCK_REALTIME, false)
end

local function pthread_rwlock_clockwrlock(rwlock: *PthreadRwlock,
    clock_id: cint, abstime: *Timespec): cint
    <cexport, codename 'pthread_rwlock_clockwrlock'>
  if abstime == nilptr or
     (clock_id ~= CLOCK_REALTIME and clock_id ~= CLOCK_MONOTONIC) then
    return 22 -- EINVAL
  end
  return pthread_rwlock_wrlock_internal(rwlock, abstime, clock_id, false)
end

local function pthread_rwlock_unlock(rwlock: *PthreadRwlock): cint
    <cexport, codename 'pthread_rwlock_unlock'>
  if not pthread_rwlock_valid(rwlock) then return 22 end -- EINVAL
  while true do
    local state = nelibc_atomic_load_int(&rwlock.state)
    if state < 0 then
      local tid = (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
      if rwlock.writer ~= tid then return 1 end -- EPERM
      nelibc_atomic_store_int(&rwlock.writer, 0)
      if nelibc_atomic_cas_int(&rwlock.state, -1, 0) ~= 0 then return 1 end
      pthread_rwlock_wake(rwlock)
      return 0
    end
    if state == 0 then return 1 end -- EPERM
    if nelibc_atomic_cas_int(&rwlock.state, state, state - 1) == 0 then
      if state == 1 then pthread_rwlock_wake(rwlock) end
      return 0
    end
  end
end

local function semaphore_valid(sem: *Semaphore): boolean <inline>
  return sem ~= nilptr and (sem.magic == SEMAPHORE_MAGIC or
    sem.magic == (SEMAPHORE_MAGIC | 0x8000000000000000_culong))
end

local function semaphore_shared(sem: *Semaphore): boolean <inline>
  return (sem.magic & 0x8000000000000000_culong) ~= 0_culong
end

local function sem_init(sem: *Semaphore, pshared: cint, value: cuint): cint <cexport, codename 'sem_init'>
  if sem == nilptr or value > 2147483647_cuint then
    nelibc_errno_location()[0] = 22; return -1
  end
  sem.magic = SEMAPHORE_MAGIC
  if pshared ~= 0 then sem.magic = SEMAPHORE_MAGIC | 0x8000000000000000_culong end
  sem.value = (@cint)(value)
  sem.sequence = 0
  sem.waiters = 0
  return 0
end

local function sem_destroy(sem: *Semaphore): cint <cexport, codename 'sem_destroy'>
  if not semaphore_valid(sem) then nelibc_errno_location()[0] = 22; return -1 end
  if nelibc_atomic_load_int(&sem.waiters) ~= 0 then nelibc_errno_location()[0] = 16; return -1 end
  sem.magic = 0
  return 0
end

local function sem_trywait(sem: *Semaphore): cint <cexport, codename 'sem_trywait'>
  if not semaphore_valid(sem) then nelibc_errno_location()[0] = 22; return -1 end
  while true do
    local value = nelibc_atomic_load_int(&sem.value)
    if value == 0 then nelibc_errno_location()[0] = 11; return -1 end
    if nelibc_atomic_cas_int(&sem.value, value, value - 1) == 0 then return 0 end
  end
end

local function sem_post(sem: *Semaphore): cint <cexport, codename 'sem_post'>
  if not semaphore_valid(sem) then nelibc_errno_location()[0] = 22; return -1 end
  while true do
    local value = nelibc_atomic_load_int(&sem.value)
    if value == 2147483647 then nelibc_errno_location()[0] = 75; return -1 end
    if nelibc_atomic_cas_int(&sem.value, value, value + 1) == 0 then break end
  end
  if nelibc_atomic_load_int(&sem.waiters) ~= 0 then
    nelibc_atomic_fetch_add_int(&sem.sequence, 1)
    local operation: culong = 129_culong
    if semaphore_shared(sem) then operation = 1_culong end
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&sem.sequence)),
                        operation, 1_culong, 0_culong, 0_culong, 0_culong)
  end
  return 0
end

local function semaphore_wait(sem: *Semaphore, abstime: *Timespec, timed: boolean,
                              clock_id: cint): cint
  if not semaphore_valid(sem) then
    nelibc_errno_location()[0] = 22; return -1
  end
  pthread_testcancel()
  while true do
    local value = nelibc_atomic_load_int(&sem.value)
    if value > 0 and nelibc_atomic_cas_int(&sem.value, value, value - 1) == 0 then return 0 end
    if timed then
      if abstime == nilptr then
        nelibc_errno_location()[0] = 22 -- EINVAL
        return -1
      end
      if abstime.tv_nsec < 0 or abstime.tv_nsec >= 1000000000 then
        nelibc_errno_location()[0] = 22 -- EINVAL
        return -1
      end
    end
    local sequence = nelibc_atomic_load_int(&sem.sequence)
    local context = pthread_current_context()
    nelibc_atomic_fetch_add_int(&sem.waiters, 1)
    if context ~= nilptr then
      if semaphore_shared(sem) then context.cancel_wait_wake_operation = 1
      else context.cancel_wait_wake_operation = 129 end
      nelibc_atomic_store_pointer(&context.cancel_wait_address, (@pointer)(&sem.sequence))
      if context.cancel_state == PTHREAD_CANCEL_ENABLE and
         nelibc_atomic_load_int(&context.cancel_pending) ~= 0 then pthread_cancel_wake(context) end
    end
    -- A post may have observed no waiters just before we registered. Recheck
    -- both the token count and sequence before entering the kernel.
    if nelibc_atomic_load_int(&sem.value) > 0 or
       nelibc_atomic_load_int(&sem.sequence) ~= sequence then
      if context ~= nilptr then nelibc_atomic_store_pointer(&context.cancel_wait_address, nilptr) end
      nelibc_atomic_fetch_add_int(&sem.waiters, -1)
      continue
    end
    local operation: culong = 0_culong
    local timeout_pointer: culong = 0_culong
    local mask: culong = 0_culong
    if abstime ~= nilptr then
      operation = 9_culong -- FUTEX_WAIT_BITSET (CLOCK_MONOTONIC)
      if clock_id == 0_cint then operation = 265_culong end -- FUTEX_CLOCK_REALTIME
      timeout_pointer = (@culong)((@usize)(abstime))
      mask = 0xFFFFFFFF_culong
    end
    if not semaphore_shared(sem) then operation = operation | 128_culong end
    local result = nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&sem.sequence)),
      operation, (@culong)(sequence), timeout_pointer, 0_culong, mask)
    if context ~= nilptr then nelibc_atomic_store_pointer(&context.cancel_wait_address, nilptr) end
    nelibc_atomic_fetch_add_int(&sem.waiters, -1)
    pthread_testcancel()
    if result == -110 then nelibc_errno_location()[0] = 110; return -1 end
    if result == -4 then
      local cancel_context = pthread_current_context()
      if cancel_context ~= nilptr and cancel_context.cancel_state == PTHREAD_CANCEL_DISABLE and
         nelibc_atomic_load_int(&cancel_context.cancel_pending) ~= 0 then
        continue -- Hide the internal cancellation signal while cancellation is disabled.
      end
      nelibc_errno_location()[0] = 4
      return -1
    end
