## pragmas.nogc = true
## pragmas.noentrypoint = true

local function nelibc_gnu_strerror_r(errnum: cint, buffer: *[0]cchar,
    buffer_size: csize): *[0]cchar <cimport> end

local function hybrid_gnu_strerror_r(errnum: cint, buffer: *[0]cchar,
    buffer_size: csize): *[0]cchar <cexport, codename 'strerror_r'>
  return nelibc_gnu_strerror_r(errnum, buffer, buffer_size)
end
