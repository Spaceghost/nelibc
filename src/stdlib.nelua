local function abs(value: cint): cint <cexport, codename 'abs'>
  if value < 0 then return -value end
  return value
end

-- Keep abort in the shared stdlib layer: host libcs provide raise/_Exit while
-- standalone builds resolve them to nelibc's thread-directed raise and _Exit.
local function abort(): void <cexport, codename 'abort'>
  raise(6) -- SIGABRT on the Linux targets supported by this runtime.
  _Exit(134)
end

local function labs(value: clong): clong <cexport, codename 'labs'>
  if value < 0 then return -value end
  return value
end

local function llabs(value: clonglong): clonglong <cexport, codename 'llabs'>
  if value < 0 then return -value end
  return value
end

local function imaxabs(value: clong): clong <cexport, codename 'imaxabs'>
  if value < 0 then return -value end
  return value
end

local function ffs(value: cint): cint <cexport, codename 'ffs'>
  local bits: cuint = (@cuint)(value)
  if bits == 0 then return 0 end
  local position: cint = 1
  while (bits & 1_cuint) == 0 do
    bits = bits >> 1
    position = position + 1
  end
  return position
end

local function ffsl(value: clong): cint <cexport, codename 'ffsl'>
  local bits: culong = (@culong)(value)
  if bits == 0 then return 0 end
  local position: cint = 1
  while (bits & 1_culong) == 0 do
    bits = bits >> 1
    position = position + 1
  end
  return position
end

local function ffsll(value: clonglong): cint <cexport, codename 'ffsll'>
  local bits: culonglong = (@culonglong)(value)
  if bits == 0 then return 0 end
  local position: cint = 1
  while (bits & 1_culonglong) == 0 do
    bits = bits >> 1
    position = position + 1
  end
  return position
end

local function srand(seed: cuint): void <cexport, codename 'srand'>
  if seed == 0 then
    random_state = 0x6D2B79F5_cuint
  else
    random_state = seed
  end
end

local function rand(): cint <cexport, codename 'rand'>
  local state: cuint = random_state
  state = state ~ (state << 13)
  state = state ~ (state >> 17)
  state = state ~ (state << 5)
  random_state = state
  return (@cint)(state & 0x7FFFFFFF_cuint)
end

local function rand_r(seed: *[0]cuint): cint <cexport, codename 'rand_r'>
  local state: culonglong = (@culonglong)(seed[0]) + 0x9E3779B97F4A7C15_culonglong
  local value: culonglong = state
  value = (value ~ (value >> 30)) * 0xBF58476D1CE4E5B9_culonglong
  value = (value ~ (value >> 27)) * 0x94D049BB133111EB_culonglong
  value = value ~ (value >> 31)
  seed[0] = (@cuint)(state & 0xFFFFFFFF_culonglong)
  return (@cint)(value >> 33)
end

local function swap_elements(left: *[0]cchar, right: *[0]cchar, width: csize): void <inline>
  local index: csize = 0
  while index < width do
    local temporary: cchar = left[index]
    left[index] = right[index]
    right[index] = temporary
    index = index + 1
  end
end

local function sift_down(bytes: *[0]cchar, root: csize, end_index: csize,
    width: csize, compare: function(pointer, pointer): cint): void <inline>
  local parent: csize = root
  -- Build targets enable this path only where the shootout favors hole sifting.
  ## cemit '#if defined(NELIBC_QSORT_HOLE_SIFT)'
  if width <= 64 then
    local temporary: [64]byte = {}
    local byte_index: csize = 0
    while byte_index < width do
      temporary[byte_index] = (@byte)(bytes[parent * width + byte_index])
      byte_index = byte_index + 1
    end
    while end_index >= 2 and parent <= (end_index - 2) // 2 do
      local child: csize = parent * 2 + 1
      if child + 1 < end_index and
          compare((@pointer)(&bytes[child * width]), (@pointer)(&bytes[(child + 1) * width])) < 0 then
        child = child + 1
      end
      if compare((@pointer)(&temporary[0]), (@pointer)(&bytes[child * width])) >= 0 then break end
      byte_index = 0
      while byte_index < width do
        bytes[parent * width + byte_index] = bytes[child * width + byte_index]
        byte_index = byte_index + 1
      end
      parent = child
    end
    byte_index = 0
    while byte_index < width do
      bytes[parent * width + byte_index] = (@cchar)(temporary[byte_index])
      byte_index = byte_index + 1
    end
    return
  end
  ## cemit '#endif'

  while end_index >= 2 and parent <= (end_index - 2) // 2 do
    local child: csize = parent * 2 + 1
    if child + 1 < end_index and
        compare((@pointer)(&bytes[child * width]), (@pointer)(&bytes[(child + 1) * width])) < 0 then
      child = child + 1
    end
    if compare((@pointer)(&bytes[parent * width]), (@pointer)(&bytes[child * width])) >= 0 then return end
    swap_elements(&bytes[parent * width], &bytes[child * width], width)
    parent = child
  end
end

local function insertion_sort(bytes: *[0]cchar, count: csize, width: csize,
    compare: function(pointer, pointer): cint): void <inline>
  local temporary: [64]byte = {}
  local index: csize = 1
  while index < count do
    local position: csize = index
    local item_offset: csize = index * width
    local byte_index: csize = 0
    while byte_index < width do
      temporary[byte_index] = (@byte)(bytes[item_offset + byte_index])
      byte_index = byte_index + 1
    end
    while position > 0 and compare((@pointer)(&bytes[(position - 1) * width]),
                                   (@pointer)(&temporary[0])) > 0 do
      local copy_index: csize = 0
      while copy_index < width do
        bytes[position * width + copy_index] = bytes[(position - 1) * width + copy_index]
        copy_index = copy_index + 1
      end
      position = position - 1
    end
    byte_index = 0
    while byte_index < width do
      bytes[position * width + byte_index] = (@cchar)(temporary[byte_index])
      byte_index = byte_index + 1
    end
    index = index + 1
  end
end

local SortRange: type = @record{first: csize, last: csize, depth: csize}
local qsort_depth_fallbacks: cuint = 0

local function nelibc_test_qsort_depth_fallbacks(): cuint <cexport, codename 'nelibc_test_qsort_depth_fallbacks'>
  return qsort_depth_fallbacks
end

local function heap_sort(bytes: *[0]cchar, count: csize, width: csize,
    compare: function(pointer, pointer): cint): void <inline>
  local parent: csize = count // 2
  while parent > 0 do
    parent = parent - 1
    sift_down(bytes, parent, count, width, compare)
  end
  local end_index: csize = count
  while end_index > 1 do
    end_index = end_index - 1
    swap_elements(&bytes[0], &bytes[end_index * width], width)
    sift_down(bytes, 0, end_index, width, compare)
  end
end

local function sift_down_r(bytes: *[0]cchar, root: csize, count: csize,
    width: csize, compare: function(pointer, pointer, pointer): cint,
    context: pointer): void <inline>
  local current: csize = root
  while current < count // 2 do
    local child: csize = current * 2 + 1
    if child + 1 < count and
        compare((@pointer)(&bytes[child * width]),
                (@pointer)(&bytes[(child + 1) * width]), context) < 0 then
      child = child + 1
    end
    if compare((@pointer)(&bytes[current * width]),
               (@pointer)(&bytes[child * width]), context) >= 0 then break end
    swap_elements(&bytes[current * width], &bytes[child * width], width)
    current = child
  end
end

local function heap_sort_r(bytes: *[0]cchar, count: csize, width: csize,
    compare: function(pointer, pointer, pointer): cint,
    context: pointer): void <inline>
  local parent: csize = count // 2
  while parent > 0 do
    parent = parent - 1
    sift_down_r(bytes, parent, count, width, compare, context)
  end
  local end_index: csize = count
  while end_index > 1 do
    end_index = end_index - 1
    swap_elements(&bytes[0], &bytes[end_index * width], width)
    sift_down_r(bytes, 0, end_index, width, compare, context)
  end
end

local function insertion_sort_r(bytes: *[0]cchar, count: csize, width: csize,
    compare: function(pointer, pointer, pointer): cint,
    context: pointer): void <inline>
  local index: csize = 1
  while index < count do
    local position: csize = index
    while position > 0 and compare(
        (@pointer)(&bytes[position * width]),
        (@pointer)(&bytes[(position - 1) * width]), context) < 0 do
      swap_elements(&bytes[position * width],
                    &bytes[(position - 1) * width], width)
      position = position - 1
    end
    index = index + 1
  end
end

local function qsort_r(base: pointer, count: csize, width: csize,
    compare: function(pointer, pointer, pointer): cint,
    context: pointer): void <cexport, codename 'qsort_r'>
  if base == nilptr or compare == nilptr or count < 2 or width == 0 then return end
  local bytes: *[0]cchar = (@*[0]cchar)(base)
  if count <= 16 and width <= 64 then
    insertion_sort_r(bytes, count, width, compare, context)
  else
    heap_sort_r(bytes, count, width, compare, context)
  end
end

local function qsort(base: pointer, count: csize, width: csize,
    compare: function(pointer, pointer): cint): void <cexport, codename 'qsort'>
  if base == nilptr or compare == nilptr or count < 2 or width == 0 then return end
  local bytes: *[0]cchar = (@*[0]cchar)(base)
  if count <= 16 and width <= 64 then
    insertion_sort(bytes, count, width, compare)
    return
  end

  local use_heap_sort: boolean = width > 64
  ## cemit '#if !defined(NELIBC_QSORT_GCC_INTROSORT)'
  use_heap_sort = use_heap_sort or count > 4096
  ## cemit '#endif'
  if use_heap_sort then
    heap_sort(bytes, count, width, compare)
    return
  end

  local ranges: [64]SortRange = {}
  local stack_size: csize = 0
  local first: csize = 0
  local last: csize = count
  local depth_limit: csize = 0
  local depth_count: csize = count
  while depth_count > 1 do
    depth_count = depth_count // 2
    depth_limit = depth_limit + 1
  end
  depth_limit = depth_limit * 2
  local running: boolean = true

  while running do
    while last - first > 16 do
      if depth_limit == 0 then
## cemit '#if defined(NELIBC_QSORT_DIAGNOSTICS)'
        qsort_depth_fallbacks = qsort_depth_fallbacks + 1
## cemit '#endif'
        heap_sort((@*[0]cchar)(&bytes[first * width]), last - first, width, compare)
        first = last
      else
        depth_limit = depth_limit - 1
        local low: csize = first
        local middle: csize = first + (last - first) // 2
        local high: csize = last - 1
        if compare((@pointer)(&bytes[low * width]), (@pointer)(&bytes[middle * width])) > 0 then
          swap_elements(&bytes[low * width], &bytes[middle * width], width)
        end
        if compare((@pointer)(&bytes[middle * width]), (@pointer)(&bytes[high * width])) > 0 then
          swap_elements(&bytes[middle * width], &bytes[high * width], width)
        end
        if compare((@pointer)(&bytes[low * width]), (@pointer)(&bytes[middle * width])) > 0 then
          swap_elements(&bytes[low * width], &bytes[middle * width], width)
        end

        local pivot: [64]byte = {}
        local byte_index: csize = 0
        while byte_index < width do
          pivot[byte_index] = (@byte)(bytes[middle * width + byte_index])
          byte_index = byte_index + 1
        end

        local left: csize = first
        local right: csize = last - 1
        local partitioning: boolean = true
        while partitioning do
          while left <= right and
              compare((@pointer)(&bytes[left * width]), (@pointer)(&pivot[0])) < 0 do
            left = left + 1
          end
          while left <= right and
              compare((@pointer)(&bytes[right * width]), (@pointer)(&pivot[0])) > 0 do
            if right > first then
              right = right - 1
            else
              partitioning = false
              break
            end
          end
          if not partitioning then break end
          if left >= right then
            partitioning = false
          else
            swap_elements(&bytes[left * width], &bytes[right * width], width)
            left = left + 1
            if right > first then
              right = right - 1
            else
              partitioning = false
            end
          end
        end

        local partition: csize = right + 1
        local left_count: csize = partition - first
        local right_count: csize = last - partition
        if left_count < right_count then
          if right_count > 1 then
            if stack_size < 64 then
              ranges[stack_size] = {first = partition, last = last, depth = depth_limit}
              stack_size = stack_size + 1
            else
              heap_sort((@*[0]cchar)(&bytes[partition * width]), right_count, width, compare)
            end
          end
          last = partition
        else
          if left_count > 1 then
            if stack_size < 64 then
              ranges[stack_size] = {first = first, last = partition, depth = depth_limit}
              stack_size = stack_size + 1
            else
              heap_sort(bytes, left_count, width, compare)
            end
          end
          first = partition
        end
      end
    end

    if last - first > 1 then
      insertion_sort((@*[0]cchar)(&bytes[first * width]), last - first, width, compare)
    end
    if stack_size == 0 then
      running = false
    else
      stack_size = stack_size - 1
      first = ranges[stack_size].first
      last = ranges[stack_size].last
      depth_limit = ranges[stack_size].depth
    end
  end
end

local function bsearch(key: pointer, base: pointer, count: csize, width: csize,
    compare: function(pointer, pointer): cint): pointer <cexport, codename 'bsearch'>
  if key == nilptr or base == nilptr or compare == nilptr or width == 0 then return nilptr end
  local bytes: *[0]cchar = (@*[0]cchar)(base)
  local first: csize = 0
  local remaining: csize = count
  while remaining > 0 do
    local half: csize = remaining // 2
    local middle: csize = first + half
    local element: pointer = (@pointer)(&bytes[middle * width])
    local order: cint = compare(key, element)
    if order == 0 then return element end
    first = middle + 1
    remaining = remaining - half - 1
    if order < 0 then remaining = half; first = middle - half end
  end
  return nilptr
end

-- Check multiplication in Nelua, then use this build's matching realloc.
local function reallocarray(ptr: pointer, count: csize, size: csize): pointer <cexport, codename 'reallocarray'>
  if size ~= 0_csize and count > (~0_csize) // size then
    nelibc_errno_location()[0] = 12_cint -- ENOMEM
    return nilptr
  end
  return realloc(ptr, count * size)
end

-- Subtract after conversion so the time_t operands cannot overflow first.
local function difftime(time1: clong, time0: clong): cdouble <cexport, codename 'difftime'>
  return (@cdouble)(time1) - (@cdouble)(time0)
end

local DivResult: type = @record{quot: cint, rem: cint}
local LdivResult: type = @record{quot: clong, rem: clong}
local LldivResult: type = @record{quot: clonglong, rem: clonglong}

local function div(numerator: cint, denominator: cint): DivResult <cexport, codename 'div'>
  local quotient: cint = numerator // denominator
  local remainder: cint = numerator % denominator
  if remainder ~= 0 and ((numerator < 0) ~= (denominator < 0)) then
    quotient = quotient + 1
    remainder = remainder - denominator
  end
  return {quot = quotient, rem = remainder}
end

local function ldiv(numerator: clong, denominator: clong): LdivResult <cexport, codename 'ldiv'>
  local quotient: clong = numerator // denominator
  local remainder: clong = numerator % denominator
  if remainder ~= 0 and ((numerator < 0) ~= (denominator < 0)) then
    quotient = quotient + 1
    remainder = remainder - denominator
  end
  return {quot = quotient, rem = remainder}
end

local function lldiv(numerator: clonglong, denominator: clonglong): LldivResult <cexport, codename 'lldiv'>
  local quotient: clonglong = numerator // denominator
  local remainder: clonglong = numerator % denominator
  if remainder ~= 0 and ((numerator < 0) ~= (denominator < 0)) then
    quotient = quotient + 1
    remainder = remainder - denominator
  end
  return {quot = quotient, rem = remainder}
end

local function imaxdiv(numerator: clong, denominator: clong): LdivResult <cexport, codename 'imaxdiv'>
  local quotient: clong = numerator // denominator
  local remainder: clong = numerator % denominator
  if remainder ~= 0 and ((numerator < 0) ~= (denominator < 0)) then
    quotient = quotient + 1
    remainder = remainder - denominator
  end
  return {quot = quotient, rem = remainder}
end
