## pragmas.nogc = true
## pragmas.noentrypoint = true

require 'C'
## cinclude '<locale.h>'

global C.locale_t: type <cimport,nodecl> = pointer
local function uselocale(locale: C.locale_t): C.locale_t <cimport,nodecl> end

local function nelibc_errno_location(): *[0]cint <cimport> end
local function nelibc_environment_vector(): **cchar <cimport> end
local function nelibc_environment_set_vector(environment: **cchar): void <cimport> end
local function nelibc_environment_pointer_size(): csize <cimport> end
local function malloc(size: csize): pointer <cimport> end
local function free(ptr: pointer): void <cimport> end
local function realloc(ptr: pointer, size: csize): pointer <cimport> end
