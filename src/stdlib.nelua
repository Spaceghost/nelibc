local function parse_long_locale(text: *[0]cchar <const>, end_text: **cchar,
    base: cint, c23: boolean, locale: C.locale_t): clonglong <inline>
  local previous: C.locale_t = uselocale(locale)
  if previous == (@C.locale_t)(0) then
    if end_text ~= nilptr then (@*[0]*cchar)(end_text)[0] = text end
    nelibc_errno_location()[0] = 22 -- EINVAL
    return 0_clonglong
  end
  local result: clonglong = parse_long(text, end_text, base, c23)
  uselocale(previous)
  return result
end

local function parse_ulong_locale(text: *[0]cchar <const>, end_text: **cchar,
    base: cint, c23: boolean, locale: C.locale_t): culonglong <inline>
  local previous: C.locale_t = uselocale(locale)
  if previous == (@C.locale_t)(0) then
    if end_text ~= nilptr then (@*[0]*cchar)(end_text)[0] = text end
    nelibc_errno_location()[0] = 22 -- EINVAL
    return 0_culonglong
  end
  local result: culonglong = parse_ulong(text, end_text, base, c23)
  uselocale(previous)
  return result
end

local function parse_wide_long_locale(text: *[0]cint <const>, end_text: **cint,
    base: cint, c23: boolean, locale: C.locale_t): clonglong <inline>
  local previous: C.locale_t = uselocale(locale)
  if previous == (@C.locale_t)(0) then
    if end_text ~= nilptr then (@*[0]*cint)(end_text)[0] = text end
    nelibc_errno_location()[0] = 22 -- EINVAL
    return 0_clonglong
  end
  local result: clonglong = parse_wide_long(text, end_text, base, c23)
  uselocale(previous)
  return result
end

local function parse_wide_ulong_locale(text: *[0]cint <const>, end_text: **cint,
    base: cint, c23: boolean, locale: C.locale_t): culonglong <inline>
  local previous: C.locale_t = uselocale(locale)
  if previous == (@C.locale_t)(0) then
    if end_text ~= nilptr then (@*[0]*cint)(end_text)[0] = text end
    nelibc_errno_location()[0] = 22 -- EINVAL
    return 0_culonglong
  end
  local result: culonglong = parse_wide_ulong(text, end_text, base, c23)
  uselocale(previous)
  return result
end

