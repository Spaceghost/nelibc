local function bytes_equal(a: *[0]cchar, b: *[0]cchar, n: usize): boolean
  local i: usize = 0
  while i < n do
    if a[i] ~= b[i] then return false end
    i = i + 1
  end
  return true
end

local function bounded_length(s: *[0]cchar, limit: usize): usize
  local n: usize = 0
  while n < limit and s[n] ~= CH_NUL do n = n + 1 end
  return n
end

local function copy_bytes(dst: *[0]uint8, src: *[0]uint8, n: usize): void
