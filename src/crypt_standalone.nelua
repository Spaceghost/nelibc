local function to64(out: *[0]cchar, p: usize, u: uint32, n: uint32): usize
  while n > 0 do
    out[p] = (@cchar)(crypt_ascii64[u & 63])
    u = u >> 6
    p = p + 1
    n = n - 1
  end
  return p
end

local function rol32(n: uint32, k: uint32): uint32 <inline>
  return (n << k) | (n >> (32 - k))
end

local function ror32(n: uint32, k: uint32): uint32 <inline>
  return (n >> k) | (n << (32 - k))
end

local function ror64(n: uint64, k: uint32): uint64 <inline>
  return (n >> k) | (n << (64 - k))
end

----------------------------------------------------------------------
-- MD5 ($1$, crypt_md5.c)
----------------------------------------------------------------------

local Md5: type = @record{
  len: uint64,
  h: [4]uint32,
  buf: [64]uint8
}

local function md5_f(x: uint32, y: uint32, z: uint32): uint32 <inline> return z ~ (x & (y ~ z)) end
local function md5_g(x: uint32, y: uint32, z: uint32): uint32 <inline> return y ~ (z & (y ~ x)) end
local function md5_h(x: uint32, y: uint32, z: uint32): uint32 <inline> return x ~ y ~ z end
local function md5_i(x: uint32, y: uint32, z: uint32): uint32 <inline> return y ~ (x | ~z) end

local function md5_step(a: uint32, f: uint32, w: uint32, s: uint32, t: uint32, b: uint32): uint32 <inline>
  return rol32(a + f + w + t, s) + b
end

local function md5_block(s: *Md5, buf: *[0]uint8): void
  local w: [16]uint32
  for i: usize = 0, 15 do
    w[i] = (@uint32)(buf[4*i]) | ((@uint32)(buf[4*i+1]) << 8) |
      ((@uint32)(buf[4*i+2]) << 16) | ((@uint32)(buf[4*i+3]) << 24)
  end
  local a: uint32, b: uint32, c: uint32, d: uint32 = s.h[0], s.h[1], s.h[2], s.h[3]
  local i: usize = 0
  while i < 16 do
    a = md5_step(a, md5_f(b, c, d), w[i], 7, md5_tab[i], b); i = i + 1
    d = md5_step(d, md5_f(a, b, c), w[i], 12, md5_tab[i], a); i = i + 1
    c = md5_step(c, md5_f(d, a, b), w[i], 17, md5_tab[i], d); i = i + 1
    b = md5_step(b, md5_f(c, d, a), w[i], 22, md5_tab[i], c); i = i + 1
  end
  while i < 32 do
    a = md5_step(a, md5_g(b, c, d), w[(5*i+1) & 15], 5, md5_tab[i], b); i = i + 1
    d = md5_step(d, md5_g(a, b, c), w[(5*i+1) & 15], 9, md5_tab[i], a); i = i + 1
    c = md5_step(c, md5_g(d, a, b), w[(5*i+1) & 15], 14, md5_tab[i], d); i = i + 1
    b = md5_step(b, md5_g(c, d, a), w[(5*i+1) & 15], 20, md5_tab[i], c); i = i + 1
  end
  while i < 48 do
    a = md5_step(a, md5_h(b, c, d), w[(3*i+5) & 15], 4, md5_tab[i], b); i = i + 1
    d = md5_step(d, md5_h(a, b, c), w[(3*i+5) & 15], 11, md5_tab[i], a); i = i + 1
    c = md5_step(c, md5_h(d, a, b), w[(3*i+5) & 15], 16, md5_tab[i], d); i = i + 1
    b = md5_step(b, md5_h(c, d, a), w[(3*i+5) & 15], 23, md5_tab[i], c); i = i + 1
  end
  while i < 64 do
    a = md5_step(a, md5_i(b, c, d), w[(7*i) & 15], 6, md5_tab[i], b); i = i + 1
    d = md5_step(d, md5_i(a, b, c), w[(7*i) & 15], 10, md5_tab[i], a); i = i + 1
    c = md5_step(c, md5_i(d, a, b), w[(7*i) & 15], 15, md5_tab[i], d); i = i + 1
    b = md5_step(b, md5_i(c, d, a), w[(7*i) & 15], 21, md5_tab[i], c); i = i + 1
  end
  s.h[0] = s.h[0] + a
  s.h[1] = s.h[1] + b
  s.h[2] = s.h[2] + c
  s.h[3] = s.h[3] + d
end

local function md5_init(s: *Md5): void
  s.len = 0
  s.h[0] = 0x67452301_u32
  s.h[1] = 0xefcdab89_u32
  s.h[2] = 0x98badcfe_u32
  s.h[3] = 0x10325476_u32
end

local function md5_update(s: *Md5, m: *[0]uint8, len: usize): void
  local p: usize = 0
  local r: usize = (@usize)(s.len & 63)
  s.len = s.len + len
  if r ~= 0 then
    if len < 64 - r then
      copy_bytes((@*[0]uint8)(&s.buf[r]), m, len)
      return
    end
    copy_bytes((@*[0]uint8)(&s.buf[r]), m, 64 - r)
    len = len - (64 - r)
    p = 64 - r
    md5_block(s, (@*[0]uint8)(&s.buf))
  end
  while len >= 64 do
    md5_block(s, (@*[0]uint8)(&m[p]))
    len = len - 64
    p = p + 64
  end
  copy_bytes((@*[0]uint8)(&s.buf), (@*[0]uint8)(&m[p]), len)
end

local function md5_sum(s: *Md5, md: *[16]uint8): void
  local r: usize = (@usize)(s.len & 63)
  s.buf[r] = 0x80
  r = r + 1
  if r > 56 then
    while r < 64 do s.buf[r] = 0; r = r + 1 end
    r = 0
    md5_block(s, (@*[0]uint8)(&s.buf))
  end
  while r < 56 do s.buf[r] = 0; r = r + 1 end
  s.len = s.len * 8
  for k: uint32 = 0, 7 do s.buf[56 + k] = (@uint8)(s.len >> (8 * k)) end
  md5_block(s, (@*[0]uint8)(&s.buf))
  for k: usize = 0, 3 do
    md[4*k] = (@uint8)(s.h[k])
    md[4*k+1] = (@uint8)(s.h[k] >> 8)
    md[4*k+2] = (@uint8)(s.h[k] >> 16)
    md[4*k+3] = (@uint8)(s.h[k] >> 24)
  end
end

local MD5_KEY_MAX: usize <comptime> = 30000
local MD5_SALT_MAX: usize <comptime> = 8

local function md5crypt(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar): *[0]cchar
  -- reject large keys
  local klen: usize = bounded_length(key, MD5_KEY_MAX + 1)
  if klen > MD5_KEY_MAX then return nilptr end

  -- setting: $1$salt$ (closing $ is optional)
  if setting[0] ~= CH_DOLLAR or setting[1] ~= CH_ONE or setting[2] ~= CH_DOLLAR then
    return nilptr
  end
  local salt: *[0]cchar = (@*[0]cchar)(&setting[3])
  local slen: usize = 0
  while slen < MD5_SALT_MAX and salt[slen] ~= CH_NUL and salt[slen] ~= CH_DOLLAR do
    slen = slen + 1
  end
  local k: *[0]uint8 = (@*[0]uint8)(key)
  local sb: *[0]uint8 = (@*[0]uint8)(salt)
  local ctx: Md5
  local md: [16]uint8

  -- md5(key salt key)
  md5_init(&ctx)
  md5_update(&ctx, k, klen)
  md5_update(&ctx, sb, slen)
  md5_update(&ctx, k, klen)
  md5_sum(&ctx, &md)

  -- md5(key $1$ salt repeated-md weird-key[0]-0)
  md5_init(&ctx)
  md5_update(&ctx, k, klen)
  md5_update(&ctx, (@*[0]uint8)(setting), 3 + slen)
  local i: usize = klen
  while i > 16 do
    md5_update(&ctx, (@*[0]uint8)(&md), 16)
    i = i - 16
  end
  md5_update(&ctx, (@*[0]uint8)(&md), i)
  md[0] = 0
  i = klen
  while i ~= 0 do
    if (i & 1) ~= 0 then
      md5_update(&ctx, (@*[0]uint8)(&md), 1)
    else
      md5_update(&ctx, k, 1)
    end
    i = i >> 1
  end
  md5_sum(&ctx, &md)

  -- md = f(md, key, salt) iteration
  for n: uint32 = 0, 999 do
    md5_init(&ctx)
    if n % 2 ~= 0 then
      md5_update(&ctx, k, klen)
    else
      md5_update(&ctx, (@*[0]uint8)(&md), 16)
    end
    if n % 3 ~= 0 then md5_update(&ctx, sb, slen) end
    if n % 7 ~= 0 then md5_update(&ctx, k, klen) end
    if n % 2 ~= 0 then
      md5_update(&ctx, (@*[0]uint8)(&md), 16)
    else
      md5_update(&ctx, k, klen)
    end
    md5_sum(&ctx, &md)
  end

  -- output is $1$salt$hash
  copy_bytes((@*[0]uint8)(output), (@*[0]uint8)(setting), 3 + slen)
  local p: usize = 3 + slen
  output[p] = CH_DOLLAR
  p = p + 1
  for n: usize = 0, 4 do
    p = to64(output, p, ((@uint32)(md[md5_perm[3*n]]) << 16) |
      ((@uint32)(md[md5_perm[3*n+1]]) << 8) | (@uint32)(md[md5_perm[3*n+2]]), 4)
  end
  p = to64(output, p, md[11], 2)
  output[p] = CH_NUL
  return output
end

local function crypt_md5(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar): *[0]cchar
  local testkey: cstring = "Xy01@#\x01\x02\x80\x7f\xff\r\n\x81\t !"
  local testsetting: cstring = "$1$abcd0123$"
  local testhash: cstring = "$1$abcd0123$9Qcg8DyviekV3tDGMZynJ1"
  local testbuf: [64]cchar
  local p: *[0]cchar = md5crypt(key, setting, output)
  -- self test and stack cleanup
  local q: *[0]cchar = md5crypt((@*[0]cchar)(testkey), (@*[0]cchar)(testsetting), &testbuf)
  if p == nilptr or q ~= (@*[0]cchar)(&testbuf) or
      not bytes_equal(&testbuf, (@*[0]cchar)(testhash), 35) then
    return &fail_star
  end
  return p
end

----------------------------------------------------------------------
-- SHA-256 ($5$, crypt_sha256.c) and SHA-512 ($6$, crypt_sha512.c)
----------------------------------------------------------------------

local SHA_KEY_MAX: usize <comptime> = 256
local SHA_SALT_MAX: usize <comptime> = 16
local SHA_ROUNDS_DEFAULT: uint32 <comptime> = 5000
local SHA_ROUNDS_MIN: uint32 <comptime> = 1000
local SHA_ROUNDS_MAX: uint32 <comptime> = 9999999

local Sha256: type = @record{
  len: uint64,
  h: [8]uint32,
  buf: [64]uint8
}

local function sha256_block(s: *Sha256, buf: *[0]uint8): void
  local w: [64]uint32
  for i: usize = 0, 15 do
    w[i] = ((@uint32)(buf[4*i]) << 24) | ((@uint32)(buf[4*i+1]) << 16) |
      ((@uint32)(buf[4*i+2]) << 8) | (@uint32)(buf[4*i+3])
  end
  for i: usize = 16, 63 do
    local x: uint32 = w[i-2]
    local y: uint32 = w[i-15]
    local r1: uint32 = ror32(x, 17) ~ ror32(x, 19) ~ (x >> 10)
    local r0: uint32 = ror32(y, 7) ~ ror32(y, 18) ~ (y >> 3)
    w[i] = r1 + w[i-7] + r0 + w[i-16]
  end
  local a: uint32, b: uint32, c: uint32, d: uint32 = s.h[0], s.h[1], s.h[2], s.h[3]
  local e: uint32, f: uint32, g: uint32, h: uint32 = s.h[4], s.h[5], s.h[6], s.h[7]
  for i: usize = 0, 63 do
    local s1: uint32 = ror32(e, 6) ~ ror32(e, 11) ~ ror32(e, 25)
    local ch: uint32 = g ~ (e & (f ~ g))
    local t1: uint32 = h + s1 + ch + sha256_k[i] + w[i]
    local s0: uint32 = ror32(a, 2) ~ ror32(a, 13) ~ ror32(a, 22)
    local maj: uint32 = (a & b) | (c & (a | b))
    local t2: uint32 = s0 + maj
    h = g
    g = f
    f = e
    e = d + t1
    d = c
    c = b
    b = a
    a = t1 + t2
  end
  s.h[0] = s.h[0] + a
  s.h[1] = s.h[1] + b
  s.h[2] = s.h[2] + c
  s.h[3] = s.h[3] + d
  s.h[4] = s.h[4] + e
  s.h[5] = s.h[5] + f
  s.h[6] = s.h[6] + g
  s.h[7] = s.h[7] + h
end

local function sha256_init(s: *Sha256): void
  s.len = 0
  s.h[0] = 0x6a09e667_u32
  s.h[1] = 0xbb67ae85_u32
  s.h[2] = 0x3c6ef372_u32
  s.h[3] = 0xa54ff53a_u32
  s.h[4] = 0x510e527f_u32
  s.h[5] = 0x9b05688c_u32
  s.h[6] = 0x1f83d9ab_u32
  s.h[7] = 0x5be0cd19_u32
end

local function sha256_update(s: *Sha256, m: *[0]uint8, len: usize): void
  local p: usize = 0
  local r: usize = (@usize)(s.len & 63)
  s.len = s.len + len
  if r ~= 0 then
    if len < 64 - r then
      copy_bytes((@*[0]uint8)(&s.buf[r]), m, len)
      return
    end
    copy_bytes((@*[0]uint8)(&s.buf[r]), m, 64 - r)
    len = len - (64 - r)
    p = 64 - r
    sha256_block(s, (@*[0]uint8)(&s.buf))
  end
  while len >= 64 do
    sha256_block(s, (@*[0]uint8)(&m[p]))
    len = len - 64
    p = p + 64
  end
  copy_bytes((@*[0]uint8)(&s.buf), (@*[0]uint8)(&m[p]), len)
end

local function sha256_sum(s: *Sha256, md: *[32]uint8): void
  local r: usize = (@usize)(s.len & 63)
  s.buf[r] = 0x80
  r = r + 1
  if r > 56 then
    while r < 64 do s.buf[r] = 0; r = r + 1 end
    r = 0
    sha256_block(s, (@*[0]uint8)(&s.buf))
  end
  while r < 56 do s.buf[r] = 0; r = r + 1 end
  s.len = s.len * 8
  for k: uint32 = 0, 7 do s.buf[63 - k] = (@uint8)(s.len >> (8 * k)) end
  sha256_block(s, (@*[0]uint8)(&s.buf))
  for k: usize = 0, 7 do
    md[4*k] = (@uint8)(s.h[k] >> 24)
    md[4*k+1] = (@uint8)(s.h[k] >> 16)
    md[4*k+2] = (@uint8)(s.h[k] >> 8)
    md[4*k+3] = (@uint8)(s.h[k])
  end
end

-- hash n bytes of the repeated md message digest
local function sha256_hashmd(s: *Sha256, n: usize, md: *[32]uint8): void
  local i: usize = n
  while i > 32 do
    sha256_update(s, (@*[0]uint8)(md), 32)
    i = i - 32
  end
  sha256_update(s, (@*[0]uint8)(md), i)
end

local Sha512: type = @record{
  len: uint64,
  h: [8]uint64,
  buf: [128]uint8
}

local function sha512_block(s: *Sha512, buf: *[0]uint8): void
  local w: [80]uint64
  for i: usize = 0, 15 do
    local v: uint64 = 0
    for k: usize = 0, 7 do v = (v << 8) | (@uint64)(buf[8*i+k]) end
    w[i] = v
  end
  for i: usize = 16, 79 do
    local x: uint64 = w[i-2]
    local y: uint64 = w[i-15]
    local r1: uint64 = ror64(x, 19) ~ ror64(x, 61) ~ (x >> 6)
    local r0: uint64 = ror64(y, 1) ~ ror64(y, 8) ~ (y >> 7)
    w[i] = r1 + w[i-7] + r0 + w[i-16]
  end
  local a: uint64, b: uint64, c: uint64, d: uint64 = s.h[0], s.h[1], s.h[2], s.h[3]
  local e: uint64, f: uint64, g: uint64, h: uint64 = s.h[4], s.h[5], s.h[6], s.h[7]
  for i: usize = 0, 79 do
    local s1: uint64 = ror64(e, 14) ~ ror64(e, 18) ~ ror64(e, 41)
    local ch: uint64 = g ~ (e & (f ~ g))
    local t1: uint64 = h + s1 + ch + sha512_k[i] + w[i]
    local s0: uint64 = ror64(a, 28) ~ ror64(a, 34) ~ ror64(a, 39)
    local maj: uint64 = (a & b) | (c & (a | b))
    local t2: uint64 = s0 + maj
    h = g
    g = f
    f = e
    e = d + t1
    d = c
    c = b
    b = a
    a = t1 + t2
  end
  s.h[0] = s.h[0] + a
  s.h[1] = s.h[1] + b
  s.h[2] = s.h[2] + c
  s.h[3] = s.h[3] + d
  s.h[4] = s.h[4] + e
  s.h[5] = s.h[5] + f
  s.h[6] = s.h[6] + g
  s.h[7] = s.h[7] + h
end

local function sha512_init(s: *Sha512): void
  s.len = 0
  s.h[0] = 0x6a09e667f3bcc908_u64
  s.h[1] = 0xbb67ae8584caa73b_u64
  s.h[2] = 0x3c6ef372fe94f82b_u64
  s.h[3] = 0xa54ff53a5f1d36f1_u64
  s.h[4] = 0x510e527fade682d1_u64
  s.h[5] = 0x9b05688c2b3e6c1f_u64
  s.h[6] = 0x1f83d9abfb41bd6b_u64
  s.h[7] = 0x5be0cd19137e2179_u64
end

local function sha512_update(s: *Sha512, m: *[0]uint8, len: usize): void
  local p: usize = 0
  local r: usize = (@usize)(s.len & 127)
  s.len = s.len + len
  if r ~= 0 then
    if len < 128 - r then
      copy_bytes((@*[0]uint8)(&s.buf[r]), m, len)
      return
    end
    copy_bytes((@*[0]uint8)(&s.buf[r]), m, 128 - r)
    len = len - (128 - r)
    p = 128 - r
    sha512_block(s, (@*[0]uint8)(&s.buf))
  end
  while len >= 128 do
    sha512_block(s, (@*[0]uint8)(&m[p]))
    len = len - 128
    p = p + 128
  end
  copy_bytes((@*[0]uint8)(&s.buf), (@*[0]uint8)(&m[p]), len)
end

local function sha512_sum(s: *Sha512, md: *[64]uint8): void
  local r: usize = (@usize)(s.len & 127)
  s.buf[r] = 0x80
  r = r + 1
  if r > 112 then
    while r < 128 do s.buf[r] = 0; r = r + 1 end
    r = 0
    sha512_block(s, (@*[0]uint8)(&s.buf))
  end
  while r < 120 do s.buf[r] = 0; r = r + 1 end
  s.len = s.len * 8
  for k: uint32 = 0, 7 do s.buf[127 - k] = (@uint8)(s.len >> (8 * k)) end
  sha512_block(s, (@*[0]uint8)(&s.buf))
  for k: usize = 0, 7 do
    for j: uint32 = 0, 7 do md[8*k + j] = (@uint8)(s.h[k] >> (56 - 8 * j)) end
  end
end

local function sha512_hashmd(s: *Sha512, n: usize, md: *[64]uint8): void
  local i: usize = n
  while i > 64 do
    sha512_update(s, (@*[0]uint8)(md), 64)
    i = i - 64
  end
  sha512_update(s, (@*[0]uint8)(md), i)
end

local function is_digit(c: cchar): boolean <inline>
  return c >= CH_ZERO and c <= CH_NINE
end

-- The setting after "$5$" or "$6$": the rounds (with the "rounds=N$" text
-- for the output, empty without one) and where the salt starts. musl reads
-- the count with strtoul after checking for a leading digit: any count that
-- does not fit (ULONG_MAX) is above ROUNDS_MAX and fails, as here.
local ShaSetting: type = @record{
  rounds: uint32,
  text: [20]cchar,
  text_len: usize,
  salt: usize,
  salt_len: usize
}

local function sha_parse_setting(setting: *[0]cchar, st: *ShaSetting): boolean
  local rounds_prefix: cstring = "rounds="
  local rp: *[0]cchar = (@*[0]cchar)(rounds_prefix)
  local pos: usize = 3
  st.rounds = SHA_ROUNDS_DEFAULT
  st.text_len = 0
  local i: usize = 0
  while i < 7 and setting[pos + i] == rp[i] do i = i + 1 end
  if i == 7 then
    pos = pos + 7
    if not is_digit(setting[pos]) then return false end
    local u: uint32 = 0
    local too_big: boolean = false
    while is_digit(setting[pos]) do
      if not too_big then
        u = u * 10 + (@uint32)(setting[pos] - CH_ZERO)
        if u > SHA_ROUNDS_MAX then too_big = true end
      end
      pos = pos + 1
    end
    if setting[pos] ~= CH_DOLLAR then return false end
    pos = pos + 1
    if too_big then return false end
    if u < SHA_ROUNDS_MIN then
      st.rounds = SHA_ROUNDS_MIN
    else
      st.rounds = u
    end
    -- needed when rounds is zero prefixed or out of bounds
    for k: usize = 0, 6 do st.text[k] = rp[k] end
    local digits: [10]cchar
    local nd: usize = 0
    local v: uint32 = st.rounds
    repeat
      digits[nd] = (@cchar)(v % 10) + CH_ZERO
      v = v // 10
      nd = nd + 1
    until v == 0
    st.text_len = 7
    while nd > 0 do
      nd = nd - 1
      st.text[st.text_len] = digits[nd]
      st.text_len = st.text_len + 1
    end
    st.text[st.text_len] = CH_DOLLAR
    st.text_len = st.text_len + 1
  end
  st.salt = pos
  i = 0
  while i < SHA_SALT_MAX and setting[pos + i] ~= CH_NUL and setting[pos + i] ~= CH_DOLLAR do
    -- reject characters that interfere with /etc/shadow parsing
    if setting[pos + i] == CH_NL or setting[pos + i] == CH_COLON then return false end
    i = i + 1
  end
  st.salt_len = i
  return true
end

-- "$5$" or "$6$" and the setting text, the salt and "$".
local function sha_output_prefix(output: *[0]cchar, id: cchar, setting: *[0]cchar, st: *ShaSetting): usize
  output[0] = CH_DOLLAR
  output[1] = id
  output[2] = CH_DOLLAR
  local p: usize = 3
  copy_bytes((@*[0]uint8)(&output[p]), (@*[0]uint8)(&st.text), st.text_len)
  p = p + st.text_len
  copy_bytes((@*[0]uint8)(&output[p]), (@*[0]uint8)(&setting[st.salt]), st.salt_len)
  p = p + st.salt_len
  output[p] = CH_DOLLAR
  return p + 1
end

local function sha256crypt(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar): *[0]cchar
  -- reject large keys
  local klen: usize = bounded_length(key, SHA_KEY_MAX + 1)
  if klen > SHA_KEY_MAX then return nilptr end

  -- setting: $5$rounds=n$salt$ (rounds=n$ and closing $ are optional)
  if setting[0] ~= CH_DOLLAR or setting[1] ~= CH_FIVE or setting[2] ~= CH_DOLLAR then
    return nilptr
  end
  local st: ShaSetting
  if not sha_parse_setting(setting, &st) then return nilptr end
  local k: *[0]uint8 = (@*[0]uint8)(key)
  local salt: *[0]uint8 = (@*[0]uint8)(&setting[st.salt])
  local slen: usize = st.salt_len
  local ctx: Sha256
  local md: [32]uint8
  local kmd: [32]uint8
  local smd: [32]uint8

  -- B = sha(key salt key)
  sha256_init(&ctx)
  sha256_update(&ctx, k, klen)
  sha256_update(&ctx, salt, slen)
  sha256_update(&ctx, k, klen)
  sha256_sum(&ctx, &md)

  -- A = sha(key salt repeat-B alternate-B-key)
  sha256_init(&ctx)
  sha256_update(&ctx, k, klen)
  sha256_update(&ctx, salt, slen)
  sha256_hashmd(&ctx, klen, &md)
  local i: usize = klen
  while i > 0 do
    if (i & 1) ~= 0 then
      sha256_update(&ctx, (@*[0]uint8)(&md), 32)
    else
      sha256_update(&ctx, k, klen)
    end
    i = i >> 1
  end
  sha256_sum(&ctx, &md)

  -- DP = sha(repeat-key), this step takes O(klen^2) time
  sha256_init(&ctx)
  for n: usize = 1, klen do sha256_update(&ctx, k, klen) end
  sha256_sum(&ctx, &kmd)

  -- DS = sha(repeat-salt)
  sha256_init(&ctx)
  for n: usize = 1, 16 + (@usize)(md[0]) do sha256_update(&ctx, salt, slen) end
  sha256_sum(&ctx, &smd)

  -- iterate A = f(A,DP,DS), this step takes O(rounds*klen) time
  for n: uint32 = 0, st.rounds - 1 do
    sha256_init(&ctx)
    if n % 2 ~= 0 then
      sha256_hashmd(&ctx, klen, &kmd)
    else
      sha256_update(&ctx, (@*[0]uint8)(&md), 32)
    end
    if n % 3 ~= 0 then sha256_update(&ctx, (@*[0]uint8)(&smd), slen) end
    if n % 7 ~= 0 then sha256_hashmd(&ctx, klen, &kmd) end
    if n % 2 ~= 0 then
      sha256_update(&ctx, (@*[0]uint8)(&md), 32)
    else
      sha256_hashmd(&ctx, klen, &kmd)
    end
    sha256_sum(&ctx, &md)
  end

  -- output is $5$rounds=n$salt$hash
  local p: usize = sha_output_prefix(output, CH_FIVE, setting, &st)
  for n: usize = 0, 9 do
    p = to64(output, p, ((@uint32)(md[sha256_perm[3*n]]) << 16) |
      ((@uint32)(md[sha256_perm[3*n+1]]) << 8) | (@uint32)(md[sha256_perm[3*n+2]]), 4)
  end
  p = to64(output, p, ((@uint32)(md[31]) << 8) | (@uint32)(md[30]), 3)
  output[p] = CH_NUL
  return output
end

local function sha512crypt(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar): *[0]cchar
  -- reject large keys
  local klen: usize = bounded_length(key, SHA_KEY_MAX + 1)
  if klen > SHA_KEY_MAX then return nilptr end

  -- setting: $6$rounds=n$salt$ (rounds=n$ and closing $ are optional)
  if setting[0] ~= CH_DOLLAR or setting[1] ~= CH_SIX or setting[2] ~= CH_DOLLAR then
    return nilptr
  end
  local st: ShaSetting
  if not sha_parse_setting(setting, &st) then return nilptr end
  local k: *[0]uint8 = (@*[0]uint8)(key)
  local salt: *[0]uint8 = (@*[0]uint8)(&setting[st.salt])
  local slen: usize = st.salt_len
  local ctx: Sha512
  local md: [64]uint8
  local kmd: [64]uint8
  local smd: [64]uint8

  -- B = sha(key salt key)
  sha512_init(&ctx)
  sha512_update(&ctx, k, klen)
  sha512_update(&ctx, salt, slen)
  sha512_update(&ctx, k, klen)
  sha512_sum(&ctx, &md)

  -- A = sha(key salt repeat-B alternate-B-key)
  sha512_init(&ctx)
  sha512_update(&ctx, k, klen)
  sha512_update(&ctx, salt, slen)
  sha512_hashmd(&ctx, klen, &md)
  local i: usize = klen
  while i > 0 do
    if (i & 1) ~= 0 then
      sha512_update(&ctx, (@*[0]uint8)(&md), 64)
    else
      sha512_update(&ctx, k, klen)
    end
    i = i >> 1
  end
  sha512_sum(&ctx, &md)

  -- DP = sha(repeat-key), this step takes O(klen^2) time
  sha512_init(&ctx)
  for n: usize = 1, klen do sha512_update(&ctx, k, klen) end
  sha512_sum(&ctx, &kmd)

  -- DS = sha(repeat-salt)
  sha512_init(&ctx)
  for n: usize = 1, 16 + (@usize)(md[0]) do sha512_update(&ctx, salt, slen) end
  sha512_sum(&ctx, &smd)

  -- iterate A = f(A,DP,DS), this step takes O(rounds*klen) time
  for n: uint32 = 0, st.rounds - 1 do
    sha512_init(&ctx)
    if n % 2 ~= 0 then
      sha512_hashmd(&ctx, klen, &kmd)
    else
      sha512_update(&ctx, (@*[0]uint8)(&md), 64)
    end
    if n % 3 ~= 0 then sha512_update(&ctx, (@*[0]uint8)(&smd), slen) end
    if n % 7 ~= 0 then sha512_hashmd(&ctx, klen, &kmd) end
    if n % 2 ~= 0 then
      sha512_update(&ctx, (@*[0]uint8)(&md), 64)
    else
      sha512_hashmd(&ctx, klen, &kmd)
    end
    sha512_sum(&ctx, &md)
  end

  -- output is $6$rounds=n$salt$hash
  local p: usize = sha_output_prefix(output, CH_SIX, setting, &st)
  for n: usize = 0, 20 do
    p = to64(output, p, ((@uint32)(md[sha512_perm[3*n]]) << 16) |
      ((@uint32)(md[sha512_perm[3*n+1]]) << 8) | (@uint32)(md[sha512_perm[3*n+2]]), 4)
  end
  p = to64(output, p, md[63], 2)
  output[p] = CH_NUL
  return output
end

local function crypt_sha256(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar): *[0]cchar
  local testkey: cstring = "Xy01@#\x01\x02\x80\x7f\xff\r\n\x81\t !"
  local testsetting: cstring = "$5$rounds=1234$abc0123456789$"
  local testhash: cstring = "$5$rounds=1234$abc0123456789$3VfDjPt05VHFn47C/ojFZ6KRPYrOjj1lLbH.dkF3bZ6"
  local testbuf: [128]cchar
  local p: *[0]cchar = sha256crypt(key, setting, output)
  -- self test and stack cleanup
  local q: *[0]cchar = sha256crypt((@*[0]cchar)(testkey), (@*[0]cchar)(testsetting), &testbuf)
  if p == nilptr or q ~= (@*[0]cchar)(&testbuf) or
      not bytes_equal(&testbuf, (@*[0]cchar)(testhash), 73) then
    return &fail_star
  end
  return p
end

local function crypt_sha512(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar): *[0]cchar
  local testkey: cstring = "Xy01@#\x01\x02\x80\x7f\xff\r\n\x81\t !"
  local testsetting: cstring = "$6$rounds=1234$abc0123456789$"
  local testhash: cstring = "$6$rounds=1234$abc0123456789$BCpt8zLrc/RcyuXmCDOE1ALqMXB2MH6n1g891HhFj8.w7LxGv.FTkqq6Vxc/km3Y0jE0j24jY5PIv/oOu6reg1"
  local testbuf: [128]cchar
  local p: *[0]cchar = sha512crypt(key, setting, output)
  -- self test and stack cleanup
  local q: *[0]cchar = sha512crypt((@*[0]cchar)(testkey), (@*[0]cchar)(testsetting), &testbuf)
  if p == nilptr or q ~= (@*[0]cchar)(&testbuf) or
      not bytes_equal(&testbuf, (@*[0]cchar)(testhash), 116) then
    return &fail_star
  end
  return p
end

----------------------------------------------------------------------
-- DES and BSDi extended DES (crypt_des.c, encrypt.c)
----------------------------------------------------------------------

local DesKey: type = @record{
  l: [16]uint32,
  r: [16]uint32
}

local function be32(b: *[0]uint8, i: usize): uint32 <inline>
  return ((@uint32)(b[i]) << 24) | ((@uint32)(b[i+1]) << 16) |
    ((@uint32)(b[i+2]) << 8) | (@uint32)(b[i+3])
end

-- We match the behavior of UFC-crypt on systems where "char" is signed by
-- default (the majority), regardless of char's signedness on our system.
local function ascii_to_bin(ch: uint8): uint32
  local sch: int32 = (@int32)(ch)
  if sch >= 0x80 then sch = sch - 0x100 end
  local retval: int32 = sch - 46
  if sch >= 65 then
    retval = sch - 53
    if sch >= 97 then retval = sch - 59 end
  end
  return (@uint32)(retval & 0x3f)
end

-- When we choose to "support" invalid salts, nevertheless disallow those
-- containing characters that would violate the passwd file format.
local function ascii_is_unsafe(ch: uint8): boolean <inline>
  return ch == 0 or ch == 10 or ch == 58
end

local function setup_salt(salt: uint32): uint32
  local saltbits: uint32 = 0
  local saltbit: uint32 = 1
  local obit: uint32 = 0x800000
  for i = 0, 23 do
    if (salt & saltbit) ~= 0 then saltbits = saltbits | obit end
    saltbit = saltbit << 1
    obit = obit >> 1
  end
  return saltbits
end

local function des_setkey(key: *[0]uint8, ekey: *DesKey): void
  local rawkey0: uint32 = be32(key, 0)
  local rawkey1: uint32 = be32(key, 4)

  -- Do key permutation and split into two 28-bit subkeys.
  local k0: uint32, k1: uint32 = 0, 0
  local ibit: uint32 = 28
  for i: uint32 = 0, 3 do
    local j: uint32 = i << 1
    k0 = k0 | des_key_perm_maskl[i][(rawkey0 >> ibit) & 0xf] |
      des_key_perm_maskl[i + 4][(rawkey1 >> ibit) & 0xf]
    k1 = k1 | des_key_perm_maskr[j][(rawkey0 >> ibit) & 0xf]
    ibit = ibit - 4
    k1 = k1 | des_key_perm_maskr[j + 1][(rawkey0 >> ibit) & 0xf] |
      des_key_perm_maskr[i + 8][(rawkey1 >> ibit) & 0xf]
    if i < 3 then ibit = ibit - 4 end
  end

  -- Rotate subkeys and do compression permutation.
  local shifts: uint32 = 0
  for round: usize = 0, 15 do
    shifts = shifts + des_key_shifts[round]
    local t0: uint32 = (k0 << shifts) | (k0 >> (28 - shifts))
    local t1: uint32 = (k1 << shifts) | (k1 >> (28 - shifts))
    local kl: uint32, kr: uint32 = 0, 0
    local cbit: uint32 = 25
    for i: usize = 0, 3 do
      kl = kl | des_comp_maskl0[i][(t0 >> cbit) & 7]
      kr = kr | des_comp_maskr0[i][(t1 >> cbit) & 7]
      cbit = cbit - 4
      kl = kl | des_comp_maskl1[i][(t0 >> cbit) & 0xf]
      kr = kr | des_comp_maskr1[i][(t1 >> cbit) & 0xf]
      if i < 3 then cbit = cbit - 3 end
    end
    ekey.l[round] = kl
    ekey.r[round] = kr
  end
end

-- l_in, r_in and the results are in pseudo-"big-endian" format.
local function do_des(l_in: uint32, r_in: uint32, count: uint32, saltbits: uint32,
    ekey: *DesKey): (uint32, uint32)
  local l: uint32, r: uint32 = 0, 0

  -- Do initial permutation (IP).
  if (l_in | r_in) ~= 0 then
    local ibit: uint32 = 28
    for i: usize = 0, 7 do
      l = l | des_ip_maskl[i][(l_in >> ibit) & 0xf] | des_ip_maskl[i + 8][(r_in >> ibit) & 0xf]
      r = r | des_ip_maskr[i][(l_in >> ibit) & 0xf] | des_ip_maskr[i + 8][(r_in >> ibit) & 0xf]
      if i < 7 then ibit = ibit - 4 end
    end
  end

  local f: uint32 = 0
  while count > 0 do
    count = count - 1
    -- Do each round.
    for round: usize = 0, 15 do
      -- Expand R to 48 bits (simulate the E-box).
      local r48l: uint32 = ((r & 0x00000001_u32) << 23)
        | ((r & 0xf8000000_u32) >> 9)
        | ((r & 0x1f800000_u32) >> 11)
        | ((r & 0x01f80000_u32) >> 13)
        | ((r & 0x001f8000_u32) >> 15)
      local r48r: uint32 = ((r & 0x0001f800_u32) << 7)
        | ((r & 0x00001f80_u32) << 5)
        | ((r & 0x000001f8_u32) << 3)
        | ((r & 0x0000001f_u32) << 1)
        | ((r & 0x80000000_u32) >> 31)
      -- Do salting for crypt() and friends, and XOR with the permuted key.
      f = (r48l ~ r48r) & saltbits
      r48l = r48l ~ f ~ ekey.l[round]
      r48r = r48r ~ f ~ ekey.r[round]
      -- Do S-box lookups (which shrink it back to 32 bits) and do the P-box
      -- permutation at the same time.
      f = des_psbox[0][r48l >> 18]
        | des_psbox[1][(r48l >> 12) & 0x3f]
        | des_psbox[2][(r48l >> 6) & 0x3f]
        | des_psbox[3][r48l & 0x3f]
        | des_psbox[4][r48r >> 18]
        | des_psbox[5][(r48r >> 12) & 0x3f]
        | des_psbox[6][(r48r >> 6) & 0x3f]
        | des_psbox[7][r48r & 0x3f]
      -- Now that we've permuted things, complete f().
      f = f ~ l
      l = r
      r = f
    end
    r = l
    l = f
  end

  -- Do final permutation (inverse of IP).
  local lo: uint32, ro: uint32 = 0, 0
  local ibit: uint32 = 28
  for i: usize = 0, 3 do
    ro = ro | des_fp_maskr[i][(l >> ibit) & 0xf] | des_fp_maskr[i + 4][(r >> ibit) & 0xf]
    ibit = ibit - 4
    lo = lo | des_fp_maskl[i][(l >> ibit) & 0xf] | des_fp_maskl[i + 4][(r >> ibit) & 0xf]
    if i < 3 then ibit = ibit - 4 end
  end
  return lo, ro
end

local function des_cipher(input: *[0]uint8, out: *[0]uint8, count: uint32, saltbits: uint32,
    ekey: *DesKey): void
  local l_out: uint32, r_out: uint32 = do_des(be32(input, 0), be32(input, 4), count, saltbits, ekey)
  out[0] = (@uint8)(l_out >> 24)
  out[1] = (@uint8)(l_out >> 16)
  out[2] = (@uint8)(l_out >> 8)
  out[3] = (@uint8)(l_out)
  out[4] = (@uint8)(r_out >> 24)
  out[5] = (@uint8)(r_out >> 16)
  out[6] = (@uint8)(r_out >> 8)
  out[7] = (@uint8)(r_out)
end

local function crypt_extended_r_uut(key_in: *[0]cchar, setting_in: *[0]cchar,
    output: *[0]cchar): *[0]cchar
  local key: *[0]uint8 = (@*[0]uint8)(key_in)
  local setting: *[0]uint8 = (@*[0]uint8)(setting_in)
  local ekey: DesKey
  local keybuf: [8]uint8
  local count: uint32
  local salt: uint32
  local p: usize

  -- Copy the key, shifting each character left by one bit and padding with
  -- zeroes.
  local kp: usize = 0
  for q: usize = 0, 7 do
    keybuf[q] = key[kp] << 1
    if key[kp] ~= 0 then kp = kp + 1 end
  end
  des_setkey(&keybuf, &ekey)

  if setting[0] == (@uint8)(CH_UNDERSCORE) then
    -- "new"-style:
    --   setting - underscore, 4 chars of count, 4 chars of salt
    --   key - unlimited characters
    count = 0
    for i: usize = 1, 4 do
      local value: uint32 = ascii_to_bin(setting[i])
      if crypt_ascii64[value] ~= setting[i] then return nilptr end
      count = count | (value << ((i - 1) * 6))
    end
    if count == 0 then return nilptr end

    salt = 0
    for i: usize = 5, 8 do
      local value: uint32 = ascii_to_bin(setting[i])
      if crypt_ascii64[value] ~= setting[i] then return nilptr end
      salt = salt | (value << ((i - 5) * 6))
    end

    while key[kp] ~= 0 do
      -- Encrypt the key with itself.
      des_cipher(&keybuf, &keybuf, 1, 0, &ekey)
      -- And XOR with the next 8 characters of the key.
      local q: usize = 0
      while q < 8 and key[kp] ~= 0 do
        keybuf[q] = keybuf[q] ~ (key[kp] << 1)
        q = q + 1
        kp = kp + 1
      end
      des_setkey(&keybuf, &ekey)
    end

    for i: usize = 0, 8 do output[i] = setting_in[i] end
    output[9] = CH_NUL
    p = 9
  else
    -- "old"-style:
    --   setting - 2 chars of salt
    --   key - up to 8 characters
    count = 25

    if ascii_is_unsafe(setting[0]) or ascii_is_unsafe(setting[1]) then return nilptr end

    salt = (ascii_to_bin(setting[1]) << 6) | ascii_to_bin(setting[0])

    output[0] = setting_in[0]
    output[1] = setting_in[1]
    p = 2
  end

  -- Do it.
  local r0: uint32, r1: uint32 = do_des(0, 0, count, setup_salt(salt), &ekey)

  -- Now encode the result...
  local l: uint32 = r0 >> 8
  output[p] = (@cchar)(crypt_ascii64[(l >> 18) & 0x3f])
  output[p+1] = (@cchar)(crypt_ascii64[(l >> 12) & 0x3f])
  output[p+2] = (@cchar)(crypt_ascii64[(l >> 6) & 0x3f])
  output[p+3] = (@cchar)(crypt_ascii64[l & 0x3f])

  l = (r0 << 16) | ((r1 >> 16) & 0xffff)
  output[p+4] = (@cchar)(crypt_ascii64[(l >> 18) & 0x3f])
  output[p+5] = (@cchar)(crypt_ascii64[(l >> 12) & 0x3f])
  output[p+6] = (@cchar)(crypt_ascii64[(l >> 6) & 0x3f])
  output[p+7] = (@cchar)(crypt_ascii64[l & 0x3f])

  l = r1 << 2
  output[p+8] = (@cchar)(crypt_ascii64[(l >> 12) & 0x3f])
  output[p+9] = (@cchar)(crypt_ascii64[(l >> 6) & 0x3f])
  output[p+10] = (@cchar)(crypt_ascii64[l & 0x3f])
  output[p+11] = CH_NUL

  return output
end

local function crypt_des(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar): *[0]cchar
  local test_key: cstring = "\x80\xff\x80\x01 \x7f\x81\x80\x80\x0d\x0a\xff\x7f \x81 test"
  local test_setting: cstring = "_0.../9Zz"
  local test_hash: cstring = "_0.../9ZzX7iSJNd21sU"
  local test_len: usize = 21
  local test_buf: [21]cchar

  if setting[0] ~= CH_UNDERSCORE then
    test_setting = "\x80x"
    test_hash = "\x80x22/wK52ZKGA"
    test_len = 14
  end

  -- Hash the supplied password.
  local retval: *[0]cchar = crypt_extended_r_uut(key, setting, output)

  -- Perform a quick self-test. Both calls are made from the same scope so
  -- that the second one likely overwrites the first one's stack.
  local p: *[0]cchar = crypt_extended_r_uut((@*[0]cchar)(test_key), (@*[0]cchar)(test_setting), &test_buf)
  if p ~= nilptr and bytes_equal(p, (@*[0]cchar)(test_hash), test_len) and retval ~= nilptr then
    return retval
  end

  if setting[0] == CH_STAR then return &fail_x end
  return &fail_star
end

local encrypt_key: DesKey

local function setkey(key: *[0]cchar): void <cexport, codename 'setkey'>
  local bkey: [8]uint8
  local k: usize = 0
  for i: usize = 0, 7 do
    local b: uint32 = 0
    local j: uint32 = 8
    while j > 0 do
      j = j - 1
      b = b | (((@uint32)((@uint8)(key[k])) & 1) << j)
      k = k + 1
    end
    bkey[i] = (@uint8)(b)
  end
  des_setkey(&bkey, &encrypt_key)
end

local function encrypt(block: *[0]cchar, edflag: cint): void <cexport, codename 'encrypt'>
  local decrypt_key: DesKey
  local b: [2]uint32
  local p: usize = 0
  for i: usize = 0, 1 do
    b[i] = 0
    local j: uint32 = 32
    while j > 0 do
      j = j - 1
      b[i] = b[i] | (((@uint32)((@uint8)(block[p])) & 1) << j)
      p = p + 1
    end
  end

  local key: *DesKey = &encrypt_key
  if edflag ~= 0 then
    key = &decrypt_key
    for i: usize = 0, 15 do
      decrypt_key.l[i] = encrypt_key.l[15 - i]
      decrypt_key.r[i] = encrypt_key.r[15 - i]
    end
  end

  b[0], b[1] = do_des(b[0], b[1], 1, 0, key)

  p = 0
  for i: usize = 0, 1 do
    local j: uint32 = 32
    while j > 0 do
      j = j - 1
      block[p] = (@cchar)((b[i] >> j) & 1)
      p = p + 1
    end
  end
end

----------------------------------------------------------------------
-- bcrypt ($2a$, $2b$, $2x$, $2y$; crypt_blowfish.c)
----------------------------------------------------------------------

-- Number of Blowfish rounds, this is also hardcoded into a few places.
local BF_N: usize <comptime> = 16
-- BF_ctx.PS: the P-box (18 words) and the four S-boxes (256 words each).
local BF_PS_WORDS: usize <comptime> = 18 + 4 * 256
local BF_S0: usize <comptime> = 18
local BF_S1: usize <comptime> = 18 + 256
local BF_S2: usize <comptime> = 18 + 512
local BF_S3: usize <comptime> = 18 + 768

local BfCtx: type = @[1042]uint32
local BfKey: type = @[18]uint32

local function bf_atoi(c: uint8): (boolean, uint32) <inline>
  local tmp: uint32 = (@uint32)(c) - 0x20
  if tmp >= 0x60 then return false, 0 end
  tmp = bf_atoi64[tmp]
  if tmp > 63 then return false, 0 end
  return true, tmp
end

local function bf_decode(dst: *[16]uint8, src: *[0]uint8): boolean
  local dp: usize = 0
  local sp: usize = 0
  local ok: boolean
  local c1: uint32, c2: uint32, c3: uint32, c4: uint32
  repeat
    ok, c1 = bf_atoi(src[sp]); sp = sp + 1
    if not ok then return false end
    ok, c2 = bf_atoi(src[sp]); sp = sp + 1
    if not ok then return false end
    dst[dp] = (@uint8)((c1 << 2) | ((c2 & 0x30) >> 4)); dp = dp + 1
    if dp >= 16 then break end

    ok, c3 = bf_atoi(src[sp]); sp = sp + 1
    if not ok then return false end
    dst[dp] = (@uint8)(((c2 & 0x0f) << 4) | ((c3 & 0x3c) >> 2)); dp = dp + 1
    if dp >= 16 then break end

    ok, c4 = bf_atoi(src[sp]); sp = sp + 1
    if not ok then return false end
    dst[dp] = (@uint8)(((c3 & 0x03) << 6) | c4); dp = dp + 1
  until dp >= 16
  return true
end

local function bf_encode(dst: *[0]cchar, src: *[0]uint8, size: usize): void
  local sp: usize = 0
  local dp: usize = 0
  local c1: uint32, c2: uint32
  repeat
    c1 = src[sp]; sp = sp + 1
    dst[dp] = (@cchar)(bf_itoa64[c1 >> 2]); dp = dp + 1
    c1 = (c1 & 0x03) << 4
    if sp >= size then
      dst[dp] = (@cchar)(bf_itoa64[c1]); dp = dp + 1
      break
    end

    c2 = src[sp]; sp = sp + 1
    c1 = c1 | (c2 >> 4)
    dst[dp] = (@cchar)(bf_itoa64[c1]); dp = dp + 1
    c1 = (c2 & 0x0f) << 2
    if sp >= size then
      dst[dp] = (@cchar)(bf_itoa64[c1]); dp = dp + 1
      break
    end

    c2 = src[sp]; sp = sp + 1
    c1 = c1 | (c2 >> 6)
    dst[dp] = (@cchar)(bf_itoa64[c1]); dp = dp + 1
    dst[dp] = (@cchar)(bf_itoa64[c2 & 0x3f]); dp = dp + 1
  until sp >= size
end

-- One Blowfish encryption of L, R under ctx (BF_encrypt's loop body).
local function bf_block(ctx: *BfCtx, l: uint32, r: uint32): (uint32, uint32) <inline>
  l = l ~ ctx[0]
  for i: usize = 0, BF_N - 1, 2 do
    -- BF_ROUND(L, R, i)
    local tmp1: uint32 = ctx[BF_S3 + (l & 0xff)]
    local tmp2: uint32 = ctx[BF_S2 + ((l >> 8) & 0xff)]
    local tmp3: uint32 = ctx[BF_S1 + ((l >> 16) & 0xff)]
    tmp3 = tmp3 + ctx[BF_S0 + (l >> 24)]
    tmp3 = tmp3 ~ tmp2
    r = r ~ ctx[i + 1]
    tmp3 = tmp3 + tmp1
    r = r ~ tmp3
    -- BF_ROUND(R, L, i + 1)
    tmp1 = ctx[BF_S3 + (r & 0xff)]
    tmp2 = ctx[BF_S2 + ((r >> 8) & 0xff)]
    tmp3 = ctx[BF_S1 + ((r >> 16) & 0xff)]
    tmp3 = tmp3 + ctx[BF_S0 + (r >> 24)]
    tmp3 = tmp3 ~ tmp2
    l = l ~ ctx[i + 2]
    tmp3 = tmp3 + tmp1
    l = l ~ tmp3
  end
  local tmp4: uint32 = r
  r = l
  l = tmp4 ~ ctx[BF_N + 1]
  return l, r
end

-- BF_encrypt(ctx, 0, 0, PS, PS + BF_PS_WORDS): each block's result replaces
-- the next two words of the context, which the following blocks then use.
local function bf_encrypt_ctx(ctx: *BfCtx): void
  local l: uint32, r: uint32 = 0, 0
  local i: usize = 0
  while i < BF_PS_WORDS do
    l, r = bf_block(ctx, l, r)
    ctx[i] = l
    ctx[i + 1] = r
    i = i + 2
  end
end

local function bf_set_key(key: *[0]cchar, expanded: *BfKey, initial: *BfKey, flags: uint32): void
  local ptr: usize = 0
  local tmp: [2]uint32

  -- There was a sign extension bug in older revisions of this function.
  -- "bug" selects the sign-extended words ($2x$); bit 16 of "safety" asks
  -- for the countermeasure ($2a$): the initial key deviates from the
  -- correct one exactly when the buggy and the correct algorithm agree on a
  -- password with a non-benign sign extension. As in musl, this uses
  -- fixed-cost bit operations rather than branches or table lookups on the
  -- password (one branch on the password's length remains).
  --   $2a$: bug = 0, safety = 0x10000
  --   $2b$: bug = 0, safety = 0
  --   $2x$: bug = 1, safety = 0
  --   $2y$: bug = 0, safety = 0
  local bug: uint32 = flags & 1
  local safety: uint32 = (flags & 2) << 15

  local sign: uint32 = 0
  local diff: uint32 = 0

  for i: usize = 0, BF_N + 1 do
    tmp[0] = 0
    tmp[1] = 0
    for j: usize = 0, 3 do
      tmp[0] = tmp[0] << 8
      tmp[0] = tmp[0] | (@uint32)((@uint8)(key[ptr])) -- correct
      tmp[1] = tmp[1] << 8
      tmp[1] = tmp[1] | (@uint32)((@int32)((@int8)(key[ptr]))) -- bug
      -- Sign extension in the first char has no effect - nothing to
      -- overwrite yet, and those extra 24 bits will be fully shifted out of
      -- the 32-bit word. For chars 2, 3, 4 in each four-char block, we set
      -- bit 7 of "sign" if sign extension in tmp[1] occurs. Once this flag
      -- is set, it remains set.
      if j ~= 0 then sign = sign | (tmp[1] & 0x80) end
      if key[ptr] == CH_NUL then
        ptr = 0
      else
        ptr = ptr + 1
      end
    end
    diff = diff | (tmp[0] ~ tmp[1]) -- Non-zero on any differences

    expanded[i] = tmp[bug]
    initial[i] = bf_init_state[i] ~ tmp[bug]
  end

  -- At this point, "diff" is zero iff the correct and buggy algorithms
  -- produced exactly the same result. If so and if "sign" is non-zero,
  -- which indicates that there was a non-benign sign extension, this means
  -- that we have a collision between the correctly computed hash for this
  -- password and a set of passwords that could be supplied to the buggy
  -- algorithm. Our safety measure is meant to protect from such many-buggy
  -- to one-correct collisions, by deviating from the correct algorithm in
  -- such cases.
  diff = diff | (diff >> 16) -- still zero iff exact match
  diff = diff & 0xffff -- ditto
  diff = diff + 0xffff -- bit 16 set iff "diff" was non-zero (on non-match)
  sign = sign << 9 -- move the non-benign sign extension flag to bit 16
  sign = sign & (~diff & safety) -- action needed?

  -- If we have determined that we need to deviate from the correct
  -- algorithm, flip bit 16 in initial expanded key. It is crucial that we
  -- don't do the same to the expanded key used in the main Eksblowfish
  -- loop.
  initial[0] = initial[0] ~ sign
end

local BfData: type = @record{
  ctx: BfCtx,
  expanded_key: BfKey,
  salt: [4]uint32,
  output: [6]uint32
}

local function bf_crypt(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar, min: uint32): *[0]cchar
  local data: BfData

  if setting[0] ~= CH_DOLLAR or setting[1] ~= CH_TWO or
      (@uint32)((@int32)(setting[2]) - CH_LOWER_A) > 25 or
      bf_flags_by_subtype[(@int32)(setting[2]) - CH_LOWER_A] == 0 or
      setting[3] ~= CH_DOLLAR or
      (@uint32)((@int32)(setting[4]) - CH_ZERO) > 1 or
      (@uint32)((@int32)(setting[5]) - CH_ZERO) > 9 or
      setting[6] ~= CH_DOLLAR then
    return nilptr
  end
  local flags: uint32 = bf_flags_by_subtype[(@int32)(setting[2]) - CH_LOWER_A]

  local count: uint32 = 1_u32 << ((@uint32)(setting[4] - CH_ZERO) * 10 + (@uint32)(setting[5] - CH_ZERO))
  local salt_bytes: [16]uint8
  if count < min or not bf_decode(&salt_bytes, (@*[0]uint8)(&setting[7])) then
    return nilptr
  end
  -- BF_swap: the salt words are big-endian.
  for i: usize = 0, 3 do data.salt[i] = be32(&salt_bytes, 4 * i) end

  bf_set_key(key, &data.expanded_key, (@*BfKey)(&data.ctx[0]), flags)

  for i: usize = 18, BF_PS_WORDS - 1 do data.ctx[i] = bf_init_state[i] end

  do
    local l: uint32, r: uint32 = 0, 0
    local ptr: usize = 0
    while true do
      l, r = bf_block(&data.ctx, l ~ data.salt[0], r ~ data.salt[1])
      data.ctx[ptr] = l
      data.ctx[ptr + 1] = r
      ptr = ptr + 2

      if ptr >= BF_PS_WORDS then break end

      l, r = bf_block(&data.ctx, l ~ data.salt[2], r ~ data.salt[3])
      data.ctx[ptr] = l
      data.ctx[ptr + 1] = r
      ptr = ptr + 2
    end
  end

  repeat
    for i: usize = 0, BF_N + 1 do
      data.ctx[i] = data.ctx[i] ~ data.expanded_key[i]
    end

    bf_encrypt_ctx(&data.ctx)

    local tmp1: uint32 = data.salt[0]
    local tmp2: uint32 = data.salt[1]
    local tmp3: uint32 = data.salt[2]
    local tmp4: uint32 = data.salt[3]
    for i: usize = 0, BF_N - 1, 4 do
      data.ctx[i] = data.ctx[i] ~ tmp1
      data.ctx[i + 1] = data.ctx[i + 1] ~ tmp2
      data.ctx[i + 2] = data.ctx[i + 2] ~ tmp3
      data.ctx[i + 3] = data.ctx[i + 3] ~ tmp4
    end
    data.ctx[16] = data.ctx[16] ~ tmp1
    data.ctx[17] = data.ctx[17] ~ tmp2

    bf_encrypt_ctx(&data.ctx)

    count = count - 1
  until count == 0

  for i: usize = 0, 4, 2 do
    local l: uint32 = bf_magic_w[i]
    local r: uint32 = bf_magic_w[i + 1]
    for n = 1, 64 do
      l, r = bf_block(&data.ctx, l, r)
    end
    data.output[i] = l
    data.output[i + 1] = r
  end

  for i: usize = 0, 7 + 22 - 2 do output[i] = setting[i] end
  output[7 + 22 - 1] = (@cchar)(bf_itoa64[bf_atoi64[(@uint8)(setting[7 + 22 - 1]) - 0x20] & 0x30])

  -- This has to be bug-compatible with the original implementation, so
  -- only encode 23 of the 24 bytes. :-)
  local out_bytes: [24]uint8
  for i: usize = 0, 5 do
    local w: uint32 = data.output[i]
    out_bytes[4*i] = (@uint8)(w >> 24)
    out_bytes[4*i+1] = (@uint8)(w >> 16)
    out_bytes[4*i+2] = (@uint8)(w >> 8)
    out_bytes[4*i+3] = (@uint8)(w)
  end
  bf_encode((@*[0]cchar)(&output[7 + 22]), &out_bytes, 23)
  output[7 + 22 + 31] = CH_NUL

  return output
end

local BfTestBuffers: type = @record{
  s: [7 + 22 + 1]cchar,
  o: [7 + 22 + 31 + 1 + 1 + 1]cchar
}

-- As in musl, the runtime self-test runs after every hash: it catches a
-- miscompiled build (giving "*" rather than incompatible hashes) and
-- overwrites the stack and registers the real computation used.
local function crypt_blowfish(key: *[0]cchar, setting: *[0]cchar, output: *[0]cchar): *[0]cchar
  local test_key: cstring = "8b \xd0\xc1\xd2\xcf\xcc\xd8"
  local test_setting: cstring = "$2a$00$abcdefghijklmnopqrstuu"
  -- 'a', 'b', 'y' and 'x'; the check also wants NUL, 0x55 and NUL after
  -- the 31 characters (no write past the terminator).
  local test_hash_ab: cstring = "i1D709vfamulimlGcq0qq3UvuUasvEa"
  local test_hash_x: cstring = "VUrPmXD6q/nVSSp7pNDhCR9071IfIRe"
  local test_hash: cstring = test_hash_ab
  local buf: BfTestBuffers

  -- Hash the supplied password
  local retval: *[0]cchar = bf_crypt(key, setting, output, 16)

  -- Do a quick self-test. Both calls to bf_crypt are made from the same
  -- scope so that they likely use the same stack locations.
  local ts: *[0]cchar = (@*[0]cchar)(test_setting)
  for i: usize = 0, 29 do buf.s[i] = ts[i] end
  if retval ~= nilptr then
    local flags: uint32 = bf_flags_by_subtype[(@int32)(setting[2]) - CH_LOWER_A]
    if (flags & 1) ~= 0 then test_hash = test_hash_x end
    buf.s[2] = setting[2]
  end
  for i: usize = 0, #buf.o - 1 do buf.o[i] = 0x55 end
  buf.o[#buf.o - 1] = 0
  local p: *[0]cchar = bf_crypt((@*[0]cchar)(test_key), &buf.s, &buf.o, 1)

  local ok: boolean = p == (@*[0]cchar)(&buf.o) and
    bytes_equal(p, &buf.s, 7 + 22) and
    bytes_equal((@*[0]cchar)(&p[7 + 22]), (@*[0]cchar)(test_hash), 31) and
    p[7 + 22 + 31] == 0 and p[7 + 22 + 32] == 0x55 and p[7 + 22 + 33] == 0

  do
    local k: cstring = "\xff\xa334\xff\xff\xff\xa3345"
    local ae: BfKey, ai: BfKey, ye: BfKey, yi: BfKey
    bf_set_key((@*[0]cchar)(k), &ae, &ai, 2) -- $2a$
    bf_set_key((@*[0]cchar)(k), &ye, &yi, 4) -- $2y$
    ai[0] = ai[0] ~ 0x10000 -- undo the safety (for comparison)
    local same: boolean = true
    for i: usize = 0, 17 do
      if ae[i] ~= ye[i] or ai[i] ~= yi[i] then same = false end
    end
    ok = ok and ai[0] == 0xdb9c59bc_u32 and ye[17] == 0x33343500_u32 and same
  end

  if ok and retval ~= nilptr then return retval end

  return &fail_star
end

----------------------------------------------------------------------
-- crypt and crypt_r (crypt.c, crypt_r.c)
----------------------------------------------------------------------

local function crypt_dispatch(key: *[0]cchar, salt: *[0]cchar, output: *[0]cchar): *[0]cchar
  if salt[0] == CH_DOLLAR and salt[1] ~= CH_NUL and salt[2] ~= CH_NUL then
    if salt[1] == CH_ONE and salt[2] == CH_DOLLAR then
      return crypt_md5(key, salt, output)
    end
    if salt[1] == CH_TWO and salt[3] == CH_DOLLAR then
      return crypt_blowfish(key, salt, output)
    end
    if salt[1] == CH_FIVE and salt[2] == CH_DOLLAR then
      return crypt_sha256(key, salt, output)
    end
    if salt[1] == CH_SIX and salt[2] == CH_DOLLAR then
      return crypt_sha512(key, salt, output)
    end
  end
  return crypt_des(key, salt, output)
end

-- struct crypt_data, as musl declares it; crypt_r uses it only as the
-- buffer for the result.
local CryptData: type = @record{
  initialized: cint,
  buf: [256]cchar
}

local function crypt_r(key: *[0]cchar, salt: *[0]cchar, data: *CryptData): *[0]cchar
    <cexport, codename 'crypt_r'>
  return crypt_dispatch(key, salt, (@*[0]cchar)(data))
end

-- This buffer is sufficiently large for all currently-supported hash types.
local crypt_buffer: [128]cchar

local function crypt(key: *[0]cchar, salt: *[0]cchar): *[0]cchar <cexport, codename 'crypt'>
  return crypt_dispatch(key, salt, &crypt_buffer)
end
