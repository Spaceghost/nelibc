## pragmas.nogc = true
## pragmas.noentrypoint = true

local function nelibc_raw_syscall3(number: culong, arg1: culong, arg2: culong, arg3: culong): clong <cimport> end
local function nelibc_raw_syscall6(number: culong, arg1: culong, arg2: culong, arg3: culong, arg4: culong, arg5: culong, arg6: culong): clong <cimport> end
local function nelibc_errno_location(): *[0]cint <cimport> end
local function malloc(size: csize): pointer <cimport> end
local function free(ptr: pointer): void <cimport> end
local function getenv(name: *[0]cchar <const>): *[0]cchar <cimport> end
local function execve(pathname: *[0]cchar <const>, argv: *[0]*[0]cchar, envp: *[0]*[0]cchar): cint <cimport> end
local function pipe2(pipefd: *[0]cint, flags: cint): cint <cimport> end
local function nelibc_waitpid(pid: cint, status: pointer, options: cint): cint <cimport> end

local SpawnSigSet: type = @record{ values: [16]culong }
local SpawnSchedParam: type = @record{ sched_priority: cint }
local SpawnAttributes: type = @record{
  magic: cuint,
  flags: cint,
  pgroup: cint,
  sigdefault: culong,
  sigmask: culong,
  schedpolicy: cint,
  schedpriority: cint,
  reserved: [88]cuchar
}
local SpawnKernelSigaction: type = @record{
  handler: pointer,
  flags: culong,
  restorer: pointer,
  mask: culong
}

local function syscall_result(result: clong): clong <inline>
  if result < 0 and result >= -4095 then
    nelibc_errno_location()[0] = (@cint)(-result)
    return -1_clong
  end
  return result
end

local SpawnAction: type = @record{
  next: *SpawnAction,
  kind: cint,
  fd: cint,
  newfd: cint,
  flags: cint,
  mode: cuint,
  pathname: *[0]cchar
}
local SpawnCandidate: type = @record{
  next: *SpawnCandidate,
  pathname: *[0]cchar
}
local SpawnFileActions: type = @record{
  first: *SpawnAction,
  last: *SpawnAction,
  magic: cuint,
  reserved: [44]cuchar
}
local spawn_actions_magic: cuint <comptime> = 0x4e535041_cuint
local spawn_attributes_magic: cuint <comptime> = 0x4e535054_cuint

local function spawn_attributes_valid(attributes: *SpawnAttributes): boolean <inline>
  return attributes ~= nilptr and attributes.magic == spawn_attributes_magic
end

local function posix_spawnattr_init(attributes: *SpawnAttributes): cint
    <cexport, codename 'posix_spawnattr_init'>
  if attributes == nilptr then return 22_cint end
  local bytes = (@*[0]cuchar)((@pointer)(attributes))
  local index: csize = 0
  while index < 128_csize do
    bytes[index] = 0_cuchar
    index = index + 1_csize
  end
  attributes.magic = spawn_attributes_magic
  attributes.schedpolicy = 0_cint
  return 0_cint
end

local function posix_spawnattr_destroy(attributes: *SpawnAttributes): cint
    <cexport, codename 'posix_spawnattr_destroy'>
  if not spawn_attributes_valid(attributes) then return 22_cint end
  attributes.magic = 0_cuint
  return 0_cint
end

local function posix_spawnattr_getflags(attributes: *SpawnAttributes,
    flags: *[0]cshort): cint <cexport, codename 'posix_spawnattr_getflags'>
  if not spawn_attributes_valid(attributes) or flags == nilptr then return 22_cint end
  flags[0] = (@cshort)(attributes.flags)
  return 0_cint
end

local function posix_spawnattr_setflags(attributes: *SpawnAttributes,
    flags: cshort): cint <cexport, codename 'posix_spawnattr_setflags'>
  if not spawn_attributes_valid(attributes) or flags < 0_cshort or flags > 0x3f_cshort then return 22_cint end
  attributes.flags = (@cint)(flags)
  return 0_cint
end

local function posix_spawnattr_getpgroup(attributes: *SpawnAttributes,
    pgroup: *[0]cint): cint <cexport, codename 'posix_spawnattr_getpgroup'>
  if not spawn_attributes_valid(attributes) or pgroup == nilptr then return 22_cint end
  pgroup[0] = attributes.pgroup
  return 0_cint
end

local function posix_spawnattr_setpgroup(attributes: *SpawnAttributes,
    pgroup: cint): cint <cexport, codename 'posix_spawnattr_setpgroup'>
  if not spawn_attributes_valid(attributes) or pgroup < 0_cint then return 22_cint end
  attributes.pgroup = pgroup
  return 0_cint
end

local function spawn_copy_sigset(destination: *[0]culong, source: *SpawnSigSet): void <inline>
  destination[0] = source.values[0]
end

local function posix_spawnattr_getsigdefault(attributes: *SpawnAttributes,
    signals: *SpawnSigSet): cint <cexport, codename 'posix_spawnattr_getsigdefault'>
  if not spawn_attributes_valid(attributes) or signals == nilptr then return 22_cint end
  local index: csize = 0
  while index < 16_csize do
    signals.values[index] = 0_culong
    index = index + 1_csize
  end
  signals.values[0] = attributes.sigdefault
  return 0_cint
end

local function posix_spawnattr_setsigdefault(attributes: *SpawnAttributes,
    signals: *SpawnSigSet): cint <cexport, codename 'posix_spawnattr_setsigdefault'>
  if not spawn_attributes_valid(attributes) or signals == nilptr then return 22_cint end
  spawn_copy_sigset(&attributes.sigdefault, signals)
  return 0_cint
end

local function posix_spawnattr_getsigmask(attributes: *SpawnAttributes,
    signals: *SpawnSigSet): cint <cexport, codename 'posix_spawnattr_getsigmask'>
  if not spawn_attributes_valid(attributes) or signals == nilptr then return 22_cint end
  local index: csize = 0
  while index < 16_csize do
    signals.values[index] = 0_culong
    index = index + 1_csize
  end
  signals.values[0] = attributes.sigmask
  return 0_cint
end

local function posix_spawnattr_setsigmask(attributes: *SpawnAttributes,
    signals: *SpawnSigSet): cint <cexport, codename 'posix_spawnattr_setsigmask'>
  if not spawn_attributes_valid(attributes) or signals == nilptr then return 22_cint end
  spawn_copy_sigset(&attributes.sigmask, signals)
  return 0_cint
end

local function posix_spawnattr_getschedpolicy(attributes: *SpawnAttributes,
    policy: *[0]cint): cint <cexport, codename 'posix_spawnattr_getschedpolicy'>
  if not spawn_attributes_valid(attributes) or policy == nilptr then return 22_cint end
  policy[0] = attributes.schedpolicy
  return 0_cint
end

local function posix_spawnattr_setschedpolicy(attributes: *SpawnAttributes,
    policy: cint): cint <cexport, codename 'posix_spawnattr_setschedpolicy'>
  local base_policy = policy & 0x3f_cint
  if not spawn_attributes_valid(attributes) or
      (base_policy ~= 0_cint and base_policy ~= 1_cint and base_policy ~= 2_cint and
       base_policy ~= 3_cint and base_policy ~= 5_cint) or
      (policy ~= base_policy and policy ~= (base_policy | 0x40000000_cint)) then
    return 22_cint
  end
  attributes.schedpolicy = policy
  return 0_cint
end

local function posix_spawnattr_getschedparam(attributes: *SpawnAttributes,
    param: *SpawnSchedParam): cint <cexport, codename 'posix_spawnattr_getschedparam'>
  if not spawn_attributes_valid(attributes) or param == nilptr then return 22_cint end
  param.sched_priority = attributes.schedpriority
  return 0_cint
end

local function posix_spawnattr_setschedparam(attributes: *SpawnAttributes,
    param: *SpawnSchedParam): cint <cexport, codename 'posix_spawnattr_setschedparam'>
  if not spawn_attributes_valid(attributes) or param == nilptr or
      param.sched_priority < 0_cint then return 22_cint end
  attributes.schedpriority = param.sched_priority
  return 0_cint
end

local function posix_spawn_file_actions_init(actions: *SpawnFileActions): cint
    <cexport, codename 'posix_spawn_file_actions_init'>
  if actions == nilptr then return 22_cint end -- EINVAL
  actions.first = nilptr
  actions.last = nilptr
  actions.magic = spawn_actions_magic
  return 0_cint
end

local function posix_spawn_file_actions_destroy(actions: *SpawnFileActions): cint
    <cexport, codename 'posix_spawn_file_actions_destroy'>
  if actions == nilptr or actions.magic ~= spawn_actions_magic then return 22_cint end
  local action = actions.first
  while action ~= nilptr do
    local next_action = action.next
    if action.pathname ~= nilptr then free((@pointer)(action.pathname)) end
    free((@pointer)(action))
    action = next_action
  end
  actions.first = nilptr
  actions.last = nilptr
  actions.magic = 0_cuint
  return 0_cint
end

local function nelibc_spawn_append_action(actions: *SpawnFileActions, kind: cint,
    fd: cint, newfd: cint, flags: cint, mode: cuint,
    pathname: *[0]cchar <const>): cint
  if actions == nilptr or actions.magic ~= spawn_actions_magic then return 22_cint end
  if fd < 0_cint or (kind == 2_cint and newfd < 0_cint) then return 9_cint end -- EBADF
  if (kind == 3_cint or kind == 4_cint) and pathname == nilptr then return 22_cint end
  local saved_errno = nelibc_errno_location()[0]
  local action = (@*SpawnAction)(malloc(40_csize))
  if action == nilptr then
    nelibc_errno_location()[0] = saved_errno
    return 12_cint -- ENOMEM
  end
  action.next = nilptr
  action.kind = kind
  action.fd = fd
  action.newfd = newfd
  action.flags = flags
  action.mode = mode
  action.pathname = nilptr
  if pathname ~= nilptr then
    local path_length: csize = 0
    while pathname[path_length] ~= 0 do path_length = path_length + 1_csize end
    if path_length == 0x7fffffffffffffff_csize then
      free((@pointer)(action))
      nelibc_errno_location()[0] = saved_errno
      return 12_cint -- ENOMEM
    end
    action.pathname = (@*[0]cchar)(malloc(path_length + 1_csize))
    if action.pathname == nilptr then
      free((@pointer)(action))
      nelibc_errno_location()[0] = saved_errno
      return 12_cint -- ENOMEM
    end
    local index: csize = 0
    while index <= path_length do
      action.pathname[index] = pathname[index]
      index = index + 1_csize
    end
  end
  if actions.last == nilptr then actions.first = action
  else actions.last.next = action end
  actions.last = action
  nelibc_errno_location()[0] = saved_errno
  return 0_cint
end

local function posix_spawn_file_actions_addclose(actions: *SpawnFileActions,
    fd: cint): cint <cexport, codename 'posix_spawn_file_actions_addclose'>
  return nelibc_spawn_append_action(actions, 1_cint, fd, 0_cint, 0_cint,
                                    0_cuint, nilptr)
end

local function posix_spawn_file_actions_adddup2(actions: *SpawnFileActions,
    fd: cint, newfd: cint): cint <cexport, codename 'posix_spawn_file_actions_adddup2'>
  return nelibc_spawn_append_action(actions, 2_cint, fd, newfd, 0_cint,
                                    0_cuint, nilptr)
end

local function posix_spawn_file_actions_addopen(actions: *SpawnFileActions,
    fd: cint, pathname: *[0]cchar <const>, flags: cint, mode: cuint): cint
    <cexport, codename 'posix_spawn_file_actions_addopen'>
  return nelibc_spawn_append_action(actions, 3_cint, fd, 0_cint, flags,
                                    mode, pathname)
end

local function posix_spawn_file_actions_addchdir_np(actions: *SpawnFileActions,
    pathname: *[0]cchar <const>): cint
    <cexport, codename 'posix_spawn_file_actions_addchdir_np'>
  return nelibc_spawn_append_action(actions, 4_cint, 0_cint, 0_cint, 0_cint,
                                    0_cuint, pathname)
end

local function posix_spawn_file_actions_addfchdir_np(actions: *SpawnFileActions,
    fd: cint): cint <cexport, codename 'posix_spawn_file_actions_addfchdir_np'>
  return nelibc_spawn_append_action(actions, 5_cint, fd, 0_cint, 0_cint,
                                    0_cuint, nilptr)
end

local function nelibc_spawn_child_fail(error_fd: cint, error_number: cint): void
  local written: csize = 0
  while written < 4_csize do
    local address = (@pointer)((@usize)(&error_number) + (@usize)(written))
    local write_result = nelibc_raw_syscall3(1_culong, (@culong)(error_fd),
        (@culong)((@usize)(address)), (@culong)(4_csize - written))
    if write_result == -4_clong then continue end -- EINTR
    if write_result <= 0_clong then break end
    written = written + (@csize)(write_result)
  end
  nelibc_raw_syscall3(60_culong, 127_culong, 0_culong, 0_culong)
  while true do end
end

-- Spawn is not a cancellation point, including its child-error cleanup path.
local function nelibc_spawn_reap_child(child: cint): void
  while true do
    local result = nelibc_raw_syscall6(61_culong, (@culong)(child), 0_culong,
        0_culong, 0_culong, 0_culong, 0_culong) -- wait4(pid, NULL, 0, NULL)
    if result == -4_clong then continue end -- EINTR
    return
  end
end

local function nelibc_spawn_max_action_fd(actions: *SpawnFileActions): cint
  local maximum: cint = 2_cint
  if actions == nilptr then return maximum end
  local action = actions.first
  while action ~= nilptr do
    if action.fd > maximum then maximum = action.fd end
    if action.kind == 2_cint and action.newfd > maximum then maximum = action.newfd end
    action = action.next
  end
  return maximum
end

local function nelibc_spawn_apply_actions(actions: *SpawnFileActions,
    error_fd: cint): void
  if actions == nilptr then return end
  local action = actions.first
  while action ~= nilptr do
    local result: clong = 0_clong
    if action.kind == 1_cint then
      result = nelibc_raw_syscall3(3_culong, (@culong)(action.fd), 0_culong, 0_culong)
    elseif action.kind == 2_cint then
      result = nelibc_raw_syscall3(33_culong, (@culong)(action.fd),
          (@culong)(action.newfd), 0_culong)
    elseif action.kind == 3_cint then
      result = nelibc_raw_syscall6(257_culong, 0xffffffffffffff9c_culong,
          (@culong)((@usize)(action.pathname)), (@culong)(action.flags),
          (@culong)(action.mode), 0_culong, 0_culong)
      if result >= 0_clong and result ~= action.fd then
        local opened_fd = result
        result = nelibc_raw_syscall3(33_culong, (@culong)(opened_fd),
            (@culong)(action.fd), 0_culong)
        nelibc_raw_syscall3(3_culong, (@culong)(opened_fd), 0_culong, 0_culong)
      end
    elseif action.kind == 4_cint then
      result = nelibc_raw_syscall3(80_culong,
          (@culong)((@usize)(action.pathname)), 0_culong, 0_culong)
    else
      result = nelibc_raw_syscall3(81_culong, (@culong)(action.fd), 0_culong, 0_culong)
    end
    if result < 0_clong then nelibc_spawn_child_fail(error_fd, (@cint)(-result)) end
    action = action.next
  end
end

local function nelibc_spawn_apply_attributes(attributes: *SpawnAttributes,
    error_fd: cint): void
  if attributes == nilptr then return end
  local result: clong = 0_clong
  if (attributes.flags & 0x02_cint) ~= 0_cint then -- POSIX_SPAWN_SETPGROUP
    result = nelibc_raw_syscall3(109_culong, 0_culong,
        (@culong)(attributes.pgroup), 0_culong)
    if result < 0_clong then nelibc_spawn_child_fail(error_fd, (@cint)(-result)) end
  end
  if (attributes.flags & 0x04_cint) ~= 0_cint then -- POSIX_SPAWN_SETSIGDEF
    local signal_index: cint = 0
    while signal_index < 64_cint do
      local signal_bit = 1_culong << signal_index
      local signal_number = signal_index + 1_cint
      if (attributes.sigdefault & signal_bit) ~= 0_culong and
          signal_number ~= 9_cint and signal_number ~= 19_cint then
        local default_action: SpawnKernelSigaction
        default_action.handler = nilptr
        default_action.flags = 0_culong
        default_action.restorer = nilptr
        default_action.mask = 0_culong
        result = nelibc_raw_syscall6(13_culong, (@culong)(signal_number),
            (@culong)((@usize)(&default_action)), 0_culong, 8_culong,
            0_culong, 0_culong)
        if result < 0_clong then nelibc_spawn_child_fail(error_fd, (@cint)(-result)) end
      end
      signal_index = signal_index + 1_cint
    end
  end
  if (attributes.flags & 0x08_cint) ~= 0_cint then -- POSIX_SPAWN_SETSIGMASK
    result = nelibc_raw_syscall6(14_culong, 2_culong,
        (@culong)((@usize)(&attributes.sigmask)), 0_culong, 8_culong,
        0_culong, 0_culong)
    if result < 0_clong then nelibc_spawn_child_fail(error_fd, (@cint)(-result)) end
  end
  if (attributes.flags & 0x01_cint) ~= 0_cint then -- POSIX_SPAWN_RESETIDS
    local real_gid = nelibc_raw_syscall3(104_culong, 0_culong, 0_culong, 0_culong)
    result = nelibc_raw_syscall6(119_culong, (@culong)(real_gid),
        (@culong)(real_gid), 0xffffffffffffffff_culong, 0_culong, 0_culong, 0_culong)
    if result < 0_clong then nelibc_spawn_child_fail(error_fd, (@cint)(-result)) end
    local real_uid = nelibc_raw_syscall3(102_culong, 0_culong, 0_culong, 0_culong)
    result = nelibc_raw_syscall6(117_culong, (@culong)(real_uid),
        (@culong)(real_uid), 0xffffffffffffffff_culong, 0_culong, 0_culong, 0_culong)
    if result < 0_clong then nelibc_spawn_child_fail(error_fd, (@cint)(-result)) end
  end
  if (attributes.flags & 0x20_cint) ~= 0_cint then -- POSIX_SPAWN_SETSCHEDULER
    local parameter: SpawnSchedParam
    parameter.sched_priority = attributes.schedpriority
    result = nelibc_raw_syscall3(144_culong, 0_culong,
        (@culong)(attributes.schedpolicy), (@culong)((@usize)(&parameter)))
    if result < 0_clong then nelibc_spawn_child_fail(error_fd, (@cint)(-result)) end
  elseif (attributes.flags & 0x10_cint) ~= 0_cint then -- POSIX_SPAWN_SETSCHEDPARAM
    local parameter: SpawnSchedParam
    parameter.sched_priority = attributes.schedpriority
    result = nelibc_raw_syscall3(142_culong, 0_culong,
        (@culong)((@usize)(&parameter)), 0_culong)
    if result < 0_clong then nelibc_spawn_child_fail(error_fd, (@cint)(-result)) end
  end
end

-- Spawn without host libc by reporting child setup and exec errors through a
-- close-on-exec pipe. Spawn attributes run before ordered file actions.
local function nelibc_spawn_candidates_destroy(candidates: *SpawnCandidate): void
  while candidates ~= nilptr do
    local next_candidate = candidates.next
    free((@pointer)(candidates.pathname))
    free((@pointer)(candidates))
    candidates = next_candidate
  end
end

local function nelibc_spawn_resolve_path(file: *[0]cchar <const>,
    candidates_out: *[0]*SpawnCandidate): cint
  candidates_out[0] = nilptr
  local file_length: csize = 0
  local has_slash: boolean = false
  while file[file_length] ~= 0 do
    if file[file_length] == 47 then has_slash = true end
    file_length = file_length + 1_csize
  end
  if has_slash then return 0_cint end

  local search_path: *[0]cchar = getenv('PATH')
  if search_path == nilptr then search_path = '/bin:/usr/bin' end
  local search_start: csize = 0
  local path_too_long: boolean = false
  local first_candidate: *SpawnCandidate = nilptr
  local last_candidate: *SpawnCandidate = nilptr
  while true do
    local search_end = search_start
    while search_path[search_end] ~= 0 and search_path[search_end] ~= 58 do
      search_end = search_end + 1_csize
    end
    local directory_length = search_end - search_start
    local prefix_length = directory_length
    if prefix_length == 0_csize then prefix_length = 1_csize end
    if prefix_length <= 0x7fffffffffffffff_csize - file_length - 2_csize then
      local candidate_length = prefix_length + 1_csize + file_length
      local candidate = (@*[0]cchar)(malloc(candidate_length + 1_csize))
      if candidate == nilptr then
        nelibc_spawn_candidates_destroy(first_candidate)
        nelibc_errno_location()[0] = 12_cint -- ENOMEM
        return 12_cint
      end
      local index: csize = 0
      if directory_length == 0_csize then
        candidate[0] = 46_cchar -- empty PATH component means '.'
        index = 1_csize
      else
        while index < directory_length do
          candidate[index] = search_path[search_start + index]
          index = index + 1_csize
        end
      end
      candidate[index] = 47_cchar
      index = 0_csize
      while index < file_length do
        candidate[prefix_length + 1_csize + index] = file[index]
        index = index + 1_csize
      end
      candidate[candidate_length] = 0_cchar
      local entry = (@*SpawnCandidate)(malloc(16_csize))
      if entry == nilptr then
        free((@pointer)(candidate))
        nelibc_spawn_candidates_destroy(first_candidate)
        nelibc_errno_location()[0] = 12_cint -- ENOMEM
        return 12_cint
      end
      entry.next = nilptr
      entry.pathname = candidate
      if last_candidate == nilptr then first_candidate = entry
      else last_candidate.next = entry end
      last_candidate = entry
    else
      path_too_long = true
    end
    if search_path[search_end] == 0 then break end
    search_start = search_end + 1_csize
  end
  if first_candidate == nilptr then
    if path_too_long then return 36_cint end -- ENAMETOOLONG
    return 2_cint -- ENOENT
  end
  candidates_out[0] = first_candidate
  return 0_cint
end

local function nelibc_posix_spawn_common(pid_output: *[0]cint,
    pathname: *[0]cchar <const>, file_actions: pointer,
    attributes: pointer, argv: *[0]*[0]cchar, envp: *[0]*[0]cchar,
    search_path: boolean): cint
  if pid_output == nilptr or pathname == nilptr or argv == nilptr or envp == nilptr then
    return 22_cint -- EINVAL
  end
  local attribute_state: *SpawnAttributes = nilptr
  if attributes ~= nilptr then
    attribute_state = (@*SpawnAttributes)(attributes)
    if not spawn_attributes_valid(attribute_state) then return 22_cint end
  end
  local action_state: *SpawnFileActions = nilptr
  if file_actions ~= nilptr then
    action_state = (@*SpawnFileActions)(file_actions)
    if action_state.magic ~= spawn_actions_magic then return 22_cint end -- EINVAL
  end

  local saved_errno = nelibc_errno_location()[0]
  local executable_candidates: *SpawnCandidate = nilptr
  if search_path then
    local resolve_error = nelibc_spawn_resolve_path(pathname, &executable_candidates)
    if resolve_error ~= 0_cint then
      nelibc_errno_location()[0] = saved_errno
      return resolve_error
    end
  end
  local error_pipe: [2]cint
  if pipe2(&error_pipe[0], 0x80000_cint) ~= 0_cint then
    local error_number = nelibc_errno_location()[0]
    nelibc_spawn_candidates_destroy(executable_candidates)
    nelibc_errno_location()[0] = saved_errno
    return error_number
  end
  local maximum_action_fd = nelibc_spawn_max_action_fd(action_state)
  if maximum_action_fd >= 0x7ffffffe_cint then
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[0]), 0_culong, 0_culong)
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[1]), 0_culong, 0_culong)
    nelibc_spawn_candidates_destroy(executable_candidates)
    nelibc_errno_location()[0] = saved_errno
    return 24_cint -- EMFILE: no room above all action descriptors for the error channel
  end
  local minimum_error_fd = maximum_action_fd + 1_cint
  if minimum_error_fd < 3_cint then minimum_error_fd = 3_cint end
  local raw_read_fd = nelibc_raw_syscall3(72_culong, (@culong)(error_pipe[0]),
      1030_culong, (@culong)(minimum_error_fd))
  if raw_read_fd < 0_clong then
    local error_number = (@cint)(-raw_read_fd)
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[0]), 0_culong, 0_culong)
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[1]), 0_culong, 0_culong)
    nelibc_spawn_candidates_destroy(executable_candidates)
    nelibc_errno_location()[0] = saved_errno
    return error_number
  end
  local raw_write_fd = nelibc_raw_syscall3(72_culong, (@culong)(error_pipe[1]),
      1030_culong, (@culong)(minimum_error_fd + 1_cint))
  if raw_write_fd < 0_clong then
    local error_number = (@cint)(-raw_write_fd)
    nelibc_raw_syscall3(3_culong, (@culong)(raw_read_fd), 0_culong, 0_culong)
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[0]), 0_culong, 0_culong)
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[1]), 0_culong, 0_culong)
    nelibc_spawn_candidates_destroy(executable_candidates)
    nelibc_errno_location()[0] = saved_errno
    return error_number
  end
  nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[0]), 0_culong, 0_culong)
  nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[1]), 0_culong, 0_culong)
  error_pipe[0] = (@cint)(raw_read_fd)
  error_pipe[1] = (@cint)(raw_write_fd)
  local raw_child = nelibc_raw_syscall3(57_culong, 0_culong, 0_culong, 0_culong)
  local child = (@cint)(syscall_result(raw_child))
  if child < 0_cint then
    local error_number = nelibc_errno_location()[0]
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[0]), 0_culong, 0_culong)
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[1]), 0_culong, 0_culong)
    nelibc_spawn_candidates_destroy(executable_candidates)
    nelibc_errno_location()[0] = saved_errno
    return error_number
  end
  if child == 0_cint then
    nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[0]), 0_culong, 0_culong)
    nelibc_spawn_apply_attributes(attribute_state, error_pipe[1])
    nelibc_spawn_apply_actions(action_state, error_pipe[1])
    local child_error: cint = 0_cint
    if executable_candidates == nilptr then
      execve(pathname, argv, envp)
      child_error = nelibc_errno_location()[0]
    else
      local candidate = executable_candidates
      local saw_access_denied = false
      child_error = 2_cint -- ENOENT
      while candidate ~= nilptr do
        execve(candidate.pathname, argv, envp)
        local attempt_error = nelibc_errno_location()[0]
        if attempt_error == 13_cint then saw_access_denied = true end -- EACCES
        if attempt_error ~= 2_cint and attempt_error ~= 20_cint and
           attempt_error ~= 13_cint and attempt_error ~= 26_cint then
          child_error = attempt_error
          break
        end
        child_error = attempt_error
        candidate = candidate.next
      end
      if candidate == nilptr and saw_access_denied then child_error = 13_cint end
    end
    nelibc_spawn_child_fail(error_pipe[1], child_error)
  end

  nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[1]), 0_culong, 0_culong)
  local child_error: cint = 0
  local received: csize = 0
  local read_error: cint = 0
  while received < 4_csize do
    local address = (@pointer)((@usize)(&child_error) + (@usize)(received))
    local result = nelibc_raw_syscall3(0_culong, (@culong)(error_pipe[0]),
                                       (@culong)((@usize)(address)),
                                       (@culong)(4_csize - received))
    if result == 0_culong then break end
    if result == -4_clong then continue end -- EINTR
    if result < 0_clong then
      read_error = (@cint)(-result)
      break
    end
    received = received + (@csize)(result)
  end
  nelibc_raw_syscall3(3_culong, (@culong)(error_pipe[0]), 0_culong, 0_culong)
  if read_error ~= 0_cint or (received ~= 0_csize and received ~= 4_csize) then
    nelibc_raw_syscall3(62_culong, (@culong)(child), 9_culong, 0_culong) -- kill SIGKILL
    nelibc_spawn_reap_child(child)
    nelibc_spawn_candidates_destroy(executable_candidates)
    nelibc_errno_location()[0] = saved_errno
    if read_error ~= 0_cint then return read_error end
    return 5_cint -- EIO
  end
  if received == 4_csize then
    nelibc_spawn_reap_child(child)
    nelibc_spawn_candidates_destroy(executable_candidates)
    nelibc_errno_location()[0] = saved_errno
    return child_error
  end
  pid_output[0] = child
  nelibc_spawn_candidates_destroy(executable_candidates)
  nelibc_errno_location()[0] = saved_errno
  return 0_cint
end

local function posix_spawn(pid_output: *[0]cint,
    pathname: cstring <const>, file_actions: pointer <const>,
    attributes: pointer <const>, argv: *[0]*[0]cchar,
    envp: *[0]*[0]cchar): cint <cexport, codename 'posix_spawn'>
  local pathname: *[0]cchar = (@*[0]cchar)(pathname)
  return nelibc_posix_spawn_common(pid_output, pathname,
      (@pointer)(file_actions), (@pointer)(attributes), argv, envp, false)
end

local function posix_spawnp(pid_output: *[0]cint,
    file: cstring <const>, file_actions: pointer <const>,
    attributes: pointer <const>, argv: *[0]*[0]cchar,
    envp: *[0]*[0]cchar): cint <cexport, codename 'posix_spawnp'>
  local file: *[0]cchar = (@*[0]cchar)(file)
  return nelibc_posix_spawn_common(pid_output, file,
      (@pointer)(file_actions), (@pointer)(attributes), argv, envp, true)
end
