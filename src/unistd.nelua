    72_culong, (@culong)(fd), (@culong)(command), argument
  )))
end

-- Command values are the Linux x86-64 fcntl ABI. Returning an argument kind
-- keeps the variadic va_arg operation in C while Nelua owns command dispatch.
local function nelibc_fcntl_argument_kind(command: cint): cint <cexport, codename 'nelibc_fcntl_argument_kind'>
  if command == 1 or command == 3 or command == 9 or command == 11 or
     command == 1025 or command == 1032 or command == 1034 then
    return 0 -- no third argument
  end
  if command == 5 or command == 6 or command == 7 or
     command == 36 or command == 37 or command == 38 then
    return 1 -- struct flock *
  end
  if command == 15 or command == 16 then
    return 2 -- struct f_owner_ex *
  end
  if command >= 1035 and command <= 1038 then
    return 3 -- uint64_t *
  end
  return 4 -- promoted int argument
end

