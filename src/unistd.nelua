-- POSIX getgroups returns the supplementary groups associated with the caller.
local function getgroups(size: cint, groups: pointer): cint <cexport, codename 'getgroups'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    115_culong,
    (@culong)(size),
    (@culong)((@usize)(groups)),
    0_culong
  )))
end

-- Linux setgroups replaces the supplementary group list and may require privilege.
local function nelibc_raw_setgroups(size: csize, groups: pointer <const>): cint <cexport, codename 'nelibc_raw_setgroups'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    116_culong,
    (@culong)(size),
    (@culong)((@usize)(groups)),
    0_culong
  )))
end

-- getpid cannot fail for a live Linux process and has no errno translation.
local function getpid(): cint <cexport, codename 'getpid'>
  return (@cint)(nelibc_raw_syscall3(39_culong, 0_culong, 0_culong, 0_culong))
end

local function getppid(): cint <cexport, codename 'getppid'>
  return (@cint)(nelibc_raw_syscall3(110_culong, 0_culong, 0_culong, 0_culong))
end

local function getpgid(pid: cint): cint <cexport, codename 'getpgid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    121_culong,
    (@culong)(pid),
    0_culong,
    0_culong
  )))
end

local function getpgrp(): cint <cexport, codename 'getpgrp'>
  return (@cint)(nelibc_raw_syscall3(121_culong, 0_culong, 0_culong, 0_culong))
end

-- POSIX setpgid assigns a process to a process group in its current session.
local function setpgid(pid: cint, pgid: cint): cint <cexport, codename 'setpgid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    109_culong, (@culong)(pid), (@culong)(pgid), 0_culong
  )))
end

local function getsid(pid: cint): cint <cexport, codename 'getsid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
