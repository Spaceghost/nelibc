-- Linux setregid accepts (gid_t)-1 to preserve either identity.
local function nelibc_raw_setregid(real_gid: cuint, effective_gid: cuint): cint <cexport, codename 'nelibc_raw_setregid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    114_culong, (@culong)(real_gid), (@culong)(effective_gid), 0_culong
  )))
