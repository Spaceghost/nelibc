local function eventfd_read(fd: cint, value: *[0]uint64): cint <cexport, codename 'eventfd_read'>
  local result = read(fd, (@pointer)(value), 8_csize)
  if result == 8_clong then return 0 end
  if result >= 0 then nelibc_errno_location()[0] = 5_cint end -- EIO
  return -1
end

local function eventfd_write(fd: cint, value: uint64): cint <cexport, codename 'eventfd_write'>
  local result = write(fd, (@pointer)(&value), 8_csize)
  if result == 8_clong then return 0 end
  if result >= 0 then nelibc_errno_location()[0] = 5_cint end -- EIO
  return -1
end

