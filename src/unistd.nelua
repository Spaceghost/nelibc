local function setsid(): cint <cexport, codename 'setsid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(112_culong, 0_culong, 0_culong, 0_culong)))
end

-- Linux-specific thread ID; libc has no separate errno handling for this call.
local function gettid(): cint <cexport, codename 'gettid'>
  return (@cint)(nelibc_raw_syscall3(186_culong, 0_culong, 0_culong, 0_culong))
end

local function kill(pid: cint, signal: cint): cint <cexport, codename 'kill'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    62_culong,
    (@culong)(pid),
    (@culong)(signal),
    0_culong
  )))
end

-- POSIX raise targets the calling thread, so use Linux tgkill rather than kill.
local function raise(signal: cint): cint <cexport, codename 'raise'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    234_culong,
    (@culong)(getpid()),
    (@culong)(gettid()),
    (@culong)(signal)
  )))
end

-- Kernel x86_64 rt_sigaction entry point used by sigaction.
local function nelibc_rt_sigaction(signal: cint, act: pointer, oldact: pointer): cint <cexport, codename 'nelibc_rt_sigaction'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    13_culong, (@culong)(signal), (@culong)((@usize)(act)),
    (@culong)((@usize)(oldact)), 8_culong, 0_culong, 0_culong
  )))
end

local Sigaction: type = @record{
  handler: pointer,
  mask: Sigset,
  flags: cint,
  restorer: pointer
}
local KernelSigaction: type = @record{
  handler: pointer,
  flags: culong,
  restorer: pointer,
  mask: culong
}
local function nelibc_rt_sigreturn(): void <cimport> end

-- Convert the glibc/musl x86_64 sigaction ABI to Linux's 8-byte kernel sigset ABI.
local function sigaction(signal: cint, action: pointer <const>, old_action: pointer): cint <cexport, codename 'sigaction'>
  if signal == 32 then
    nelibc_errno_location()[0] = 22_cint -- EINVAL: internal cancellation signal
    return -1_cint
  end
  local kernel_action: KernelSigaction
  local kernel_old_action: KernelSigaction
  local action_ptr: pointer = nilptr
  local old_action_ptr: pointer = nilptr
  if action ~= nilptr then
    local user_action = (@*Sigaction)(action)
    kernel_action.handler = user_action.handler
    kernel_action.flags = (@culong)(user_action.flags) | 0x04000000_culong -- SA_RESTORER
    kernel_action.restorer = (@pointer)(nelibc_rt_sigreturn)
    kernel_action.mask = user_action.mask.bits[0]
    action_ptr = (@pointer)(&kernel_action)
  end
  if old_action ~= nilptr then
    old_action_ptr = (@pointer)(&kernel_old_action)
  end
  local result = nelibc_rt_sigaction(signal, action_ptr, old_action_ptr)
  if result == 0 and old_action ~= nilptr then
    local user_old_action = (@*Sigaction)(old_action)
    user_old_action.handler = kernel_old_action.handler
    user_old_action.flags = (@cint)(kernel_old_action.flags & ~0x04000000_culong)
    user_old_action.restorer = kernel_old_action.restorer
    for i = 0, 15 do
      user_old_action.mask.bits[i] = 0_culong
    end
    user_old_action.mask.bits[0] = kernel_old_action.mask
  end
  return result
end

-- Linux x86_64 uses an 8-byte kernel sigset even when libc's sigset_t is larger.
local function sigprocmask(how: cint, set: pointer <const>, oldset: pointer): cint <cexport, codename 'sigprocmask'>
  local kernel_set: culong
  local set_pointer: pointer = nilptr
  if set ~= nilptr then
    kernel_set = ((@*Sigset)(set)).bits[0] & ~(1_culong << 31)
    set_pointer = (@pointer)(&kernel_set)
  end
  local result = syscall_result(nelibc_raw_syscall6(
    14_culong, (@culong)(how), (@culong)((@usize)(set_pointer)),
    (@culong)((@usize)(oldset)), 8_culong, 0_culong, 0_culong
  ))
  if result == 0 and oldset ~= nilptr then
    ((@*Sigset)(oldset)).bits[0] = ((@*Sigset)(oldset)).bits[0] & ~(1_culong << 31)
  end
  return (@cint)(result)
end

local function sigpending(set: pointer): cint <cexport, codename 'sigpending'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    127_culong, (@culong)((@usize)(set)), 8_culong, 0_culong,
    0_culong, 0_culong, 0_culong
  )))
end

local function sigismember(set: pointer <const>, signal: cint): cint <cexport, codename 'sigismember'>
  if signal < 1 or signal > 64 then
    nelibc_errno_location()[0] = 22_cint
    return -1_cint
  end
  if signal == 32 then return 0_cint end
  local words: *[0]culong = (@*[0]culong)(set)
  local bit = 1_culong << (@culong)((signal - 1) % 64)
  local word = words[(signal - 1) // 64]
  if (word & bit) ~= 0_culong then
    return 1_cint
  end
  return 0_cint
end

local function sigemptyset(set: pointer): cint <cexport, codename 'sigemptyset'>
  local bytes: *[0]byte = (@*[0]byte)(set)
  for i = 0, 127 do bytes[i] = 0 end
  return 0_cint
end

local function sigaddset(set: pointer, signal: cint): cint <cexport, codename 'sigaddset'>
  if signal < 1 or signal > 64 then
    nelibc_errno_location()[0] = 22_cint
    return -1_cint
  end
  if signal == 32 then
    nelibc_errno_location()[0] = 22_cint
    return -1_cint
  end
  local words: *[0]culong = (@*[0]culong)(set)
  words[(signal - 1) // 64] = words[(signal - 1) // 64] | (1_culong << (@culong)((signal - 1) % 64))
  return 0_cint
end

local function sigdelset(set: pointer, signal: cint): cint <cexport, codename 'sigdelset'>
  if signal < 1 or signal > 64 then
    nelibc_errno_location()[0] = 22_cint
    return -1_cint
  end
  if signal == 32 then return 0_cint end
  local words: *[0]culong = (@*[0]culong)(set)
  words[(signal - 1) // 64] = words[(signal - 1) // 64] & ~(1_culong << (@culong)((signal - 1) % 64))
  return 0_cint
end

local function sigfillset(set: pointer): cint <cexport, codename 'sigfillset'>
  local bytes: *[0]byte = (@*[0]byte)(set)
  for i = 0, 127 do bytes[i] = 0xff end
  ((@*Sigset)(set)).bits[0] = ((@*Sigset)(set)).bits[0] & ~(1_culong << 31)
  return 0_cint
end
