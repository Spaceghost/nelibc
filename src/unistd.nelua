-- POSIX posix_fallocate returns the error number directly and leaves errno alone.
local function posix_fallocate(fd: cint, offset: clong, length: clong): cint <cexport, codename 'posix_fallocate'>
  local result = nelibc_raw_syscall6(
    285_culong,
    (@culong)(fd),
    0_culong,
    (@culong)(offset),
    (@culong)(length),
    0_culong,
    0_culong
  )
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  return 0_cint
end

-- POSIX posix_fadvise returns error numbers directly without changing errno.
local function posix_fadvise(fd: cint, offset: clong, length: clong, advice: cint): cint <cexport, codename 'posix_fadvise'>
