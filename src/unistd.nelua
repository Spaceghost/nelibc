-- POSIX swab exchanges adjacent byte pairs; an odd final byte is ignored.
local function swab(from: pointer <const>, to: pointer, count: clong): void <cexport, codename 'swab'>
  if count < 2_clong then return end
  local source = (@*[0]cchar)(from)
  local destination = (@*[0]cchar)(to)
  local index: csize = 0
  while index + 1_csize < (@csize)(count) do
    destination[index] = source[index + 1_csize]
    destination[index + 1_csize] = source[index]
    index = index + 2_csize
  end
end

local function syncfs(fd: cint): cint <cexport, codename 'syncfs'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    306_culong, (@culong)(fd), 0_culong, 0_culong
  )))
end

-- POSIX pipe on Linux x86_64; the kernel writes the two descriptors to pipefd.
local function pipe(pipefd: *[0]cint): cint <cexport, codename 'pipe'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    22_culong,
    (@culong)((@usize)(pipefd)),
    0_culong,
    0_culong
  )))
end

-- Linux pipe2 creates the descriptors and applies status flags atomically.
local function pipe2(pipefd: *[0]cint, flags: cint): cint <cexport, codename 'pipe2'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    293_culong,
    (@culong)((@usize)(pipefd)),
    (@culong)(flags),
    0_culong
  )))
end

-- POSIX openat; mode is consumed only when flags request file creation.
local function openat(dirfd: cint, pathname: pointer <const>, flags: cint, mode: cuint): cint <cexport, codename 'openat'>
  local create_mode: cuint = 0
  if (flags & 0x40) ~= 0 or (flags & 0x410000) == 0x410000 then
    create_mode = mode
  end
  local raw_result = nelibc_cancellable_syscall6(
    257_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)(flags),
    (@culong)(create_mode),
    0_culong,
    0_culong
  )
  return (@cint)(syscall_result(raw_result))
end

-- x86_64 openat64 has the same large-file syscall ABI as openat.
local function openat64(dirfd: cint, pathname: pointer <const>, flags: cint, mode: cuint): cint <cexport, codename 'openat64'>
  return openat(dirfd, pathname, flags, mode)
end

-- POSIX open resolves a path from the current working directory.
local function open(pathname: pointer <const>, flags: cint, mode: cuint): cint <cexport, codename 'open'>
  return openat(-100_cint, pathname, flags, mode)
end

-- POSIX creat opens a write-only file, creating or truncating it as needed.
local function creat(pathname: pointer <const>, mode: cuint): cint <cexport, codename 'creat'>
  return openat(-100_cint, pathname, 0x241_cint, mode)
end

local function open64(pathname: pointer <const>, flags: cint, mode: cuint): cint <cexport, codename 'open64'>
  return open(pathname, flags, mode)
end

-- POSIX truncate uses Linux x86_64 syscall 76 and follows the final symlink.
local function truncate(pathname: pointer <const>, length: clong): cint <cexport, codename 'truncate'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    76_culong,
    (@culong)((@usize)(pathname)),
    (@culong)(length),
    0_culong
  )))
end

local function unlinkat(dirfd: cint, pathname: pointer <const>, flags: cint): cint <cexport, codename 'unlinkat'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    263_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)(flags)
  )))
end

-- POSIX unlink removes a non-directory path relative to the current directory.
local function unlink(pathname: pointer <const>): cint <cexport, codename 'unlink'>
  return unlinkat(-100_cint, pathname, 0_cint)
end

-- POSIX rmdir removes a directory through unlinkat's AT_REMOVEDIR flag.
local function rmdir(pathname: pointer <const>): cint <cexport, codename 'rmdir'>
  return unlinkat(-100_cint, pathname, 0x200_cint)
end

local function mkdirat(dirfd: cint, pathname: pointer <const>, mode: cuint): cint <cexport, codename 'mkdirat'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(258_culong, (@culong)(dirfd), (@culong)((@usize)(pathname)), (@culong)(mode))))
end

-- POSIX mkdir creates a directory relative to the current working directory.
local function mkdir(pathname: pointer <const>, mode: cuint): cint <cexport, codename 'mkdir'>
  return mkdirat(-100_cint, pathname, mode)
end

local function temp_template_length(template: *[0]cchar, suffix_length: cint): csize <inline>
  if template == nilptr or suffix_length < 0 then
    nelibc_errno_location()[0] = 22_cint -- EINVAL
    return 0_csize
  end
  local length: csize = 0
  while template[length] ~= 0 do length = length + 1_csize end
  if length < 6_csize or (@csize)(suffix_length) > length - 6_csize then
    nelibc_errno_location()[0] = 22_cint -- EINVAL
    return 0_csize
  end
  local start = length - (@csize)(suffix_length) - 6_csize
  local index: csize = 0
  while index < 6_csize do
    if template[start + index] ~= 88 then
      nelibc_errno_location()[0] = 22_cint -- EINVAL
      return 0_csize
    end
    index = index + 1_csize
  end
  return length
end

local function temp_template_restore(template: *[0]cchar, start: csize): void <inline>
  local index: csize = 0
  while index < 6_csize do
    template[start + index] = 88_cchar
    index = index + 1_csize
  end
end

-- Use kernel randomness and a power-of-two alphabet to avoid modulo bias.
local function temp_template_randomize(template: *[0]cchar, start: csize): boolean <inline>
  local alphabet: *[0]cchar <const> = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_'
  local produced: csize = 0
  while produced < 6_csize do
    local bytes: [16]cuchar
    local count = getrandom((@pointer)(&bytes[0]), 16_csize, 0_cuint)
    if count < 0_clong then
      if nelibc_errno_location()[0] == 4_cint then continue end -- EINTR
      return false
    end
    if count == 0_clong then
      nelibc_errno_location()[0] = 5_cint -- EIO
      return false
    end
    local index: csize = 0
    while index < (@csize)(count) and produced < 6_csize do
      template[start + produced] = alphabet[bytes[index] & 0x3f_cuchar]
      produced = produced + 1_csize
      index = index + 1_csize
    end
  end
  return true
end

local function mkostemps_impl(template: *[0]cchar, suffix_length: cint, flags: cint): cint <inline>
  local length = temp_template_length(template, suffix_length)
  if length == 0_csize then return -1_cint end
  local start = length - (@csize)(suffix_length) - 6_csize
  local create_flags = (flags & ~3_cint) | 0x2_cint | 0x40_cint | 0x80_cint
  local attempt: cint = 0
  while attempt < 100_cint do
    if not temp_template_randomize(template, start) then
      temp_template_restore(template, start)
      return -1_cint
    end
    local descriptor = open((@pointer)(template), create_flags, 0x180_cuint)
    if descriptor >= 0_cint then return descriptor end
    if nelibc_errno_location()[0] ~= 17_cint then break end -- EEXIST
    attempt = attempt + 1_cint
  end
  temp_template_restore(template, start)
  return -1_cint
end

local function mkstemp(template: *[0]cchar): cint <cexport, codename 'mkstemp'>
  return mkostemps_impl(template, 0_cint, 0_cint)
end

local function mkstemps(template: *[0]cchar, suffix_length: cint): cint <cexport, codename 'mkstemps'>
  return mkostemps_impl(template, suffix_length, 0_cint)
end

local function mkostemp(template: *[0]cchar, flags: cint): cint <cexport, codename 'mkostemp'>
  return mkostemps_impl(template, 0_cint, flags)
end

local function mkostemps(template: *[0]cchar, suffix_length: cint, flags: cint): cint <cexport, codename 'mkostemps'>
  return mkostemps_impl(template, suffix_length, flags)
end

local function mkdtemp(template: *[0]cchar): *[0]cchar <cexport, codename 'mkdtemp'>
  local length = temp_template_length(template, 0_cint)
  if length == 0_csize then return nilptr end
  local start = length - 6_csize
  local attempt: cint = 0
  while attempt < 100_cint do
    if not temp_template_randomize(template, start) then
      temp_template_restore(template, start)
      return nilptr
    end
    if mkdir((@pointer)(template), 0x1c0_cuint) == 0_cint then return template end
    if nelibc_errno_location()[0] ~= 17_cint then break end -- EEXIST
    attempt = attempt + 1_cint
  end
  temp_template_restore(template, start)
  return nilptr
end

-- POSIX mknodat creates a node relative to a directory descriptor.
local function mknodat(dirfd: cint, pathname: pointer <const>, mode: cuint, device: culong): cint <cexport, codename 'mknodat'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    259_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)(mode),
    (@culong)(device),
    0_culong,
    0_culong
  )))
end

-- POSIX mknod creates a node relative to the current working directory.
local function mknod(pathname: pointer <const>, mode: cuint, device: culong): cint <cexport, codename 'mknod'>
  return mknodat(-100_cint, pathname, mode, device)
end

-- Linux mkfifoat creates a FIFO with mknodat and no device number.
local function mkfifoat(dirfd: cint, pathname: pointer <const>, mode: cuint): cint <cexport, codename 'mkfifoat'>
  return mknodat(dirfd, pathname, 0x1000_cuint | mode, 0_culong)
end

-- POSIX mkfifo creates a FIFO relative to the current working directory.
local function mkfifo(pathname: pointer <const>, mode: cuint): cint <cexport, codename 'mkfifo'>
  return mkfifoat(-100_cint, pathname, mode)
end

-- POSIX chmod changes permissions on a path, following its final symlink.
local function chmod(pathname: pointer <const>, mode: cuint): cint <cexport, codename 'chmod'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    90_culong,
    (@culong)((@usize)(pathname)),
    (@culong)(mode),
    0_culong
  )))
end

-- POSIX fchmod changes permissions on an already-open descriptor.
local function fchmod(fd: cint, mode: cuint): cint <cexport, codename 'fchmod'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    91_culong,
    (@culong)(fd),
    (@culong)(mode),
    0_culong
  )))
end

-- POSIX fchmodat uses fchmodat2 when available; legacy kernels support flags=0.
local function fchmodat(dirfd: cint, pathname: pointer <const>, mode: cuint, flags: cint): cint <cexport, codename 'fchmodat'>
  local result = nelibc_raw_syscall6(
    452_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)(mode),
    (@culong)(flags),
    0_culong,
    0_culong
  )
  if result == -38_clong and flags == 0 then
    result = nelibc_raw_syscall3(
      268_culong,
      (@culong)(dirfd),
      (@culong)((@usize)(pathname)),
      (@culong)(mode)
    )
  end
  return (@cint)(syscall_result(result))
end

-- POSIX nanosecond timestamp update using the native x86_64 timespec layout.
local function utimensat(dirfd: cint, pathname: pointer <const>, timestamps: pointer <const>, flags: cint): cint <cexport, codename 'utimensat'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    280_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)((@usize)(timestamps)),
    (@culong)(flags),
    0_culong,
    0_culong
  )))
end

-- POSIX futimens uses utimensat's Linux AT_EMPTY_PATH descriptor form.
local function futimens(fd: cint, timestamps: pointer <const>): cint <cexport, codename 'futimens'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    280_culong, (@culong)(fd), (@culong)((@usize)(''_cstring)),
    (@culong)((@usize)(timestamps)), 0x1000_culong, 0_culong, 0_culong
  )))
end

local function renameat(olddirfd: cint, oldpath: pointer <const>, newdirfd: cint, newpath: pointer <const>): cint <cexport, codename 'renameat'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    264_culong, (@culong)(olddirfd), (@culong)((@usize)(oldpath)),
    (@culong)(newdirfd), (@culong)((@usize)(newpath)), 0_culong, 0_culong
  )))
end

-- POSIX rename operates between paths relative to the current directory.
local function rename(oldpath: pointer <const>, newpath: pointer <const>): cint <cexport, codename 'rename'>
  return renameat(-100_cint, oldpath, -100_cint, newpath)
end

local function linkat(olddirfd: cint, oldpath: pointer <const>, newdirfd: cint, newpath: pointer <const>, flags: cint): cint <cexport, codename 'linkat'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    265_culong, (@culong)(olddirfd), (@culong)((@usize)(oldpath)),
    (@culong)(newdirfd), (@culong)((@usize)(newpath)), (@culong)(flags), 0_culong
  )))
end

-- POSIX fchownat changes ownership relative to a directory descriptor.
local function fchownat(dirfd: cint, pathname: pointer <const>, owner: cuint, group: cuint, flags: cint): cint <cexport, codename 'fchownat'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    260_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)(owner),
    (@culong)(group),
    (@culong)(flags),
    0_culong
  )))
end

-- POSIX descriptor ownership change uses the dedicated Linux x86_64 syscall.
local function fchown(fd: cint, owner: cuint, group: cuint): cint <cexport, codename 'fchown'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    93_culong, (@culong)(fd), (@culong)(owner), (@culong)(group)
  )))
end

-- POSIX chown follows the final symlink.
local function chown(pathname: pointer <const>, owner: cuint, group: cuint): cint <cexport, codename 'chown'>
  return fchownat(-100_cint, pathname, owner, group, 0_cint)
end

-- POSIX lchown changes ownership of the symlink itself.
local function lchown(pathname: pointer <const>, owner: cuint, group: cuint): cint <cexport, codename 'lchown'>
  return fchownat(-100_cint, pathname, owner, group, 0x100_cint)
end

-- POSIX link creates a hard link relative to the current directory.
local function link(oldpath: pointer <const>, newpath: pointer <const>): cint <cexport, codename 'link'>
  return linkat(-100_cint, oldpath, -100_cint, newpath, 0_cint)
end

local function faccessat2_raw(dirfd: cint, pathname: pointer <const>, mode: cint, flags: cint): clong
  if (mode & ~7_cint) ~= 0 or (flags & ~0x1300_cint) ~= 0 then
    return -22_clong
  end
  return nelibc_raw_syscall6(
    439_culong, (@culong)(dirfd), (@culong)((@usize)(pathname)),
    (@culong)(mode), (@culong)(flags), 0_culong, 0_culong
  )
end

-- Linux faccessat2 exposes flags without the older libc emulation layer.
local function faccessat2(dirfd: cint, pathname: pointer <const>, mode: cint, flags: cint): cint <cexport, codename 'faccessat2'>
  return (@cint)(syscall_result(faccessat2_raw(dirfd, pathname, mode, flags)))
end

-- POSIX faccessat falls back to the older syscall when flags are not needed.
local function faccessat(dirfd: cint, pathname: pointer <const>, mode: cint, flags: cint): cint <cexport, codename 'faccessat'>
  local result = faccessat2_raw(dirfd, pathname, mode, flags)
  if result == -38_clong and flags == 0 then
    result = nelibc_raw_syscall3(
      269_culong, (@culong)(dirfd), (@culong)((@usize)(pathname)), (@culong)(mode)
    )
  end
  return (@cint)(syscall_result(result))
end

-- POSIX access uses the real IDs and follows the final symlink.
local function access(pathname: pointer <const>, mode: cint): cint <cexport, codename 'access'>
  return faccessat(-100_cint, pathname, mode, 0_cint)
end

-- Linux x86_64 struct stat has the same layout as glibc and musl on this ABI.
local function fstatat(dirfd: cint, pathname: pointer <const>, statbuf: pointer, flags: cint): cint <cexport, codename 'fstatat'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    262_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)((@usize)(statbuf)),
    (@culong)(flags),
    0_culong,
    0_culong
  )))
end

-- AT_EMPTY_PATH lets the newfstatat syscall query an already-open descriptor.
local function fstat(fd: cint, statbuf: pointer): cint <cexport, codename 'fstat'>
  local empty_path: cstring = ""
  return fstatat(fd, empty_path, statbuf, 4096_cint)
end

-- AT_FDCWD selects the process working directory for a pathname lookup.
local function stat(pathname: pointer <const>, statbuf: pointer): cint <cexport, codename 'stat'>
  return fstatat(-100_cint, pathname, statbuf, 0_cint)
end

-- AT_SYMLINK_NOFOLLOW returns metadata for the link itself.
local function lstat(pathname: pointer <const>, statbuf: pointer): cint <cexport, codename 'lstat'>
  return fstatat(-100_cint, pathname, statbuf, 256_cint)
end

-- Linux statx writes the libc-neutral statx UAPI structure supplied by the caller.
local function statx(dirfd: cint, pathname: pointer <const>, flags: cint, mask: cuint, statbuf: pointer): cint <cexport, codename 'statx'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    332_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)(flags),
    (@culong)(mask),
    (@culong)((@usize)(statbuf)),
    0_culong
  )))
end

local function symlinkat(target: pointer <const>, newdirfd: cint, linkpath: pointer <const>): cint <cexport, codename 'symlinkat'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    266_culong,
    (@culong)((@usize)(target)),
    (@culong)(newdirfd),
    (@culong)((@usize)(linkpath))
  )))
end

-- POSIX symlink creates a link path relative to the current directory.
local function symlink(target: pointer <const>, linkpath: pointer <const>): cint <cexport, codename 'symlink'>
  return symlinkat(target, -100_cint, linkpath)
end

local function readlinkat(dirfd: cint, pathname: pointer <const>, buf: pointer, bufsiz: csize): clong <cexport, codename 'readlinkat'>
  return syscall_result(nelibc_raw_syscall6(
    267_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)((@usize)(buf)),
    (@culong)(bufsiz),
    0_culong,
    0_culong
  ))
end

-- POSIX readlink uses the current working directory for its pathname.
local function readlink(pathname: pointer <const>, buf: pointer, bufsiz: csize): clong <cexport, codename 'readlink'>
  return readlinkat(-100_cint, pathname, buf, bufsiz)
end

-- This syscall layer targets Linux x86_64, whose base page size is 4 KiB.
local function getpagesize(): cint <cexport, codename 'getpagesize'>
  return 4096_cint
end

local function nelibc_affinity_cpu_count(): clong
  local saved_errno = nelibc_errno_location()[0]
  local mask: [4096]byte = {1}
  local size: csize = 128
  local result: clong = -1_clong
  while true do
    result = syscall_result(nelibc_raw_syscall3(
      204_culong, 0_culong, (@culong)(size), (@culong)((@usize)(&mask))
    ))
    if result >= 0 then break end
    if nelibc_errno_location()[0] ~= 22_cint or size >= 4096 then break end
    size = size * 2
  end

  local count: clong = 0
  if result < 0 then
    count = 1_clong
  else
    local index: csize = 0
    while index < (@csize)(result) do
      local bits = mask[index]
      while bits ~= 0 do
        count = count + 1_clong
        bits = bits & (bits - 1)
      end
      index = index + 1
    end
    if count == 0 then count = 1_clong end
  end
  nelibc_errno_location()[0] = saved_errno
  return count
end

-- Linux x86_64 sysinfo supplies RAM totals in mem_unit-sized units.
local function nelibc_sysconf_memory_pages(selector: cint): clong <inline>
  local saved_errno = nelibc_errno_location()[0]
  local info: Sysinfo = {
    uptime = 0_clong, loads = {0_culong, 0_culong, 0_culong},
    totalram = 0_culong, freeram = 0_culong, sharedram = 0_culong,
    bufferram = 0_culong, totalswap = 0_culong, freeswap = 0_culong,
    procs = 0_cushort, pad = 0_cushort, totalhigh = 0_culong,
    freehigh = 0_culong, mem_unit = 0_cuint
  }
  local result = syscall_result(nelibc_raw_syscall3(
    99_culong, (@culong)((@usize)(&info)), 0_culong, 0_culong
  ))
  if result < 0 then return -1_clong end
  local amount: culong = info.totalram
  if selector == 86 then
    amount = info.freeram + info.bufferram
  end
  local unit = (@culong)(info.mem_unit)
  if unit == 0 then unit = 1_culong end
  local quotient: culong = amount // 4096_culong
  local remainder: culong = amount % 4096_culong
  local longmax: culong = 9223372036854775807_culong
  if quotient > longmax // unit then
    nelibc_errno_location()[0] = saved_errno
    return 9223372036854775807_clong
  end
  local pages: culong = quotient * unit
  local fraction: culong = (remainder * unit) // 4096_culong
  if fraction > longmax - pages then
    pages = longmax
  else
    pages = pages + fraction
  end
  nelibc_errno_location()[0] = saved_errno
  return (@clong)(pages)
end

-- POSIX sysconf selectors use the Linux/glibc/musl ABI values.
-- confstr currently implements the POSIX default executable search path.
local function confstr(name: cint, buffer: pointer, length: csize): csize <cexport, codename 'confstr'>
  if name ~= 0 then
    nelibc_errno_location()[0] = 22_cint -- EINVAL: unsupported/invalid selector
    return 0_csize
  end
  local path: *[0]cchar <const> = '/bin:/usr/bin'
  local required: csize = 14_csize -- includes the terminating NUL
  if buffer ~= nilptr and length > 0_csize then
    local copy_length = length
    if copy_length > required then copy_length = required end
    memcpy(buffer, (@pointer)(path), copy_length)
    if copy_length < required then
      local output = (@*[0]cchar)(buffer)
      output[copy_length - 1_csize] = 0_cchar
    end
  end
  return required
end

-- Linux x86_64 statfs ABI. f_namelen is filesystem-specific and backs _PC_NAME_MAX.
local Statfs: type = @record{
  f_type: clong, f_bsize: clong,
  f_blocks: culong, f_bfree: culong, f_bavail: culong,
  f_files: culong, f_ffree: culong,
  f_fsid: [2]cint, f_namelen: clong, f_frsize: clong,
  f_flags: clong, f_spare: [4]clong
}

-- Linux x86_64 struct stat layout, used to determine _PC_ASYNC_IO file types.
local FileStat: type = @record{
  st_dev: uint64, st_ino: uint64, st_nlink: uint64,
  st_mode: cuint, st_uid: cuint, st_gid: cuint, st_pad0: cint,
  st_rdev: uint64, st_size: clong, st_blksize: clong, st_blocks: clong,
  st_atime: clong, st_atime_nsec: clong, st_mtime: clong,
  st_mtime_nsec: clong, st_ctime: clong, st_ctime_nsec: clong,
  st_reserved: [3]clong
}

local function nelibc_pathconf_value(name: cint, target: pointer, fd: cint,
                                     by_fd: boolean): clong <inline>
  -- Linux x86_64 uses the same _PC_* selector values in glibc and musl.
  if name < 0 or name > 20 then
    nelibc_errno_location()[0] = 22_cint
    return -1_clong
  end
  -- These Linux values do not depend on filesystem metadata; glibc/musl
  -- answer them without issuing statfs and retain that low-cost path.
  if name == 1 or name == 2 then return 255_clong end
  if name == 4 or name == 5 then return 4096_clong end
  if name == 7 then return 1_clong end
  if name == 8 then return 0_clong end
  if name == 9 or name == 11 or name == 12 or name == 14 or name == 15 or name == 19 then
    return -1_clong -- indeterminate/not supported on Linux
  end
  if name == 20 then return 1_clong end -- _PC_2_SYMLINKS
  local status: FileStat = {
    st_dev = 0_u64, st_ino = 0_u64, st_nlink = 0_u64,
    st_mode = 0_cuint, st_uid = 0_cuint, st_gid = 0_cuint, st_pad0 = 0_cint,
    st_rdev = 0_u64, st_size = 0_clong, st_blksize = 0_clong, st_blocks = 0_clong,
    st_atime = 0_clong, st_atime_nsec = 0_clong, st_mtime = 0_clong,
    st_mtime_nsec = 0_clong, st_ctime = 0_clong, st_ctime_nsec = 0_clong,
    st_reserved = {0_clong, 0_clong, 0_clong}
  }
  if name == 10 then -- _PC_ASYNC_IO is supported only for regular/block devices.
    local stat_result: clong = -1_clong
    if by_fd then
      stat_result = syscall_result(nelibc_raw_syscall3(
        5_culong, (@culong)(fd), (@culong)((@usize)(&status)), 0_culong
      ))
    else
      stat_result = syscall_result(nelibc_raw_syscall3(
        4_culong, (@culong)((@usize)(target)), (@culong)((@usize)(&status)), 0_culong
      ))
    end
    if stat_result < 0 then return -1_clong end
    local kind = status.st_mode & 0xF000_cuint
    if kind == 0x8000_cuint or kind == 0x6000_cuint then return 1_clong end
    return -1_clong
  end
  if name == 13 then -- _PC_FILESIZEBITS varies by filesystem type.
    local fs_for_size: Statfs = {
      f_type = 0_clong, f_bsize = 0_clong,
      f_blocks = 0_culong, f_bfree = 0_culong, f_bavail = 0_culong,
      f_files = 0_culong, f_ffree = 0_culong, f_fsid = {0_cint, 0_cint},
      f_namelen = 0_clong, f_frsize = 0_clong, f_flags = 0_clong,
      f_spare = {0_clong, 0_clong, 0_clong, 0_clong}
    }
    local fs_result: clong = -1_clong
    if by_fd then
      fs_result = syscall_result(nelibc_raw_syscall3(
        138_culong, (@culong)(fd), (@culong)((@usize)(&fs_for_size)), 0_culong
      ))
    else
      fs_result = syscall_result(nelibc_raw_syscall3(
        137_culong, (@culong)((@usize)(target)), (@culong)((@usize)(&fs_for_size)), 0_culong
      ))
    end
    if fs_result < 0 then return -1_clong end
    if fs_for_size.f_type == 0x9123683E_clong then return 255_clong end -- Btrfs
    if fs_for_size.f_type == 0xEF53_clong or fs_for_size.f_type == 0x3153464A_clong or
        fs_for_size.f_type == 0x58465342_clong or fs_for_size.f_type == 0xFF534D42_clong or
        fs_for_size.f_type == 0x5346544E_clong or fs_for_size.f_type == 0x15013346_clong or
        fs_for_size.f_type == 0x27E0EB_clong or fs_for_size.f_type == 0x00011954_clong or
        fs_for_size.f_type == 0x54190100_clong or fs_for_size.f_type == 0x52654973_clong or
        fs_for_size.f_type == 0xA501FCF5_clong then return 64_clong end
    return 32_clong
  end
  local fs: Statfs = {
    f_type = 0_clong, f_bsize = 0_clong,
    f_blocks = 0_culong, f_bfree = 0_culong, f_bavail = 0_culong,
    f_files = 0_culong, f_ffree = 0_culong, f_fsid = {0_cint, 0_cint},
    f_namelen = 0_clong, f_frsize = 0_clong, f_flags = 0_clong,
    f_spare = {0_clong, 0_clong, 0_clong, 0_clong}
  }
  local result: clong = -1_clong
  if by_fd then
    result = syscall_result(nelibc_raw_syscall3(
      138_culong, (@culong)(fd), (@culong)((@usize)(&fs)), 0_culong
    ))
  else
    result = syscall_result(nelibc_raw_syscall3(
      137_culong, (@culong)((@usize)(target)), (@culong)((@usize)(&fs)), 0_culong
    ))
  end
  if result < 0 then return -1_clong end
  if name == 0 then -- Linux filesystem-specific link-count limits.
    if fs.f_type == 0x9123683E_clong then return 65535_clong end -- Btrfs
    if fs.f_type == 0xEF53_clong then return 65000_clong end -- ext2/3/4
    if fs.f_type == 0x58465342_clong then return 2147483647_clong end -- XFS
    return 127_clong
  end
  if name == 3 then return fs.f_namelen end -- _PC_NAME_MAX
  if name == 6 then return 1_clong end -- _PC_CHOWN_RESTRICTED
  if name == 16 then return fs.f_bsize end -- _PC_REC_MIN_XFER_SIZE
  if name == 17 or name == 18 then return fs.f_frsize end
  return -1_clong -- _PC_REC_INCR_XFER_SIZE / _PC_REC_MAX_XFER_SIZE
end

local function pathconf(pathname: pointer <const>, name: cint): clong <cexport, codename 'pathconf'>
  return nelibc_pathconf_value(name, (@pointer)(pathname), -1_cint, false)
end

local function fpathconf(fd: cint, name: cint): clong <cexport, codename 'fpathconf'>
  return nelibc_pathconf_value(name, nilptr, fd, true)
end

local function sysconf(name: cint): clong <cexport, codename 'sysconf'>
  if name == 0 then -- _SC_ARG_MAX follows one quarter of RLIMIT_STACK, capped by Linux.
    local limit: Rlimit = {rlim_cur = 0_culong, rlim_max = 0_culong}
    if getrlimit(3_cint, (@pointer)(&limit)) ~= 0 then return -1_clong end
    local value = limit.rlim_cur / 4_culong
    if value < 131072_culong then value = 131072_culong end
    if value > 6291456_culong then value = 6291456_culong end
    return (@clong)(value)
  end
  if name == 1 or name == 4 or name == 34 then -- process, fd, and queued-signal limits
    local resource: cint = 7_cint
    if name == 1 then resource = 6_cint end
    if name == 34 then resource = 11_cint end -- RLIMIT_SIGPENDING
    local limit: Rlimit = {rlim_cur = 0_culong, rlim_max = 0_culong}
    if getrlimit(resource, (@pointer)(&limit)) ~= 0 then return -1_clong end
    if limit.rlim_cur == (-1_culong) then return -1_clong end
    return (@clong)(limit.rlim_cur)
  end
  if name == 2 then return 100_clong end -- _SC_CLK_TCK
  if name == 3 then return 65536_clong end -- Linux supplementary groups
  if name == 5 then return 16_clong end -- _SC_STREAM_MAX
  if name == 6 then return -1_clong end -- _SC_TZNAME_MAX is indeterminate
  if name == 7 or name == 8 then return 1_clong end -- JOB_CONTROL, SAVED_IDS
  if name == 9 or name == 11 or name == 12 or
      (name >= 15 and name <= 22) then return 200809_clong end
  if name == 10 then return -1_clong end -- POSIX process priority scheduling is incomplete
  if name == 13 or name == 14 or name == 23 or name == 24 or
      name == 27 or name == 32 or name == 35 then return -1_clong end
  if name == 25 then return 0_clong end -- _SC_AIO_PRIO_DELTA_MAX
  if name == 26 or name == 33 then return 2147483647_clong end
  if name == 28 then return 32768_clong end -- _SC_MQ_PRIO_MAX
  if name == 29 then return 200809_clong end -- _SC_VERSION
  if name == 30 then return 4096_clong end -- _SC_PAGESIZE
  if name == 31 then return 30_clong end -- _SC_RTSIG_MAX
  if name == 36 then return 99_clong end -- _SC_BC_BASE_MAX
  if name == 37 then return 2048_clong end -- _SC_BC_DIM_MAX
  if name == 38 then return 99_clong end -- _SC_BC_SCALE_MAX
  if name == 39 then return 1000_clong end -- _SC_BC_STRING_MAX
  if name == 40 then return 255_clong end -- _SC_COLL_WEIGHTS_MAX
  if name == 42 or name == 43 then return -1_clong end
  if name == 44 then return 32767_clong end -- _SC_RE_DUP_MAX
  if name == 46 or name == 47 then return 200809_clong end
  if name >= 48 and name <= 52 then return -1_clong end
  if name == 60 then return 1024_clong end -- _SC_IOV_MAX
  if name == 67 or name == 68 then return 200809_clong end -- thread support
  if name == 69 or name == 70 or name == 76 then return -1_clong end
  if name == 71 then return 256_clong end -- _SC_LOGIN_NAME_MAX
  if name == 72 then return 32_clong end -- _SC_TTY_NAME_MAX
  if name == 73 then return 4_clong end -- _SC_THREAD_DESTRUCTOR_ITERATIONS
  if name == 74 then return 1024_clong end -- _SC_THREAD_KEYS_MAX
  if name == 75 then return 16384_clong end -- _SC_THREAD_STACK_MIN
  if name == 77 or name == 78 or name == 82 then
    return 200809_clong
  end
  if name == 79 then return -1_clong end -- POSIX thread priority scheduling is incomplete
  if name == 80 or name == 81 then return -1_clong end
  if name == 87 or name == 88 then return -1_clong end
  if name == 89 or name == 90 then return 700_clong end -- XSI version
  if name == 91 or name == 93 or name == 94 then return 1_clong end
  if name == 92 or name == 95 or (name >= 97 and name <= 100) then
    return -1_clong
  end
  if name == 109 then return 20_clong end -- _SC_NZERO
  if name == 125 or name == 126 or name == 128 or
      (name >= 129 and name <= 131) then return -1_clong end
  if name == 127 then return 1_clong end -- _SC_XBS5_LP64_OFF64
  if name == 132 or name == 133 then return 200809_clong end
  if name == 137 or name == 138 or name == 139 or name == 149 or
      name == 153 or name == 154 or name == 159 or name == 164 then
    return 200809_clong
  end
  if name == 155 or name == 157 then return 1_clong end
  if name == 173 then return -1_clong end -- _SC_SYMLOOP_MAX is filesystem-dependent
  if name == 160 or name == 161 or name == 165 then return -1_clong end
  if name == 174 then return 0_clong end -- STREAMS are not supported
  if name == 180 then return 64_clong end -- _SC_HOST_NAME_MAX
  if name >= 181 and name <= 184 then return -1_clong end
  if name == 235 or name == 236 then return 200809_clong end -- IPv6/raw sockets
  if name >= 237 and name <= 240 then
    if name == 239 then return 1_clong end -- _SC_V7_LP64_OFF64
    return -1_clong
  end
  if name >= 241 and name <= 245 then return -1_clong end
  if name == 246 then return 0_clong end -- _SC_XOPEN_STREAMS
  if name == 247 or name == 248 then return -1_clong end
  if name == 83 or name == 84 then -- _SC_NPROCESSORS_CONF / _SC_NPROCESSORS_ONLN
    return nelibc_affinity_cpu_count()
  end
  if name == 85 or name == 86 then return nelibc_sysconf_memory_pages(name) end
  nelibc_errno_location()[0] = 22_cint -- EINVAL: unsupported/invalid selector
  return -1_clong
end

-- The Linux syscall returns a length; POSIX getcwd returns the supplied buffer.
local function getcwd(buf: pointer, size: csize): pointer <cexport, codename 'getcwd'>
  if size == 0 then
    nelibc_errno_location()[0] = 22
    return nilptr
  end
  if size < 2 then
    nelibc_errno_location()[0] = 34
    return nilptr
  end
  local result = syscall_result(nelibc_raw_syscall3(
    79_culong,
    (@culong)((@usize)(buf)),
    (@culong)(size),
    0_culong
  ))
  if result < 0 then
    -- Linux reports ENAMETOOLONG for a short syscall buffer; POSIX requires ERANGE.
    if size < 4096 and nelibc_errno_location()[0] == 36 then
      nelibc_errno_location()[0] = 34
    end
    return nilptr
  end
  return buf
end

local function get_current_dir_name(): *[0]cchar <cexport, codename 'get_current_dir_name'>
  local size: csize = 128_csize
  while true do
    local buffer = (@*[0]cchar)(malloc(size))
    if buffer == nilptr then
      nelibc_errno_location()[0] = 12_cint -- ENOMEM
      return nilptr
    end
    if getcwd((@pointer)(buffer), size) ~= nilptr then return buffer end
    local error_number = nelibc_errno_location()[0]
    free((@pointer)(buffer))
    if error_number ~= 34_cint then -- ERANGE
      nelibc_errno_location()[0] = error_number
      return nilptr
    end
    if size > 0x7fffffffffffffff_csize // 2_csize then
      nelibc_errno_location()[0] = 12_cint -- ENOMEM
      return nilptr
    end
    size = size * 2_csize
  end
end

local function chdir(pathname: pointer <const>): cint <cexport, codename 'chdir'>
  local result = nelibc_raw_syscall3(
    80_culong,
    (@culong)((@usize)(pathname)),
    0_culong,
    0_culong
  )
  return (@cint)(syscall_result(result))
end

local function fchdir(fd: cint): cint <cexport, codename 'fchdir'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    81_culong,
    (@culong)(fd),
    0_culong,
    0_culong
  )))
end

local Dirent64: type = @record{
  d_ino: uint64,
  d_off: clong,
  d_reclen: cushort,
  d_type: byte,
  d_name: [256]byte
}

local DIRStream: type = @record{
  fd: cint,
  length: csize,
  position: csize,
  location: clong,
  buffer: [8192]byte
}

local DIRENT_BUFFER_SIZE: csize <comptime> = 8192

local function nelibc_dir_fill(stream: *DIRStream): cint <inline>
  local result = syscall_result(nelibc_raw_syscall3(
    217_culong, (@culong)(stream.fd), (@culong)((@usize)(&stream.buffer[0])),
    (@culong)(DIRENT_BUFFER_SIZE)
  ))
  if result < 0 then return -1 end
  stream.length = (@csize)(result)
  stream.position = 0
  return 0
end

local function nelibc_dir_stream_create(fd: cint): pointer <inline>
  local stream = (@*DIRStream)(malloc((@csize)(#DIRStream)))
  if stream == nilptr then return nilptr end
  stream.fd = fd
  stream.length = 0
  stream.position = 0
  stream.location = 0
  return (@pointer)(stream)
end

local function fdopendir(fd: cint): pointer <cexport, codename 'fdopendir'>
  local descriptor_flags = nelibc_raw_fcntl(fd, 3_cint, 0_culong) -- F_GETFL
  if descriptor_flags < 0 then return nilptr end
  if (descriptor_flags & 0x200001_cint) ~= 0 then -- O_PATH or O_WRONLY
    nelibc_errno_location()[0] = 9_cint -- EBADF
    return nilptr
  end
  local status: FileStat
  if fstat(fd, (@pointer)(&status)) ~= 0 then return nilptr end
  if (status.st_mode & 0xF000_cuint) ~= 0x4000_cuint then
    nelibc_errno_location()[0] = 20_cint -- ENOTDIR
    return nilptr
  end
  return nelibc_dir_stream_create(fd)
end

local function opendir(pathname: *[0]cchar <const>): pointer <cexport, codename 'opendir'>
  local fd = open((@pointer)(pathname), 0x90000_cint, 0_cuint) -- O_DIRECTORY|O_CLOEXEC
  if fd < 0 then return nilptr end
  -- open's O_DIRECTORY|O_RDONLY flags already validate this descriptor.
  local stream = nelibc_dir_stream_create(fd)
  if stream == nilptr then
    local saved_errno = nelibc_errno_location()[0]
    close(fd)
    nelibc_errno_location()[0] = saved_errno
  end
  return stream
end

local function readdir(dirp: pointer): pointer <cexport, codename 'readdir'>
  if dirp == nilptr then
    nelibc_errno_location()[0] = 9_cint -- EBADF
    return nilptr
  end
  local stream = (@*DIRStream)(dirp)
  if stream.position >= stream.length then
    if nelibc_dir_fill(stream) < 0 then return nilptr end
    if stream.length == 0 then return nilptr end
  end
  local remaining = stream.length - stream.position
  if remaining < 19_csize then
    nelibc_errno_location()[0] = 5_cint -- EIO
    return nilptr
  end
  local address = (@usize)(&stream.buffer[0]) + (@usize)(stream.position)
  local entry = (@*Dirent64)(address)
  local record_length = (@csize)(entry.d_reclen)
  if record_length < 20_csize or record_length > 280_csize or record_length > remaining then
    nelibc_errno_location()[0] = 5_cint -- EIO
    return nilptr
  end
  -- getdents64 guarantees a NUL-terminated d_name of at most 255 bytes.
  stream.position = stream.position + record_length
  stream.location = entry.d_off
  return (@pointer)(entry)
end

local function closedir(dirp: pointer): cint <cexport, codename 'closedir'>
  if dirp == nilptr then
    nelibc_errno_location()[0] = 9_cint -- EBADF
    return -1
  end
  local stream = (@*DIRStream)(dirp)
  local result = close(stream.fd)
  local saved_errno = nelibc_errno_location()[0]
  free(dirp)
  if result < 0 then nelibc_errno_location()[0] = saved_errno end
  return result
end

local function dirfd(dirp: pointer): cint <cexport, codename 'dirfd'>
  if dirp == nilptr then
    nelibc_errno_location()[0] = 9_cint -- EBADF
    return -1
  end
  return (@*DIRStream)(dirp).fd
end

local function rewinddir(dirp: pointer): void <cexport, codename 'rewinddir'>
  if dirp == nilptr then return end
  local stream = (@*DIRStream)(dirp)
  if lseek(stream.fd, 0_clong, 0_cint) >= 0 then
    stream.length = 0
    stream.position = 0
    stream.location = 0
  end
end

local function telldir(dirp: pointer): clong <cexport, codename 'telldir'>
  if dirp == nilptr then
    nelibc_errno_location()[0] = 9_cint -- EBADF
    return -1
  end
  return (@*DIRStream)(dirp).location
end

local function seekdir(dirp: pointer, location: clong): void <cexport, codename 'seekdir'>
  if dirp == nilptr then return end
  local stream = (@*DIRStream)(dirp)
  if lseek(stream.fd, location, 0_cint) >= 0 then
    stream.length = 0
    stream.position = 0
    stream.location = location
  end
end

local function alphasort(left: pointer, right: pointer): cint <cexport, codename 'alphasort'>
  local left_slot: *[0]*Dirent64 = (@*[0]*Dirent64)(left)
  local right_slot: *[0]*Dirent64 = (@*[0]*Dirent64)(right)
  local left_entry = left_slot[0]
  local right_entry = right_slot[0]
  return strcoll(
    (@*[0]cchar)(&left_entry.d_name[0]),
    (@*[0]cchar)(&right_entry.d_name[0])
  )
end

local function versionsort(left: pointer, right: pointer): cint <cexport, codename 'versionsort'>
  local left_slot: *[0]*Dirent64 = (@*[0]*Dirent64)(left)
  local right_slot: *[0]*Dirent64 = (@*[0]*Dirent64)(right)
  local left_entry = left_slot[0]
  local right_entry = right_slot[0]
  return strverscmp(
    (@*[0]cchar)(&left_entry.d_name[0]),
    (@*[0]cchar)(&right_entry.d_name[0])
  )
end

local function nelibc_scandir_free(entries: *[0]pointer, count: csize): void <inline>
  local index: csize = 0
  while index < count do
    free(entries[index])
    index = index + 1
  end
  free((@pointer)(entries))
end

local function nelibc_scandir_stream(directory: pointer, namelist: *[0]pointer,
    selector: function(pointer): cint,
    compare: function(pointer, pointer): cint): cint <inline>
  local capacity: csize = 16
  local entries = (@*[0]pointer)(malloc(capacity * 8_csize))
  if entries == nilptr then
    local saved_errno = nelibc_errno_location()[0]
    closedir(directory)
    nelibc_errno_location()[0] = saved_errno
    return -1
  end

  local count: csize = 0
  while true do
    nelibc_errno_location()[0] = 0
    local entry = readdir(directory)
    if entry == nilptr then
      if nelibc_errno_location()[0] ~= 0 then
        local saved_errno = nelibc_errno_location()[0]
        closedir(directory)
        nelibc_scandir_free(entries, count)
        nelibc_errno_location()[0] = saved_errno
        return -1
      end
      break
    end
    if selector == nilptr or selector(entry) ~= 0 then
      if count == 2147483647_csize then
        nelibc_errno_location()[0] = 75_cint -- EOVERFLOW
        local saved_errno = nelibc_errno_location()[0]
        closedir(directory)
        nelibc_scandir_free(entries, count)
        nelibc_errno_location()[0] = saved_errno
        return -1
      end
      if count == capacity then
        if capacity > 1073741823_csize then
          nelibc_errno_location()[0] = 75_cint -- EOVERFLOW
          local saved_errno = nelibc_errno_location()[0]
          closedir(directory)
          nelibc_scandir_free(entries, count)
          nelibc_errno_location()[0] = saved_errno
          return -1
        end
        capacity = capacity * 2
        local expanded = (@*[0]pointer)(realloc((@pointer)(entries), capacity * 8_csize))
        if expanded == nilptr then
          local saved_errno = nelibc_errno_location()[0]
          closedir(directory)
          nelibc_scandir_free(entries, count)
          nelibc_errno_location()[0] = saved_errno
          return -1
        end
        entries = expanded
      end
      local copy = malloc(280_csize)
      if copy == nilptr then
        local saved_errno = nelibc_errno_location()[0]
        closedir(directory)
        nelibc_scandir_free(entries, count)
        nelibc_errno_location()[0] = saved_errno
        return -1
      end
      memset(copy, 0, 280_csize)
      memcpy(copy, entry, (@csize)((@*Dirent64)(entry).d_reclen))
      entries[count] = copy
      count = count + 1
    end
  end

  if closedir(directory) ~= 0 then
    local saved_errno = nelibc_errno_location()[0]
    nelibc_scandir_free(entries, count)
    nelibc_errno_location()[0] = saved_errno
    return -1
  end
  if compare ~= nilptr and count > 1 then
    qsort((@pointer)(entries), count, 8_csize, compare)
  end
  namelist[0] = (@pointer)(entries)
  return (@cint)(count)
end

local function scandir(pathname: *[0]cchar <const>, namelist: *[0]pointer,
    selector: function(pointer): cint,
    compare: function(pointer, pointer): cint): cint <cexport, codename 'scandir'>
  if pathname == nilptr or namelist == nilptr then
    nelibc_errno_location()[0] = 22_cint -- EINVAL
    return -1
  end
  namelist[0] = nilptr
  local directory = opendir(pathname)
  if directory == nilptr then return -1 end
  return nelibc_scandir_stream(directory, namelist, selector, compare)
end

local function scandirat(dirfd: cint, pathname: *[0]cchar <const>, namelist: *[0]pointer,
    selector: function(pointer): cint,
    compare: function(pointer, pointer): cint): cint <cexport, codename 'scandirat'>
  if pathname == nilptr or namelist == nilptr then
    nelibc_errno_location()[0] = 22_cint -- EINVAL
    return -1
  end
  namelist[0] = nilptr
  local fd = openat(dirfd, (@pointer)(pathname), 0x90000_cint, 0_cuint)
  if fd < 0 then return -1 end
  local directory = fdopendir(fd)
  if directory == nilptr then
    local saved_errno = nelibc_errno_location()[0]
    close(fd)
    nelibc_errno_location()[0] = saved_errno
    return -1
  end
  return nelibc_scandir_stream(directory, namelist, selector, compare)
end

-- realpath resolves dot components and symlinks using only Nelibc path calls.
local function realpath(pathname: *[0]cchar <const>, resolved_path: *[0]cchar): *[0]cchar <cexport, codename 'realpath'>
  if pathname == nilptr then
    nelibc_errno_location()[0] = 22 -- EINVAL
    return nilptr
  end
  local path_length: csize = 0
  while pathname[path_length] ~= 0 do
    path_length = path_length + 1
    if path_length >= 4096 then
      nelibc_errno_location()[0] = 36 -- ENAMETOOLONG
      return nilptr
    end
  end
  if path_length == 0 then
    nelibc_errno_location()[0] = 2 -- ENOENT
    return nilptr
  end

  local work: [4096]cchar
  local resolved: [4096]cchar
  local link_target: [4096]cchar
  local remainder: [4096]cchar
  local work_length: csize = 0
  if pathname[0] == 47 then
    local index: csize = 0
    while index < path_length do
      work[index] = pathname[index]
      index = index + 1
    end
    work_length = path_length
  else
    if getcwd((@pointer)(&work[0]), 4096) == nilptr then return nilptr end
    while work[work_length] ~= 0 do work_length = work_length + 1 end
    if work_length + 1 + path_length >= 4096 then
      nelibc_errno_location()[0] = 36 -- ENAMETOOLONG
      return nilptr
    end
    work[work_length] = 47
    work_length = work_length + 1
    local index: csize = 0
    while index < path_length do
      work[work_length] = pathname[index]
      work_length = work_length + 1
      index = index + 1
    end
  end
  work[work_length] = 0
  resolved[0] = 47
  resolved[1] = 0
  local resolved_length: csize = 1
  local cursor: csize = 0
  local symlink_count: csize = 0

  while cursor < work_length do
    while cursor < work_length and work[cursor] == 47 do cursor = cursor + 1 end
    if cursor >= work_length then break end
    local component_start = cursor
    while cursor < work_length and work[cursor] ~= 47 do cursor = cursor + 1 end
    local component_end = cursor
    local component_length = component_end - component_start

    if component_length == 1 and work[component_start] == 46 then
      -- Current directory component.
    elseif component_length == 2 and work[component_start] == 46 and work[component_start + 1] == 46 then
      if resolved_length > 1 then
        resolved_length = resolved_length - 1
        while resolved_length > 1 and resolved[resolved_length - 1] ~= 47 do
          resolved_length = resolved_length - 1
        end
        if resolved_length > 1 then resolved_length = resolved_length - 1 end
        resolved[resolved_length] = 0
      end
    else
      local parent_length = resolved_length
      if resolved_length > 1 then
        if resolved_length + 1 + component_length >= 4096 then
          nelibc_errno_location()[0] = 36 -- ENAMETOOLONG
          return nilptr
        end
        resolved[resolved_length] = 47
        resolved_length = resolved_length + 1
      elseif resolved_length + component_length >= 4096 then
        nelibc_errno_location()[0] = 36 -- ENAMETOOLONG
        return nilptr
      end
      local index: csize = 0
      while index < component_length do
        resolved[resolved_length] = work[component_start + index]
        resolved_length = resolved_length + 1
        index = index + 1
      end
      resolved[resolved_length] = 0

      local saved_errno = nelibc_errno_location()[0]
      local link_length = readlink((@pointer)(&resolved[0]), (@pointer)(&link_target[0]), 4096)
      if link_length >= 0 then
        if link_length == 0 then
          nelibc_errno_location()[0] = 2 -- ENOENT
          return nilptr
        end
        if link_length >= 4096 then
          nelibc_errno_location()[0] = 36 -- ENAMETOOLONG
          return nilptr
        end
        symlink_count = symlink_count + 1
        if symlink_count > 40 then
          nelibc_errno_location()[0] = 40 -- ELOOP
          return nilptr
        end

        local remainder_length: csize = work_length - component_end
        index = 0
        while index < remainder_length do
          remainder[index] = work[component_end + index]
          index = index + 1
        end
        local separator_length: csize = 0
        if remainder_length ~= 0 and link_target[link_length - 1] ~= 47 and remainder[0] ~= 47 then
          separator_length = 1
        end
        if link_length + separator_length + remainder_length >= 4096 then
          nelibc_errno_location()[0] = 36 -- ENAMETOOLONG
          return nilptr
        end

        if link_target[0] == 47 then
          resolved_length = 1
          resolved[0] = 47
          resolved[1] = 0
        else
          resolved_length = parent_length
          resolved[resolved_length] = 0
        end
        work_length = 0
        index = 0
        while index < link_length do
          work[work_length] = link_target[index]
          work_length = work_length + 1
          index = index + 1
        end
        if separator_length ~= 0 then
          work[work_length] = 47
          work_length = work_length + 1
        end
        index = 0
        while index < remainder_length do
          work[work_length] = remainder[index]
          work_length = work_length + 1
          index = index + 1
        end
        work[work_length] = 0
        cursor = 0
      elseif nelibc_errno_location()[0] == 22 then
        nelibc_errno_location()[0] = saved_errno
        local continuation = component_end
        local needs_directory: boolean = false
        while continuation < work_length do
          if work[continuation] ~= 47 then needs_directory = true; break end
          continuation = continuation + 1
        end
        if not needs_directory and component_end < work_length then needs_directory = true end
        if needs_directory then
          local directory_fd = openat(-100_cint, (@pointer)(&resolved[0]), 0x00290000_cint, 0_cuint)
          if directory_fd < 0 then return nilptr end
          if close(directory_fd) ~= 0 then return nilptr end
        end
      else
        return nilptr
      end
    end
  end

  if resolved_length >= 4096 then
    nelibc_errno_location()[0] = 36 -- ENAMETOOLONG
    return nilptr
  end
  resolved[resolved_length] = 0
  local output = resolved_path
  if output == nilptr then
    output = (@*[0]cchar)(malloc(4096))
    if output == nilptr then return nilptr end
  end
  local index: csize = 0
  while index <= resolved_length do
    output[index] = resolved[index]
    index = index + 1
  end
  return output
end

local function getuid(): cuint <cexport, codename 'getuid'>
  return (@cuint)(nelibc_raw_syscall3(102_culong, 0_culong, 0_culong, 0_culong))
end

local function geteuid(): cuint <cexport, codename 'geteuid'>
  return (@cuint)(nelibc_raw_syscall3(107_culong, 0_culong, 0_culong, 0_culong))
end

local function getgid(): cuint <cexport, codename 'getgid'>
  return (@cuint)(nelibc_raw_syscall3(104_culong, 0_culong, 0_culong, 0_culong))
end

local function getegid(): cuint <cexport, codename 'getegid'>
  return (@cuint)(nelibc_raw_syscall3(108_culong, 0_culong, 0_culong, 0_culong))
end

-- Linux getresuid writes the real, effective, and saved user IDs.
local function getresuid(real_uid: pointer, effective_uid: pointer, saved_uid: pointer): cint <cexport, codename 'getresuid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    118_culong,
    (@culong)((@usize)(real_uid)),
    (@culong)((@usize)(effective_uid)),
    (@culong)((@usize)(saved_uid))
  )))
end

-- Direct syscall fallbacks used by hybrid credential adapters and standalone.
local function nelibc_raw_setuid(uid: cuint): cint <cexport, codename 'nelibc_raw_setuid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(105_culong, (@culong)(uid), 0_culong, 0_culong)))
end

local function nelibc_raw_seteuid(uid: cuint): cint <cexport, codename 'nelibc_raw_seteuid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(117_culong, ~0_culong, (@culong)(uid), ~0_culong)))
end

local function nelibc_raw_setresuid(real_uid: cuint, effective_uid: cuint, saved_uid: cuint): cint <cexport, codename 'nelibc_raw_setresuid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    117_culong,
    (@culong)(real_uid),
    (@culong)(effective_uid),
    (@culong)(saved_uid)
  )))
end

-- Linux setreuid accepts (uid_t)-1 to preserve either identity.
local function nelibc_raw_setreuid(real_uid: cuint, effective_uid: cuint): cint <cexport, codename 'nelibc_raw_setreuid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    113_culong, (@culong)(real_uid), (@culong)(effective_uid), 0_culong
  )))
end

-- Linux getresgid writes the real, effective, and saved group IDs.
local function getresgid(real_gid: pointer, effective_gid: pointer, saved_gid: pointer): cint <cexport, codename 'getresgid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    120_culong,
    (@culong)((@usize)(real_gid)),
    (@culong)((@usize)(effective_gid)),
    (@culong)((@usize)(saved_gid))
  )))
end

-- The effective-only and full group-ID fallbacks mirror Linux setter syscalls.
local function nelibc_raw_setgid(gid: cuint): cint <cexport, codename 'nelibc_raw_setgid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(106_culong, (@culong)(gid), 0_culong, 0_culong)))
end

local function nelibc_raw_setegid(gid: cuint): cint <cexport, codename 'nelibc_raw_setegid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(119_culong, ~0_culong, (@culong)(gid), ~0_culong)))
end

local function nelibc_raw_setresgid(real_gid: cuint, effective_gid: cuint, saved_gid: cuint): cint <cexport, codename 'nelibc_raw_setresgid'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    119_culong,
    (@culong)(real_gid),
    (@culong)(effective_gid),
    (@culong)(saved_gid)
  )))
