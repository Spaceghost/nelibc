## pragmas.nogc = true
## pragmas.noentrypoint = true

-- POSIX adaptation of the raw Linux x86_64 syscall. errno comes from the host
-- libc during bootstrap; this dependency goes away when nelibc owns TLS errno.
local function nelibc_raw_syscall3(number: culong, arg1: culong, arg2: culong, arg3: culong): clong <cimport> end
local function nelibc_raw_syscall6(number: culong, arg1: culong, arg2: culong, arg3: culong, arg4: culong, arg5: culong, arg6: culong): clong <cimport> end
local function nelibc_errno_location(): *[0]cint <cimport> end
local function malloc(size: csize): pointer <cimport> end
local function free(ptr: pointer): void <cimport> end
local function realloc(ptr: pointer, size: csize): pointer <cimport> end
local function memcpy(dest: pointer, src: pointer <const>, size: csize): pointer <cimport> end
local function memset(dest: pointer, value: cint, size: csize): pointer <cimport> end
local function getenv(name: *[0]cchar <const>): *[0]cchar <cimport> end
local function nelibc_environment_vector(): **cchar <cimport> end
local function snprintf(buffer: *[0]cchar, max_size: csize,
    format: *[0]cchar <const>, ...): cint <cimport> end
local function qsort(base: pointer, count: csize, width: csize,
    compare: function(pointer, pointer): cint): void <cimport> end
local function strcoll(left: *[0]cchar <const>, right: *[0]cchar <const>): cint <cimport> end
local function strverscmp(left: *[0]cchar <const>, right: *[0]cchar <const>): cint <cimport> end
local function nelibc_cancellation_enter(): cint <cimport> end
local function nelibc_cancellation_leave(previous_type: cint): void <cimport> end
local function nelibc_cancellable_syscall3(number: culong, arg1: culong, arg2: culong, arg3: culong): clong <cimport> end
local function nelibc_cancellable_syscall6(number: culong, arg1: culong, arg2: culong, arg3: culong, arg4: culong, arg5: culong, arg6: culong): clong <cimport> end
local function nelibc_atfork_lock_try(value: *[0]cint): cint <cimport> end
local function nelibc_atfork_lock_reset(value: *[0]cint): void <cimport> end

local AtforkHandler: type = @record{
  prepare: pointer,
  parent: pointer,
  child: pointer,
  previous: *AtforkHandler,
  next: *AtforkHandler
}
local atfork_handlers_first: *AtforkHandler = nilptr
local atfork_handlers_last: *AtforkHandler = nilptr
local atfork_handlers_lock: cint = 0

local function atfork_handlers_lock_acquire(): void <inline>
  while nelibc_atfork_lock_try(&atfork_handlers_lock) == 0 do
    nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&atfork_handlers_lock)),
                        128_culong, 1_culong, 0_culong, 0_culong, 0_culong)
  end
end

local function atfork_handlers_lock_release(): void <inline>
  nelibc_atfork_lock_reset(&atfork_handlers_lock)
  nelibc_raw_syscall6(202_culong, (@culong)((@usize)(&atfork_handlers_lock)),
                      129_culong, 1_culong, 0_culong, 0_culong, 0_culong)
end

local function pthread_atfork(prepare: pointer, parent: pointer, child: pointer): cint <cexport, codename 'pthread_atfork'>
  local handler = (@*AtforkHandler)(malloc(40_csize)) -- five pointers on Linux x86_64
  if handler == nilptr then return 12 end -- ENOMEM
  handler.prepare = prepare
  handler.parent = parent
  handler.child = child
  handler.previous = nilptr
  handler.next = nilptr
  atfork_handlers_lock_acquire()
  handler.previous = atfork_handlers_last
  if atfork_handlers_last == nilptr then
    atfork_handlers_first = handler
  else
    atfork_handlers_last.next = handler
  end
  atfork_handlers_last = handler
  atfork_handlers_lock_release()
  return 0
end

local function nelibc_atfork_prepare(): pointer
  atfork_handlers_lock_acquire()
  local snapshot = atfork_handlers_last
  atfork_handlers_lock_release()
  local handler = snapshot
  while handler ~= nilptr do
    if handler.prepare ~= nilptr then ((@function(): void)(handler.prepare))() end
    handler = handler.previous
  end
  return (@pointer)(snapshot)
end

local function nelibc_atfork_parent(snapshot: pointer): void
  local handler = atfork_handlers_first
  local last = (@*AtforkHandler)(snapshot)
  while handler ~= nilptr do
    if handler.parent ~= nilptr then ((@function(): void)(handler.parent))() end
    if handler == last then break end
    handler = handler.next
  end
end

local function nelibc_atfork_child(snapshot: pointer): void
  -- The child contains only the forking thread; release an inherited lock.
  nelibc_atfork_lock_reset(&atfork_handlers_lock)
  local handler = atfork_handlers_first
  local last = (@*AtforkHandler)(snapshot)
  while handler ~= nilptr do
    if handler.child ~= nilptr then ((@function(): void)(handler.child))() end
    if handler == last then break end
    handler = handler.next
  end
end

local function syscall_result(result: clong): clong <inline>
  if result < 0 and result >= -4095 then
    nelibc_errno_location()[0] = (@cint)(-result)
    return -1_clong
  end
  return result
end

-- Linux x86_64 provides a distinct syscall for each socket operation.
local function socket(domain: cint, socket_type: cint, protocol: cint): cint <cexport, codename 'socket'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    41_culong, (@culong)(domain), (@culong)(socket_type), (@culong)(protocol)
  )))
end

local function socketpair(domain: cint, socket_type: cint, protocol: cint, sockets: *[2]cint): cint <cexport, codename 'socketpair'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    53_culong, (@culong)(domain), (@culong)(socket_type), (@culong)(protocol),
    (@culong)((@usize)(sockets)), 0_culong, 0_culong
  )))
end

local function bind(sockfd: cint, address: pointer <const>, address_length: cuint): cint <cexport, codename 'bind'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    49_culong, (@culong)(sockfd), (@culong)((@usize)(address)), (@culong)(address_length)
  )))
end

local function connect(sockfd: cint, address: pointer <const>, address_length: cuint): cint <cexport, codename 'connect'>
  local raw_result = nelibc_cancellable_syscall3(
    42_culong, (@culong)(sockfd), (@culong)((@usize)(address)), (@culong)(address_length)
  )
  return (@cint)(syscall_result(raw_result))
end

local function listen(sockfd: cint, backlog: cint): cint <cexport, codename 'listen'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    50_culong, (@culong)(sockfd), (@culong)(backlog), 0_culong
  )))
end

local function accept(sockfd: cint, address: pointer, address_length: *[0]cuint): cint <cexport, codename 'accept'>
  local raw_result = nelibc_cancellable_syscall3(
    43_culong, (@culong)(sockfd), (@culong)((@usize)(address)),
    (@culong)((@usize)(address_length))
  )
  return (@cint)(syscall_result(raw_result))
end

local function accept4(sockfd: cint, address: pointer, address_length: *[0]cuint, flags: cint): cint <cexport, codename 'accept4'>
  local raw_result = nelibc_cancellable_syscall6(
    288_culong, (@culong)(sockfd), (@culong)((@usize)(address)),
    (@culong)((@usize)(address_length)), (@culong)(flags), 0_culong, 0_culong
  )
  return (@cint)(syscall_result(raw_result))
end

local function sendto(sockfd: cint, buffer: pointer <const>, length: csize, flags: cint, address: pointer <const>, address_length: cuint): clong <cexport, codename 'sendto'>
  local raw_result = nelibc_cancellable_syscall6(
    44_culong, (@culong)(sockfd), (@culong)((@usize)(buffer)), (@culong)(length),
    (@culong)(flags), (@culong)((@usize)(address)), (@culong)(address_length)
  )
  return syscall_result(raw_result)
end

local function recvfrom(sockfd: cint, buffer: pointer, length: csize, flags: cint, address: pointer, address_length: *[0]cuint): clong <cexport, codename 'recvfrom'>
  local raw_result = nelibc_cancellable_syscall6(
    45_culong, (@culong)(sockfd), (@culong)((@usize)(buffer)), (@culong)(length),
    (@culong)(flags), (@culong)((@usize)(address)), (@culong)((@usize)(address_length))
  )
  return syscall_result(raw_result)
end

local function send(sockfd: cint, buffer: pointer <const>, length: csize, flags: cint): clong <cexport, codename 'send'>
  return sendto(sockfd, buffer, length, flags, nilptr, 0_cuint)
end

local function recv(sockfd: cint, buffer: pointer, length: csize, flags: cint): clong <cexport, codename 'recv'>
  return recvfrom(sockfd, buffer, length, flags, nilptr, nilptr)
end

local function sendmsg(sockfd: cint, message: pointer <const>, flags: cint): clong <cexport, codename 'sendmsg'>
  local raw_result = nelibc_cancellable_syscall3(
    46_culong, (@culong)(sockfd), (@culong)((@usize)(message)), (@culong)(flags)
  )
  return syscall_result(raw_result)
end

local function recvmsg(sockfd: cint, message: pointer, flags: cint): clong <cexport, codename 'recvmsg'>
  local raw_result = nelibc_cancellable_syscall3(
    47_culong, (@culong)(sockfd), (@culong)((@usize)(message)), (@culong)(flags)
  )
  return syscall_result(raw_result)
end

local function shutdown(sockfd: cint, how: cint): cint <cexport, codename 'shutdown'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    48_culong, (@culong)(sockfd), (@culong)(how), 0_culong
  )))
end

local function getsockname(sockfd: cint, address: pointer, address_length: *[0]cuint): cint <cexport, codename 'getsockname'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    51_culong, (@culong)(sockfd), (@culong)((@usize)(address)),
    (@culong)((@usize)(address_length))
  )))
end

local function getpeername(sockfd: cint, address: pointer, address_length: *[0]cuint): cint <cexport, codename 'getpeername'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    52_culong, (@culong)(sockfd), (@culong)((@usize)(address)),
    (@culong)((@usize)(address_length))
  )))
end

local function setsockopt(sockfd: cint, level: cint, option_name: cint, option_value: pointer <const>, option_length: cuint): cint <cexport, codename 'setsockopt'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    54_culong, (@culong)(sockfd), (@culong)(level), (@culong)(option_name),
    (@culong)((@usize)(option_value)), (@culong)(option_length), 0_culong
  )))
end

local function getsockopt(sockfd: cint, level: cint, option_name: cint, option_value: pointer, option_length: *[0]cuint): cint <cexport, codename 'getsockopt'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    55_culong, (@culong)(sockfd), (@culong)(level), (@culong)(option_name),
    (@culong)((@usize)(option_value)), (@culong)((@usize)(option_length)), 0_culong
  )))
end

-- isatty uses Linux TCGETS; the kernel fills a termios structure on success.
local function isatty(fd: cint): cint <cexport, codename 'isatty'>
  local terminal_state: [64]byte
  local result = syscall_result(nelibc_raw_syscall6(
    16_culong, (@culong)(fd), 0x5401_culong,
    (@culong)((@usize)(&terminal_state[0])), 0_culong, 0_culong, 0_culong
  ))
  if result == 0 then return 1 end
  return 0
end

-- ioctl forwards its variadic third argument as the x86_64 syscall ABI word.
local function ioctl(fd: cint, request: culong, argument: pointer): cint <cexport, codename 'ioctl'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    16_culong, (@culong)(fd), request, (@culong)((@usize)(argument)),
    0_culong, 0_culong, 0_culong
  )))
end

-- Linux mount attaches a filesystem to a target path.
local function mount(source: pointer <const>, target: pointer <const>, filesystem: pointer <const>, mountflags: culong, data: pointer <const>): cint <cexport, codename 'mount'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    165_culong,
    (@culong)((@usize)(source)),
    (@culong)((@usize)(target)),
    (@culong)((@usize)(filesystem)),
    mountflags,
    (@culong)((@usize)(data)),
    0_culong
  )))
end

-- Linux umount2 detaches a mounted filesystem with optional unmount flags.
local function umount2(target: pointer <const>, flags: cint): cint <cexport, codename 'umount2'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    166_culong,
    (@culong)((@usize)(target)),
    (@culong)(flags),
    0_culong
  )))
end

-- umount is the flags-zero form of umount2.
local function umount(target: pointer <const>): cint <cexport, codename 'umount'>
  return umount2(target, 0)
end

-- Linux pivot_root changes the root mount and moves the old root beneath it.
local function pivot_root(new_root: pointer <const>, put_old: pointer <const>): cint <cexport, codename 'pivot_root'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    155_culong,
    (@culong)((@usize)(new_root)),
    (@culong)((@usize)(put_old)),
    0_culong
  )))
end

-- Linux unshare creates a new namespace or detaches selected process resources.
local function unshare(flags: cint): cint <cexport, codename 'unshare'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    272_culong,
    (@culong)(flags),
    0_culong,
    0_culong
  )))
end

-- Linux setns joins the namespace represented by a file descriptor.
local function setns(fd: cint, nstype: cint): cint <cexport, codename 'setns'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    308_culong,
    (@culong)(fd),
    (@culong)(nstype),
    0_culong
  )))
end

-- Linux sethostname changes the nodename of the calling UTS namespace.
local function sethostname(name: pointer <const>, length: csize): cint <cexport, codename 'sethostname'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    170_culong,
    (@culong)((@usize)(name)),
    (@culong)(length),
    0_culong
  )))
end

-- Linux setdomainname changes the NIS domain name of the calling UTS namespace.
local function setdomainname(name: pointer <const>, length: csize): cint <cexport, codename 'setdomainname'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    171_culong,
    (@culong)((@usize)(name)),
    (@culong)(length),
    0_culong
  )))
end

local function read(fd: cint, buf: pointer, count: csize): clong <cexport, codename 'read'>
  local raw_result = nelibc_cancellable_syscall3(
    0_culong,
    (@culong)(fd),
    (@culong)((@usize)(buf)),
    (@culong)(count)
  )
  return syscall_result(raw_result)
end

local function readv(fd: cint, iov: pointer <const>, iovcnt: cint): clong <cexport, codename 'readv'>
  local raw_result = nelibc_cancellable_syscall3(19_culong, (@culong)(fd), (@culong)((@usize)(iov)), (@culong)(iovcnt))
  return syscall_result(raw_result)
end

local function pread(fd: cint, buf: pointer, count: csize, offset: clong): clong <cexport, codename 'pread'>
  local raw_result = nelibc_cancellable_syscall6(
    17_culong,
    (@culong)(fd),
    (@culong)((@usize)(buf)),
    (@culong)(count),
    (@culong)(offset),
    0_culong,
    0_culong
  )
  return syscall_result(raw_result)
end

local function pread64(fd: cint, buf: pointer, count: csize, offset: clong): clong <cexport, codename 'pread64'>
  return pread(fd, buf, count, offset)
end

-- Linux x86_64 uses a native-width offset for preadv; only 32-bit ABIs split it.
local function preadv(fd: cint, iov: pointer <const>, iovcnt: cint, offset: clong): clong <cexport, codename 'preadv'>
  local raw_result = nelibc_cancellable_syscall6(
    295_culong,
    (@culong)(fd),
    (@culong)((@usize)(iov)),
    (@culong)(iovcnt),
    (@culong)(offset),
    0_culong,
    0_culong
  )
  return syscall_result(raw_result)
end

local function preadv64(fd: cint, iov: pointer <const>, iovcnt: cint, offset: clong): clong <cexport, codename 'preadv64'>
  return preadv(fd, iov, iovcnt, offset)
end

-- Linux x86_64 preadv2 uses a native-width offset followed by flags.
local function preadv2(fd: cint, iov: pointer <const>, iovcnt: cint, offset: clong, flags: cuint): clong <cexport, codename 'preadv2'>
  local raw_result = nelibc_cancellable_syscall6(
    327_culong,
    (@culong)(fd),
    (@culong)((@usize)(iov)),
    (@culong)(iovcnt),
    (@culong)(offset),
    0_culong,
    (@culong)(flags)
  )
  return syscall_result(raw_result)
end

local function write(fd: cint, buf: pointer, count: csize): clong <cexport, codename 'write'>
  local raw_result = nelibc_cancellable_syscall3(
    1_culong,
    (@culong)(fd),
    (@culong)((@usize)(buf)),
    (@culong)(count)
  )
  return syscall_result(raw_result)
end

local function writev(fd: cint, iov: pointer <const>, iovcnt: cint): clong <cexport, codename 'writev'>
  local raw_result = nelibc_cancellable_syscall3(20_culong, (@culong)(fd), (@culong)((@usize)(iov)), (@culong)(iovcnt))
  return syscall_result(raw_result)
end

local Timespec: type = @record{tv_sec: clong, tv_nsec: clong}
local Sigset: type = @record{bits: [16]culong}
local PselectSigmask: type = @record{mask: pointer, size: csize}

local function poll(fds: pointer, nfds: culong, timeout: cint): cint <cexport, codename 'poll'>
  local raw_result = nelibc_cancellable_syscall3(
    7_culong, (@culong)((@usize)(fds)), nfds, (@culong)(timeout)
  )
  return (@cint)(syscall_result(raw_result))
end

local function ppoll(fds: pointer, nfds: culong, timeout: pointer <const>, sigmask: pointer <const>): cint <cexport, codename 'ppoll'>
  local timeout_copy: Timespec
  local timeout_pointer: pointer = nilptr
  if timeout ~= nilptr then
    local requested_timeout = (@*Timespec)(timeout)
    timeout_copy.tv_sec = requested_timeout.tv_sec
    timeout_copy.tv_nsec = requested_timeout.tv_nsec
    timeout_pointer = (@pointer)(&timeout_copy)
  end
  local kernel_sigmask: culong
  local sigmask_pointer: pointer = nilptr
  if sigmask ~= nilptr then
    kernel_sigmask = ((@*Sigset)(sigmask)).bits[0] & ~(1_culong << 31)
    sigmask_pointer = (@pointer)(&kernel_sigmask)
  end
  local raw_result = nelibc_cancellable_syscall6(
    271_culong, (@culong)((@usize)(fds)), nfds,
    (@culong)((@usize)(timeout_pointer)), (@culong)((@usize)(sigmask_pointer)),
    8_culong, 0_culong
  )
  return (@cint)(syscall_result(raw_result))
end

local function select(nfds: cint, readfds: pointer, writefds: pointer, exceptfds: pointer, timeout: pointer): cint <cexport, codename 'select'>
  local raw_result = nelibc_cancellable_syscall6(
    23_culong, (@culong)(nfds), (@culong)((@usize)(readfds)),
    (@culong)((@usize)(writefds)), (@culong)((@usize)(exceptfds)),
    (@culong)((@usize)(timeout)), 0_culong
  )
  return (@cint)(syscall_result(raw_result))
end

local function pselect(nfds: cint, readfds: pointer, writefds: pointer, exceptfds: pointer, timeout: pointer <const>, sigmask: pointer <const>): cint <cexport, codename 'pselect'>
  local timeout_copy: Timespec
  local timeout_pointer: pointer = nilptr
  if timeout ~= nilptr then
    local requested_timeout = (@*Timespec)(timeout)
    timeout_copy.tv_sec = requested_timeout.tv_sec
    timeout_copy.tv_nsec = requested_timeout.tv_nsec
    timeout_pointer = (@pointer)(&timeout_copy)
  end
  local kernel_sigmask: culong
  local kernel_mask_pointer: pointer = nilptr
  local syscall_mask: PselectSigmask
  local syscall_mask_pointer: pointer = nilptr
  if sigmask ~= nilptr then
    kernel_sigmask = ((@*Sigset)(sigmask)).bits[0] & ~(1_culong << 31)
    kernel_mask_pointer = (@pointer)(&kernel_sigmask)
    syscall_mask.mask = kernel_mask_pointer
    syscall_mask.size = 8_csize
    syscall_mask_pointer = (@pointer)(&syscall_mask)
  end
  local raw_result = nelibc_cancellable_syscall6(
    270_culong, (@culong)(nfds), (@culong)((@usize)(readfds)),
    (@culong)((@usize)(writefds)), (@culong)((@usize)(exceptfds)),
    (@culong)((@usize)(timeout_pointer)),
    (@culong)((@usize)(syscall_mask_pointer))
  )
  return (@cint)(syscall_result(raw_result))
end

local function nanosleep(requested: pointer <const>, remaining: pointer): cint <cexport, codename 'nanosleep'>
  local raw_result = nelibc_cancellable_syscall3(
    35_culong, (@culong)((@usize)(requested)), (@culong)((@usize)(remaining)), 0_culong
  )
  return (@cint)(syscall_result(raw_result))
end

-- POSIX clock_nanosleep returns an error number directly and leaves errno alone.
local function clock_nanosleep(clock_id: cint, flags: cint, requested: pointer <const>, remaining: pointer): cint <cexport, codename 'clock_nanosleep'>
  local result = nelibc_cancellable_syscall6(
    230_culong, (@culong)(clock_id), (@culong)(flags),
    (@culong)((@usize)(requested)), (@culong)((@usize)(remaining)),
    0_culong, 0_culong
  )
  if result < 0 and result >= -4095 then return (@cint)(-result) end
  return 0
end

local function usleep(microseconds: cuint): cint <cexport, codename 'usleep'>
  if microseconds >= 1000000_cuint then
    nelibc_errno_location()[0] = 22_cint -- EINVAL
    return -1_cint
  end
  local requested: Timespec = {
    tv_sec = 0_clong,
    tv_nsec = (@clong)(microseconds) * 1000_clong
  }
  return nanosleep((@pointer)(&requested), nilptr)
end

local Timeval: type = @record{tv_sec: clong, tv_usec: clong}
local Itimerval: type = @record{it_interval: Timeval, it_value: Timeval}

local function getitimer(which: cint, current: pointer): cint <cexport, codename 'getitimer'>
  return (@cint)(syscall_result(nelibc_cancellable_syscall3(
    36_culong, (@culong)(which), (@culong)((@usize)(current)), 0_culong
  )))
end

local function setitimer(which: cint, new_value: pointer <const>, old_value: pointer): cint <cexport, codename 'setitimer'>
  return (@cint)(syscall_result(nelibc_cancellable_syscall3(
    38_culong, (@culong)(which), (@culong)((@usize)(new_value)),
    (@culong)((@usize)(old_value))
  )))
end

local function ualarm(microseconds: cuint, interval: cuint): cuint <cexport, codename 'ualarm'>
  local replacement: Itimerval = {
    it_interval = {tv_sec = (@clong)(interval // 1000000_cuint),
                   tv_usec = (@clong)(interval % 1000000_cuint)},
    it_value = {tv_sec = (@clong)(microseconds // 1000000_cuint),
                tv_usec = (@clong)(microseconds % 1000000_cuint)}
  }
  local previous: Itimerval = {
    it_interval = {tv_sec = 0_clong, tv_usec = 0_clong},
    it_value = {tv_sec = 0_clong, tv_usec = 0_clong}
  }
  local timer_result = setitimer(0_cint, (@pointer)(&replacement), (@pointer)(&previous))
  if timer_result ~= 0_cint then
    return ~0_cuint
  end
  return (@cuint)(previous.it_value.tv_sec * 1000000_clong + previous.it_value.tv_usec)
end

local Tm: type = @record{
  tm_sec: cint, tm_min: cint, tm_hour: cint, tm_mday: cint, tm_mon: cint,
  tm_year: cint, tm_wday: cint, tm_yday: cint, tm_isdst: cint,
  tm_gmtoff: clong, tm_zone: pointer
}

local function floor_division(value: clonglong, divisor: clonglong): clonglong <inline>
  local quotient: clonglong = value // divisor
  local remainder: clonglong = value - quotient * divisor
  if remainder < 0 then quotient = quotient - 1_clonglong end
  return quotient
end

-- POSIX sleep is built from nanosleep and reports whole unslept seconds.
local function sleep(seconds: cuint): cuint <cexport, codename 'sleep'>
  if seconds == 0 then return 0_cuint end
  local requested: Timespec = {tv_sec = (@clong)(seconds), tv_nsec = 0_clong}
  local remaining: Timespec = {tv_sec = 0_clong, tv_nsec = 0_clong}
  if nanosleep((@pointer)(&requested), (@pointer)(&remaining)) == 0 then
    return 0_cuint
  end
  if nelibc_errno_location()[0] == 4_cint then -- EINTR
    local unslept = (@cuint)(remaining.tv_sec)
    if remaining.tv_nsec > 0 then unslept = unslept + 1_cuint end
    if unslept > seconds then unslept = seconds end
    return unslept
  end
  return seconds
end

local function alarm(seconds: cuint): cuint <cexport, codename 'alarm'>
  return (@cuint)(nelibc_raw_syscall3(37_culong, (@culong)(seconds), 0_culong, 0_culong))
end

local function pause(): cint <cexport, codename 'pause'>
  local raw_result = nelibc_cancellable_syscall3(34_culong, 0_culong, 0_culong, 0_culong)
  return (@cint)(syscall_result(raw_result))
end

-- Linux wait4 is the common kernel primitive behind wait and waitpid.
local function wait4(pid: cint, status: pointer, options: cint, usage: pointer): cint <cexport, codename 'wait4'>
  local raw_result = nelibc_cancellable_syscall6(
    61_culong,
    (@culong)(pid),
    (@culong)((@usize)(status)),
    (@culong)(options),
    (@culong)((@usize)(usage)),
    0_culong,
    0_culong
  )
  return (@cint)(syscall_result(raw_result))
end

local function nelibc_waitpid(pid: cint, status: pointer, options: cint): cint <cexport, codename 'nelibc_waitpid'>
  return wait4(pid, status, options, nilptr)
end

local function wait(status: pointer): cint <cexport, codename 'wait'>
  return nelibc_waitpid(-1_cint, status, 0_cint)
end

local function fork(): cint <cexport, codename 'fork'>
  local snapshot = nelibc_atfork_prepare()
  local result = nelibc_raw_syscall3(57_culong, 0_culong, 0_culong, 0_culong)
  if result == 0 then
    nelibc_atfork_child(snapshot)
    return 0
  end
  nelibc_atfork_parent(snapshot)
  return (@cint)(syscall_result(result))
end

local function execve(pathname: *[0]cchar <const>, argv: *[0]*[0]cchar, envp: *[0]*[0]cchar): cint <cexport, codename 'execve'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    59_culong,
    (@culong)((@usize)(pathname)),
    (@culong)((@usize)(argv)),
    (@culong)((@usize)(envp))
  )))
end

local function execve_with_shell_fallback(pathname: *[0]cchar <const>,
    argv: *[0]*[0]cchar, envp: *[0]*[0]cchar): cint <inline>
  local result = execve(pathname, argv, envp)
  if result ~= -1_cint or nelibc_errno_location()[0] ~= 8_cint then return result end -- ENOEXEC
  local argument_count: csize = 0
  while argv[argument_count] ~= nilptr do argument_count = argument_count + 1_csize end
  if argument_count > 0x7fffffffffffffff_csize // 8_csize - 2_csize then
    nelibc_errno_location()[0] = 12_cint -- ENOMEM
    return -1_cint
  end
  local shell_arguments = (@*[0]*[0]cchar)(malloc((argument_count + 2_csize) * 8_csize))
  if shell_arguments == nilptr then
    nelibc_errno_location()[0] = 12_cint -- ENOMEM
    return -1_cint
  end
  shell_arguments[0] = '/bin/sh'
  shell_arguments[1] = pathname
  local index: csize = 1_csize
  while index < argument_count do
    shell_arguments[index + 1_csize] = argv[index]
    index = index + 1_csize
  end
  shell_arguments[argument_count + 1_csize] = nilptr
  result = execve('/bin/sh', shell_arguments, envp)
  local error_number = nelibc_errno_location()[0]
  free((@pointer)(shell_arguments))
  nelibc_errno_location()[0] = error_number
  return result
end

local function exec_search_path(file: *[0]cchar <const>, argv: *[0]*[0]cchar,
    envp: *[0]*[0]cchar): cint <inline>
  local file_length: csize = 0
  local has_slash: boolean = false
  while file[file_length] ~= 0 do
    if file[file_length] == 47 then has_slash = true end
    file_length = file_length + 1_csize
  end
  if has_slash then return execve_with_shell_fallback(file, argv, envp) end

  local search_path: *[0]cchar = getenv('PATH')
  if search_path == nilptr then search_path = '/bin:/usr/bin' end
  local saw_access_denied: boolean = false
  local path_start: csize = 0
  while true do
    local path_end = path_start
    while search_path[path_end] ~= 0 and search_path[path_end] ~= 58 do
      path_end = path_end + 1_csize
    end
    local directory_length = path_end - path_start
    local prefix_length = directory_length
    if prefix_length == 0_csize then prefix_length = 1_csize end -- empty PATH entry means '.'
    if prefix_length > 0x7fffffffffffffff_csize - file_length - 2_csize then
      nelibc_errno_location()[0] = 36_cint -- ENAMETOOLONG
      return -1_cint
    end
    local candidate_length = prefix_length + 1_csize + file_length
    local candidate = (@*[0]cchar)(malloc(candidate_length + 1_csize))
    if candidate == nilptr then
      nelibc_errno_location()[0] = 12_cint -- ENOMEM
      return -1_cint
    end
    local index: csize = 0
    if directory_length == 0_csize then
      candidate[0] = 46_cchar -- '.'
      index = 1_csize
    else
      while index < directory_length do
        candidate[index] = search_path[path_start + index]
        index = index + 1_csize
      end
    end
    candidate[index] = 47_cchar -- '/'
    index = 0_csize
    while index < file_length do
      candidate[prefix_length + 1_csize + index] = file[index]
      index = index + 1_csize
    end
    candidate[candidate_length] = 0_cchar

    local result = execve_with_shell_fallback(candidate, argv, envp)
    local error_number = nelibc_errno_location()[0]
    free((@pointer)(candidate))
    nelibc_errno_location()[0] = error_number
    if result ~= -1_cint then return result end
    if error_number == 13_cint then
      saw_access_denied = true -- EACCES
    elseif error_number ~= 2_cint and error_number ~= 20_cint and
        error_number ~= 116_cint and error_number ~= 19_cint and
        error_number ~= 110_cint then
      return -1_cint -- only continue for the errors execvp treats as search misses
    end
    if search_path[path_end] == 0 then break end
    path_start = path_end + 1_csize
  end
  if saw_access_denied then nelibc_errno_location()[0] = 13_cint
  else nelibc_errno_location()[0] = 2_cint end -- ENOENT
  return -1_cint
end

local function execv(pathname: *[0]cchar <const>, argv: *[0]*[0]cchar): cint <cexport, codename 'execv'>
  return execve(pathname, argv, (@*[0]*[0]cchar)(nelibc_environment_vector()))
end

local function execvp(file: *[0]cchar <const>, argv: *[0]*[0]cchar): cint <cexport, codename 'execvp'>
  return exec_search_path(file, argv, (@*[0]*[0]cchar)(nelibc_environment_vector()))
end

local function execvpe(file: *[0]cchar <const>, argv: *[0]*[0]cchar,
    envp: *[0]*[0]cchar): cint <cexport, codename 'execvpe'>
  return exec_search_path(file, argv, envp)
end

-- Linux execveat resolves pathname relative to dirfd, with AT_EMPTY_PATH support.
local function execveat(dirfd: cint, pathname: *[0]cchar <const>, argv: *[0]*[0]cchar, envp: *[0]*[0]cchar, flags: cint): cint <cexport, codename 'execveat'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    322_culong,
    (@culong)(dirfd),
    (@culong)((@usize)(pathname)),
    (@culong)((@usize)(argv)),
    (@culong)((@usize)(envp)),
    (@culong)(flags),
    0_culong
  )))
end

local function fexecve(descriptor: cint, argv: *[0]*[0]cchar,
    envp: *[0]*[0]cchar): cint <cexport, codename 'fexecve'>
  return execveat(descriptor, '', argv, envp, 0x1000_cint) -- AT_EMPTY_PATH
end

local function _exit(status: cint): void <cexport, codename '_exit'>
  nelibc_raw_syscall3(231_culong, (@culong)(status), 0_culong, 0_culong)
  while true do end
end

-- POSIX _Exit bypasses handlers and stdio but terminates every process thread.
local function _Exit(status: cint): void <cexport, codename '_Exit'>
  _exit(status)
  while true do end
end

local function clock_gettime(clock_id: cint, time_value: pointer): cint <cexport, codename 'clock_gettime'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    228_culong, (@culong)(clock_id), (@culong)((@usize)(time_value)), 0_culong
  )))
end

local function clock_getres(clock_id: cint, resolution: pointer): cint <cexport, codename 'clock_getres'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    229_culong, (@culong)(clock_id), (@culong)((@usize)(resolution)), 0_culong
  )))
end

-- C11 timespec_get supports the UTC calendar-time base.
local function timespec_get(time_value: pointer, base: cint): cint <cexport, codename 'timespec_get'>
  if time_value == nilptr or base ~= 1_cint then return 0_cint end
  if clock_gettime(0_cint, time_value) ~= 0_cint then return 0_cint end
  return base
end

-- C23 reports the resolution of a supported timespec_get time base.
local function timespec_getres(resolution: pointer, base: cint): cint <cexport, codename 'timespec_getres'>
  if base ~= 1_cint then return 0_cint end
  if resolution ~= nilptr and clock_getres(0_cint, resolution) ~= 0_cint then
    return 0_cint
  end
  return base
end

-- POSIX gettimeofday; Linux currently ignores the obsolete timezone argument.
local function gettimeofday(time_value: pointer, timezone: pointer): cint <cexport, codename 'gettimeofday'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    96_culong,
    (@culong)((@usize)(time_value)),
    (@culong)((@usize)(timezone)),
    0_culong
  )))
end

-- POSIX time returns seconds since the Epoch and optionally stores them.
local function time(timer: *[0]clong): clong <cexport, codename 'time'>
  local result = syscall_result(nelibc_raw_syscall3(201_culong, 0_culong, 0_culong, 0_culong))
  if result >= 0 and timer ~= nilptr then
    timer[0] = result
  end
  return result
end

local utc_zone: [4]cchar = {85_cchar, 84_cchar, 67_cchar, 0_cchar}
local gmtime_result: Tm = {
  tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
  tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 4_cint, tm_yday = 0_cint,
  tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = (@pointer)(&utc_zone[0])
}

-- Convert seconds since the Epoch to UTC without consulting host timezone state.
local function gmtime_r(timer: *[0]clong <const>, result: *Tm): *Tm
    <cexport, codename 'gmtime_r'>
  if timer == nilptr or result == nilptr then return nilptr end
  local timestamp: clonglong = (@clonglong)(timer[0])
  local days: clonglong = floor_division(timestamp, 86400_clonglong)
  local seconds_in_day: clonglong = timestamp - days * 86400_clonglong
  local z: clonglong = days + 719468_clonglong
  local era: clonglong = floor_division(z, 146097_clonglong)
  local day_of_era: clonglong = z - era * 146097_clonglong
  local year_of_era: clonglong =
    (day_of_era - day_of_era // 1460_clonglong +
      day_of_era // 36524_clonglong - day_of_era // 146096_clonglong) // 365_clonglong
  local year: clonglong = year_of_era + era * 400_clonglong
  local day_of_year_march: clonglong = day_of_era -
    (365_clonglong * year_of_era + year_of_era // 4_clonglong - year_of_era // 100_clonglong)
  local month_prime: clonglong = (5_clonglong * day_of_year_march + 2_clonglong) // 153_clonglong
  local day: clonglong = day_of_year_march -
    (153_clonglong * month_prime + 2_clonglong) // 5_clonglong + 1_clonglong
  local month: clonglong = month_prime
  if month_prime < 10_clonglong then month = month_prime + 3_clonglong
  else month = month_prime - 9_clonglong end
  if month <= 2_clonglong then year = year + 1_clonglong end
  local tm_year: clonglong = year - 1900_clonglong
  if tm_year < -2147483648_clonglong or tm_year > 2147483647_clonglong then
    nelibc_errno_location()[0] = 75_cint -- EOVERFLOW
    return nilptr
  end

  local is_leap: boolean = year % 400_clonglong == 0_clonglong or
    (year % 4_clonglong == 0_clonglong and year % 100_clonglong ~= 0_clonglong)
  local year_day: clonglong = 0_clonglong
  local month_index: clonglong = 1_clonglong
  while month_index < month do
    if month_index == 2_clonglong then
      if is_leap then year_day = year_day + 29_clonglong
      else year_day = year_day + 28_clonglong end
    elseif month_index == 4_clonglong or month_index == 6_clonglong or
        month_index == 9_clonglong or month_index == 11_clonglong then
      year_day = year_day + 30_clonglong
    else
      year_day = year_day + 31_clonglong
    end
    month_index = month_index + 1_clonglong
  end
  year_day = year_day + day - 1_clonglong
  local weekday_value: clonglong = days + 4_clonglong
  local weekday: clonglong = weekday_value -
    floor_division(weekday_value, 7_clonglong) * 7_clonglong
  local hour: clonglong = seconds_in_day // 3600_clonglong
  local minute: clonglong = (seconds_in_day - hour * 3600_clonglong) // 60_clonglong
  local second: clonglong = seconds_in_day - hour * 3600_clonglong - minute * 60_clonglong

  result.tm_sec = (@cint)(second)
  result.tm_min = (@cint)(minute)
  result.tm_hour = (@cint)(hour)
  result.tm_mday = (@cint)(day)
  result.tm_mon = (@cint)(month - 1_clonglong)
  result.tm_year = (@cint)(tm_year)
  result.tm_wday = (@cint)(weekday)
  result.tm_yday = (@cint)(year_day)
  result.tm_isdst = 0_cint
  result.tm_gmtoff = 0_clong
  result.tm_zone = (@pointer)(&utc_zone[0])
  return result
end

local function gmtime(timer: *[0]clong <const>): *Tm <cexport, codename 'gmtime'>
  return gmtime_r(timer, &gmtime_result)
end

local local_zone: [16]cchar = {85_cchar, 84_cchar, 67_cchar, 0_cchar}
local timezone: clong <cexport, codename 'timezone'> = 0_clong
local daylight: cint <cexport, codename 'daylight'> = 0_cint
local tz_standard_name: [16]cchar = {85_cchar, 84_cchar, 67_cchar, 0_cchar}
local tz_daylight_name: [16]cchar = {85_cchar, 84_cchar, 67_cchar, 0_cchar}
local tzname: [2]*[0]cchar <cexport, codename 'tzname'> = {
  (@*[0]cchar)(&tz_standard_name[0]), (@*[0]cchar)(&tz_daylight_name[0])
}
local tz_cache_ready: boolean = false
local tz_cache_is_set: boolean = false
local tz_cached_value: [512]cchar = {}
local tz_localtime_signature_ready: boolean = false
local tz_localtime_signature: [56]cchar = {}
local tz_localtime_path: [512]cchar = {
  47_cchar, 101_cchar, 116_cchar, 99_cchar, 47_cchar, 108_cchar,
  111_cchar, 99_cchar, 97_cchar, 108_cchar, 116_cchar, 105_cchar,
  109_cchar, 101_cchar, 0_cchar
}
local TzType: type = @record{offset: clonglong, is_dst: cint, abbreviation: csize}
local TzRule: type = @record{kind: cint, month: clonglong, week: clonglong,
  weekday: clonglong, seconds: clonglong, basis: cint}

-- Cache only stable statx fields for a timezone file. atime is deliberately
-- excluded because reading the zone file may update it.
local function tz_read_file_signature(path: *[0]cchar <const>,
    signature: *[56]cchar): boolean
  local metadata: [256]cchar = {}
  local result = nelibc_raw_syscall6(332_culong, (@culong)(-100_cint),
      (@culong)((@usize)(path)), 0_culong, 0x7ff_culong,
      (@culong)((@usize)(&metadata[0])), 0_culong)
  if result < 0 then return false end
  local source_offset: csize = 32
  local destination_offset: csize = 0
  while destination_offset < 16 do
    signature[destination_offset] = metadata[source_offset]
    destination_offset = destination_offset + 1
    source_offset = source_offset + 1
  end
  -- ctime and mtime (including nanoseconds).
  source_offset = 96
  while destination_offset < 48 do
    signature[destination_offset] = metadata[source_offset]
    destination_offset = destination_offset + 1
    source_offset = source_offset + 1
  end
  -- Device major/minor distinguish equal-inode values across mounts.
  source_offset = 136
  while destination_offset < 56 do
    signature[destination_offset] = metadata[source_offset]
    destination_offset = destination_offset + 1
    source_offset = source_offset + 1
  end
  return true
end

## if NELIBC_TESTING then
-- Test-only ABI hooks; normal libc archives do not export them.
local function nelibc_tz_file_signature(path: *[0]cchar <const>,
    signature: *[56]cchar): cint <cexport, codename '__nelibc_tz_file_signature'>
  if path == nilptr or signature == nilptr then return -1_cint end
  if not tz_read_file_signature(path, signature) then return -1_cint end
  return 0_cint
end

-- Private smoke-test seam for exercising the unset-TZ /etc/localtime path.
local function nelibc_set_localtime_path(path: *[0]cchar <const>): cint
    <cexport, codename '__nelibc_set_localtime_path'>
  if path == nilptr or path[0] == 0_cchar then return -1_cint end
  local index: csize = 0
  while index < 511 and path[index] ~= 0_cchar do index = index + 1 end
  if path[index] ~= 0_cchar then return -1_cint end
  index = 0
  while path[index] ~= 0_cchar do
    tz_localtime_path[index] = path[index]
    index = index + 1
  end
  tz_localtime_path[index] = 0_cchar
  return 0_cint
end
## end

local function tz_file_path(zone: *[0]cchar <const>, path: *[512]cchar): boolean
  local source: *[0]cchar = (@*[0]cchar)(zone)
  local relative: boolean = false
  if zone == nilptr then
    source = (@*[0]cchar)(&tz_localtime_path[0])
  else
    if zone[0] == 0_cchar then return false end
    if zone[0] == 58_cchar then
      source = (@*[0]cchar)(&zone[1])
      relative = true
    end
    local has_slash: boolean = false
    local scan: csize = 0
    while source[scan] ~= 0_cchar do
      if source[scan] == 47_cchar then has_slash = true end
      scan = scan + 1
    end
    if not has_slash and not relative then return false end
    if source[0] == 47_cchar then relative = false else relative = true end
  end
  local index: csize = 0
  if relative then
    local prefix: *[0]cchar <const> = "/usr/share/zoneinfo/"
    while prefix[index] ~= 0_cchar do
      if index >= 510 then return false end
      path[index] = prefix[index]
      index = index + 1
    end
  end
  local source_index: csize = 0
  while source[source_index] ~= 0_cchar do
    if index >= 511 then return false end
    path[index] = source[source_index]
    index = index + 1
    source_index = source_index + 1
  end
  path[index] = 0_cchar
  return true
end

local function tz_file_signature_matches(path: *[0]cchar <const>): boolean
  if not tz_localtime_signature_ready then return false end
  local current: [56]cchar = {}
  if not tz_read_file_signature(path, &current[0]) then return false end
  local index: csize = 0
  while index < 56 do
    if current[index] ~= tz_localtime_signature[index] then return false end
    index = index + 1
  end
  return true
end

local function tz_zone_file_signature_store(zone: *[0]cchar <const>): void
  local path: [512]cchar = {}
  if not tz_file_path(zone, &path[0]) then
    tz_localtime_signature_ready = false
    return
  end
  tz_localtime_signature_ready = tz_read_file_signature(
      &path[0], &tz_localtime_signature[0])
end

local function tz_cache_matches(zone: *[0]cchar <const>): boolean
  if not tz_cache_ready then return false end
  if zone == nilptr then
    if tz_cache_is_set then return false end
  else
    if not tz_cache_is_set then return false end
    local index: csize = 0
    while index < 511 do
      if zone[index] ~= tz_cached_value[index] then return false end
      if zone[index] == 0_cchar then break end
      index = index + 1
    end
    -- Avoid treating overlong environment strings as equal after truncation.
    if index == 511 then return false end
  end
  local path: [512]cchar = {}
  if not tz_file_path(zone, &path[0]) then return true end
  return tz_file_signature_matches(&path[0])
end

local function tz_cache_store(zone: *[0]cchar <const>): void <inline>
  tz_cache_is_set = zone ~= nilptr
  local index: csize = 0
  if zone ~= nilptr then
    while index < 511 and zone[index] ~= 0_cchar do
      tz_cached_value[index] = zone[index]
      index = index + 1
    end
    if zone[index] ~= 0_cchar then
      tz_cache_ready = false
      return
    end
  end
  tz_cached_value[index] = 0_cchar
  tz_cache_ready = true
end

local function tz_parse_decimal(data: *[0]cchar <const>, index: *[0]csize,
    limit: csize): clonglong
  local value: clonglong = 0_clonglong
  while index[0] < limit and data[index[0]] >= 48_cchar and data[index[0]] <= 57_cchar do
    local digit: clonglong = (@clonglong)(data[index[0]] - 48_cchar)
    if value > (0x7fffffffffffffff_clonglong - digit) // 10_clonglong then
      value = 0x7fffffffffffffff_clonglong
    else
      value = value * 10_clonglong + digit
    end
    index[0] = index[0] + 1
  end
  return value
end

local function tz_parse_abbreviation(data: *[0]cchar <const>, index: *[0]csize,
    limit: csize, name: *[16]cchar): boolean
  local quoted: boolean = false
  if index[0] < limit and data[index[0]] == 60_cchar then
    quoted = true
    index[0] = index[0] + 1
  end
  local length: csize = 0
  while index[0] < limit do
    local ch: cchar = data[index[0]]
    if quoted then
      if ch == 62_cchar then break end
    elseif not ((ch >= 65_cchar and ch <= 90_cchar) or (ch >= 97_cchar and ch <= 122_cchar)) then
      break
    end
    if length < 15 then name[length] = ch end
    length = length + 1
    index[0] = index[0] + 1
  end
  if quoted then
    if index[0] >= limit or data[index[0]] ~= 62_cchar then return false end
    index[0] = index[0] + 1
  end
  if length < 3 then return false end
  if length > 15 then length = 15 end
  name[length] = 0_cchar
  return true
end

-- POSIX TZ offsets are seconds west of UTC; the returned value retains that sign.
local function tz_parse_offset(data: *[0]cchar <const>, index: *[0]csize,
    limit: csize, offset: *[0]clonglong): boolean
  local sign: clonglong = 1_clonglong
  if index[0] < limit and data[index[0]] == 45_cchar then
    sign = -1_clonglong; index[0] = index[0] + 1
  elseif index[0] < limit and data[index[0]] == 43_cchar then
    index[0] = index[0] + 1
  end
  local before: csize = index[0]
  local hours: clonglong = tz_parse_decimal(data, index, limit)
  if index[0] == before or hours > 24_clonglong then return false end
  local minutes: clonglong = 0_clonglong
  local seconds: clonglong = 0_clonglong
  if index[0] < limit and data[index[0]] == 58_cchar then
    index[0] = index[0] + 1
    before = index[0]
    minutes = tz_parse_decimal(data, index, limit)
    if index[0] == before or minutes > 59_clonglong then return false end
    if index[0] < limit and data[index[0]] == 58_cchar then
      index[0] = index[0] + 1
      before = index[0]
      seconds = tz_parse_decimal(data, index, limit)
      if index[0] == before or seconds > 59_clonglong then return false end
    end
  end
  offset[0] = sign * (hours * 3600_clonglong + minutes * 60_clonglong + seconds)
  return true
end

local function tz_parse_rule(data: *[0]cchar <const>, index: *[0]csize,
    limit: csize, rule: *TzRule): boolean
  if index[0] >= limit then return false end
  if data[index[0]] == 77_cchar then -- Mmonth.week.weekday
    rule.kind = 0_cint
    index[0] = index[0] + 1
    rule.month = tz_parse_decimal(data, index, limit)
    if index[0] >= limit or data[index[0]] ~= 46_cchar then return false end
    index[0] = index[0] + 1
    rule.week = tz_parse_decimal(data, index, limit)
    if index[0] >= limit or data[index[0]] ~= 46_cchar then return false end
    index[0] = index[0] + 1
    rule.weekday = tz_parse_decimal(data, index, limit)
    if rule.month < 1_clonglong or rule.month > 12_clonglong or
        rule.week < 1_clonglong or rule.week > 5_clonglong or
        rule.weekday < 0_clonglong or rule.weekday > 6_clonglong then return false end
  elseif data[index[0]] == 74_cchar then -- Jn, excluding leap day from the count.
    rule.kind = 1_cint
    index[0] = index[0] + 1
    rule.weekday = tz_parse_decimal(data, index, limit)
    if rule.weekday < 1_clonglong or rule.weekday > 365_clonglong then return false end
  else -- n, zero-based day of year including leap day.
    rule.kind = 2_cint
    rule.weekday = tz_parse_decimal(data, index, limit)
    if rule.weekday < 0_clonglong or rule.weekday > 365_clonglong then return false end
  end
  rule.seconds = 7200_clonglong
  rule.basis = 0_cint -- wall time
  if index[0] < limit and data[index[0]] == 47_cchar then
    index[0] = index[0] + 1
    local sign: clonglong = 1_clonglong
    if index[0] < limit and data[index[0]] == 45_cchar then
      sign = -1_clonglong; index[0] = index[0] + 1
    elseif index[0] < limit and data[index[0]] == 43_cchar then
      index[0] = index[0] + 1
    end
    local before: csize = index[0]
    local hours: clonglong = tz_parse_decimal(data, index, limit)
    if index[0] == before or hours > 167_clonglong then return false end
    local minutes: clonglong = 0_clonglong
    local seconds: clonglong = 0_clonglong
    if index[0] < limit and data[index[0]] == 58_cchar then
      index[0] = index[0] + 1
      before = index[0]; minutes = tz_parse_decimal(data, index, limit)
      if index[0] == before or minutes > 59_clonglong then return false end
      if index[0] < limit and data[index[0]] == 58_cchar then
        index[0] = index[0] + 1
        before = index[0]; seconds = tz_parse_decimal(data, index, limit)
        if index[0] == before or seconds > 59_clonglong then return false end
      end
    end
    rule.seconds = sign * (hours * 3600_clonglong + minutes * 60_clonglong + seconds)
    if index[0] < limit and (data[index[0]] == 119_cchar or data[index[0]] == 115_cchar or
        data[index[0]] == 117_cchar or data[index[0]] == 103_cchar or data[index[0]] == 122_cchar) then
      if data[index[0]] == 115_cchar then rule.basis = 1_cint
      elseif data[index[0]] == 117_cchar or data[index[0]] == 103_cchar or data[index[0]] == 122_cchar then rule.basis = 2_cint end
      index[0] = index[0] + 1
    end
  end
  return true
end

local function tz_days_from_civil(year_arg: clonglong, month: clonglong,
    day: clonglong): clonglong
  local year: clonglong = year_arg
  if month <= 2_clonglong then year = year - 1_clonglong end
  local era: clonglong = floor_division(year, 400_clonglong)
  local year_of_era: clonglong = year - era * 400_clonglong
  local march_month: clonglong = month
  if month > 2_clonglong then march_month = month - 3_clonglong
  else march_month = month + 9_clonglong end
  local day_of_year: clonglong = (153_clonglong * march_month + 2_clonglong) // 5_clonglong + day - 1_clonglong
  local day_of_era: clonglong = year_of_era * 365_clonglong + year_of_era // 4_clonglong -
      year_of_era // 100_clonglong + day_of_year
  return era * 146097_clonglong + day_of_era - 719468_clonglong
end

local function tz_rule_epoch(year: clonglong, rule: *TzRule): clonglong
  if rule.kind ~= 0_cint then
    local day_index: clonglong = rule.weekday
    if rule.kind == 1_cint then
      day_index = day_index - 1_clonglong
      local leap: boolean = year % 400_clonglong == 0_clonglong or
        (year % 4_clonglong == 0_clonglong and year % 100_clonglong ~= 0_clonglong)
      if leap and rule.weekday >= 60_clonglong then day_index = day_index + 1_clonglong end
    end
    return tz_days_from_civil(year, 1_clonglong, 1_clonglong) * 86400_clonglong +
      day_index * 86400_clonglong + rule.seconds
  end
  local first_day: clonglong = tz_days_from_civil(year, rule.month, 1_clonglong)
  local first_weekday: clonglong = (first_day + 4_clonglong) % 7_clonglong
  if first_weekday < 0_clonglong then first_weekday = first_weekday + 7_clonglong end
  local day: clonglong = 1_clonglong + (rule.weekday - first_weekday + 7_clonglong) % 7_clonglong +
      (rule.week - 1_clonglong) * 7_clonglong
  local month_length: clonglong = 31_clonglong
  if rule.month == 4_clonglong or rule.month == 6_clonglong or rule.month == 9_clonglong or rule.month == 11_clonglong then
    month_length = 30_clonglong
  elseif rule.month == 2_clonglong then
    local leap: boolean = year % 400_clonglong == 0_clonglong or
      (year % 4_clonglong == 0_clonglong and year % 100_clonglong ~= 0_clonglong)
    if leap then month_length = 29_clonglong else month_length = 28_clonglong end
  end
  if day > month_length then day = day - 7_clonglong end
  return tz_days_from_civil(year, rule.month, day) * 86400_clonglong + rule.seconds
end

local function tz_apply_footer(data: *[0]cchar <const>, footer: csize, data_length: csize,
    timestamp: clonglong, year: clonglong, offset: *[0]clonglong,
    is_dst: *[0]cint, zone: *[16]cchar): boolean
  if footer >= data_length or data[footer] ~= 10_cchar then return false end
  local start: csize = footer + 1
  local finish: csize = start
  while finish < data_length and data[finish] ~= 10_cchar do finish = finish + 1 end
  if finish == data_length then return false end
  local index: csize = start
  local standard_name: [16]cchar = {}
  local daylight_name: [16]cchar = {}
  if not tz_parse_abbreviation(data, &index, finish, &standard_name[0]) then return false end
  local standard_west: clonglong = 0_clonglong
  if not tz_parse_offset(data, &index, finish, &standard_west) then return false end
  local standard_offset: clonglong = -standard_west
  if index == finish then
    offset[0] = standard_offset; is_dst[0] = 0_cint
    local copy: csize = 0
    while copy < 16 and standard_name[copy] ~= 0_cchar do zone[copy] = standard_name[copy]; copy = copy + 1 end
    return true
  end
  if not tz_parse_abbreviation(data, &index, finish, &daylight_name[0]) then return false end
  local daylight_offset: clonglong = standard_offset + 3600_clonglong
  if index < finish and data[index] ~= 44_cchar then
    local daylight_west: clonglong = 0_clonglong
    if not tz_parse_offset(data, &index, finish, &daylight_west) then return false end
    daylight_offset = -daylight_west
  end
  local start_rule: TzRule = {kind = 0, month = 0, week = 0, weekday = 0, seconds = 0, basis = 0}
  local end_rule: TzRule = {kind = 0, month = 0, week = 0, weekday = 0, seconds = 0, basis = 0}
  if index == finish then
    -- Use the contemporary US rule where a POSIX TZ string omits transition rules.
    start_rule.month = 3_clonglong; start_rule.week = 2_clonglong
    start_rule.weekday = 0_clonglong; start_rule.seconds = 7200_clonglong
    end_rule.month = 11_clonglong; end_rule.week = 1_clonglong
    end_rule.weekday = 0_clonglong; end_rule.seconds = 7200_clonglong
  else
    if data[index] ~= 44_cchar then return false end
    index = index + 1
    if not tz_parse_rule(data, &index, finish, &start_rule) or index >= finish or data[index] ~= 44_cchar then return false end
    index = index + 1
    if not tz_parse_rule(data, &index, finish, &end_rule) or index ~= finish then return false end
  end
  local start_epoch: clonglong = tz_rule_epoch(year, &start_rule)
  local end_epoch: clonglong = tz_rule_epoch(year, &end_rule)
  -- Wall time uses the offset in effect before each change. "s" uses standard time;
  -- UTC suffixes need no correction.
  if start_rule.basis == 0_cint or start_rule.basis == 1_cint then start_epoch = start_epoch - standard_offset end
  if end_rule.basis == 0_cint then end_epoch = end_epoch - daylight_offset
  elseif end_rule.basis == 1_cint then end_epoch = end_epoch - standard_offset end
  local daylight: boolean
  if start_epoch < end_epoch then daylight = timestamp >= start_epoch and timestamp < end_epoch
  else daylight = timestamp >= start_epoch or timestamp < end_epoch end
  if daylight then
    offset[0] = daylight_offset; is_dst[0] = 1_cint
    local copy: csize = 0
    while copy < 16 and daylight_name[copy] ~= 0_cchar do zone[copy] = daylight_name[copy]; copy = copy + 1 end
  else
    offset[0] = standard_offset; is_dst[0] = 0_cint
    local copy: csize = 0
    while copy < 16 and standard_name[copy] ~= 0_cchar do zone[copy] = standard_name[copy]; copy = copy + 1 end
  end
  return true
end

local function tz_apply_posix_zone(specification: *[0]cchar <const>, length: csize,
    timer: *[0]clong <const>, result: *Tm): boolean
  if length > 255 then return false end
  local footer: [258]cchar = {}
  footer[0] = 10_cchar
  local index: csize = 0
  while index < length do footer[index + 1] = specification[index]; index = index + 1 end
  footer[length + 1] = 10_cchar
  local utc_calendar: Tm = {
    tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
    tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 4_cint, tm_yday = 0_cint,
    tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
  }
  if gmtime_r(timer, &utc_calendar) == nilptr then return false end
  local offset: clonglong = 0_clonglong
  local is_dst: cint = 0_cint
  local name: [16]cchar = {}
  if not tz_apply_footer(&footer[0], 0, length + 2, (@clonglong)(timer[0]),
      (@clonglong)(utc_calendar.tm_year) + 1900_clonglong, &offset, &is_dst, &name[0]) then return false end
  local timestamp: clonglong = (@clonglong)(timer[0])
  if offset > 0_clonglong and timestamp > 0x7fffffffffffffff_clonglong - offset or
      offset < 0_clonglong and timestamp < (-0x7fffffffffffffff_clonglong - 1_clonglong) - offset then
    nelibc_errno_location()[0] = 75_cint
    return false
  end
  timestamp = timestamp + offset
  if gmtime_r((@*[0]clong)(&timestamp), result) == nilptr then return false end
  result.tm_gmtoff = (@clong)(offset)
  result.tm_isdst = is_dst
  index = 0
  while index < 15 and name[index] ~= 0_cchar do
    local_zone[index] = name[index]
    index = index + 1
  end
  local_zone[index] = 0_cchar
  result.tm_zone = (@pointer)(&local_zone[0])
  return true
end

local function tz_read_unsigned(data: *[0]cchar <const>, offset: csize, width: csize): culonglong <inline>
  local value: culonglong = 0_culonglong
  local index: csize = 0
  while index < width do
    value = (value << 8) | (@culonglong)((@cint)(data[offset + index]) & 255_cint)
    index = index + 1
  end
  return value
end

-- Read TZif v1-v4 transition tables from /etc/localtime or TZ's zone file.
local function localtime_tzif(timer: *[0]clong <const>, result: *Tm,
    path: *[0]cchar <const>): cint
  local data: [131072]cchar = {}
  local fd: clong = syscall_result(nelibc_raw_syscall3(
    257_culong, (@culong)(-100_clong), (@culong)((@usize)(path)), 0_culong))
  if fd < 0 then return 0_cint end
  local data_length: csize = 0
  while data_length < 131072 do
    local amount: clong = syscall_result(nelibc_raw_syscall3(
      0_culong, (@culong)(fd), (@culong)((@usize)(&data[data_length])),
      (@culong)(131072 - data_length)))
    if amount < 0 then
      syscall_result(nelibc_raw_syscall3(3_culong, (@culong)(fd), 0_culong, 0_culong))
      return 0_cint
    end
    if amount == 0 then break end
    data_length = data_length + (@csize)(amount)
  end
  syscall_result(nelibc_raw_syscall3(3_culong, (@culong)(fd), 0_culong, 0_culong))
  if data_length < 44 or data[0] ~= 84_cchar or data[1] ~= 90_cchar or
      data[2] ~= 105_cchar or data[3] ~= 102_cchar then return 0_cint end

  local header: csize = 0
  local time_width: csize = 4
  local time_count: culonglong = tz_read_unsigned(&data[0], 32, 4)
  local type_count: culonglong = tz_read_unsigned(&data[0], 36, 4)
  local char_count: culonglong = tz_read_unsigned(&data[0], 40, 4)
  local leap_count: culonglong = tz_read_unsigned(&data[0], 28, 4)
  local std_count: culonglong = tz_read_unsigned(&data[0], 24, 4)
  local gmt_count: culonglong = tz_read_unsigned(&data[0], 20, 4)
  local version: cchar = data[4]
  if version == 50_cchar or version == 51_cchar or version == 52_cchar then
    local block_size: culonglong = time_count * 5_culonglong + type_count * 6_culonglong +
      char_count + leap_count * 8_culonglong + std_count + gmt_count
    if block_size > (@culonglong)(data_length - 44) then return 0_cint end
    header = 44 + (@csize)(block_size)
    if header + 44 > data_length or data[header] ~= 84_cchar or data[header + 1] ~= 90_cchar or
        data[header + 2] ~= 105_cchar or data[header + 3] ~= 102_cchar then return 0_cint end
    time_width = 8
    time_count = tz_read_unsigned(&data[0], header + 32, 4)
    type_count = tz_read_unsigned(&data[0], header + 36, 4)
    char_count = tz_read_unsigned(&data[0], header + 40, 4)
    leap_count = tz_read_unsigned(&data[0], header + 28, 4)
    std_count = tz_read_unsigned(&data[0], header + 24, 4)
    gmt_count = tz_read_unsigned(&data[0], header + 20, 4)
  end
  if type_count == 0 or type_count > 256 or char_count == 0 or
      time_count > 32768 then return 0_cint end
  local block_size: culonglong = time_count * (@culonglong)(time_width + 1) +
      type_count * 6_culonglong + char_count + leap_count * (@culonglong)(time_width + 4) +
      std_count + gmt_count
  local block: csize = header + 44
  if block_size > (@culonglong)(data_length - block) then return 0_cint end
  local indexes: csize = block + (@csize)(time_count * (@culonglong)(time_width))
  local info: csize = indexes + (@csize)(time_count)
  local abbreviations: csize = info + (@csize)(type_count * 6_culonglong)
  local times: [32768]clonglong = {}
  local transition_types: [32768]cuchar = {}
  local types: [256]TzType = {}
  local index: csize = 0
  while index < (@csize)(time_count) do
    local raw: culonglong = tz_read_unsigned(&data[0], block + index * time_width, time_width)
    if time_width == 4 then
      if raw >= 0x80000000_culonglong then
        times[index] = (@clonglong)(raw - 0x100000000_culonglong)
      else times[index] = (@clonglong)(raw) end
    else times[index] = (@clonglong)(raw) end
    transition_types[index] = (@cuchar)(data[indexes + index])
    if index > 0 and times[index] < times[index - 1] then return 0_cint end
    index = index + 1
  end
  index = 0
  while index < (@csize)(type_count) do
    local raw_offset: culonglong = tz_read_unsigned(&data[0], info + index * 6, 4)
    if raw_offset >= 0x80000000_culonglong then
      types[index].offset = (@clonglong)(raw_offset - 0x100000000_culonglong)
    else types[index].offset = (@clonglong)(raw_offset) end
    types[index].is_dst = ((@cint)(data[info + index * 6 + 4]) & 255_cint)
    types[index].abbreviation = (@csize)((@cint)(data[info + index * 6 + 5]) & 255_cint)
    if types[index].abbreviation >= (@csize)(char_count) then return 0_cint end
    index = index + 1
  end
  local selected: csize = 0
  local timestamp: clonglong = (@clonglong)(timer[0])
  if time_count > 0 and timestamp < times[0] then
    index = 0
    while index < (@csize)(type_count) do
      if types[index].is_dst == 0 then selected = index; break end
      index = index + 1
    end
  else
    index = 0
    while index < (@csize)(time_count) and times[index] <= timestamp do
      selected = (@csize)(transition_types[index])
      if selected >= (@csize)(type_count) then return 0_cint end
      index = index + 1
    end
  end
  local chosen: TzType = types[selected]
  local footer_zone: [16]cchar = {}
  local footer_offset: clonglong = 0_clonglong
  local footer_is_dst: cint = 0_cint
  local use_footer: boolean = false
  local after_last_transition: boolean = time_count == 0
  if time_count > 0 then after_last_transition = timestamp > times[(@csize)(time_count) - 1] end
  if after_last_transition then
    local utc_calendar: Tm = {
      tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
      tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 4_cint, tm_yday = 0_cint,
      tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
    }
    if gmtime_r(timer, &utc_calendar) == nilptr then return -1_cint end
    use_footer = tz_apply_footer(&data[0], block + (@csize)(block_size), data_length,
      timestamp, (@clonglong)(utc_calendar.tm_year) + 1900_clonglong,
      &footer_offset, &footer_is_dst, &footer_zone)
    if use_footer then
      chosen.offset = footer_offset
      chosen.is_dst = footer_is_dst
    end
  end
  if chosen.offset > 0_clonglong and timestamp > 0x7fffffffffffffff_clonglong - chosen.offset or
      chosen.offset < 0_clonglong and timestamp < (-0x7fffffffffffffff_clonglong - 1_clonglong) - chosen.offset then
    nelibc_errno_location()[0] = 75_cint
    return -1_cint
  end
  timestamp = timestamp + chosen.offset
  if gmtime_r((@*[0]clong)(&timestamp), result) == nilptr then return -1_cint end
  result.tm_gmtoff = (@clong)(chosen.offset)
  result.tm_isdst = chosen.is_dst
  local name_index: csize = 0
  if use_footer then
    while name_index < 15 and footer_zone[name_index] ~= 0_cchar do
      local_zone[name_index] = footer_zone[name_index]
      name_index = name_index + 1
    end
  else
    while name_index < 15 and data[abbreviations + chosen.abbreviation + name_index] ~= 0_cchar do
      local_zone[name_index] = data[abbreviations + chosen.abbreviation + name_index]
      name_index = name_index + 1
    end
  end
  local_zone[name_index] = 0_cchar
  result.tm_zone = (@pointer)(&local_zone[0])
  return 1_cint
end

local localtime_result: Tm = {
  tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
  tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 4_cint, tm_yday = 0_cint,
  tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = (@pointer)(&utc_zone[0])
}

-- Parse the fixed-offset form of POSIX TZ (for example EST5 or JST-9).
-- The sign is reversed by POSIX: EST5 means UTC-05:00.
local function localtime_r_core(timer: *[0]clong <const>, result: *Tm): *Tm
  if timer == nilptr or result == nilptr then return nilptr end
  local zone: *[0]cchar <const> = getenv("TZ")
  local zone_path: [512]cchar = {}
  if tz_file_path(zone, &zone_path[0]) then
    local zone_status: cint = localtime_tzif(timer, result, &zone_path[0])
    if zone_status > 0 then return result end
    if zone_status < 0 then return nilptr end
  end
  local offset: clonglong = 0_clonglong
  local zone_length: csize = 0
  if zone ~= nilptr then
    while zone[zone_length] ~= 0_cchar do zone_length = zone_length + 1 end
  end
  if zone ~= nilptr and zone_length > 0 and
      tz_apply_posix_zone(zone, zone_length, timer, result) then return result end
  local copy_length: csize = zone_length
  if copy_length > 15 then copy_length = 15 end
  if zone == nilptr or zone_length == 0 then
    local_zone[0] = 85_cchar; local_zone[1] = 84_cchar
    local_zone[2] = 67_cchar; local_zone[3] = 0_cchar
  else
    local index: csize = 0
    while index < copy_length and ((zone[index] >= 65_cchar and zone[index] <= 90_cchar) or
        (zone[index] >= 97_cchar and zone[index] <= 122_cchar)) do
      local_zone[index] = zone[index]
      index = index + 1
    end
    if index == 0 then return gmtime_r(timer, result) end
    local_zone[index] = 0_cchar
    if zone[index] ~= 0_cchar then
      local sign: clonglong = 1_clonglong
      if zone[index] == 45_cchar then sign = -1_clonglong; index = index + 1
      elseif zone[index] == 43_cchar then index = index + 1
      elseif zone[index] < 48_cchar or zone[index] > 57_cchar then return gmtime_r(timer, result) end
      local hours: clonglong = 0_clonglong
      local digits: cint = 0_cint
      while zone[index] >= 48_cchar and zone[index] <= 57_cchar do
        hours = hours * 10_clonglong + (@clonglong)(zone[index] - 48_cchar)
        index = index + 1; digits = digits + 1_cint
        if hours > 24_clonglong then return gmtime_r(timer, result) end
      end
      if digits == 0_cint then return gmtime_r(timer, result) end
      local minutes: clonglong = 0_clonglong
      if zone[index] == 58_cchar then
        index = index + 1
        if zone[index] < 48_cchar or zone[index] > 57_cchar then return gmtime_r(timer, result) end
        minutes = (@clonglong)(zone[index] - 48_cchar) * 10_clonglong
        index = index + 1
        if zone[index] < 48_cchar or zone[index] > 57_cchar then return gmtime_r(timer, result) end
        minutes = minutes + (@clonglong)(zone[index] - 48_cchar)
        index = index + 1
        if minutes > 59_clonglong then return gmtime_r(timer, result) end
      end
      if zone[index] ~= 0_cchar then return gmtime_r(timer, result) end
      offset = -sign * (hours * 3600_clonglong + minutes * 60_clonglong)
    end
  end
  local timestamp: clonglong = (@clonglong)(timer[0])
  if offset > 0_clonglong and timestamp > 0x7fffffffffffffff_clonglong - offset or
      offset < 0_clonglong and timestamp < (-0x7fffffffffffffff_clonglong - 1_clonglong) - offset then
    nelibc_errno_location()[0] = 75_cint
    return nilptr
  end
  timestamp = timestamp + offset
  if gmtime_r((@*[0]clong)(&timestamp), result) == nilptr then return nilptr end
  result.tm_gmtoff = (@clong)(offset)
  result.tm_zone = (@pointer)(&local_zone[0])
  return result
end

local function tz_copy_global_name(destination: *[16]cchar,
    source: *[0]cchar <const>): void <inline>
  local index: csize = 0
  if source ~= nilptr then
    while index < 15 and source[index] ~= 0_cchar do
      destination[index] = source[index]
      index = index + 1
    end
  end
  destination[index] = 0_cchar
  while index < 15 do
    index = index + 1
    destination[index] = 0_cchar
  end
end

-- Publish POSIX timezone globals from the same TZ/TZif engine used by localtime.
local function tzset(): void <cexport, codename 'tzset'>
  local zone: *[0]cchar <const> = getenv("TZ")
  tz_cache_store(zone)
  tz_zone_file_signature_store(zone)
  timezone = 0_clong
  daylight = 0_cint
  tz_copy_global_name(&tz_standard_name[0], "UTC")
  tz_copy_global_name(&tz_daylight_name[0], "UTC")
  local now: clong = time(nilptr)
  local calendar: Tm = {
    tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
    tm_mon = 0_cint, tm_year = 124_cint, tm_wday = 1_cint, tm_yday = 0_cint,
    tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
  }
  if now ~= -1_clong then gmtime_r(&now, &calendar) end
  local year: clonglong = (@clonglong)(calendar.tm_year) + 1900_clonglong
  local standard_found: boolean = false
  local daylight_found: boolean = false
  local month: clonglong = 1_clonglong
  while month <= 12_clonglong do
    local sample_time: clonglong = tz_days_from_civil(year, month, 15_clonglong) *
        86400_clonglong + 43200_clonglong
    local sample_timestamp: clong = (@clong)(sample_time)
    local sample: Tm = {
      tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
      tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 0_cint, tm_yday = 0_cint,
      tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
    }
    if localtime_r_core(&sample_timestamp, &sample) ~= nilptr then
      if sample.tm_isdst > 0 then
        if not daylight_found then
          daylight = 1_cint
          tz_copy_global_name(&tz_daylight_name[0], (@*[0]cchar)(sample.tm_zone))
          daylight_found = true
        end
      elseif not standard_found then
        timezone = -sample.tm_gmtoff
        tz_copy_global_name(&tz_standard_name[0], (@*[0]cchar)(sample.tm_zone))
        standard_found = true
      end
    end
    month = month + 1_clonglong
  end
  if not standard_found and daylight_found then
    tz_copy_global_name(&tz_standard_name[0], (@*[0]cchar)(&tz_daylight_name[0]))
  elseif standard_found and not daylight_found then
    tz_copy_global_name(&tz_daylight_name[0], (@*[0]cchar)(&tz_standard_name[0]))
  end
  tzname[0] = (@*[0]cchar)(&tz_standard_name[0])
  tzname[1] = (@*[0]cchar)(&tz_daylight_name[0])
end

-- POSIX localtime_r behaves as though tzset refreshed the environment state.
local function localtime_r(timer: *[0]clong <const>, result: *Tm): *Tm
    <cexport, codename 'localtime_r'>
  if timer == nilptr or result == nilptr then return nilptr end
  if not tz_cache_matches(getenv("TZ")) then tzset() end
  return localtime_r_core(timer, result)
end

local function localtime(timer: *[0]clong <const>): *Tm <cexport, codename 'localtime'>
  return localtime_r(timer, &localtime_result)
end

-- Normalize local calendar fields and resolve the requested wall time through
-- the active TZ rules. Sampling both sides of the year captures standard and
-- daylight offsets, including repeated and skipped wall-clock hours.
local function mktime(time_value: *Tm): clong <cexport, codename 'mktime'>
  if time_value == nilptr then return -1_clong end
  local month_zero_based: clonglong = (@clonglong)(time_value.tm_mon)
  local year: clonglong = (@clonglong)(time_value.tm_year) + 1900_clonglong +
      floor_division(month_zero_based, 12_clonglong)
  local month: clonglong = month_zero_based -
      floor_division(month_zero_based, 12_clonglong) * 12_clonglong + 1_clonglong
  local wall_seconds: clonglong = tz_days_from_civil(year, month, 1_clonglong) * 86400_clonglong +
      ((@clonglong)(time_value.tm_mday) - 1_clonglong) * 86400_clonglong +
      (@clonglong)(time_value.tm_hour) * 3600_clonglong +
      (@clonglong)(time_value.tm_min) * 60_clonglong + (@clonglong)(time_value.tm_sec)
  local normalized: Tm = {
    tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
    tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 4_cint, tm_yday = 0_cint,
    tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
  }
  if gmtime_r((@*[0]clong)(&wall_seconds), &normalized) == nilptr then return -1_clong end

  local sample_shifts: [7]clonglong = {
    0_clonglong, 86400_clonglong, -86400_clonglong,
    15552000_clonglong, -15552000_clonglong,
    31536000_clonglong, -31536000_clonglong
  }
  local offsets: [7]clonglong = {}
  local offset_count: csize = 0
  local index: csize = 0
  while index < 7 do
    local sample_time: clonglong = wall_seconds + sample_shifts[index]
    local sample: Tm = {
      tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
      tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 4_cint, tm_yday = 0_cint,
      tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
    }
    if localtime_r((@*[0]clong)(&sample_time), &sample) ~= nilptr then
      local duplicate: boolean = false
      local seen: csize = 0
      while seen < offset_count do
        if offsets[seen] == (@clonglong)(sample.tm_gmtoff) then duplicate = true end
        seen = seen + 1
      end
      if not duplicate then
        offsets[offset_count] = (@clonglong)(sample.tm_gmtoff)
        offset_count = offset_count + 1
      end
    end
    index = index + 1
  end
  if offset_count == 0 then
    nelibc_errno_location()[0] = 75_cint
    return -1_clong
  end

  local exact_found: boolean = false
  local exact_time: clonglong = 0_clonglong
  local forward_found: boolean = false
  local forward_time: clonglong = 0_clonglong
  local forward_delta: clonglong = 0x7fffffffffffffff_clonglong
  local backward_found: boolean = false
  local backward_time: clonglong = 0_clonglong
  local backward_delta: clonglong = -0x7fffffffffffffff_clonglong
  index = 0
  while index < offset_count do
    local candidate_time: clonglong = wall_seconds - offsets[index]
    local candidate: Tm = {
      tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
      tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 4_cint, tm_yday = 0_cint,
      tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
    }
    if localtime_r((@*[0]clong)(&candidate_time), &candidate) ~= nilptr then
      local dst_matches: boolean = time_value.tm_isdst < 0 or
          (time_value.tm_isdst == 0 and candidate.tm_isdst == 0) or
          (time_value.tm_isdst > 0 and candidate.tm_isdst > 0)
      local exact: boolean = candidate.tm_year == normalized.tm_year and
          candidate.tm_mon == normalized.tm_mon and candidate.tm_mday == normalized.tm_mday and
          candidate.tm_hour == normalized.tm_hour and candidate.tm_min == normalized.tm_min and
          candidate.tm_sec == normalized.tm_sec
      if exact and dst_matches and not exact_found then
        exact_found = true
        exact_time = candidate_time
      else
        local candidate_wall: clonglong = tz_days_from_civil(
            (@clonglong)(candidate.tm_year) + 1900_clonglong,
            (@clonglong)(candidate.tm_mon) + 1_clonglong,
            (@clonglong)(candidate.tm_mday)) * 86400_clonglong +
            (@clonglong)(candidate.tm_hour) * 3600_clonglong +
            (@clonglong)(candidate.tm_min) * 60_clonglong + (@clonglong)(candidate.tm_sec)
        local delta: clonglong = candidate_wall - wall_seconds
        if dst_matches and delta >= 0_clonglong and delta < forward_delta then
          forward_found = true
          forward_delta = delta
          forward_time = candidate_time
        elseif dst_matches and delta < 0_clonglong and delta > backward_delta then
          backward_found = true
          backward_delta = delta
          backward_time = candidate_time
        end
      end
    end
    index = index + 1
  end
  local result_time: clonglong
  if exact_found then result_time = exact_time
  elseif forward_found then result_time = forward_time
  elseif backward_found then result_time = backward_time
  else result_time = wall_seconds - offsets[0] end
  local converted_time: clong = (@clong)(result_time)
  if localtime_r(&converted_time, time_value) == nilptr then return -1_clong end
  return converted_time
end

-- GNU timegm normalizes a broken-down UTC time without consulting TZ.
local function timegm(time_value: *Tm): clong <cexport, codename 'timegm'>
  if time_value == nilptr then return -1_clong end
  local month_zero_based: clonglong = (@clonglong)(time_value.tm_mon)
  local year: clonglong = (@clonglong)(time_value.tm_year) + 1900_clonglong +
      floor_division(month_zero_based, 12_clonglong)
  local month: clonglong = month_zero_based -
      floor_division(month_zero_based, 12_clonglong) * 12_clonglong + 1_clonglong
  local seconds: clonglong = tz_days_from_civil(year, month, 1_clonglong) * 86400_clonglong +
      ((@clonglong)(time_value.tm_mday) - 1_clonglong) * 86400_clonglong +
      (@clonglong)(time_value.tm_hour) * 3600_clonglong +
      (@clonglong)(time_value.tm_min) * 60_clonglong + (@clonglong)(time_value.tm_sec)
  local converted_time: clong = (@clong)(seconds)
  if gmtime_r(&converted_time, time_value) == nilptr then return -1_clong end
  return converted_time
end

local asctime_result: [26]cchar = {}

local function asctime_r(time_value: *Tm <const>, buffer: *[0]cchar): *[0]cchar
    <cexport, codename 'asctime_r'>
  if time_value == nilptr or buffer == nilptr then
    nelibc_errno_location()[0] = 22_cint -- EINVAL
    return nilptr
  end
  local year: clonglong = (@clonglong)(time_value.tm_year) + 1900_clonglong
  if time_value.tm_wday < 0 or time_value.tm_wday > 6 or
      time_value.tm_mon < 0 or time_value.tm_mon > 11 or
      time_value.tm_mday < 1 or time_value.tm_mday > 31 or
      time_value.tm_hour < 0 or time_value.tm_hour > 23 or
      time_value.tm_min < 0 or time_value.tm_min > 59 or
      time_value.tm_sec < 0 or time_value.tm_sec > 60 then
    nelibc_errno_location()[0] = 22_cint
    return nilptr
  end
  if year < 0_clonglong or year > 9999_clonglong then
    nelibc_errno_location()[0] = 75_cint -- EOVERFLOW; asctime's fixed result is 26 bytes.
    return nilptr
  end
  local weekday: *[0]cchar
  if time_value.tm_wday == 0 then weekday = "Sun"
  elseif time_value.tm_wday == 1 then weekday = "Mon"
  elseif time_value.tm_wday == 2 then weekday = "Tue"
  elseif time_value.tm_wday == 3 then weekday = "Wed"
  elseif time_value.tm_wday == 4 then weekday = "Thu"
  elseif time_value.tm_wday == 5 then weekday = "Fri"
  else weekday = "Sat" end
  local month: *[0]cchar
  if time_value.tm_mon == 0 then month = "Jan"
  elseif time_value.tm_mon == 1 then month = "Feb"
  elseif time_value.tm_mon == 2 then month = "Mar"
  elseif time_value.tm_mon == 3 then month = "Apr"
  elseif time_value.tm_mon == 4 then month = "May"
  elseif time_value.tm_mon == 5 then month = "Jun"
  elseif time_value.tm_mon == 6 then month = "Jul"
  elseif time_value.tm_mon == 7 then month = "Aug"
  elseif time_value.tm_mon == 8 then month = "Sep"
  elseif time_value.tm_mon == 9 then month = "Oct"
  elseif time_value.tm_mon == 10 then month = "Nov"
  else month = "Dec" end
  local index: csize = 0
  while index < 3 do buffer[index] = weekday[index]; index = index + 1 end
  buffer[3] = 32_cchar
  index = 0
  while index < 3 do buffer[index + 4] = month[index]; index = index + 1 end
  buffer[7] = 32_cchar
  if time_value.tm_mday < 10 then buffer[8] = 32_cchar
  else buffer[8] = (@cchar)(48 + time_value.tm_mday // 10) end
  buffer[9] = (@cchar)(48 + time_value.tm_mday % 10)
  buffer[10] = 32_cchar
  buffer[11] = (@cchar)(48 + time_value.tm_hour // 10)
  buffer[12] = (@cchar)(48 + time_value.tm_hour % 10)
  buffer[13] = 58_cchar
  buffer[14] = (@cchar)(48 + time_value.tm_min // 10)
  buffer[15] = (@cchar)(48 + time_value.tm_min % 10)
  buffer[16] = 58_cchar
  buffer[17] = (@cchar)(48 + time_value.tm_sec // 10)
  buffer[18] = (@cchar)(48 + time_value.tm_sec % 10)
  buffer[19] = 32_cchar
  buffer[20] = (@cchar)(48 + year // 1000_clonglong)
  buffer[21] = (@cchar)(48 + (year // 100_clonglong) % 10_clonglong)
  buffer[22] = (@cchar)(48 + (year // 10_clonglong) % 10_clonglong)
  buffer[23] = (@cchar)(48 + year % 10_clonglong)
  buffer[24] = 10_cchar
  buffer[25] = 0_cchar
  return buffer
end

local function asctime(time_value: *Tm <const>): *[0]cchar <cexport, codename 'asctime'>
  return asctime_r(time_value, &asctime_result[0])
end

local function ctime_r(timer: *[0]clong <const>, buffer: *[0]cchar): *[0]cchar
    <cexport, codename 'ctime_r'>
  if timer == nilptr or buffer == nilptr then
    nelibc_errno_location()[0] = 22_cint
    return nilptr
  end
  local broken_down: Tm = {
    tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
    tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 4_cint, tm_yday = 0_cint,
    tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
  }
  if localtime_r(timer, &broken_down) == nilptr then return nilptr end
  return asctime_r(&broken_down, buffer)
end

local function ctime(timer: *[0]clong <const>): *[0]cchar <cexport, codename 'ctime'>
  if ctime_r(timer, &asctime_result[0]) == nilptr then return nilptr end
  return (@*[0]cchar)(&asctime_result[0])
end

local function strftime_append_text(buffer: *[0]cchar, max_size: csize,
    position: *[0]csize, text: *[0]cchar <const>): boolean <inline>
  local index: csize = 0
  while text[index] ~= 0_cchar do
    if position[0] + 1 >= max_size then return false end
    buffer[position[0]] = text[index]
    position[0] = position[0] + 1
    index = index + 1
  end
  return true
end

local function strftime_append_number(buffer: *[0]cchar, max_size: csize,
    position: *[0]csize, value: clonglong, width: cint, pad: cchar): boolean <inline>
  local digits: [24]cchar = {}
  local count: csize = 0
  local negative: boolean = value < 0_clonglong
  local magnitude: culonglong
  if negative then magnitude = (@culonglong)(-(value + 1_clonglong)) + 1_culonglong
  else magnitude = (@culonglong)(value) end
  repeat
    digits[count] = (@cchar)(48 + (@cint)(magnitude % 10_culonglong))
    magnitude = magnitude // 10_culonglong
    count = count + 1
  until magnitude == 0_culonglong
  if negative then
    if position[0] + 1 >= max_size then return false end
    buffer[position[0]] = 45_cchar
    position[0] = position[0] + 1
    width = width - 1_cint
  end
  while count < (@csize)(width) do
    if position[0] + 1 >= max_size then return false end
    buffer[position[0]] = pad
    position[0] = position[0] + 1
    width = width - 1_cint
  end
  while count > 0 do
    count = count - 1
    if position[0] + 1 >= max_size then return false end
    buffer[position[0]] = digits[count]
    position[0] = position[0] + 1
  end
  return true
end

local function iso_weeks_in_year(year: clonglong): cint <inline>
  local january_first: clonglong = (tz_days_from_civil(year, 1_clonglong, 1_clonglong) +
    4_clonglong) % 7_clonglong
  if january_first < 0_clonglong then january_first = january_first + 7_clonglong end
  local iso_weekday: clonglong = january_first
  if iso_weekday == 0_clonglong then iso_weekday = 7_clonglong end
  local leap: boolean = year % 400_clonglong == 0_clonglong or
    (year % 4_clonglong == 0_clonglong and year % 100_clonglong ~= 0_clonglong)
  if iso_weekday == 4_clonglong or (iso_weekday == 3_clonglong and leap) then return 53_cint end
  return 52_cint
end

local function strptime_fold(character: cchar): cint <inline>
  local value: cint = (@cint)(character)
  if value >= 65 and value <= 90 then value = value + 32 end
  return value
end

local function strptime_word(input: *[0]cchar <const>, position: *[0]csize,
    word: *[0]cchar <const>): boolean <inline>
  local index: csize = 0
  while word[index] ~= 0_cchar do
    if input[position[0] + index] == 0_cchar or
        strptime_fold(input[position[0] + index]) ~= strptime_fold(word[index]) then
      return false
    end
    index = index + 1
  end
  position[0] = position[0] + index
  return true
end

-- C-locale strptime parser for the standard calendar and clock directives.
local function strptime(input: *[0]cchar <const>, format: *[0]cchar <const>,
    time_value: *Tm): *[0]cchar <cexport, codename 'strptime'>
  if input == nilptr or format == nilptr or time_value == nilptr then return nilptr end
  local input_position: csize = 0
  local format_position: csize = 0
  local parsed_year: boolean = false
  local parsed_weekday: boolean = false
  local parsed_u_week: boolean = false
  local parsed_w_week: boolean = false
  local parsed_iso_week: boolean = false
  local parsed_iso_year: boolean = false
  local parsed_century: boolean = false
  local parsed_two_digit_year: boolean = false
  local u_week: cint = 0
  local w_week: cint = 0
  local iso_week: cint = 0
  local iso_year: clonglong = 0_clonglong
  local century: cint = 0
  local two_digit_year: cint = 0
  while format[format_position] ~= 0_cchar do
    local format_character: cchar = format[format_position]
    if format_character == 32_cchar or format_character == 9_cchar or
        format_character == 10_cchar or format_character == 13_cchar then
      while format[format_position] == 32_cchar or format[format_position] == 9_cchar or
          format[format_position] == 10_cchar or format[format_position] == 13_cchar do
        format_position = format_position + 1
      end
      while input[input_position] == 32_cchar or input[input_position] == 9_cchar or
          input[input_position] == 10_cchar or input[input_position] == 13_cchar do
        input_position = input_position + 1
      end
    elseif format_character ~= 37_cchar then
      if input[input_position] ~= format_character then return nilptr end
      input_position = input_position + 1
      format_position = format_position + 1
    else
      format_position = format_position + 1
      local directive: cchar = format[format_position]
      if directive == 0_cchar then return nilptr end
      format_position = format_position + 1
      if directive == 69_cchar or directive == 79_cchar then
        directive = format[format_position]
        if directive == 0_cchar then return nilptr end
        format_position = format_position + 1
      end
      if directive == 37_cchar then
        if input[input_position] ~= 37_cchar then return nilptr end
        input_position = input_position + 1
      elseif directive == 115_cchar then
        local negative: boolean = false
        if input[input_position] == 45_cchar then negative = true; input_position = input_position + 1
        elseif input[input_position] == 43_cchar then input_position = input_position + 1 end
        local magnitude: culonglong = 0_culonglong
        local digit_count: csize = 0
        local limit: culonglong = 0x7fffffffffffffff_culonglong
        if negative then limit = 0x8000000000000000_culonglong end
        while input[input_position] >= 48_cchar and input[input_position] <= 57_cchar do
          local digit: culonglong = (@culonglong)((@cint)(input[input_position]) - 48)
          if magnitude > (limit - digit) // 10_culonglong then return nilptr end
          magnitude = magnitude * 10_culonglong + digit
          digit_count = digit_count + 1
          input_position = input_position + 1
        end
        if digit_count == 0 then return nilptr end
        local timestamp: clonglong
        if negative and magnitude == 0x8000000000000000_culonglong then
          timestamp = -0x7fffffffffffffff_clonglong - 1_clonglong
        elseif negative then timestamp = -(@clonglong)(magnitude)
        else timestamp = (@clonglong)(magnitude) end
        local converted: Tm = {
          tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
          tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 0_cint, tm_yday = 0_cint,
          tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
        }
        local timestamp_time: clong = (@clong)(timestamp)
        if localtime_r(&timestamp_time, &converted) == nilptr then return nilptr end
        time_value.tm_sec = converted.tm_sec
        time_value.tm_min = converted.tm_min
        time_value.tm_hour = converted.tm_hour
        time_value.tm_mday = converted.tm_mday
        time_value.tm_mon = converted.tm_mon
        time_value.tm_year = converted.tm_year
        time_value.tm_wday = converted.tm_wday
        time_value.tm_yday = converted.tm_yday
        time_value.tm_isdst = converted.tm_isdst
        time_value.tm_gmtoff = converted.tm_gmtoff
        time_value.tm_zone = converted.tm_zone
      elseif directive == 110_cchar or directive == 116_cchar then
        while input[input_position] == 32_cchar or input[input_position] == 9_cchar or
            input[input_position] == 10_cchar or input[input_position] == 13_cchar or
            input[input_position] == 11_cchar or input[input_position] == 12_cchar do
          input_position = input_position + 1
        end
      elseif directive == 122_cchar then
        local sign: cint = 1
        if input[input_position] == 43_cchar then input_position = input_position + 1
        elseif input[input_position] == 45_cchar then sign = -1; input_position = input_position + 1
        else return nilptr end
        local hour: cint = 0
        local minute: cint = 0
        local digit_count: cint = 0
        while digit_count < 2 and input[input_position] >= 48_cchar and input[input_position] <= 57_cchar do
          hour = hour * 10 + (@cint)(input[input_position]) - 48
          input_position = input_position + 1
          digit_count = digit_count + 1
        end
        if digit_count ~= 2 then return nilptr end
        local colon_form: boolean = false
        if input[input_position] == 58_cchar then colon_form = true; input_position = input_position + 1 end
        digit_count = 0
        while digit_count < 2 and input[input_position] >= 48_cchar and input[input_position] <= 57_cchar do
          minute = minute * 10 + (@cint)(input[input_position]) - 48
          input_position = input_position + 1
          digit_count = digit_count + 1
        end
        if digit_count ~= 2 or hour > 23 or minute > 59 then return nilptr end
        if not colon_form and input[input_position] == 58_cchar then
          input_position = input_position + 1
          local second: cint = 0
          digit_count = 0
          while digit_count < 2 and input[input_position] >= 48_cchar and input[input_position] <= 57_cchar do
            second = second * 10 + (@cint)(input[input_position]) - 48
            input_position = input_position + 1
            digit_count = digit_count + 1
          end
          if digit_count ~= 2 or second > 59 then return nilptr end
          time_value.tm_gmtoff = sign * (hour * 3600 + minute * 60 + second)
        else
          time_value.tm_gmtoff = sign * (hour * 3600 + minute * 60)
        end
      elseif directive == 90_cchar then
        local zone_start: csize = input_position
        while (input[input_position] >= 65_cchar and input[input_position] <= 90_cchar) or
            (input[input_position] >= 97_cchar and input[input_position] <= 122_cchar) do
          input_position = input_position + 1
        end
        if input_position == zone_start then return nilptr end
      elseif directive == 70_cchar or directive == 84_cchar or
          directive == 82_cchar or directive == 68_cchar or
          directive == 99_cchar or directive == 120_cchar or
          directive == 88_cchar or directive == 114_cchar then
        local nested_format: *[0]cchar = "%Y-%m-%d"
        if directive == 84_cchar or directive == 88_cchar then nested_format = "%H:%M:%S"
        elseif directive == 82_cchar then nested_format = "%H:%M"
        elseif directive == 68_cchar then nested_format = "%m/%d/%y"
        elseif directive == 99_cchar then nested_format = "%a %b %e %H:%M:%S %Y"
        elseif directive == 120_cchar then nested_format = "%m/%d/%y"
        elseif directive == 114_cchar then nested_format = "%I:%M:%S %p" end
        local nested_end: *[0]cchar = strptime(&input[input_position], nested_format, time_value)
        if nested_end == nilptr then return nilptr end
        while (@*[0]cchar)(&input[input_position]) ~= nested_end do
          if input[input_position] == 0_cchar then return nilptr end
          input_position = input_position + 1
        end
      elseif directive == 98_cchar or directive == 66_cchar or directive == 104_cchar then
        local matched: boolean = false
        local month: cint = 0
        while month < 12 and not matched do
          local name3: *[0]cchar = "Jan"
          local name_full: *[0]cchar = "January"
          if month == 0 then name3 = "Jan"; name_full = "January"
          elseif month == 1 then name3 = "Feb"; name_full = "February"
          elseif month == 2 then name3 = "Mar"; name_full = "March"
          elseif month == 3 then name3 = "Apr"; name_full = "April"
          elseif month == 4 then name3 = "May"; name_full = "May"
          elseif month == 5 then name3 = "Jun"; name_full = "June"
          elseif month == 6 then name3 = "Jul"; name_full = "July"
          elseif month == 7 then name3 = "Aug"; name_full = "August"
          elseif month == 8 then name3 = "Sep"; name_full = "September"
          elseif month == 9 then name3 = "Oct"; name_full = "October"
          elseif month == 10 then name3 = "Nov"; name_full = "November"
          else name3 = "Dec"; name_full = "December" end
          local candidate_position: csize = input_position
          if strptime_word(input, &candidate_position, name3) then
            local full_position: csize = input_position
            if strptime_word(input, &full_position, name_full) then
              input_position = full_position
            else
              input_position = candidate_position
            end
            time_value.tm_mon = month
            matched = true
          end
          month = month + 1
        end
        if not matched then return nilptr end
      elseif directive == 97_cchar or directive == 65_cchar then
        local matched: boolean = false
        local weekday: cint = 0
        while weekday < 7 and not matched do
          local name3: *[0]cchar = "Sun"
          local name_full: *[0]cchar = "Sunday"
          if weekday == 0 then name3 = "Sun"; name_full = "Sunday"
          elseif weekday == 1 then name3 = "Mon"; name_full = "Monday"
          elseif weekday == 2 then name3 = "Tue"; name_full = "Tuesday"
          elseif weekday == 3 then name3 = "Wed"; name_full = "Wednesday"
          elseif weekday == 4 then name3 = "Thu"; name_full = "Thursday"
          elseif weekday == 5 then name3 = "Fri"; name_full = "Friday"
          else name3 = "Sat"; name_full = "Saturday" end
          local candidate_position: csize = input_position
          if strptime_word(input, &candidate_position, name3) then
            local full_position: csize = input_position
            if strptime_word(input, &full_position, name_full) then input_position = full_position
            else input_position = candidate_position end
            time_value.tm_wday = weekday
            parsed_weekday = true
            matched = true
          end
          weekday = weekday + 1
        end
        if not matched then return nilptr end
      elseif directive == 112_cchar then
        local candidate_position: csize = input_position
        if strptime_word(input, &candidate_position, "AM") then
          input_position = candidate_position
          if time_value.tm_hour == 12 then time_value.tm_hour = 0 end
        else
          candidate_position = input_position
          if not strptime_word(input, &candidate_position, "PM") then return nilptr end
          input_position = candidate_position
          if time_value.tm_hour < 12 then time_value.tm_hour = time_value.tm_hour + 12 end
        end
      elseif directive == 89_cchar or directive == 71_cchar or directive == 67_cchar or
          directive == 103_cchar or directive == 121_cchar or
          directive == 109_cchar or directive == 100_cchar or directive == 101_cchar or
          directive == 72_cchar or directive == 73_cchar or directive == 107_cchar or directive == 108_cchar or
          directive == 77_cchar or directive == 83_cchar or directive == 106_cchar or
          directive == 119_cchar or directive == 117_cchar or directive == 85_cchar or
          directive == 87_cchar or directive == 86_cchar then
        while input[input_position] == 32_cchar do input_position = input_position + 1 end
        local number: cint = 0
        local digits: cint = 0
        local width: cint = 2
        if directive == 89_cchar or directive == 71_cchar then width = 4
        elseif directive == 106_cchar then width = 3
        elseif directive == 67_cchar or directive == 121_cchar or directive == 103_cchar or directive == 85_cchar or
            directive == 87_cchar or directive == 86_cchar then width = 2 end
        while digits < width and input[input_position] >= 48_cchar and
            input[input_position] <= 57_cchar do
          number = number * 10 + (@cint)(input[input_position]) - 48
          input_position = input_position + 1
          digits = digits + 1
        end
        if digits == 0 then return nilptr end
        if (directive == 109_cchar and (number < 1 or number > 12)) or
            ((directive == 100_cchar or directive == 101_cchar) and (number < 1 or number > 31)) or
            ((directive == 72_cchar or directive == 107_cchar) and (number < 0 or number > 23)) or
            ((directive == 73_cchar or directive == 108_cchar) and (number < 1 or number > 12)) or
            (directive == 77_cchar and (number < 0 or number > 59)) or
            (directive == 83_cchar and (number < 0 or number > 60)) or
            (directive == 106_cchar and (number < 1 or number > 366)) then return nilptr end
        if (directive == 119_cchar and (number < 0 or number > 6)) or
            (directive == 117_cchar and (number < 1 or number > 7)) or
            ((directive == 85_cchar or directive == 87_cchar) and number > 53) or
            (directive == 86_cchar and (number < 1 or number > 53)) then return nilptr end
        if directive == 89_cchar then
          time_value.tm_year = number - 1900
          parsed_year = true
        elseif directive == 67_cchar then
          century = number
          parsed_century = true
        elseif directive == 71_cchar or directive == 103_cchar then
          if directive == 103_cchar then
            if number <= 68 then iso_year = (@clonglong)(number + 2000)
            else iso_year = (@clonglong)(number + 1900) end
          else iso_year = (@clonglong)(number) end
          parsed_iso_year = true
        elseif directive == 121_cchar then
          two_digit_year = number
          parsed_two_digit_year = true
          if number <= 68 then time_value.tm_year = number + 100
          else time_value.tm_year = number end
          parsed_year = true
        elseif directive == 109_cchar then time_value.tm_mon = number - 1
        elseif directive == 100_cchar or directive == 101_cchar then time_value.tm_mday = number
        elseif directive == 72_cchar or directive == 107_cchar or directive == 108_cchar or directive == 73_cchar then
          time_value.tm_hour = number
        elseif directive == 77_cchar then time_value.tm_min = number
        elseif directive == 83_cchar then time_value.tm_sec = number
        elseif directive == 106_cchar then time_value.tm_yday = number - 1
        elseif directive == 119_cchar then
          time_value.tm_wday = number
          parsed_weekday = true
        elseif directive == 117_cchar then
          time_value.tm_wday = number % 7
          parsed_weekday = true
        elseif directive == 85_cchar then u_week = number; parsed_u_week = true
        elseif directive == 87_cchar then w_week = number; parsed_w_week = true
        else iso_week = number; parsed_iso_week = true end
      else
        return nilptr
      end
    end
  end
  if parsed_century and parsed_two_digit_year then
    time_value.tm_year = century * 100 + two_digit_year - 1900
    parsed_year = true
  elseif parsed_century then
    time_value.tm_year = century * 100 - 1900
    parsed_year = true
  end
  local year: clonglong = (@clonglong)(time_value.tm_year) + 1900_clonglong
  if parsed_iso_week and parsed_iso_year and parsed_weekday then
    if iso_week < 1 or iso_week > iso_weeks_in_year(iso_year) then return nilptr end
    local january_fourth: clonglong = tz_days_from_civil(iso_year, 1_clonglong, 4_clonglong)
    local january_fourth_weekday: clonglong = (january_fourth + 4_clonglong) % 7_clonglong
    if january_fourth_weekday < 0_clonglong then january_fourth_weekday = january_fourth_weekday + 7_clonglong end
    local iso_monday: clonglong = january_fourth -
        ((january_fourth_weekday + 6_clonglong) % 7_clonglong)
    local target_day: clonglong = iso_monday +
        ((@clonglong)(iso_week) - 1_clonglong) * 7_clonglong +
        ((@clonglong)(time_value.tm_wday) + 6_clonglong) % 7_clonglong
    local target_seconds: clonglong = target_day * 86400_clonglong
    local converted: Tm = {
      tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
      tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 0_cint, tm_yday = 0_cint,
      tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
    }
    if gmtime_r((@*[0]clong)(&target_seconds), &converted) == nilptr then return nilptr end
    time_value.tm_year = converted.tm_year
    time_value.tm_mon = converted.tm_mon
    time_value.tm_mday = converted.tm_mday
    time_value.tm_yday = converted.tm_yday
    time_value.tm_wday = converted.tm_wday
  elseif parsed_year and parsed_weekday and (parsed_u_week or parsed_w_week) then
    local january_first: clonglong = tz_days_from_civil(year, 1_clonglong, 1_clonglong)
    local january_weekday: clonglong = (january_first + 4_clonglong) % 7_clonglong
    if january_weekday < 0_clonglong then january_weekday = january_weekday + 7_clonglong end
    local year_day: clonglong
    if parsed_u_week then
      year_day = (@clonglong)(u_week) * 7_clonglong +
          (@clonglong)(time_value.tm_wday) - january_weekday
    else
      local monday_weekday: clonglong = (january_weekday + 6_clonglong) % 7_clonglong
      local monday_time_weekday: clonglong = (time_value.tm_wday + 6_clonglong) % 7_clonglong
      year_day = (@clonglong)(w_week) * 7_clonglong + monday_time_weekday - monday_weekday
    end
    local leap_year: boolean = year % 400_clonglong == 0_clonglong or
        (year % 4_clonglong == 0_clonglong and year % 100_clonglong ~= 0_clonglong)
    local last_year_day: clonglong = 364_clonglong
    if leap_year then last_year_day = 365_clonglong end
    if year_day < 0_clonglong or year_day > last_year_day then return nilptr end
    local target_seconds: clonglong = (january_first + year_day) * 86400_clonglong
    local converted: Tm = {
      tm_sec = 0_cint, tm_min = 0_cint, tm_hour = 0_cint, tm_mday = 1_cint,
      tm_mon = 0_cint, tm_year = 70_cint, tm_wday = 0_cint, tm_yday = 0_cint,
      tm_isdst = 0_cint, tm_gmtoff = 0_clong, tm_zone = nilptr
    }
    if gmtime_r((@*[0]clong)(&target_seconds), &converted) == nilptr then return nilptr end
    time_value.tm_year = converted.tm_year
    time_value.tm_mon = converted.tm_mon
    time_value.tm_mday = converted.tm_mday
    time_value.tm_yday = converted.tm_yday
    time_value.tm_wday = converted.tm_wday
  end
  return (@*[0]cchar)(&input[input_position])
end

-- C-locale strftime directives; locale-specific names can replace these tables later.
local function strftime(buffer: *[0]cchar, max_size: csize,
    format: *[0]cchar <const>, time_value: *Tm <const>): csize
    <cexport, codename 'strftime'>
  if buffer == nilptr or format == nilptr or time_value == nilptr then return 0 end
  if max_size == 0 then return 0 end
  local position: csize = 0
  local index: csize = 0
  local ok: boolean = true
  local calendar_year: clonglong = (@clonglong)(time_value.tm_year) + 1900_clonglong
  local iso_year: clonglong = calendar_year
  local iso_weekday: clonglong = time_value.tm_wday
  if iso_weekday == 0_clonglong then iso_weekday = 7_clonglong end
  local iso_week: clonglong = ((@clonglong)(time_value.tm_yday) + 10_clonglong - iso_weekday) // 7_clonglong
  if iso_week < 1_clonglong then
    iso_year = calendar_year - 1_clonglong
    iso_week = (@clonglong)(iso_weeks_in_year(iso_year))
  elseif iso_week > (@clonglong)(iso_weeks_in_year(calendar_year)) then
    iso_year = calendar_year + 1_clonglong
    iso_week = 1_clonglong
  end
  while format[index] ~= 0_cchar and ok do
    if format[index] ~= 37_cchar then
      if position + 1 >= max_size then ok = false
      else buffer[position] = format[index]; position = position + 1 end
      index = index + 1
    else
      index = index + 1
      local directive: cchar = format[index]
      if directive == 0_cchar then break end
      index = index + 1
      if directive == 69_cchar or directive == 79_cchar then -- E/O modifiers use C-locale forms here.
        directive = format[index]
        if directive == 0_cchar then break end
        index = index + 1
      end
      if directive == 37_cchar then ok = strftime_append_text(buffer, max_size, &position, "%")
      elseif directive == 110_cchar then ok = strftime_append_text(buffer, max_size, &position, "\n")
      elseif directive == 116_cchar then ok = strftime_append_text(buffer, max_size, &position, "\t")
      elseif directive == 97_cchar then
        if time_value.tm_wday < 0 or time_value.tm_wday > 6 then ok = false
        elseif time_value.tm_wday == 0 then ok = strftime_append_text(buffer, max_size, &position, "Sun")
        elseif time_value.tm_wday == 1 then ok = strftime_append_text(buffer, max_size, &position, "Mon")
        elseif time_value.tm_wday == 2 then ok = strftime_append_text(buffer, max_size, &position, "Tue")
        elseif time_value.tm_wday == 3 then ok = strftime_append_text(buffer, max_size, &position, "Wed")
        elseif time_value.tm_wday == 4 then ok = strftime_append_text(buffer, max_size, &position, "Thu")
        elseif time_value.tm_wday == 5 then ok = strftime_append_text(buffer, max_size, &position, "Fri")
        else ok = strftime_append_text(buffer, max_size, &position, "Sat") end
      elseif directive == 65_cchar then
        if time_value.tm_wday < 0 or time_value.tm_wday > 6 then ok = false
        elseif time_value.tm_wday == 0 then ok = strftime_append_text(buffer, max_size, &position, "Sunday")
        elseif time_value.tm_wday == 1 then ok = strftime_append_text(buffer, max_size, &position, "Monday")
        elseif time_value.tm_wday == 2 then ok = strftime_append_text(buffer, max_size, &position, "Tuesday")
        elseif time_value.tm_wday == 3 then ok = strftime_append_text(buffer, max_size, &position, "Wednesday")
        elseif time_value.tm_wday == 4 then ok = strftime_append_text(buffer, max_size, &position, "Thursday")
        elseif time_value.tm_wday == 5 then ok = strftime_append_text(buffer, max_size, &position, "Friday")
        else ok = strftime_append_text(buffer, max_size, &position, "Saturday") end
      elseif directive == 98_cchar or directive == 104_cchar then
        if time_value.tm_mon < 0 or time_value.tm_mon > 11 then ok = false
        elseif time_value.tm_mon == 0 then ok = strftime_append_text(buffer, max_size, &position, "Jan")
        elseif time_value.tm_mon == 1 then ok = strftime_append_text(buffer, max_size, &position, "Feb")
        elseif time_value.tm_mon == 2 then ok = strftime_append_text(buffer, max_size, &position, "Mar")
        elseif time_value.tm_mon == 3 then ok = strftime_append_text(buffer, max_size, &position, "Apr")
        elseif time_value.tm_mon == 4 then ok = strftime_append_text(buffer, max_size, &position, "May")
        elseif time_value.tm_mon == 5 then ok = strftime_append_text(buffer, max_size, &position, "Jun")
        elseif time_value.tm_mon == 6 then ok = strftime_append_text(buffer, max_size, &position, "Jul")
        elseif time_value.tm_mon == 7 then ok = strftime_append_text(buffer, max_size, &position, "Aug")
        elseif time_value.tm_mon == 8 then ok = strftime_append_text(buffer, max_size, &position, "Sep")
        elseif time_value.tm_mon == 9 then ok = strftime_append_text(buffer, max_size, &position, "Oct")
        elseif time_value.tm_mon == 10 then ok = strftime_append_text(buffer, max_size, &position, "Nov")
        else ok = strftime_append_text(buffer, max_size, &position, "Dec") end
      elseif directive == 66_cchar then
        if time_value.tm_mon < 0 or time_value.tm_mon > 11 then ok = false
        elseif time_value.tm_mon == 0 then ok = strftime_append_text(buffer, max_size, &position, "January")
        elseif time_value.tm_mon == 1 then ok = strftime_append_text(buffer, max_size, &position, "February")
        elseif time_value.tm_mon == 2 then ok = strftime_append_text(buffer, max_size, &position, "March")
        elseif time_value.tm_mon == 3 then ok = strftime_append_text(buffer, max_size, &position, "April")
        elseif time_value.tm_mon == 4 then ok = strftime_append_text(buffer, max_size, &position, "May")
        elseif time_value.tm_mon == 5 then ok = strftime_append_text(buffer, max_size, &position, "June")
        elseif time_value.tm_mon == 6 then ok = strftime_append_text(buffer, max_size, &position, "July")
        elseif time_value.tm_mon == 7 then ok = strftime_append_text(buffer, max_size, &position, "August")
        elseif time_value.tm_mon == 8 then ok = strftime_append_text(buffer, max_size, &position, "September")
        elseif time_value.tm_mon == 9 then ok = strftime_append_text(buffer, max_size, &position, "October")
        elseif time_value.tm_mon == 10 then ok = strftime_append_text(buffer, max_size, &position, "November")
        else ok = strftime_append_text(buffer, max_size, &position, "December") end
      elseif directive == 112_cchar then
        if time_value.tm_hour < 0 or time_value.tm_hour > 23 then ok = false
        elseif time_value.tm_hour < 12 then ok = strftime_append_text(buffer, max_size, &position, "AM")
        else ok = strftime_append_text(buffer, max_size, &position, "PM") end
      elseif directive == 90_cchar then
        ok = strftime_append_text(buffer, max_size, &position,
          (@*[0]cchar)(time_value.tm_zone))
      elseif directive == 89_cchar then
        ok = strftime_append_number(buffer, max_size, &position,
          calendar_year, 4_cint, 48_cchar)
      elseif directive == 71_cchar then
        ok = strftime_append_number(buffer, max_size, &position, iso_year, 4_cint, 48_cchar)
      elseif directive == 103_cchar then
        local iso_year_suffix: clonglong = iso_year % 100_clonglong
        if iso_year_suffix < 0 then iso_year_suffix = iso_year_suffix + 100_clonglong end
        ok = strftime_append_number(buffer, max_size, &position, iso_year_suffix, 2_cint, 48_cchar)
      elseif directive == 121_cchar then
        local year_suffix: clonglong = ((@clonglong)(time_value.tm_year) + 1900_clonglong) % 100_clonglong
        if year_suffix < 0 then year_suffix = year_suffix + 100_clonglong end
        ok = strftime_append_number(buffer, max_size, &position, year_suffix, 2_cint, 48_cchar)
      elseif directive == 67_cchar then
        ok = strftime_append_number(buffer, max_size, &position,
          floor_division((@clonglong)(time_value.tm_year) + 1900_clonglong, 100_clonglong), 2_cint, 48_cchar)
      elseif directive == 109_cchar then ok = strftime_append_number(buffer, max_size, &position, (@clonglong)(time_value.tm_mon) + 1_clonglong, 2_cint, 48_cchar)
      elseif directive == 100_cchar then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_mday, 2_cint, 48_cchar)
      elseif directive == 101_cchar then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_mday, 2_cint, 32_cchar)
      elseif directive == 72_cchar then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_hour, 2_cint, 48_cchar)
      elseif directive == 107_cchar then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_hour, 2_cint, 32_cchar)
      elseif directive == 73_cchar then
        local hour12: cint = time_value.tm_hour % 12
        if hour12 == 0 then hour12 = 12 end
        ok = strftime_append_number(buffer, max_size, &position, hour12, 2_cint, 48_cchar)
      elseif directive == 108_cchar then
        local hour12: cint = time_value.tm_hour % 12
        if hour12 == 0 then hour12 = 12 end
        ok = strftime_append_number(buffer, max_size, &position, hour12, 2_cint, 32_cchar)
      elseif directive == 77_cchar then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_min, 2_cint, 48_cchar)
      elseif directive == 83_cchar then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_sec, 2_cint, 48_cchar)
      elseif directive == 106_cchar then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_yday + 1, 3_cint, 48_cchar)
      elseif directive == 119_cchar then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_wday, 1_cint, 48_cchar)
      elseif directive == 117_cchar then
        local weekday: cint = time_value.tm_wday
        if weekday == 0 then weekday = 7 end
        ok = strftime_append_number(buffer, max_size, &position, weekday, 1_cint, 48_cchar)
      elseif directive == 122_cchar then
        local offset: clonglong = (@clonglong)(time_value.tm_gmtoff)
        local sign: [2]cchar = {43_cchar, 0_cchar}
        if offset < 0_clonglong then sign[0] = 45_cchar; offset = -offset end
        ok = strftime_append_text(buffer, max_size, &position, (@*[0]cchar)(&sign[0]))
        if ok then ok = strftime_append_number(buffer, max_size, &position, offset // 3600_clonglong, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_number(buffer, max_size, &position, (offset // 60_clonglong) % 60_clonglong, 2_cint, 48_cchar) end
      elseif directive == 115_cchar then
        local epoch_seconds: clonglong = tz_days_from_civil(calendar_year,
          (@clonglong)(time_value.tm_mon) + 1_clonglong, time_value.tm_mday) * 86400_clonglong +
          (@clonglong)(time_value.tm_hour) * 3600_clonglong +
          (@clonglong)(time_value.tm_min) * 60_clonglong +
          (@clonglong)(time_value.tm_sec) - (@clonglong)(time_value.tm_gmtoff)
        ok = strftime_append_number(buffer, max_size, &position, epoch_seconds, 1_cint, 48_cchar)
      elseif directive == 70_cchar then
        ok = strftime_append_number(buffer, max_size, &position,
          (@clonglong)(time_value.tm_year) + 1900_clonglong, 4_cint, 48_cchar)
        if ok then ok = strftime_append_text(buffer, max_size, &position, "-") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, (@clonglong)(time_value.tm_mon) + 1_clonglong, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, "-") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_mday, 2_cint, 48_cchar) end
      elseif directive == 84_cchar or directive == 88_cchar then
        ok = strftime_append_number(buffer, max_size, &position, time_value.tm_hour, 2_cint, 48_cchar)
        if ok then ok = strftime_append_text(buffer, max_size, &position, ":") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_min, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, ":") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_sec, 2_cint, 48_cchar) end
      elseif directive == 82_cchar then
        ok = strftime_append_number(buffer, max_size, &position, time_value.tm_hour, 2_cint, 48_cchar)
        if ok then ok = strftime_append_text(buffer, max_size, &position, ":") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_min, 2_cint, 48_cchar) end
      elseif directive == 68_cchar or directive == 120_cchar then
        ok = strftime_append_number(buffer, max_size, &position, (@clonglong)(time_value.tm_mon) + 1_clonglong, 2_cint, 48_cchar)
        if ok then ok = strftime_append_text(buffer, max_size, &position, "/") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_mday, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, "/") end
        if ok then
          local year_suffix: clonglong = ((@clonglong)(time_value.tm_year) + 1900_clonglong) % 100_clonglong
          if year_suffix < 0 then year_suffix = year_suffix + 100_clonglong end
          ok = strftime_append_number(buffer, max_size, &position, year_suffix, 2_cint, 48_cchar)
        end
      elseif directive == 99_cchar then
        -- C-locale composite: abbreviated weekday/month, day, time, and year.
        local weekday_abbrev: *[0]cchar
        if time_value.tm_wday == 0 then weekday_abbrev = "Sun"
        elseif time_value.tm_wday == 1 then weekday_abbrev = "Mon"
        elseif time_value.tm_wday == 2 then weekday_abbrev = "Tue"
        elseif time_value.tm_wday == 3 then weekday_abbrev = "Wed"
        elseif time_value.tm_wday == 4 then weekday_abbrev = "Thu"
        elseif time_value.tm_wday == 5 then weekday_abbrev = "Fri"
        elseif time_value.tm_wday == 6 then weekday_abbrev = "Sat"
        else weekday_abbrev = nilptr; ok = false end
        local month_abbrev: *[0]cchar
        if time_value.tm_mon == 0 then month_abbrev = "Jan"
        elseif time_value.tm_mon == 1 then month_abbrev = "Feb"
        elseif time_value.tm_mon == 2 then month_abbrev = "Mar"
        elseif time_value.tm_mon == 3 then month_abbrev = "Apr"
        elseif time_value.tm_mon == 4 then month_abbrev = "May"
        elseif time_value.tm_mon == 5 then month_abbrev = "Jun"
        elseif time_value.tm_mon == 6 then month_abbrev = "Jul"
        elseif time_value.tm_mon == 7 then month_abbrev = "Aug"
        elseif time_value.tm_mon == 8 then month_abbrev = "Sep"
        elseif time_value.tm_mon == 9 then month_abbrev = "Oct"
        elseif time_value.tm_mon == 10 then month_abbrev = "Nov"
        elseif time_value.tm_mon == 11 then month_abbrev = "Dec"
        else month_abbrev = nilptr; ok = false end
        if ok then ok = strftime_append_text(buffer, max_size, &position, weekday_abbrev) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, " ") end
        if ok then ok = strftime_append_text(buffer, max_size, &position, month_abbrev) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, " ") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_mday, 2_cint, 32_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, " ") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_hour, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, ":") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_min, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, ":") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_sec, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, " ") end
        if ok then ok = strftime_append_number(buffer, max_size, &position,
          (@clonglong)(time_value.tm_year) + 1900_clonglong, 4_cint, 48_cchar) end
      elseif directive == 114_cchar then
        local hour12: cint = time_value.tm_hour % 12
        if hour12 == 0 then hour12 = 12 end
        ok = strftime_append_number(buffer, max_size, &position, hour12, 2_cint, 48_cchar)
        if ok then ok = strftime_append_text(buffer, max_size, &position, ":") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_min, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, ":") end
        if ok then ok = strftime_append_number(buffer, max_size, &position, time_value.tm_sec, 2_cint, 48_cchar) end
        if ok then ok = strftime_append_text(buffer, max_size, &position, " ") end
        if ok and time_value.tm_hour < 12 then ok = strftime_append_text(buffer, max_size, &position, "AM")
        elseif ok then ok = strftime_append_text(buffer, max_size, &position, "PM") end
      elseif directive == 86_cchar then
        ok = strftime_append_number(buffer, max_size, &position, iso_week, 2_cint, 48_cchar)
      elseif directive == 85_cchar or directive == 87_cchar then
        local weekday_start: cint = time_value.tm_wday
        if directive == 87_cchar then
          weekday_start = (weekday_start + 6) % 7
        end
        local week: cint = (time_value.tm_yday + 7 - weekday_start) // 7
        ok = strftime_append_number(buffer, max_size, &position, week, 2_cint, 48_cchar)
      else ok = false end
    end
  end
  if not ok then buffer[0] = 0_cchar; return 0 end
  buffer[position] = 0_cchar
  return position
end

-- ISO C clock reports process CPU time in CLOCKS_PER_SEC ticks.
local function clock(): clong <cexport, codename 'clock'>
  local process_time: Timespec = {tv_sec = 0_clong, tv_nsec = 0_clong}
  if clock_gettime(2_cint, (@pointer)(&process_time)) ~= 0_cint or
      process_time.tv_sec < 0_clong or process_time.tv_nsec < 0_clong or
      process_time.tv_nsec >= 1000000000_clong then
    return -1_clong
  end
  local ticks_per_second: clong <comptime> = 1000000_clong
  local maximum_ticks: clong <comptime> = 0x7fffffffffffffff_clong
  if process_time.tv_sec > maximum_ticks // ticks_per_second then
    return -1_clong
  end
  local whole_ticks: clong = process_time.tv_sec * ticks_per_second
  local fraction_ticks: clong = process_time.tv_nsec // 1000_clong
  if whole_ticks > maximum_ticks - fraction_ticks then return -1_clong end
  return whole_ticks + fraction_ticks
end

local function getrandom(buffer: pointer, length: csize, flags: cuint): clong <cexport, codename 'getrandom'>
  return syscall_result(nelibc_raw_syscall3(
    318_culong, (@culong)((@usize)(buffer)), (@culong)(length), (@culong)(flags)
  ))
end

-- POSIX getentropy is all-or-error, capped at 256 bytes, and not a cancellation point.
local function getentropy(buffer: pointer, length: csize): cint <cexport, codename 'getentropy'>
  if length > 256_csize then
    nelibc_errno_location()[0] = 5_cint -- EIO
    return -1
  end
  local offset: csize = 0
  while offset < length do
    local address = (@pointer)((@usize)(buffer) + (@usize)(offset))
    local result = syscall_result(nelibc_raw_syscall3(
      318_culong, (@culong)((@usize)(address)), (@culong)(length - offset), 0_culong
    ))
    if result < 0 then
      if nelibc_errno_location()[0] == 4_cint then -- EINTR
        continue
      end
      return -1
    end
    if result == 0 then
      nelibc_errno_location()[0] = 5_cint -- EIO
      return -1
    end
    offset = offset + (@csize)(result)
  end
  return 0
end

-- POSIX resource limits use the native x86_64 struct rlimit layout.
local function getrlimit(resource: cint, limits: pointer): cint <cexport, codename 'getrlimit'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    97_culong,
    (@culong)(resource),
    (@culong)((@usize)(limits)),
    0_culong
  )))
end

local Rlimit: type = @record{rlim_cur: culong, rlim_max: culong}
local function getdtablesize(): cint <cexport, codename 'getdtablesize'>
  local limit: Rlimit = {rlim_cur = 0_culong, rlim_max = 0_culong}
  if getrlimit(7_cint, (@pointer)(&limit)) ~= 0_cint then return 256_cint end -- OPEN_MAX fallback
  return (@cint)(limit.rlim_cur)
end

local Sysinfo: type = @record{
  uptime: clong,
  loads: [3]culong,
  totalram: culong,
  freeram: culong,
  sharedram: culong,
  bufferram: culong,
  totalswap: culong,
  freeswap: culong,
  procs: cushort,
  pad: cushort,
  totalhigh: culong,
  freehigh: culong,
  mem_unit: cuint
}

local function setrlimit(resource: cint, limits: pointer <const>): cint <cexport, codename 'setrlimit'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    160_culong,
    (@culong)(resource),
    (@culong)((@usize)(limits)),
    0_culong
  )))
end

-- Linux getpriority returns 20 minus the POSIX nice value.
local function getpriority(which: cint, who: cint): cint <cexport, codename 'getpriority'>
  local kernel_priority = syscall_result(nelibc_raw_syscall3(
    140_culong,
    (@culong)(which),
    (@culong)(who),
    0_culong
  ))
  if kernel_priority < 0 then return -1_cint end
  return (@cint)(20_clong - kernel_priority)
end

local function setpriority(which: cint, who: cint, priority: cint): cint <cexport, codename 'setpriority'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    141_culong,
    (@culong)(which),
    (@culong)(who),
    (@culong)(priority)
  )))
end

local function sched_yield(): cint <cexport, codename 'sched_yield'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(24_culong, 0_culong, 0_culong, 0_culong)))
end

-- Linux getaffinity returns bytes copied; POSIX sched_getaffinity returns zero.
local function sched_getaffinity(pid: cint, size: csize, mask: pointer): cint <cexport, codename 'sched_getaffinity'>
  local result = syscall_result(nelibc_raw_syscall3(
    204_culong,
    (@culong)(pid),
    (@culong)(size),
    (@culong)((@usize)(mask))
  ))
  if result < 0 then return -1_cint end
  return 0_cint
end

local function sched_setaffinity(pid: cint, size: csize, mask: pointer <const>): cint <cexport, codename 'sched_setaffinity'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    203_culong,
    (@culong)(pid),
    (@culong)(size),
    (@culong)((@usize)(mask))
  )))
end

-- POSIX process resource usage uses the native x86_64 struct rusage layout.
local function getrusage(who: cint, usage: pointer): cint <cexport, codename 'getrusage'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    98_culong,
    (@culong)(who),
    (@culong)((@usize)(usage)),
    0_culong
  )))
end

-- POSIX times returns process CPU accounting in clock ticks.
local function times(buffer: pointer): clong <cexport, codename 'times'>
  return syscall_result(nelibc_raw_syscall3(
    100_culong,
    (@culong)((@usize)(buffer)),
    0_culong,
    0_culong
  ))
end

local function mmap(address: pointer, length: csize, protection: cint, flags: cint, fd: cint, offset: clong): pointer <cexport, codename 'mmap'>
  local result = nelibc_raw_syscall6(
    9_culong, (@culong)((@usize)(address)), (@culong)(length),
    (@culong)(protection), (@culong)(flags), (@culong)(fd), (@culong)(offset)
  )
  if result < 0 and result >= -4095 then
    nelibc_errno_location()[0] = (@cint)(-result)
    return (@pointer)((@usize)(-1))
  end
  return (@pointer)((@usize)(result))
end

local function mprotect(address: pointer, length: csize, protection: cint): cint <cexport, codename 'mprotect'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    10_culong, (@culong)((@usize)(address)), (@culong)(length), (@culong)(protection)
  )))
end

local function mmap64(address: pointer, length: csize, protection: cint, flags: cint, fd: cint, offset: clong): pointer <cexport, codename 'mmap64'>
  return mmap(address, length, protection, flags, fd, offset)
end

-- The public mremap wrapper is variadic; its adapter passes the optional
-- destination only when MREMAP_FIXED is set.
local function nelibc_raw_mremap(old_address: pointer, old_size: csize, new_size: csize, flags: cint, new_address: pointer): pointer <cexport, codename 'nelibc_raw_mremap'>
  local result = nelibc_raw_syscall6(
    25_culong, (@culong)((@usize)(old_address)), (@culong)(old_size),
    (@culong)(new_size), (@culong)(flags), (@culong)((@usize)(new_address)),
    0_culong
  )
  if result < 0 and result >= -4095 then
    nelibc_errno_location()[0] = (@cint)(-result)
    return (@pointer)((@usize)(-1))
  end
  return (@pointer)((@usize)(result))
end

local function munmap(address: pointer, length: csize): cint <cexport, codename 'munmap'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    11_culong, (@culong)((@usize)(address)), (@culong)(length), 0_culong
  )))
end

local function madvise(address: pointer, length: csize, advice: cint): cint <cexport, codename 'madvise'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    28_culong, (@culong)((@usize)(address)), (@culong)(length), (@culong)(advice)
  )))
end

local function umask(mask: cuint): cuint <cexport, codename 'umask'>
  return (@cuint)(nelibc_raw_syscall3(95_culong, (@culong)(mask), 0_culong, 0_culong))
end

local function uname(buffer: pointer): cint <cexport, codename 'uname'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    63_culong, (@culong)((@usize)(buffer)), 0_culong, 0_culong
  )))
end

-- Linux x86_64 struct utsname is six fixed 65-byte fields.
local Utsname: type = @record{
  sysname: [65]cchar,
  nodename: [65]cchar,
  release: [65]cchar,
  version: [65]cchar,
  machine: [65]cchar,
  domainname: [65]cchar
}

local function copy_utsname_field(destination: pointer, source: *[0]cchar <const>, length: csize,
                                  error_on_truncation: boolean): cint <inline>
  local source_length: csize = 0
  while source_length < 65_csize and source[source_length] ~= 0 do
    source_length = source_length + 1_csize
  end
  local copy_length = source_length + 1_csize
  if copy_length > length then copy_length = length end
  local destination_chars = (@*[0]cchar)(destination)
  local i: csize = 0
  while i < copy_length do
    destination_chars[i] = source[i]
    i = i + 1_csize
  end
  if error_on_truncation and source_length >= length then
    nelibc_errno_location()[0] = 36_cint -- ENAMETOOLONG
    return -1_cint
  end
  return 0_cint
end

-- gethostname obtains the node name from uname and follows glibc truncation semantics.
local function gethostname(name: pointer, length: csize): cint <cexport, codename 'gethostname'>
  local uts: Utsname
  if uname((@pointer)(&uts)) ~= 0 then return -1_cint end
  return copy_utsname_field(name, (@*[0]cchar)(&uts.nodename[0]), length, true)
end

-- getdomainname obtains the NIS domain name from uname; truncation is successful.
local function getdomainname(name: pointer, length: csize): cint <cexport, codename 'getdomainname'>
  local uts: Utsname
  if uname((@pointer)(&uts)) ~= 0 then return -1_cint end
  return copy_utsname_field(name, (@*[0]cchar)(&uts.domainname[0]), length, false)
end

local function pwrite(fd: cint, buf: pointer <const>, count: csize, offset: clong): clong <cexport, codename 'pwrite'>
  local raw_result = nelibc_cancellable_syscall6(
    18_culong,
    (@culong)(fd),
    (@culong)((@usize)(buf)),
    (@culong)(count),
    (@culong)(offset),
    0_culong,
    0_culong
  )
  return syscall_result(raw_result)
end

local function pwrite64(fd: cint, buf: pointer <const>, count: csize, offset: clong): clong <cexport, codename 'pwrite64'>
  return pwrite(fd, buf, count, offset)
end

-- Linux x86_64 uses a native-width offset for pwritev; only 32-bit ABIs split it.
local function pwritev(fd: cint, iov: pointer <const>, iovcnt: cint, offset: clong): clong <cexport, codename 'pwritev'>
  local raw_result = nelibc_cancellable_syscall6(
    296_culong,
    (@culong)(fd),
    (@culong)((@usize)(iov)),
    (@culong)(iovcnt),
    (@culong)(offset),
    0_culong,
    0_culong
  )
  return syscall_result(raw_result)
end

local function pwritev64(fd: cint, iov: pointer <const>, iovcnt: cint, offset: clong): clong <cexport, codename 'pwritev64'>
  return pwritev(fd, iov, iovcnt, offset)
end

-- Linux x86_64 pwritev2 uses the same offset and flags argument layout.
local function pwritev2(fd: cint, iov: pointer <const>, iovcnt: cint, offset: clong, flags: cuint): clong <cexport, codename 'pwritev2'>
  local raw_result = nelibc_cancellable_syscall6(
    328_culong,
    (@culong)(fd),
    (@culong)((@usize)(iov)),
    (@culong)(iovcnt),
    (@culong)(offset),
    0_culong,
    (@culong)(flags)
  )
  return syscall_result(raw_result)
end

local function close(fd: cint): cint <cexport, codename 'close'>
  local raw_result = nelibc_cancellable_syscall3(3_culong, (@culong)(fd), 0_culong, 0_culong)
  return (@cint)(syscall_result(raw_result))
end

-- Linux close_range applies descriptor operations to an inclusive range.
local function close_range(first: cuint, last: cuint, flags: cint): cint <cexport, codename 'close_range'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    436_culong, (@culong)(first), (@culong)(last), (@culong)(flags)
  )))
end

-- Linux eventfd2 returns a counter descriptor with optional status flags.
local function eventfd(initial_value: cuint, flags: cint): cint <cexport, codename 'eventfd'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    290_culong, (@culong)(initial_value), (@culong)(flags), 0_culong
  )))
end

local function timerfd_create(clock_id: cint, flags: cint): cint <cexport, codename 'timerfd_create'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    283_culong, (@culong)(clock_id), (@culong)(flags), 0_culong
  )))
end

local function timerfd_settime(fd: cint, flags: cint, new_value: pointer <const>, old_value: pointer): cint <cexport, codename 'timerfd_settime'>
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    286_culong, (@culong)(fd), (@culong)(flags),
    (@culong)((@usize)(new_value)), (@culong)((@usize)(old_value)),
    0_culong, 0_culong
  )))
end

local function timerfd_gettime(fd: cint, current_value: pointer): cint <cexport, codename 'timerfd_gettime'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    287_culong, (@culong)(fd), (@culong)((@usize)(current_value)), 0_culong
  )))
end

local function signalfd(fd: cint, signal_mask: pointer <const>, flags: cint): cint <cexport, codename 'signalfd'>
  local kernel_mask = ((@*Sigset)(signal_mask)).bits[0] & ~(1_culong << 31)
  return (@cint)(syscall_result(nelibc_raw_syscall6(
    289_culong, (@culong)(fd), (@culong)((@usize)(&kernel_mask)),
    8_culong, (@culong)(flags), 0_culong, 0_culong
  )))
end

-- Linux x86_64 memfd_create creates an anonymous, sealable file descriptor.
local function memfd_create(name: *[0]cchar <const>, flags: cuint): cint
    <cexport, codename 'memfd_create'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
    319_culong, (@culong)((@usize)(name)), (@culong)(flags), 0_culong
  )))
end

-- Linux pidfd syscalls provide stable process handles and signaling.
local function pidfd_send_signal(pidfd: cint, signal: cint, info: pointer,
    flags: cuint): cint <cexport, codename 'pidfd_send_signal'>
  return (@cint)(syscall_result(nelibc_raw_syscall3(
